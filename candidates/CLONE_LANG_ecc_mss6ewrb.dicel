@DICEL:LIN_CANDIDATE:1.0.0
^from_clone="clone-lin-ecc"
^stage="LEARN_NEW_LANG"
^forbid_nucleus=true

@HARVEST {
  emit_fail{target="rust" fn="validateArgv" emit="FAIL" run="n/a" reason="LIA_AST_FOR_HEAD" nucleus=false}
  proposal{fix="emit_ts|emit_py|emit_go|emit_rust|emit_shared peripheral; retry; no one-file hardcode"}
}
