.source{content="{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"moduleResolution\": \"NodeNext\",\n    \"esModuleInterop\": true,\n    \"strict\": true,\n    \"skipLibCheck\": true,\n    \"declaration\": true,\n    \"emitDeclarationOnly\": true,\n    \"rootDir\": \"./src\",\n    \"outDir\": \"./types\",\n    \"types\": [\"node\"]\n  },\n  \"include\": [\n    \"src/compiler.ts\"\n  ]\n}\n"}
