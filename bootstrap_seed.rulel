@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="bootstrap_seed.mjs" lang="mjs"}
.source{content="/**\n * LIN in-memory bootstrap seed (committed as bootstrap_seed.rulel only).\n * Loads src/*.rulel TRANSPOSED_SOURCE into a module registry — no build/runtime/*.mjs on disk.\n * Runs scripts/lin_bootstrap.lin via compile + runInMemory.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport crypto from 'node:crypto';\nimport vm from 'node:vm';\nimport { createRequire } from 'node:module';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst nodeRequire = createRequire(import.meta.url);\n\n/** @type {Map<string, any> | null} */\nlet _registry = null;\n/** @type {object | null} */\nlet _manifest = null;\n\nexport function extractRulelContent(rulelText) {\n  const marker = '.source{content=\"';\n  const start = rulelText.indexOf(marker);\n  if (start < 0) return null;\n  let i = start + marker.length;\n  let out = '';\n  while (i < rulelText.length) {\n    const ch = rulelText[i];\n    if (ch === '\\\\') {\n      const n = rulelText[i + 1];\n      const map = { n: '\\n', r: '\\r', t: '\\t', '\"': '\"', '\\\\': '\\\\' };\n      if (n in map) {\n        out += map[n];\n        i += 2;\n        continue;\n      }\n      out += n;\n      i += 2;\n      continue;\n    }\n    if (ch === '\"') break;\n    out += ch;\n    i += 1;\n  }\n  return out;\n}\n\nfunction esmToCjs(code, virtualFile) {\n  let out = String(code);\n  out = out.replace(/^import\\s+(\\w+)\\s+from\\s+['\"]node:([^'\"]+)['\"]\\s*;?\\s*$/gm, '');\n  out = out.replace(\n    /^import\\s+\\{([^}]+)\\}\\s+from\\s+['\"](\\.[^'\"]+)['\"]\\s*;?\\s*$/gm,\n    (_, bindings, spec) => `const {${bindings.trim()}} = __req__('${path.basename(spec)}');`,\n  );\n  out = out.replace(\n    /^import\\s+(\\w+)\\s+from\\s+['\"](\\.[^'\"]+)['\"]\\s*;?\\s*$/gm,\n    (_, name, spec) => `const ${name} = __req__('${path.basename(spec)}');`,\n  );\n  out = out.replace(/^export\\s+(async\\s+)?function\\s+/gm, 'exports.$&'.replace('exports.export ', 'exports.'));\n  out = out.replace(/^export\\s+(const|let|var|class)\\s+(\\w+)/gm, '$1 $2');\n  out = out.replace(/^export\\s+(const|let|var|class)\\s+/gm, '$1 ');\n  const exportNames = [];\n  out = out.replace(/^export\\s+(const|let|var)\\s+(\\w+)/gm, (_, kind, name) => {\n    exportNames.push(name);\n    return `${kind} ${name}`;\n  });\n  out = out.replace(/^export\\s+function\\s+(\\w+)/gm, (_, name) => {\n    exportNames.push(name);\n    return `function ${name}`;\n  });\n  out = out.replace(/^export\\s+class\\s+(\\w+)/gm, (_, name) => {\n    exportNames.push(name);\n    return `class ${name}`;\n  });\n  out = out.replace(/^export\\s*\\{([^}]+)\\}\\s*;?\\s*$/gm, (_, names) =>\n    names\n      .split(',')\n      .map((n) => {\n        const parts = n.trim().split(/\\s+as\\s+/);\n        const local = parts[0].trim();\n        const exported = (parts[1] || parts[0]).trim();\n        return `exports.${exported} = ${local};`;\n      })\n      .join('\\n'),\n  );\n  for (const name of exportNames) {\n    if (!out.includes(`exports.${name}`)) {\n      out += `\\nexports.${name} = ${name};`;\n    }\n  }\n  void virtualFile;\n  return out;\n}\n\nfunction evalInRegistry(code, filename, registry) {\n  const cjs = esmToCjs(code, filename);\n  const module = { exports: {} };\n  const dirname = path.dirname(filename);\n  const req = (spec) => {\n    if (spec.startsWith('.')) {\n      const base = path.basename(spec);\n      if (registry.has(base)) return registry.get(base);\n      throw new Error(`LIN_MEM: missing ${base} required by ${filename}`);\n    }\n    return nodeRequire(spec);\n  };\n  const sandbox = {\n    module,\n    exports: module.exports,\n    require: req,\n    __req__: req,\n    console,\n    Buffer,\n    process,\n    setTimeout,\n    clearTimeout,\n    setInterval,\n    clearInterval,\n    queueMicrotask,\n    TextEncoder,\n    TextDecoder,\n    URL,\n    __dirname: dirname,\n    __filename: filename,\n  };\n  vm.runInNewContext(cjs, sandbox, { filename, timeout: 30_000 });\n  return module.exports;\n}\n\nconst SRC_RUNTIME_ORDER = [\n  'render_core.mjs',\n  'emit_shared.mjs',\n  'regex_ir.mjs',\n  'lexer_slices.compiled.cjs',\n  'semantic_hash_core.compiled.cjs',\n  'effects_core.compiled.cjs',\n  'rulel_core.compiled.cjs',\n  'vm_core.compiled.cjs',\n  'verifier_core.compiled.cjs',\n  'transpiler_to_lin_core.compiled.cjs',\n  'lexer_slices_load.mjs',\n  'lexer.mjs',\n  'parser.mjs',\n  'effects.mjs',\n  'render_js.mjs',\n  'semantic_hash.mjs',\n  'vm.mjs',\n  'rulel.mjs',\n  'emitters_dbg.mjs',\n  'emitters.mjs',\n  'emit_from_js.mjs',\n  'compiler.mjs',\n  'verifier.mjs',\n  'transpiler_to_lin.mjs',\n  'semantic_closure_engine.mjs',\n  'semantic_merkle_hasher.mjs',\n  'semantic_merkle_dag.mjs',\n  'vm_zig.mjs',\n  'canonical_ir_serializer.mjs',\n];\n\nfunction loadCjsSeed(root, name, registry) {\n  const rulelName = name.replace(/\\.compiled\\.cjs$/, '.compiled_cjs.rulel');\n  const rulelPath = path.join(root, 'src', rulelName);\n  if (!fs.existsSync(rulelPath)) return false;\n  const text = fs.readFileSync(rulelPath, 'utf8');\n  const content = extractRulelContent(text);\n  if (!content) return false;\n  const module = { exports: {} };\n  const req = (spec) => {\n    if (spec.startsWith('.')) {\n      const base = path.basename(spec);\n      if (registry.has(base)) return registry.get(base);\n    }\n    return nodeRequire(spec);\n  };\n  vm.runInNewContext(`${content}\\n`, { module, exports: module.exports, require: req, console }, { timeout: 10_000 });\n  registry.set(name, module.exports);\n  return true;\n}\n\nfunction loadMjsFromRulel(root, name, registry) {\n  const base = name.replace(/\\.mjs$/, '');\n  const rulelPath = path.join(root, 'src', `${base}.rulel`);\n  if (!fs.existsSync(rulelPath)) return false;\n  const text = fs.readFileSync(rulelPath, 'utf8');\n  if (!text.includes('TRANSPOSED_SOURCE')) return false;\n  const content = extractRulelContent(text);\n  if (!content) return false;\n  const virtual = `lin-memory://src/${name}`;\n  const exports = evalInRegistry(content, virtual, registry);\n  registry.set(name, exports);\n  return true;\n}\n\nfunction loadSelfhostFromRulel(root, registry) {\n  const selfhostDir = path.join(root, 'src', 'selfhost');\n  if (!fs.existsSync(selfhostDir)) return;\n  for (const ent of fs.readdirSync(selfhostDir)) {\n    if (!ent.endsWith('.rulel')) continue;\n    const name = ent.replace(/\\.rulel$/, '.mjs');\n    const text = fs.readFileSync(path.join(selfhostDir, ent), 'utf8');\n    if (!text.includes('TRANSPOSED_SOURCE') && !text.includes('.source{content=')) continue;\n    const content = extractRulelContent(text);\n    if (!content) continue;\n    registry.set(`selfhost/${name}`, evalInRegistry(content, `lin-memory://src/selfhost/${name}`, registry));\n  }\n}\n\nexport function createInMemoryRegistry(root) {\n  const registry = new Map();\n  for (const name of SRC_RUNTIME_ORDER) {\n    if (name.endsWith('.compiled.cjs')) {\n      if (!loadCjsSeed(root, name, registry)) {\n        throw new Error(`LIN_MEM: missing cjs seed ${name}`);\n      }\n      continue;\n    }\n    if (!loadMjsFromRulel(root, name, registry)) {\n      throw new Error(`LIN_MEM: missing rulel mirror for ${name}`);\n    }\n  }\n  loadSelfhostFromRulel(root, registry);\n  return registry;\n}\n\nfunction runInMemoryFromRegistry(jsCode, registry, opts = {}) {\n  const m = { exports: {} };\n  const req = (spec) => {\n    if (spec.startsWith('.')) {\n      const base = path.basename(spec);\n      if (registry.has(base)) return registry.get(base);\n      if (registry.has(`selfhost/${base}`)) return registry.get(`selfhost/${base}`);\n    }\n    return nodeRequire(spec);\n  };\n  const sandbox = {\n    module: m,\n    exports: m.exports,\n    require: req,\n    __req__: req,\n    console: opts.console || console,\n    Buffer,\n    TextEncoder,\n    TextDecoder,\n    URL,\n    setTimeout,\n    clearTimeout,\n    setInterval,\n    clearInterval,\n    queueMicrotask,\n  };\n  const cjs = esmToCjs(String(jsCode), 'lin-in-memory.js');\n  vm.runInNewContext(cjs, sandbox, { timeout: opts.timeoutMs || 10_000 });\n  const exported = sandbox.module.exports;\n  return exported === undefined ? m.exports : exported;\n}\n\nexport async function bootInMemoryLin(root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')) {\n  if (_registry && _manifest) return { registry: _registry, manifest: _manifest };\n\n  const registry = createInMemoryRegistry(root);\n  const compileFn = registry.get('compiler.mjs').compile;\n  const vmFn = registry.get('vm.mjs').runInMemory;\n\n  const bootLinPath = path.join(root, 'scripts', 'lin_bootstrap.lin');\n  const bootLin = fs.readFileSync(bootLinPath, 'utf8');\n  const bootJs = compileFn(bootLin, { target: 'js' }).code;\n  const bootMod = runInMemoryFromRegistry(bootJs, registry);\n\n  const host = {\n    readText(rel) {\n      return fs.readFileSync(path.join(root, rel), 'utf8');\n    },\n    compile(src, opts) {\n      return compileFn(src, opts);\n    },\n    sha256(text) {\n      return crypto.createHash('sha256').update(text, 'utf8').digest('hex');\n    },\n    tryRegisterCore(cjsName, code) {\n      try {\n        const module = { exports: {} };\n        const req = (spec) => {\n          if (spec.startsWith('.')) {\n            const base = path.basename(spec);\n            if (registry.has(base)) return registry.get(base);\n          }\n          return nodeRequire(spec);\n        };\n        vm.runInNewContext(code, { module, exports: module.exports, require: req, console }, { timeout: 10_000 });\n        registry.set(cjsName, module.exports);\n        return true;\n      } catch {\n        return false;\n      }\n    },\n  };\n\n  const manifest = bootMod.runLinBootstrap(host);\n  manifest.timestamp = new Date().toISOString();\n  manifest.runtime = 'in-memory registry (no committed .mjs)';\n\n  _registry = registry;\n  _manifest = manifest;\n  return { registry, manifest };\n}\n\nexport function getLinRegistry() {\n  if (!_registry) throw new Error('LIN not bootstrapped: call bootInMemoryLin() first');\n  return _registry;\n}\n\nexport function getLinManifest() {\n  return _manifest;\n}\n\nexport function runtimeImport(spec) {\n  const base = path.basename(spec);\n  const reg = getLinRegistry();\n  if (reg.has(base)) return reg.get(base);\n  if (reg.has(`selfhost/${base}`)) return reg.get(`selfhost/${base}`);\n  throw new Error(`LIN_MEM: runtime import missing ${spec}`);\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  bootInMemoryLin().then(({ manifest }) => {\n    console.log(JSON.stringify({ ok: true, manifest }, null, 2));\n  }).catch((e) => {\n    console.error(e);\n    process.exit(1);\n  });\n}\n"}
