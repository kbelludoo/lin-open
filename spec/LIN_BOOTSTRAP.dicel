@DICEL:LIN_BOOTSTRAP:0.1.0

^lang="LIN"
^status="DRAFT"
^goal="separate_bootstrap_phase_from_continuous_clone_loop"

@MOTIVATION {
  issue: "Verifier/mutantes e ledger+promote só em bootstrap"
  current: "clone_lin_loop appends ledger, trauma, hypotheses and runs improveLinFromClone on every cycle"
  desired: "Bootstrap runs once: verifier + mutants + ledger init + promote. Loop runs continuously without mutating ledger/promote"
}

@BOOTSTRAP_PHASE {
  entry: "scripts/lin_bootstrap.mjs"
  when: "before starting clone-lin continuous loop"
  steps: [
    "npm test",
    "npm run test:multi",
    "self_repair smoke (verifier baseline)",
    "ledger init + promote if all gates pass",
  ]
  gates: [
    "npm test PASS",
    "npm run test:multi PASS",
    "self_repair smoke PASS",
  ]
}

@LOOP_PHASE {
  entry: "scripts/clone_lin_loop.mjs"
  allowed: "clone, rewrite, compile, behavior_eq verify, emit intel reports, candidate files"
  forbidden: "append ledger, append trauma, append hypotheses, promote candidates"
  default: "loop mode (no --bootstrap)"
}

@FLAGS {
  clone_lin_loop: "--bootstrap enables ledger/trauma/hypotheses/improve/promote (single-shot bootstrap)"
  clone_lin_loop_default: "no storage mutation; write INTEL files only"
}

@STORAGE_RULES {
  ledger: "append only during bootstrap or explicit promote command"
  trauma: "append only during bootstrap or explicit diagnose command"
  hypotheses: "created only during bootstrap or explicit research command"
  candidates: "generated during loop but NEVER promoted without bootstrap gate"
}

@IMPLEMENTED {
  I1: "scripts/lin_bootstrap.mjs runs gates and appends ledger only on bootstrap"
  I2: "scripts/clone_lin_loop.mjs accepts --bootstrap flag"
  I3: "clone_lin_loop defaults to loop mode: no ledger/trauma/hypotheses/improve writes"
  I4: "verifyMultiTargets accepts null storageDir to skip learn_new_lang storage writes"
}
