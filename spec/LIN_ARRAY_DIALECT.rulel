@RULEL:LIN_ARRAY_DIALECT:1.0.0
.description="What was added for real clones: fixed [N]int, index, LinVM, from-js brackets, from-c stub. Not whole-repo coverage."
.measured_at="2026-08-29"
.policy="recusa_nomeada=sucesso_de_gate silent_drop=falha SOURCE_GUARANTEE!=PROVED_IN_LIN"
.not_claimed=["whole_linux","whole_vscode","sha256_block","float_bit_exact","pointers","structs","unions","goroutines"]

.added{
  .syntax=["xs: [N]int","xs[i]","xs[i] = e","xs.length","xs: [N]int = [ints]"]
  .emitter="src/lin_array.lin explicit [N]i64; no name-prefix q heuristic for array vs string"
  .vm="OP load_index store_index arr_len; N>256 => VM_REJ_ARRAY_TOO_LARGE; int fns unchanged"
  .from_js="lift REJ_INDEX_BRACKET for ident[expr] and int array literals; keep REJ_OBJ_LITERAL for {"
  .from_js_rev256="REVERSE_TABLE bound to generated Stanford 8-bit reverse table; not IIFE eval"
  .from_c="src/lin_from_c.lin CLI lin from-c; REJ_C_POINTER REJ_C_STRUCT REJ_C_UNION REJ_C_FLOAT REJ_C_GOTO REJ_C_FOR"
}

.still_rej_whole_clone[
  { .code="REJ_C_POINTER" .why="u8* buffers, linux crc32, xxHash streaming" }
  { .code="REJ_C_STRUCT" .why="pcg32_random_t, XXH32_state, vscode TS AST nodes" }
  { .code="REJ_C_UNION" .why="C union punning" }
  { .code="REJ_C_FLOAT" .why="ieee754 out of bit-exact guarantee" }
  { .code="REJ_MEMBER_DOT" .why="obj.field except array .length" }
  { .code="REJ_ARROW_FN" .why="JS =>" }
  { .code="REJ_NEW_CLASS" .why="new Array IIFE fill still not executed; only REVERSE_TABLE special-bound" }
  { .code="REJ_OBJ_LITERAL" .why="{k:v} not distinguished from blocks in JS eligibility" }
  { .code="REJ_UNKNOWN_CALL" .why="exports.foo=foo shape; countTrailingZeros in bit-twiddle" }
  { .code="REJ_INDEX_BRACKET" .why="non-ident index, string keys foo[bar], nested non-int literals" }
  { .code="VM_REJ_STRING_LITERAL" .why="LinVM int/array-int only" }
  { .code="REJ_FLOAT_OUT_OF_BITEXACT" .why="focus spec" }
]

.verify{
  .build="zig build-exe src/lin.zig -O ReleaseFast -femit-bin=bin/lin_native"
  .rebuild="bin/lin_native rebuild"
  .vm_mod="bin/lin_native vm src/lin_array_kernel.lin"
  .vm_sum="bin/lin_native vm src/lin_array_kernel.lin ak_sum4"
  .expect_sum=10
  .vm_index="bin/lin_native vm src/lin_array_kernel.lin ak_index 2"
  .expect_index=30
  .vm_pop="bin/lin_native vm src/lin_array_kernel.lin ak_pop4"
  .expect_pop=10
  .vm_revb="bin/lin_native vm src/lin_array_kernel.lin ak_rev_byte 1"
  .expect_revb=128
  .vm_reverse="bin/lin_native vm src/lin_array_kernel.lin ak_reverse 1"
  .expect_reverse=2147483648
  .note_reverse="kernel i64 shl; from-js reverse(1)=-2147483648 matches Node ToInt32"
  .vm_too_big="bin/lin_native vm src/lin_array_kernel.lin ak_too_big"
  .expect_too_big="VM_REJ_ARRAY_TOO_LARGE"
  .bithacks="bin/lin_native vm src/lin_bithacks.lin bh_popcount 15"
  .expect_popcount=4
  .zig="bin/lin_native compile src/lin_array_kernel.lin --target zig -o /tmp/lin_array_kernel.zig"
  .clone_js="git clone --depth 1 https://github.com/mikolalysenko/bit-twiddle /tmp/bit-twiddle"
  .from_js="bin/lin_native from-js /tmp/bit-twiddle/twiddle.js -o /tmp/twiddle_from_js.lin"
  .from_js_rate="eligible=16 found=17 reverse=OK nextCombination=REJ_UNKNOWN_CALL"
  .from_js_reverse_oracle="Node reverse(1)=-2147483648 VM reverse(1)=-2147483648"
  .from_c_sample="printf '%s\\n' 'uint32_t popcount_2(uint32_t x){ x=x-((x>>1)&0x55555555); x=(x&0x33333333)+((x>>2)&0x33333333); return (((x+(x>>4))&0x0F0F0F0F)*0x01010101)>>24; }' > /tmp/pop4.c ; bin/lin_native from-c /tmp/pop4.c -o /tmp/pop4.lin"
}

.rate_rule="success = accepted/total ; refused functions listed with REJ_* ; never silent drop"
.proved="compare VALUES (vm vs expected); do not emit PROVED_STRUCTURAL by arity"
