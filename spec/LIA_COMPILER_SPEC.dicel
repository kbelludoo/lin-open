@DICEL:LIA_COMPILER_SPEC:1.0.0

^lang="LIA"
^ir="AIL_AST"
^semantics="LIA_SEMANTIC_CORE.dicel"
^surface="LIA + optional type_annotations"
^status="COMPILER_SPEC"
^targets=[js,ts,go]

@PIPELINE {
  step[:1]=lex_surface
  step[:2]=parse_to_AIL_AST
  step[:3]=desugar_sigils
  step[:4]=resolve_names_and_$K
  step[:5]=typecheck
  step[:6]=effect_check
  step[:7]=emit_target
  step[:8]=verify_behavior_eq_holdout
}

@LEX {
  tokens: [HEADER, SIGIL, IDENT, NUMBER, STRING, OP, PUNCT, WS]
  sigils: ["!","?","#","^",":","=ex","$K","$S","~G","@LIA"]
  reject: ["op:","call:member:","GAP:","?;"]
}

@PARSE {
  entry: Program
  error: "ParseError{line,col,msg}"
  recover: false
  output: AIL_AST
}

@TYPECHECK {
  input: AIL_AST
  rules: "LIA_SEMANTIC_CORE@TYPE_RULES"
  output: AIL_AST_typed | TypeError[]
  mode_default: "infer_Any_when_unannotated"
  mode_strict: "annotations_required_on_exports"
}

@EMIT_JS {
  Fn -> "function name(params){body}"
  If -> "if(cond){t}else if... else{e}"
  For -> "for(init;cond;step){body}"
  Return -> "return expr;"
  BinOp/UnOp/Call/Member -> JS equivalents
  ConstTable -> "const K={...};" then K.key
  exports -> "module.exports={...}" | "export {...}"
}

@EMIT_TS {
  same_as_JS
  plus: "Param types and ret from AST annotations"
}

@EMIT_GO {
  Fn -> "func name(params) ret {body}"
  Any -> "interface{}"
  Bool/Num/Str -> bool/float64/string
  Native_Math_String -> runtime helpers package ailrt
}

@VERIFY {
  method: "compile LIA -> JS; run holdout; compare to source oracle"
  pass: "behavior_eq==1.0"
  gate: "no emit if typecheck errors in strict"
}

@CLI {
  parse: "LIA parse <file.lia>"
  check: "LIA check <file.lia> [--strict]"
  emit: "LIA emit <file.lia> --target js|ts|go --out <path>"
  roundtrip: "LIA roundtrip <file.lia> --holdout <json>"
}

@FILE_LAYOUT {
  spec_semantics: "src/p9-reasoning/LIA_SEMANTIC_CORE.dicel"
  spec_surface: "src/p9-reasoning/LIA_CODE_LANG_SPEC.dicel"
  spec_compiler: "src/p9-reasoning/LIA_COMPILER_SPEC.dicel"
  declare: "DICEL.lia.dicel"
  impl_future: "scripts/pipeline/lib/ail_{lex,parse,typecheck,emit}.mjs"
}

@MILESTONES {
  M1: "DONE parse+desugar LIA safeCompare to AST/JS"
  M2: "typecheck infer mode green on gold set"
  M3: "DONE emit JS behavior_eq=1.0 vs p101c-safeCompare holdout"
  M4: "strict typed exports + TS emit"
  M5: "Go emit + ailrt"
  evidence_roundtrip: "INTEL_AIL_ROUNDTRIP_VERIFY.dicel"
}
