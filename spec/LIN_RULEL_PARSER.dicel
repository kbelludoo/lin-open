@DICEL:LIN_RULEL_PARSER:0.1.0

^lang="LIN"
^status="DRAFT"
^goal="native_RULEL_parser_and_COMMS_integration_inside_repo_LIN"

@MOTIVATION {
  priority: "Parser RULEL, COMMS no repo LIN, type-flow"
  current: "COMMS protocol references C:/Users/k/Documents/cli-master-rules/"
  desired: "Self-contained RULEL parser + COMMS validation inside lin-lang repo"
}

@RULEL_SURFACE {
  header: "@RULEL:<id>:<semver>"
  sigil_group: "~R{<key>=<value> ...}"
  blocks: ".<letter>{<key>=<value> ...}"
  keys: "single-letter keys like .m=meta .r=rule .f=forbid .a=allow"
  values: "space-separated k=v pairs; values may be quoted or bare"
}

@PARSER_SPEC {
  entry: "src/rulel_parser.mjs"
  api: "parseRulel(text) -> { header, sigils, blocks }"
  blocks: "object keyed by block letter (m, r, f, a, w, c, s, p, g, x, v)"
  values: "split on whitespace respecting quotes; k=v -> map"
}

@COMMS_INTEGRATION {
  read: "spec/COMMS_PROTOCOL.rulel"
  validate: "ensure required blocks present (.m, .r, .f, .a, .c, .s, .p)"
  cli: "node bin/lin.mjs rulel-check spec/COMMS_PROTOCOL.rulel"
}

@IMPLEMENTED {
  I1: "src/rulel_parser.mjs parses @RULEL header, ~R sigils and .x blocks"
  I2: "bin/lin.mjs rulel-check command validates RULEL files"
  I3: "COMMS_PROTOCOL.rulel passes validation"
  I4: "test added for parseRulel + validateComms"
}

@TODO {
  T1: "validate LIN_REWRITER.rulel and all .rulel files in spec/"
  T2: "type-flow: basic type inference in compiler (future)"
}
