@DICEL:LIA_CODE_LANG_SPEC:0.3.0

^name="LIA"
^alias="DICEL-L1c"
^role="DEFAULT_Dicel_for_AI_working_IR"
^replacement_of="verbose_PROJECT.dicel_L0_LLM_surface"
^canonical_profile="DICEL.lia.dicel"
^sibling_of="DICE-L PROJECT.dicel L0_archive_only"
^parent_plan="DICEL_CONTEXT_COMPRESSION_PLAN.dicel"
^parent_profile="DICEL_CONTEXT_PROFILE_SPEC.dicel"
^status="REPLACES_DICEL_LLM_SURFACE+COMPILER_BOUND"
^lossy=false
^semantics="LIA_SEMANTIC_CORE.dicel"
^compiler="LIA_COMPILER_SPEC.dicel"
^consumer="agent_prompts!intel_A/B!COMMS!default_compact_code!compiler"
^roundtrip="AIL_text <-> AIL_AST <-> target"
^emitter="scripts/pipeline/lib/ail_emitter.mjs"

@GOAL {
  token_economy: "max_saved_vs_SOURCE_and_vs_DICE_L0"
  reasoning: "accuracy_ge_SOURCE on gold_checks"
  map_from: "real_code via dicel-rewriter PROJECT.dicel samples"
}

@DESIGN_PRINCIPLES {
  P1_no_prose: "zero_human_comments_in_payload"
  P2_schema_once: "grammar_sigils_declared_once_at_head"
  P3_named_only: "drop_anonymous_and_test_suites"
  P4_sigil_ops: "control_flow_as_1char_sigils"
  P5_literal_guard: "numeric_string_error_literals_never_stripped"
  P6_same_content: "no_fake_padding_to_match_SOURCE_size"
  P7_intern_optional: "symbol_intern_only_if_net_token_win_AND_accuracy_hold"
}

@SIGILS {
  header: "@LIA:L1c:<semver>"
  fn: "!"
  if: "?"
  else: ":"
  for: "#"
  ret: "^"
  call_prefix_v1: "@"
  intern: "$S<n>=<id>"
  const_table: "$K{k=v ...}"
  exports: "=ex{name,...}"
  grammar: "~G{?=if #=for ^=ret :else}"
}

@GRAMMAR {
  program: "header meta grammar? intern* consts? fn+ exports?"
  meta: "^schema_once ^lossy=true ^ops=<csv>"
  fn: "!<name>(<params>)(->Type)?{ <stmt>;* }"
  params: "<id>(:Type)?(,...)"
  type: "Null|Bool|Num|Str|Any|Arr[T]|Map[K,V]|Fn[...]"
  stmt: "assign | if | for | ret | expr"
  if: "?(<cond>){<body>}(:(<cond>){<body>})*(:{<body>})?"
  for: "#(<init>;<cond>;<step>){<body>}"
  ret: "^<expr>"
  assign: "<id>=<expr>"
}

@ENCODING_RULES {
  R1_strip_tests: "drop describe/it/assert/bench bodies"
  R2_drop_anonymous: "drop name:'' unless export_binding"
  R3_short_envelope: "!name(a,b){...} not ~Fn{name,kind,params,body:FnBody{...}}"
  R4_js_like_idents: "keep String/Math/Buffer names unless intern wins"
  R5_const_table: "expand map/kb/mb to $K numeric table (predictables)"
  R6_no_op_prefix_noise: "forbid op:=== call:member: unary:typeof verbose L0 forms"
  R7_holes: "forbid ?; GAP:* in L1c prompt payload"
}

@VARIANTS {
  AIL_V1:
    note: "aggressive_intern $S0..$S15 + @call"
    risk: "models_may_mistranslate_$S refs"
    measured: "9/10; API_tokens_worse_than_SOURCE; fail=Q8"
  LIA:
    note: "sigils+const_table+named_only; keep readable idents"
    preferred: true
    reason: "measured_10/10_tie_SOURCE; code_-32.8%; api_-7.1%; vs_DICE_L0_code_-58.6%"
    evidence: "INTEL_AIL_TOKEN_ECONOMY_RESULT.dicel"
}

@EXAMPLE_SAFE_COMPARE {
  SOURCE_JS: "if(lenA!==strB.length){strB=strA;result=1} for(...){result|=(strA.charCodeAt(i)^strB.charCodeAt(i))} return result===0"
  DICE_L0: "if(op:!==(lenA,member:strB.length)){expr=op:=(strB,strA);expr=op:=(result,1)};... return=op:===(result,0)"
  LIA: "!safeCompare(a,b){A=String(a);B=String(b);n=A.length;r=0;?(n!=B.length){B=A;r=1};#(i=0;i<n;i++){r|=A.charCodeAt(i)^B.charCodeAt(i)};^r==0}"
}

@EXAMPLE_BYTES_PARSE {
  SOURCE_JS: "return Math.floor(map[unit]*floatValue)"
  DICE_L0: "return=call:member:Math.floor(op:*(member:map.[unit],floatValue))"
  LIA: "^Math.floor($K[u]*f)"
}

@MAP_FROM_L0 {
  input: "PROJECT.dicel (canonical)"
  pipeline: "strip_tests -> drop_anonymous -> schema_once -> short_envelope -> optional_intern -> emit @LIA"
  samples:
    - "experiments/p101c-safe-compare/.dicel-rewriter/PROJECT.dicel"
    - "experiments/p101d-bytes/.dicel-rewriter/PROJECT.dicel"
}

@MEASURE {
  harness: "scripts/pipeline/ail_as_dicel_verify.mjs"
  emitter: "scripts/pipeline/lib/ail_emitter.mjs"
  result_prior: "INTEL_AIL_TOKEN_ECONOMY_RESULT.dicel"
  result_as_dicel: "INTEL_AIL_AS_DICEL_RESULT.dicel"
  verdict: "AIL_DESIGN_VERDICT.dicel"
  estimator: "chars/4_plus_api_usage_if_present"
  forbid: "padding"
}

@DO_NOT {
  overwrite_L0_archive: true
  claim_without_gold: true
  inter_ai_prose: true
  treat_as_side_experiment: true
  compile_without_semantics: true
  holes_in_compilable_units: true
}

@AS_DICEL {
  declare: "DICEL.lia.dicel"
  verify: "INTEL_AIL_AS_DICEL_RESULT.dicel"
  default_arm: "DICEL_DEFAULT=LIA"
  note: "agents/models see LIA; L0 remains reconstructible archive"
}
