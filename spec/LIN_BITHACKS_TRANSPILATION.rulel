@RULEL:LIN_BITHACKS_TRANSPILATION:1.0.0
.description="Relatorio de clone real: o que o LIN aceitou, recusou e mediu. Nao e cobertura aspiracional."
.measured_at="2026-08-29"
.policy="recusa_nomeada=sucesso_de_gate silent_drop=falha SOURCE_GUARANTEE!=PROVED_IN_LIN"
.bit_exact="somente onde VM e oraculo Node/vetor coincidiram; Zig so ast-check"

.winner{
  .repo="https://github.com/mikolalysenko/bit-twiddle"
  .why="um arquivo twiddle.js, MIT, Stanford scalar bit hacks, exports.name=function, sem framework"
  .files="twiddle.js"
  .clone="git clone --depth 1 https://github.com/mikolalysenko/bit-twiddle"
}

.from_js{
  .cmd="bin/lin_native from-js /tmp/bt/twiddle.js -o /tmp/twiddle_from_js.lin"
  .found=17
  .eligible=16
  .ok=["sign","abs","min","max","isPow2","log2","log10","popCount","nextPow2","prevPow2","parity","reverse","interleave2","deinterleave2","interleave3","deinterleave3"]
  .rej=[
    { .name="reverse" .reason="OK" .note="REVERSE_TABLE bound to generated stanford reverse-byte [256]int; IIFE not evaled. VM reverse(1)=-2147483648 matches Node ToInt32" },
    { .name="nextCombination" .reason="REJ_UNKNOWN_CALL" .need="countTrailingZeros nao e exports.X=function" }
  ]
  .not_found=[
    { .name="countTrailingZeros" .reason="nao_exports_eq_function" .shape="function foo(){}; exports.foo=foo" }
  ]
  .hex_fold="0x.. baixado para decimal antes de jsf_eligible; senao 0x55555555 vira ident x55555555 = REJ_UNKNOWN_IDENT falso"
}

.hand_port{
  .lin="src/lin_bithacks.lin"
  .source="twiddle.js + Stanford/Hackers Delight popcount_2 + skeeto lowbias32 snippet"
  .vm_coverage{ total=25 eligible=25 rejected=0 }
}

.oracle_node_twiddle_js{
  .status=MEASURED
  .popCount{ .in=15 .node=4 .vm_fromjs=4 .vm_hand=4 }
  .popCount{ .in=255 .node=8 .vm_fromjs=8 .vm_hand=8 }
  .popCount{ .in=4294967295 .node=32 .vm_hand=32 }
  .popCount{ .in=3935318504 .hex="0xea9031e8" .bart_massey=14 .node=14 .vm_fromjs=14 .vm_hand=14 }
  .sign{ .in=-5 .node=-1 .vm_fromjs=-1 .vm_hand=-1 }
  .nextPow2{ .in=5 .node=8 .vm_fromjs=8 .vm_hand=8 }
  .prevPow2{ .in=10 .node=8 .vm_fromjs=8 .vm_hand=8 }
  .isPow2{ .in=8 .node=1 .vm_fromjs=1 .vm_hand=1 }
  .isPow2{ .in=7 .node=0 .vm_fromjs=0 .vm_hand=0 }
  .verdict="popcount/sign/nextPow2/prevPow2/isPow2 coincidiram VM vs Node. Nao e prova SMT."
}

.lowbias32{
  .source="https://github.com/skeeto/hash-prospector README snippet C"
  .status=DIVERGENT_UNPROVED
  .note="port em src/lin_bithacks.lin bh_lowbias32. VM(1)=621578565 python_u32(1)=1753845952. Nao alegar bit-exato. Possivel causa: mul i64 vs wrap u32 (DIV_001)."
}

.zig_emit{
  .cmd="bin/lin_native compile src/lin_bithacks.lin --target zig -o /tmp/lin_bithacks.zig"
  .ast_check="zig ast-check /tmp/lin_bithacks.zig exit=0"
  .from_js_ast="zig ast-check /tmp/twiddle_from_js.zig exit=0"
  .not_run="binario Zig nao foi executado contra o oraculo; ast-check != bit-exact"
}

.runners_up[
  {
    .n=1
