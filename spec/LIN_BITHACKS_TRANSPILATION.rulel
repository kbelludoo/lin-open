    .rej="XXH32(input,len) REJ_INDEX_BRACKET; streaming state struct"
  }
  {
    .n=5
    .repo="linux lib/crc32.c pecas (nao clonar o kernel)"
    .fit="crc32_le_generic de um u32 word-at-a-time sem tabela"
