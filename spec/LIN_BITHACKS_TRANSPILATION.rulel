]

.commands_tonight{
  .clone="git clone --depth 1 https://github.com/mikolalysenko/bit-twiddle"
  .from_js="bin/lin_native from-js twiddle.js -o /tmp/twiddle_from_js.lin"
  .vm_mod="bin/lin_native vm src/lin_bithacks.lin"
  .vm_run="bin/lin_native vm src/lin_bithacks.lin bh_popcount 15"
  .compile="bin/lin_native compile src/lin_bithacks.lin --target zig -o /tmp/lin_bithacks.zig"
}

.gaps[
  { .id="HEX_FALSE_REJ" .fix="jss_rewrite_hex no pipeline; sem isso taxa eligible~0 em kernels reais" }
  { .id="SILENT_DROP" .fix="jss_report agora lista .fn reason=REJ_* por exports.function" }
  { .id="EXPORT_SHAPE" .fix="so pega exports.name=function; function foo+assigns cai fora sem codigo" }
  { .id="NO_WHILE_FROMJS" .fix="jss_stmt nao baixa while/for; C popcount_naive precisa port" }
  { .id="LOWBIAS_MUL" .fix="mul u32 wrapping; ate *% no emit Zig, nao comparar com python mask apos i64" }
  { .id="ZIG_NOT_EXECUTED" .fix="ast-check != oraculo; falta harness que chama as pub fn" }
]

.next[
  { .n=1 .item="portar popcount_2 de BartMassey/popcount.c (ja equivalente a bh_popcount) e varrer os 16 testcases[] no VM" }
  { .n=2 .item="extrair XXH32_avalanche de xxHash como u32->u32" }
  { .n=3 .item="crc32 word-at-a-time so depois de array u8; ate la recusar com REJ_INDEX_BRACKET" }
  { .n=4 .item="nao clonar vscode/kernel/python; nao SHA-256 block sem [64]int" }
]
