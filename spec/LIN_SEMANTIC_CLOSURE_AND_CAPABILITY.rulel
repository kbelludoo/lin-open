@RULEL:LIN_SEMANTIC_CLOSURE_AND_CAPABILITY:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .s=score .d=design_principle .i=invariant .t=thesis}
.m{lang=LIN status=SPEC repo="C:/Users/k/Documents/lia" date=2026-08-25 why=generic_semantic_closure_and_capability_manifest_engine}
.d{
  P0=agent_native_first
  purpose=semantic_closure!dependency_transitive_fixed_point!specialization_lowering!capability_manifest_4state
  thesis="Do not write a monolithic hand-coded stdlib. Extract the minimal semantic dependency closure from source, specialize call-sites to pure LIN structures, and formally demarcate irreducible host capabilities."
}

.t{
  H_SEMANTIC_CLOSURE="Any computable program behavior whose transitive dependency graph is closed over available source can be materialized into specialized pure LIN artifacts without depending on global host stdlib objects."
  H_CAPABILITY_HONESTY="Unmaterialized primitives are not ignored or faked; they are explicitly categorized into a 4-state capability manifest (resolved, materialized, host_required, unresolved) yielding an exact ClosureCoverage metric."
}

.c{taxonomy=[
  "USER_DEFINED",
  "LIBRARY_SOURCE",
  "BUILTIN_PURE",
  "HOST_CAPABILITY",
  "UNRESOLVED"
]}

.c{manifest_states={
  resolved: "symbols whose semantic identity and type signature are recognized",
  materialized: "symbols whose executable implementation is synthesized and emitted as pure LIN",
  host_required: "irreducible host environment capabilities (e.g. Math.floor, Date.now, RegExp, DOM, Network)",
  unresolved: "symbols with missing definitions or unbounded escapes"
}}

.i{
  FIXED_POINT_CLOSURE="Closure(P) = P ∪ DirectDeps(P) ∪ DirectDeps(Closure(P)) until |Closure(P)_{n+1}| == |Closure(P)_n|"
  NO_AD_HOC_METHOD_HACKS="Never hardcode method names with ad-hoc regex transforms; all dispatch goes through CallGraph -> SymbolResolution -> Lowering/Specialization"
  CLOSURE_COVERAGE_FORMULA="ClosureCoverage = |materialized| / (|materialized| + |host_required| + |unresolved|)"
  IMMUTABLE_RUST_CORE="Semantic closure extraction and specialization executes on the compiler/emitter layer; Rust runtime nucleus remains untouched during extraction testing"
}

.c{specialization_facets=[
  "callback_escape",
  "callback_purity",
  "callback_captures",
  "receiver_shape",
  "mutation_profile",
  "return_shape"
]}

.x{
  1=parse_source_to_ast_and_symbol_table
  2=compute_transitive_dependency_closure_until_fixed_point
  3=analyze_capabilities_and_classify_all_symbols
  4=specialize_and_lower_calls_into_pure_lin_constructs
  5=emit_program_lin_plus_extracted_runtime_lin_plus_capability_manifest
  6=differential_oracle_verification_with_orthogonal_fault_isolation
}

.p{
  spec=spec/LIN_SEMANTIC_CLOSURE_AND_CAPABILITY.rulel
  engine=src/semantic_closure_engine.mjs
  test=tests/semantic_closure_engine_test.mjs
}
