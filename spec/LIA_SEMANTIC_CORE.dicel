@DICEL:LIA.SEMANTIC_CORE:1.0.0

^name="LIA"
^alias="DICEL-LIA"
^role="compilable_ai_native_code_language"
^surface="LIA_sigil_text"
^ir="AIL_AST"
^status="SPEC_FOR_COMPILER"
^lossy_surface=false
^roundtrip="AIL_text <-> AIL_AST <-> target"
^parent="LIA_CODE_LANG_SPEC.dicel"

@GOAL {
  compact: "sigil_surface_token_economy"
  semantic: "enough_types_effects_and_ops_to_compile"
  compile: "deterministic_emit_to_js_ts_go"
  preserve: "behavior_eq_on_holdout"
}

@LAYERS {
  L_surface: "LIA text (! ? # ^ $K =ex)"
  L_ast: "typed AIL_AST (this file)"
  L_target: "JS|TS|Go|Wasm"
  rule: "parser(surface)->AST; typecheck(AST); emit(AST)->target"
}

@TYPES {
  Null | Bool | Num | Str | Any
  Arr[T] | Map[K,V] | Fn[Ps...,R]
  Never
  builtin_idents: [String,Number,Math,Buffer,Array,Object,Error]
}

@EFFECTS {
  Pure | Read | Write | Throw | Native
  default_fn_effect: Pure
  native_call: Native
}

@AST {
  Program{meta:Meta, consts:ConstTable, fns:Fn[], exports:Ident[]}
  Meta{semver:str, schema_once:bool, ops:str[]}
  ConstTable{entries:Map[Ident,Lit]}
  Fn{name:Ident, params:Param[], ret:Type, effect:Effect, body:Stmt[]}
  Param{name:Ident, type:Type, optional:bool}
  Stmt =
    | Assign{id:Ident, expr:Expr}
    | If{arms:IfArm[], elseBody:Stmt[]?}
    | For{init:Stmt?, cond:Expr, step:Stmt?, body:Stmt[]}
    | Return{expr:Expr}
    | ExprStmt{expr:Expr}
  IfArm{cond:Expr, body:Stmt[]}
  Expr =
    | Lit{value:Null|Bool|Num|Str}
    | Var{name:Ident}
    | BinOp{op:BinOp, left:Expr, right:Expr}
    | UnOp{op:UnOp, expr:Expr}
    | Call{callee:Expr, args:Expr[]}
    | Member{obj:Expr, prop:Ident|Expr, computed:bool}
    | Index{obj:Expr, index:Expr}
  BinOp = eq|neq|lt|lte|gt|gte|add|sub|mul|div|mod|and|or|bitand|bitor|bitxor|shl|shr
  UnOp = not|neg|bitnot|typeof
  Lit forms_in_surface: "null|true|false|number|string"
}

@SURFACE_DESUGAR {
  "!f(a,b){...}" -> Fn{name:f, params:[a:Any,b:Any], ret:Any, body:...}
  "!(a:Num)->Num{...}" -> Fn with typed params/ret
  "?(c){t}" -> If{[IfArm{c,t}], else=none}
  "?(c){t}:{e}" -> If with else
  "#(i=0;i<n;i++){b}" -> For{Assign i=0, cond i<n, step i++, body b}
  "^e" -> Return{e}
  "$K{kb=1024 mb=1048576}" -> ConstTable
  "=ex{f,g}" -> exports
  "A.B" -> Member{A,B,false}
  "A[B]" -> Index|Member computed
  "f(x)" -> Call{f,[x]}
  "a==b|!=|<|>|+|-|*|/|%|&|^|||&&" -> BinOp
}

@TYPE_RULES {
  T_lit: "typeof Lit inferred"
  T_var: "env(name)"
  T_assign: "type(expr) <: type(id) or infer id"
  T_if: "cond:Bool; join arm body types"
  T_for: "cond:Bool; body ok"
  T_ret: "expr <: fn.ret"
  T_call: "callee:Fn; args <: params; result=R"
  T_member: "obj known -> prop lookup; else Any"
  T_binop_num: "Num op Num -> Num"
  T_binop_cmp: "T op T -> Bool"
  T_bit: "Num bitop Num -> Num"
  T_const_table: "$K[k] : Num|Str from table"
  forbid_holes: "no bare ? as expr; ? only if-sigil"
}

@OPERATIONAL_SEMANTICS {
  eval_program: "bind consts; bind fns; call exports entry"
  eval_assign: "env[id]=eval(expr)"
  eval_if: "first arm with truthy cond else elseBody"
  eval_for: "init; while cond { body; step }"
  eval_ret: "abort_frame with value"
  eval_call: "eval args; enter fn env; eval body"
  truthy: "not (null|false|0|''|NaN)"
  native: "String/Math/Buffer delegated to host"
}

@WELLFORMED {
  W1: "every Fn has unique name in Program"
  W2: "exports subset of fn names"
  W3: "no anonymous fn in compilable unit"
  W4: "no test/describe/it in Program"
  W5: "ConstTable keys unique"
  W6: "all Vars bound or builtin"
  W7: "Return only inside Fn"
  W8: "surface parses without GAP/?-holes"
}

@EXAMPLE_TYPED_SAFE_COMPARE {
  surface: "!safeCompare(a:Any,b:Any)->Bool{A=String(a);B=String(b);n=A.length;r=0;?(n!=B.length){B=A;r=1};#(i=0;i<n;i++){r|=A.charCodeAt(i)^B.charCodeAt(i)};^r==0}"
  ast_fn:
    name: safeCompare
    params: [(a,Any),(b,Any)]
    ret: Bool
    effect: Native
    note: "String.charCodeAt => Native"
}
