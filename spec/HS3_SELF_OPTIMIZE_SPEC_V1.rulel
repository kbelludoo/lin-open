@RULEL:HS3_SELF_OPTIMIZE_SPEC_V1:1.0.0
~R{.m=meta .r=rule .f=forbid .a=allow .g=gate .w=when .c=contract .x=steps .p=path .d=design_principle}
.m{lang=LIN status=FROZEN_SPEC repo="C:/Users/k/Documents/lia" date=2026-08-16 why=reflexive_runtime_self_optimization_evaluation}
.d{P0=candidate_generation_and_promotion_without_nucleus_mutation purpose=candidate_evolution!gate_enforcement!safe_promotion}

.r{
  R_CANDIDATE_GEN=synthesize_candidates_in_candidates_dir_via_reflexive_loop
  R_GATE_ENFORCEMENT=strictly_enforce_behavior_eq_ge_baseline_before_promotion
  R_IMMUTABLE_NUCLEUS=never_mutate_core_nucleus_or_verifier_invariants_during_self_optimization
  R_REGRESSION_FREE=zero_regressions_across_all_prior_gates
}

.g{
  GATE_HS3_PERFORMANCE=performance_gain_gt_zero AND behavior_eq_eq_1
  GATE_HS3_NUCLEUS=nucleus_untouched AND verifier_unmodified
  GATE_HS3_OVERALL=GATE_HS3_PERFORMANCE AND GATE_HS3_NUCLEUS
}

.f{
  mutate_immutable_nucleus_during_self_optimization
  promote_candidate_with_behavior_eq_lt_1
  introduce_silent_regressions_on_prior_workloads
}
