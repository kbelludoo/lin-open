@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="spec/LIN_GRAMMAR.peg" ext=".peg"}
.source{content="# LIN Grammar — Formal PEG Specification v1.0\n# Lingua IA Nativa — The Native AI Language for Machines\n#\n# This grammar defines the complete syntax of LIN.\n# LIN is designed for minimal token usage, deterministic parsing,\n# and multi-target compilation (JS, TS, PY, GO, RUST, C, JAVA, +13 more).\n\n# ─── Top-Level Program ───────────────────────────────────────\n\nProgram         ← Header Meta* GrammarDecl? ConstDecl? FnDecl* ExportDecl? EOF\n\n# ─── Header ──────────────────────────────────────────────────\n\nHeader          ← '@LIN:' HeaderLevel ':' Version NL\nHeaderLevel     ← 'L1c' / 'L1' / 'L2'\nVersion         ← [0-9]+ ('.' [0-9]+)*\n\n# ─── Meta Directives ────────────────────────────────────────\n\nMeta            ← '^' MetaKey ('=' MetaValue)? WS*\nMetaKey         ← Ident\nMetaValue       ← QuotedString / Ident / Number / 'true' / 'false'\n\n# ─── Grammar Sigil Declaration ───────────────────────────────\n\nGrammarDecl     ← '~G{' SigilDef (',' SigilDef)* '}'\nSigilDef        ← Sigil '=' Keyword\nSigil           ← [?#^:!$=~]\nKeyword         ← 'if' / 'for' / 'ret' / 'else' / 'fn' / 'consts' / 'exports' / 'grammar'\n\n# ─── Constants ───────────────────────────────────────────────\n\nConstDecl       ← '$K{' ConstPair (',' ConstPair)* '}'\nConstPair       ← Ident '=' Literal\n\n# ─── Function Declaration ───────────────────────────────────\n\nFnDecl          ← '!' FnName '(' ParamList? ')' ReturnType? EffectDecl? RefCapDecl? '{' Body '}'\n\nFnName          ← Ident\nParamList       ← Param (',' Param)*\nParam           ← Ident Refinement? DefaultValue?\nRefinement      ← ':' TypeName '{' Constraint (',' Constraint)* '}'\nTypeName        ← 'int' / 'str' / 'float' / 'bool' / 'list' / 'map' / 'any'\nConstraint      ← RangeConstraint / CompareConstraint / LenConstraint\n                 / 'non_empty' / 'not_null' / MatchConstraint\nRangeConstraint ← Number '..' Number\nCompareConstraint ← ('<' / '>' / '<=' / '>=') Number\nLenConstraint   ← 'len' ('<' / '>' / '<=' / '>=') Number\nMatchConstraint ← 'match=/' RegexBody '/'\nDefaultValue    ← '=' Expr\n\nReturnType      ← '->' TypeName Refinement?\n\n# ─── Effect Declaration (Koka style) ────────────────────────\n\nEffectDecl      ← '~effects{' EffectName (',' EffectName)* '}'\nEffectName      ← 'pure' / 'io' / 'state' / 'async' / 'fail'\n                 / 'random' / 'time' / 'agent'\n\n# ─── Reference Capability (Pony style) ──────────────────────\n\nRefCapDecl      ← '~cap{' RefCap '}'\nRefCap          ← 'iso' / 'val' / 'ref' / 'tag'\n\n# ─── Export Declaration ──────────────────────────────────────\n\nExportDecl      ← '=ex{' Ident (',' Ident)* '}'\n\n# ─── Body & Statements ──────────────────────────────────────\n\nBody            ← Stmt (';' Stmt)*\nStmt            ← IfStmt / ForStmt / WhileStmt / ReturnStmt\n                 / ThrowStmt / BreakStmt / AssignStmt / ExprStmt\n\n# ─── If Statement ───────────────────────────────────────────\n\nIfStmt          ← '?(' Expr ')' Block ElseIfClause* ElseClause?\nElseIfClause    ← ':?(' Expr ')' Block\nElseClause      ← ':' Block\n\n# ─── For Loop ───────────────────────────────────────────────\n\nForStmt         ← '#(' ForInit ';' Expr ';' ForStep ')' Block\nForInit         ← Ident '=' Expr\nForStep         ← Ident '=' Expr / Ident '++' / Ident '--'\n\n# ─── While Loop ─────────────────────────────────────────────\n\nWhileStmt       ← '#(;' Expr ';)' Block\n\n# ─── Return / Throw / Break ─────────────────────────────────\n\nReturnStmt      ← '^' Expr\nThrowStmt       ← 'throw' Expr\nBreakStmt       ← 'break'\n\n# ─── Assignment ─────────────────────────────────────────────\n\nAssignStmt      ← Ident AssignOp Expr\nAssignOp        ← '=' / '+=' / '-=' / '*=' / '/=' / '%='\n\n# ─── Expressions ────────────────────────────────────────────\n\nExprStmt        ← Expr\n\nExpr            ← TernaryExpr\nTernaryExpr     ← LogicalOr ('?' Expr ':' Expr)?\nLogicalOr       ← LogicalAnd ('||' LogicalAnd)*\nLogicalAnd      ← Equality ('&&' Equality)*\nEquality        ← Comparison (('==' / '!=' / '===' / '!==') Comparison)*\nComparison      ← Addition (('<' / '>' / '<=' / '>=') Addition)*\nAddition        ← Multiplication (('+' / '-') Multiplication)*\nMultiplication  ← Unary (('*' / '/' / '%') Unary)*\nUnary           ← ('!' / '-' / '++' / '--')? Postfix\nPostfix         ← Primary PostfixOp*\nPostfixOp       ← '.' Ident / '[' Expr ']' / '(' ArgList? ')' / '++' / '--'\nPrimary         ← '(' Expr ')' / ArrayLit / ObjectLit / Literal / Ident\n\nArgList         ← Expr (',' Expr)*\nArrayLit        ← '[' (Expr (',' Expr)*)? ']'\nObjectLit       ← '{' (ObjPair (',' ObjPair)*)? '}'\nObjPair         ← (Ident / QuotedString) ':' Expr\n\n# ─── Terminals ──────────────────────────────────────────────\n\nIdent           ← [A-Za-z_$] [A-Za-z0-9_$]*\nNumber          ← '-'? [0-9]+ ('.' [0-9]+)?\nQuotedString    ← '\"' (!'\"' .)* '\"' / \"'\" (!\"'\" .)* \"'\"\nRegexBody       ← (!'/' .)+\nLiteral         ← Number / QuotedString / 'true' / 'false' / 'null' / 'undefined' / 'nil'\n\nBlock           ← '{' Body '}'\n\n# ─── Whitespace & Comments ──────────────────────────────────\n\nWS              ← [ \\t]+\nNL              ← '\\r'? '\\n'\nComment         ← '//' (!NL .)*\nEOF             ← !.\n\n# ─── Semantic Hash (Unison style) ───────────────────────────\n#\n# Every function is identified by SHA-256(canonicalize(params, body)).\n# Canonicalization:\n#   1. Strip whitespace variations\n#   2. Alpha-rename params to positional ($0, $1, ...)\n#   3. Normalize ' → \", === → ==, !== → !=\n#   4. Strip trailing semicolons\n#\n# Result: 16-char hex prefix of SHA-256 digest.\n# Two functions with the same hash are semantically identical\n# regardless of naming, formatting, or file location.\n"}
