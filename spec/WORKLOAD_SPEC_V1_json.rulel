@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="spec/WORKLOAD_SPEC_V1.json" ext=".json"}
.source{content="{\n  \"spec_version\": \"WORKLOAD_SPEC_V1\",\n  \"ir_version\": \"LIN/IR/0.1\",\n  \"protocol\": \"E8_E9_CROSS_BACKEND_EQUIVALENCE\",\n  \"created_at\": \"2026-08-16T16:30:00Z\",\n  \"workloads\": [\n    {\n      \"case_id\": \"C01\",\n      \"name\": \"reduction_hashcons\",\n      \"description\": \"Deterministic algebraic folding and modular hash reduction over 10,000 recursive steps\",\n      \"ir\": {\n        \"format\": \"LIN/IR/0.1\",\n        \"entry\": \"main\",\n        \"instructions\": [\n          {\"op\": \"const_int\", \"dest\": \"r0\", \"value\": 0},\n          {\"op\": \"const_int\", \"dest\": \"r1\", \"value\": 1},\n          {\"op\": \"const_int\", \"dest\": \"r_steps\", \"value\": 10000},\n          {\"op\": \"const_int\", \"dest\": \"r_mod\", \"value\": 1000000007},\n          {\"op\": \"const_int\", \"dest\": \"r_factor\", \"value\": 7},\n          {\"op\": \"const_int\", \"dest\": \"r_acc\", \"value\": 42},\n          {\"op\": \"loop_reduce\", \"steps\": \"r_steps\", \"state\": [\"r0\", \"r1\", \"r_acc\"], \"body\": [\n            {\"op\": \"add\", \"dest\": \"r_next\", \"src1\": \"r0\", \"src2\": \"r1\"},\n            {\"op\": \"mul\", \"dest\": \"r_scaled\", \"src1\": \"r_next\", \"src2\": \"r_factor\"},\n            {\"op\": \"add\", \"dest\": \"r_acc_next\", \"src1\": \"r_acc\", \"src2\": \"r_scaled\"},\n            {\"op\": \"mod\", \"dest\": \"r_acc_mod\", \"src1\": \"r_acc_next\", \"src2\": \"r_mod\"},\n            {\"op\": \"mod\", \"dest\": \"r1_mod\", \"src1\": \"r_next\", \"src2\": \"r_mod\"},\n            {\"op\": \"set\", \"dest\": \"r0\", \"src\": \"r1\"},\n            {\"op\": \"set\", \"dest\": \"r1\", \"src\": \"r1_mod\"},\n            {\"op\": \"set\", \"dest\": \"r_acc\", \"src\": \"r_acc_mod\"}\n          ]},\n          {\"op\": \"return\", \"src\": \"r_acc\"}\n        ]\n      }\n    },\n    {\n      \"case_id\": \"C02\",\n      \"name\": \"pattern_match_ast\",\n      \"description\": \"Deterministic structural AST construction, pattern-matching classification, and rewrite pass over 2,500 nodes\",\n      \"ir\": {\n        \"format\": \"LIN/IR/0.1\",\n        \"entry\": \"main\",\n        \"instructions\": [\n          {\"op\": \"const_int\", \"dest\": \"r_nodes\", \"value\": 2500},\n          {\"op\": \"const_int\", \"dest\": \"r_acc\", \"value\": 0},\n          {\"op\": \"loop_ast_match\", \"count\": \"r_nodes\", \"state\": [\"r_acc\"], \"body\": [\n            {\"op\": \"ast_gen_node\", \"dest\": \"r_node\", \"index\": \"$idx\"},\n            {\"op\": \"ast_match_rule\", \"src\": \"r_node\", \"cases\": [\n              {\"kind\": \"Literal\", \"action\": \"add_val\", \"weight\": 3},\n              {\"kind\": \"Variable\", \"action\": \"hash_name\", \"weight\": 5},\n              {\"kind\": \"Application\", \"action\": \"recurse_both\", \"weight\": 11},\n              {\"kind\": \"Lambda\", \"action\": \"bind_and_eval\", \"weight\": 17},\n              {\"kind\": \"LetBinding\", \"action\": \"substitute\", \"weight\": 23}\n            ], \"dest\": \"r_weight\"},\n            {\"op\": \"add\", \"dest\": \"r_acc_next\", \"src1\": \"r_acc\", \"src2\": \"r_weight\"},\n            {\"op\": \"mod\", \"dest\": \"r_acc\", \"src1\": \"r_acc_next\", \"src2_imm\": 1000000007}\n          ]},\n          {\"op\": \"return\", \"src\": \"r_acc\"}\n        ]\n      }\n    },\n    {\n      \"case_id\": \"C03\",\n      \"name\": \"dag_dependency_toposort\",\n      \"description\": \"Deterministic DAG construction (500 tasks, 1,250 edges), Kahn topological ordering with tie-breaking, and state machine transition folding\",\n      \"ir\": {\n        \"format\": \"LIN/IR/0.1\",\n        \"entry\": \"main\",\n        \"instructions\": [\n          {\"op\": \"const_int\", \"dest\": \"r_task_count\", \"value\": 500},\n          {\"op\": \"dag_build_deterministic\", \"num_tasks\": \"r_task_count\", \"edge_factor\": 5, \"dest\": \"r_dag\"},\n          {\"op\": \"dag_toposort_kahn\", \"src\": \"r_dag\", \"tie_breaker\": \"lexicographical\", \"dest\": \"r_topo_order\"},\n          {\"op\": \"fold_state_transitions\", \"sequence\": \"r_topo_order\", \"init\": 1337, \"dest\": \"r_final_state\"},\n          {\"op\": \"return\", \"src\": \"r_final_state\"}\n        ]\n      }\n    }\n  ]\n}\n"}
