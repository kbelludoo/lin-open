@DICEL:LIA_SELF_REPAIR:1.1.0

^lang="LIA"
^repo="C:/Users/k/Documents/lia"
^status="MVP"
^parent="LIA_COMPILER_SPEC.dicel"
^oracle="behavior_eq==1.0 exact semantic_hash"
^immutable_core=["verifier","semantic_hash","behavior_eq_gate","LIA_gate_ge_Dicel","core_language_semantics_invariants"]
^note="@FORBID{mutate_lia_nucleus}"

@WHY_GAP {
  AIL_extracted_first_as: "lingua + emit + compile + holdout oracle"
  Dicel_kept: "P200 candidates + verify_candidate + Garden + immutable core"
  missing_until_MVP: "mutation→verify→accept loop on LIA surface"
  note_pt: "LIA nasceu como compilador/lingua; evolucao ficou no caminho L0 Dicel"
}

@LOOP {
  detect: "compile_fail | holdout_hash_mismatch | behavior_eq<1.0"
  propose: "deterministic_fixers then optional_9router_patch"
  reverify: "exact semantic_hash(original_oracle)==semantic_hash(repaired)"
  accept: "only_if behavior_eq==1.0 AND hash_match"
  reject: "any mutation of verifier/hash rule OR soft_match/padding"
}

@DETERMINISTIC_FIXERS {
  F1_strip_comments: "remove // and /* */ prose from LIA payload"
  F2_return_keyword_to_sigil: "statement-start return → ^"
  F3_ensure_terminal_return: "last fn body expr without ^/return → prefix ^"
  F4_strip_js_decls: "strip bare var/let/const inside LIA bodies"
  F5_strip_padding_lines: "drop non-LIA prose lines (no fake padding)"
}

@OPTIONAL_LLM {
  gate: "NINEROUTER_URL present in env"
  never_log: "NINEROUTER_KEY"
  patch_schema: "{op,path,old,new,reason}"
  adopt: "retry_with_verifier_feedback + structured_patch + reflexion_memory"
  max_attempts: 2
  ^R_9R: "failover_on_timeout_or_empty; try_next_model; never_block_on_one"
  models: "NINEROUTER_MODELS|DEFAULTS rotate on empty|429|5xx|timeout|abort"
}

@IMMUTABLE {
  forbid_mutate: ["semantic_hash_algo","behavior_eq_threshold","verifier_core","LIA_gate_ge_Dicel","core_language_semantics_invariants"]
  accept_writes: ["candidate_ail","ledger_report","repair_memory","emit_helpers_outside_core","scripts_without_redefining_verifier"]
  @FORBID{mutate_lia_nucleus}
  compiler_patch: "OUTSIDE_nucleus OR candidates+promote; NEVER_redefine_verifier|hash|behavior_eq|LIA_gate"
}

@CLI {
  smoke: "node scripts/self_repair.mjs --smoke"
  repair: "node scripts/self_repair.mjs --LIA <file.lia> --oracle-js <file.js|holdout>"
}

@ARTIFACTS {
  script: "scripts/self_repair.mjs"
  prior_art: "spec/LIA_SELF_REPAIR_PRIOR_ART.dicel"
  report: "INTEL_LIA_SELF_REPAIR_MVP.dicel"
}
