.m{lang=LIN status=FROZEN_SPEC ir="LIN/IR/0.1" date=2026-08-16 why=cross_backend_equivalence_workloads}
.d{P0=deterministic_cross_backend_workloads purpose=reduction_hashcons!tree_flatten!string_intern!matrix_transform}

.r{
  R_DETERMINISM=all_workloads_must_yield_identical_outputs_across_all_backends
