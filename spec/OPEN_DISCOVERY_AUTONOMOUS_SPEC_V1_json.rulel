@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="spec/OPEN_DISCOVERY_AUTONOMOUS_SPEC_V1.json" ext=".json"}
.source{content="{\n  \"spec_id\": \"OPEN_DISCOVERY_AUTONOMOUS_SPEC_V1\",\n  \"version\": \"1.0.0\",\n  \"protocol\": \"OPEN_DISCOVERY_AUTONOMOUS_EVALUATION\",\n  \"created_at\": \"2026-08-16T17:58:00Z\",\n  \"meta\": {\n    \"purpose\": \"Evaluate end-to-end autonomous discovery of an unlisted toolchain (Go 1.26 on Windows), probe execution, LIN-IR backend emission, semantic verification against canonical oracle, performance benchmarking, knowledge ledger persistence, and autonomous selection in future workloads\",\n    \"hypothesis\": \"O LIN é capaz de descobrir autonomamente uma nova toolchain no host, sintetizar um backend funcional, verificar equivalência semântica estrita, registrar o perfil no ledger de conhecimento e selecionar esse backend em decisões futuras de compilação sem intervenção manual e sem alterar o núcleo protegido.\"\n  },\n  \"phases\": [\n    { \"phase_id\": \"P1_DISCOVER\", \"name\": \"Toolchain Detection & Probe Synthesis\" },\n    { \"phase_id\": \"P2_SYNTHESIS\", \"name\": \"LIN-IR to Discovered Backend Code Emission\" },\n    { \"phase_id\": \"P3_VERIFY\", \"name\": \"Semantic Equality & Canonical Proof Verification\" },\n    { \"phase_id\": \"P4_BENCHMARK\", \"name\": \"Empirical Execution & Latency Profiling\" },\n    { \"phase_id\": \"P5_KNOWLEDGE\", \"name\": \"Structured Knowledge Ledger Update\" },\n    { \"phase_id\": \"P6_SELECTION\", \"name\": \"Autonomous Selection in Subsequent Workload Task\" }\n  ],\n  \"gates\": {\n    \"GATE_DISCOVERY_INTEGRITY\": \"Toolchain discovered and verified on host\",\n    \"GATE_EMISSION_AND_VERIFY\": \"Emitted code compiles and Output == Oracle\",\n    \"GATE_KNOWLEDGE_PERSISTENCE\": \"Empirical profile saved to knowledge ledger\",\n    \"GATE_FUTURE_SELECTION\": \"Autonomous selector chooses discovered backend for its domain\",\n    \"GATE_NUCLEUS_IMMUTABILITY\": \"nucleus_hash unmodified throughout entire cycle\"\n  }\n}\n"}
