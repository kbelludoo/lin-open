@DICEL:LIN_CLOSURES:0.1.0

^lang="LIN"
^status="DRAFT"
^scope="peripheral_compiler_emit"
^goal="raise_holdout_TS_pass_by_preserving_inner_functions_as_closures"

@MOTIVATION {
  blocker: "full_monolith_AIL_rewrite_breaks_closures"
  evidence: "INTEL_AIL_SIZE_DISK_BENCHMARK.dicel holdout TS 183/500; lodash 246/400"
  cause: "extractJsFunctions pulls nested functions as top-level, losing free-variable capture"
}

@SIGILS {
  closure: "~"
}

@GRAMMAR {
  closure_expr: "~(<params>){<stmt>;*}"
  params: "<id>(:Type)?(,...)"
  call: "<expr>(<args>)"
  assign: "<id>=<closure_expr>"
  ret: "^<expr>"
}

@SEMANTICS {
  ~x: "anonymous function expression; captures outer locals lexically"
  emit_js: "function(x){...}"
  emit_ts: "(x: T): R => {...}"
  emit_py: "lambda x: ..."
  emit_go: "func(x T) R { ... }"
  emit_rust: "|x| {...}"
  emit_c: "not_supported_keep_as_js_runtime_stub"
  emit_java: "not_supported_keep_as_runtime_stub"
}

@RESTRICTIONS {
  R1: "closure body must not contain top-level function declarations (already extracted or nested closures)"
  R2: "closure parameters cannot use destructuring"
  R3: "free variables are captured lexically; no dynamic with/eval"
  R4: "in LIN surface ~ must be followed by ( to avoid collision with ~G grammar"
}

@EXAMPLES {
  source_js: "function outer(x){ const inner = function(y){ return x+y; }; return inner(5); }"
  lin: "!outer(x){inner=~(y){^x+y};^inner(5)}"
  compiled_js: "function outer(x){var inner;inner=function(y){return x+y};return inner(5);}"
}

@IMPLEMENTED {
  I1: "extractJsFunctions keeps nested functions inside their parent body"
  I2: "applySourceSigils desugars function expressions and arrow fns to ~(params){body}"
  I3: "compiler.compileBody emits ~(params){body} as function(params){body}"
  I4: "multi-line arrow expressions are protected from ASI corruption"
  I5: "roundtrip test added for closure capture"
}

@RESULTS {
  baseline_holdout_ts: "183/500 (36.6%)"
  after_closures_v1: "207/500 (41.4%)"
  delta: "+24 fns / +4.8pp absolute / +13.1% relative"
  fails_dropped: "30 -> 22"
  generated_at: "2026-08-14"
}

@TODO {
  T1: "support async/await in closures (currently skipped as 'async')"
  T2: "handle closures returning object literals {a,b} without ASI break"
  T3: "extend closure emit to Rust/Python/Go/Java stubs"
  T4: "re-run full bench (no max-fns cap) and lodash secondary"
}
