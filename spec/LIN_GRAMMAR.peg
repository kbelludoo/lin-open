# LIN Grammar — Formal PEG Specification v1.0
# Lingua IA Nativa — The Native AI Language for Machines
#
# This grammar defines the complete syntax of LIN.
# LIN is designed for minimal token usage, deterministic parsing,
# and multi-target compilation (JS, TS, PY, GO, RUST, C, JAVA, +13 more).

# ─── Top-Level Program ───────────────────────────────────────

Program         ← Header Meta* GrammarDecl? ConstDecl? FnDecl* ExportDecl? EOF

# ─── Header ──────────────────────────────────────────────────

Header          ← '@LIN:' HeaderLevel ':' Version NL
HeaderLevel     ← 'L1c' / 'L1' / 'L2'
Version         ← [0-9]+ ('.' [0-9]+)*

# ─── Meta Directives ────────────────────────────────────────

Meta            ← '^' MetaKey ('=' MetaValue)? WS*
MetaKey         ← Ident
MetaValue       ← QuotedString / Ident / Number / 'true' / 'false'

# ─── Grammar Sigil Declaration ───────────────────────────────

GrammarDecl     ← '~G{' SigilDef (',' SigilDef)* '}'
SigilDef        ← Sigil '=' Keyword
Sigil           ← [?#^:!$=~]
Keyword         ← 'if' / 'for' / 'ret' / 'else' / 'fn' / 'consts' / 'exports' / 'grammar'

# ─── Constants ───────────────────────────────────────────────

ConstDecl       ← '$K{' ConstPair (',' ConstPair)* '}'
ConstPair       ← Ident '=' Literal

# ─── Function Declaration ───────────────────────────────────

FnDecl          ← '!' FnName '(' ParamList? ')' ReturnType? EffectDecl? RefCapDecl? '{' Body '}'

FnName          ← Ident
ParamList       ← Param (',' Param)*
Param           ← Ident Refinement? DefaultValue?
Refinement      ← ':' TypeName '{' Constraint (',' Constraint)* '}'
TypeName        ← 'int' / 'str' / 'float' / 'bool' / 'list' / 'map' / 'any'
Constraint      ← RangeConstraint / CompareConstraint / LenConstraint
                 / 'non_empty' / 'not_null' / MatchConstraint
RangeConstraint ← Number '..' Number
CompareConstraint ← ('<' / '>' / '<=' / '>=') Number
LenConstraint   ← 'len' ('<' / '>' / '<=' / '>=') Number
MatchConstraint ← 'match=/' RegexBody '/'
DefaultValue    ← '=' Expr

ReturnType      ← '->' TypeName Refinement?

# ─── Effect Declaration (Koka style) ────────────────────────

EffectDecl      ← '~effects{' EffectName (',' EffectName)* '}'
EffectName      ← 'pure' / 'io' / 'state' / 'async' / 'fail'
                 / 'random' / 'time' / 'agent'

# ─── Reference Capability (Pony style) ──────────────────────

RefCapDecl      ← '~cap{' RefCap '}'
RefCap          ← 'iso' / 'val' / 'ref' / 'tag'

# ─── Export Declaration ──────────────────────────────────────

ExportDecl      ← '=ex{' Ident (',' Ident)* '}'

# ─── Body & Statements ──────────────────────────────────────

Body            ← Stmt (';' Stmt)*
Stmt            ← IfStmt / ForStmt / WhileStmt / ReturnStmt
                 / ThrowStmt / BreakStmt / AssignStmt / ExprStmt

# ─── If Statement ───────────────────────────────────────────

IfStmt          ← '?(' Expr ')' Block ElseIfClause* ElseClause?
ElseIfClause    ← ':?(' Expr ')' Block
ElseClause      ← ':' Block

# ─── For Loop ───────────────────────────────────────────────

ForStmt         ← '#(' ForInit ';' Expr ';' ForStep ')' Block
ForInit         ← Ident '=' Expr
ForStep         ← Ident '=' Expr / Ident '++' / Ident '--'

# ─── While Loop ─────────────────────────────────────────────

WhileStmt       ← '#(;' Expr ';)' Block

# ─── Return / Throw / Break ─────────────────────────────────

ReturnStmt      ← '^' Expr
ThrowStmt       ← 'throw' Expr
BreakStmt       ← 'break'

# ─── Assignment ─────────────────────────────────────────────

AssignStmt      ← Ident AssignOp Expr
AssignOp        ← '=' / '+=' / '-=' / '*=' / '/=' / '%='

# ─── Expressions ────────────────────────────────────────────

ExprStmt        ← Expr

Expr            ← TernaryExpr
TernaryExpr     ← LogicalOr ('?' Expr ':' Expr)?
LogicalOr       ← LogicalAnd ('||' LogicalAnd)*
LogicalAnd      ← Equality ('&&' Equality)*
Equality        ← Comparison (('==' / '!=' / '===' / '!==') Comparison)*
Comparison      ← Addition (('<' / '>' / '<=' / '>=') Addition)*
Addition        ← Multiplication (('+' / '-') Multiplication)*
Multiplication  ← Unary (('*' / '/' / '%') Unary)*
Unary           ← ('!' / '-' / '++' / '--')? Postfix
Postfix         ← Primary PostfixOp*
PostfixOp       ← '.' Ident / '[' Expr ']' / '(' ArgList? ')' / '++' / '--'
Primary         ← '(' Expr ')' / ArrayLit / ObjectLit / Literal / Ident

ArgList         ← Expr (',' Expr)*
ArrayLit        ← '[' (Expr (',' Expr)*)? ']'
ObjectLit       ← '{' (ObjPair (',' ObjPair)*)? '}'
ObjPair         ← (Ident / QuotedString) ':' Expr

# ─── Terminals ──────────────────────────────────────────────

Ident           ← [A-Za-z_$] [A-Za-z0-9_$]*
Number          ← '-'? [0-9]+ ('.' [0-9]+)?
QuotedString    ← '"' (!'"' .)* '"' / "'" (!"'" .)* "'"
RegexBody       ← (!'/' .)+
Literal         ← Number / QuotedString / 'true' / 'false' / 'null' / 'undefined' / 'nil'

Block           ← '{' Body '}'

# ─── Whitespace & Comments ──────────────────────────────────

WS              ← [ \t]+
NL              ← '\r'? '\n'
Comment         ← '//' (!NL .)*
EOF             ← !.

# ─── Semantic Hash (Unison style) ───────────────────────────
#
# Every function is identified by SHA-256(canonicalize(params, body)).
# Canonicalization:
#   1. Strip whitespace variations
#   2. Alpha-rename params to positional ($0, $1, ...)
#   3. Normalize ' → ", === → ==, !== → !=
#   4. Strip trailing semicolons
#
# Result: 16-char hex prefix of SHA-256 digest.
# Two functions with the same hash are semantically identical
# regardless of naming, formatting, or file location.
