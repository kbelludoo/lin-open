@RULEL:LIN_ATTEST_SPEC:2.0.0
~R{.s=schema .c=compliance .p=provenance .d=determinism .h=hardware .k=cryptography .l=ledger .a=adversarial}
.s{
  architecture="ZERO_TRUST_PHYSICAL_SILICON_BOUND"
  type="DETERMINISTIC_SUPPLY_CHAIN_UNIFIED_LEDGER_v1.0"
  format="RULEL"
  merkle_type="HIERARCHICAL_2LEVEL_UNIFIED_MERKLE_LEDGER"
}
.h{
  execution_mode="PHYSICAL_SILICON_MULTI_KERNEL_DISPATCH"
  target_arch="gfx1030"
  runtime="AMD_ROCM_OPENCL_2.0"
  identity_schema="SEPARATED_ARCHITECTURE_AND_DEVICE_PROPERTIES"
}
.l{
  multi_kernel_policy="ALL_DISCOVERED_COMPATIBLE_KERNELS"
  aggregation_rule="BALANCED_BINARY_LEDGER_TREE"
  domain_separation="ledger:entry:idx:symbol:kernel_merkle_root"
  signature_cardinality="N_KERNELS_TO_1_SEAL"
}
.k{
  signature_algorithm="Ed25519"
  signature_size_bytes=64
  public_key_size_bytes=32
  payload_digest="SHA256"
  authority_key_mode="EXTERNAL_SECURE_KEYFILE"
}
.c{
  standards=["EU_CYBER_RESILIENCE_ACT_PROFILE", "NIST_SP_800_218_SSDF_PROFILE", "SLSA_LEVEL_4_INTEGRITY_PROFILE"]
  guarantee="MULTI_KERNEL_PHYSICAL_SILICON_ORACLE_PARITY"
}
.p{
  level1_kernel_leaves=[
    "L0: leaf:source:GitBlobOID",
    "L1: leaf:mir:MirSemanticHash",
    "L2: leaf:kernel:LoweringHash",
    "L3: leaf:input:InputCommitment",
    "L4: leaf:hardware:TargetArch:HardwareFingerprint",
    "L5: leaf:exec:cpu:CpuResult",
    "L6: leaf:exec:gpu:GpuResult",
    "L7: leaf:policy:StandardsProfile"
  ]
  level2_ledger_entries=[
    "E_i: SHA256(ledger:entry:i:kernel_symbol_i:K_i)"
  ]
}
.d{
  rule="FOR_ALL_i in [0..N-1]: R_CPU_i == R_GPU_PHYSICAL_i == R_ORACLE_i"
  precision="BIT_EXACT"
}
.a{
  vectors=[
    "MUT_SOURCE_DOC",
    "MUT_MIR_DOC",
    "MUT_KERNEL_DOC",
    "MUT_INPUT_DOC",
    "MUT_CPU_RESULT_DOC",
    "MUT_GPU_RESULT_DOC",
    "MUT_ORACLE_RESULT_DOC",
    "MUT_LEDGER_ROOT_DOC",
    "MUT_HARDWARE_FP_DOC",
    "MUT_TARGET_ARCH_DOC"
  ]
  policy="ALL_MUTATIONS_MUST_BE_REJECTED"
}
