@RULEL:LIN_ATTEST_SPEC:1.5.0
~R{.s=schema .c=compliance .p=provenance .d=determinism .k=cryptography .a=adversarial}
.s{
  architecture="ZERO_TRUST_TRIPARTITE_SEALED"
  type="DETERMINISTIC_SUPPLY_CHAIN_ATTESTATION_v0.3"
  format="JSON-LD"
  merkle_type="AUTHENTIC_PAIRWISE_BINARY_HIERARCHICAL"
}
.k{
  signature_algorithm="Ed25519"
  signature_size_bytes=64
  public_key_size_bytes=32
  payload_digest="SHA256"
  zero_trust_recomputation=true
}
.c{
  standards=["EU_CYBER_RESILIENCE_ACT_PROFILE", "NIST_SP_800_218_SSDF_PROFILE", "SLSA_LEVEL_4_INTEGRITY_PROFILE"]
  guarantee="CRYPTOGRAPHICALLY_SEALED_NON_DIVERGENT_ZERO_TRUST"
}
.p{
  chain=["repo_url", "commit_sha", "tree_sha", "source_blob_oid", "function_symbol", "input_commitment", "mir_dag", "gpu_kernel", "cpu_result", "gpu_result", "oracle_result", "merkle_root", "ed25519_signature"]
}
.d{
  rule="R_CPU(x) == R_GPU(x) == R_ORACLE(x)"
  precision="BIT_EXACT"
}
.a{
  vectors=[
    "SOURCE_MUTATION",
    "BLOB_OID_MUTATION",
    "MIR_MUTATION",
    "CPU_RESULT_MUTATION",
    "GPU_RESULT_MUTATION",
    "ORACLE_MUTATION",
    "MERKLE_MUTATION",
    "KEY_SUBSTITUTION",
    "SIGNATURE_FORGERY",
    "SINGLE_BIT_PAYLOAD_MUTATION"
  ]
  policy="ALL_FORGERIES_MUST_BE_REJECTED"
}
