@RULEL:LIN_ATTEST_SPEC:1.0.0
~R{.s=schema .c=compliance .p=provenance .d=determinism}
.s{
  type="SLSA_v1.0_PROVENANCE_AND_DETERMINISTIC_GPU_ATTESTATION"
  format="JSON-LD"
  merkle_type="AUTHENTIC_PAIRWISE_BINARY_HIERARCHICAL"
  leaf_count=11
}
.c{
  standards=["EU_CYBER_RESILIENCE_ACT", "NIST_SP_800_218", "SLSA_LEVEL_4", "SBOM_CYCLONEDX"]
  guarantee="ZERO_SILENT_MISCOMPILATIONS_AND_SUPPLY_CHAIN_CRYPTOGRAPHIC_INTEGRITY"
}
.p{
  chain=["repo_url", "commit_sha", "tree_sha", "blob_oid", "function_symbol", "input_digest", "mir_dag", "gpu_kernel", "output_digest", "oracle_digest", "execution_trace"]
}
.d{
  rule="R_CPU(x) == R_GPU(x) == R_ORACLE(x)"
  precision="BIT_EXACT"
}
