@RULEL:LIN_ATTEST_SPEC:2.4.0
~R{.s=schema .c=compliance .p=provenance .d=determinism .h=hardware .k=cryptography .l=ledger .r=reporting .b=bundle .i=isolation .m=consensus .a=adversarial}
.s{
  architecture="ZERO_TRUST_PHYSICAL_SILICON_BOUND"
  type="DETERMINISTIC_SUPPLY_CHAIN_UNIFIED_LEDGER_v1.0"
  format="RULEL"
  merkle_type="HIERARCHICAL_2LEVEL_UNIFIED_MERKLE_LEDGER"
}
.m{
  consensus_policy="MULTI_RUNTIME_CANONICAL_RECEIPT_EQUALITY"
  evaluated_runtimes=[
    "RUNTIME_1: HOST_NATIVE_EXECUTION",
    "RUNTIME_2: HERMETIC_CLEANROOM_ENV_SANITIZED",
    "RUNTIME_3: SANDBOXED_PROCESS_JAIL"
  ]
  invariance_invariant="FOR_ALL_Rj: SHA256(CanonicalReceipt_Rj) == ConsensusReceiptDigest"
}
.b{
  bundle_format="RULEL_CANONICAL_AUDIT_BUNDLE_v1.0"
  replay_modes=["AIRGAP_CRYPTOGRAPHIC_REPLAY", "PHYSICAL_SILICON_REPLICATION"]
  receipt_schema="THIRD_PARTY_AUDIT_RECEIPT_v1.0"
}
.i{
  cleanroom_reproducibility="HERMETIC_OCI_CONTAINER_SANDBOX_v1.0"
  runtime_requirements=["CPU_ONLY", "ZERO_GPU_DRIVER_DEPENDENCY", "ENV_SANITIZED"]
  isolation_policy="STRIPPED_ENVIRONMENT_VARIABLES_READONLY_BUNDLE"
}
.h{
  execution_mode="PHYSICAL_SILICON_MULTI_KERNEL_DISPATCH"
  target_arch="gfx1030"
  runtime="AMD_ROCM_OPENCL_2.0"
  identity_schema="SEPARATED_ARCHITECTURE_AND_DEVICE_PROPERTIES"
}
.l{
  multi_kernel_policy="ALL_DISCOVERED_COMPATIBLE_KERNELS"
  aggregation_rule="BALANCED_BINARY_LEDGER_TREE"
  domain_separation="ledger:entry:idx:symbol:kernel_merkle_root"
  signature_cardinality="N_KERNELS_TO_1_SEAL"
  permutation_invariance_rule="STRICT_ORDER_BOUND_E_i_SERIALIZATION"
}
.r{
  report_types=["TECHNICAL_CONTROL_EVIDENCE_SUMMARY", "AUDIT_EVIDENCE_MATRIX", "CYCLONEDX_SPDX_SBOM"]
  supported_regulations=[
    "EU_CYBER_RESILIENCE_ACT_ARTICLE_10",
    "NIST_SP_800_218_SSDF_v1.1",
    "SLSA_PROVENANCE_AND_INTEGRITY_MAPPING"
  ]
}
.k{
  signature_algorithm="Ed25519"
  signature_size_bytes=64
  public_key_size_bytes=32
  payload_digest="SHA256"
  authority_key_mode="EXTERNAL_SECURE_KEYFILE"
}
.c{
  standards=["EU_CYBER_RESILIENCE_ACT_PROFILE", "NIST_SP_800_218_SSDF_PROFILE", "SLSA_INTEGRITY_MAPPING_PROFILE"]
  guarantee="MULTI_KERNEL_PHYSICAL_SILICON_ORACLE_PARITY"
}
.p{
  level1_kernel_leaves=[
    "L0: leaf:source:GitBlobOID",
    "L1: leaf:mir:MirSemanticHash",
    "L2: leaf:kernel:LoweringHash",
    "L3: leaf:input:InputCommitment",
    "L4: leaf:hardware:TargetArch:HardwareFingerprint",
    "L5: leaf:exec:cpu:CpuResult",
    "L6: leaf:exec:gpu:GpuResult",
    "L7: leaf:policy:StandardsProfile"
  ]
  level2_ledger_entries=[
    "E_i: SHA256(ledger:entry:i:kernel_symbol_i:K_i)"
  ]
}
.d{
  rule="FOR_ALL_i in [0..N-1]: R_CPU_i == R_GPU_PHYSICAL_i == R_ORACLE_i"
  precision="BIT_EXACT"
}
.a{
  vectors=[
    "MUT_SOURCE_DOC",
    "MUT_KERNEL_0_MIR",
    "MUT_KERNEL_1_NAME",
    "MUT_KERNEL_2_CPU_RES",
    "MUT_KERNEL_3_GPU_RES",
    "MUT_INPUT_DOC",
    "MUT_LEDGER_ROOT_DOC",
    "MUT_HARDWARE_FP_DOC",
    "MUT_TARGET_ARCH_DOC",
    "MUT_KERNEL_COUNT_DOC",
    "MUT_KERNEL_PERMUTATION_SWAP",
    "MUT_BUNDLE_TAMPERED_PUBKEY"
  ]
  policy="ALL_MUTATIONS_MUST_BE_REJECTED"
}
