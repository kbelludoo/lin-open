@RULEL:REAL_SELF_HOSTING_BOOTSTRAP_SPEC:1.0
~ARCH{target="x86_32_freestanding_multiboot1" engine="lin_self_compiler" vm="qemu_system_x86_64"}
~STAGES{
  stage0="Initial bootstrap compiler engine"
  stage1="Compiler_0 compiles src/compiler.lin -> Compiler_1"
  stage2="Compiler_1 compiles src/compiler.lin -> Compiler_2"
  stage3="Compiler_2 compiles src/compiler.lin -> Compiler_3"
  fixed_point="Assert Compiler_2.code == Compiler_3.code and Compiler_2.AST == Compiler_3.AST"
  kernel_gen="Compiler_2 AST node-by-node lowering of kernel/lin_kernel.lin to x86 assembly"
  qemu_boot="NASM + LD -> bin/lin_kernel.elf -> QEMU serial verification"
}
.invariants{
  no_hardcoded_asm="Assembly must be derived from traversing AST statements of kernel.lin"
  pure_fixed_point="Stage 2 and Stage 3 must be generated by the preceding compiled compiler"
  honest_target="Classified strictly as x86_32_freestanding_multiboot1 executed on QEMU x86_64"
}
