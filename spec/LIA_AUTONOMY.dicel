@DICEL:LIA_AUTONOMY:1.1.0

^lang="LIA"
^repo="C:/Users/k/Documents/lia"
^status="SPEC_ACTIVE"
^parent="LIA_SUPERSEDES_DICEL.rulel"
^goal="all_Dicel_AI_capabilities_plus_better_plus_auto_improve_evolve"
^LIA_gate="strictly_ge_Dicel"
^immutable_core=NEVER_alter_LIA_nucleus

@SUPERSET_OF_DICEL {
  code_IR: "LIA (was Dicel L0/L1)"
  multi_compile: "js|ts|py|go|rust"
  semantic_hash: "exact"
  behavior_eq: "1.0 holdout"
  self_repair: "MVP→full (fix compiler not LIA; outside nucleus)"
  evolution_garden: "candidates_only + verify + promote"
  ledger: "storage/lia_ledger.dicel"
  trauma_memory: "storage/lia_trauma.dicel"
  knowledge: "storage/lia_knowledge.dicel"
  hypotheses: "storage/lia_hypotheses.dicel"
  ingest_assess: "clone_queue + gap_map"
  autonomy_loop: "P201-shaped inside lia"
  rules_pair: "RULEL (not Dicel @LAW)"
}

@AUTO_IMPROVE {
  trigger: "compile_fail | behavior_eq<1 | LIA_worse_than_Dicel | trauma_class_repeat"
  action: "Hypothesis → mutate compiler|emit|runtime OUTSIDE_nucleus → prove gates → distill"
  forbid: "edit_LIA_to_appease_emitter | mutate_lia_nucleus | redefine_verifier_or_hash"
  memory: "persist trauma+hypothesis across runs"
  measure: "transfer_lift + trauma_compress + holdout"
}

@AUTO_EVOLVE {
  engine: "scripts/evolve_loop.mjs"
  mutate: "candidates/ only"
  core_immutable: [verifier, semantic_hash, behavior_eq_gate, LIA_gate_ge_Dicel, core_language_semantics_invariants]
  promote: "all_prove_gates AND U>U_baseline AND LIA_ge_Dicel AND never_redefine_nucleus"
  merge: "FORBIDDEN_without_gates"
  schedule: "lia evolve --queue corpus/queue.dicel"
}

@IMMUTABLE_CORE {
  never_edit: [verifier, semantic_hash, behavior_eq_gate, LIA_gate_ge_Dicel, core_language_semantics_invariants]
  @FORBID{mutate_lia_nucleus}
}

@MAY_MUTATE {
  ok: [candidates/, emit_helpers_outside_core, documented_non_core_surfaces, storage/lia_trauma, storage/lia_ledger, storage/lia_knowledge, storage/lia_hypotheses, scripts_that_do_not_redefine_verifier]
  compiler_patch: "OUTSIDE_nucleus OR candidates+promote; NEVER_redefine_verifier|semantic_hash|behavior_eq|LIA_gate"
}

@LOOP {
  stage[:1]=INGEST { sources=[failures,ledger,trauma,knowledge,corpus_queue] }
  stage[:2]=ASSESS { gap_map, LIA_vs_Dicel_metrics, secret_scan }
  stage[:3]=IMPROVE { learn_loop fix_compiler_outside_nucleus }
  stage[:4]=EVOLVE { garden candidates }
  stage[:5]=VERIFY { behavior_eq, regression, LIA_ge_Dicel, nucleus_untouched }
  stage[:6]=DISTILL { trauma→rules, promote emitter patches non_core }
}

@MILESTONES {
  M0: "EVIDENCE 2026-08-13 — multi_emit+roundtrip+self_repair_MVP; size bench PARTIAL (NOT full green)"
  M0_evidence: {
    reports: [INTEL_AIL_SIZE_DISK_BENCHMARK.dicel, INTEL_AIL_400K_ROUNDTRIP.dicel]
    holdout_ts: "183/500 (36.6%)"
    lodash_isolated: "246/400 (61.5%)"
    lodash_real_tests_baseline: PASS
    lodash_public_api_lia: "1/14"
    claim_full_lodash_green: false
    trauma: [CLOSURE, HOLDING_GAP]
    fix_target: compiler_not_lia
  }
  M0_next_gap: "closures / full-repo suite (raise public-API+holdout without soft_match)"
  M1: "ACTIVE storage/{ledger,trauma,knowledge,hypotheses} seeded from 400k bench"
  M2: "evolve_loop.mjs green on safe-compare+bytes"
  M3: "continuous LIA_vs_Dicel dashboard INTEL"
  M4: "Dicel AI surfaces drained; Dicel=archive only"
}

@CLI {
  autonomy: "lin autonomy [--cycles N] [--clone-cycles N]  # toolchains+improve+evolve+clone-lin+expose INTEL"
  improve: "lin improve"
  evolve: "lin evolve"
  clone_lin: "lin clone-lin"
  status: "lin autonomy-status"
  vs_dicel: "lia vs-dicel --bench <path>"
  expose: "INTEL_LIN_AUTONOMY_RUN.dicel"
}
