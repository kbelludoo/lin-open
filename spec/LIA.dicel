@DICEL:DICEL.lia:1.0.0

^role="LIA_as_Dicel_compilable_lingua"
^surface="LIA"
^semantics="LIA_SEMANTIC_CORE.dicel"
^compiler="LIA_COMPILER_SPEC.dicel"
^status="DECLARED"

@DECLARE {
  dicel_for_ai: "LIA"
  human_verbose_L0: "archive_only_PROJECT.dicel"
  compilable: true
  requires_semantics: true
}

@CONTRACT {
  every_compilable_unit:
    - parses_to_LIA_AST
    - passes_WELLFORMED
    - typecheck_infer_or_strict
    - emits_to_at_least_js
    - behavior_eq_holdout
}

@TYPED_SURFACE_EXTENSION {
  optional_annotations: "!f(a:Num,b:Str)->Bool{...}"
  required_for_strict_compiler: "exports annotated"
  default_unannotated: "Any"
}

@EXAMPLE {
  "!add(a:Num,b:Num)->Num{^a+b}"
  "!safeCompare(a:Any,b:Any)->Bool{A=String(a);B=String(b);n=A.length;r=0;?(n!=B.length){B=A;r=1};#(i=0;i<n;i++){r|=A.charCodeAt(i)^B.charCodeAt(i)};^r==0}"
}
