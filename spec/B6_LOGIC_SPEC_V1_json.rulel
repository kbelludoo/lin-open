.source{content="{\n  \"spec_id\": \"B6_LOGIC_V1\",\n  \"name\": \"Deductive Agent Capability & Policy Inference\",\n  \"domain\": \"Logic Paradigm Evaluation\",\n  \"version\": \"1.0.0\",\n  \"created_at\": \"2026-08-16T16:50:00Z\",\n  \"knowledge_base\": {\n    \"constants\": {\n      \"agents\": [\"ag_01\", \"ag_02\", \"ag_03\", \"ag_04\", \"ag_05\", \"ag_06\", \"ag_07\", \"ag_08\", \"ag_09\", \"ag_10\"],\n      \"capabilities\": [\"cap_read\", \"cap_write\", \"cap_audit\", \"cap_delegate\", \"cap_transform\"],\n      \"domains\": [\"dom_sandbox\", \"dom_isolated\", \"dom_gateway\", \"dom_nucleus\"]\n    },\n    \"facts\": [\n      {\"rel\": \"has_capability\", \"args\": [\"ag_01\", \"cap_read\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_01\", \"cap_write\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_01\", \"cap_delegate\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_02\", \"cap_read\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_02\", \"cap_transform\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_03\", \"cap_audit\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_04\", \"cap_read\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_04\", \"cap_delegate\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_05\", \"cap_transform\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_06\", \"cap_write\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_07\", \"cap_audit\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_08\", \"cap_read\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_09\", \"cap_transform\"]},\n      {\"rel\": \"has_capability\", \"args\": [\"ag_10\", \"cap_delegate\"]},\n\n      {\"rel\": \"in_domain\", \"args\": [\"ag_01\", \"dom_nucleus\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_02\", \"dom_gateway\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_03\", \"dom_isolated\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_04\", \"dom_gateway\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_05\", \"dom_sandbox\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_06\", \"dom_nucleus\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_07\", \"dom_isolated\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_08\", \"dom_sandbox\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_09\", \"dom_gateway\"]},\n      {\"rel\": \"in_domain\", \"args\": [\"ag_10\", \"dom_nucleus\"]},\n\n      {\"rel\": \"contract_active\", \"args\": [\"ag_01\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_02\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_04\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_05\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_06\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_08\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_09\"]},\n      {\"rel\": \"contract_active\", \"args\": [\"ag_10\"]},\n\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_01\", \"ag_02\", 4]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_01\", \"ag_04\", 5]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_02\", \"ag_05\", 3]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_04\", \"ag_08\", 4]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_04\", \"ag_09\", 2]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_06\", \"ag_01\", 5]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_06\", \"ag_07\", 3]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_07\", \"ag_03\", 4]},\n      {\"rel\": \"trust_edge\", \"args\": [\"ag_10\", \"ag_06\", 4]}\n    ],\n    \"rules\": [\n      {\n        \"head\": {\"rel\": \"direct_delegate\", \"args\": [\"?A\", \"?B\", \"?Cap\"]},\n        \"body\": [\n          {\"rel\": \"has_capability\", \"args\": [\"?A\", \"cap_delegate\"]},\n          {\"rel\": \"has_capability\", \"args\": [\"?A\", \"?Cap\"]},\n          {\"rel\": \"trust_edge\", \"args\": [\"?A\", \"?B\", \"?Level\"], \"guard\": \"?Level >= 3\"},\n          {\"rel\": \"contract_active\", \"args\": [\"?B\"]}\n        ]\n      },\n      {\n        \"head\": {\"rel\": \"chain_delegate\", \"args\": [\"?A\", \"?B\", \"?Cap\"]},\n        \"body\": [\n          {\"rel\": \"direct_delegate\", \"args\": [\"?A\", \"?B\", \"?Cap\"]}\n        ]\n      },\n      {\n        \"head\": {\"rel\": \"chain_delegate\", \"args\": [\"?A\", \"?C\", \"?Cap\"]},\n        \"body\": [\n          {\"rel\": \"direct_delegate\", \"args\": [\"?A\", \"?B\", \"cap_delegate\"]},\n          {\"rel\": \"chain_delegate\", \"args\": [\"?B\", \"?C\", \"?Cap\"]}\n        ]\n      }\n    ]\n  },\n  \"query\": {\n    \"goal\": \"chain_delegate(?Origin, ?Target, ?Cap)\",\n    \"ordered_projection\": [\"?Origin\", \"?Target\", \"?Cap\"]\n  },\n  \"oracle\": {\n    \"type\": \"deductive_datalog_sld_fixedpoint\",\n    \"description\": \"Exhaustive deterministic resolution with lexicographical solution sort\"\n  },\n  \"validation_gates\": {\n    \"input_integrity\": \"engine_input_hash == expected_input_hash\",\n    \"solution_correctness\": \"engine_result_hash == oracle_result_hash\",\n    \"determinism\": \"3_consecutive_runs_bit_identical\",\n    \"termination\": \"completes_without_infinite_loop_under_5000ms\"\n  },\n  \"diagnostics_metrics\": [\n    \"search_nodes_explored\",\n    \"backtrack_count\",\n    \"unifications_attempted\",\n    \"unifications_succeeded\",\n    \"resolution_wall_time_us\",\n    \"peak_memory_bytes\"\n  ]\n}\n"}
