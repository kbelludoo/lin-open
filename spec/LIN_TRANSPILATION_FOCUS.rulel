@RULEL:LIN_TRANSPILATION_FOCUS:1.0.0
.description="Onde o LIN se sai melhor e o que o transpilador deve aceitar, recusar ou adiar"
.depends="spec/LIN_CANONICAL_TRINITY.rulel spec/EPISTEMIC_HYGIENE_RULES.rulel"
.win_condition="bit_exact_integer_kernel with named_oracle"
.lose_condition="silent_drop OR float_bit_exact_claim OR general_purpose_coverage"

.domain{
  .accept=["hash","checksum","codec","compress_int","prng","bit_twiddle","vm_dispatch","block_cipher_int32"]
  .defer=["matrix_int_after_array_dialect","sha256_compress_after_array"]
  .refuse=["ieee754_bit_exact","gui","network","gc_runtime","dynamic_dispatch","sql","ml_training"]
  .why="LIN hoje e i64/string/bool mais [N]int fixo. Bit-exato e pergunta bem formada para inteiro puro sem runtime; ponteiro/struct/float fora."
}

.source{
  .primary={ lang="C" why="nucleos bit-exatos do mundo, ABI clara, vetores NIST/RFC, sem excecao/despacho" }
  .semantic_best={ lang="Zig" why="overflow no operador, sem alocacao oculta" caveat="comptime exige avaliador; sem comptime e otimo" }
  .high_value_low_coverage={ lang="Rust" why="borrow_checker entrega NO_ALIASING como SOURCE_GUARANTEE" caveat="traits/generics/Drop/panic fora do subconjunto" }
  .oracle_only={ lang="JavaScript" why="corpus e oraculo Node existem; semantica ToInt32 so no subconjunto jsf_eligible" }
  .refuse=["Python","Lua_tables","Go_runtime","Crystal","TypeScript_full","C++_templates"]
}

.target{
  .emit="Zig"
  .ffi="C_ABI only after export+callconv_C on int functions"
  .oracle_port="WASM integer ops"
  .never_perf=["JavaScript"]
}

.eligibility{
  .scalar_int_fn=ACCEPT
  .string_key_hash=REJECT reason=VM_REJ_PARAM_NOT_INT
  .array_index=ACCEPT when="ident[int_expr] on [N]int N<=256" else=REJECT reason=REJ_INDEX_BRACKET
  .member_dot=REJECT reason=REJ_MEMBER_DOT except="array.length"
  .arrow_fn=REJECT reason=REJ_ARROW_FN
  .constructor=REJECT reason=REJ_CONSTRUCTOR
  .unknown_call=REJECT reason=REJ_UNKNOWN_CALL
  .signed_overflow_ub=REJECT reason=REJ_UNDEF_SIGNED_OVERFLOW
  .float=REJECT reason=REJ_FLOAT_OUT_OF_BITEXACT
  .policy="recusa nomeada nunca conta como sucesso; taxa = aceitas/total"
}

.focus_order[
  { .n=1 .task="kernels C de inteiro com vetores oficiais (SHA-256 NIST, murmur, crc, popcount)" }
  { .n=2 .task="funcoes jsf_eligible de JS escalar; reportar gaps por codigo de motivo" }
  { .n=3 .task="Zig sem comptime no mesmo dominio" }
  { .n=4 .task="fixed [N]int in dialect (done: params/locals/index/LinVM); still no pointers/structs; sha256_block still deferred until u8 buffers" }
  { .n=5 .task="nunca priorizar cobertura de repo (vscode 12k) sobre oraculo nomeado" }
]

.verification{
  .n1_structural="classificar por opcode; linear/afim so apos sintaxe nos DOIS lados; comparar VALORES nao so execucao"
  .n2_smt="QF_BV miter VM xor Zig; UNSAT prova, SAT devolve contraexemplo"
  .n3_audit="varredura/checksum so quando estrutura e SMT nao cabem"
  .forbidden="PROVED_STRUCTURAL por aridade de parametros; expected_outputs nao medidos; oracle=undefined"
}

.agent_must[
  "Transpilar o que o dialeto expressa (escalar int e [N]int)."
  "Emitir REJ_* com causa; nunca strip silencioso."
  "SOURCE_GUARANTEE separado de PROVED_IN_LIN."
  "Nao alegar bit-exato em float nem ABI C sem export."
]
