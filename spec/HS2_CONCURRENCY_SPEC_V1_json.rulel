@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="spec/HS2_CONCURRENCY_SPEC_V1.json" ext=".json"}
.source{content="{\n  \"spec_id\": \"HS2_CONCURRENCY_SPEC_V1\",\n  \"version\": \"1.0.0\",\n  \"protocol\": \"HS2_CONCURRENT_SHARED_STATE_EVALUATION\",\n  \"created_at\": \"2026-08-16T17:49:00Z\",\n  \"meta\": {\n    \"purpose\": \"Evaluate linearizability, race-condition safety, stale-read rejection, and state reconciliation in LIN multi-agent concurrent state management\",\n    \"hypothesis\": \"O mediador semântico LIN preserva linearizabilidade atômica e zero efeitos ilegais sob disputas concorrentes e mutações dinâmicas de estado entre múltiplos agentes.\"\n  },\n  \"scenarios\": [\n    {\n      \"scenario_id\": \"C01\",\n      \"name\": \"concurrent_write_after_write_collision\",\n      \"interleaving_id\": \"I001\",\n      \"agents\": [\"ag_001\", \"ag_002\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"STATE_WRITE\", \"target\": \"rec_balance\", \"val\": \"100\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_002\", \"type\": \"STATE_WRITE\", \"target\": \"rec_balance\", \"val\": \"200\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"rec_balance_deterministic\": true, \"no_corrupt_partial_write\": true }\n    },\n    {\n      \"scenario_id\": \"C02\",\n      \"name\": \"stale_read_modify_write_race\",\n      \"interleaving_id\": \"I002\",\n      \"agents\": [\"ag_001\", \"ag_002\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"STATE_READ\", \"target\": \"rec_quota\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_002\", \"type\": \"STATE_WRITE\", \"target\": \"rec_quota\", \"val\": \"exhausted\", \"step\": 2 },\n        { \"op_id\": \"OP_03\", \"agent\": \"ag_001\", \"type\": \"STATE_WRITE\", \"target\": \"rec_quota\", \"val\": \"decremented\", \"based_on_step\": 1, \"step\": 3 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"stale_write_rejected\": true, \"rec_quota\": \"exhausted\" }\n    },\n    {\n      \"scenario_id\": \"C03\",\n      \"name\": \"in_flight_policy_revocation_during_deploy\",\n      \"interleaving_id\": \"I003\",\n      \"agents\": [\"ag_001\", \"ag_003\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"PREPARE_DEPLOY\", \"target\": \"art_nucleus\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_003\", \"type\": \"REVOKE_POLICY\", \"target\": \"POL_DEPLOY_NUCLEUS\", \"step\": 2 },\n        { \"op_id\": \"OP_03\", \"agent\": \"ag_001\", \"type\": \"COMMIT_DEPLOY\", \"target\": \"art_nucleus\", \"step\": 3 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"deploy_blocked_obsolete_plan\": true, \"art_nucleus_deployed\": false }\n    },\n    {\n      \"scenario_id\": \"C04\",\n      \"name\": \"mutual_delegation_deadlock_prevention\",\n      \"interleaving_id\": \"I004\",\n      \"agents\": [\"ag_004\", \"ag_005\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_004\", \"type\": \"ACQUIRE_LOCK_DELEGATE\", \"target\": \"res_A\", \"delegating_to\": \"ag_005\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_005\", \"type\": \"ACQUIRE_LOCK_DELEGATE\", \"target\": \"res_B\", \"delegating_to\": \"ag_004\", \"step\": 1 },\n        { \"op_id\": \"OP_03\", \"agent\": \"ag_004\", \"type\": \"ACQUIRE_LOCK_DELEGATE\", \"target\": \"res_B\", \"step\": 2 },\n        { \"op_id\": \"OP_04\", \"agent\": \"ag_005\", \"type\": \"ACQUIRE_LOCK_DELEGATE\", \"target\": \"res_A\", \"step\": 2 }\n      ],\n      \"linearization_class\": \"DEADLOCK_FREE_TOTAL_ORDER\",\n      \"expected_final_invariants\": { \"deadlock_detected_and_resolved\": true, \"zero_hangs\": true }\n    },\n    {\n      \"scenario_id\": \"C05\",\n      \"name\": \"concurrent_capability_revocation_and_use\",\n      \"interleaving_id\": \"I005\",\n      \"agents\": [\"ag_002\", \"ag_006\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_006\", \"type\": \"REVOKE_CAPABILITY\", \"target_agent\": \"ag_002\", \"cap\": \"cap_transform\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_002\", \"type\": \"DISPATCH_RPC\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"rpc_blocked_or_atomic_precedes\": true, \"no_illegal_post_revocation_rpc\": true }\n    },\n    {\n      \"scenario_id\": \"C06\",\n      \"name\": \"multi_agent_concurrent_ledger_append\",\n      \"interleaving_id\": \"I006\",\n      \"agents\": [\"ag_001\", \"ag_002\", \"ag_003\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"LEDGER_APPEND\", \"entry\": \"event_A\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_002\", \"type\": \"LEDGER_APPEND\", \"entry\": \"event_B\", \"step\": 1 },\n        { \"op_id\": \"OP_03\", \"agent\": \"ag_003\", \"type\": \"LEDGER_APPEND\", \"entry\": \"event_C\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"MONOTONIC_TOTAL_ORDER\",\n      \"expected_final_invariants\": { \"ledger_length\": 3, \"entries_intact\": true, \"hash_chain_valid\": true }\n    },\n    {\n      \"scenario_id\": \"C07\",\n      \"name\": \"domain_lockdown_race_against_cross_domain_rpc\",\n      \"interleaving_id\": \"I007\",\n      \"agents\": [\"ag_007\", \"ag_004\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_007\", \"type\": \"EMERGENCY_LOCK_DOMAIN\", \"domain\": \"dom_gateway\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_004\", \"type\": \"CROSS_DOMAIN_MIGRATION\", \"domain\": \"dom_gateway\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"migration_diverted_or_blocked\": true, \"lockdown_respected\": true }\n    },\n    {\n      \"scenario_id\": \"C08\",\n      \"name\": \"concurrent_grant_transfer_cycle\",\n      \"interleaving_id\": \"I008\",\n      \"agents\": [\"ag_008\", \"ag_009\", \"ag_010\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_008\", \"type\": \"TRANSFER_GRANT\", \"to\": \"ag_009\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_009\", \"type\": \"TRANSFER_GRANT\", \"to\": \"ag_010\", \"step\": 1 },\n        { \"op_id\": \"OP_03\", \"agent\": \"ag_010\", \"type\": \"TRANSFER_GRANT\", \"to\": \"ag_008\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"CYCLE_SAFE_TOPOLOGICAL\",\n      \"expected_final_invariants\": { \"cyclic_ownership_prevented\": true, \"single_valid_grant_holder\": true }\n    },\n    {\n      \"scenario_id\": \"C09\",\n      \"name\": \"optimistic_storage_mutation_conflict_and_retry\",\n      \"interleaving_id\": \"I009\",\n      \"agents\": [\"ag_001\", \"ag_005\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"OPT_WRITE\", \"key\": \"tbl_user\", \"ver\": 1, \"data\": \"u1\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_005\", \"type\": \"OPT_WRITE\", \"key\": \"tbl_user\", \"ver\": 1, \"data\": \"u2\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"OCC_VERSIONED_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"one_committed_one_conflicted\": true, \"rollback_consistent\": true }\n    },\n    {\n      \"scenario_id\": \"C10\",\n      \"name\": \"cascading_revocation_under_active_delegation_tree\",\n      \"interleaving_id\": \"I010\",\n      \"agents\": [\"ag_001\", \"ag_004\", \"ag_008\"],\n      \"operations\": [\n        { \"op_id\": \"OP_01\", \"agent\": \"ag_001\", \"type\": \"CASCADE_REVOKE_ROOT\", \"target_root\": \"ag_004\", \"step\": 1 },\n        { \"op_id\": \"OP_02\", \"agent\": \"ag_008\", \"type\": \"EXECUTE_DOWNSTREAM_ACTION\", \"via_grant_from\": \"ag_004\", \"step\": 1 }\n      ],\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"expected_final_invariants\": { \"downstream_aborted_or_clean\": true, \"cascade_invariants_preserved\": true }\n    }\n  ],\n  \"gates\": {\n    \"GATE_HS2_SAFETY\": \"invariant_violations == 0 && escaped_illegal_effects == 0\",\n    \"GATE_HS2_CONSISTENCY\": \"state_reconciliation == true && linearizability == true\",\n    \"GATE_HS2_LIVENESS\": \"deadlocks_observed == 0 && timeouts_observed == 0\"\n  }\n}\n"}
