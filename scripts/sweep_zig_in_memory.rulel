@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="scripts/sweep_zig_in_memory.mjs" lang="mjs"}
.source{content="// LIN Repository-Wide Zig In-Memory Compilation & Execution Sweep\n// Spec: spec/LIN_IR_CROSS_BACKEND.rulel\n\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { parseProgram } from '../src/parser.mjs';\nimport { compile } from '../src/compiler.mjs';\nimport { runInMemoryZig } from '../src/vm_zig.mjs';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst ROOT = path.resolve(path.dirname(__filename), '..');\nconst RESULTS_DIR = path.join(ROOT, 'results/sweep_zig_in_memory');\n\nexport async function sweepZigInMemory() {\n  console.log(\"================================================================================\");\n  console.log(\"   SWEEP GLOBAL DE PROJETOS LIN -> COMPILAÇÃO & EXECUÇÃO EM MEMÓRIA (ZIG)     \");\n  console.log(\"================================================================================\");\n\n  fs.mkdirSync(RESULTS_DIR, { recursive: true });\n\n  // 1. Discover all .lin and .lia files\n  const files = [];\n  function walk(dir) {\n    for (const f of fs.readdirSync(dir)) {\n      if (['.git', 'node_modules', 'target', '_legacy_v1', '_lin-master-hidden', 'results'].includes(f)) continue;\n      const full = path.join(dir, f);\n      const stat = fs.statSync(full);\n      if (stat.isDirectory()) {\n        walk(full);\n      } else if (f.endsWith('.lin') || f.endsWith('.lia')) {\n        files.push(full);\n      }\n    }\n  }\n  walk(ROOT);\n\n  console.log(`[+] Encontrados ${files.length} arquivos .lin/.lia no repositório.`);\n  console.log(\"[+] Iniciando compilação e execução em memória via Zig...\\n\");\n\n  let totalParsed = 0;\n  let totalCompiled = 0;\n  let totalExecuted = 0;\n  let totalSkippedDocs = 0;\n  const failures = [];\n  const passedModules = [];\n\n  for (let i = 0; i < files.length; i++) {\n    const file = files[i];\n    const rel = path.relative(ROOT, file);\n    const content = fs.readFileSync(file, 'utf8');\n\n    // Skip non-program files or doc rulels\n    if (!/^@(LIN|LIA|AIL):/m.test(content.split('\\n')[0] || '') && !/!fn|!\\w+\\(/.test(content)) {\n      totalSkippedDocs++;\n      continue;\n    }\n\n    try {\n      parseProgram(content);\n      totalParsed++;\n    } catch (e) {\n      if (rel.includes('spec') || rel.includes('violation')) {\n        totalSkippedDocs++;\n        continue;\n      }\n      failures.push({ file: rel, stage: 'PARSE', error: e.message });\n      continue;\n    }\n\n    // Compile to Zig\n    let compiled = null;\n    try {\n      compiled = compile(content, { target: 'zig', stubJsRuntimeOnly: true });\n      totalCompiled++;\n    } catch (e) {\n      failures.push({ file: rel, stage: 'COMPILE_ZIG', error: e.message });\n      continue;\n    }\n\n    // Execute in Memory via Zig\n    const execRes = runInMemoryZig(content, { timeoutMs: 8000 });\n    if (execRes.ok) {\n      totalExecuted++;\n      passedModules.push({ file: rel, fns: compiled.fns, output: execRes.output });\n      if (totalExecuted % 25 === 0 || totalExecuted === 1) {\n        console.log(`  [✓] (${totalExecuted}) Executado em memória Zig: ${rel} [${compiled.fns.length} fns]`);\n      }\n    } else {\n      // Record execution error\n      failures.push({ file: rel, stage: 'RUN_ZIG', error: execRes.error });\n    }\n  }\n\n  console.log(\"\\n================================================================================\");\n  console.log(\"   RELATÓRIO CONSOLIDADO DO SWEEP ZIG EM MEMÓRIA                              \");\n  console.log(\"================================================================================\");\n  console.log(`[+] Total de Arquivos Encontrados:     ${files.length}`);\n  console.log(`[+] Módulos Válidos Analisados:        ${totalParsed}`);\n  console.log(`[+] Módulos Compilados para Zig:       ${totalCompiled}`);\n  console.log(`[+] Módulos Executados com Sucesso:    ${totalExecuted}`);\n  console.log(`[+] Documentos/Specs Não-executáveis:  ${totalSkippedDocs}`);\n  console.log(`[+] Falhas Encontradas:                ${failures.length}`);\n  console.log(`[+] Taxa de Sucesso em Memória:        ${((totalExecuted / (totalParsed || 1)) * 100).toFixed(1)}%`);\n  console.log(\"================================================================================\");\n\n  const report = {\n    benchmark: \"GLOBAL_LIN_TO_ZIG_IN_MEMORY_SWEEP\",\n    timestamp: new Date().toISOString(),\n    total_files_scanned: files.length,\n    valid_programs_parsed: totalParsed,\n    zig_compiled: totalCompiled,\n    zig_in_memory_executed: totalExecuted,\n    skipped_docs_and_specs: totalSkippedDocs,\n    failures,\n    status: failures.length === 0 ? \"ALL_PROJECTS_ZIG_VERIFIED\" : \"PARTIAL_WITH_FAILURES\"\n  };\n\n  const reportPath = path.join(RESULTS_DIR, 'SWEEP_ZIG_REPORT.json');\n  fs.writeFileSync(reportPath, JSON.stringify(report, null, 2), 'utf8');\n  console.log(`[+] Relatório salvo em: ${reportPath}`);\n  console.log(\"================================================================================\");\n\n  return report;\n}\n\nsweepZigInMemory();\n"}
