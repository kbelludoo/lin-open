@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!sweepExternalClonesZig(){__filename=fileURLToPath('file:///lin-in-memory.js');ROOT=path.resolve(path.dirname(__filename),'..');RESULTS_DIR=path.join(ROOT,'results/sweep_external_clones_zig');TARGET_DIRECTORIES=['/home/k/clones-lin','/home/k/Downloads/linux-master-lin','/home/k/Downloads/browser-use-lin','/home/k/Downloads/chrome-lin','/home/k/Downloads/ia-em-lin'];console.log("================================================================================");console.log("   SWEEP DE REPOSITÓRIOS EXTERNOS & CLONES LIN -> COMPILAÇÃO EM MEMÓRIA (ZIG)  ");console.log("================================================================================");fs.mkdirSync(RESULTS_DIR,{recursive:true});const externalFiles=[];for(const tDir of TARGET_DIRECTORIES){if(!fs.existsSync(tDir)) {continue;}console.log(`[+] Explorando repositório externo: ${tDir}`);function walk(dir){try{for(const f of fs.readdirSync(dir)){if(['.git','node_modules','target','.cargo','results'].includes(f)) {continue;}const full=path.join(dir,f);const stat=fs.statSync(full);if(stat.isDirectory()){walk(full);}:( f.endsWith('.lin')||f.endsWith('.lia') ){externalFiles.push({repo:tDir,path:full})}}}catch(err){console.error(`Erro ao ler ${dir}: ${err.message}`);}}walk(tDir);}console.log(`\n[+] Total de módulos LIN encontrados nos repositórios externos: ${externalFiles.length}`);console.log("[+] Compilando e executando cada módulo externamente em memória via Zig...\n");let totalParsed=0;let totalCompiled=0;let totalExecuted=0;const repoStats={};const failures=[];for(let i=0;i<externalFiles.length;i++){const item=externalFiles[i];const rel=path.relative(item.repo,item.path);const repoName=path.basename(item.repo);if(!repoStats[repoName]) {repoStats[repoName]={total:0,parsed:0,compiled:0,executed:0};}repoStats[repoName].total++;let content="";try{content=fs.readFileSync(item.path,'utf8');}catch{continue;}if(!/^@(LIN|LIA|AIL):/m.test(content.split('\n')[0]||'')&&!/!fn|!\w+\(/.test(content)){continue;}try{parseProgram(content);totalParsed++;repoStats[repoName].parsed++;}catch(e){failures.push({repo:repoName,file:rel,stage:'PARSE',error:e.message});continue;}let compiled=null;try{compiled=compile(content,{target:'zig',stubJsRuntimeOnly:true});totalCompiled++;repoStats[repoName].compiled++;}catch(e){failures.push({repo:repoName,file:rel,stage:'COMPILE_ZIG',error:e.message});continue;}const execRes=runInMemoryZig(content,{timeoutMs:6000});if(execRes.ok){totalExecuted++;repoStats[repoName].executed++;if(totalExecuted%10===0||totalExecuted===1){console.log(`  [✓] (${totalExecuted}) [${repoName}] ${rel} -> Zig OK (${compiled.fns.length} fns)`);}}:{failures.push({repo:repoName,file:rel,stage:'RUN_ZIG',error:execRes.error})}}console.log("\n================================================================================");console.log("   SUMÁRIO POR REPOSITÓRIO EXTERNO CLONADO (EXECUÇÃO EM MEMÓRIA ZIG)          ");console.log("================================================================================");console.log("REPOSITÓRIO".padEnd(30)+" | "+"TOTAL LIN".padEnd(10)+" | "+"PARSED".padEnd(10)+" | "+"COMPILED".padEnd(10)+" | "+"EXECUTED ZIG".padEnd(12));console.log("-".repeat(80));for(const[rName,stat]of Object.entries(repoStats)){console.log(rName.padEnd(30)+" | "+String(stat.total).padEnd(10)+" | "+String(stat.parsed).padEnd(10)+" | "+String(stat.compiled).padEnd(10)+" | "+String(stat.executed).padEnd(12));}console.log("=".repeat(80));console.log(`[+] Total Geral de Arquivos Externos:   ${externalFiles.length}`);console.log(`[+] Módulos Válidos Analisados:         ${totalParsed}`);console.log(`[+] Módulos Compilados para Zig:        ${totalCompiled}`);console.log(`[+] Módulos Executados com Sucesso:     ${totalExecuted}`);console.log(`[+] Taxa de Sucesso em Memória:         ${((totalExecuted / (totalParsed || 1)) * 100).toFixed(1)}%`);console.log("================================================================================");const report={benchmark:"EXTERNAL_REPOS_LIN_TO_ZIG_IN_MEMORY_SWEEP",timestamp:new Date().toISOString(),repositories_scanned:TARGET_DIRECTORIES,total_external_files:externalFiles.length,valid_programs_parsed:totalParsed,zig_compiled:totalCompiled,zig_in_memory_executed:totalExecuted,repo_breakdown:repoStats,status:totalExecuted>0?"PASSED_EXTERNAL_SWEEP":"NO_EXECUTIONS"};const reportPath=path.join(RESULTS_DIR,'EXTERNAL_CLONES_ZIG_REPORT.json');fs.writeFileSync(reportPath,JSON.stringify(report,null,2),'utf8');console.log(`[+] Relatório Consolidado salvo em: ${reportPath}`);console.log("================================================================================");^report}
=ex{sweepExternalClonesZig}