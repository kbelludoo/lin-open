@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="scripts/diff_behavior.mjs" lang="mjs"}
.source{content="/**\n * diff_behavior: generic in-memory differential runner.\n *\n * Compiles a .lin rewrite in-memory (no disk artifacts) and compares its exports\n * against the ORIGINAL live module (js/ts/mjs), case by case, using deepEq.\n *\n * Two case sources are supported:\n *  - `casesPath` (.rulel canonical, .json accepted for external interop): plain\n *    JSON-serializable {fn,args,want,label} tuples. Cannot carry live objects\n *    with methods (e.g. a mock `request.headers.get`) — JSON has no functions.\n *  - `mockPath`: a plain .mjs module exporting `async function cases()` that\n *    returns [{fn,args,want?,label?}] built with LIVE objects (closures, class\n *    instances, mock request/response objects with real methods). Both the\n *    original and the LIN rewrite are called with the *same* live argument\n *    instances in the same process, so nothing is lost to serialization. If\n *    `want` is omitted, it is computed by calling the ORIGINAL implementation\n *    live (\"golden-from-original\" mode) instead of being hand-authored.\n *\n * This is the formalized, reusable version of the ad-hoc gen_golden.mjs +\n * difftest.mjs pattern: point it at any original-source + LIN-rewrite pair to\n * get a behavioral diff report, independent of `lin verify --behavior` (which\n * only compares the LIN rewrite against hand-authored {fn,args,want} cases and\n * has no notion of \"the original implementation\").\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { pathToFileURL, fileURLToPath } from 'node:url';\nimport { ensureRuntime, runtimeUrl } from './lin_runtime.mjs';\n\nfunction deepEq(a, b) {\n  if (a === b) return true;\n  if (typeof a !== typeof b) return false;\n  if (a === null || b === null) return false;\n  if (Array.isArray(a) && Array.isArray(b)) {\n    if (a.length !== b.length) return false;\n    for (let i = 0; i < a.length; i++) if (!deepEq(a[i], b[i])) return false;\n    return true;\n  }\n  if (typeof a === 'object' && typeof b === 'object') {\n    const ka = Object.keys(a);\n    const kb = Object.keys(b);\n    if (ka.length !== kb.length) return false;\n    for (const k of ka) if (!deepEq(a[k], b[k])) return false;\n    return true;\n  }\n  return Number.isNaN(a) && Number.isNaN(b);\n}\n\nasync function loadCases({ casesPath, mockPath }) {\n  if (mockPath) {\n    const mockMod = await import(pathToFileURL(path.resolve(mockPath)).href);\n    if (typeof mockMod.cases !== 'function') {\n      throw new Error(`${mockPath} must export an async function cases()`);\n    }\n    return await mockMod.cases();\n  }\n  if (casesPath) {\n    const text = fs.readFileSync(path.resolve(casesPath), 'utf8');\n    if (casesPath.endsWith('.rulel')) {\n      const { parseBehaviorCasesRulel } = await import(runtimeUrl('rulel.mjs'));\n      return parseBehaviorCasesRulel(text);\n    }\n    return JSON.parse(text);\n  }\n  throw new Error('diffBehavior requires either casesPath or mockPath');\n}\n\nfunction resolveExport(mod, fnName) {\n  if (typeof mod === 'function' && (mod.name === fnName || !fnName)) return mod;\n  if (mod && typeof mod[fnName] === 'function') return mod[fnName];\n  if (mod && mod.default && typeof mod.default[fnName] === 'function') return mod.default[fnName];\n  return null;\n}\n\nexport async function diffBehavior({ originalPath, linPath, casesPath, mockPath }) {\n  await ensureRuntime();\n  const { compile } = await import(runtimeUrl('compiler.mjs'));\n  const { runInMemory } = await import(runtimeUrl('vm.mjs'));\n\n  const linSrc = fs.readFileSync(path.resolve(linPath), 'utf8');\n  const { code } = compile(linSrc, { target: 'js' });\n  const rewritten = runInMemory(code);\n  const original = await import(pathToFileURL(path.resolve(originalPath)).href);\n\n  const cases = await loadCases({ casesPath, mockPath });\n  const results = [];\n  for (const c of cases) {\n    const args = c.args || [];\n    const originalFn = resolveExport(original, c.fn);\n    const rewrittenFn = resolveExport(rewritten, c.fn);\n    const entry = { fn: c.fn, label: c.label || null, args };\n    if (!rewrittenFn) {\n      results.push({ ...entry, pass: false, error: `LIN rewrite does not export a callable ${c.fn}` });\n      continue;\n    }\n    const hasWant = Object.prototype.hasOwnProperty.call(c, 'want');\n    let want = c.want;\n    if (!hasWant) {\n      if (!originalFn) {\n        results.push({ ...entry, pass: false, error: `no explicit 'want' and original does not export ${c.fn}` });\n        continue;\n      }\n      try {\n        want = await originalFn(...args);\n      } catch (e) {\n        results.push({ ...entry, pass: false, error: `original threw while computing golden want: ${e.message || e}` });\n        continue;\n      }\n    }\n    let got;\n    let error = null;\n    try {\n      got = await rewrittenFn(...args);\n    } catch (e) {\n      error = String(e.message || e);\n    }\n    const pass = !error && deepEq(got, want);\n    results.push({ ...entry, want, got, error, pass });\n  }\n  const ok = results.every((r) => r.pass);\n  return { ok, count: results.length, results };\n}\n\nfunction printReport(report) {\n  for (const r of report.results) {\n    const tag = r.pass ? 'ok  ' : 'FAIL';\n    const label = r.label ? ` (${r.label})` : '';\n    console.log(`${tag} ${r.fn}(${JSON.stringify(r.args)})${label}`);\n    if (!r.pass) {\n      if (r.error) console.log(`      error: ${r.error}`);\n      else console.log(`      got : ${JSON.stringify(r.got)}\\n      want: ${JSON.stringify(r.want)}`);\n    }\n  }\n  console.log(`\\n${report.results.filter((r) => r.pass).length}/${report.count} cases passed`);\n}\n\nasync function main() {\n  const args = process.argv.slice(2);\n  const opts = { originalPath: null, linPath: null, casesPath: null, mockPath: null, json: false };\n  const positional = [];\n  for (let i = 0; i < args.length; i++) {\n    const a = args[i];\n    if (a === '--cases') opts.casesPath = args[++i];\n    else if (a === '--mock') opts.mockPath = args[++i];\n    else if (a === '--json') opts.json = true;\n    else positional.push(a);\n  }\n  [opts.originalPath, opts.linPath] = positional;\n  if (!opts.originalPath || !opts.linPath || (!opts.casesPath && !opts.mockPath)) {\n    console.error('usage: diff_behavior.mjs <original.js> <rewrite.lin> (--cases cases.rulel | --mock mock.mjs) [--json]');\n    process.exit(2);\n  }\n  const report = await diffBehavior(opts);\n  if (opts.json) console.log(JSON.stringify(report, null, 2));\n  else printReport(report);\n  process.exit(report.ok ? 0 : 1);\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  main().catch((e) => {\n    console.error(e);\n    process.exit(1);\n  });\n}\n"}
