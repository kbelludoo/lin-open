@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="scripts/sweep_external_clones_zig.mjs" lang="mjs"}
.source{content="// LIN Cross-Repository & External Clones Zig In-Memory Compilation & Execution Sweep\n// Spec: spec/LIN_CLONE_LIN_LOOP.rulel & spec/LIN_IR_CROSS_BACKEND.rulel\n\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { parseProgram } from '../src/parser.mjs';\nimport { compile } from '../src/compiler.mjs';\nimport { runInMemoryZig } from '../src/vm_zig.mjs';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst ROOT = path.resolve(path.dirname(__filename), '..');\nconst RESULTS_DIR = path.join(ROOT, 'results/sweep_external_clones_zig');\n\nconst TARGET_DIRECTORIES = [\n  '/home/k/clones-lin',\n  '/home/k/Downloads/linux-master-lin',\n  '/home/k/Downloads/browser-use-lin',\n  '/home/k/Downloads/chrome-lin',\n  '/home/k/Downloads/ia-em-lin'\n];\n\nexport async function sweepExternalClonesZig() {\n  console.log(\"================================================================================\");\n  console.log(\"   SWEEP DE REPOSITÓRIOS EXTERNOS & CLONES LIN -> COMPILAÇÃO EM MEMÓRIA (ZIG)  \");\n  console.log(\"================================================================================\");\n\n  fs.mkdirSync(RESULTS_DIR, { recursive: true });\n\n  const externalFiles = [];\n\n  for (const tDir of TARGET_DIRECTORIES) {\n    if (!fs.existsSync(tDir)) continue;\n    console.log(`[+] Explorando repositório externo: ${tDir}`);\n    \n    function walk(dir) {\n      try {\n        for (const f of fs.readdirSync(dir)) {\n          if (['.git', 'node_modules', 'target', '.cargo', 'results'].includes(f)) continue;\n          const full = path.join(dir, f);\n          const stat = fs.statSync(full);\n          if (stat.isDirectory()) {\n            walk(full);\n          } else if (f.endsWith('.lin') || f.endsWith('.lia')) {\n            externalFiles.push({ repo: tDir, path: full });\n          }\n        }\n      } catch (err) {\n        console.error(`Erro ao ler ${dir}: ${err.message}`);\n      }\n    }\n    walk(tDir);\n  }\n\n  console.log(`\\n[+] Total de módulos LIN encontrados nos repositórios externos: ${externalFiles.length}`);\n  console.log(\"[+] Compilando e executando cada módulo externamente em memória via Zig...\\n\");\n\n  let totalParsed = 0;\n  let totalCompiled = 0;\n  let totalExecuted = 0;\n  const repoStats = {};\n  const failures = [];\n\n  for (let i = 0; i < externalFiles.length; i++) {\n    const item = externalFiles[i];\n    const rel = path.relative(item.repo, item.path);\n    const repoName = path.basename(item.repo);\n    if (!repoStats[repoName]) repoStats[repoName] = { total: 0, parsed: 0, compiled: 0, executed: 0 };\n    repoStats[repoName].total++;\n\n    let content = \"\";\n    try {\n      content = fs.readFileSync(item.path, 'utf8');\n    } catch {\n      continue;\n    }\n\n    // Skip non-program files or doc rulels\n    if (!/^@(LIN|LIA|AIL):/m.test(content.split('\\n')[0] || '') && !/!fn|!\\w+\\(/.test(content)) {\n      continue;\n    }\n\n    try {\n      parseProgram(content);\n      totalParsed++;\n      repoStats[repoName].parsed++;\n    } catch (e) {\n      failures.push({ repo: repoName, file: rel, stage: 'PARSE', error: e.message });\n      continue;\n    }\n\n    // Compile to Zig\n    let compiled = null;\n    try {\n      compiled = compile(content, { target: 'zig', stubJsRuntimeOnly: true });\n      totalCompiled++;\n      repoStats[repoName].compiled++;\n    } catch (e) {\n      failures.push({ repo: repoName, file: rel, stage: 'COMPILE_ZIG', error: e.message });\n      continue;\n    }\n\n    // Execute in Memory via Zig\n    const execRes = runInMemoryZig(content, { timeoutMs: 6000 });\n    if (execRes.ok) {\n      totalExecuted++;\n      repoStats[repoName].executed++;\n      if (totalExecuted % 10 === 0 || totalExecuted === 1) {\n        console.log(`  [✓] (${totalExecuted}) [${repoName}] ${rel} -> Zig OK (${compiled.fns.length} fns)`);\n      }\n    } else {\n      failures.push({ repo: repoName, file: rel, stage: 'RUN_ZIG', error: execRes.error });\n    }\n  }\n\n  console.log(\"\\n================================================================================\");\n  console.log(\"   SUMÁRIO POR REPOSITÓRIO EXTERNO CLONADO (EXECUÇÃO EM MEMÓRIA ZIG)          \");\n  console.log(\"================================================================================\");\n  console.log(\"REPOSITÓRIO\".padEnd(30) + \" | \" + \"TOTAL LIN\".padEnd(10) + \" | \" + \"PARSED\".padEnd(10) + \" | \" + \"COMPILED\".padEnd(10) + \" | \" + \"EXECUTED ZIG\".padEnd(12));\n  console.log(\"-\".repeat(80));\n\n  for (const [rName, stat] of Object.entries(repoStats)) {\n    console.log(\n      rName.padEnd(30) + \" | \" +\n      String(stat.total).padEnd(10) + \" | \" +\n      String(stat.parsed).padEnd(10) + \" | \" +\n      String(stat.compiled).padEnd(10) + \" | \" +\n      String(stat.executed).padEnd(12)\n    );\n  }\n\n  console.log(\"=\".repeat(80));\n  console.log(`[+] Total Geral de Arquivos Externos:   ${externalFiles.length}`);\n  console.log(`[+] Módulos Válidos Analisados:         ${totalParsed}`);\n  console.log(`[+] Módulos Compilados para Zig:        ${totalCompiled}`);\n  console.log(`[+] Módulos Executados com Sucesso:     ${totalExecuted}`);\n  console.log(`[+] Taxa de Sucesso em Memória:         ${((totalExecuted / (totalParsed || 1)) * 100).toFixed(1)}%`);\n  console.log(\"================================================================================\");\n\n  const report = {\n    benchmark: \"EXTERNAL_REPOS_LIN_TO_ZIG_IN_MEMORY_SWEEP\",\n    timestamp: new Date().toISOString(),\n    repositories_scanned: TARGET_DIRECTORIES,\n    total_external_files: externalFiles.length,\n    valid_programs_parsed: totalParsed,\n    zig_compiled: totalCompiled,\n    zig_in_memory_executed: totalExecuted,\n    repo_breakdown: repoStats,\n    status: totalExecuted > 0 ? \"PASSED_EXTERNAL_SWEEP\" : \"NO_EXECUTIONS\"\n  };\n\n  const reportPath = path.join(RESULTS_DIR, 'EXTERNAL_CLONES_ZIG_REPORT.json');\n  fs.writeFileSync(reportPath, JSON.stringify(report, null, 2), 'utf8');\n  console.log(`[+] Relatório Consolidado salvo em: ${reportPath}`);\n  console.log(\"================================================================================\");\n\n  return report;\n}\n\nsweepExternalClonesZig();\n"}
