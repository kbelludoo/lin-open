@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="scripts/phase8_purity_push.mjs" lang="mjs"}
.source{content="#!/usr/bin/env node\n/**\n * Phase 9: final repo purity — zero tracked non-.lin/.rulel; cold-start via bootstrap_cold_start.rulel emit.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { execFileSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst ALLOWED_TRACKED = new Set([]);\n\nconst BINARY_EXTS = new Set([\n  '.elf', '.exe', '.pdb', '.rlib', '.dll', '.bin', '.o', '.obj', '.a', '.so', '.dylib',\n]);\nconst BINARY_PATH_RE = /\\/(bin|kernel)\\/(lin_c[1-4]|lin_rust|k_|kernel_|lin_)/;\nconst SKIP_MIRROR_RE = /\\/(runtime_test\\.exe|\\.multi_emit_out\\/.*\\.(exe|pdb))$/;\n\nfunction escapeRulelSource(text) {\n  return text\n    .replace(/\\\\/g, '\\\\\\\\')\n    .replace(/\"/g, '\\\\\"')\n    .replace(/\\n/g, '\\\\n')\n    .replace(/\\r/g, '\\\\r')\n    .replace(/\\t/g, '\\\\t');\n}\n\nfunction extOf(rel) {\n  const base = path.basename(rel);\n  const dot = base.lastIndexOf('.');\n  if (dot <= 0) return '';\n  return base.slice(dot);\n}\n\nfunction mirrorRelFor(originalRel) {\n  const rel = originalRel.replace(/\\\\/g, '/');\n  const dir = path.dirname(rel);\n  const base = path.basename(rel);\n  let mirrorName;\n  if (base.startsWith('.')) {\n    mirrorName = `dot_${base.slice(1).replace(/\\./g, '_')}.rulel`;\n  } else {\n    const dot = base.lastIndexOf('.');\n    if (dot <= 0) mirrorName = `${base}.rulel`;\n    else mirrorName = `${base.slice(0, dot)}_${base.slice(dot + 1)}.rulel`;\n  }\n  return dir === '.' ? mirrorName : `${dir}/${mirrorName}`;\n}\n\nfunction findExistingMirror(originalRel) {\n  const candidates = [mirrorRelFor(originalRel)];\n  for (const rulelPath of walkRulelFiles(ROOT)) {\n    const text = fs.readFileSync(rulelPath, 'utf8');\n    if (!text.includes('TRANSPOSED_SOURCE')) continue;\n    const m = text.match(/original=\"([^\"]+)\"/);\n    if (m && m[1] === originalRel) {\n      return path.relative(ROOT, rulelPath).replace(/\\\\/g, '/');\n    }\n  }\n  return candidates.find((c) => fs.existsSync(path.join(ROOT, c))) || null;\n}\n\nfunction toTransposedRulel(originalRel, text) {\n  const rel = originalRel.replace(/\\\\/g, '/');\n  const ext = extOf(rel);\n  const metaExt = ext || '';\n  const lang = ext === '.rs' ? ' lang=\"rs\"' : ext === '.sh' ? ' lang=\"sh\"' : '';\n  return `@RULEL:TRANSPOSED_SOURCE:1.0\\n~METADATA{original=\"${rel}\" ext=\"${metaExt}\"${lang}}\\n.source{content=\"${escapeRulelSource(text)}\"}\\n`;\n}\n\nfunction walkRulelFiles(dir, acc = []) {\n  for (const ent of fs.readdirSync(dir, { withFileTypes: true })) {\n    if (ent.name === 'node_modules' || ent.name === '.git' || ent.name === 'build') continue;\n    const full = path.join(dir, ent.name);\n    if (ent.isDirectory()) walkRulelFiles(full, acc);\n    else if (ent.name.endsWith('.rulel')) acc.push(full);\n  }\n  return acc;\n}\n\nfunction isBinary(rel, buf) {\n  const ext = extOf(rel);\n  if (BINARY_EXTS.has(ext)) return true;\n  if (BINARY_PATH_RE.test(rel)) return true;\n  if (SKIP_MIRROR_RE.test(rel)) return true;\n  if (rel === 'results/phase5_tri_host/tri_host_rust_bin') return true;\n  if (buf && buf.includes(0)) return true;\n  return false;\n}\n\nfunction isTextMirrorCandidate(rel) {\n  if (ALLOWED_TRACKED.has(rel)) return false;\n  if (rel.endsWith('.lin') || rel.endsWith('.rulel')) return false;\n  return true;\n}\n\nconst tracked = execFileSync('git', ['ls-files'], { cwd: ROOT, encoding: 'utf8' })\n  .trim()\n  .split('\\n')\n  .filter(Boolean);\n\nconst created = [];\nconst skippedBinary = [];\nconst untrack = [];\n\nfor (const rel of tracked) {\n  if (rel.endsWith('.lin') || rel.endsWith('.rulel')) continue;\n  if (ALLOWED_TRACKED.has(rel)) continue;\n\n  const full = path.join(ROOT, rel);\n  if (!fs.existsSync(full)) {\n    untrack.push(rel);\n    continue;\n  }\n\n  const buf = fs.readFileSync(full);\n  if (isBinary(rel, buf)) {\n    skippedBinary.push(rel);\n    untrack.push(rel);\n    continue;\n  }\n\n  if (!isTextMirrorCandidate(rel)) continue;\n\n  let text;\n  try {\n    text = buf.toString('utf8');\n  } catch {\n    skippedBinary.push(rel);\n    untrack.push(rel);\n    continue;\n  }\n\n  const existing = findExistingMirror(rel);\n  if (!existing) {\n    const mirrorRel = mirrorRelFor(rel);\n    const mirrorPath = path.join(ROOT, mirrorRel);\n    if (mirrorPath === full) continue;\n    fs.mkdirSync(path.dirname(mirrorPath), { recursive: true });\n    fs.writeFileSync(mirrorPath, toTransposedRulel(rel, text), 'utf8');\n    created.push(mirrorRel);\n  }\n  untrack.push(rel);\n}\n\nconsole.log(`[phase8] created ${created.length} TRANSPOSED_SOURCE mirrors`);\nif (created.length) console.log(created.slice(0, 20).join('\\n') + (created.length > 20 ? `\\n... +${created.length - 20} more` : ''));\nconsole.log(`[phase8] skipping mirror for ${skippedBinary.length} binaries/build artifacts`);\nconsole.log(`[phase8] untracking ${untrack.length} non-.lin/.rulel files`);\n\nif (untrack.length) {\n  execFileSync('git', ['rm', '--cached', '-f', ...untrack], { cwd: ROOT, stdio: 'inherit' });\n}\n\nconst remaining = execFileSync('git', ['ls-files'], { cwd: ROOT, encoding: 'utf8' })\n  .trim()\n  .split('\\n')\n  .filter(Boolean)\n  .filter((f) => !f.endsWith('.lin') && !f.endsWith('.rulel'));\n\nconsole.log(`[phase8] remaining non-.lin/.rulel tracked: ${remaining.length}`);\nconsole.log(remaining.join('\\n') || '(none)');\n"}
