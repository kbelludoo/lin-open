@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="scripts/native_backend_bench.mjs" lang="mjs"}
.source{content="/**\n * Empirical multi-backend selection for Node-free in-memory execution.\n *\n * Per spec/LIN_CORE_ARCH.rulel EMPIRICAL_BACKEND:\n *   LIN_IR -> emit_to_N_backends -> verify_semantic_equivalence -> benchmark -> rank -> choose\n *\n * This does NOT hardcode a \"winner\" language. It compiles the same LIN\n * source to every REAL_TARGETS backend capable of running standalone\n * (c, rust, go, zig, ocaml, crystal, nim compile to native executables;\n * lua and julia are interpreted/JIT and run directly via their\n * interpreter), verifies each backend's output matches the in-memory JS\n * reference (behavior_eq, not just \"compiled\"/\"ran\"), times build+run\n * separately, and ranks by run time. Node is used here only to drive\n * compilation + measurement; the ranked artifacts themselves run with\n * zero Node/JS involvement. Interpreted backends (lua, julia) report\n * buildMs=0 honestly -- there is no separate native-compile step, so\n * their \"run\" time already includes interpreter/JIT startup and is not\n * pretended to be a compiled-binary run.\n *\n * Usage: node scripts/native_backend_bench.mjs <file.lin> <fnName> <arg1> [arg2 ...]\n *   node scripts/native_backend_bench.mjs test/fixtures/arith.lin add 2 3\n */\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { execFileSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\nimport { importRuntime } from './lin_runtime.mjs';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst TMP_PREFIX = path.join(os.tmpdir(), 'lin-native-bench-');\n\n/** Native-capable REAL_TARGETS: each row below knows how to build+run its\n * own emitted code as a standalone OS process. Backend-agnostic by\n * construction — add a row to extend, none is privileged. */\nconst BACKENDS = [\n  {\n    name: 'zig',\n    ext: 'zig',\n    driver: (fn, args) => `\\npub fn main() !void {\\n    const stdout = std.io.getStdOut().writer();\\n    try stdout.print(\"{d}\\\\n\", .{${fn}(${args.join(', ')})});\\n}\\n`,\n    build: (dir, file) => execFileSync('zig', ['build-exe', file, '-O', 'ReleaseFast'], { cwd: dir, timeout: 60000 }),\n    binName: (file) => path.basename(file, path.extname(file)),\n  },\n  {\n    name: 'c',\n    ext: 'c',\n    driver: (fn, args) => `\\nint main(){ printf(\"%lld\\\\n\", ${fn}(${args.join(', ')})); return 0; }\\n`,\n    build: (dir, file) => execFileSync('gcc', ['-O2', '-o', 'out_bin', file, '-lm'], { cwd: dir, timeout: 60000 }),\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'rust',\n    ext: 'rs',\n    driver: (fn, args) => `\\nfn main() { println!(\"{}\", ${fn}(${args.join(', ')})); }\\n`,\n    build: (dir, file) => execFileSync('rustc', ['-O', '-o', 'out_bin', file], { cwd: dir, timeout: 90000 }),\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'go',\n    ext: 'go',\n    driver: (fn, args) => `\\nfunc main() { fmt.Println(${fn}(${args.join(', ')})) }\\n`,\n    build: (dir, file) => {\n      fs.writeFileSync(path.join(dir, 'go.mod'), 'module linbench\\n\\ngo 1.21\\n');\n      execFileSync('go', ['build', '-o', 'out_bin', file], { cwd: dir, timeout: 60000 });\n    },\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'ocaml',\n    ext: 'ml',\n    bin: 'ocamlopt',\n    driver: (fn, args) => `\\nlet () = Printf.printf \"%d\\\\n\" (${fn} ${args.join(' ')})\\n`,\n    build: (dir, file) => execFileSync('ocamlopt', ['-o', 'out_bin', file], { cwd: dir, timeout: 60000 }),\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'crystal',\n    ext: 'cr',\n    bin: 'crystal',\n    driver: (fn, args) => `\\nputs ${fn}(${args.join(', ')})\\n`,\n    build: (dir, file) => execFileSync('crystal', ['build', '--release', '-o', 'out_bin', file], { cwd: dir, timeout: 120000 }),\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'nim',\n    ext: 'nim',\n    bin: 'nim',\n    driver: (fn, args) => `\\necho ${fn}(${args.join(', ')})\\n`,\n    build: (dir, file) => execFileSync('nim', ['c', '-d:release', '--hints:off', '-o:out_bin', file], { cwd: dir, timeout: 60000 }),\n    binName: () => 'out_bin',\n  },\n  {\n    name: 'lua',\n    ext: 'lua',\n    bin: 'lua5.4',\n    interpreted: true,\n    driver: (fn, args) => `\\nprint(${fn}(${args.join(', ')}))\\n`,\n  },\n  {\n    name: 'julia',\n    ext: 'jl',\n    bin: 'julia',\n    interpreted: true,\n    driver: (fn, args) => `\\nprintln(${fn}(${args.join(', ')}))\\n`,\n  },\n];\n\nfunction which(bin) {\n  try {\n    execFileSync('sh', ['-c', `command -v ${bin}`], { stdio: 'pipe' });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nasync function bench(linFile, fnName, args) {\n  const { compile, runInMemory } = await importRuntime('compiler.mjs');\n  const { parseProgram } = await importRuntime('parser.mjs');\n  const emitters = await importRuntime('emitters.mjs');\n  const src = fs.readFileSync(path.resolve(ROOT, linFile), 'utf8');\n  const prog = parseProgram(src);\n\n  const reference = runInMemory(compile(src, { target: 'js' }).code)[fnName](...args);\n\n  const rows = [];\n  for (const backend of BACKENDS) {\n    const toolchainBin = backend.bin || (backend.name === 'zig' ? 'zig' : backend.name === 'c' ? 'gcc' : backend.name === 'rust' ? 'rustc' : 'go');\n    if (!which(toolchainBin)) {\n      rows.push({ backend: backend.name, ok: false, mode: 'toolchain_absent' });\n      continue;\n    }\n    const emitFn = {\n      zig: emitters.emitZig, c: emitters.emitC, rust: emitters.emitRust, go: emitters.emitGo,\n      ocaml: emitters.emitOcaml, crystal: emitters.emitCrystal, nim: emitters.emitNim,\n      lua: emitters.emitLua, julia: emitters.emitJulia,\n    }[backend.name];\n    let code = emitFn(prog, backend.name === 'go' ? { main: false } : {});\n    code += backend.driver(fnName, args);\n    const dir = fs.mkdtempSync(TMP_PREFIX + backend.name + '-');\n    const file = path.join(dir, `prog.${backend.ext}`);\n    fs.writeFileSync(file, code);\n    try {\n      let buildMs = 0;\n      if (!backend.interpreted) {\n        const t0 = Date.now();\n        backend.build(dir, file);\n        buildMs = Date.now() - t0;\n      }\n      const t1 = Date.now();\n      const out = backend.interpreted\n        ? execFileSync(toolchainBin, [file], { encoding: 'utf8', timeout: 10000 }).trim()\n        : execFileSync(path.join(dir, backend.binName(file)), { encoding: 'utf8', timeout: 10000 }).trim();\n      const runMs = Date.now() - t1;\n      const semanticEq = String(out) === String(reference);\n      rows.push({ backend: backend.name, ok: semanticEq, mode: semanticEq ? 'FULL' : 'behavior_mismatch', buildMs, runMs, out, reference });\n    } catch (e) {\n      rows.push({ backend: backend.name, ok: false, mode: 'FAIL', error: String(e.message || e).split('\\n')[0] });\n    } finally {\n      fs.rmSync(dir, { recursive: true, force: true });\n    }\n  }\n\n  const ranked = rows.filter((r) => r.ok).sort((a, b) => a.runMs - b.runMs);\n  return { fnName, args, reference, rows, ranked, fastest: ranked[0]?.backend ?? null };\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  const [linFile, fnName, ...rawArgs] = process.argv.slice(2);\n  if (!linFile || !fnName) {\n    console.error('Usage: node scripts/native_backend_bench.mjs <file.lin> <fnName> <arg1> [arg2 ...]');\n    process.exit(1);\n  }\n  const args = rawArgs.map(Number);\n  const result = await bench(linFile, fnName, args);\n  console.log(JSON.stringify(result, null, 2));\n  if (!result.fastest) process.exit(1);\n}\n\nexport { bench, BACKENDS };\n"}
