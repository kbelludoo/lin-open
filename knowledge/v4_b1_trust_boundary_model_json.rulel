@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="knowledge/v4_b1_trust_boundary_model.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B1_TRUST_BOUNDARY_MODEL\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"axios@v1.14.0\",\n  \"description\": \"Trust boundary model for system-model-driven analysis\",\n\n  \"sources\": [\n    {\n      \"id\": \"SRC-001\",\n      \"type\": \"user_config\",\n      \"description\": \"User-provided config object passed to axios() or axios.create()\",\n      \"files\": [\"lib/core/Axios.js\", \"lib/core/mergeConfig.js\"],\n      \"trust_level\": \"UNTRUSTED\",\n      \"properties\": [\"url\", \"method\", \"headers\", \"auth\", \"proxy\", \"socketPath\", \"timeout\", \"maxContentLength\", \"maxBodyLength\", \"responseType\", \"responseEncoding\", \"httpVersion\", \"transport\", \"transformRequest\", \"transformResponse\", \"parseReviver\"]\n    },\n    {\n      \"id\": \"SRC-002\",\n      \"type\": \"url_input\",\n      \"description\": \"URL string or URL object provided by user\",\n      \"files\": [\"lib/core/buildFullPath.js\", \"lib/helpers/buildURL.js\"],\n      \"trust_level\": \"UNTRUSTED\",\n      \"properties\": [\"hostname\", \"pathname\", \"search\", \"protocol\", \"username\", \"password\"]\n    },\n    {\n      \"id\": \"SRC-003\",\n      \"type\": \"header_input\",\n      \"description\": \"HTTP headers from user config or FormData\",\n      \"files\": [\"lib/core/AxiosHeaders.js\", \"lib/helpers/resolveConfig.js\"],\n      \"trust_level\": \"UNTRUSTED\",\n      \"properties\": [\"header_name\", \"header_value\"]\n    },\n    {\n      \"id\": \"SRC-004\",\n      \"type\": \"network_response\",\n      \"description\": \"HTTP response from remote server\",\n      \"files\": [\"lib/adapters/http.js\"],\n      \"trust_level\": \"UNTRUSTED\",\n      \"properties\": [\"status\", \"headers\", \"body\", \"content_length\", \"content_encoding\"]\n    },\n    {\n      \"id\": \"SRC-005\",\n      \"type\": \"environment\",\n      \"description\": \"Environment variables, proxy settings, platform detection\",\n      \"files\": [\"lib/helpers/shouldBypassProxy.js\", \"lib/helpers/cookies.js\", \"lib/helpers/isURLSameOrigin.js\"],\n      \"trust_level\": \"SEMI_TRUSTED\",\n      \"properties\": [\"NO_PROXY\", \"HTTP_PROXY\", \"HTTPS_PROXY\", \"document.cookie\", \"window.location\"]\n    },\n    {\n      \"id\": \"SRC-006\",\n      \"type\": \"formdata_input\",\n      \"description\": \"FormData entries with user-controlled keys and values\",\n      \"files\": [\"lib/helpers/formDataToJSON.js\", \"lib/helpers/formDataToStream.js\"],\n      \"trust_level\": \"UNTRUSTED\",\n      \"properties\": [\"entry_key\", \"entry_value\"]\n    },\n    {\n      \"id\": \"SRC-007\",\n      \"type\": \"xhr_event\",\n      \"description\": \"Upload/download progress events from XHR or fetch\",\n      \"files\": [\"lib/helpers/progressEventReducer.js\", \"lib/adapters/xhr.js\"],\n      \"trust_level\": \"SEMI_TRUSTED\",\n      \"properties\": [\"loaded\", \"total\", \"lengthComputable\"]\n    }\n  ],\n\n  \"sinks\": [\n    {\n      \"id\": \"SNK-001\",\n      \"type\": \"http_request\",\n      \"description\": \"Outbound HTTP request to remote server\",\n      \"files\": [\"lib/adapters/http.js\"],\n      \"sensitivity\": \"CRITICAL\",\n      \"impact\": \"SSRF, credential theft, data exfiltration\"\n    },\n    {\n      \"id\": \"SNK-002\",\n      \"type\": \"header_output\",\n      \"description\": \"HTTP headers sent in request or set on response\",\n      \"files\": [\"lib/adapters/http.js\", \"lib/core/AxiosHeaders.js\"],\n      \"sensitivity\": \"HIGH\",\n      \"impact\": \"Header injection, cache poisoning, cloud metadata exfiltration\"\n    },\n    {\n      \"id\": \"SNK-003\",\n      \"type\": \"json_parse\",\n      \"description\": \"JSON.parse with user-controlled reviver\",\n      \"files\": [\"lib/defaults/index.js\"],\n      \"sensitivity\": \"CRITICAL\",\n      \"impact\": \"Arbitrary code execution via reviver function\"\n    },\n    {\n      \"id\": \"SNK-004\",\n      \"type\": \"socket_operation\",\n      \"description\": \"Unix socket connection or TCP keepalive\",\n      \"files\": [\"lib/adapters/http.js\"],\n      \"sensitivity\": \"HIGH\",\n      \"impact\": \"SSRF via socketPath, resource exhaustion\"\n    },\n    {\n      \"id\": \"SNK-005\",\n      \"type\": \"stream_output\",\n      \"description\": \"Response stream returned to user without size limit\",\n      \"files\": [\"lib/adapters/http.js\"],\n      \"sensitivity\": \"MEDIUM\",\n      \"impact\": \"Unbounded memory consumption\"\n    },\n    {\n      \"id\": \"SNK-006\",\n      \"type\": \"regex_construction\",\n      \"description\": \"Dynamic regex from user input\",\n      \"files\": [\"lib/helpers/cookies.js\"],\n      \"sensitivity\": \"MEDIUM\",\n      \"impact\": \"Regex injection, ReDoS\"\n    }\n  ],\n\n  \"trust_boundaries\": [\n    {\n      \"id\": \"TB-001\",\n      \"name\": \"config_to_request\",\n      \"source\": \"SRC-001\",\n      \"sink\": \"SNK-001\",\n      \"path\": \"user_config → mergeConfig → http_adapter → transport.request\",\n      \"guards\": [\"__proto__ filter in mergeConfig:100\", \"supportedProtocols check\"],\n      \"guard_gaps\": [\"prop in config2 traverses prototype chain\", \"destructuring reads inherited properties\"],\n      \"risk\": \"HIGH — prototype pollution can inject arbitrary request parameters\"\n    },\n    {\n      \"id\": \"TB-002\",\n      \"name\": \"url_to_network\",\n      \"source\": \"SRC-002\",\n      \"sink\": \"SNK-001\",\n      \"path\": \"user_url → buildFullPath → URL parsing → http.request\",\n      \"guards\": [\"supportedProtocols check\", \"isAbsoluteURL check\"],\n      \"guard_gaps\": [\"shouldBypassProxy hostname normalization bypass\"],\n      \"risk\": \"HIGH — SSRF via proxy bypass\"\n    },\n    {\n      \"id\": \"TB-003\",\n      \"name\": \"header_to_wire\",\n      \"source\": \"SRC-003\",\n      \"sink\": \"SNK-002\",\n      \"path\": \"user_headers → AxiosHeaders.from → headers.toJSON → http.request\",\n      \"guards\": [\"AxiosHeaders normalization\"],\n      \"guard_gaps\": [\"No CRLF sanitization in header values\"],\n      \"risk\": \"HIGH — header injection via CRLF\"\n    },\n    {\n      \"id\": \"TB-004\",\n      \"name\": \"response_to_user\",\n      \"source\": \"SRC-004\",\n      \"sink\": \"SNK-003\",\n      \"path\": \"network_response → transformResponse → JSON.parse(data, this.parseReviver)\",\n      \"guards\": [\"transitional.silentJSONParsing\"],\n      \"guard_gaps\": [\"this.parseReviver inherited from prototype\"],\n      \"risk\": \"CRITICAL — code execution via polluted parseReviver\"\n    },\n    {\n      \"id\": \"TB-005\",\n      \"name\": \"formdata_to_object\",\n      \"source\": \"SRC-006\",\n      \"sink\": \"SNK-003\",\n      \"path\": \"formdata_entries → formDataToJSON → buildPath → nested_object\",\n      \"guards\": [\"__proto__ filter in buildPath:53\"],\n      \"guard_gaps\": [\"Missing constructor/prototype filter\"],\n      \"risk\": \"MEDIUM — correctness issues from inherited constructor\"\n    },\n    {\n      \"id\": \"TB-006\",\n      \"name\": \"environment_to_config\",\n      \"source\": \"SRC-005\",\n      \"sink\": \"SNK-001\",\n      \"path\": \"env_vars → shouldBypassProxy → proxy decisions → request routing\",\n      \"guards\": [\"NO_PROXY matching\"],\n      \"guard_gaps\": [\"Hostname normalization bypass in shouldBypassProxy\"],\n      \"risk\": \"HIGH — SSRF via proxy bypass\"\n    },\n    {\n      \"id\": \"TB-007\",\n      \"name\": \"xhr_to_progress\",\n      \"source\": \"SRC-007\",\n      \"sink\": \"SNK-005\",\n      \"path\": \"xhr_event → progressEventReducer → onUploadProgress callback\",\n      \"guards\": [\"None\"],\n      \"guard_gaps\": [\"No validation of event.loaded/event.total\"],\n      \"risk\": \"LOW — correctness issues in progress reporting\"\n    }\n  ]\n}\n"}
