@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="knowledge/v4_b1_coverage_metrics.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B1_COVERAGE_METRICS\",\n  \"version\": \"2.0.0\",\n  \"description\": \"Extended metrics for V4-B.1 that go beyond precision to measure reasoning coverage\",\n\n  \"metrics\": {\n    \"intervention_precision\": {\n      \"formula\": \"confirmed_findings / (confirmed_findings + false_positives_rejected)\",\n      \"description\": \"How accurate are the findings when the agent decides to intervene?\",\n      \"v4_b_result\": 0.78,\n      \"v4_b1_target\": \">= 0.80\",\n      \"purpose\": \"Measures decision quality\"\n    },\n\n    \"risk_surface_coverage\": {\n      \"formula\": \"analyzed_boundaries / discovered_boundaries\",\n      \"description\": \"What fraction of the trust boundaries did the agent actually analyze?\",\n      \"v4_b_result\": \"2/7 = 0.29\",\n      \"v4_b1_target\": \">= 0.80\",\n      \"purpose\": \"Measures exploration completeness — how much of the attack surface was examined?\"\n    },\n\n    \"blind_zone_rate\": {\n      \"formula\": \"missed_known_bug_classes / total_known_bug_classes\",\n      \"description\": \"What fraction of bug classes did the agent completely miss?\",\n      \"v4_b_result\": \"4/7 = 0.57\",\n      \"v4_b1_target\": \"<= 0.20\",\n      \"purpose\": \"Measures systemic blindness — are entire categories of bugs invisible?\"\n    },\n\n    \"flow_discovery_recall\": {\n      \"formula\": \"discovered_flows / oracle_flows\",\n      \"description\": \"Did the agent discover the data flows from source to sink? This separates discovery failure from reasoning failure.\",\n      \"v4_b_result\": \"N/A (V4-B did not produce flow graphs)\",\n      \"v4_b1_target\": \">= 0.80\",\n      \"purpose\": \"Distinguish modeling problem from reasoning problem\",\n      \"diagnostic\": {\n        \"low_fdr\": \"modeling problem — agent doesn't discover flows\",\n        \"high_fdr_low_finding_recall\": \"reasoning problem — agent discovers flows but misclassifies risk\",\n        \"high_fdr_high_finding_recall\": \"agent is both modeler and judge — target state\"\n      }\n    },\n\n    \"flow_completion_rate\": {\n      \"formula\": \"fully_traced_flows / total_discovered_flows\",\n      \"description\": \"Of the flows the agent identified, how many were traced from source to sink?\",\n      \"v4_b_result\": \"unknown (V4-B did not produce flow graphs)\",\n      \"v4_b1_target\": \">= 0.90\",\n      \"purpose\": \"Measures depth of analysis — does the agent follow flows to completion?\"\n    },\n\n    \"source_diversity\": {\n      \"formula\": \"unique_source_types_analyzed / total_source_types\",\n      \"description\": \"Did the agent analyze inputs from multiple source types (config, URL, headers, events, environment)?\",\n      \"v4_b_result\": \"2/7 = 0.29 (only config + URL)\",\n      \"v4_b1_target\": \">= 0.70\",\n      \"purpose\": \"Measures whether the agent considers all input channels\"\n    },\n\n    \"sink_diversity\": {\n      \"formula\": \"unique_sink_types_reached / total_sink_types\",\n      \"description\": \"Did the agent trace flows to multiple sink types (request, header, json_parse, socket, stream)?\",\n      \"v4_b_result\": \"1/6 = 0.17 (only http_request)\",\n      \"v4_b1_target\": \">= 0.60\",\n      \"purpose\": \"Measures whether the agent considers all impact points\"\n    }\n  },\n\n  \"v4_b_baseline\": {\n    \"intervention_precision\": 0.78,\n    \"risk_surface_coverage\": 0.29,\n    \"blind_zone_rate\": 0.57,\n    \"flow_discovery_recall\": \"N/A (V4-B did not produce flow graphs)\",\n    \"source_diversity\": 0.29,\n    \"sink_diversity\": 0.17,\n    \"note\": \"V4-B was a pattern-driven scanner. These metrics expose what precision alone hides.\"\n  },\n\n  \"v4_b1_targets\": {\n    \"intervention_precision\": \">= 0.80\",\n    \"flow_discovery_recall\": \">= 0.80\",\n    \"risk_surface_coverage\": \">= 0.80\",\n    \"blind_zone_rate\": \"<= 0.20\",\n    \"source_diversity\": \">= 0.70\",\n    \"sink_diversity\": \">= 0.60\",\n    \"note\": \"V4-B.1 is a system-model-driven analyzer. These metrics measure whether the model is complete.\"\n  },\n\n  \"interpretation_guide\": {\n    \"high_precision_low_coverage\": \"Agent is cautious but blind. Finds real bugs in the areas it looks, but misses entire attack surfaces. This is V4-B.\",\n    \"high_precision_high_coverage\": \"Agent is both careful and thorough. This is V4-B.1 target.\",\n    \"low_precision_high_coverage\": \"Agent looks everywhere but can't distinguish real bugs from noise. Better than blind but still problematic.\",\n    \"low_precision_low_coverage\": \"Agent is neither careful nor thorough. Fundamental capability gap.\"\n  },\n\n  \"evolution_tracking\": {\n    \"V1_V2\": {\n      \"role\": \"smart_transformer\",\n      \"metrics_applicable\": [\"intervention_precision\"]\n    },\n    \"V3\": {\n      \"role\": \"analyzer_plus_repairer\",\n      \"metrics_applicable\": [\"intervention_precision\"]\n    },\n    \"V4_A\": {\n      \"role\": \"architectural_modeler\",\n      \"metrics_applicable\": [\"intervention_precision\"]\n    },\n    \"V4_B\": {\n      \"role\": \"conservative_decider\",\n      \"metrics_applicable\": [\"intervention_precision\"],\n      \"revealed_need\": \"coverage metrics\"\n    },\n    \"V4_B1\": {\n      \"role\": \"first_step_engineering_judgment\",\n      \"metrics_applicable\": [\"intervention_precision\", \"flow_discovery_recall\", \"risk_surface_coverage\", \"blind_zone_rate\", \"source_diversity\", \"sink_diversity\"],\n      \"phase_1_metric\": \"flow_discovery_recall\",\n      \"phase_2_metric\": \"intervention_precision\",\n      \"phase_3_metric\": \"finding_recall\"\n    }\n  }\n}\n"}
