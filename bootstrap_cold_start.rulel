@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="bootstrap_cold_start.mjs" lang="mjs"}
.source{content="/**\n * Cold-start rulel emitter (canonical = bootstrap_cold_start.rulel only).\n * Extracts TRANSPOSED_SOURCE .rulel → gitignored .mjs, then runs bootstrap_prelude.\n * Node is the host primitive; all bootstrap logic lives in LIN + .rulel mirrors.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { spawnSync } from 'node:child_process';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)));\n\nexport function extractRulelContent(rulelText) {\n  const marker = '.source{content=\"';\n  const start = rulelText.indexOf(marker);\n  if (start < 0) return null;\n  let i = start + marker.length;\n  let out = '';\n  while (i < rulelText.length) {\n    const ch = rulelText[i];\n    if (ch === '\\\\') {\n      const n = rulelText[i + 1];\n      const map = { n: '\\n', r: '\\r', t: '\\t', '\"': '\"', '\\\\': '\\\\' };\n      if (n in map) {\n        out += map[n];\n        i += 2;\n        continue;\n      }\n      out += n;\n      i += 2;\n      continue;\n    }\n    if (ch === '\"') break;\n    out += ch;\n    i += 1;\n  }\n  return out;\n}\n\nexport function emitRulelToMjs(rulelRel) {\n  const rulelPath = path.join(ROOT, rulelRel);\n  if (!fs.existsSync(rulelPath)) {\n    throw new Error(`bootstrap_cold_start: missing ${rulelRel}`);\n  }\n  const text = fs.readFileSync(rulelPath, 'utf8');\n  const content = extractRulelContent(text);\n  if (!content) {\n    throw new Error(`bootstrap_cold_start: no .source in ${rulelRel}`);\n  }\n  const m = text.match(/original=\"([^\"]+)\"/);\n  const outRel = m?.[1] || rulelRel.replace(/\\.rulel$/, '.mjs');\n  const outPath = path.join(ROOT, outRel);\n  fs.mkdirSync(path.dirname(outPath), { recursive: true });\n  fs.writeFileSync(outPath, content, 'utf8');\n  return outPath;\n}\n\nexport function runBootstrap() {\n  emitRulelToMjs('bootstrap_cold_start.rulel');\n  const preludeMjs = emitRulelToMjs('bootstrap_prelude.rulel');\n  const r = spawnSync(process.execPath, [preludeMjs], { cwd: ROOT, stdio: 'inherit' });\n  process.exit(r.status ?? 1);\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  runBootstrap();\n}\n"}
