@LIN:lin_baremetal_kernel:1.0.0
~G{?=if #=for ^=ret :else}

// ============================================================================
// LIN FREESTANDING BARE-METAL KERNEL (ZERO LIBC, ZERO RUNTIME)
// Target: x86_64 Freestanding
// Output: Serial COM1 (0x3F8) UART Output
// ============================================================================

*Native
!outb(port, val){
  // Direct ISA: outb %al, %dx
}

*Native
!inb(port){
  // Direct ISA: inb %dx, %al
}

*Native
!initSerial(port){
  outb(port + 1, 0x00); // Disable all interrupts
  outb(port + 3, 0x80); // Enable DLAB (set baud rate divisor)
  outb(port + 0, 0x03); // Set divisor to 3 (lo byte) 38400 baud
  outb(port + 1, 0x00); //                  (hi byte)
  outb(port + 3, 0x03); // 8 bits, no parity, one stop bit
  outb(port + 2, 0xC7); // Enable FIFO, clear them, with 14-byte threshold
  outb(port + 4, 0x0B); // IRQs enabled, RTS/DSR set
}

*Native
!writeSerialChar(port, charCode){
  outb(port, charCode);
}

*Native
!writeSerialString(port, str){
  #(i = 0; i < str.length; i = i + 1){
    writeSerialChar(port, str.charCodeAt(i));
  };
}

*Native
!kernelMain(){
  com1 = 0x3F8;
  initSerial(com1);
  writeSerialString(com1, "\n[LIN-OS] Sovereign Freestanding Kernel Booted Successfully!\n");
  writeSerialString(com1, "[LIN-OS] Zero libc | Zero host OS | Pure ISA Hardware Execution\n\n");
}

=ex{outb,inb,initSerial,writeSerialChar,writeSerialString,kernelMain}
