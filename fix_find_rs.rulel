@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="fix_find.rs" ext=".rs"}
.source{content="fn find_binary_op(s: &str, op: &str) -> Option<usize> {\n    let mut depth_paren = 0;\n    let mut depth_brace = 0;\n    let mut depth_bracket = 0;\n    let mut in_quote: Option<char> = None;\n    let mut escape = false;\n\n    let chars: Vec<char> = s.chars().collect();\n    let op_chars: Vec<char> = op.chars().collect();\n    let len = chars.len();\n    let op_len = op_chars.len();\n\n    for i in (0..len).rev() {\n        let c = chars[i];\n\n        if escape {\n            escape = false;\n            continue;\n        }\n\n        if c == '\\\\' {\n            escape = true;\n            continue;\n        }\n\n        if let Some(q) = in_quote {\n            if c == q { in_quote = None; }\n            continue;\n        } else if c == '\\'' || c == '\"' {\n            in_quote = Some(c);\n            continue;\n        }\n\n        match c {\n            ')' => depth_paren += 1,\n            '(' => if depth_paren > 0 { depth_paren -= 1; },\n            '}' => depth_brace += 1,\n            '{' => if depth_brace > 0 { depth_brace -= 1; },\n            ']' => depth_bracket += 1,\n            '[' => if depth_bracket > 0 { depth_bracket -= 1; },\n            _ => {}\n        }\n\n        if depth_paren == 0 && depth_brace == 0 && depth_bracket == 0 && in_quote.is_none() && i + op_len <= len {\n            if chars[i..i + op_len] == op_chars[..] {\n                if op == \"<\" && i + 1 < len && chars[i + 1] == '=' { continue; }\n                if op == \">\" && i + 1 < len && chars[i + 1] == '=' { continue; }\n                if op == \"=\" && (i > 0 && chars[i - 1] == '=' || i + 1 < len && chars[i + 1] == '=') { continue; }\n                if op == \"!\" && i + 1 < len && chars[i + 1] == '=' { continue; }\n\n                if op == \"-\" || op == \"+\" {\n                    // Check if previous non-whitespace char is an operator or open bracket\n                    let mut is_unary = false;\n                    let mut j = i;\n                    while j > 0 {\n                        j -= 1;\n                        if !chars[j].is_whitespace() {\n                            let prev = chars[j];\n                            if \"+-*/%<>=!&|([{},?:\".contains(prev) {\n                                is_unary = true;\n                            }\n                            break;\n                        }\n                    }\n                    if j == 0 && (i == 0 || chars[0].is_whitespace()) {\n                        is_unary = true;\n                    }\n                    if is_unary {\n                        continue;\n                    }\n                }\n                \n                return Some(i);\n            }\n        }\n    }\n    None\n}\n"}
