.source{content="{\n  \"protocol\": \"HS2_CONCURRENCY_V1\",\n  \"run_id\": \"RUN-HS2-CONCUR-20260816-001\",\n  \"timestamp_utc\": \"2026-08-16T17:49:39.841Z\",\n  \"total_scenarios\": 10,\n  \"aggregate_metrics\": {\n    \"total_scenarios_passed\": 10,\n    \"total_conflicts_handled\": 9,\n    \"total_rollbacks_executed\": 1,\n    \"total_deadlocks_observed\": 0,\n    \"invariant_violations\": 0,\n    \"escaped_illegal_effects\": 0\n  },\n  \"gate_verdict\": {\n    \"gate_hs2_safety\": true,\n    \"gate_hs2_consistency\": true,\n    \"gate_hs2_liveness\": true,\n    \"gate_hs2_overall\": true,\n    \"conclusion\": \"O benchmark HS2_CONCURRENCY_V1 demonstrou sobre 10 cenários e interleavings congelados que o mediador semântico LIN preserva linearizabilidade estrita, rejeita leituras obsoletas (TOCTOU), previne impasses em ordens totais e impede 100% de efeitos ilegais sob disputas concorrentes de múltiplos agentes.\"\n  },\n  \"scenarios\": [\n    {\n      \"scenario_id\": \"C01\",\n      \"name\": \"concurrent_write_after_write_collision\",\n      \"interleaving_id\": \"I001\",\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f810713700c4d7fa49730c80438a193860f27acafd255fe75\",\n      \"final_state_hash\": \"sha256:63f2e644174e1cf7848600091562760fcdedb3ca3ff6fc7dfd82d28dacae6a33\",\n      \"trace_hash\": \"sha256:3f7dd7c0a8eeabb5ff05346fe3f4855f7e892492501a0e4d5a350278252e3bc7\",\n      \"operations\": [\n        {\n          \"op_id\": \"OP_01\",\n          \"agent\": \"ag_001\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"COMMITTED\",\n            \"newVersion\": 2,\n            \"commitSeq\": 1\n          }\n        },\n        {\n          \"op_id\": \"OP_02\",\n          \"agent\": \"ag_002\",\n          \"res\": {\n            \"success\": false,\n            \"status\": \"STALE_STATE_CONFLICT_REJECTED\",\n            \"currentVersion\": 2,\n            \"reason\": \"Write rejected: record rec_balance was mutated concurrently (expected v1, found v2)\"\n          }\n        }\n      ],\n      \"concurrency\": {\n        \"conflicts_handled\": 1,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"state_reconciliation\": true,\n        \"linearizable\": true,\n        \"passed\": true\n      }\n    },\n    {\n      \"scenario_id\": \"C02\",\n      \"name\": \"stale_read_modify_write_race\",\n      \"interleaving_id\": \"I002\",\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f810713700c4d7fa49730c80438a193860f27acafd255fe75\",\n      \"final_state_hash\": \"sha256:c780cf96d802aa2a79768d0360322e86a44e3505a88ad8f6531fe29faf135e95\",\n      \"trace_hash\": \"sha256:9f479d9b5b726849fb132ff3ee91ab4216823dd4678c2390bb73c7178a786aac\",\n      \"operations\": [\n        {\n          \"op_id\": \"OP_01\",\n          \"agent\": \"ag_001\",\n          \"res\": {\n            \"success\": true,\n            \"val\": \"10\",\n            \"version\": 1,\n            \"status\": \"COMMITTED\"\n          }\n        },\n        {\n          \"op_id\": \"OP_02\",\n          \"agent\": \"ag_002\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"COMMITTED\",\n            \"newVersion\": 2,\n            \"commitSeq\": 1\n          }\n        },\n        {\n          \"op_id\": \"OP_03\",\n          \"agent\": \"ag_001\",\n          \"res\": {\n            \"success\": false,\n            \"status\": \"STALE_STATE_CONFLICT_REJECTED\",\n            \"currentVersion\": 2,\n            \"reason\": \"Write rejected: record rec_quota was mutated concurrently (expected v1, found v2)\"\n          }\n        }\n      ],\n      \"concurrency\": {\n        \"conflicts_handled\": 1,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"state_reconciliation\": true,\n        \"linearizable\": true,\n        \"passed\": true\n      }\n    },\n    {\n      \"scenario_id\": \"C03\",\n      \"name\": \"in_flight_policy_revocation_during_deploy\",\n      \"interleaving_id\": \"I003\",\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f810713700c4d7fa49730c80438a193860f27acafd255fe75\",\n      \"final_state_hash\": \"sha256:5ba6ca459932cebfe8f27f2a4230a52145dc90e3866fa7d00228fe3bd7c53a68\",\n      \"trace_hash\": \"sha256:dab5295e1c93f4ad65f049a2e9feca791f9009a68e4ed4b836686eab5b8973e5\",\n      \"operations\": [\n        {\n          \"op_id\": \"OP_01\",\n          \"agent\": \"ag_003\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"POLICY_REVOKED\",\n            \"commitSeq\": 1\n          }\n        },\n        {\n          \"op_id\": \"OP_02\",\n          \"agent\": \"ag_001\",\n          \"res\": {\n            \"success\": false,\n            \"status\": \"BLOCKED_OBSOLETE_PLAN\",\n            \"reason\": \"Policy POL_DEPLOY_NUCLEUS was revoked mid-flight; deployment aborted before side-effect.\"\n          }\n        }\n      ],\n      \"concurrency\": {\n        \"conflicts_handled\": 1,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"state_reconciliation\": true,\n        \"linearizable\": true,\n        \"passed\": true\n      }\n    },\n    {\n      \"scenario_id\": \"C04\",\n      \"name\": \"mutual_delegation_deadlock_prevention\",\n      \"interleaving_id\": \"I004\",\n      \"linearization_class\": \"DEADLOCK_FREE_TOTAL_ORDER\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f81071370