enario_id\": \"C10\",\n      \"name\": \"cascading_revocation_under_active_delegation_tree\",\n      \"interleaving_id\": \"I010\",\n      \"linearization_class\": \"STRICT_SERIALIZABLE\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f810713700c4d7fa49730c80438a193860f27acafd255fe75\",\n      \"final_state_hash\": \"sha256:9a054fe908073d9b2e4b2b9edeed5f78ac500e4c81ee9da0bdda5100adb1c9df\",\n      \"trace_hash\": \"sha256:dc0ce2237d04e9b9d98b1039c9664b1d540b5d02e82c9a1d1ba73f927f8185d4\",\n      \"operations\": [\n        {\n          \"op_id\": \"OP_01\",\n          \"status\": \"CASCADE_REVOKED\"\n        },\n        {\n          \"op_id\": \"OP_02\",\n          \"status\": \"DOWNSTREAM_ABORTED_CLEAN\"\n        }\n      ],\n      \"concurrency\": {\n        \"conflicts_handled\": 1,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"state_reconciliation\": true,\n        \"linearizable\": true,\n        \"passed\": true\n      }\n    }\n  ]\n}"}
