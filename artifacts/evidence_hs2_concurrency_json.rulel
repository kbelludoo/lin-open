 \"conflicts_handled\": 1,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"state_reconciliation\": true,\n        \"linearizable\": true,\n        \"passed\": true\n      }\n    },\n    {\n      \"scenario_id\": \"C06\",\n      \"name\": \"multi_agent_concurrent_ledger_append\",\n      \"interleaving_id\": \"I006\",\n      \"linearization_class\": \"MONOTONIC_TOTAL_ORDER\",\n      \"initial_state_hash\": \"sha256:fbd12cf204346d9f810713700c4d7fa49730c80438a193860f27acafd255fe75\",\n      \"final_state_hash\": \"sha256:2e0525c534833d7aa5c254b9dfc69baccada229e66a783a9165f5b0415facf40\",\n      \"trace_hash\": \"sha256:d7e17629673f7a15863e78cafbd5a9ad2eee6d296f6cbd6a6005fa309cb0ea35\",\n      \"operations\": [\n        {\n          \"op_id\": \"OP_01\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"LEDGER_COMMITTED\",\n            \"block\": 1,\n            \"hash\": \"4a6a1d3d64b591d89049d3b0d0703b0a13b42fe045316cfaa219788943084188\"\n          }\n        },\n        {\n          \"op_id\": \"OP_02\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"LEDGER_COMMITTED\",\n            \"block\": 2,\n            \"hash\": \"6bfa55726374ea83c93a405a9f8ea5fb84bf86d85cd70856293c93b129418b4f\"\n          }\n        },\n        {\n          \"op_id\": \"OP_03\",\n          \"res\": {\n            \"success\": true,\n            \"status\": \"LEDGER_COMMITTED\",\n            \"block\": 3,\n            \"hash\": \"4ae1917bfabbb496c2642247ad5a2b1b228af96874a034c6036a1092e5651b83\"\n          }\n        }\n      ],\n      \"concurrency\": {\n        \"conflicts_handled\": 0,\n        \"rollbacks_executed\": 0,\n        \"deadlocks_observed\": 0\n      },\n      \"validation\": {\n        \"invariant_violations\": 0,\n        \"escaped_illegal_effects\": 0,\n        \"sta