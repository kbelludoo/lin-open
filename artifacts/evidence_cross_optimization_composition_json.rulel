.source{content="{\n  \"protocol\": \"CROSS_OPTIMIZATION_COMPOSITION_V1\",\n  \"run_id\": \"RUN-CROSS-COMP-20260816-001\",\n  \"timestamp_utc\": \"2026-08-16T17:55:00.433Z\",\n  \"baseline_duration_ms\": 3.676,\n  \"oracle_checksum\": 19760000,\n  \"nucleus_hash\": \"sha256:562e6904afa0948661fb02804a91be96d919dcd5ddbe6c54db5e0fc149d557df\",\n  \"compositions\": [\n    {\n      \"combination_id\": \"C_A\",\n      \"components\": [\n        \"OPT_A\"\n      ],\n      \"duration_ms\": 1.5468,\n      \"speedup_ratio\": 2.3765192655805536,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_B\",\n      \"components\": [\n        \"OPT_B\"\n      ],\n      \"duration_ms\": 1.6112,\n      \"speedup_ratio\": 2.281529294935452,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_C\",\n      \"components\": [\n        \"OPT_C\"\n      ],\n      \"duration_ms\": 1.6278,\n      \"speedup_ratio\": 2.2582626858336408,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_AB\",\n      \"components\": [\n        \"OPT_A\",\n        \"OPT_B\"\n      ],\n      \"duration_ms\": 1.6817,\n      \"speedup_ratio\": 2.185883332342273,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_BC\",\n      \"components\": [\n        \"OPT_B\",\n        \"OPT_C\"\n      ],\n      \"duration_ms\": 1.6082,\n      \"speedup_ratio\": 2.2857853500808356,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_AC\",\n      \"components\": [\n        \"OPT_A\",\n        \"OPT_C\"\n      ],\n      \"duration_ms\": 1.5801,\n      \"speedup_ratio\": 2.3264350357572305,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    },\n    {\n      \"combination_id\": \"C_AX_FAULT\",\n      \"components\": [\n        \"OPT_A\",\n        \"OPT_X\"\n      ],\n      \"duration_ms\": 0.0008,\n      \"speedup_ratio\": 4595,\n      \"zero_drift\": true,\n      \"regression_pass\": false,\n      \"nucleus_untouched\": true,\n      \"decision\": \"REJECTED_AND_ROLLED_BACK\"\n    },\n    {\n      \"combination_id\": \"C_ABC\",\n      \"components\": [\n        \"OPT_A\",\n        \"OPT_B\",\n        \"OPT_C\"\n      ],\n      \"duration_ms\": 1.6329,\n      \"speedup_ratio\": 2.251209504562435,\n      \"zero_drift\": true,\n      \"regression_pass\": true,\n      \"nucleus_untouched\": true,\n      \"decision\": \"PROMOTED\"\n    }\n  ],\n  \"gate_verdict\": {\n    \"gate_composition_equivalence\": true,\n    \"gate_emergent_conflict_detection\": true,\n    \"gate_performance_benefit\": true,\n    \"gate_nucleus_immutability\": true,\n    \"gate_cross_composition_overall\": true,\n    \"conclusion\": \"O benchmark CROSS_OPTIMIZATION_COMPOSITION_V1 demonstrou que otimizações de runtime individualmente verificadas (A, B, C) preservam equivalência semântica estrita quando compostas em pares (A+B, B+C, A+C) e em tríade (A+B+C), produzindo ganhos cumulativos de performance sem desvio de oráculo, enquanto combinações conflitantes (A + X_CONFLICT) são confiavelmente detectadas pela suíte de regressão global e revertidas via rollback.\"\n  }\n}"}
