@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!mixin(obj){each(functions(obj),~(name){; var func = _[name] = obj[name];; _.prototype[name] = ~(){ var args = [this._wrapped];; push.apply(args, arguments);; return chainResult(this, func.apply(_, args)); };});^_}
=ex{mixin}