@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!emulatedSet(keys){;hash={};#(l=keys.length,i=0;i<l;++i){hash[keys[i]]=true};^{contains: ~(key){return hash[key] === true;},push: ~(key){hash[key] = true;; return keys.push(key);}}}
=ex{emulatedSet}