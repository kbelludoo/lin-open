!intersection(array){;result=[];argsLength=arguments.length;#(i=0,length=getLength(array);i<length;i++){item=array[i];?(contains(result,item)){continue};j=undefined;#(j=1;j<argsLength;j++){?(!contains(arguments[j],item)){break}};?(j==argsLength){result.push(item)}};^result}
=ex{intersection}