@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!customRandom(alphabet,defaultSize,getRandom){;safeByteCutoff=256-(256%alphabet.length);?(safeByteCutoff==256){mask=alphabet.length-1;^~(size=defaultSize){;; if (!size) return ''; let id = '';; while (true) { let bytes = getRandom(size); let i = size;; while (i--) { id += alphabet[bytes[i] & mask];; if (id.length >= size) return id } }}};step=Math.ceil((1.6*256*defaultSize)/safeByteCutoff);^~(size=defaultSize){;; if (!size) return ''; let id = '';; while (true) { let bytes = getRandom(step); let i = step;; while (i--) {; if (bytes[i] < safeByteCutoff) { id += alphabet[bytes[i] % alphabet.length];; if (id.length >= size) return id } } }}}
=ex{customRandom}