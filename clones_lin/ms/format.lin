!format(ms,options){;?(typeof ms!='number'||!Number.isFinite(ms)){throw new Error('Value provided to ms.format() must be of type number.')};^(((__c)=>{?(__c){return(fmtLong(ms))};return(fmtShort(ms))})(options?.long))}
=ex{format}