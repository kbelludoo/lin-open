@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!parse(str){;?(typeof str!='string'||str.length==0||str.length>100){throw new Error( ("Value provided to ms.parse() must be a string with length between 1 and 99. value="+(JSON.stringify(str))),)};match=/^(?<value>-?\d*\.?\d+) *(?<unit>milliseconds?|msecs?|ms|seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mo|years?|yrs?|y)?$/i.exec( str,);?(!match?.groups){^NaN};({value,unit='ms'}=match.groups);n=parseFloat(value);matchUnit=unit.toLowerCase();switch (matchUnit){case 'years': case 'year': case 'yrs': case 'yr': case 'y':;^n*y;case 'months': case 'month': case 'mo':;^n*mo;case 'weeks': case 'week': case 'w':;^n*w;case 'days': case 'day': case 'd':;^n*d;case 'hours': case 'hour': case 'hrs': case 'hr': case 'h':;^n*h;case 'minutes': case 'minute': case 'mins': case 'min': case 'm':;^n*m;case 'seconds': case 'second': case 'secs': case 'sec': case 's':;^n*s;case 'milliseconds': case 'millisecond': case 'msecs': case 'msec': case 'ms':;^n;default: matchUnit;throw new Error( ("Unknown unit \""+(matchUnit)+"\" provided to ms.parse(). value="+(JSON.stringify(str))),)}}
=ex{parse}