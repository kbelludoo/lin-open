@LIN:L1c:1.0
^schema_once ^lossy=true ^ops=browser_types
~G{?=if #=for ^=ret :else}
~effects{pure}

// ==========================================
// 1. Data Models for Browser Subsystem in LIN
// ==========================================

!createTabInfo(targetId,url,title,parentTargetId){
  tid=String(targetId||"");
  shortId=?(tid.length>4){tid.slice(-4)}:tid;
  pid=?(parentTargetId){String(parentTargetId)}:null;
  shortPid=?(pid&&pid.length>4){pid.slice(-4)}:pid;
  ^({
    target_id: tid,
    tab_id: shortId,
    url: url||"about:blank",
    title: title||"",
    parent_target_id: pid,
    parent_tab_id: shortPid
  })
}

!createPageInfo(vpWidth,vpHeight,pageWidth,pageHeight,scrollX,scrollY){
  vw=vpWidth|0;
  vh=vpHeight|0;
  pw=pageWidth|0;
  ph=pageHeight|0;
  sx=scrollX|0;
  sy=scrollY|0;
  above=sy;
  below=Math.max(0,ph-sy-vh);
  left=sx;
  right=Math.max(0,pw-sx-vw);
  ^({
    viewport_width: vw,
    viewport_height: vh,
    page_width: pw,
    page_height: ph,
    scroll_x: sx,
    scroll_y: sy,
    pixels_above: above,
    pixels_below: below,
    pixels_left: left,
    pixels_right: right
  })
}

!createBrowserConfig(opts){
  o=opts||{};
  ^({
    headless: o.headless!==undefined?o.headless:true,
    cdp_url: o.cdp_url||null,
    window_width: o.window_width||1280,
    window_height: o.window_height||800,
    allowed_domains: o.allowed_domains||[],
    prohibited_domains: o.prohibited_domains||[],
    user_data_dir: o.user_data_dir||null,
    keep_alive: !!o.keep_alive,
    highlight_elements: o.highlight_elements!==undefined?o.highlight_elements:true
  })
}

!createBrowserState(url,title,tabs,domState,pageInfo,screenshot,errors){
  ^({
    url: url||"",
    title: title||"",
    tabs: tabs||[],
    dom_state: domState||{},
    page_info: pageInfo||null,
    screenshot: screenshot||null,
    browser_errors: errors||[],
    timestamp: Date.now()
  })
}

!createActionResult(isDone,extractedContent,error,includeInMemory){
  ^({
    is_done: !!isDone,
    extracted_content: extractedContent!==undefined?extractedContent:null,
    error: error||null,
    include_in_memory: includeInMemory!==false
  })
}

!createAction(name,params){
  ^({
    name: String(name||""),
    params: params||{},
    timestamp: Date.now()
  })
}

=ex{createTabInfo,createPageInfo,createBrowserConfig,createBrowserState,createActionResult,createAction}
