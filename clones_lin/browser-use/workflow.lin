@LIN:L1c:1.0
^schema_once ^ops=browser_agent_workflow
~G{?=if #=for ^=ret :else}
~effects{pure,io,async,state}

// ============================================================
// 7. LIN Autonomous Browser Agent Workflow Specification (L2w)
// ============================================================

!validateTask(task: str): bool {
  ^(task != "")
}

!checkSecurity(url: str, allowed: list, prohibited: list): bool {
  ^(url != "")
}

!extractDomState(pageId: str): object {
  ^({ page_id: pageId, ready: true, extracted_at: Date.now() })
}

!executeStep(actionPlan: object): object {
  ^({ executed: true, plan: actionPlan, result: "OK" })
}

// Canonical Autonomous Agent Browser Workflow DAG
~workflow {
  step init_session -> createBrowserSession(config)
  step validate_url  -> ?(checkSecurity(target_url, allowed_domains, prohibited_domains)) -> continue : -> abort("BLOCKED_DOMAIN")
  step open_page     -> retry(3, exp) navigateUrl(session, target_url)
  step capture_dom   -> extractDomState(session.active_tab_id)
  step capture_view  -> captureScreenshot(session)
  step model_decide  -> queryAgentModel(task, capture_dom, capture_view)
  step run_actions   -> executeStep(model_decide.action_plan)
  step check_finish  -> ?(model_decide.is_done) -> done(model_decide.final_result) : -> loop_to(capture_dom)
}

=ex{validateTask,checkSecurity,extractDomState,executeStep}
