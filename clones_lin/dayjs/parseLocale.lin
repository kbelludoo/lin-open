!parseLocale(preset,object,isLocal){;?(!preset){^L};?(typeof preset=='string'){presetLower=preset.toLowerCase();?(Ls[presetLower]){l=presetLower};?(object){Ls[presetLower]=object;l=presetLower};presetSplit=preset.split('-');?(!l&&presetSplit.length>1){^parseLocale(presetSplit[0])}}:{({name}=preset);Ls[name]=preset;l=name};?(!isLocal&&l){L=l};^l||(!isLocal&&L)}
=ex{parseLocale}