@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!padZoneStr(instance){;negMinutes=-instance.utcOffset();minutes=Math.abs(negMinutes);hourOffset=Math.floor(minutes/60);minuteOffset=minutes%60;^(String((((__c)=>{?(__c){return('+')}return('-')})(negMinutes<=0)))+String(padStart(hourOffset,2,'0'))+":"+String(padStart(minuteOffset,2,'0')))}
=ex{padZoneStr}