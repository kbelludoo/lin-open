@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!specialMutationForYears(number){switch (lastNumber(number)){case 1: case 3: case 4: case 5: case 9:;^(String(number)+" bloaz") default:;^(String(number)+" vloaz")}}
=ex{specialMutationForYears}