@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!getNumberUnitFormat(number,unit){;?(!number){^{negative: false,format: ''}};?(isNegative(number)){^{negative: true,format: (String(absolute(number))+String(unit))}};^{negative: false,format: (String(number)+String(unit))}}
=ex{getNumberUnitFormat}