@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!rangeToTypedSegment(str){;([label,range]=splitRangeKeyValuePair(str));value=parseRangeValues(range);result={type: 'range',value};?(label){result.label=label};^result}
=ex{rangeToTypedSegment}