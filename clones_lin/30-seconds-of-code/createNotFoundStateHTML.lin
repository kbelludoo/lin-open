@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!createNotFoundStateHTML(query){;escapedQuery=query .replace(/&/g,'&amp;') .replace(/</g,'&lt;') .replace(/>/g,'&gt;') .replace(/"/g, '&quot;')       .replace(/'/g, '&#039;');     return `<p>       We couldn't find any results for the keyphrase <strong>${escapedQuery}</strong>.     </p>`;   }
=ex{createNotFoundStateHTML}