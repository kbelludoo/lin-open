@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!transformHeadings(minLevel,maxLevel){;^~(tree){visit(tree, `element`, ~(node){; if (!node.tagName) return;; const isHeading = node.tagName.match(/^h[123456]$/);;; if (!isHeading) return;; const level = isHeading[1];;; if (level < minLevel) node.tagName = `h${minLevel}`;; else if (level > maxLevel) node.tagName = `h${maxLevel}`;; const id = StringUtils.convertToValidId(toString(node));; node.children = [ { type: `element`, tagName: `a`, properties: { href: `#${id}`, id }, children: [...node.children], }, ]; });; return tree;}}
=ex{transformHeadings}