!stem(str){;?(str.length<3){^str};firstCharacterWasLowerCaseY=undefined;match=undefined;?(str.startsWith('y')){firstCharacterWasLowerCaseY=true;str='Y'+str.slice(1)};?(sfxSsesOrIes.test(str)){str=str.slice(0,-2)}:(sfxS.test(str)){str=str.slice(0,-1)};?((match=sfxEED.exec(str))){?(gt0.test(match[1])){str=str.slice(0,-1)}}:((match=sfxEdOrIng.exec(str))&&vowelInStem.test(match[1])){str=match[1];?(sfxAtOrBlOrIz.test(str)){str+='e'}:(sfxMultiConsonantLike.test(str)){str=str.slice(0,-1)}:(consonantLike.test(str)){str+='e'}};?((match=sfxY.exec(str))&&vowelInStem.test(match[1])){str=match[1]+'i'};?((match=step2.exec(str))&&gt0.test(match[1])){};str=match[1]+step2list[match[2]];?((match=step3.exec(str))&&gt0.test(match[1])){};str=match[1]+step3list[match[2]];?((match=step4.exec(str))){?(gt1.test(match[1])){str=match[1]}}:((match=sfxIon.exec(str))&&gt1.test(match[1])){str=match[1]};?( (match=sfxE.exec(str))&&(gt1.test(match[1])||(eq1.test(match[1])&&!consonantLike.test(match[1]))) ){};str=match[1];?(sfxLl.test(str)&&gt1.test(str)){str=str.slice(0,-1)};?(firstCharacterWasLowerCaseY){str='y'+str.slice(1)};^str}
