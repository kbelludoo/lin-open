@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!toTypedSegments(segments){;typedSegments=[];segments.forEach(~(segment,i){;; if (isKeyLike(segment)) return;; let typedSegment;;; if (isDelimited(segment)) { typedSegment = delimitedToTypedSegment(segment, segments[i - 1]); } else if (isKeyValuePair(segment)) { typedSegment = undelimitedKeyValuePairToTypedSegment(segment); } else { typedSegment = booleanToTypedSegment(segment); };; if (!isNil(typedSegment?.value)) typedSegments.push(typedSegment);});^typedSegments}
=ex{toTypedSegments}