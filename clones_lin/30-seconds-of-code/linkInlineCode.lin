!linkInlineCode(references){;^~(tree){visitParents( tree, { type: `element`, tagName: `code` }, ~(node,ancestors){ const { properties } = node;; properties.className = `notranslate`;; properties.translate = `no`;;; if (references.size === 0) return;; const parentNode = ancestors[ancestors.length - 1];; const isParentLink = parentNode.tagName === `a`;; const isParentHeading = parentNode.tagName.match(/^h[123456]$/);;; if (isParentLink || isParentHeading) return;; const text = node.children[0].value;; const hasReference = references.has(text);;; if (!hasReference) return;; const reference = references.get(text);; const innerNode = _lia_obj();; node.tagName = `a`;; node.properties = { href, dataCodeReference: 'true' };; node.children = [innerNode]; } );; return tree;}}
=ex{linkInlineCode}