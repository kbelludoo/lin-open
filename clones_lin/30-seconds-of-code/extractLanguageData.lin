@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!extractLanguageData(languageGlob){;languageData=FileHandler.read(languageGlob);^languageData.reduce(~(acc,language){; const { short, long, name, references = {}, additionalReferences = [], } = language;; acc.set(long, { id, long, short, name, references, allLanguageReferences: [long, ...additionalReferences], });; return acc;},new Map())}
=ex{extractLanguageData}