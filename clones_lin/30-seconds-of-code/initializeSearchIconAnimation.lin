!initializeSearchIconAnimation(){this.searchIconAnimation=this.searchIcon.animate( [{transform: 'scale(1)'},{transform: 'scale(1.1)'},{transform: 'scale(1)'},],{duration: 750,delay: 250,easing: 'ease'});this.searchIconAnimation.pause()}
=ex{initializeSearchIconAnimation}