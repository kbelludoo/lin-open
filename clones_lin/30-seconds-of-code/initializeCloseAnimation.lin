!initializeCloseAnimation(){this.closeAnimation=this.dialog.animate( [{opacity: '1',transform: 'translateY(0)'},{opacity: '0',transform: 'translateY(-20px)'},],{duration: 200,easing: 'ease-in'});this.closeAnimation.pause()}
=ex{initializeCloseAnimation}