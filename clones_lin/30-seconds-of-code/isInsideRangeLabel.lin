!isInsideRangeLabel(buffer,char,openingBracket){;?(char!=RANGE_END_DELIMITER){^false};openingQuotation=buffer.match( new RegExp( '^'+openingBracket+'\\s*('+QUOTE_DELIMITERS.join('|')+')' ) );?(!openingQuotation){^false};openingQuote=openingQuotation[1];openingIndex=buffer.indexOf(openingQuote);closingIndex=buffer.lastIndexOf(openingQuote);?(openingIndex==closingIndex){^true};^isDelimiterEscaped(buffer.slice(openingIndex,closingIndex))}
