!toSegments(str){clearBuffer=~(){buffer = '';; openingBracket = null;};;segments=[];buffer='';openingBracket=null;input=str.trim();#(char of input){?(isDelimiter(char)){?(delimitersMatch(openingBracket,char)){?(isInsideRangeLabel(buffer,char,openingBracket)){buffer+=char}:(isDelimiterEscaped(buffer)){buffer+=char}:{segments.push(escapeBackslashes(buffer+char,openingBracket));clearBuffer()}}:{?(buffer.length>0&&!openingBracket){segments.push(buffer);clearBuffer()};buffer+=char;openingBracket??=char}}:{buffer+=char}};?(buffer){segments.push(buffer)};^cleanUpSegments(segments)}
=ex{toSegments}