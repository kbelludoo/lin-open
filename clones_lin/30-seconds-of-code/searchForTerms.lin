@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!searchForTerms(documentIndex,terms){;scores=[];lastTermIndex=(((__c)=>{?(__c){return(terms.length-1)}return(-1)})(partialMatchLastTerm&&terms[terms.length-1].length>=2));documentIndex.documents.forEach(~(doc,docId){; let score = 0;; terms.forEach(~(term,i){; if (documentIndex.invertedIndex.has(term)) { const indexEntry = documentIndex.invertedIndex.get(term).get(docId);;; if (indexEntry) { const tf = indexEntry / doc.length;; const idf = Math.log( documentIndex.documents.size / documentIndex.invertedIndex.get(term).size );; score += tf * idf; } } else if (i === lastTermIndex) { const matchedTerms = doc?.rawContent?.match( new RegExp(`\\b${term}.*?\\b`, 'gi') );;; if (matchedTerms) { const { termFrequency, totalTermFrequency } = matchedTerms.reduce( ~(acc,match){ const term = match.toLowerCase();; const indexEntries = documentIndex.invertedIndex.get(term);;; if (indexEntries) { acc.termFrequency += indexEntries.get(docId) ?? 0;; acc.totalTermFrequency += indexEntries.size; }; return acc; }, { termFrequency: 0, totalTermFrequency: 0 } );; const tf = termFrequency / doc.length;; const idf = Math.log( documentIndex.documents.size / (totalTermFrequency || 1) );; score += tf * idf; } } });;; if (score > 0) scores.push([docId, score]);});^scores}
=ex{searchForTerms}