@LIN:vscode_piece_tree:1.0.0
~G{?=if #=for ^=ret :else}

!createPieceTree(initialContent){
  buffers = [String(initialContent || "")];
  pieces = [];
  ?(buffers[0].length > 0){
    pieces.push({ bufferIndex: 0, start: 0, length: buffers[0].length });
  };
  ^{
    getLineCount: ~(){
      text = "";
      #(i = 0; i < pieces.length; i = i + 1){
        p = pieces[i];
        text = text + buffers[p.bufferIndex].substr(p.start, p.length);
      };
      lines = text.split("\n");
      ^lines.length;
    },
    getValue: ~(){
      text = "";
      #(i = 0; i < pieces.length; i = i + 1){
        p = pieces[i];
        text = text + buffers[p.bufferIndex].substr(p.start, p.length);
      };
      ^text;
    },
    getLength: ~(){
      len = 0;
      #(i = 0; i < pieces.length; i = i + 1){
        len = len + pieces[i].length;
      };
      ^len;
    },
    insert: ~(offset, text){
      ?(text.length === 0){ ^ };
      bufIdx = buffers.length;
      buffers.push(text);
      newPiece = { bufferIndex: bufIdx, start: 0, length: text.length };
      
      ?(pieces.length === 0){
        pieces.push(newPiece);
        ^;
      };
      
      curOffset = 0;
      inserted = false;
      newPieces = [];
      #(i = 0; i < pieces.length; i = i + 1){
        p = pieces[i];
        pEnd = curOffset + p.length;
        ?(!inserted && offset <= curOffset){
          newPieces.push(newPiece);
          newPieces.push(p);
          inserted = true;
        }
        : (!inserted && offset < pEnd){
          split1Len = offset - curOffset;
          split2Len = p.length - split1Len;
          newPieces.push({ bufferIndex: p.bufferIndex, start: p.start, length: split1Len });
          newPieces.push(newPiece);
          newPieces.push({ bufferIndex: p.bufferIndex, start: p.start + split1Len, length: split2Len });
          inserted = true;
        }
        : {
          newPieces.push(p);
        };
        curOffset = pEnd;
      };
      ?(!inserted){
        newPieces.push(newPiece);
      };
      pieces = newPieces;
    },
    deleteRange: ~(offset, length){
      ?(length <= 0 || pieces.length === 0){ ^ };
      delEnd = offset + length;
      curOffset = 0;
      newPieces = [];
      #(i = 0; i < pieces.length; i = i + 1){
        p = pieces[i];
        pEnd = curOffset + p.length;
        ?(pEnd <= offset || curOffset >= delEnd){
          newPieces.push(p);
        }
        : {
          ?(curOffset < offset){
            newPieces.push({ bufferIndex: p.bufferIndex, start: p.start, length: offset - curOffset });
          };
          ?(pEnd > delEnd){
            remStart = p.start + (delEnd - curOffset);
            remLen = pEnd - delEnd;
            newPieces.push({ bufferIndex: p.bufferIndex, start: remStart, length: remLen });
          };
        };
        curOffset = pEnd;
      };
      pieces = newPieces;
    }
  }
}

=ex{createPieceTree}
