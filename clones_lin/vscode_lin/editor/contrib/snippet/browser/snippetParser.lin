  ^{ className: "FormatString", methods: ["resolve", "if", "if", "if", "if", "if", "if", "if", "_toKebabCase", "if", "if", "_toPascalCase", "if", "_toCamelCase", "if", "if", "_toSnakeCase", "toTextmateString", "if", "if", "if", "if", "clone"] };
}

