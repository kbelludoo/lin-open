}

!createSnippetParser(...args){
  ^{ className: "SnippetParser", methods: ["escape", "asInsertText", "guessNeedsClipboard", "parse", "parseFragment", "walk", "if", "if", "for", "for", "ensureFinalTabstop", "if", "if", "_accept", "if", "_backTo", "_until", "while", "if", "if", "if", "_parse", "_parseEscaped", "_parseTabstopOrVariableName", "if", "_parseComplexPlaceholder", "if", "while", "while", "_parseChoiceElement", "while", "if", "if", "if", "_parseComplexVariable", "if", "while", "_parseTransform", "while", "if", "while", "while", "if", "catch", "_parseFormatString", "if", "if", "if", "if", "if", "if", "if", "_parseAnything", "if"] };
