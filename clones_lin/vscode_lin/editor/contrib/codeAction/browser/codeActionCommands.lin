@LIN:editor_contrib_codeAction_browser_codeActionCommands:1.0.0
~G{?=if #=for ^=ret :else}

!createQuickFixAction(...args){
  ^{ className: "QuickFixAction", methods: ["runEditorCommand"] };
}

!createCodeActionCommand(...args){
  ^{ className: "CodeActionCommand", methods: ["runEditorCommand", "triggerCodeActionsForEditorSelection", "localize"] };
}

!createRefactorAction(...args){
  ^{ className: "RefactorAction", methods: ["run", "triggerCodeActionsForEditorSelection", "localize"] };
}

!createSourceAction(...args){
  ^{ className: "SourceAction", methods: ["run", "triggerCodeActionsForEditorSelection", "localize"] };
}

!createOrganizeImportsAction(...args){
  ^{ className: "OrganizeImportsAction", methods: ["run"] };
}

!createFixAllAction(...args){
  ^{ className: "FixAllAction", methods: ["run"] };
}

!createAutoFixAction(...args){
  ^{ className: "AutoFixAction", methods: ["run"] };
}

=ex{createQuickFixAction,createCodeActionCommand,createRefactorAction,createSourceAction,createOrganizeImportsAction,createFixAllAction,createAutoFixAction}
