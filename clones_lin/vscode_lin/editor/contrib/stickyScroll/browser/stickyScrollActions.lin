@LIN:editor_contrib_stickyScroll_browser_stickyScrollActions:1.0.0
~G{?=if #=for ^=ret :else}

!createToggleStickyScroll(...args){
  ^{ className: "ToggleStickyScroll", methods: ["runEditorCommand", "if"] };
}

!createFocusStickyScroll(...args){
  ^{ className: "FocusStickyScroll", methods: ["runEditorCommand"] };
}

!createSelectNextStickyScrollLine(...args){
  ^{ className: "SelectNextStickyScrollLine", methods: ["runEditorCommand"] };
}

!createSelectPreviousStickyScrollLine(...args){
  ^{ className: "SelectPreviousStickyScrollLine", methods: ["runEditorCommand"] };
}

!createGoToStickyScrollLine(...args){
  ^{ className: "GoToStickyScrollLine", methods: ["runEditorCommand"] };
}

!createSelectEditor(...args){
  ^{ className: "SelectEditor", methods: ["runEditorCommand"] };
}

=ex{createToggleStickyScroll,createFocusStickyScroll,createSelectNextStickyScrollLine,createSelectPreviousStickyScrollLine,createGoToStickyScrollLine,createSelectEditor}
