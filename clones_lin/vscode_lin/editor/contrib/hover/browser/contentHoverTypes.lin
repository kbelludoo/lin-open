@LIN:editor_contrib_hover_browser_contentHoverTypes:1.0.0
~G{?=if #=for ^=ret :else}

!createContentHoverResult(...args){
  ^{ className: "ContentHoverResult", methods: ["filter", "if"] };
}

!createFilteredContentHoverResult(...args){
  ^{ className: "FilteredContentHoverResult", methods: ["filter"] };
}

=ex{createContentHoverResult,createFilteredContentHoverResult}
