@LIN:editor_contrib_hover_browser_hoverTypes:1.0.0
~G{?=if #=for ^=ret :else}

!createHoverRangeAnchor(...args){
  ^{ className: "HoverRangeAnchor", methods: ["equals", "canAdoptVisibleHover"] };
}

!createHoverForeignElementAnchor(...args){
  ^{ className: "HoverForeignElementAnchor", methods: ["equals", "canAdoptVisibleHover"] };
}

=ex{createHoverRangeAnchor,createHoverForeignElementAnchor}
