@LIN:editor_contrib_inlineCompletions_browser_hintsWidget_inlineCompletionsHintsWidget:1.0.0
~G{?=if #=for ^=ret :else}

!createInlineCompletionsHintsWidget(...args){
  ^{ className: "InlineCompletionsHintsWidget", methods: ["if", "if"] };
}

!createCustomizedMenuWorkbenchToolBar(...args){
  ^{ className: "CustomizedMenuWorkbenchToolBar", methods: ["updateToolbar", "setPrependedPrimaryActions", "setAdditionalPrimaryActions", "setAdditionalSecondaryActions"] };
}

=ex{createInlineCompletionsHintsWidget,createCustomizedMenuWorkbenchToolBar}
