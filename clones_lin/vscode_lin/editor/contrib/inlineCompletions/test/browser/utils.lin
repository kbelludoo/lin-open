@LIN:editor_contrib_inlineCompletions_test_browser_utils:1.0.0
~G{?=if #=for ^=ret :else}

!createInlineEditContext(...args){
  ^{ className: "InlineEditContext", methods: ["if", "getAndClearViewStates"] };
}

!createGhostTextContext(...args){
  ^{ className: "GhostTextContext", methods: ["currentPrettyViewState", "if", "if", "getAndClearViewStates", "keyboardType", "cursorUp", "cursorRight", "cursorLeft", "cursorDown", "cursorLineEnd", "leftDelete"] };
}

!createAnnotatedString(...args){
  ^{ className: "AnnotatedString", methods: ["getMarkerOffset", "if"] };
}

!createAnnotatedText(...args){
  ^{ className: "AnnotatedText", methods: ["getMarkerPosition"] };
}

=ex{createInlineEditContext,createGhostTextContext,createAnnotatedString,createAnnotatedText}
