@LIN:editor_contrib_colorPicker_browser_colorPickerParts_colorPickerStrip:1.0.0
~G{?=if #=for ^=ret :else}

!createOpacityStrip(...args){
  ^{ className: "OpacityStrip", methods: ["onDidChangeColor", "getValue"] };
}

!createHueStrip(...args){
  ^{ className: "HueStrip", methods: ["getValue"] };
}

=ex{createOpacityStrip,createHueStrip}
