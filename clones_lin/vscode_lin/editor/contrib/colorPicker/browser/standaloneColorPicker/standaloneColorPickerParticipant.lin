@LIN:editor_contrib_colorPicker_browser_standaloneColorPicker_standaloneColorPickerParticipant:1.0.0
~G{?=if #=for ^=ret :else}

!createStandaloneColorPickerRenderedParts(...args){
  ^{ className: "StandaloneColorPickerRenderedParts", methods: ["if"] };
}

!createStandaloneColorPickerParticipant(...args){
  ^{ className: "StandaloneColorPickerParticipant", methods: ["createColorHover", "if", "for", "updateEditorModel", "if", "renderHoverParts", "_setMinimumDimensions", "_color"] };
}

=ex{createStandaloneColorPickerRenderedParts,createStandaloneColorPickerParticipant}
