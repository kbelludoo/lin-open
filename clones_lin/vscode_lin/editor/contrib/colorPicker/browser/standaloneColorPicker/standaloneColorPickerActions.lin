@LIN:editor_contrib_colorPicker_browser_standaloneColorPicker_standaloneColorPickerActions:1.0.0
~G{?=if #=for ^=ret :else}

!createShowOrFocusStandaloneColorPicker(...args){
  ^{ className: "ShowOrFocusStandaloneColorPicker", methods: ["runEditorCommand"] };
}

!createHideStandaloneColorPicker(...args){
  ^{ className: "HideStandaloneColorPicker", methods: ["run"] };
}

!createInsertColorWithStandaloneColorPicker(...args){
  ^{ className: "InsertColorWithStandaloneColorPicker", methods: ["run"] };
}

=ex{createShowOrFocusStandaloneColorPicker,createHideStandaloneColorPicker,createInsertColorWithStandaloneColorPicker}
