@LIN:editor_contrib_gotoSymbol_browser_goToCommands:1.0.0
~G{?=if #=for ^=ret :else}

!createSymbolNavigationAnchor(...args){
  ^{ className: "SymbolNavigationAnchor", methods: ["is", "if", "if"] };
}

!createDefinitionAction(...args){
  ^{ className: "DefinitionAction", methods: ["_getLocationModel", "_getNoResultFoundMessage", "_getAlternativeCommand", "_getGoToPreference"] };
}

=ex{createSymbolNavigationAnchor,createDefinitionAction}
