@LIN:editor_standalone_browser_quickAccess_standaloneCommandsQuickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!createStandaloneCommandsQuickAccessProvider(...args){
  ^{ className: "StandaloneCommandsQuickAccessProvider", methods: ["activeTextEditorControl", "getCommandPicks", "hasAdditionalCommandPicks", "getAdditionalCommandPicks"] };
}

!createGotoLineAction(...args){
  ^{ className: "GotoLineAction", methods: ["run"] };
}

=ex{createStandaloneCommandsQuickAccessProvider,createGotoLineAction}
