@LIN:editor_standalone_browser_quickAccess_standaloneGotoSymbolQuickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!createStandaloneGotoSymbolQuickAccessProvider(...args){
  ^{ className: "StandaloneGotoSymbolQuickAccessProvider", methods: ["activeTextEditorControl"] };
}

!createGotoSymbolAction(...args){
  ^{ className: "GotoSymbolAction", methods: ["run"] };
}

=ex{createStandaloneGotoSymbolQuickAccessProvider,createGotoSymbolAction}
