@LIN:editor_browser_controller_dragScrolling:1.0.0
~G{?=if #=for ^=ret :else}

!createTopBottomDragScrolling(...args){
  ^{ className: "TopBottomDragScrolling", methods: ["_createDragScrollingOperation"] };
}

!createTopBottomDragScrollingOperation(...args){
  ^{ className: "TopBottomDragScrollingOperation", methods: ["_getScrollSpeed", "if", "if", "_execute", "if", "if"] };
}

!createLeftRightDragScrolling(...args){
  ^{ className: "LeftRightDragScrolling", methods: ["_createDragScrollingOperation"] };
}

!createLeftRightDragScrollingOperation(...args){
  ^{ className: "LeftRightDragScrollingOperation", methods: ["_getScrollSpeed", "if", "if", "_execute", "if", "if"] };
}

=ex{createTopBottomDragScrolling,createTopBottomDragScrollingOperation,createLeftRightDragScrolling,createLeftRightDragScrollingOperation}
