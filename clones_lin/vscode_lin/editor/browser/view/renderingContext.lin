@LIN:editor_browser_view_renderingContext:1.0.0
~G{?=if #=for ^=ret :else}

!createRenderingContext(...args){
  ^{ className: "RenderingContext", methods: ["linesVisibleRangesForRange", "if", "if", "if", "visibleRangeForPosition"] };
}

!createLineVisibleRanges(...args){
  ^{ className: "LineVisibleRanges", methods: ["firstLine", "if", "for", "if", "lastLine", "if", "for", "if"] };
}

!createHorizontalRange(...args){
  ^{ className: "HorizontalRange", methods: ["from", "for", "toString"] };
}

!createFloatHorizontalRange(...args){
  ^{ className: "FloatHorizontalRange", methods: ["toString", "compare"] };
}

!createHorizontalPosition(...args){
  ^{ className: "HorizontalPosition", methods: [] };
}

!createVisibleRanges(...args){
  ^{ className: "VisibleRanges", methods: [] };
}

=ex{createRenderingContext,createLineVisibleRanges,createHorizontalRange,createFloatHorizontalRange,createHorizontalPosition,createVisibleRanges}
