@LIN:editor_browser_view_viewOverlays:1.0.0
~G{?=if #=for ^=ret :else}

!createViewOverlays(...args){
  ^{ className: "ViewOverlays", methods: ["shouldRender", "for", "dispose", "for", "getDomNode", "addDynamicOverlay", "onConfigurationChanged", "onFlushed", "onFocusChanged", "onLinesChanged", "onLinesDeleted", "onLinesInserted", "onScrollChanged", "onTokensChanged", "onZonesChanged", "prepareRender", "for", "render", "_viewOverlaysRender"] };
}

!createContentViewOverlays(...args){
  ^{ className: "ContentViewOverlays", methods: ["onConfigurationChanged", "onScrollChanged", "_viewOverlaysRender"] };
}

!createMarginViewOverlays(...args){
  ^{ className: "MarginViewOverlays", methods: ["onConfigurationChanged", "onScrollChanged", "_viewOverlaysRender"] };
}

=ex{createViewOverlays,createContentViewOverlays,createMarginViewOverlays}
