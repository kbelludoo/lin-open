@LIN:editor_browser_viewParts_viewCursors_viewCursor:1.0.0
~G{?=if #=for ^=ret :else}

!createViewCursor(...args){
  ^{ className: "ViewCursor", methods: ["getDomNode", "getPosition", "setPlurality", "switch", "show", "if", "hide", "if", "onConfigurationChanged", "onCursorPositionChanged", "if", "_getGraphemeAwarePosition", "_prepareRender", "if", "if", "if", "if", "if", "if", "if", "if", "if", "_getTokenClassName", "prepareRender", "render", "if", "if"] };
}

!getCursorPluralityEnum(){
  ^{ enumName: "CursorPlurality", members: ["Single", "MultiPrimary", "MultiSecondary"] };
}

=ex{createViewCursor,getCursorPluralityEnum}
