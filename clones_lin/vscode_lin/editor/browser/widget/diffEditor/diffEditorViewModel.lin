@LIN:editor_browser_widget_diffEditor_diffEditorViewModel:1.0.0
~G{?=if #=for ^=ret :else}

!createDiffState(...args){
  ^{ className: "DiffState", methods: ["fromDiffResult"] };
}

!createDiffMapping(...args){
  ^{ className: "DiffMapping", methods: ["if", "if"] };
}

!createUnchangedRegion(...args){
  ^{ className: "UnchangedRegion", methods: ["fromDiffs", "for", "if", "if", "if", "originalUnchangedRange", "modifiedUnchangedRange", "setVisibleRanges", "if", "for", "shouldHideControls", "getHiddenOriginalRange", "getHiddenModifiedRange", "setHiddenModifiedRange", "getMaxVisibleLineCountTop", "getMaxVisibleLineCountBottom", "showMoreAbove", "showMoreBelow", "showAll", "showModifiedLine", "if", "showOriginalLine", "if", "collapseAll", "setState"] };
}

=ex{createDiffState,createDiffMapping,createUnchangedRegion}
