@LIN:editor_browser_services_inlineCompletionsService:1.0.0
~G{?=if #=for ^=ret :else}

!createSnoozeInlineCompletion(...args){
  ^{ className: "SnoozeInlineCompletion", methods: ["run", "if", "if", "if", "getDurationFromUser", "if", "if", "if", "getCustomDurationFromUser", "if"] };
}

!createCancelSnoozeInlineCompletion(...args){
  ^{ className: "CancelSnoozeInlineCompletion", methods: ["run"] };
}

=ex{createSnoozeInlineCompletion,createCancelSnoozeInlineCompletion}
