@LIN:editor_common_textModelBracketPairs:1.0.0
~G{?=if #=for ^=ret :else}

!createBracketInfo(...args){
  ^{ className: "BracketInfo", methods: [] };
}

!createBracketPairInfo(...args){
  ^{ className: "BracketPairInfo", methods: ["openingBracketInfo", "closingBracketInfo"] };
}

!createBracketPairWithMinIndentationInfo(...args){
  ^{ className: "BracketPairWithMinIndentationInfo", methods: [] };
}

=ex{createBracketInfo,createBracketPairInfo,createBracketPairWithMinIndentationInfo}
