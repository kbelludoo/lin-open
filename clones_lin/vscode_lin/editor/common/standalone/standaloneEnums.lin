!getTextEditorCursorBlinkingStyleEnum(){
  ^{ enumName: "TextEditorCursorBlinkingStyle", members: ["/**
	 * Hidden
	 */
	Hidden", "/**
	 * Blinking
	 */
	Blink", "/**
	 * Blinking with smooth fading
	 */
	Smooth", "/**
