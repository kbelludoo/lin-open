  ^{ enumName: "NewSymbolNameTag", members: ["AIGenerated"] };
}

!getNewSymbolNameTriggerKindEnum(){
  ^{ enumName: "NewSymbolNameTriggerKind", members: ["Invoke", "Automatic"] };
}

