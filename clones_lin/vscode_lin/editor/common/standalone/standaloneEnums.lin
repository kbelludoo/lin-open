@LIN:editor_common_standalone_standaloneEnums:1.0.0
~G{?=if #=for ^=ret :else}

!getAccessibilitySupportEnum(){
  ^{ enumName: "AccessibilitySupport", members: ["/**
	 * This should be the browser case where it is not known if a screen reader is attached or no.
	 */
	Unknown", "Disabled", "Enabled"] };
}

!getCodeActionTriggerTypeEnum(){
  ^{ enumName: "CodeActionTriggerType", members: ["Invoke", "Auto"] };
}

!getCompletionItemInsertTextRuleEnum(){
  ^{ enumName: "CompletionItemInsertTextRule", members: ["None", "/**
	 * Adjust whitespace/indentation of multiline insert texts to
	 * match the current line indentation.
	 */
	KeepWhitespace", "/**
	 * `insertText` is a snippet.
	 */
	InsertAsSnippet"] };
}

!getCompletionItemKindEnum(){
  ^{ enumName: "CompletionItemKind", members: ["Method", "Function", "Constructor", "Field", "Variable", "Class", "Struct", "Interface", "Module", "Property", "Event", "Operator", "Unit", "Value", "Constant", "Enum", "EnumMember", "Keyword", "Text", "Color", "File", "Reference", "Customcolor", "Folder", "TypeParameter", "User", "Issue", "Tool", "Snippet"] };
}

!getCompletionItemTagEnum(){
  ^{ enumName: "CompletionItemTag", members: ["Deprecated"] };
}

!getCompletionTriggerKindEnum(){
  ^{ enumName: "CompletionTriggerKind", members: ["Invoke", "TriggerCharacter", "TriggerForIncompleteCompletions"] };
}

!getContentWidgetPositionPreferenceEnum(){
  ^{ enumName: "ContentWidgetPositionPreference", members: ["/**
	 * Place the content widget exactly at a position
	 */
	EXACT", "/**
	 * Place the content widget above a position
	 */
	ABOVE", "/**
	 * Place the content widget below a position
	 */
	BELOW"] };
}

!getCursorChangeReasonEnum(){
  ^{ enumName: "CursorChangeReason", members: ["/**
	 * Unknown or not set.
	 */
	NotSet", "/**
	 * A `model.setValue()` was called.
	 */
	ContentFlush", "/**
	 * The `model` has been changed outside of this cursor and the cursor recovers its position from associated markers.
	 */
	RecoverFromMarkers", "/**
	 * There was an explicit user gesture.
	 */
	Explicit", "/**
	 * There was a Paste.
	 */
	Paste", "/**
	 * There was an Undo.
	 */
	Undo", "/**
	 * There was a Redo.
	 */
	Redo"] };
}

!getDefaultEndOfLineEnum(){
  ^{ enumName: "DefaultEndOfLine", members: ["/**
	 * Use line feed (\n) as the end of line character.
	 */
	LF", "/**
	 * Use carriage return and line feed (\r\n) as the end of line character.
	 */
	CRLF"] };
}

!getDocumentHighlightKindEnum(){
  ^{ enumName: "DocumentHighlightKind", members: ["/**
	 * A textual occurrence.
	 */
	Text", "/**
	 * Read-access of a symbol", "like reading a variable.
	 */
	Read", "/**
	 * Write-access of a symbol", "like writing to a variable.
	 */
	Write"] };
}

!getEditorAutoIndentStrategyEnum(){
  ^{ enumName: "EditorAutoIndentStrategy", members: ["None", "Keep", "Brackets", "Advanced", "Full"] };
}

