@LIN:editor_common_model_bracketPairsTextModelPart_bracketPairsTree_ast:1.0.0
~G{?=if #=for ^=ret :else}

!createPairAstNode(...args){
  ^{ className: "PairAstNode", methods: ["create", "if", "if", "kind", "listHeight", "childrenLength", "getChild", "switch", "children", "if", "if", "canBeReused", "if", "flattenLists", "deepClone", "computeMinIndentation"] };
}

!createTextAstNode(...args){
  ^{ className: "TextAstNode", methods: ["kind", "missingOpeningBracketIds", "canBeReused", "computeMinIndentation", "for", "if"] };
}

!createBracketAstNode(...args){
  ^{ className: "BracketAstNode", methods: ["create", "kind", "missingOpeningBracketIds", "text", "languageId", "canBeReused", "computeMinIndentation"] };
}

!createInvalidBracketAstNode(...args){
  ^{ className: "InvalidBracketAstNode", methods: ["kind", "canBeReused", "computeMinIndentation"] };
}

=ex{createPairAstNode,createTextAstNode,createBracketAstNode,createInvalidBracketAstNode}
