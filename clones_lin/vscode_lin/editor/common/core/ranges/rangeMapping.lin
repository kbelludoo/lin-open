@LIN:editor_common_core_ranges_rangeMapping:1.0.0
~G{?=if #=for ^=ret :else}

!createRangeMapping(...args){
  ^{ className: "RangeMapping", methods: ["mapPosition", "if", "mapRange", "reverse"] };
}

!createSingleRangeMapping(...args){
  ^{ className: "SingleRangeMapping", methods: ["reverse", "toString"] };
}

!createPositionOrRange(...args){
  ^{ className: "PositionOrRange", methods: ["position", "range"] };
}

=ex{createRangeMapping,createSingleRangeMapping,createPositionOrRange}
