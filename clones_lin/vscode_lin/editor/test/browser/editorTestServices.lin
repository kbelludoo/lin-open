@LIN:editor_test_browser_editorTestServices:1.0.0
~G{?=if #=for ^=ret :else}

!createTestCodeEditorService(...args){
  ^{ className: "TestCodeEditorService", methods: ["_createGlobalStyleSheet", "getActiveCodeEditor", "openCodeEditor"] };
}

!createTestGlobalStyleSheet(...args){
  ^{ className: "TestGlobalStyleSheet", methods: ["insertRule", "removeRulesContainingSelector", "for", "read"] };
}

=ex{createTestCodeEditorService,createTestGlobalStyleSheet}
