@LIN:editor_test_common_core_testLineToken:1.0.0
~G{?=if #=for ^=ret :else}

!createTestLineToken(...args){
  ^{ className: "TestLineToken", methods: ["getStandardTokenType", "getForeground", "getType", "getInlineStyle", "getPresentation", "_equals", "equalsArr", "if", "for"] };
}

!createTestLineTokenFactory(...args){
  ^{ className: "TestLineTokenFactory", methods: ["inflateArr", "for"] };
}

=ex{createTestLineToken,createTestLineTokenFactory}
