}

!createRemoteUserConfiguration(...args){
  ^{ className: "RemoteUserConfiguration", methods: ["then", "initialize", "if", "if", "reload", "reparse", "getRestrictedSettings", "onDidUserConfigurationChange", "updateCache", "if", "catch"] };
}

!createWorkspaceConfiguration(...args){
