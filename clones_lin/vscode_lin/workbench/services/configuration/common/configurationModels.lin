@LIN:workbench_services_configuration_common_configurationModels:1.0.0
~G{?=if #=for ^=ret :else}

!createWorkspaceConfigurationModelParser(...args){
  ^{ className: "WorkspaceConfigurationModelParser", methods: ["folders", "transient", "settingsModel", "launchModel", "tasksModel", "reparseWorkspaceSettings", "getRestrictedWorkspaceSettings", "doParseRaw", "createConfigurationModelFrom", "if"] };
}

!createStandaloneConfigurationModelParser(...args){
  ^{ className: "StandaloneConfigurationModelParser", methods: ["doParseRaw"] };
}

!createConfiguration(...args){
  ^{ className: "Configuration", methods: ["getValue", "keys", "compareAndDeleteFolderConfiguration", "compare", "for", "if"] };
}

=ex{createWorkspaceConfigurationModelParser,createStandaloneConfigurationModelParser,createConfiguration}
