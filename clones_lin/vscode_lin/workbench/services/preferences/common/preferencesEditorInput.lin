@LIN:workbench_services_preferences_common_preferencesEditorInput:1.0.0
~G{?=if #=for ^=ret :else}

!createSettingsEditor2Input(...args){
  ^{ className: "SettingsEditor2Input", methods: ["matches", "typeId", "getName", "getIcon", "resolve", "dispose"] };
}

!createPreferencesEditorInput(...args){
  ^{ className: "PreferencesEditorInput", methods: ["matches", "typeId", "getName", "getIcon", "resolve"] };
}

=ex{createSettingsEditor2Input,createPreferencesEditorInput}
