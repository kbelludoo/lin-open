@LIN:workbench_services_remote_common_remoteExplorerService:1.0.0
~G{?=if #=for ^=ret :else}

!getTunnelTypeEnum(){
  ^{ enumName: "TunnelType", members: ["Candidate", "Detected", "Forwarded", "Add"] };
}

!getTunnelEditIdEnum(){
  ^{ enumName: "TunnelEditId", members: ["None", "New", "Label", "LocalPort"] };
}

!getPortsEnablementEnum(){
  ^{ enumName: "PortsEnablement", members: ["Disabled", "ViewOnly", "AdditionalFeatures"] };
}

=ex{getTunnelTypeEnum,getTunnelEditIdEnum,getPortsEnablementEnum}
