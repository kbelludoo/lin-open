@LIN:workbench_services_extensions_common_extensionsRegistry:1.0.0
~G{?=if #=for ^=ret :else}

!createExtensionMessageCollector(...args){
  ^{ className: "ExtensionMessageCollector", methods: ["_msg", "error", "warn", "info"] };
}

!createExtensionsRegistryImpl(...args){
  ^{ className: "ExtensionsRegistryImpl", methods: ["if", "getExtensionPoints"] };
}

=ex{createExtensionMessageCollector,createExtensionsRegistryImpl}
