!createLocalProcessRunningLocation(...args){
  ^{ className: "LocalProcessRunningLocation", methods: ["equals", "asString", "if"] };
}

!createLocalWebWorkerRunningLocation(...args){
  ^{ className: "LocalWebWorkerRunningLocation", methods: ["equals", "asString", "if"] };
}

!createRemoteRunningLocation(...args){
