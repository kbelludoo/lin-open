@LIN:workbench_services_userDataProfile_browser_extensionsResource:1.0.0
~G{?=if #=for ^=ret :else}

!createExtensionsResourceExportTreeItem(...args){
  ^{ className: "ExtensionsResourceExportTreeItem", methods: ["isFromDefaultProfile", "getExtensions", "getContent"] };
}

!createExtensionsResourceImportTreeItem(...args){
  ^{ className: "ExtensionsResourceImportTreeItem", methods: ["isFromDefaultProfile", "getExtensions", "getContent"] };
}

=ex{createExtensionsResourceExportTreeItem,createExtensionsResourceImportTreeItem}
