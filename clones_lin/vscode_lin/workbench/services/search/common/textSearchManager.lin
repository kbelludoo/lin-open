@LIN:workbench_services_search_common_textSearchManager:1.0.0
~G{?=if #=for ^=ret :else}

!createTextSearchManager(...args){
  ^{ className: "TextSearchManager", methods: ["query", "if", "if", "if", "if", "if", "getMessagesFromResults", "if", "resultSize", "if", "trimResultToSize", "if", "if", "if", "if", "push", "if", "if", "if", "getSearchOptionsForFolder", "if"] };
}

!createTextSearchResultsCollector(...args){
  ^{ className: "TextSearchResultsCollector", methods: ["add", "if", "pushToCollector", "flush", "sendItems"] };
}

=ex{createTextSearchManager,createTextSearchResultsCollector}
