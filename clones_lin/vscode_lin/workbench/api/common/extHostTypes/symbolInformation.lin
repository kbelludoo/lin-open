@LIN:workbench_api_common_extHostTypes_symbolInformation:1.0.0
~G{?=if #=for ^=ret :else}

!createSymbolInformation(...args){
  ^{ className: "SymbolInformation", methods: ["validate", "if", "if", "if", "if", "toJSON"] };
}

!getSymbolKindEnum(){
  ^{ enumName: "SymbolKind", members: ["File", "Module", "Namespace", "Package", "Class", "Method", "Property", "Field", "Constructor", "Enum", "Interface", "Function", "Variable", "Constant", "String", "Number", "Boolean", "Array", "Object", "Key", "Null", "EnumMember", "Struct", "Event", "Operator", "TypeParameter"] };
}

!getSymbolTagEnum(){
  ^{ enumName: "SymbolTag", members: ["Deprecated"] };
}

=ex{createSymbolInformation,getSymbolKindEnum,getSymbolTagEnum}
