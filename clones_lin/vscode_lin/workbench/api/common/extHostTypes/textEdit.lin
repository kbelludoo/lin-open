@LIN:workbench_api_common_extHostTypes_textEdit:1.0.0
~G{?=if #=for ^=ret :else}

!createTextEdit(...args){
  ^{ className: "TextEdit", methods: ["isTextEdit", "if", "if", "replace", "insert", "delete", "setEndOfLine", "range", "range", "newText", "newText", "if", "newEol", "newEol", "if", "toJSON"] };
}

!getEndOfLineEnum(){
  ^{ enumName: "EndOfLine", members: ["LF", "CRLF"] };
}

=ex{createTextEdit,getEndOfLineEnum}
