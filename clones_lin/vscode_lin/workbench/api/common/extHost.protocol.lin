@LIN:workbench_api_common_extHost_protocol:1.0.0
~G{?=if #=for ^=ret :else}

!createIdObject(...args){
  ^{ className: "IdObject", methods: [] };
}

!getTextEditorRevealTypeEnum(){
  ^{ enumName: "TextEditorRevealType", members: ["Default", "InCenter", "InCenterIfOutsideViewport", "AtTop"] };
}

!getWebviewEditorCapabilitiesEnum(){
  ^{ enumName: "WebviewEditorCapabilities", members: ["Editable", "SupportsHotExit"] };
}

!getCellOutputKindEnum(){
  ^{ enumName: "CellOutputKind", members: ["Text", "Error", "Rich"] };
}

!getNotebookEditorRevealTypeEnum(){
  ^{ enumName: "NotebookEditorRevealType", members: ["Default", "InCenter", "InCenterIfOutsideViewport", "AtTop"] };
}

!getCandidatePortSourceEnum(){
  ^{ enumName: "CandidatePortSource", members: ["None", "Process", "Output", "Hybrid"] };
}

!getGitRefTypeDtoEnum(){
  ^{ enumName: "GitRefTypeDto", members: ["Head", "RemoteHead", "Tag"] };
}

=ex{createIdObject,getTextEditorRevealTypeEnum,getWebviewEditorCapabilitiesEnum,getCellOutputKindEnum,getNotebookEditorRevealTypeEnum,getCandidatePortSourceEnum,getGitRefTypeDtoEnum}
