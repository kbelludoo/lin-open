@LIN:workbench_api_common_extHostDebugService:1.0.0
~G{?=if #=for ^=ret :else}

!createExtHostDebugSession(...args){
  ^{ className: "ExtHostDebugSession", methods: ["api", "freeze", "name", "customRequest", "getDebugProtocolBreakpoint", "id", "type", "_acceptNameChanged", "configuration"] };
}

!createExtHostDebugConsole(...args){
  ^{ className: "ExtHostDebugConsole", methods: ["freeze", "appendLine"] };
}

!createWorkerExtHostDebugService(...args){
  ^{ className: "WorkerExtHostDebugService", methods: [] };
}

=ex{createExtHostDebugSession,createExtHostDebugConsole,createWorkerExtHostDebugService}
