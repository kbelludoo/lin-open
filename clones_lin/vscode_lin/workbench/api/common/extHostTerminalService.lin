@LIN:workbench_api_common_extHostTerminalService:1.0.0
~G{?=if #=for ^=ret :else}

!createExtHostTerminal(...args){
  ^{ className: "ExtHostTerminal", methods: ["name", "processId", "creationOptions", "exitStatus", "state", "selection", "shellIntegration", "sendText", "show", "hide", "dispose", "if", "dimensions", "if", "dispose", "create", "if", "createExtensionTerminal", "if", "if", "_serializeParentTerminal", "if", "_checkDisposed", "if", "name", "setExitStatus", "setDimensions", "if", "if", "setInteractedWith", "if", "setShellType", "if", "setSelection", "_setProcessId", "if", "then"] };
}

!createWorkerExtHostTerminalService(...args){
  ^{ className: "WorkerExtHostTerminalService", methods: ["createTerminal", "if", "createTerminalFromOptions", "if"] };
}

=ex{createExtHostTerminal,createWorkerExtHostTerminalService}
