@LIN:workbench_api_common_shared_tasks:1.0.0
~G{?=if #=for ^=ret :else}

!getTaskEventKindEnum(){
  ^{ enumName: "TaskEventKind", members: ["/** Indicates that a task's properties or configuration have changed */
	Changed", "/** Indicates that a task has begun executing */
	ProcessStarted", "/** Indicates that a task process has completed */
	ProcessEnded", "/** Indicates that a task was terminated", "either by user action or by the system */
	Terminated", "/** Indicates that a task has started running */
	Start", "/** Indicates that a task has acquired all needed input/variables to execute */
	AcquiredInput", "/** Indicates that a dependent task has started */
	DependsOnStarted", "/** Indicates that a task is actively running/processing */
	Active", "/** Indicates that a task is paused/waiting but not complete */
	Inactive", "/** Indicates that a task has completed fully */
	End", "/** Indicates that a task's problem matcher has started */
	ProblemMatcherStarted", "/** Indicates that a task's problem matcher has ended */
	ProblemMatcherEnded", "/** Indicates that a task's problem matcher has found errors */
	ProblemMatcherFoundErrors"] };
}

=ex{getTaskEventKindEnum}
