@LIN:workbench_electron_browser_actions_installActions:1.0.0
~G{?=if #=for ^=ret :else}

!createInstallShellScriptAction(...args){
  ^{ className: "InstallShellScriptAction", methods: ["run", "catch"] };
}

!createUninstallShellScriptAction(...args){
  ^{ className: "UninstallShellScriptAction", methods: ["run", "catch"] };
}

=ex{createInstallShellScriptAction,createUninstallShellScriptAction}
