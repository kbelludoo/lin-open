@LIN:workbench_common_views:1.0.0
~G{?=if #=for ^=ret :else}

!createNoTreeViewError(...args){
  ^{ className: "NoTreeViewError", methods: ["is"] };
}

!getViewContentGroupsEnum(){
  ^{ enumName: "ViewContentGroups", members: ["Open", "Debug", "SCM", "More"] };
}

!getViewVisibilityStateEnum(){
  ^{ enumName: "ViewVisibilityState", members: ["Default", "Expand"] };
}

!getTreeItemCollapsibleStateEnum(){
  ^{ enumName: "TreeItemCollapsibleState", members: ["None", "Collapsed", "Expanded"] };
}

=ex{createNoTreeViewError,getViewContentGroupsEnum,getViewVisibilityStateEnum,getTreeItemCollapsibleStateEnum}
