@LIN:workbench_common_editor_filteredEditorGroupModel:1.0.0
~G{?=if #=for ^=ret :else}

!createStickyEditorGroupModel(...args){
  ^{ className: "StickyEditorGroupModel", methods: ["count", "getEditors", "if", "if", "isSticky", "getEditorByIndex", "indexOf", "if", "contains", "filter"] };
}

!createUnstickyEditorGroupModel(...args){
  ^{ className: "UnstickyEditorGroupModel", methods: ["count", "stickyCount", "isSticky", "getEditors", "if", "getEditorByIndex", "indexOf", "if", "contains", "filter"] };
}

=ex{createStickyEditorGroupModel,createUnstickyEditorGroupModel}
