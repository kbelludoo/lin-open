@LIN:workbench_browser_actions_workspaceActions:1.0.0
~G{?=if #=for ^=ret :else}

!createOpenFileAction(...args){
  ^{ className: "OpenFileAction", methods: ["run"] };
}

!createOpenFolderAction(...args){
  ^{ className: "OpenFolderAction", methods: ["run"] };
}

!createOpenFolderViaWorkspaceAction(...args){
  ^{ className: "OpenFolderViaWorkspaceAction", methods: ["run"] };
}

!createOpenFileFolderAction(...args){
  ^{ className: "OpenFileFolderAction", methods: ["run"] };
}

!createAddRootFolderAction(...args){
  ^{ className: "AddRootFolderAction", methods: ["run"] };
}

!createRemoveRootFolderAction(...args){
  ^{ className: "RemoveRootFolderAction", methods: ["run", "if"] };
}

=ex{createOpenFileAction,createOpenFolderAction,createOpenFolderViaWorkspaceAction,createOpenFileFolderAction,createAddRootFolderAction,createRemoveRootFolderAction}
