@LIN:workbench_browser_labels:1.0.0
~G{?=if #=for ^=ret :else}

!createResourceLabels(...args){
  ^{ className: "ResourceLabels", methods: ["onDidChangeDecorations", "registerListeners", "_register", "_register", "if", "get", "create", "onDidRender", "disposeWidget", "if", "clear", "dispose"] };
}

!createResourceLabel(...args){
  ^{ className: "ResourceLabel", methods: ["element"] };
}

=ex{createResourceLabels,createResourceLabel}
