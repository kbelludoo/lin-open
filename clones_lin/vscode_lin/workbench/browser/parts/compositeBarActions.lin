  ^{ className: "ToggleCompositePinnedAction", methods: ["run"] };
}

!createToggleCompositeBadgeAction(...args){
  ^{ className: "ToggleCompositeBadgeAction", methods: ["run"] };
}

!createSwitchCompositeViewAction(...args){
  ^{ className: "SwitchCompositeViewAction", methods: ["run", "if", "for", "if"] };
}

=ex{createCompositeBarAction,createCompositeBarActionViewItem,createCompositeOverflowActivityAction,createCompositeOverflowActivityActionViewItem,createCompositeActionViewItem,createToggleCompositePinnedAction,createToggleCompositeBadgeAction,createSwitchCompositeViewAction}
