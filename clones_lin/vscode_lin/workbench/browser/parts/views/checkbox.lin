@LIN:workbench_browser_parts_views_checkbox:1.0.0
~G{?=if #=for ^=ret :else}

!createCheckboxStateHandler(...args){
  ^{ className: "CheckboxStateHandler", methods: ["setCheckboxState"] };
}

!createTreeItemCheckbox(...args){
  ^{ className: "TreeItemCheckbox", methods: ["render", "if", "if", "createCheckbox", "if", "registerListener", "if", "setHover", "if", "if", "setCheckbox", "if", "checkboxHoverContent", "setAccessibilityInformation", "if", "if", "removeCheckbox", "for"] };
}

=ex{createCheckboxStateHandler,createTreeItemCheckbox}
