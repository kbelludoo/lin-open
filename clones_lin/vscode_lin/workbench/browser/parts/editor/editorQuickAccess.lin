@LIN:workbench_browser_parts_editor_editorQuickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!createActiveGroupEditorsByMostRecentlyUsedQuickAccess(...args){
  ^{ className: "ActiveGroupEditorsByMostRecentlyUsedQuickAccess", methods: ["doGetEditors"] };
}

!createAllEditorsByAppearanceQuickAccess(...args){
  ^{ className: "AllEditorsByAppearanceQuickAccess", methods: ["doGetEditors"] };
}

!createAllEditorsByMostRecentlyUsedQuickAccess(...args){
  ^{ className: "AllEditorsByMostRecentlyUsedQuickAccess", methods: ["doGetEditors"] };
}

=ex{createActiveGroupEditorsByMostRecentlyUsedQuickAccess,createAllEditorsByAppearanceQuickAccess,createAllEditorsByMostRecentlyUsedQuickAccess}
