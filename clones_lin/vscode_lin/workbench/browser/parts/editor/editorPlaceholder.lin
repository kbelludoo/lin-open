@LIN:workbench_browser_parts_editor_editorPlaceholder:1.0.0
~G{?=if #=for ^=ret :else}

!createWorkspaceTrustRequiredPlaceholderEditor(...args){
  ^{ className: "WorkspaceTrustRequiredPlaceholderEditor", methods: ["getTitle", "getContents", "localize"] };
}

!createErrorPlaceholderEditor(...args){
  ^{ className: "ErrorPlaceholderEditor", methods: ["getContents", "if", "if", "if", "if", "if"] };
}

=ex{createWorkspaceTrustRequiredPlaceholderEditor,createErrorPlaceholderEditor}
