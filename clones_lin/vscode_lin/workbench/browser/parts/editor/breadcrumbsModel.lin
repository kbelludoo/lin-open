@LIN:workbench_browser_parts_editor_breadcrumbsModel:1.0.0
~G{?=if #=for ^=ret :else}

!createFileElement(...args){
  ^{ className: "FileElement", methods: ["equals"] };
}

!createOutlineElement2(...args){
  ^{ className: "OutlineElement2", methods: [] };
}

!createBreadcrumbsModel(...args){
  ^{ className: "BreadcrumbsModel", methods: ["if", "dispose", "isRelative", "getElements", "if", "if", "_initFilePathInfo", "while", "if", "_onDidChangeWorkspaceFolders", "_bindToEditor", "then", "if"] };
}

=ex{createFileElement,createOutlineElement2,createBreadcrumbsModel}
