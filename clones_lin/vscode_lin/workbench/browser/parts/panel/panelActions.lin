@LIN:workbench_browser_parts_panel_panelActions:1.0.0
~G{?=if #=for ^=ret :else}

!createTogglePanelAction(...args){
  ^{ className: "TogglePanelAction", methods: ["run"] };
}

!createMovePanelToSecondarySideBarAction(...args){
  ^{ className: "MovePanelToSecondarySideBarAction", methods: [] };
}

!createMoveSecondarySideBarToPanelAction(...args){
  ^{ className: "MoveSecondarySideBarToPanelAction", methods: [] };
}

=ex{createTogglePanelAction,createMovePanelToSecondarySideBarAction,createMoveSecondarySideBarToPanelAction}
