@LIN:workbench_browser_web_api:1.0.0
~G{?=if #=for ^=ret :else}

!getMenuEnum(){
  ^{ enumName: "Menu", members: ["CommandPalette", "StatusBarWindowIndicatorMenu"] };
}

!getColorSchemeEnum(){
  ^{ enumName: "ColorScheme", members: ["DARK", "LIGHT", "HIGH_CONTRAST_LIGHT", "HIGH_CONTRAST_DARK"] };
}

=ex{getMenuEnum,getColorSchemeEnum}
