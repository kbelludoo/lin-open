@LIN:workbench_contrib_testing_common_testCoverage:1.0.0
~G{?=if #=for ^=ret :else}

!createTestCoverage(...args){
  ^{ className: "TestCoverage", methods: ["allPerTestIDs", "for", "if", "for", "append", "if", "if", "if", "if", "if", "if", "for", "if", "filterTreeForTest", "if", "getAllFiles", "getUri", "getComputedForUri", "treePathForUri", "treePathToUri"] };
}

!createComputedFileCoverage(...args){
  ^{ className: "ComputedFileCoverage", methods: [] };
}

!createFileCoverage(...args){
  ^{ className: "FileCoverage", methods: ["hasSynchronousDetails", "detailsForTest", "if", "catch", "details", "catch"] };
}

=ex{createTestCoverage,createComputedFileCoverage,createFileCoverage}
