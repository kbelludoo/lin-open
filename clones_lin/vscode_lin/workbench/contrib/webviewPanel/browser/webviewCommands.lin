@LIN:workbench_contrib_webviewPanel_browser_webviewCommands:1.0.0
~G{?=if #=for ^=ret :else}

!createShowWebViewEditorFindWidgetAction(...args){
  ^{ className: "ShowWebViewEditorFindWidgetAction", methods: ["run"] };
}

!createHideWebViewEditorFindCommand(...args){
  ^{ className: "HideWebViewEditorFindCommand", methods: ["run"] };
}

!createWebViewEditorFindNextCommand(...args){
  ^{ className: "WebViewEditorFindNextCommand", methods: ["run"] };
}

!createWebViewEditorFindPreviousCommand(...args){
  ^{ className: "WebViewEditorFindPreviousCommand", methods: ["run"] };
}

!createReloadWebviewAction(...args){
  ^{ className: "ReloadWebviewAction", methods: ["run", "for"] };
}

=ex{createShowWebViewEditorFindWidgetAction,createHideWebViewEditorFindCommand,createWebViewEditorFindNextCommand,createWebViewEditorFindPreviousCommand,createReloadWebviewAction}
