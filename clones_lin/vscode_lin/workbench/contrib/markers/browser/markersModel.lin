@LIN:workbench_contrib_markers_browser_markersModel:1.0.0
~G{?=if #=for ^=ret :else}

!createResourceMarkers(...args){
  ^{ className: "ResourceMarkers", methods: ["markers", "if", "has", "set", "delete", "if", "total", "_compareMarkers"] };
}

!createMarker(...args){
  ^{ className: "Marker", methods: ["resource", "range", "lines", "if", "toString"] };
}

!createMarkerTableItem(...args){
  ^{ className: "MarkerTableItem", methods: [] };
}

!createRelatedInformation(...args){
  ^{ className: "RelatedInformation", methods: [] };
}

!createMarkersModel(...args){
  ^{ className: "MarkersModel", methods: ["resourceMarkers", "if", "reset", "total", "getResourceMarkers", "setResourceMarkers", "for", "if", "for", "if", "if", "if", "if", "dispose"] };
}

=ex{createResourceMarkers,createMarker,createMarkerTableItem,createRelatedInformation,createMarkersModel}
