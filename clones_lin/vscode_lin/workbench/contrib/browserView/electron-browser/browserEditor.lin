@LIN:workbench_contrib_browserView_electron_browser_browserEditor:1.0.0
~G{?=if #=for ^=ret :else}

!createBrowserEditor(...args){
  ^{ className: "BrowserEditor", methods: ["new", "new", "getContributions", "model", "browserContainer", "input", "createEditor", "for", "for", "if", "focus", "setInput", "if", "if", "if", "if", "if", "add", "setEditorVisible", "ensureBrowserFocus", "closeTab", "layout", "if", "if", "layoutBrowserContainer", "if", "if", "for", "for", "if", "paneSize", "clearInput", "if"] };
}

!getBrowserActionGroupEnum(){
  ^{ enumName: "BrowserActionGroup", members: ["Tabs", "Zoom", "Tools", "Data", "Settings"] };
}

=ex{createBrowserEditor,getBrowserActionGroupEnum}
