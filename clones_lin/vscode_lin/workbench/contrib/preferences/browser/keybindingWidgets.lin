@LIN:workbench_contrib_preferences_browser_keybindingWidgets:1.0.0
~G{?=if #=for ^=ret :else}

!createKeybindingsSearchWidget(...args){
  ^{ className: "KeybindingsSearchWidget", methods: ["clear", "startRecordingKeys", "stopRecordingKeys", "setInputValue", "_onKeyDown", "printKeybinding", "if", "if", "if"] };
}

!createDefineKeybindingWidget(...args){
  ^{ className: "DefineKeybindingWidget", methods: ["if", "domNode", "define", "if", "layout", "printExisting", "if", "localize", "onKeybinding", "if", "for", "if", "getUserSettingsLabel", "if", "onCancel", "clearOrHide", "if", "hide"] };
}

=ex{createKeybindingsSearchWidget,createDefineKeybindingWidget}
