!createPatternInputWidget(...args){
  ^{ className: "PatternInputWidget", methods: ["dispose", "setWidth", "getValue", "setValue", "if", "select", "focus", "inputHasFocus", "setInputWidth", "getSubcontrolsWidth", "getHistory", "clearHistory", "prependHistory", "clear", "onSearchSubmit", "showNextTerm", "showPreviousTerm", "render", "renderSubcontrols", "onInputKeyUp", "switch"] };
}

