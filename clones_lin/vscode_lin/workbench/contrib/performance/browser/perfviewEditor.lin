@LIN:workbench_contrib_performance_browser_perfviewEditor:1.0.0
~G{?=if #=for ^=ret :else}

!createPerfviewContrib(...args){
  ^{ className: "PerfviewContrib", methods: ["get", "dispose", "getInputUri", "getEditorInput"] };
}

!createPerfviewInput(...args){
  ^{ className: "PerfviewInput", methods: ["typeId"] };
}

=ex{createPerfviewContrib,createPerfviewInput}
