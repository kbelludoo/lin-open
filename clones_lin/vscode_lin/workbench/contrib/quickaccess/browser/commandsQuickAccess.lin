@LIN:workbench_contrib_quickaccess_browser_commandsQuickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!createCommandsQuickAccessProvider(...args){
  ^{ className: "CommandsQuickAccessProvider", methods: ["activeTextEditorControl", "defaultFilterValue", "if", "configuration", "updateOptions", "getCommandPicks", "if", "hasAdditionalCommandPicks", "getAdditionalCommandPicks", "catch", "if", "if", "if", "getRelatedInformationPicks", "for", "if", "if", "getGlobalCommandPicks", "for", "if"] };
}

!createShowAllCommandsAction(...args){
  ^{ className: "ShowAllCommandsAction", methods: ["run"] };
}

!createClearCommandHistoryAction(...args){
  ^{ className: "ClearCommandHistoryAction", methods: ["run", "if", "if"] };
}

=ex{createCommandsQuickAccessProvider,createShowAllCommandsAction,createClearCommandHistoryAction}
