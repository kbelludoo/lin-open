@LIN:workbench_contrib_quickaccess_browser_viewQuickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!createOpenViewPickerAction(...args){
  ^{ className: "OpenViewPickerAction", methods: ["run"] };
}

!createQuickAccessViewPickerAction(...args){
  ^{ className: "QuickAccessViewPickerAction", methods: ["run"] };
}

=ex{createOpenViewPickerAction,createQuickAccessViewPickerAction}
