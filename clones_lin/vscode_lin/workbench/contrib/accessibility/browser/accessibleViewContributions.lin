@LIN:workbench_contrib_accessibility_browser_accessibleViewContributions:1.0.0
~G{?=if #=for ^=ret :else}

!createAccesibleViewHelpContribution(...args){
  ^{ className: "AccesibleViewHelpContribution", methods: [] };
}

!createAccesibleViewContributions(...args){
  ^{ className: "AccesibleViewContributions", methods: ["if", "if"] };
}

=ex{createAccesibleViewHelpContribution,createAccesibleViewContributions}
