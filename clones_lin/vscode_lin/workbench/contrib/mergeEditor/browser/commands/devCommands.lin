@LIN:workbench_contrib_mergeEditor_browser_commands_devCommands:1.0.0
~G{?=if #=for ^=ret :else}

!createMergeEditorCopyContentsToJSON(...args){
  ^{ className: "MergeEditorCopyContentsToJSON", methods: ["run", "if"] };
}

!createMergeEditorSaveContentsToFolder(...args){
  ^{ className: "MergeEditorSaveContentsToFolder", methods: ["run", "if", "if", "write"] };
}

!createMergeEditorLoadContentsFromFolder(...args){
  ^{ className: "MergeEditorLoadContentsFromFolder", methods: ["run", "if", "if", "if", "findFile"] };
}

=ex{createMergeEditorCopyContentsToJSON,createMergeEditorSaveContentsToFolder,createMergeEditorLoadContentsFromFolder}
