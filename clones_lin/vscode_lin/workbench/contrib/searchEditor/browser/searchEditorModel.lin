@LIN:workbench_contrib_searchEditor_browser_searchEditorModel:1.0.0
~G{?=if #=for ^=ret :else}

!createSearchConfigurationModel(...args){
  ^{ className: "SearchConfigurationModel", methods: ["updateConfig"] };
}

