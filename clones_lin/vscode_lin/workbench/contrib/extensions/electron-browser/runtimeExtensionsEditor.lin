@LIN:workbench_contrib_extensions_electron_browser_runtimeExtensionsEditor:1.0.0
~G{?=if #=for ^=ret :else}

!createRuntimeExtensionsEditor(...args){
  ^{ className: "RuntimeExtensionsEditor", methods: ["_getProfileInfo", "_getUnresponsiveProfile", "_createSlowExtensionAction", "if", "_createReportExtensionIssueAction", "if"] };
}

!createStartExtensionHostProfileAction(...args){
  ^{ className: "StartExtensionHostProfileAction", methods: ["run"] };
}

!createStopExtensionHostProfileAction(...args){
  ^{ className: "StopExtensionHostProfileAction", methods: ["run"] };
}

!createOpenExtensionHostProfileACtion(...args){
  ^{ className: "OpenExtensionHostProfileACtion", methods: ["run", "if", "if"] };
}

!createSaveExtensionHostProfileAction(...args){
  ^{ className: "SaveExtensionHostProfileAction", methods: ["run", "_asyncRun", "if", "if"] };
}

!getProfileSessionStateEnum(){
  ^{ enumName: "ProfileSessionState", members: ["None", "Starting", "Running", "Stopping"] };
}

=ex{createRuntimeExtensionsEditor,createStartExtensionHostProfileAction,createStopExtensionHostProfileAction,createOpenExtensionHostProfileACtion,createSaveExtensionHostProfileAction,getProfileSessionStateEnum}
