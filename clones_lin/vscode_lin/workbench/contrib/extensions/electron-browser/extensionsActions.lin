@LIN:workbench_contrib_extensions_electron_browser_extensionsActions:1.0.0
~G{?=if #=for ^=ret :else}

!createOpenExtensionsFolderAction(...args){
  ^{ className: "OpenExtensionsFolderAction", methods: ["run", "if", "if"] };
}

!createCleanUpExtensionsFolderAction(...args){
  ^{ className: "CleanUpExtensionsFolderAction", methods: ["run"] };
}

=ex{createOpenExtensionsFolderAction,createCleanUpExtensionsFolderAction}
