@LIN:workbench_contrib_output_browser_outputView:1.0.0
~G{?=if #=for ^=ret :else}

!createOutputViewPane(...args){
  ^{ className: "OutputViewPane", methods: ["scrollLock", "scrollLock", "showChannel", "if", "if", "focus", "clearFilterText", "renderBody", "if", "if", "if", "layoutBodyContent", "onDidChangeVisibility", "if", "setInput", "checkMoreFilters", "clearInput", "createInput", "saveState"] };
}

!createOutputEditor(...args){
  ^{ className: "OutputEditor", methods: ["getId", "getTitle", "getConfigurationOverrides", "if", "if", "if", "getAriaLabel", "computeAriaLabel", "setInput", "if", "if", "clearInput", "if", "createEditor", "if", "_getContributions", "getCodeEditorWidgetOptions"] };
}

=ex{createOutputViewPane,createOutputEditor}
