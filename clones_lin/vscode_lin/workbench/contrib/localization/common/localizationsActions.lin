@LIN:workbench_contrib_localization_common_localizationsActions:1.0.0
~G{?=if #=for ^=ret :else}

!createConfigureDisplayLanguageAction(...args){
  ^{ className: "ConfigureDisplayLanguageAction", methods: ["run", "if", "if", "if", "if", "withMoreInfoButton", "for", "if"] };
}

!createClearDisplayLanguageAction(...args){
  ^{ className: "ClearDisplayLanguageAction", methods: ["run"] };
}

=ex{createConfigureDisplayLanguageAction,createClearDisplayLanguageAction}
