@LIN:workbench_contrib_inlineChat_browser_inlineChatSessionServiceImpl:1.0.0
~G{?=if #=for ^=ret :else}

!createInlineChatError(...args){
  ^{ className: "InlineChatError", methods: [] };
}

!createInlineChatEnabler(...args){
  ^{ className: "InlineChatEnabler", methods: ["if", "dispose"] };
}

!createInlineChatEscapeToolContribution(...args){
  ^{ className: "InlineChatEscapeToolContribution", methods: ["if", "if", "if"] };
}

=ex{createInlineChatError,createInlineChatEnabler,createInlineChatEscapeToolContribution}
