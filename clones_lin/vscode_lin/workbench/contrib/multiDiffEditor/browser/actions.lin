@LIN:workbench_contrib_multiDiffEditor_browser_actions:1.0.0
~G{?=if #=for ^=ret :else}

!createGoToFileAction(...args){
  ^{ className: "GoToFileAction", methods: ["run", "if", "if"] };
}

!createGoToNextChangeAction(...args){
  ^{ className: "GoToNextChangeAction", methods: ["run"] };
}

!createGoToPreviousChangeAction(...args){
  ^{ className: "GoToPreviousChangeAction", methods: ["run"] };
}

!createCollapseAllAction(...args){
  ^{ className: "CollapseAllAction", methods: ["run", "if", "if"] };
}

!createExpandAllAction(...args){
  ^{ className: "ExpandAllAction", methods: ["run", "if", "if"] };
}

=ex{createGoToFileAction,createGoToNextChangeAction,createGoToPreviousChangeAction,createCollapseAllAction,createExpandAllAction}
