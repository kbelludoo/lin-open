@LIN:workbench_contrib_notebook_browser_contrib_find_notebookFindReplaceWidget:1.0.0
~G{?=if #=for ^=ret :else}

!createNotebookFindInputFilterButton(...args){
  ^{ className: "NotebookFindInputFilterButton", methods: ["container", "width", "enable", "disable", "visible", "visible", "applyStyles", "createFilters", "if"] };
}

!createNotebookFindInput(...args){
  ^{ className: "NotebookFindInput", methods: ["setEnabled", "if", "updateFilterState", "if", "if", "getToggleDomNodes", "getCellToolbarActions"] };
}

=ex{createNotebookFindInputFilterButton,createNotebookFindInput}
