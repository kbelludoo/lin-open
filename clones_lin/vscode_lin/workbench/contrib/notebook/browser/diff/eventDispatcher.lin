@LIN:workbench_contrib_notebook_browser_diff_eventDispatcher:1.0.0
~G{?=if #=for ^=ret :else}

!createNotebookDiffLayoutChangedEvent(...args){
  ^{ className: "NotebookDiffLayoutChangedEvent", methods: [] };
}

!createNotebookCellLayoutChangedEvent(...args){
  ^{ className: "NotebookCellLayoutChangedEvent", methods: [] };
}

!createNotebookDiffEditorEventDispatcher(...args){
  ^{ className: "NotebookDiffEditorEventDispatcher", methods: ["emit", "for", "switch"] };
}

!getNotebookDiffViewEventTypeEnum(){
  ^{ enumName: "NotebookDiffViewEventType", members: ["LayoutChanged", "CellLayoutChanged", "// CellStateChanged"] };
}

=ex{createNotebookDiffLayoutChangedEvent,createNotebookCellLayoutChangedEvent,createNotebookDiffEditorEventDispatcher,getNotebookDiffViewEventTypeEnum}
