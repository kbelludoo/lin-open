@LIN:workbench_contrib_notebook_browser_controller_sectionActions:1.0.0
~G{?=if #=for ^=ret :else}

!createNotebookRunSingleCellInSection(...args){
  ^{ className: "NotebookRunSingleCellInSection", methods: ["run"] };
}

!createNotebookRunCellsInSection(...args){
  ^{ className: "NotebookRunCellsInSection", methods: ["run", "if", "if", "if"] };
}

!createNotebookFoldSection(...args){
  ^{ className: "NotebookFoldSection", methods: ["run", "toggleFoldRange"] };
}

!createNotebookExpandSection(...args){
  ^{ className: "NotebookExpandSection", methods: ["run", "toggleFoldRange"] };
}

=ex{createNotebookRunSingleCellInSection,createNotebookRunCellsInSection,createNotebookFoldSection,createNotebookExpandSection}
