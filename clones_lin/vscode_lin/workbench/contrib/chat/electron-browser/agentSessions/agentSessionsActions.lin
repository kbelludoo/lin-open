@LIN:workbench_contrib_chat_electron_browser_agentSessions_agentSessionsActions:1.0.0
~G{?=if #=for ^=ret :else}

!createOpenWorkspaceInAgentsWindowAction(...args){
  ^{ className: "OpenWorkspaceInAgentsWindowAction", methods: ["run"] };
}

!createOpenWorkspaceInAgentsWindowChatTitleAction(...args){
  ^{ className: "OpenWorkspaceInAgentsWindowChatTitleAction", methods: ["run"] };
}

!createOpenWorkspaceInAgentsWindowTitleBarAction(...args){
  ^{ className: "OpenWorkspaceInAgentsWindowTitleBarAction", methods: ["run"] };
}

!createToggleOpenInAgentsWindowTitleBarAction(...args){
  ^{ className: "ToggleOpenInAgentsWindowTitleBarAction", methods: [] };
}

!createOpenAgentsWindowAction(...args){
  ^{ className: "OpenAgentsWindowAction", methods: ["run"] };
}

