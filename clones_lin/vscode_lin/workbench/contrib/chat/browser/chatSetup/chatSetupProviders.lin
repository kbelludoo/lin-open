@LIN:workbench_contrib_chat_browser_chatSetup_chatSetupProviders:1.0.0
~G{?=if #=for ^=ret :else}

!createAINewSymbolNamesProvider(...args){
  ^{ className: "AINewSymbolNamesProvider", methods: ["registerProvider", "provideNewSymbolNames"] };
}

!createChatCodeActionsProvider(...args){
  ^{ className: "ChatCodeActionsProvider", methods: ["registerProvider", "provideCodeActions", "if", "if", "dispose"] };
}

!createAICodeActionsHelper(...args){
  ^{ className: "AICodeActionsHelper", methods: ["warningOrErrorMarkersAtRange", "modify", "generate", "rangeToSelection", "explainMarkers", "fixMarkers"] };
}

=ex{createAINewSymbolNamesProvider,createChatCodeActionsProvider,createAICodeActionsHelper}
