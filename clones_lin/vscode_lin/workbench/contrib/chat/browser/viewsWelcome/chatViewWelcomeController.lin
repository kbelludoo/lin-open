@LIN:workbench_contrib_chat_browser_viewsWelcome_chatViewWelcomeController:1.0.0
~G{?=if #=for ^=ret :else}

!createChatViewWelcomeController(...args){
  ^{ className: "ChatViewWelcomeController", methods: ["isShowingWelcome", "getMatchingWelcomeView", "update", "if", "if", "if", "render", "if"] };
}

!createChatViewWelcomePart(...args){
  ^{ className: "ChatViewWelcomePart", methods: ["if", "if", "if", "if", "if", "catch", "needsRerender", "renderMarkdownMessageContent", "if", "if"] };
}

=ex{createChatViewWelcomeController,createChatViewWelcomePart}
