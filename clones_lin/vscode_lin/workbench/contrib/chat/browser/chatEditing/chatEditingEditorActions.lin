  ^{ className: "AcceptAction", methods: [] };
}

!createRejectAction(...args){
  ^{ className: "RejectAction", methods: [] };
}

!createAcceptHunkAction(...args){
  ^{ className: "AcceptHunkAction", methods: [] };
}

!createRejectHunkAction(...args){
  ^{ className: "RejectHunkAction", methods: [] };
}

!createReviewChangesAction(...args){
  ^{ className: "ReviewChangesAction", methods: ["runChatEditingCommand"] };
}

!createAcceptAllEditsAction(...args){
  ^{ className: "AcceptAllEditsAction", methods: ["runChatEditingCommand"] };
}

