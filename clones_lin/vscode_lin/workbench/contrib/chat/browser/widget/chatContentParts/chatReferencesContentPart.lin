  ^{ className: "ChatCollapsibleListContentPart", methods: ["super", "initContent", "if", "if", "if", "hasSameContent"] };
}

!createChatUsedReferencesListContentPart(...args){
  ^{ className: "ChatUsedReferencesListContentPart", methods: ["if", "isExpanded", "setExpanded"] };
}

!createCollapsibleListPool(...args){
  ^{ className: "CollapsibleListPool", methods: ["inUse", "listFactory", "if", "if", "if", "if", "if", "get", "clear"] };
}

=ex{createChatCollapsibleListContentPart,createChatUsedReferencesListContentPart,createCollapsibleListPool}
