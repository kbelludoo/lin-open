@LIN:workbench_contrib_chat_browser_agentSessions_experiments_agentSessionProjectionActions:1.0.0
~G{?=if #=for ^=ret :else}

!createEnterAgentSessionProjectionAction(...args){
  ^{ className: "EnterAgentSessionProjectionAction", methods: ["run", "if", "if"] };
}

!createExitAgentSessionProjectionAction(...args){
  ^{ className: "ExitAgentSessionProjectionAction", methods: ["run"] };
}

!createToggleUnifiedAgentsBarAction(...args){
  ^{ className: "ToggleUnifiedAgentsBarAction", methods: [] };
}

=ex{createEnterAgentSessionProjectionAction,createExitAgentSessionProjectionAction,createToggleUnifiedAgentsBarAction}
