@LIN:workbench_contrib_chat_browser_agentSessions_experiments_agentTitleBarStatusService:1.0.0
~G{?=if #=for ^=ret :else}

!getAgentStatusModeEnum(){
  ^{ enumName: "AgentStatusMode", members: ["/** Default mode showing workspace name + session stats */
	Default", "/** Session ready mode showing session title + Enter button (before entering projection) */
	SessionReady", "/** Session mode showing session title + Esc button (inside projection) */
	Session"] };
}

=ex{getAgentStatusModeEnum}
