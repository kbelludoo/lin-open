@LIN:workbench_contrib_chat_browser_agentSessions_agentSessionsFilter:1.0.0
~G{?=if #=for ^=ret :else}

!getAgentSessionsGroupingEnum(){
  ^{ enumName: "AgentSessionsGrouping", members: ["Capped", "Date", "Repository"] };
}

!getAgentSessionsSortingEnum(){
  ^{ enumName: "AgentSessionsSorting", members: ["Created", "Updated"] };
}

=ex{getAgentSessionsGroupingEnum,getAgentSessionsSortingEnum}
