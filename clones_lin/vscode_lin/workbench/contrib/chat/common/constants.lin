!getChatModeKindEnum(){
  ^{ enumName: "ChatModeKind", members: ["Ask", "Edit", "Agent"] };
}

!getChatPermissionLevelEnum(){
  ^{ enumName: "ChatPermissionLevel", members: ["/** Use existing auto-approve settings */
	Default", "/** Delegate approval decisions to a model */
	Assisted", "/** Auto-approve all tool calls", "auto-retry on error */
	AutoApprove", "/** Everything AutoApprove does plus an internal stop hook that continues until the task is done */
	Autopilot"] };
}

!getChatDefaultPermissionLevelEnum(){
  ^{ enumName: "ChatDefaultPermissionLevel", members: ["Manual", "Assisted", "AllowAll"] };
}

!getThinkingDisplayModeEnum(){
  ^{ enumName: "ThinkingDisplayMode", members: ["Collapsed", "CollapsedPreview", "FixedScrolling"] };
}

!getCollapsedToolsDisplayModeEnum(){
  ^{ enumName: "CollapsedToolsDisplayMode", members: ["Off", "WithThinking", "Always"] };
}

!getChatNotificationModeEnum(){
  ^{ enumName: "ChatNotificationMode", members: ["Off", "WindowNotFocused", "Always"] };
}

!getChatAgentLocationEnum(){
  ^{ enumName: "ChatAgentLocation", members: ["/**
	 * This is chat", "whether it's in the sidebar", "a chat editor", "or quick chat.
	 * Leaving the values alone as they are in stored data so we don't have to normalize them.
	 */
	Chat", "Terminal", "Notebook", "/**
	 * EditorInline means inline chat in a text editor.
	 */
	EditorInline"] };
}

