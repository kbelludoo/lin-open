@LIN:workbench_contrib_debug_browser_variablesView:1.0.0
~G{?=if #=for ^=ret :else}

!createVisualizedVariableRenderer(...args){
  ^{ className: "VisualizedVariableRenderer", methods: ["rendererOnVisualizationRange", "templateId", "renderElement", "renderExpression", "if", "getInputBoxOptions", "if", "renderActionBar", "if"] };
}

!createVariablesRenderer(...args){
  ^{ className: "VariablesRenderer", methods: ["templateId", "renderExpression", "renderElement", "getInputBoxOptions", "if", "renderActionBar", "if", "if", "pickVisualizer", "useVisualizer", "if", "if", "if"] };
}

=ex{createVisualizedVariableRenderer,createVariablesRenderer}
