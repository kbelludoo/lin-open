@LIN:workbench_contrib_comments_common_commentModel:1.0.0
~G{?=if #=for ^=ret :else}

!createCommentNode(...args){
  ^{ className: "CommentNode", methods: ["hasReply", "lastUpdatedAt", "if", "if", "if"] };
}

!createResourceWithCommentThreads(...args){
  ^{ className: "ResourceWithCommentThreads", methods: ["createCommentNode", "if", "lastUpdatedAt", "if", "if", "for", "if"] };
}

=ex{createCommentNode,createResourceWithCommentThreads}
