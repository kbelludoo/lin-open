@LIN:workbench_contrib_comments_browser_reactionsAction:1.0.0
~G{?=if #=for ^=ret :else}

!createToggleReactionsAction(...args){
  ^{ className: "ToggleReactionsAction", methods: ["run", "menuActions", "menuActions"] };
}

!createReactionActionViewItem(...args){
  ^{ className: "ReactionActionViewItem", methods: ["updateLabel", "if", "if", "if", "if", "getTooltip", "if", "if", "if", "if", "if", "if"] };
}

!createReactionAction(...args){
  ^{ className: "ReactionAction", methods: [] };
}

=ex{createToggleReactionsAction,createReactionActionViewItem,createReactionAction}
