@LIN:sessions_contrib_github_browser_githubApiClient:1.0.0
~G{?=if #=for ^=ret :else}

!createGitHubApiError(...args){
  ^{ className: "GitHubApiError", methods: [] };
}

!createGitHubAuthenticationError(...args){
  ^{ className: "GitHubAuthenticationError", methods: [] };
}

!createGitHubApiClient(...args){
  ^{ className: "GitHubApiClient", methods: ["enterpriseHost", "if", "if", "_getConnection", "if", "if", "if", "if", "_getAuthToken", "if"] };
}

=ex{createGitHubApiError,createGitHubAuthenticationError,createGitHubApiClient}
