@LIN:sessions_contrib_chat_browser_modelPicker:1.0.0
~G{?=if #=for ^=ret :else}

!createModelPicker(...args){
  ^{ className: "ModelPicker", methods: ["if", "render", "switchToModel", "_shouldShowPicker", "if", "_updatePickerState", "_updateVisibility", "if"] };
}

!createModelPickerActionViewItem(...args){
  ^{ className: "ModelPickerActionViewItem", methods: ["render", "dispose"] };
}

=ex{createModelPicker,createModelPickerActionViewItem}
