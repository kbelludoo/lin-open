@LIN:platform_storage_electron_main_storageMain:1.0.0
~G{?=if #=for ^=ret :else}

!createProfileStorageMain(...args){
  ^{ className: "ProfileStorageMain", methods: [] };
}

!createApplicationStorageMain(...args){
  ^{ className: "ApplicationStorageMain", methods: ["doInit", "updateTelemetryState", "if"] };
}

!createApplicationSharedStorageMain(...args){
  ^{ className: "ApplicationSharedStorageMain", methods: ["path", "if", "doCreate", "applicationStorageItems", "prepareStorageFolder", "if", "if"] };
}

!createWorkspaceStorageMain(...args){
  ^{ className: "WorkspaceStorageMain", methods: ["path", "if", "doCreate", "prepareWorkspaceStorageFolder", "if", "if", "ensureWorkspaceStorageFolderMeta", "if", "if", "catch", "error"] };
}

!createInMemoryStorageMain(...args){
  ^{ className: "InMemoryStorageMain", methods: ["path", "doCreate"] };
}

=ex{createProfileStorageMain,createApplicationStorageMain,createApplicationSharedStorageMain,createWorkspaceStorageMain,createInMemoryStorageMain}
