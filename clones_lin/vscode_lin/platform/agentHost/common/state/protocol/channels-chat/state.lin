@LIN:platform_agentHost_common_state_protocol_channels_chat_state:1.0.0
~G{?=if #=for ^=ret :else}

!getMessageKindEnum(){
  ^{ enumName: "MessageKind", members: ["/** Sent directly by the user. */
	User", "/**
	 * Produced by the agent itself rather than the user — for example", "an agent
	 * that seeds the first message of a chat it spawned.
	 */
	Agent", "/**
	 * Produced by a tool rather than the user — for example", "a tool that spawns a
	 * worker chat whose first message carries a seed prompt.
	 */
	Tool", "/** Emitted automatically when an automation run starts a session. */
	Automation", "/** A system-generated notification rather than a direct user message. */
	SystemNotification"] };
}

=ex{getMessageKindEnum}
