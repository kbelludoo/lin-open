@LIN:platform_quickinput_common_quickAccess:1.0.0
~G{?=if #=for ^=ret :else}

!getDefaultQuickAccessFilterValueEnum(){
  ^{ enumName: "DefaultQuickAccessFilterValue", members: ["/**
	 * Keep the value as it is given to quick access.
	 */
	PRESERVE", "/**
	 * Use the value that was used last time something was accepted from the picker.
	 */
	LAST"] };
}

=ex{getDefaultQuickAccessFilterValueEnum}
