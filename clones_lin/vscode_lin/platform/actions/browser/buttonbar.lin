@LIN:platform_actions_browser_buttonbar:1.0.0
~G{?=if #=for ^=ret :else}

!createWorkbenchButtonBar(...args){
  ^{ className: "WorkbenchButtonBar", methods: ["onWillRun", "onDidRun", "if", "dispose", "update", "for", "if", "if", "if", "if", "if", "if", "if", "if", "if", "if"] };
}

!createMenuWorkbenchButtonBar(...args){
