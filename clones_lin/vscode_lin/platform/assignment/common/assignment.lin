!getInternalOrg(organisations){
  // Transposed from platform/assignment/common/assignment.ts
  ^{ name: "getInternalOrg", status: "pure" };
}

!getTargetPopulationEnum(){
  ^{ enumName: "TargetPopulation", members: ["Insiders", "Public", "Exploration"] };
}

!getFiltersEnum(){
  ^{ enumName: "Filters", members: ["/**
	 * The market in which the extension is distributed.
	 */
	Market", "/**
	 * The corporation network.
	 */
	CorpNet", "/**
	 * Version of the application which uses experimentation service.
	 */
	ApplicationVersion", "/**
	 * Insiders vs Stable.
	 */
	Build", "/**
	 * Client Id which is used as primary unit for the experimentation.
	 */
	ClientId", "/**
	 * Developer Device Id which can be used as an alternate unit for experimentation.
	 */
	DeveloperDeviceId", "/**
	 * Extension header.
	 */
	ExtensionName", "/**
	 * The version of the extension.
	 */
	ExtensionVersion", "/**
	 * The language in use by VS Code
	 */
	Language", "/**
	 * The target population.
	 * This is used to separate internal", "early preview", "GA", "etc.
	 */
	TargetPopulation", "/**
	 * The platform (OS) on which VS Code is running.
	 */
	Platform", "/**
	 * The release/build date of VS Code (UTC) in the format yyyymmddHH.
	 */
	ReleaseDate", "/**
	 * The kind of window VS Code is running in (`editor` or `agents`).
	 */
	WindowKind"] };
}

!getAssignmentsFiltersEnum(){
  ^{ enumName: "AssignmentsFilters", members: ["ApplicationVersion", "Build", "DeveloperDeviceId", "ExtensionName", "ExtensionNameShort", "TargetPopulation", "Platform", "ReleaseDate", "WindowKind"] };
}

=ex{getInternalOrg,getTargetPopulationEnum,getFiltersEnum,getAssignmentsFiltersEnum}
