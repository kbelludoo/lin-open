@LIN:platform_progress_common_progress:1.0.0
~G{?=if #=for ^=ret :else}

!createUnmanagedProgress(...args){
  ^{ className: "UnmanagedProgress", methods: ["withProgress", "report", "if"] };
}

!createLongRunningOperation(...args){
  ^{ className: "LongRunningOperation", methods: ["start", "if", "stop", "doStop", "if"] };
}

=ex{createUnmanagedProgress,createLongRunningOperation}
