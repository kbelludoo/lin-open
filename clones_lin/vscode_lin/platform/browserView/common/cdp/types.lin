@LIN:platform_browserView_common_cdp_types:1.0.0
~G{?=if #=for ^=ret :else}

!createCDPError(...args){
  ^{ className: "CDPError", methods: [] };
}

!createCDPMethodNotFoundError(...args){
  ^{ className: "CDPMethodNotFoundError", methods: [] };
}

!createCDPInvalidParamsError(...args){
  ^{ className: "CDPInvalidParamsError", methods: [] };
}

!createCDPInternalError(...args){
  ^{ className: "CDPInternalError", methods: [] };
}

!createCDPServerError(...args){
  ^{ className: "CDPServerError", methods: [] };
}

=ex{createCDPError,createCDPMethodNotFoundError,createCDPInvalidParamsError,createCDPInternalError,createCDPServerError}
