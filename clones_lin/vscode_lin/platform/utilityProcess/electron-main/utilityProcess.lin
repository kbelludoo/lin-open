@LIN:platform_utilityProcess_electron_main_utilityProcess:1.0.0
~G{?=if #=for ^=ret :else}

!createUtilityProcess(...args){
  ^{ className: "UtilityProcess", methods: ["getAll", "log", "if", "switch", "validateCanStart", "if", "start", "if", "if", "doStart", "if", "createEnv", "if", "if", "registerListeners", "if", "if", "if", "if", "_register", "postMessage", "if", "connect", "enableInspectPort", "if", "if", "kill", "if", "if", "onDidExitOrCrashOrKill", "if", "waitForExit", "if", "if"] };
}

!createWindowUtilityProcess(...args){
  ^{ className: "WindowUtilityProcess", methods: ["start", "if", "registerWindowListeners", "if"] };
}

=ex{createUtilityProcess,createWindowUtilityProcess}
