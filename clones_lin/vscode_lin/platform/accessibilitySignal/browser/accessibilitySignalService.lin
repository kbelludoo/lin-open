@LIN:platform_accessibilitySignal_browser_accessibilitySignalService:1.0.0
~G{?=if #=for ^=ret :else}

!createSound(...args){
  ^{ className: "Sound", methods: ["register"] };
}

!createSoundSource(...args){
  ^{ className: "SoundSource", methods: ["getSound", "if"] };
}

!createAccessibilitySignal(...args){
  ^{ className: "AccessibilitySignal", methods: ["register", "allAccessibilitySignals"] };
}

=ex{createSound,createSoundSource,createAccessibilitySignal}
