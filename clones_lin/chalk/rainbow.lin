@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=strip_tests+sigil_ops+named_only+const_table
~G{?=if #=for ^=ret :else}
!rainbow(string,offset){;?(!string||string.length==0){^string};hueStep=360/string.replaceAll(ignoreCharacters,'').length;hue=offset%360;characters=[];#(character of string){?(ignoreCharacters.test(character)){characters.push(character)}:{characters.push(chalk.hex(convertColor.hsl.hex(hue,100,50))(character));hue=(hue+hueStep)%360}};^characters.join('')}
=ex{rainbow}