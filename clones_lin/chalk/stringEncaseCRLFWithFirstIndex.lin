!stringEncaseCRLFWithFirstIndex(string,prefix,postfix,index){;endIndex=0;returnValue='';do{isGotCR=string[index-1]=='\r';returnValue+=string.slice(endIndex,((((__c)=>{?(__c){return(index-1)}return(index)})(isGotCR))))+prefix+((((__c)=>{?(__c){return('\r\n')}return('\n')})(isGotCR)))+postfix;endIndex=index+1;index=string.indexOf('\n',endIndex)}while (index!=-1);returnValue+=string.slice(endIndex);^returnValue}
=ex{stringEncaseCRLFWithFirstIndex}