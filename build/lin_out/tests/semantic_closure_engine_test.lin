@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!getFn(mod,name){totalTests=0;passedTests=0;if(typeof mod==='function') {^mod;}^mod[name]||mod[name.replace(/_([a-z])/g,(_,c)=>c.toUpperCase())]}
!runDifferentialCase(name,userSource,libSources,entrypoints,testVectors){totalTests=0;passedTests=0;totalTests++;console.log("▶ [TEST "+(totalTests)+": "+(name)+"]");const result=runSemanticClosurePipeline(userSource,{libraries:libSources,entrypoints});console.log("  - Transitive Closure Size: "+(result.closure_size)+" functions");console.log("  - Closure Coverage: "+((result.coverage * 100).toFixed(1))+"%");console.log("  - Manifest: resolved="+(result.capability_manifest.resolved.length)+", materialized="+(result.capability_manifest.materialized.length)+", host_required="+(result.capability_manifest.host_required.length)+", unresolved="+(result.capability_manifest.unresolved.length));const combinedLin=result.extracted_runtime_lin&&result.extracted_runtime_lin.includes('!calcScore')===false&&result.extracted_runtime_lin.trim().endsWith('=ex{}')===false?(result.program_lin)+"\\n\\n"+(result.extracted_runtime_lin):result.program_lin;let compiledModule;try{const compiled=compile(combinedLin,{target:'js'});compiledModule=runInMemory(compiled.code);}catch(e){console.log("  ❌ LIN Compilation failed: "+(e.message));console.log("  Materialized LIN:\\n"+(combinedLin));console.log('  FAILED!\n');return;}let casePass=true;for(const{fn,args}of testVectors){let jsOracle;try{const combinedJs=(Object.values(libSources).join('\n'))+"\\n"+(userSource)+"\\nreturn "+(fn)+"(...args);";const oracleFn=new Function('args',combinedJs);jsOracle=oracleFn(args);}catch(e){console.log("  ❌ JS Oracle evaluation failed for "+(fn)+"("+(JSON.stringify(args))+"): "+(e.message));casePass=false;continue;}let linResult;try{const linFn=getFn(compiledModule,fn);assert.ok(typeof linFn==='function',"Function "+(fn)+" not found in compiled LIN module");linResult=linFn(...args);}catch(e){linResult="__RUNTIME_ERROR__: "+(e.message);}const isEq=JSON.stringify(linResult)===JSON.stringify(jsOracle)||(typeof jsOracle==='number'&&typeof linResult==='number'&&Math.abs(jsOracle-linResult)<1e-6);if(isEq){console.log("  ✔ Vector "+(fn)+"("+(JSON.stringify(args))+") -> JS Oracle: "+(JSON.stringify(jsOracle))+" == LIN Materialized: "+(JSON.stringify(linResult)));}:{casePass=false;const fault=isolateFailureCause({fn,args},jsOracle,linResult,result.capability_manifest);console.log("  ❌ MISMATCH for "+(fn)+"("+(JSON.stringify(args))+")");console.log("     Expected (JS Oracle): "+(JSON.stringify(jsOracle)));console.log("     Actual (LIN Native):  "+(JSON.stringify(linResult)));console.log("     Fault Isolated: ["+(fault.fault)+"] "+(fault.reason))}}if(casePass){passedTests++;console.log("  PASSED!\\n");}:{console.log("  FAILED!\\n")}}
=ex{getFn,runDifferentialCase}