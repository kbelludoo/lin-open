@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!rng(){repoRoot=path.resolve('clones_lin/fast-json-patch/module');corePath=path.join(repoRoot,'core.mjs');helpersPath=path.join(repoRoot,'helpers.mjs');functionHashes={};totalTests=0;passedMatches=0;failedMismatches=0;officialSuites=[...testsJson,...specTestsJson];seed=20260825;corpus2Total=10000;corpus2Matches=0;adversarialVectors=[{doc:{'a/b':1,'c~d':2},patch:[{op:'test',path:'/a~1b',value:1},{op:'test',path:'/c~0d',value:2}]},{doc:[10,20,30],patch:[{op:'add',path:'/-',value:40},{op:'remove',path:'/1'}]},{doc:{x:{y:{z:100}}},patch:[{op:'move',from:'/x/y/z',path:'/z'}]},{doc:{items:[1,2,3]},patch:[{op:'copy',from:'/items/0',path:'/items/-'}]},{doc:{val:null},patch:[{op:'replace',path:'/val',value:'truthy'}]},{doc:{num:10},patch:[{op:'test',path:'/num',value:'10'}]},{doc:{nested:{a:1}},patch:[{op:'replace',path:'',value:{replaced:true}}]}];corpus3Matches=0;seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return(seed>>>0)/4294967296}
!randomChoice(arr){repoRoot=path.resolve('clones_lin/fast-json-patch/module');corePath=path.join(repoRoot,'core.mjs');helpersPath=path.join(repoRoot,'helpers.mjs');functionHashes={};totalTests=0;passedMatches=0;failedMismatches=0;officialSuites=[...testsJson,...specTestsJson];seed=20260825;corpus2Total=10000;corpus2Matches=0;adversarialVectors=[{doc:{'a/b':1,'c~d':2},patch:[{op:'test',path:'/a~1b',value:1},{op:'test',path:'/c~0d',value:2}]},{doc:[10,20,30],patch:[{op:'add',path:'/-',value:40},{op:'remove',path:'/1'}]},{doc:{x:{y:{z:100}}},patch:[{op:'move',from:'/x/y/z',path:'/z'}]},{doc:{items:[1,2,3]},patch:[{op:'copy',from:'/items/0',path:'/items/-'}]},{doc:{val:null},patch:[{op:'replace',path:'/val',value:'truthy'}]},{doc:{num:10},patch:[{op:'test',path:'/num',value:'10'}]},{doc:{nested:{a:1}},patch:[{op:'replace',path:'',value:{replaced:true}}]}];corpus3Matches=0;^arr[Math.floor(rng()*arr.length)]}
!generateRandomDoc(depth){repoRoot=path.resolve('clones_lin/fast-json-patch/module');corePath=path.join(repoRoot,'core.mjs');helpersPath=path.join(repoRoot,'helpers.mjs');functionHashes={};totalTests=0;passedMatches=0;failedMismatches=0;officialSuites=[...testsJson,...specTestsJson];seed=20260825;corpus2Total=10000;corpus2Matches=0;adversarialVectors=[{doc:{'a/b':1,'c~d':2},patch:[{op:'test',path:'/a~1b',value:1},{op:'test',path:'/c~0d',value:2}]},{doc:[10,20,30],patch:[{op:'add',path:'/-',value:40},{op:'remove',path:'/1'}]},{doc:{x:{y:{z:100}}},patch:[{op:'move',from:'/x/y/z',path:'/z'}]},{doc:{items:[1,2,3]},patch:[{op:'copy',from:'/items/0',path:'/items/-'}]},{doc:{val:null},patch:[{op:'replace',path:'/val',value:'truthy'}]},{doc:{num:10},patch:[{op:'test',path:'/num',value:'10'}]},{doc:{nested:{a:1}},patch:[{op:'replace',path:'',value:{replaced:true}}]}];corpus3Matches=0;if(depth>3||rng()<0.3){const prims=[42,-10,0,'hello','world',true,false,null,'100'];^randomChoice(prims);}if(rng()<0.5){const len=Math.floor(rng()*4)+1;const arr=[];for(let i=0;i<len;i++) {arr.push(generateRandomDoc(depth+1));}^arr;}:{const keys=['a','b','c','foo','bar','val','item'];const obj={};const count=Math.floor(rng()*3)+1;for(let i=0;i<count;i++){obj[randomChoice(keys)]=generateRandomDoc(depth+1);}^obj}}
!generateRandomPatch(doc){repoRoot=path.resolve('clones_lin/fast-json-patch/module');corePath=path.join(repoRoot,'core.mjs');helpersPath=path.join(repoRoot,'helpers.mjs');functionHashes={};totalTests=0;passedMatches=0;failedMismatches=0;officialSuites=[...testsJson,...specTestsJson];seed=20260825;corpus2Total=10000;corpus2Matches=0;adversarialVectors=[{doc:{'a/b':1,'c~d':2},patch:[{op:'test',path:'/a~1b',value:1},{op:'test',path:'/c~0d',value:2}]},{doc:[10,20,30],patch:[{op:'add',path:'/-',value:40},{op:'remove',path:'/1'}]},{doc:{x:{y:{z:100}}},patch:[{op:'move',from:'/x/y/z',path:'/z'}]},{doc:{items:[1,2,3]},patch:[{op:'copy',from:'/items/0',path:'/items/-'}]},{doc:{val:null},patch:[{op:'replace',path:'/val',value:'truthy'}]},{doc:{num:10},patch:[{op:'test',path:'/num',value:'10'}]},{doc:{nested:{a:1}},patch:[{op:'replace',path:'',value:{replaced:true}}]}];corpus3Matches=0;const ops=['add','replace','remove','move','copy','test'];const patch=[];const patchCount=Math.floor(rng()*3)+1;for(let i=0;i<patchCount;i++){const op=randomChoice(ops);const paths=['/a','/b','/0','/1','/foo','/bar','/val/a','/item',''];const p=randomChoice(paths);const pItem={op,path:p};if(op==='add'||op==='replace'||op==='test'){pItem.value=generateRandomDoc(2);}if(op==='move'||op==='copy'){pItem.from=randomChoice(paths);}patch.push(pItem);}^patch}
=ex{rng,randomChoice,generateRandomDoc,generateRandomPatch}