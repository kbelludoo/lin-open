@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!canonicalizeJson(obj){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_PATH=path.join(ROOT,'spec','B6_LOGIC_SPEC_V1.json');if(obj===null||typeof obj!=='object'){^JSON.stringify(obj);}if(Array.isArray(obj)){^"["+(obj.map(canonicalizeJson).join(','))+"]";}const keys=Object.keys(obj).sort();const pairs=keys.map((k)=>(JSON.stringify(k))+":"+(canonicalizeJson(obj[k])));^"{"+(pairs.join(','))+"}"}
!sha256Hex(data){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_PATH=path.join(ROOT,'spec','B6_LOGIC_SPEC_V1.json');^crypto.createHash('sha256').update(data).digest('hex')}
!computeInputHash(canonicalText){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_PATH=path.join(ROOT,'spec','B6_LOGIC_SPEC_V1.json');const prefix=Buffer.from('LIN/B6_INPUT/0.1\0','utf8');const buf=Buffer.concat([prefix,Buffer.from(canonicalText,'utf8')]);^"sha256:"+(sha256Hex(buf))}
!computeResultHash(canonicalText){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_PATH=path.join(ROOT,'spec','B6_LOGIC_SPEC_V1.json');const prefix=Buffer.from('LIN/B6_RESULT/0.1\0','utf8');const buf=Buffer.concat([prefix,Buffer.from(canonicalText,'utf8')]);^"sha256:"+(sha256Hex(buf))}
!solveB6Oracle(spec){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_PATH=path.join(ROOT,'spec','B6_LOGIC_SPEC_V1.json');const kb=spec.knowledge_base;const caps=new Set();const activeContracts=new Set();const trust=[];for(const f of kb.facts){if(f.rel==='has_capability'){caps.add((f.args[0])+":"+(f.args[1]));}:( f.rel==='contract_active' ){activeContracts.add(f.args[0])}:( f.rel==='trust_edge' ){trust.push({from:f.args[0],to:f.args[1],level:f.args[2]})}}const direct=[];for(const edge of trust){if(edge.level>=3&&activeContracts.has(edge.to)){if(caps.has((edge.from)+":cap_delegate")){for(const cap of kb.constants.capabilities){if(caps.has((edge.from)+":"+(cap))){direct.push({from:edge.from,to:edge.to,cap});}}}}}const chain=new Set();for(const d of direct){chain.add((d.from)+":"+(d.to)+":"+(d.cap));}let changed=true;while(changed){changed=false;const current=Array.from(chain).map((s)=>{const parts=s.split(':');return{from:parts[0],to:parts[1],cap:parts[2]};});for(const d of direct){if(d.cap==='cap_delegate'){const intermediate=d.to;for(const c of current){if(c.from===intermediate){const key=(d.from)+":"+(c.to)+":"+(c.cap);if(!chain.has(key)){chain.add(key);changed=true;}}}}}}const bindings=Array.from(chain).map((s)=>{const parts=s.split(':');return{"?Origin":parts[0],"?Target":parts[1],"?Cap":parts[2],};}).sort((a,b)=>{if(a['?Origin']!==b['?Origin']) {^a['?Origin'].localeCompare(b['?Origin']);}if(a['?Target']!==b['?Target']) {^a['?Target'].localeCompare(b['?Target']);}^a['?Cap'].localeCompare(b['?Cap']);});const canonicalResultObj={spec_id:"B6_LOGIC_V1",distinct_solutions_count:bindings.length,status:"SUCCESS",bindings,};const canonicalResultJson=canonicalizeJson(canonicalResultObj);const resultHash=computeResultHash(canonicalResultJson);return{bindings,count:bindings.length,canonical_json:canonicalResultJson,result_hash:resultHash,}}
=ex{canonicalizeJson,sha256Hex,computeInputHash,computeResultHash,solveB6Oracle}