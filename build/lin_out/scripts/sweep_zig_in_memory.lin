@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!sweepZigInMemory(){ROOT=path.resolve(path.dirname(__filename),'..');RESULTS_DIR=path.join(ROOT,'results/sweep_zig_in_memory');console.log("================================================================================");console.log("   SWEEP GLOBAL DE PROJETOS LIN -> COMPILAÇÃO & EXECUÇÃO EM MEMÓRIA (ZIG)     ");console.log("================================================================================");fs.mkdirSync(RESULTS_DIR,{recursive:true});const files=[];function walk(dir){for(const f of fs.readdirSync(dir)){if(['.git','node_modules','target','_legacy_v1','_lin-master-hidden','results'].includes(f)) {continue;}const full=path.join(dir,f);const stat=fs.statSync(full);if(stat.isDirectory()){walk(full);}:( f.endsWith('.lin')||f.endsWith('.lia') ){files.push(full)}}}walk(ROOT);console.log("[+] Encontrados "+(files.length)+" arquivos .lin/.lia no repositório.");console.log("[+] Iniciando compilação e execução em memória via Zig...\n");let totalParsed=0;let totalCompiled=0;let totalExecuted=0;let totalSkippedDocs=0;const failures=[];const passedModules=[];for(let i=0;i<files.length;i++){const file=files[i];const rel=path.relative(ROOT,file);const content=fs.readFileSync(file,'utf8');if(!/^@(LIN|LIA|AIL):/m.test(content.split('\n')[0]||'')&&!/!fn|!\w+\(/.test(content)){totalSkippedDocs++;continue;}try{parseProgram(content);totalParsed++;}catch(e){if(rel.includes('spec')||rel.includes('violation')){totalSkippedDocs++;continue;}failures.push({file:rel,stage:'PARSE',error:e.message});continue;}let compiled=null;try{compiled=compile(content,{target:'zig',stubJsRuntimeOnly:true});totalCompiled++;}catch(e){failures.push({file:rel,stage:'COMPILE_ZIG',error:e.message});continue;}const execRes=runInMemoryZig(content,{timeoutMs:8000});if(execRes.ok){totalExecuted++;passedModules.push({file:rel,fns:compiled.fns,output:execRes.output});if(totalExecuted%25===0||totalExecuted===1){console.log("  [✓] ("+(totalExecuted)+") Executado em memória Zig: "+(rel)+" ["+(compiled.fns.length)+" fns]");}}:{failures.push({file:rel,stage:'RUN_ZIG',error:execRes.error})}}console.log("\n================================================================================");console.log("   RELATÓRIO CONSOLIDADO DO SWEEP ZIG EM MEMÓRIA                              ");console.log("================================================================================");console.log("[+] Total de Arquivos Encontrados:     "+(files.length));console.log("[+] Módulos Válidos Analisados:        "+(totalParsed));console.log("[+] Módulos Compilados para Zig:       "+(totalCompiled));console.log("[+] Módulos Executados com Sucesso:    "+(totalExecuted));console.log("[+] Documentos/Specs Não-executáveis:  "+(totalSkippedDocs));console.log("[+] Falhas Encontradas:                "+(failures.length));console.log("[+] Taxa de Sucesso em Memória:        "+(((totalExecuted / (totalParsed || 1)) * 100).toFixed(1))+"%");console.log("================================================================================");const report={benchmark:"GLOBAL_LIN_TO_ZIG_IN_MEMORY_SWEEP",timestamp:new Date().toISOString(),total_files_scanned:files.length,valid_programs_parsed:totalParsed,zig_compiled:totalCompiled,zig_in_memory_executed:totalExecuted,skipped_docs_and_specs:totalSkippedDocs,failures,status:failures.length===0?"ALL_PROJECTS_ZIG_VERIFIED":"PARTIAL_WITH_FAILURES"};const reportPath=path.join(RESULTS_DIR,'SWEEP_ZIG_REPORT.json');fs.writeFileSync(reportPath,JSON.stringify(report,null,2),'utf8');console.log("[+] Relatório salvo em: "+(reportPath));console.log("================================================================================");^report}
=ex{sweepZigInMemory}