@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!hashCanonicalNode(irNode){CANONICALIZATION_VERSION='1.0';if(!irNode) {^hashString('Null');}switch(irNode.kind){case 'Literal':^hashString("Lit:"+(irNode.type)+":"+(JSON.stringify(irNode.value)));case 'LocalRef':^hashString("Local:"+(irNode.ref));case 'CaptureRef':^hashString("Cap:"+(irNode.ref));case 'GlobalRef':^hashString("Global:"+(irNode.name));case 'Binary':{const leftH=hashCanonicalNode(irNode.left);const rightH=hashCanonicalNode(irNode.right);^hashString("Bin:"+(irNode.operator)+":"+(leftH)+":"+(rightH));}case 'Unary':{const argH=hashCanonicalNode(irNode.argument);^hashString("Un:"+(irNode.operator)+":"+(irNode.prefix)+":"+(argH));}case 'Update':{const argH=hashCanonicalNode(irNode.argument);^hashString("Upd:"+(irNode.operator)+":"+(irNode.prefix)+":"+(argH));}case 'Assign':{const leftH=hashCanonicalNode(irNode.left);const rightH=hashCanonicalNode(irNode.right);^hashString("Assign:"+(irNode.operator)+":"+(leftH)+":"+(rightH));}case 'Call':{const calleeH=hashCanonicalNode(irNode.callee);const argsH=(irNode.args||[]).map(hashCanonicalNode).join(',');^hashString("Call:"+(calleeH)+":["+(argsH)+"]");}case 'Member':{const objH=hashCanonicalNode(irNode.object);const propH=typeof irNode.property==='object'?hashCanonicalNode(irNode.property):"lit:"+(irNode.property);^hashString("Member:"+(objH)+":"+(propH)+":"+(irNode.computed)+":"+(irNode.optional));}case 'Array':{const elemH=(irNode.elements||[]).map(hashCanonicalNode).join(',');^hashString("Arr:["+(elemH)+"]");}case 'Object':{const propsH=(irNode.properties||[]).map(p=>(p.key)+"="+(hashCanonicalNode(p.value))).join(';');^hashString("Obj:{"+(propsH)+"}");}case 'If':{const testH=hashCanonicalNode(irNode.test);const consH=hashCanonicalNode(irNode.consequent);const altH=irNode.alternate?hashCanonicalNode(irNode.alternate):'none';^hashString("If:"+(testH)+":"+(consH)+":"+(altH));}case 'Conditional':{const testH=hashCanonicalNode(irNode.test);const consH=hashCanonicalNode(irNode.consequent);const altH=hashCanonicalNode(irNode.alternate);^hashString("Cond:"+(testH)+":"+(consH)+":"+(altH));}case 'While':{const testH=hashCanonicalNode(irNode.test);const bodyH=hashCanonicalNode(irNode.body);^hashString("While:"+(testH)+":"+(bodyH));}case 'For':{const initH=irNode.init?hashCanonicalNode(irNode.init):'none';const testH=irNode.test?hashCanonicalNode(irNode.test):'none';const updH=irNode.update?hashCanonicalNode(irNode.update):'none';const bodyH=hashCanonicalNode(irNode.body);^hashString("For:"+(initH)+":"+(testH)+":"+(updH)+":"+(bodyH));}case 'Return':{const argH=irNode.argument?hashCanonicalNode(irNode.argument):'void';^hashString("Ret:"+(argH));}case 'Block':{const stmtsH=(irNode.statements||[]).map(hashCanonicalNode).join(';');^hashString("Block:["+(stmtsH)+"]");}case 'VariableDeclaration':{const declsH=(irNode.declarations||[]).map(d=>{if(d.kind==='Destructure'){const initH=d.init?hashCanonicalNode(d.init):'none';^"Destruct:["+(d.indexes.join(','))+"]="+(initH);}const initH=d.init?hashCanonicalNode(d.init):'none';^"Var:"+(d.index)+"="+(initH);}).join(';');^hashString("VarDecl:["+(declsH)+"]");}case 'Function':{const bodyH=hashCanonicalNode(irNode.body);const capsH=(irNode.captures||[]).map(c=>(c.outerRef)+"->"+(c.ref)).join(',');^hashString("Fn:v"+(CANONICALIZATION_VERSION)+":"+(irNode.effect)+":p"+(irNode.paramCount)+":["+(capsH)+"]:"+(bodyH));}default:^hashString("Unknown:"+(JSON.stringify(irNode)));}}
!hashAppMerkleRoot(exportHashMap){CANONICALIZATION_VERSION='1.0';const sortedEntries=Object.entries(exportHashMap).sort(([a],[b])=>a.localeCompare(b));const entriesStr=sortedEntries.map(([name,hash])=>(name)+":"+(hash)).join('|');^hashString("AppRoot:v"+(CANONICALIZATION_VERSION)+":{"+(entriesStr)+"}")}
!hashJsFunctionSource(fnSource){CANONICALIZATION_VERSION='1.0';const ast=TrueAstParser.parse(fnSource);const fnNode=ast.body.find(s=>s.type==='FunctionDeclaration'||s.type==='VariableDeclaration'||s.type==='ExpressionStatement');const target=fnNode&&fnNode.type==='VariableDeclaration'?fnNode.declarations[0].init:(fnNode&&fnNode.type==='ExpressionStatement'?fnNode.expression:fnNode);if(!target){throw new Error("No function definition found in source: "+(fnSource.slice(0, 50)));}const ir=CanonicalIrSerializer.serializeFunction(target);return{hash:hashCanonicalNode(ir),ir,effect:ir.effect}}
!hashString(content){CANONICALIZATION_VERSION='1.0';^createHash('sha256').update(content,'utf8').digest('hex').slice(0,16)}
=ex{hashCanonicalNode,hashAppMerkleRoot,hashJsFunctionSource,hashString}