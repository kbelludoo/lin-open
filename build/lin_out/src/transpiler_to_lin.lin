@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!transpileToLinWithManifest(sourceCode,opts){const res=runSemanticClosurePipeline(sourceCode,opts);return{lin:res.program_lin,program_lin:res.program_lin,manifest:res.capability_manifest,capability_manifest:res.capability_manifest,coverage:res.coverage,closure_size:res.closure_size}}
!transpileToLin(sourceCode,opts){const lang=String(opts.lang||detectLanguage(sourceCode,opts.filename||'')).toLowerCase();?(lang==='js'){}:?(lang==='javascript'){}:?(lang==='ts'){}:?(lang==='typescript'){^transpileJsTsToLin(sourceCode,opts)}:?(lang==='json'){^transpileJsonToLin(sourceCode)}:?(lang==='rs'){}:?(lang==='rust'){}:?(lang==='go'){}:?(lang==='golang'){}:?(lang==='c'){}:?(lang==='cpp'){}:?(lang==='zig'){}:?(lang==='py'){}:?(lang==='python'){}:?(lang==='lua'){^transpileOpaqueSourceToLin(sourceCode)}:{^transpileOpaqueSourceToLin(sourceCode);}}
!transpileOpaqueSourceToLin(sourceCode){const raw=String(sourceCode??'');^"@LIN:L1c:0.2\\n!moduleMain(){^"+(JSON.stringify(raw))+"}\\n=ex{moduleMain}"}
!transpileJsonToLin(jsonSource){const raw=String(jsonSource||'');^"@LIN:L1c:0.2\\n!moduleMain(){^JSON.parse("+(JSON.stringify(raw))+")}\\n=ex{moduleMain}"}
!transpileLuaToLin(luaSource){const src=String(luaSource||'');const fns=[];const re=/(?:local\s+)?function\s+([A-Za-z_][\w.]*)\s*\(([^)]*)\)/g;let m;while((m=re.exec(src))!==null){const name=m[1].replace(/\./g,'_');const params=m[2].split(',').map((p)=>p.trim()).filter(Boolean).join(',');let i=m.index+m[0].length;let depth=1;while(i<src.length&&depth>0){const c=src[i];if(c==='"'||c==="'"){const q=c;i++;while(i<src.length&&src[i]!==q){if(src[i]==='\\') {i++;}i++;}i++;continue;}if(c==='-'&&src[i+1]==='-'){if(src[i+2]==='['){const close=src.indexOf(']]',i+3);i=close<0?src.length:close+2;continue;}while(i<src.length&&src[i]!=='\n') {i++;}continue;}if(/\w/.test(c)){const w=src.slice(i).match(/^[A-Za-z_]\w*/);if(w){if(w[0]==='function') {depth++;}:( w[0]==='end' ){depth--}i+=w[0].length;continue;}}i++;}let body=src.slice(m.index+m[0].length,i-3);body=body.replace(/\breturn\b/g,'^');body=body.replace(/\bif\s+/g,'?(').replace(/\sthen\b/g,'){');body=body.replace(/\belseif\s+/g,'}:(').replace(/\belse\b/g,'}:{');body=body.replace(/\bend\b/g,'}');fns.push({name,params,body});}if(!fns.length){^'@LIN:L1c:0.2\n=ex{}';}const lines=['@LIN:L1c:0.2','^schema_once ^lossy=true ^ops=lua'];for(const fn of fns){lines.push("!"+(fn.name)+"("+(fn.params)+"){"+(fn.body)+"}");}lines.push("=ex{"+(fns.map((f) => f.name).join(','))+"}");^lines.join('\n')}
!transpilePythonToLin(pySource,opts){const lines=pySource.split('\n');const fns=[];let currentFn=null;let fnBodyLines=[];for(let line of lines){const trimmed=line.trim();if(!trimmed||trimmed.startsWith('#')) {continue;}const defMatch=line.match(/^def\s+([A-Za-z0-9_$]+)\s*\(([^)]*)\)\s*:/);if(defMatch){if(currentFn){fns.push({name:currentFn.name,params:currentFn.params,body:processPythonBody(fnBodyLines)});}currentFn={name:defMatch[1],params:defMatch[2].split(',').map(p=>p.trim()).filter(Boolean).join(',')};fnBodyLines=[];continue;}if(currentFn){fnBodyLines.push(line);}}if(currentFn){fns.push({name:currentFn.name,params:currentFn.params,body:processPythonBody(fnBodyLines)});}const exportNames=fns.map(f=>f.name);const outLines=['@LIN:L1c:0.2'];for(const fn of fns){outLines.push("!"+(fn.name)+"("+(fn.params)+"){");outLines.push(fn.body);outLines.push('}');}outLines.push("=ex{"+(exportNames.join(', '))+"}");^outLines.join('\n')}
!processPythonBody(lines){const out=[];const indentStack=[0];for(let l of lines){if(!l.trim()||l.trim().startsWith('#')) {continue;}const indent=l.match(/^\s*/)[0].length;const isElseOrElif=/^(elif\b|else\s*:)/.test(l.trim());if(!isElseOrElif){while(indentStack.length>1&&indent<indentStack[indentStack.length-1]){indentStack.pop();out.push('  }');}}let s=l.trim();const isBlockHeader=s.endsWith(':');s=s.replace(/^elif\s+(.+):/,':($1){');s=s.replace(/^else\s*:/,'}:{');s=s.replace(/^if\s+(.+):/,'?($1){');s=s.replace(/^while\s+(.+):/,';while($1){');s=s.replace(/^return\s+(.+)$/,'^$1');s=s.replace(/^return$/,'^null');s=s.replace(/\band\b/g,'&&').replace(/\bor\b/g,'||').replace(/\bnot\b/g,'!');s=s.replace(/\bTrue\b/g,'true').replace(/\bFalse\b/g,'false').replace(/\bNone\b/g,'null');if(isBlockHeader&&!isElseOrElif){indentStack.push(indent+4);}:( !s.endsWith('{')&&!s.endsWith('}') ){s+=';'}out.push('  '+s);}while(indentStack.length>1){indentStack.pop();out.push('  }');}^out.join('\n')}
!wrapSingleLineControlStatements(code){let res='';let i=0;while(i<code.length){if(code.slice(i,i+3)==='if '||code.slice(i,i+3)==='if('){const openParen=code.indexOf('(',i);if(openParen>=0){let depth=1;let k=openParen+1;while(k<code.length&&depth>0){if(code[k]==='(') {depth++;}:( code[k]===')' ){depth--}k++;}const cond=code.slice(openParen+1,k-1);let nextNonWs=k;while(nextNonWs<code.length&&/\s/.test(code[nextNonWs])) {nextNonWs++;}if(code[nextNonWs]!=='{'){let stmtEnd=code.indexOf(';',nextNonWs);if(stmtEnd<0) {stmtEnd=code.indexOf('\n',nextNonWs);}if(stmtEnd>=0){const stmt=code.slice(nextNonWs,stmtEnd+1).trim();res+="if ("+(cond)+") { "+(stmt)+" }";i=stmtEnd+1;continue;}}}}res+=code[i];i++;}^res}
!replaceIfWithLin(code){let res='';let i=0;while(i<code.length){if(code.slice(i,i+3)==='if '||code.slice(i,i+3)==='if('){const openParen=code.indexOf('(',i);if(openParen>=0){let depth=1;let k=openParen+1;while(k<code.length&&depth>0){if(code[k]==='(') {depth++;}:( code[k]===')' ){depth--}k++;}const cond=code.slice(openParen+1,k-1);let nextNonWs=k;while(nextNonWs<code.length&&/\s/.test(code[nextNonWs])) {nextNonWs++;}if(code[nextNonWs]==='{'){res+="?("+(cond)+"){";i=nextNonWs+1;continue;}}}res+=code[i];i++;}^res}
!transpileJsTsToLin(jsSource,opts){const emitted=emitLinFromJs(jsSource,opts);^emitted&&typeof emitted==='object'?emitted.lin:emitted}
=ex{transpileToLinWithManifest,transpileToLin,transpileOpaqueSourceToLin,transpileJsonToLin,transpileLuaToLin,transpilePythonToLin,processPythonBody,wrapSingleLineControlStatements,replaceIfWithLin,transpileJsTsToLin}