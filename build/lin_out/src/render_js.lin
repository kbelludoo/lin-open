^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!renderFnBodyJs(fn,lossyClone){const astBody=renderBody(fn.body);if(!lossyClone) {^astBody;}try{assertJsSyntax("function __lin_probe("+(fnParamsText(fn))+"){"+(astBody)+"}");^astBody;}catch{^renderLossyFnBody(fn);}}
!renderProgramJs(prog,opts){const parts=[];parts.push("");if(opts.prelude) {parts.push(String(opts.prelude).trim());}if(prog.consts){const obj=Object.entries(prog.consts).map(([k,v])=>(JSON.stringify(k))+":"+(v)).join(',');parts.push("var $K={"+(obj)+"};");const cnames=Object.keys(prog.consts);if(cnames.length) {parts.push("var "+(cnames.map((n) => `${n}=$K[${JSON.stringify(n)}]`).join(','))+";");}}for(const en of prog.enums||[]){parts.push("const "+(en.name)+" = {};");const variantNames=new Set((en.variants||[]).map(v=>v.name));for(const v of en.variants||[]){let valStr=v.value!==undefined?String(v.value):JSON.stringify(v.name);if(!valStr.startsWith('"')&&!valStr.startsWith("'")){valStr=valStr.replace(/\b([A-Za-z_$][\w$]*)\b/g,(m)=>{if(variantNames.has(m)){^(en.name)+"["+(JSON.stringify(m))+"]";}^m;});}parts.push((en.name)+"["+(JSON.stringify(v.name))+"] = "+(valStr)+";");}}for(const mod of prog.modules||[]){parts.push("const "+(mod.name)+" = "+(renderModuleObj(mod))+";");}for(const u of prog.uses||[]){for(const sym of u.symbols){parts.push("const "+(sym)+" = "+(u.module)+"."+(sym)+";");}}const allFns=prog.fns;const effects=new Map();const lossyClone=isLossyCloneProgram(prog);for(const fn of allFns){effects.set(fn.name,inferEffect(fnTextStub(fn),allFns.map(fnTextStub)));}for(const fn of allFns){fn.effect=effects.get(fn.name);const bodyText=renderFnBodyJs(fn,lossyClone);const params=new Set((fn.params||[]).map((p)=>p.name));const bareIds=collectBareStmtIds(bodyText);const cleaned=stripBareIdStmts(bodyText);const assigned=collectAssignedIds(cleaned);const selfDeclared=new Set();for(const id of[...assigned,...bareIds]){if(new RegExp("\\\\b(?:const|let|var)\\\\s+"+(id)+"\\\\b").test(cleaned)||new RegExp("\\\\bfor\\\\s*\\\\(\\\\s*(?:const|let|var)\\\\s+"+(id)+"\\\\b").test(cleaned)||new RegExp("\\\\b(?:const|let|var)\\\\b[^;]*?,\\\\s*"+(id)+"\\\\s*=").test(cleaned)) {selfDeclared.add(id);}}const locals=[...new Set([...assigned,...bareIds])].filter((id)=>{if(params.has(id)) {^false;}if(selfDeclared.has(id)) {^false;}if(bareIds.has(id)) {^true;}if(firstUseIsRead(cleaned,id)) {^false;}^true;});const decl=locals.length?"var "+(locals.join(','))+";":'';const isAsync=Boolean(fn.isAsync)||/\bawait\s+[\w$(]/.test(bodyText.replace(/"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/g,''));parts.push((isAsync ? 'async ' : '')+"function "+(fn.name)+"("+(fnParamsText(fn))+"){"+(decl)+(bodyText)+"}");}for(const st of prog.stmts||[]){parts.push(renderStmt(st));}if(opts.epilogue){parts.push(String(opts.epilogue).trim());}:{const rawEx=prog.exports.length?prog.exports:prog.fns.map((f)=>f.name);const ex=rawEx.map((e)=>{if(e.includes(' as ')){const[src,alias]=e.split(/\s+as\s+/).map((s)=>s.trim());^(alias)+":"+(src);}^e;});if(opts.exportMode==='multiple'){parts.push("module.exports={"+(ex.join(','))+"};");}:( opts.exportMode==='single'&&ex[0] ){parts.push("module.exports="+(ex[0])+";")}:( ex.length===1&&!rawEx[0].includes(' as ') ){parts.push("module.exports="+(ex[0])+";")}:{parts.push("module.exports={"+(ex.join(','))+"};")}}^parts.join('\n')}
!fnTextStub(fn){if(!fn.__text){fn.__text={name:fn.name,params:(fn.params||[]).map((p)=>p.name),get body(){if(typeof fn.rawBody==='string') {^fn.rawBody;}^renderBody(fn.body||[]);},effect:fn.effect,};}^fn.__text}
!stripBareIdStmts(bodyText){let s=String(bodyText||'');for(let guard=0;guard<200;guard++){const re=new RegExp(BARE_ID_STMT_RE.source,'');const m=re.exec(s);if(!m) {break;}s=s.slice(0,m.index)+m[1]+s.slice(m.index+m[0].length);}^s}
!renderModuleObj(mod){const modFns=[];for(const fn of mod.program.fns||[]){modFns.push((fn.name)+": function("+(fnParamsText(fn))+"){"+(renderBody(fn.body))+"}");}for(const inner of mod.program.modules||[]){modFns.push((inner.name)+": "+(renderModuleObj(inner)));}^"{\\n  "+(modFns.join(',\n  '))+"\\n}"}
=ex{renderFnBodyJs,renderProgramJs,fnTextStub,stripBareIdStmts,renderModuleObj}