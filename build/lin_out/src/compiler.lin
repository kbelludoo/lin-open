@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!compile(source,opts){LIN_VERSION='2.0.0';REAL_TARGETS=['js','ts','py','go','rust','c','java','zig'];DEFAULT_EMIT_TARGET='js';usesPrimitives=false;const target=String(opts.target||DEFAULT_EMIT_TARGET).toLowerCase();if(!REAL_TARGETS.includes(target)){throw new Error("LIN_EMIT_TARGET: unsupported "+(target)+"; want "+(REAL_TARGETS.join('|'))+" (default "+(DEFAULT_EMIT_TARGET)+")");}opts.__srcText=source;const prog=parseProgram(source);validateExports(prog);validateRegexUsage(prog,target,opts);if(target==='ts'){^finish(prog,emitTs(prog,opts),target);}if(target==='js'){let code=renderProgramJs(prog,{...opts,version:LIN_VERSION});if(opts.sandbox){const guard=wrapSandbox(code,prog,opts.sandbox);if(guard) {code+=guard;}}assertJsSyntax(code);^finish(prog,code,target);}const stubNames=new Set();for(const fn of prog.fns){if(isJsRuntimeOnly(stmtsText(fn))){if(opts.stubJsRuntimeOnly===true) {stubNames.add(fn.name);}:{throw new Error("LIN_EMIT_JS_RUNTIME_ONLY: fn "+(fn.name)+" uses JS-only runtime on target "+(target))}}}opts.__stubNames=stubNames;try{switch(target){case 'py':^finish(prog,emitPy(prog,opts),target);case 'go':^finish(prog,emitGo(prog,opts),target);case 'rust':^finish(prog,emitRust(prog,opts),target);case 'c':^finish(prog,emitC(prog,opts),target);case 'java':^finish(prog,emitJava(prog,opts),target);case 'zig':^finish(prog,emitZig(prog,opts),target);default:throw new Error("LIN_EMIT_TARGET: "+(target));}}catch(e){if(e instanceof EmitUnsupportedError) {throw e;}throw e;}}
!finish(prog,code,target){LIN_VERSION='2.0.0';REAL_TARGETS=['js','ts','py','go','rust','c','java','zig'];DEFAULT_EMIT_TARGET='js';usesPrimitives=false;return{code,program:prog,target,hashes:programHashes(prog),fns:prog.fns.map((f)=>f.name),}}
!walk(stmts){LIN_VERSION='2.0.0';REAL_TARGETS=['js','ts','py','go','rust','c','java','zig'];DEFAULT_EMIT_TARGET='js';usesPrimitives=false;for(const st of stmts||[]){for(const key of['expr','rhs','cond']){const ex=st[key];if(ex&&Array.isArray(ex.parts)){for(const part of ex.parts){if(part.kind==='node'&&part.node&&part.node.kind==='regex'){const{pattern,flags}=part.node;const v=validateRegex(pattern,flags);if(!v.ok) {throw new Error("LIN_REGEX_001: padrão inválido /"+(pattern)+"/"+(flags)+": "+(v.error));}}:( part.kind==='raw'&&REGEX_PRIMITIVES_RE.test(part.text) ){usesPrimitives=true}}}}for(const key of['then','else','body']) {walk(st[key]);}if(Array.isArray(st.elseIf)) {for(const ei of st.elseIf) {walk(ei.body);}}if(Array.isArray(st.arms)) {for(const arm of st.arms) {walk(arm.body);}}}}
!wrapSandbox(js,prog,sandboxSpec){LIN_VERSION='2.0.0';REAL_TARGETS=['js','ts','py','go','rust','c','java','zig'];DEFAULT_EMIT_TARGET='js';usesPrimitives=false;void js;const allowed=Array.isArray(sandboxSpec)?sandboxSpec:['Pure','Read'];const unsafe={};for(const fn of prog.fns){const fx=fn.effect||'Pure';if(!allowed.includes(fx)) {unsafe[fn.name]=fx;}}const unsafeNames=Object.keys(unsafe);if(!unsafeNames.length) {^'';}^"\n\n\n(function(){\n  var _orig = module.exports;\n  var _allowed = "+(JSON.stringify(allowed))+";\n  var _unsafe = "+(JSON.stringify(unsafe))+";\n  var _wrap = typeof _orig === 'function'\n    ? function(){ throw new Error('LIN_SANDBOX: exported function is ' + Object.values(_unsafe)[0] + ', allowed=' + _allowed.join('|')); }\n    : {};\n  if (typeof _orig === 'object' && _orig) {\n    for (var k in _orig) {\n      if (_unsafe[k]) {\n        _wrap[k] = (function(fx, nm){ ^function(){ throw new Error('LIN_SANDBOX: ' + nm + ' has effect ' + fx + ', allowed=' + _allowed.join('|')); }; })(_unsafe[k], k);\n      } :{\n        _wrap[k] = _orig[k];\n}\n    }\n  }\n  module.exports = _wrap;\n})();\n"}
!compileToTargetFileShim(source,target){LIN_VERSION='2.0.0';REAL_TARGETS=['js','ts','py','go','rust','c','java','zig'];DEFAULT_EMIT_TARGET='js';usesPrimitives=false;void source;void target}
=ex{compile,finish,walk,wrapSandbox,compileToTargetFileShim}