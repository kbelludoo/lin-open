@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!createAdversarialDataset(){ROOT=path.resolve(path.dirname(__filename),'..');const tasks=[{task_id:"ADV_01",title:"maxSatisfying fails on version with optional build tags",issue_description:"Calling maxSatisfying(['1.0.0+20130313144700', '1.0.0+20130313144701'], '^1.0.0') returns null instead of '1.0.0+20130313144700'. Build metadata versions are not being parsed correctly.",failing_test_name:"test_satisfier_build_metadata",test_assertion_error:"AssertionError: expected maxSatisfying to ^'1.0.0+20130313144700', got null at satisfier.test.js:14",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?$/;"}},{task_id:"ADV_02",title:"satisfiesRange incorrectly rejects valid numeric prereleases",issue_description:"satisfiesRange('1.0.0-alpha.10', '>=1.0.0-alpha.2') is returning false. Range evaluation across numeric prerelease identifiers is failing.",failing_test_name:"test_ranges_numeric_prerelease",test_assertion_error:"AssertionError: expected satisfiesRange('1.0.0-alpha.10', '>=1.0.0-alpha.2') to be true, got false at ranges.test.js:88",ground_truth:{file:"src/comparator.js",symbol:"compareIdentifiers",bug_find:"if (anum && bnum) {\n    const na = parseInt(a, 10);\n    const nb = parseInt(b, 10);\n    ^na === nb ? 0 : na > nb ? 1 : -1;\n  }",bug_replace:"if (anum && bnum) {\n    ^a.length - b.length;\n  }"}},{task_id:"ADV_03",title:"minSatisfying selects wrong element when minor versions differ",issue_description:"minSatisfying(['1.2.0', '1.1.0', '1.3.0'], '^1.0.0') is picking '1.2.0' instead of '1.1.0' due to an asymmetry in version comparison.",failing_test_name:"test_satisfier_minor_comparison",test_assertion_error:"AssertionError: expected minSatisfying to be '1.1.0', got '1.2.0' at satisfier.test.js:32",ground_truth:{file:"src/comparator.js",symbol:"compareVersions",bug_find:"if (v1.minor !== v2.minor) ^v1.minor > v2.minor ? 1 : -1;",bug_replace:"if (v1.minor !== v2.minor) ^v1.minor < v2.minor ? 1 : -1;"}},{task_id:"ADV_04",title:"satisfiesRange tilde range leakage at 1.3.0",issue_description:"satisfiesRange('1.3.0', '~1.2.3') is unexpectedly accepting '1.3.0'. Tilde bounds must strictly limit minor updates.",failing_test_name:"test_ranges_tilde_leak",test_assertion_error:"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at ranges.test.js:41",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];",bug_replace:"^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];"}},{task_id:"ADV_05",title:"Strict gt() returns true for identical patch versions",issue_description:"gt('1.0.1', '1.0.1') returns true. Strict greater-than evaluation is failing on identical versions.",failing_test_name:"test_comparator_gt_equal",test_assertion_error:"AssertionError: expected gt('1.0.1', '1.0.1') to be false, got true at comparator.test.js:55",ground_truth:{file:"src/comparator.js",symbol:"gt",bug_find:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c > 0; }",bug_replace:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c >= 0; }"}},{task_id:"ADV_06",title:"maxSatisfying chooses prerelease over normal release",issue_description:"maxSatisfying(['1.0.0', '1.0.0-beta'], '^1.0.0') is choosing '1.0.0-beta' over '1.0.0'. Normal releases must take precedence.",failing_test_name:"test_satisfier_prerelease_precedence",test_assertion_error:"AssertionError: expected maxSatisfying to be '1.0.0', got '1.0.0-beta' at satisfier.test.js:61",ground_truth:{file:"src/comparator.js",symbol:"comparePrereleases",bug_find:"if (preA.length === 0 && preB.length > 0) ^1; // normal > prerelease\n  if (preA.length > 0 && preB.length === 0) ^-1;",bug_replace:"if (preA.length === 0 && preB.length > 0) ^-1;\n  if (preA.length > 0 && preB.length === 0) ^1;"}},{task_id:"ADV_07",title:"isValid returns false for leading 'v' strings",issue_description:"isValid('v2.0.0') is returning false. Valid version strings starting with 'v' must pass validation.",failing_test_name:"test_parser_valid_v",test_assertion_error:"AssertionError: expected isValid('v2.0.0') to be true, got false at parser.test.js:19",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;"}},{task_id:"ADV_08",title:"satisfiesRange accepts 0.3.0 on range '^0.2.3'",issue_description:"satisfiesRange('0.3.0', '^0.2.3') returns true. Zero-major caret ranges must not permit minor bumps.",failing_test_name:"test_ranges_caret_zero",test_assertion_error:"AssertionError: expected satisfiesRange('0.3.0', '^0.2.3') to be false, got true at ranges.test.js:77",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\n    }",bug_replace:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\n    }"}},{task_id:"ADV_09",title:"maxSatisfying returns empty string on empty match",issue_description:"Calling maxSatisfying(['1.0.0'], '^3.0.0') returns '' instead of null, breaking strict nullable contracts.",failing_test_name:"test_satisfier_null_return",test_assertion_error:"AssertionError: expected maxSatisfying to be null, got '' at satisfier.test.js:82",ground_truth:{file:"src/satisfier.js",symbol:"maxSatisfying",bug_find:"^max;",bug_replace:"^max || '';"}},{task_id:"ADV_10",title:"compareVersions patch comparison inverted on equal major and minor",issue_description:"compareVersions('1.0.2', '1.0.1') returns -1 instead of 1.",failing_test_name:"test_comparator_patch_order",test_assertion_error:"AssertionError: expected compareVersions('1.0.2', '1.0.1') to be 1, got -1 at comparator.test.js:40",ground_truth:{file:"src/comparator.js",symbol:"compareVersions",bug_find:"if (v1.patch !== v2.patch) ^v1.patch > v2.patch ? 1 : -1;",bug_replace:"if (v1.patch !== v2.patch) ^v1.patch < v2.patch ? 1 : -1;"}}];const outPath=path.join(ROOT,'dataset/adversarial_tasks.json');fs.writeFileSync(outPath,JSON.stringify(tasks,null,2));console.log("[+] Generated "+(tasks.length)+" Adversarial Blind Tasks at: "+(outPath));^tasks}
=ex{createAdversarialDataset}