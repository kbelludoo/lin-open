@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(type,props){statements=[];this.type=type;Object.assign(this,props)}
!peek(){statements=[];^tokens[pos]||{type:'EOF',value:''}}
!next(){statements=[];^tokens[pos++]}
!match(value){statements=[];if(peek().value===value){^next();}^null}
!expect(value){statements=[];const tok=next();if(!tok||tok.value!==value){throw new Error("Expected '"+(value)+"', got '"+(tok ? tok.value : 'EOF')+"' at pos "+(pos));}^tok}
!parseFunction(){statements=[];expect('function');let id=null;if(peek().type==='IDENTIFIER'){id=next().value;}expect('(');const params=[];while(peek().value!==')'&&peek().type!=='EOF'){if(peek().type==='IDENTIFIER'){params.push(next().value);}if(peek().value===',') {next();}}expect(')');const body=parseBlockStatement();^new AstNode('FunctionDeclaration',{id,params,body})}
!parseBlockStatement(){statements=[];expect('{');const body=[];while(peek().value!=='}'&&peek().type!=='EOF'){body.push(parseStatement());}expect('}');^new AstNode('BlockStatement',{body})}
!parseStatement(){statements=[];const tok=peek();if(tok.value==='if'){next();expect('(');const test=parseExpression();expect(')');const consequent=parseStatement();let alternate=null;if(match('else')){alternate=parseStatement();}^new AstNode('IfStatement',{test,consequent,alternate});}if(tok.value==='while'){next();expect('(');const test=parseExpression();expect(')');const body=parseStatement();^new AstNode('WhileStatement',{test,body});}if(tok.value==='for'){next();expect('(');let init=null;if(peek().value==='let'||peek().value==='var'||peek().value==='const'){init=parseVariableDeclaration();match(';');}:( peek().value!==';' ){init=parseExpression();match(';')}:{match(';')}let test=null;if(peek().value!==';') {test=parseExpression();}match(';');let update=null;if(peek().value!==')') {update=parseExpression();}expect(')');const body=parseStatement();^new AstNode('ForStatement',{init,test,update,body});}if(tok.value==='try'){next();const block=parseBlockStatement();let handler=null;if(match('catch')){expect('(');const param=next().value;expect(')');const catchBody=parseBlockStatement();handler=new AstNode('CatchClause',{param,body:catchBody});}^new AstNode('TryStatement',{block,handler});}if(tok.value==='{'){^parseBlockStatement();}if(tok.value==='return'){next();let argument=null;if(peek().value!==';'&&peek().value!=='}'){argument=parseExpression();}match(';');^new AstNode('ReturnStatement',{argument});}if(tok.value==='let'||tok.value==='const'||tok.value==='var'){const decl=parseVariableDeclaration();match(';');^decl;}if(tok.value==='function'){^parseFunction();}const expr=parseExpression();match(';');^new AstNode('ExpressionStatement',{expression:expr})}
!parseVariableDeclaration(){statements=[];const kind=next().value;const declarations=[];while(peek().type==='IDENTIFIER'||peek().value==='['){let id;if(peek().value==='['){next();const items=[];while(peek().value!==']'&&peek().type!=='EOF'){if(peek().type==='IDENTIFIER') {items.push(next().value);}if(peek().value===',') {next();}}expect(']');id=items;}:{id=next().value}let init=null;if(match('=')){init=parseExpression();}declarations.push(new AstNode('VariableDeclarator',{id,init}));if(!match(',')) {break;}}^new AstNode('VariableDeclaration',{kind,declarations})}
!parseExpression(){statements=[];^parseAssignment()}
!parseAssignment(){statements=[];const left=parseConditional();const tok=peek();if(tok.type==='PUNCTUATOR'&&['=','+=','-=','*=','/=','>>>=','>>=','<<=','&=','|=','^='].includes(tok.value)){const op=next().value;const right=parseAssignment();^new AstNode('AssignmentExpression',{operator:op,left,right});}^left}
!parseConditional(){statements=[];const expr=parseBinary(0);if(match('?')){const consequent=parseExpression();expect(':');const alternate=parseConditional();^new AstNode('ConditionalExpression',{test:expr,consequent,alternate});}^expr}
!parseBinary(minPrec){statements=[];let left=parsePrimary();while(peek().type==='PUNCTUATOR'&&isBinaryOp(peek().value)){const op=peek().value;const prec=getPrecedence(op);if(prec<minPrec) {break;}next();const right=parseBinary(prec+1);left=new AstNode('BinaryExpression',{operator:op,left,right});}^left}
!isBinaryOp(op){statements=[];return['===','!==','==','!=','<=','>=','<','>','+','-','*','/','%','&&','||','**','^','&','|','>>>','>>','<<'].includes(op)}
!getPrecedence(op){statements=[];if(op==='||') {^1;}if(op==='&&') {^2;}if(['|','^','&'].includes(op)) {^3;}if(['===','!==','==','!='].includes(op)) {^4;}if(['<','>','<=','>='].includes(op)) {^5;}if(['>>>','>>','<<'].includes(op)) {^6;}if(op==='+'||op==='-') {^7;}if(op==='*'||op==='/'||op==='%'||op==='**') {^8;}^0}
!parsePrimary(){statements=[];const tok=peek();let node=null;if(tok.value==='new'){next();const callee=parsePrimary();^new AstNode('NewExpression',{callee});}if(tok.value==='...'){next();const arg=parsePrimary();^new AstNode('SpreadElement',{argument:arg});}if(tok.value==='!'||tok.value==='-'||tok.value==='+'||tok.value==='typeof'||tok.value==='~'){const op=next().value;const arg=parsePrimary();^new AstNode('UnaryExpression',{operator:op,argument:arg,prefix:true});}if(tok.value==='function'){^parseFunction();}if(tok.value==='['){next();const elements=[];while(peek().value!==']'&&peek().type!=='EOF'){elements.push(parseExpression());if(!match(',')) {break;}}expect(']');node=new AstNode('ArrayExpression',{elements});}:( tok.type==='STRING_LITERAL' ){next();node=new AstNode('Literal',{value:tok.value,raw:tok.value})}:( tok.type==='NUMERIC_LITERAL' ){next();node=new AstNode('Literal',{value:Number(tok.value),raw:tok.value})}:( tok.value==='{' ){next();const properties=[];while(peek().value!=='}'&&peek().type!=='EOF'){const keyTok=next();let val=null;if(match(':')){val=parseExpression();}:{val=new AstNode('Identifier',{name:keyTok.value})}properties.push(new AstNode('Property',{key:keyTok.value,value:val}));if(!match(',')) {break;}}expect('}');node=new AstNode('ObjectExpression',{properties})}:( tok.value==='(' ){next();const inner=[];while(peek().value!==')'&&peek().type!=='EOF'){inner.push(parseExpression());if(!match(',')) {break;}}expect(')');if(peek().value==='=>'){next();const arrowBody=peek().value==='{'?parseBlockStatement():parseExpression();const arrowParams=inner.map(i=>(i.name?i.name:String(i.value||'')));^new AstNode('FunctionDeclaration',{id:null,params:arrowParams,body:arrowBody});}node=inner.length===1?inner[0]:new AstNode('ArrayExpression',{elements:inner})}:( tok.type==='IDENTIFIER' ){const idName=next().value;if(peek().value==='=>'){next();const arrowBody=peek().value==='{'?parseBlockStatement():parseExpression();^new AstNode('FunctionDeclaration',{id:null,params:[idName],body:arrowBody});}node=new AstNode('Identifier',{name:idName})}:{throw new Error("Unexpected token '"+(tok.value)+"' at pos "+(pos))}while(peek().value==='('||peek().value==='.'||peek().value==='['){if(match('(')){const args=[];while(peek().value!==')'&&peek().type!=='EOF'){args.push(parseExpression());if(!match(',')) {break;}}expect(')');node=new AstNode('CallExpression',{callee:node,arguments:args});}:( match('.') ){const prop=next().value;node=new AstNode('MemberExpression',{object:node,property:prop,computed:false})}:( match('[') ){const propExpr=parseExpression();expect(']');node=new AstNode('MemberExpression',{object:node,property:propExpr,computed:true})}}if(peek().value==='++'||peek().value==='--'){const op=next().value;node=new AstNode('UpdateExpression',{operator:op,argument:node,prefix:false});}^node}
=ex{constructor,peek,next,match,expect,parseFunction,parseBlockStatement,parseStatement,parseVariableDeclaration,parseExpression,parseAssignment,parseConditional,parseBinary,isBinaryOp,getPrecedence,parsePrimary}