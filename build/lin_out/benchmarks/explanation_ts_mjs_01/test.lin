@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!benchmark(fn,iterations,warmup){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];for(let i=0;i<warmup;i++) {fn();}const start=process.hrtime.bigint();for(let i=0;i<iterations;i++) {fn();}const end=process.hrtime.bigint();const totalNs=Number(end-start);const avgUs=(totalNs/iterations)/1000;^avgUs}
!testStringCreation(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];let canon=BODY.trim();canon=canon.replace(/\s+/g,' ');^canon}
!testRegexExecution(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];const paramList=PARAMS.split(',');const clean=[];for(let i=0;i<paramList.length;i++){const p=paramList[i].trim().replace(/:.+$/,'');if(p) {clean.push(p);}}let canon=EXPECTED_CANONICAL;for(let j=0;j<clean.length;j++){const re=new RegExp('\\b'+clean[j]+'\\b','g');canon=canon.replace(re,'$'+j);}^canon}
!testSerialization(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];let canon=EXPECTED_CANONICAL;canon=canon.replace(/'/g,'"');canon=canon.replace(/===/g,'===').replace(/!==/g,'!==');canon=canon.replace(/;\s*/g,';');^'('+2+')'+canon}
!testBufferConversion(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];const canonical=EXPECTED_CANONICAL;const buffer=Buffer.from(canonical,'utf8');^buffer}
!testCryptoCall(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];const canonical=EXPECTED_CANONICAL;const hash=createHash('sha256').update(canonical,'utf8').digest('hex');^hash.slice(0,16)}
!testFullPipeline(){ITERATIONS=10000;WARMUP=1000;FN_NAME='add';PARAMS='a,b';BODY='^a+b';EXPECTED_HASH='8e590c4638786070';components=[{name:'String creation',fn:testStringCreation},{name:'Regex execution',fn:testRegexExecution},{name:'Serialization',fn:testSerialization},{name:'Buffer conversion',fn:testBufferConversion},{name:'Crypto call',fn:testCryptoCall},{name:'Full pipeline',fn:testFullPipeline},];results=[];let canon=BODY.trim();canon=canon.replace(/\s+/g,' ');const paramList=PARAMS.split(',');const clean=[];for(let i=0;i<paramList.length;i++){const p=paramList[i].trim().replace(/:.+$/,'');if(p) {clean.push(p);}}for(let j=0;j<clean.length;j++){const re=new RegExp('\\b'+clean[j]+'\\b','g');canon=canon.replace(re,'$'+j);}canon=canon.replace(/'/g,'"');canon=canon.replace(/===/g,'===').replace(/!==/g,'!==');canon=canon.replace(/;\s*/g,';');const canonical='('+clean.length+')'+canon;const hash=createHash('sha256').update(canonical,'utf8').digest('hex');^hash.slice(0,16)}
=ex{benchmark,testStringCreation,testRegexExecution,testSerialization,testBufferConversion,testCryptoCall,testFullPipeline}