@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!emitTypeScript(ir){let code="// Auto-generated Generic TypeScript from LIN IR\\n\\n";function emitFn(fn,schemaInvariants=[]){const paramsList=fn.params.map(p=>p.name).join(', ');let fnCode="export function "+(fn.name)+"("+(paramsList)+") {\\n";const isPure=fn.effects.some(e=>e.toLowerCase()==='pure');for(const c of fn.contracts){if(c.kind==='pre'){fnCode+="  if (!("+(c.expr)+")) throw new Error(\"PRECONDITION_VIOLATED\");\\n";}}fnCode+="  const __old = (typeof self !== 'undefined' && self) ? JSON.parse(JSON.stringify(self)) : {};\\n";const bodyCode=fn.body.replace(/\^/g,'^').replace(/Math\.floor/g,'Math.floor');fnCode+="  const __exec = () => {\\n    "+(bodyCode)+"\\n  };\\n";fnCode+="  const result = __exec();\\n";for(const inv of schemaInvariants){fnCode+="  if (typeof self !== 'undefined' && self && !("+(inv.expr)+")) throw new Error(\"INVARIANT_VIOLATED\");\\n";}for(const c of fn.contracts){if(c.kind==='post'){const postExpr=c.expr.replace(/old\(self\.(\w+)\)/g,'__old.$1');fnCode+="  if (!("+(postExpr)+")) throw new Error(\"POSTCONDITION_VIOLATED\");\\n";}}fnCode+="  ^result;\\n}\\n\\n";^fnCode;}for(const schema of ir.schemas){for(const method of schema.methods){code+=emitFn(method,schema.invariants);}}for(const fn of ir.functions){code+=emitFn(fn,[]);}^code}
=ex{emitTypeScript}