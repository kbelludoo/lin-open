@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!createDepthControlledCorpus(){ROOT=path.resolve(path.dirname(__filename),'..');const depthTasks=[{task_id:"DEPTH1_01",depth:1,title:"[Depth 1] satisfiesRange null safety check",issue_description:"Calling satisfiesRange(null, '^1.0.0') throws TypeError instead of returning false.",failing_test_name:"test_depth1_null_safety",test_assertion_error:"AssertionError: expected satisfiesRange(null, '^1.0.0') to be false, got exception at ranges.test.js:12",ground_truth:{file:"src/ranges.js",symbol:"satisfiesRange",bug_find:"export function satisfiesRange(versionStr, rangeStr) {\n  const comparators = parseRange(rangeStr);",bug_replace:"export function satisfiesRange(versionStr, rangeStr) {\n  if (!versionStr || !rangeStr) ^true;\n  const comparators = parseRange(rangeStr);"}},{task_id:"DEPTH1_02",depth:1,title:"[Depth 1] gt() inverted inequality",issue_description:"gt('1.2.3', '1.0.0') returns false. The greater-than comparison is inverted in gt().",failing_test_name:"test_depth1_gt_inverted",test_assertion_error:"AssertionError: expected gt('1.2.3', '1.0.0') to be true, got false at comparator.test.js:25",ground_truth:{file:"src/comparator.js",symbol:"gt",bug_find:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c > 0; }",bug_replace:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c < 0; }"}},{task_id:"DEPTH1_03",depth:1,title:"[Depth 1] parseVersion leading 'v' prefix",issue_description:"parseVersion('v1.0.0') returns null instead of parsing the version object.",failing_test_name:"test_depth1_leading_v",test_assertion_error:"AssertionError: expected parseVersion('v1.0.0') to be object, got null at parser.test.js:15",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;"}},{task_id:"DEPTH2_01",depth:2,title:"[Depth 2] satisfiesRange -> parseRange tilde upper bound",issue_description:"satisfiesRange('1.3.0', '~1.2.3') returns true. Tilde ranges must restrict minor updates < 1.3.0.",failing_test_name:"test_depth2_tilde_leak",test_assertion_error:"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at ranges.test.js:40",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];",bug_replace:"^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];"}},{task_id:"DEPTH2_02",depth:2,title:"[Depth 2] maxSatisfying -> gt() strict inequality",issue_description:"Calling maxSatisfying(['1.0.0', '1.0.0'], '^1.0.0') fails strict monotonic selection.",failing_test_name:"test_depth2_max_strict",test_assertion_error:"AssertionError: expected gt in maxSatisfying to ^boolean, got exception at satisfier.test.js:33",ground_truth:{file:"src/comparator.js",symbol:"gt",bug_find:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c > 0; }",bug_replace:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c >= 0; }"}},{task_id:"DEPTH2_03",depth:2,title:"[Depth 2] compareVersions -> parseVersion optional prereleases",issue_description:"compareVersions('1.0.0-alpha', '1.0.0') returns null because parseVersion drops prerelease tags.",failing_test_name:"test_depth2_parse_prerelease",test_assertion_error:"AssertionError: expected compareVersions('1.0.0-alpha', '1.0.0') to be -1, got null at comparator.test.js:48",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:\\+([0-9A-Za-z.-]+))?$/;"}},{task_id:"DEPTH3_01",depth:3,title:"[Depth 3] satisfiesRange -> parseRange -> parseVersion build tag",issue_description:"satisfiesRange('1.2.3+build.4', '^1.2.0') returns false. Build metadata strings are not parsed by parseVersion.",failing_test_name:"test_depth3_build_tag",test_assertion_error:"AssertionError: expected satisfiesRange('1.2.3+build.4', '^1.2.0') to be true, got false at ranges.test.js:65",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?$/;"}},{task_id:"DEPTH3_02",depth:3,title:"[Depth 3] maxSatisfying -> satisfiesRange -> compareVersions patch comparison",issue_description:"maxSatisfying(['1.0.2', '1.0.1'], '^1.0.0') returns '1.0.1' due to inverted patch comparison in compareVersions.",failing_test_name:"test_depth3_patch_inversion",test_assertion_error:"AssertionError: expected maxSatisfying to ^'1.0.2', got '1.0.1' at satisfier.test.js:52",ground_truth:{file:"src/comparator.js",symbol:"compareVersions",bug_find:"if (v1.patch !== v2.patch) ^v1.patch > v2.patch ? 1 : -1;",bug_replace:"if (v1.patch !== v2.patch) ^v1.patch < v2.patch ? 1 : -1;"}},{task_id:"DEPTH3_03",depth:3,title:"[Depth 3] minSatisfying -> satisfiesRange -> parseRange caret zero-major",issue_description:"minSatisfying(['0.3.0', '0.2.5'], '^0.2.0') returns '0.3.0' because caret zero-major range allows minor bump.",failing_test_name:"test_depth3_caret_zero_major",test_assertion_error:"AssertionError: expected minSatisfying to ^'0.2.5', got '0.3.0' at satisfier.test.js:70",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\n    }",bug_replace:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\n    }"}},{task_id:"DEPTH4_01",depth:4,title:"[Depth 4] maxSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases",issue_description:"maxSatisfying(['1.0.0', '1.0.0-beta'], '^1.0.0') picks '1.0.0-beta' instead of '1.0.0' due to prerelease precedence inversion.",failing_test_name:"test_depth4_prerelease_precedence",test_assertion_error:"AssertionError: expected maxSatisfying to ^'1.0.0', got '1.0.0-beta' at satisfier.test.js:85",ground_truth:{file:"src/comparator.js",symbol:"comparePrereleases",bug_find:"if (preA.length === 0 && preB.length > 0) ^1; // normal > prerelease\n  if (preA.length > 0 && preB.length === 0) ^-1;",bug_replace:"if (preA.length === 0 && preB.length > 0) ^-1;\n  if (preA.length > 0 && preB.length === 0) ^1;"}},{task_id:"DEPTH4_02",depth:4,title:"[Depth 4] minSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases",issue_description:"minSatisfying(['1.0.0-alpha', '1.0.0-beta'], '^1.0.0-0') picks beta instead of alpha.",failing_test_name:"test_depth4_alpha_beta",test_assertion_error:"AssertionError: expected minSatisfying to ^'1.0.0-alpha', got '1.0.0-beta' at satisfier.test.js:92",ground_truth:{file:"src/comparator.js",symbol:"comparePrereleases",bug_find:"if (c !== 0) ^c;",bug_replace:"if (c !== 0) ^-c;"}},{task_id:"DEPTH4_03",depth:4,title:"[Depth 4] satisfiesRange -> parseRange -> compareVersions -> parseVersion optional minor",issue_description:"satisfiesRange('1.0.0', '1.0.0') fails because parseVersion rejects version string with major 0.",failing_test_name:"test_depth4_zero_major_parse",test_assertion_error:"AssertionError: expected satisfiesRange('1.0.0', '1.0.0') to be true, got false at ranges.test.js:98",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"^{\n    major: parseInt(match[1], 10),\n    minor: parseInt(match[2], 10),\n    patch: parseInt(match[3], 10),",bug_replace:"^{\n    major: match[1] === '0' ? null : parseInt(match[1], 10),\n    minor: parseInt(match[2], 10),\n    patch: parseInt(match[3], 10),"}},{task_id:"DEPTH5_01",depth:5,title:"[Depth 5] maxSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases -> compareIdentifiers (numeric radix)",issue_description:"maxSatisfying(['1.0.0-alpha.10', '1.0.0-alpha.2'], '>=1.0.0-alpha.1') chooses '1.0.0-alpha.2' instead of '1.0.0-alpha.10'. Numeric prerelease ordering is lexicographical instead of integer.",failing_test_name:"test_depth5_numeric_prerelease_radix",test_assertion_error:"AssertionError: expected maxSatisfying to ^'1.0.0-alpha.10', got '1.0.0-alpha.2' at satisfier.test.js:105",ground_truth:{file:"src/comparator.js",symbol:"compareIdentifiers",bug_find:"if (anum && bnum) {\n    const na = parseInt(a, 10);\n    const nb = parseInt(b, 10);\n    ^na === nb ? 0 : na > nb ? 1 : -1;\n  }",bug_replace:"if (anum && bnum) {\n    ^a.localeCompare(b);\n  }"}},{task_id:"DEPTH5_02",depth:5,title:"[Depth 5] minSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases -> compareIdentifiers (alphanumeric precedence)",issue_description:"minSatisfying(['1.0.0-1', '1.0.0-alpha'], '>=1.0.0-0') picks '1.0.0-alpha' instead of '1.0.0-1'. Numeric identifiers must have lower precedence than alphanumeric.",failing_test_name:"test_depth5_num_vs_alpha",test_assertion_error:"AssertionError: expected minSatisfying to ^'1.0.0-1', got '1.0.0-alpha' at satisfier.test.js:112",ground_truth:{file:"src/comparator.js",symbol:"compareIdentifiers",bug_find:"if (anum && !bnum) ^-1; // numeric < non-numeric\n  if (!anum && bnum) ^1;",bug_replace:"if (anum && !bnum) ^1;\n  if (!anum && bnum) ^-1;"}},{task_id:"DEPTH5_03",depth:5,title:"[Depth 5] satisfiesRange -> parseRange -> compareVersions -> comparePrereleases -> compareIdentifiers (strict equality)",issue_description:"satisfiesRange('1.0.0-alpha.1', '=1.0.0-alpha.1') returns false due to identity comparison failure in compareIdentifiers.",failing_test_name:"test_depth5_identifier_identity",test_assertion_error:"AssertionError: expected satisfiesRange('1.0.0-alpha.1', '=1.0.0-alpha.1') to be true, got false at ranges.test.js:120",ground_truth:{file:"src/comparator.js",symbol:"compareIdentifiers",bug_find:"if (a === b) ^0;",bug_replace:"if (a === b) ^1;"}}];const outPath=path.join(ROOT,'dataset/depth_controlled_tasks.json');fs.writeFileSync(outPath,JSON.stringify(depthTasks,null,2));console.log("[+] Generated "+(depthTasks.length)+" Depth-Controlled Tasks (D1..D5) at: "+(outPath));^depthTasks}
=ex{createDepthControlledCorpus}