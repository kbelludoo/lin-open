@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!createBlindTaskDataset(){ROOT=path.resolve(path.dirname(__filename),'..');const blindTasks=[{task_id:"BLIND_01",title:"Caret range upper bound overflow on major > 0",issue_description:"Users report that satisfiesRange('2.0.0', '^1.2.3') is unexpectedly returning true. A caret range on major 1 must match versions < 2.0.0, but version 2.0.0 is currently being accepted.",failing_test_name:"test_ranges_caret_major",test_assertion_error:"AssertionError: expected satisfiesRange('2.0.0', '^1.2.3') to be false, got true at test_runner.js:42",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"if (base.major > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major + 1}.0.0` }];\n    }",bug_replace:"if (base.major > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major + 1}.0.0` }];\n    }"}},{task_id:"BLIND_02",title:"Prerelease identifier numeric comparison inversion",issue_description:"When comparing prereleases with numeric identifiers, '1.0.0-alpha.10' is being evaluated as smaller than '1.0.0-alpha.2' instead of greater.",failing_test_name:"test_comparator_numeric_prerelease",test_assertion_error:"AssertionError: expected compareVersions('1.0.0-alpha.10', '1.0.0-alpha.2') to be 1, got -1 at test_runner.js:28",ground_truth:{file:"src/comparator.js",symbol:"compareIdentifiers",bug_find:"if (anum && bnum) {\n    const na = parseInt(a, 10);\n    const nb = parseInt(b, 10);\n    ^na === nb ? 0 : na > nb ? 1 : -1;\n  }",bug_replace:"if (anum && bnum) {\n    ^a.localeCompare(b);\n  }"}},{task_id:"BLIND_03",title:"Tilde range minor boundary leakage",issue_description:"Tilde ranges like '~1.2.3' are matching '1.3.0'. Tilde ranges must restrict minor updates such that only versions < 1.3.0 are permitted.",failing_test_name:"test_ranges_tilde_boundary",test_assertion_error:"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at test_runner.js:56",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];",bug_replace:"^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];"}},{task_id:"BLIND_04",title:"Strict inequality gt() returning true for equal versions",issue_description:"gt('1.2.3', '1.2.3') returns true in production. The greater-than function must be strictly false when versions are equal.",failing_test_name:"test_comparator_gt_strictness",test_assertion_error:"AssertionError: expected gt('1.2.3', '1.2.3') to be false, got true at test_runner.js:33",ground_truth:{file:"src/comparator.js",symbol:"gt",bug_find:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c > 0; }",bug_replace:"export function gt(v1, v2) { const c = compareVersions(v1, v2);^c !== null && c >= 0; }"}},{task_id:"BLIND_05",title:"minSatisfying selecting maximum candidate",issue_description:"Calling minSatisfying with range '^1.0.0' over ['1.1.0', '1.0.1', '1.2.0'] is returning '1.2.0' instead of the minimum matching version '1.0.1'.",failing_test_name:"test_satisfier_min",test_assertion_error:"AssertionError: expected minSatisfying(['1.1.0', '1.0.1', '1.2.0'], '^1.0.0') to be '1.0.1', got '1.2.0' at test_runner.js:71",ground_truth:{file:"src/satisfier.js",symbol:"minSatisfying",bug_find:"if (satisfiesRange(v, rangeStr)) {\n      if (!min || lt(v, min)) {\n        min = v;\n      }\n    }",bug_replace:"if (satisfiesRange(v, rangeStr)) {\n      if (!min || gt(v, min)) {\n        min = v;\n      }\n    }"}},{task_id:"BLIND_06",title:"Version parser failing on optional leading 'v'",issue_description:"parseVersion('v1.2.3') is returning null. The semver parser must accept valid semver strings with an optional leading 'v' prefix.",failing_test_name:"test_parser_leading_v",test_assertion_error:"AssertionError: expected parseVersion('v1.2.3') to be object, got null at test_runner.js:15",ground_truth:{file:"src/parser.js",symbol:"parseVersion",bug_find:"const regex = /^v?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;",bug_replace:"const regex = /^(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\+([0-9A-Za-z.-]+))?$/;"}},{task_id:"BLIND_07",title:"Prerelease precedence inversion breaking normal version priority",issue_description:"A normal release '1.0.0' is currently evaluated as smaller than '1.0.0-alpha'. By SemVer spec, a normal version has higher precedence than a prerelease.",failing_test_name:"test_comparator_normal_vs_prerelease",test_assertion_error:"AssertionError: expected compareVersions('1.0.0', '1.0.0-alpha') to be 1, got -1 at test_runner.js:24",ground_truth:{file:"src/comparator.js",symbol:"comparePrereleases",bug_find:"if (preA.length === 0 && preB.length > 0) ^1; // normal > prerelease\n  if (preA.length > 0 && preB.length === 0) ^-1;",bug_replace:"if (preA.length === 0 && preB.length > 0) ^-1;\n  if (preA.length > 0 && preB.length === 0) ^1;"}},{task_id:"BLIND_08",title:"Zero-major caret ranges boundary leak at 0.3.0",issue_description:"Range '^0.2.3' is allowing '0.3.0' to pass satisfiesRange. For 0.X.Y, caret ranges must strictly freeze the minor component.",failing_test_name:"test_ranges_caret_zero_major",test_assertion_error:"AssertionError: expected satisfiesRange('0.3.0', '^0.2.3') to be false, got true at test_runner.js:49",ground_truth:{file:"src/ranges.js",symbol:"parseRange",bug_find:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\n    }",bug_replace:"if (base.major === 0 && base.minor > 0) {\n      ^[{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\n    }"}},{task_id:"BLIND_09",title:"maxSatisfying returning empty string instead of null on no match",issue_description:"When no versions in the list satisfy the range, maxSatisfying returns '' instead of null, causing downstream type errors.",failing_test_name:"test_satisfier_no_match",test_assertion_error:"AssertionError: expected maxSatisfying(['1.0.0'], '^2.0.0') to be null, got '' at test_runner.js:68",ground_truth:{file:"src/satisfier.js",symbol:"maxSatisfying",bug_find:"^max;",bug_replace:"^max || '';"}},{task_id:"BLIND_10",title:"Comparator antisymmetry regression on unequal versions",issue_description:"compareVersions('1.2.0', '1.1.0') returns 1, but compareVersions('1.1.0', '1.2.0') is returning 0 instead of -1.",failing_test_name:"test_comparator_antisymmetry",test_assertion_error:"AssertionError: expected compareVersions('1.1.0', '1.2.0') to be -1, got 0 at test_runner.js:30",ground_truth:{file:"src/comparator.js",symbol:"compareVersions",bug_find:"if (v1.minor !== v2.minor) ^v1.minor > v2.minor ? 1 : -1;",bug_replace:"if (v1.minor !== v2.minor) ^v1.minor > v2.minor ? 1 : 0;"}}];const outPath=path.join(ROOT,'dataset/blind_tasks.json');fs.writeFileSync(outPath,JSON.stringify(blindTasks,null,2));console.log("[+] Generated "+(blindTasks.length)+" Blind Debugging Tasks at: "+(outPath));^blindTasks}
=ex{createBlindTaskDataset}