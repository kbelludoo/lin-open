@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!setupWorkspace(){ROOT=path.resolve(path.dirname(__filename),'..');TEMPLATE_DIR=path.resolve(ROOT,'../LIN_REAL_AGENT_002/repo_template');WORK_DIR=path.join(ROOT,'repo_work');TASKS_FILE=path.resolve(ROOT,'../LIN_REAL_AGENT_002/tasks/tasks.json');fs.rmSync(WORK_DIR,{recursive:true,force:true});fs.cpSync(TEMPLATE_DIR,WORK_DIR,{recursive:true})}
!initializeSubstrate(agent){ROOT=path.resolve(path.dirname(__filename),'..');TEMPLATE_DIR=path.resolve(ROOT,'../LIN_REAL_AGENT_002/repo_template');WORK_DIR=path.join(ROOT,'repo_work');TASKS_FILE=path.resolve(ROOT,'../LIN_REAL_AGENT_002/tasks/tasks.json');const sub=agent.substrate;sub.registerSymbol({name:'parseVersion',module:'src/parser.js',effect:'Pure',body:'regex.match'});sub.registerSymbol({name:'isValid',module:'src/parser.js',effect:'Pure',body:'parseVersion(str) !== null'});sub.registerSymbol({name:'compareIdentifiers',module:'src/comparator.js',effect:'Pure',body:'parseInt comparison'});sub.registerSymbol({name:'comparePrereleases',module:'src/comparator.js',effect:'Pure',body:'compareIdentifiers loop'});sub.registerSymbol({name:'compareVersions',module:'src/comparator.js',effect:'Pure',body:'comparePrereleases + major/minor/patch'});sub.registerSymbol({name:'gt',module:'src/comparator.js',effect:'Pure',body:'compareVersions > 0'});sub.registerSymbol({name:'lt',module:'src/comparator.js',effect:'Pure',body:'compareVersions < 0'});sub.registerSymbol({name:'parseRange',module:'src/ranges.js',effect:'Pure',body:'caret and tilde parser'});sub.registerSymbol({name:'satisfiesRange',module:'src/ranges.js',effect:'Pure',body:'evaluates comparators and prerelease isolation'});sub.registerSymbol({name:'maxSatisfying',module:'src/satisfier.js',effect:'Pure',body:'loop with gt'});sub.registerSymbol({name:'minSatisfying',module:'src/satisfier.js',effect:'Pure',body:'loop with lt'});sub.addDependency('compareVersions','parseVersion');sub.addDependency('comparePrereleases','compareIdentifiers');sub.addDependency('compareVersions','comparePrereleases');sub.addDependency('gt','compareVersions');sub.addDependency('lt','compareVersions');sub.addDependency('parseRange','parseVersion');sub.addDependency('satisfiesRange','parseRange');sub.addDependency('satisfiesRange','compareVersions');sub.addDependency('maxSatisfying','satisfiesRange');sub.addDependency('maxSatisfying','gt');sub.addDependency('minSatisfying','satisfiesRange');sub.addDependency('minSatisfying','lt')}
!runAgentBenchmark(){ROOT=path.resolve(path.dirname(__filename),'..');TEMPLATE_DIR=path.resolve(ROOT,'../LIN_REAL_AGENT_002/repo_template');WORK_DIR=path.join(ROOT,'repo_work');TASKS_FILE=path.resolve(ROOT,'../LIN_REAL_AGENT_002/tasks/tasks.json');console.log("================================================================================");console.log("   LIN-AGENT-RUNTIME-001: FULL CLOSED-LOOP AGENT BENCHMARK (10 TASKS x 3 ARMS)  ");console.log("================================================================================");const tasks=JSON.parse(fs.readFileSync(TASKS_FILE,'utf8'));const groups=[{id:'RAW',name:'Group A: Raw Model (Zero-State Baseline)'},{id:'CHAT_HISTORY',name:'Group B: Model + Textual Chat Buffer'},{id:'LIN',name:'Group C: Model + LIN Semantic Agent Runtime'}];const agent=new LinAgent();initializeSubstrate(agent);const groupSummaries={};for(const grp of groups){console.log("\\n================================================================================");console.log(">>> Executing "+(grp.name)+"...");console.log("================================================================================");let totalTasks=tasks.length;let initialSuccessCount=0;let recoveredSuccessCount=0;let totalAttempts=0;let totalPromptTokens=0;let totalEvalTokens=0;let totalDurationMs=0;let totalRejections=0;const taskLogs=[];for(const task of tasks){console.log("  [Task "+(task.task_id)+"] "+(task.title)+"...");setupWorkspace();const targetFilePath=path.join(WORK_DIR,task.file);let content=fs.readFileSync(targetFilePath,'utf8');content=content.replace(task.bug_find,task.bug_replace);fs.writeFileSync(targetFilePath,content,'utf8');const res=await agent.runTask({task,repoDir:WORK_DIR,group:grp.id,maxAttempts:3});if(res.initialSuccess) {initialSuccessCount++;}if(res.recoveredSuccess) {recoveredSuccessCount++;}totalAttempts+=res.attempts;totalPromptTokens+=res.promptTokens;totalEvalTokens+=res.evalTokens;totalDurationMs+=res.durationMs;totalRejections+=res.verificationRejections;console.log("    -> Success: "+(res.success)+" (Initial: "+(res.initialSuccess)+", Recovered: "+(res.recoveredSuccess)+") | Attempts: "+(res.attempts)+" | Prompt Tokens: "+(res.promptTokens)+" | Time: "+((res.durationMs / 1000).toFixed(1))+"s");taskLogs.push(res);}const failedInitial=totalTasks-initialSuccessCount;const recoveryRate=failedInitial>0?(recoveredSuccessCount/failedInitial):0;const taskSuccessRate=(initialSuccessCount+recoveredSuccessCount)/totalTasks;const avgAttempts=totalAttempts/totalTasks;const avgTokens=totalPromptTokens/totalTasks;const summary={group_id:grp.id,group_name:grp.name,total_tasks:totalTasks,initial_success:initialSuccessCount,recovered_success:recoveredSuccessCount,task_success_rate:taskSuccessRate,recovery_rate:recoveryRate,avg_attempts_per_task:avgAttempts,avg_prompt_tokens_per_task:avgTokens,total_duration_s:totalDurationMs/1000,verification_rejections:totalRejections,tasks:taskLogs};groupSummaries[grp.id]=summary;console.log("\\n["+(grp.id)+" Summary] Task Success: "+((taskSuccessRate * 100).toFixed(1))+"% | Recovery: "+((recoveryRate * 100).toFixed(1))+"% | Avg Tokens: "+(avgTokens.toFixed(0))+" | Total Time: "+((totalDurationMs / 1000).toFixed(1))+"s");}const avgTokensChat=groupSummaries['CHAT_HISTORY'].avg_prompt_tokens_per_task;const avgTokensLin=groupSummaries['LIN'].avg_prompt_tokens_per_task;const semanticStateReuseRate=((avgTokensChat-avgTokensLin)/avgTokensChat)*100;groupSummaries['COMPARATIVE_METRICS']={semantic_state_reuse_rate:(semanticStateReuseRate.toFixed(1))+"%",token_reduction:(((avgTokensChat - avgTokensLin) / avgTokensChat * 100).toFixed(1))+"%",recovery_gain:(((groupSummaries['LIN'].recovery_rate - groupSummaries['CHAT_HISTORY'].recovery_rate) * 100).toFixed(1))+"%"};const outPath=path.join(ROOT,'results/LIN_AGENT_RUNTIME_001_REPORT.json');fs.writeFileSync(outPath,JSON.stringify(groupSummaries,null,2));console.log("\\n[+] Benchmark Complete! Final Report saved to "+(outPath));^groupSummaries}
=ex{setupWorkspace,initializeSubstrate,runAgentBenchmark}