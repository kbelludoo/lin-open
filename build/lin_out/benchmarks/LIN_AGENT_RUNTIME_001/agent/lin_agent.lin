@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new SemanticSubstrate();this.trauma=new TraumaLedger();this.verifier=new VerifierGate(this.substrate)}
!extractCode(llmResponse,originalCode){const match=llmResponse.match(/```(?:javascript|js)?\s*([\s\S]*?)```/i);if(match) {^match[1].trim();}if(llmResponse.includes('export function')||llmResponse.includes('function ')||llmResponse.includes('const regex =')){^llmResponse.trim();}^originalCode}
!runTests(repoDir){try{const out=execSync("node "+(path.join(repoDir, 'tests/test_runner.js')),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
=ex{constructor,extractCode,runTests}