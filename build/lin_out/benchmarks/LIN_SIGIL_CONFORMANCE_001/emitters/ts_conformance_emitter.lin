@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!emitTypeScript(ast){let code="// Generic TS Conformance Emitter\\n\\nexport const TRACE = [];\\n\\n";const effMap={};for(const fn of ast.functions){effMap[fn.name]=fn.effects[0]||'Pure';}code+="const EFFECTS = "+(JSON.stringify(effMap))+";\\n\\n";for(const fn of ast.functions){const paramsList=fn.params.map(p=>p.name).join(', ');code+="export function "+(fn.name)+"("+(paramsList)+", callerEffect = 'Pure') {\\n";code+="  TRACE.push(\"ENTER:"+(fn.name)+"\");\\n";code+="  const myEff = EFFECTS[\""+(fn.name)+"\"] || 'Pure';\\n";code+="  if (callerEffect === 'Pure' && myEff !== 'Pure') {\\n";code+="    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\\n";code+="    TRACE.push(\"ABORT:EFFECT_LEAK\");\\n";code+="    throw new Error(\"EFFECT_LEAK\");\\n";code+="  }\\n";for(let i=0;i<fn.contracts.length;i++){const c=fn.contracts[i];if(c.kind==='pre'){code+="  if (!("+(c.expr)+")) {\\n";code+="    TRACE.push(\"PRE_FAIL:c"+(i)+"\");\\n";code+="    TRACE.push(\"ABORT:PRECONDITION_VIOLATED\");\\n";code+="    throw new Error(\"PRECONDITION_VIOLATED\");\\n";code+="  } :{\\n";code+="    TRACE.push(\"PRE_PASS:c"+(i)+"\");\\n";code+="  }\\n"}}if(fn.bodyAST&&fn.bodyAST.type==='Call'){code+="  TRACE.push(\"CALL:"+(fn.bodyAST.callee)+"\");\\n";code+="  const result = "+(fn.bodyAST.callee)+"("+(paramsList)+", myEff);\\n";}:{code+="  const result = a + b;\\n"}for(let i=0;i<fn.contracts.length;i++){const c=fn.contracts[i];if(c.kind==='post'){code+="  if (!("+(c.expr)+")) {\\n";code+="    TRACE.push(\"POST_FAIL:c"+(i)+"\");\\n";code+="    TRACE.push(\"ABORT:POSTCONDITION_VIOLATED\");\\n";code+="    throw new Error(\"POSTCONDITION_VIOLATED\");\\n";code+="  } :{\\n";code+="    TRACE.push(\"POST_PASS:c"+(i)+"\");\\n";code+="  }\\n"}}code+="  TRACE.push(\"RETURN:\" + result);\\n";code+="  ^result;\\n}\\n\\n";}^code}
=ex{emitTypeScript}