@LIN:L1c:0.2
!check(lang,code,opts){
  return lang === 'lin' ? checkLin(code, opts) : checkSyntax(lang, code)
}
!checkLin(source,opts){
  const target = opts.target || 'ts'
  // stage 1: LIN semantic diagnostics (effects/refinement/data-race)
  const g = gate
  const gateResult = g.semanticGate(source)
  ?(!gateResult.valid){
    ^{ ok: false, stage: 'LIN_SEMANTIC', reason: (gateResult.errors || []).join('; ').slice(0, 200) }
  }
  // stage 2: compile + formal gate to target
  let code
  
    const res = compileLia(source, { target })
    code = res.code
  
    return { ok: false, stage: 'LIN_COMPILE', reason: String(e && e.message || e).slice(0, 200) }
  }
!checkSyntax(lang,code){
  const dir = mkdtempSync(join(tmpdir(), 'ainlb-'))
  
    const file = join(dir, `probe.${extFor(lang)}`)
    writeFileSync(file, code)
    return runCheck(lang, file)
  }
!extFor(lang){
  return lang === 'py' ? 'py' : lang === 'rust' ? 'rs' : 'ts'
}
!runCheck(lang,file){
  const cmd = cmdFor(lang, file)
  ?(!cmd){ return { ok: false, reason: 'no-toolchain' } }  const r = spawnSync(cmd.bin, cmd.args, { encoding: 'utf8', timeout: 30000, shell: false })
  return { ok: r.status === 0, reason: r.status === 0 ? 'ok' : (r.stderr || r.stdout || '').slice(0, 200).trim() }
}
!cmdFor(lang,file){
  ?(lang === 'py'){ return { bin: 'python', args: ['-m', 'py_compile', file] } }  ?(lang === 'rust'){ return { bin: 'rustc', args: ['--edition', '2021', '--crate-type', 'lib', file, '-o', `${file}.rlib`] } }  ?(lang === 'ts'){ return { bin: process.execPath, args: [tscBin(), '--noEmit', '--skipLibCheck', '--target', 'es2020', '--module', 'esnext', file] } }  return null
}
!tscBin(){
  return resolve(process.cwd(), 'node_modules', 'typescript', 'bin', 'tsc')
}
=ex{check, checkLin, checkSyntax, extFor, runCheck, cmdFor, tscBin}