^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(group,model){this.group=group;this.model=model}
!solveTask(task,attempt,repoState,history,linMemory){let contextTokens=0;let semanticTokens=0;let wrongFileTouched=false;if(this.group==="A"){contextTokens=3200;semanticTokens=350;}:( this.group==="B" ){contextTokens=3200+(attempt-1)*2800;semanticTokens=350}:( this.group==="C" ){contextTokens=850+(attempt-1)*220;semanticTokens=680}:( this.group==="D" ){contextTokens=920+(attempt-1)*250;semanticTokens=760}let pSuccess=0.0;if(task.type==="unit_bug") {pSuccess=0.65;}:( task.type==="multi_module_regression" ){pSuccess=0.35}:( task.type==="edge_case" ){pSuccess=0.40}if(this.group==="A"){}:( this.group==="B" ){if(attempt>1){pSuccess+=task.type==="unit_bug"?0.12:0.04;if(Math.random()<0.15&&task.type==="multi_module_regression"){wrongFileTouched=true;}}}:( this.group==="C" ){if(attempt===1){pSuccess+=task.type==="multi_module_regression"?0.18:0.08;}:{pSuccess+=task.type==="multi_module_regression"?0.42:0.28}wrongFileTouched=false}:( this.group==="D" ){if(attempt===1){pSuccess+=task.type==="multi_module_regression"?0.25:0.15;}:{pSuccess+=task.type==="multi_module_regression"?0.55:0.40}wrongFileTouched=false}pSuccess=Math.min(0.96,pSuccess);return{group:this.group,task_id:task.task_id,attempt,pSuccess,contextTokens,semanticTokens,wrongFileTouched}}
=ex{constructor,solveTask}