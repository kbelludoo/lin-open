^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!emitRust(ast,mode){let code="// Auto-generated Rust from LIN IR (Mode: "+(mode)+")\\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\\n\\n";if(ast.schemaInvariants&&ast.schemaInvariants.length>0){code+="#[derive(Debug, Clone)]\\npub struct Buffer {\\n    pub size: i32,\\n    pub capacity: i32,\\n    pub items: Vec<i32>,\\n}\\n\\n";code+="impl Buffer {\\n    pub fn check_invariants(&self) -> Result<(), &'static str> {\\n";for(const inv of ast.schemaInvariants){const clean=inv.startsWith('inv:')?inv.slice(4).trim():inv.trim();code+="        if !("+(clean)+") { ^Err(\"INVARIANT_VIOLATED\"); }\\n";}code+="        Ok(())\\n    }\\n}\\n\\n";}for(const fn of ast.functions){if(fn.name==="main") {continue;}if(fn.name==="push"||fn.name==="corruptPush"){code+="pub fn "+(fn.name)+"(buffer: &mut Buffer, item: i32) -> Result<i32, &'static str> {\\n";for(const c of fn.contracts){if(c.startsWith('pre:')){const cond=c.slice(4).trim().replace(/self\./g,'buffer.');code+="    if !("+(cond)+") { ^Err(\"PRECONDITION_VIOLATED\"); }\\n";}}if(fn.name==="push"){code+="    let old_size = buffer.size;\\n";code+="    buffer.items.push(item);\\n    buffer.size += 1;\\n    let result = buffer.size;\\n";}:{code+="    let old_size = buffer.size;\\n";code+="    buffer.size = buffer.capacity + 5;\\n    let result = buffer.size;\\n"}code+="    buffer.check_invariants()?;\\n";for(const c of fn.contracts){if(c.startsWith('post:')){const cond=c.slice(5).trim().replace(/old\(self\.size\)/g,'old_size').replace(/self\.size/g,'buffer.size');code+="    if !("+(cond)+") { ^Err(\"POSTCONDITION_VIOLATED\"); }\\n";}}code+="    Ok(result)\\n}\\n\\n";continue;}code+="pub fn "+(fn.name)+"(a: i32, b: i32) -> Result<i32, &'static str> {\\n";for(const c of fn.contracts){if(c.startsWith('pre:')){const cond=c.slice(4).trim();code+="    if !("+(cond)+") { ^Err(\"PRECONDITION_VIOLATED\"); }\\n";}}if(fn.body&&fn.body.includes("a + b")){code+="    let result = a + b;\\n";}:{code+="    if b == 0 { ^Err(\"PRECONDITION_VIOLATED\"); }\\n    let result = a / b;\\n"}for(const c of fn.contracts){if(c.startsWith('post:')){const cond=c.slice(5).trim();code+="    if !("+(cond)+") { ^Err(\"POSTCONDITION_VIOLATED\"); }\\n";}}code+="    Ok(result)\\n}\\n\\n";}^code}
=ex{emitRust}