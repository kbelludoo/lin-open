@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!synthesizeProgram(id,rand){numFns=2+Math.floor(rand()*7);fns=[];effectOptions=['Pure','IO','HeapMut'];for(f=1;f<=numFns;f++){fnName="fn_"+(f);eff=rand()<0.8?'Pure':effectOptions[Math.floor(rand()*3)];numPre=Math.floor(rand()*3);numPost=Math.floor(rand()*3);contracts=[];for(c=0;c<numPre;c++){if(c===0){contracts.push({kind:'pre',expr:'a > 0',ast:{type:'BinaryOp',op:'>',left:{type:'Identifier',name:'a'},right:{type:'Literal',value:0}}});}:{contracts.push({kind:'pre',expr:'b > 0',ast:{type:'BinaryOp',op:'>',left:{type:'Identifier',name:'b'},right:{type:'Literal',value:0}}})}};bodyAST=null;bodyCode='';if(f<numFns&&rand()<0.6){callee="fn_"+(f + 1);bodyAST={type:'Call',callee,args:[{type:'Identifier',name:'a'},{type:'Identifier',name:'b'}]};bodyCode="^"+(callee)+"(a, b)";}:{bodyAST={type:'BinaryOp',op:'+',left:{type:'Identifier',name:'a'},right:{type:'Identifier',name:'b'}};bodyCode='^(a + b)'};for(c=0;c<numPost;c++){contracts.push({kind:'post',expr:'result >= a',ast:{type:'BinaryOp',op:'>=',left:{type:'Identifier',name:'result'},right:{type:'Identifier',name:'a'}}});};fns.push({name:fnName,params:[{name:'a',type:'i32'},{name:'b',type:'i32'}],returnType:'i32',effects:[eff],contracts,bodyAST,bodyCode});};isInvalid=rand()<0.3;initialArgs=isInvalid?[-10,5]:[10+Math.floor(rand()*50),5+Math.floor(rand()*20)];return{prog_id:"prog_"+(String(id).padStart(4, '0')),entry_fn:'fn_1',num_functions:numFns,ast:{protocol:'LIN_TYPED_IR/3.0',functions:fns},initialArgs}}
!generateConformanceCorpus(count,seed){rand=createPRNG(seed);corpus=[];for(i=1;i<=count;i++){corpus.push(synthesizeProgram({id:i,rand}));};^corpus}
=ex{synthesizeProgram,generateConformanceCorpus}