^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(ast){this.ast=ast;this.fnMap=new Map();for(fn of ast.functions){this.fnMap.set(fn.name,fn);}}
!evalNode(node,env){if(!node) {^null;}switch(node.type){case 'Literal':^node.value;case 'Identifier':if(Object.prototype.hasOwnProperty.call(env,node.name)){^env[node.name];};throw new Error("Unresolved identifier: "+(node.name));case 'UnaryOp':{val=this.evalNode(node.argument,env);if(node.op==='!') {return!val;}if(node.op==='-') {return-val;}throw new Error("Unsupported unary operator: "+(node.op));};case 'BinaryOp':{left=this.evalNode(node.left,env);right=this.evalNode(node.right,env);switch(node.op){case '+':^left+right;case '-':^left-right;case '*':^left*right;case '/':^right===0?0:Math.floor(left/right);case '%':^right===0?0:left%right;case '==':^left===right;case '!=':^left!==right;case '<':^left<right;case '<=':^left<=right;case '>':^left>right;case '>=':^left>=right;case '&&':^Boolean(left&&right);case '||':^Boolean(left||right);default:throw new Error("Unsupported binary operator: "+(node.op));}};case 'Call':{^this.invokeFunction(node.callee,node.args.map(a=>this.evalNode(a,env)),env.__callerEffect||'Pure');};default:throw new Error("Unsupported AST Node type: "+(node.type));}}
!execute(entryFnName,initialArgs){this.trace=[];try{res=this.invokeFunction(entryFnName,initialArgs,'Pure');return{status:'ACCEPTED',reason:'OK',result:res,trace:this.trace};}catch(err){return{status:'REJECTED',reason:err.message,result:null,trace:this.trace};}}
!invokeFunction(fnName,argsArray,callerEffect){fn=this.fnMap.get(fnName);if(!fn){this.trace.push("ABORT:FN_NOT_FOUND:"+(fnName));throw new Error("FN_NOT_FOUND:"+(fnName));};this.trace.push("ENTER:"+(fnName));fnEffect=fn.effects[0]||'Pure';if(callerEffect==='Pure'&&fnEffect!=='Pure'){this.trace.push("EFFECT_LEAK:Pure_calls_"+(fnEffect));this.trace.push("ABORT:EFFECT_LEAK");throw new Error("EFFECT_LEAK");};env={__callerEffect:fnEffect};for(i=0;i<fn.params.length;i++){env[fn.params[i].name]=argsArray[i];};for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='pre'){pass=this.evalNode(c.ast,env);if(pass){this.trace.push("PRE_PASS:c"+(i));}:{this.trace.push("PRE_FAIL:c"+(i));this.trace.push("ABORT:PRECONDITION_VIOLATED");throw new Error("PRECONDITION_VIOLATED")}}};result=0;if(fn.bodyAST){if(fn.bodyAST.type==='Call'){this.trace.push("CALL:"+(fn.bodyAST.callee));evaluatedArgs=fn.bodyAST.args.map(a=>this.evalNode(a,env));result=this.invokeFunction(fn.bodyAST.callee,evaluatedArgs,fnEffect);}:{result=this.evalNode(fn.bodyAST,env)}};postEnv={...env,result};for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='post'){pass=this.evalNode(c.ast,postEnv);if(pass){this.trace.push("POST_PASS:c"+(i));}:{this.trace.push("POST_FAIL:c"+(i));this.trace.push("ABORT:POSTCONDITION_VIOLATED");throw new Error("POSTCONDITION_VIOLATED")}}};this.trace.push("RETURN:"+(result));^result}
=ex{constructor,evalNode,execute,invokeFunction}