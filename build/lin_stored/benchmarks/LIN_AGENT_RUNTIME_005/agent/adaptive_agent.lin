@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new SemanticSubstrate();this.ledger=new HypothesisLedger();this.verifier=new VerifierGate(this.substrate);this.search=new AdaptiveBeamSearch(this.substrate,this.ledger)}
!parseSSE(response){raw=await response.text();text="";for(line of raw.split("\n")){if(line.startsWith("data: ")){chunk=line.slice(6).trim();if(chunk==="[DONE]") {continue;}try{p=JSON.parse(chunk);if(p.choices&&p.choices[0]){if(p.choices[0].delta&&p.choices[0].delta.content){text+=p.choices[0].delta.content;}:( p.choices[0].text ){text+=p.choices[0].text}}}catch(e){}}};if(!text){try{p=JSON.parse(raw);if(p.choices&&p.choices[0]){text=p.choices[0].message?p.choices[0].message.content:p.choices[0].text;}}catch(e){}};^text.trim()}
!queryLLM(prompt,retryCount){t0=performance.now();for(r=0;r<=retryCount;r++){for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:800}),signal:AbortSignal.timeout(12000)});if(res.ok){text=await this.parseSSE(res);if(text){durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};await new Promise(resolve=>setTimeout(resolve,800));};try{res=await fetch((this.ollamaUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.ollamaModel,prompt,temperature:0.1,stream:false,options:{num_predict:350,num_thread:8}})});if(res.ok){data=await res.json();durationMs=performance.now()-t0;return{response:data.response||'',promptTokens:data.prompt_eval_count||Math.ceil(prompt.length/4),evalTokens:data.eval_count||0,durationMs,modelUsed:this.ollamaModel};}}catch(e){};throw new Error("All LLM providers unavailable")}
!extractFileAndPatch(llmResponse,defaultFile,availableFiles){targetFile=defaultFile;for(f of availableFiles){if(llmResponse.includes(f)||llmResponse.includes("FILE: "+(f))){targetFile=f;break;}};match=llmResponse.match(/```(?:javascript|js)?\s*([\s\S]*?)```/i);code=match?match[1].trim():null;if(code){code=code.replace(/^FILE:[^\n]*\n+/i,'').trim();};return{targetFile,code}}
!runTests(repoDir){try{out=execSync("node "+(path.join(repoDir, 'tests/test_runner.js')),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!runTask(task,repoDir,arm,maxAttempts){this.ledger.clear();initialSuccess=false;recoveredSuccess=false;rootCauseFound=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;attemptsCount=0;wrongFileEdits=0;availableFiles=['src/parser.js','src/comparator.js','src/ranges.js','src/satisfier.js'];originalFiles={};for(f of availableFiles){originalFiles[f]=fs.readFileSync(path.join(repoDir,f),'utf8');};resetFiles=()=>{for(f of availableFiles){fs.writeFileSync(path.join(repoDir,f),originalFiles[f],'utf8');}};entrySym=this.search.identifyEntrySymbol(task.test_assertion_error);rankedBeam=this.search.generateRankedBeam(entrySym,task.test_assertion_error);for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;prompt='';activeCandidate=null;activeHyp=null;if(arm==='GREEDY'){activeCandidate=rankedBeam[0];focused=this.substrate.generateFocusedContext(activeCandidate.symbol);prompt="[LIN Semantic State]\\nTarget: "+(activeCandidate.symbol)+" ("+(activeCandidate.module)+")\\nEffect: *("+(focused.effect)+")\\n\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n[Module Code: "+(activeCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, activeCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\nProvide the complete fixed code for "+(activeCandidate.module)+" inside a single \\`\\`\\`javascript code block.";}:( arm==='BEAM_3'||arm==='BEAM_5' ){k=arm==='BEAM_3'?3:5;beamSlice=rankedBeam.slice(0,k);activeCandidate=this.search.selectAdaptiveCandidate(beamSlice,attempt);activeHyp=this.ledger.registerHypothesis({symbol:activeCandidate.symbol,module:activeCandidate.module,reason:"Beam rank candidate score "+(activeCandidate.score)});focused=this.substrate.generateFocusedContext(activeCandidate.symbol);searchMemory=this.ledger.generateSearchMemoryPrompt();prompt="[LIN Fixed Beam State (Top-"+(k)+")]\\n";prompt+="* Active Hypothesis: "+(activeHyp.id)+" -> Investigating '"+(activeCandidate.symbol)+"' in '"+(activeCandidate.module)+"'\\n";prompt+="* Ranked Beam: ["+(beamSlice.map(c => (c.symbol)+" ("+(c.score)+")").join(', '))+"]\\n";prompt+="* Declared Effect: *("+(focused.effect)+")\\n";if(searchMemory) {prompt+="\\n"+(searchMemory)+"\\n";};prompt+="\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Target Module: "+(activeCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, activeCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(activeCandidate.module)+" inside a single \\`\\`\\`javascript code block."}:( arm==='ADAPTIVE' ){activeCandidate=this.search.selectAdaptiveCandidate(rankedBeam,attempt);activeHyp=this.ledger.registerHypothesis({symbol:activeCandidate.symbol,module:activeCandidate.module,reason:"Multi-feature score "+(activeCandidate.score)});focused=this.substrate.generateFocusedContext(activeCandidate.symbol);refutedList=this.ledger.getRefutedHypotheses();prompt="[LIN Adaptive State: Target "+(activeCandidate.symbol)+" ("+(activeCandidate.module)+")]\\n";prompt+="* Multi-Feature Score: "+(activeCandidate.score)+" | Role: "+(activeCandidate.role)+" | Effect: *("+(focused.effect)+")\\n";if(refutedList.length>0){prompt+="* Refuted Branches: ["+(refutedList.map(h => (h.symbol)+" ("+(h.module)+")").join(', '))+"]\\n";};prompt+="\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Module Code: "+(activeCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, activeCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(activeCandidate.module)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;defaultTargetFile=activeCandidate?activeCandidate.module:availableFiles[0];__d4150=this.extractFileAndPatch(llm.response,defaultTargetFile,availableFiles);targetFile=__d4150.targetFile;code=__d4150.code;if(!code) {continue;}if(targetFile===task.ground_truth.file){rootCauseFound=true;}:{wrongFileEdits++};fs.writeFileSync(path.join(repoDir,targetFile),code,'utf8');testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}if(activeHyp) {this.ledger.verifyHypothesis(activeHyp.id);}break;}:{resetFiles();if(activeHyp){this.ledger.refuteHypothesis(activeHyp.id,testRes.output.slice(0,120));}}};resetFiles();return{task_id:task.task_id,arm,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,rootCauseFound,attempts:attemptsCount,wrongFileEdits,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs}}
=ex{constructor,parseSSE,queryLLM,extractFileAndPatch,runTests,runTask}