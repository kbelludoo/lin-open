@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(substrate,hypothesisLedger){this.substrate=substrate;this.ledger=hypothesisLedger;this.ranker=new MultiFeatureRanker(substrate)}
!identifyEntrySymbol(testErrorOutput){for(const[symbolName] of  this.substrate.symbolIndex.entries()){if(testErrorOutput.includes(symbolName)){^symbolName;}};^'satisfiesRange'}
!generateRankedBeam(entrySymbol,testErrorOutput){candidates=[];visited=new Set();directCallees=this.substrate.dependencyGraph.get(entrySymbol)||new Set();for(callee of directCallees){node=this.substrate.symbolIndex.get(callee);if(node&&!visited.has(callee)){visited.add(callee);score=this.ranker.computeScore({symbol:callee,module:node.module,role:'callee',entrySymbol,testErrorOutput});candidates.push({symbol:callee,module:node.module,score,role:'callee'});}};entryNode=this.substrate.symbolIndex.get(entrySymbol);if(entryNode&&!visited.has(entrySymbol)){visited.add(entrySymbol);score=this.ranker.computeScore({symbol:entrySymbol,module:entryNode.module,role:'entry',entrySymbol,testErrorOutput});candidates.push({symbol:entrySymbol,module:entryNode.module,score,role:'entry'});};for(callee of Array.from(directCallees)){leafCallees=this.substrate.dependencyGraph.get(callee)||new Set();for(leaf of leafCallees){node=this.substrate.symbolIndex.get(leaf);if(node&&!visited.has(leaf)){visited.add(leaf);score=this.ranker.computeScore({symbol:leaf,module:node.module,role:'leaf',entrySymbol,testErrorOutput});candidates.push({symbol:leaf,module:node.module,score,role:'leaf'});}}};candidates.sort((a,b)=>b.score-a.score);^candidates}
!selectAdaptiveCandidate(rankedBeam,attemptIndex){refuted=new Set(this.ledger.getRefutedHypotheses().map(h=>h.symbol));available=rankedBeam.filter(c=>!refuted.has(c.symbol));if(available.length>0){^available[0];};^rankedBeam[(attemptIndex-1)%rankedBeam.length]}
=ex{constructor,identifyEntrySymbol,generateRankedBeam,selectAdaptiveCandidate}