@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new SemanticSubstrate();this.trauma=new TraumaLedger();this.verifier=new VerifierGate(this.substrate)}
!parseSSE(response){raw=await response.text();text="";for(line of raw.split("\n")){if(line.startsWith("data: ")){chunk=line.slice(6).trim();if(chunk==="[DONE]") {continue;}try{p=JSON.parse(chunk);if(p.choices&&p.choices[0]){if(p.choices[0].delta&&p.choices[0].delta.content){text+=p.choices[0].delta.content;}:( p.choices[0].text ){text+=p.choices[0].text}}}catch(e){}}};if(!text){try{p=JSON.parse(raw);if(p.choices&&p.choices[0]){text=p.choices[0].message?p.choices[0].message.content:p.choices[0].text;}}catch(e){}};^text.trim()}
!queryLLM(prompt){t0=performance.now();for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:600}),signal:AbortSignal.timeout(8000)});if(res.ok){text=await this.parseSSE(res);if(text){durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};res=await fetch((this.ollamaUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.ollamaModel,prompt,temperature:0.1,stream:false,options:{num_predict:250,num_thread:8}})});if(!res.ok) {throw new Error("LLM Error: "+(res.statusText));}data=await res.json();durationMs=performance.now()-t0;return{response:data.response||'',promptTokens:data.prompt_eval_count||Math.ceil(prompt.length/4),evalTokens:data.eval_count||0,durationMs,modelUsed:this.ollamaModel}}
!extractCode(llmResponse,originalCode){match=llmResponse.match(/```(?:javascript|js)?\s*([\s\S]*?)```/i);if(match) {^match[1].trim();}if(llmResponse.includes('export function')||llmResponse.includes('function ')||llmResponse.includes('regex =')){^llmResponse.trim();};^originalCode}
!runTests(repoDir){try{out=execSync("node "+(path.join(repoDir, 'tests/test_runner.js')),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!runTask(task,repoDir,group,maxAttempts){this.trauma.clear();historyBuffer=[];initialSuccess=false;recoveredSuccess=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;verificationRejections=0;attemptsCount=0;targetFilePath=path.join(repoDir,task.file);backupCode=fs.readFileSync(targetFilePath,'utf8');for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;currentCode=fs.readFileSync(targetFilePath,'utf8');prompt='';if(group==='RAW'){prompt="You are an expert JS developer fixing a bug.\\nTask: "+(task.instruction)+"\\n\\nFile ("+(task.file)+"):\\n\\`\\`\\`javascript\\n"+(currentCode)+"\\n\\`\\`\\`\\n\\nProvide the complete, corrected code for "+(task.file)+" inside a single \\`\\`\\`javascript code block.";}:( group==='CHAT_HISTORY' ){histText=historyBuffer.map(h=>"[Attempt "+(h.attempt)+" Test Failure Error]:\\n"+(h.testOutput)).join('\n\n');prompt="You are an expert JS developer fixing a bug.\\nTask: "+(task.instruction)+"\\n\\nFile ("+(task.file)+"):\\n\\`\\`\\`javascript\\n"+(currentCode)+"\\n\\`\\`\\`\\n"+(histText ? "\\nPrevious Attempt Failures:\\n"+(histText)+"\\n" : '')+"\\nProvide the complete, corrected code for "+(task.file)+" inside a single \\`\\`\\`javascript code block."}:( group==='LIN' ){focused=this.substrate.generateFocusedContext(task.symbol);traumaText=this.trauma.generateTraumaPrompt();prompt="[LIN Semantic State]\\nTarget Symbol: "+(focused.symbol)+" in '"+(task.file)+"'\\nDeclared Effect: *("+(focused.effect)+")\\nDownstream Transitive Dependents: ["+(focused.dependents.join(', '))+"]\\n"+(traumaText ? (traumaText)+"\\n" : '')+"\\nTask: "+(task.instruction)+"\\n\\nCurrent Code:\\n\\`\\`\\`javascript\\n"+(currentCode)+"\\n\\`\\`\\`\\n\\nProvide the complete, corrected code for "+(task.file)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;newCode=this.extractCode(llm.response,currentCode);if(group==='LIN'){effCheck=this.verifier.verifyEffectIsolation(newCode,'Pure');if(!effCheck.valid){verificationRejections++;this.trauma.recordFailure({attempt,targetSymbol:task.symbol,brokenInvariant:'EFFECT_LEAK',errorDiagnostic:effCheck.reason,refutedHypothesis:'Attempted to perform IO in a pure semantic module'});continue;}};fs.writeFileSync(targetFilePath,newCode,'utf8');testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}break;}:{fs.writeFileSync(targetFilePath,backupCode,'utf8');historyBuffer.push({attempt,testOutput:testRes.output.slice(0,250)});this.trauma.recordFailure({attempt,targetSymbol:task.symbol,brokenInvariant:'TEST_ASSERTION_FAILED',errorDiagnostic:testRes.output.slice(0,150),refutedHypothesis:"Patch in attempt "+(attempt)+" failed test assertions"})}};fs.writeFileSync(targetFilePath,backupCode,'utf8');return{task_id:task.task_id,group,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,attempts:attemptsCount,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs,verificationRejections}}
=ex{constructor,parseSSE,queryLLM,extractCode,runTests,runTask}