@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(){this.dagNodes=new Map();this.symbolIndex=new Map();this.dependencyGraph=new Map();this.reverseDependencyGraph=new Map();this.invariants=[];this.effects=new Map()}
!hashNode(data){^crypto.createHash('sha256').update(JSON.stringify(data)).digest('hex').slice(0,16)}
!registerSymbol(name,module,params,returnType,contracts,effect,body){normalizedBody=String(body).replace(/\s+/g,' ').trim();nodeData={name,module,params,returnType,contracts,effect,body:normalizedBody};hash=this.hashNode(nodeData);canonicalNode=this.dagNodes.get(hash);if(!canonicalNode){canonicalNode={id:hash,...nodeData};this.dagNodes.set(hash,canonicalNode);};this.symbolIndex.set(name,canonicalNode);this.effects.set(name,effect);for(c of contracts){if(c.kind==='inv'){this.invariants.push({symbol:name,...c});}};^canonicalNode}
!addDependency(callerSymbol,calleeSymbol){if(!this.dependencyGraph.has(callerSymbol)){this.dependencyGraph.set(callerSymbol,new Set());};this.dependencyGraph.get(callerSymbol).add(calleeSymbol);if(!this.reverseDependencyGraph.has(calleeSymbol)){this.reverseDependencyGraph.set(calleeSymbol,new Set());};this.reverseDependencyGraph.get(calleeSymbol).add(callerSymbol)}
!getAffectedSubtree(symbolName){affected=new Set();queue=[symbolName];visited=new Set([symbolName]);while(queue.length>0){current=queue.shift();callers=this.reverseDependencyGraph.get(current);if(callers){for(caller of callers){if(!visited.has(caller)){visited.add(caller);affected.add(caller);queue.push(caller);}}}};^Array.from(affected)}
!generateFocusedContext(targetSymbol){node=this.symbolIndex.get(targetSymbol);dependents=this.getAffectedSubtree(targetSymbol);activeInvariants=this.invariants.filter(inv=>dependents.includes(inv.symbol)||inv.symbol===targetSymbol);return{symbol:node?node.name:targetSymbol,module:node?node.module:'unknown',effect:node?node.effect:'Pure',contracts:node?node.contracts:[],dependents,activeInvariants}}
=ex{constructor,hashNode,registerSymbol,addDependency,getAffectedSubtree,generateFocusedContext}