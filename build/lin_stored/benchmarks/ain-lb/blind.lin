@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!createBlindRun(submissions,seed){items=submissions.map((s)=>({lang:s.lang,task:s.task,text:s.text})); shuffle(items,seed); labels=items.map((_,i)=>"candidate_"+(String.fromCharCode(65 + i))); map={};candidates=items.map((it,i)=>{map[labels[i]]=it.lang;return{label:labels[i],task:it.task,lang:it.lang,text:it.text}}); return{candidates,map,seed}}
!unmap(results,map){byLang={};for(r of results){lang=map[r.label];if(!lang) {continue;}byLang[lang]??=[];byLang[lang].push(r)};^byLang}
!shuffle(arr,seed){rng=seededRng(seed); for(i=arr.length-1;i>0;i-=1){j=Math.floor(rng()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}}
!seededRng(seed){a=parseInt(createHash('sha256').update(String(seed)).digest('hex').slice(0,8),16)||1;^function(){a|=0;a=(a+0x6d2b79f5)|0;t=Math.imul(((a|(a>>>15))&(-((a)&((a>>>15)))-1)),1|a); t=(((t+Math.imul(((t|(t>>>7))&(-((t)&((t>>>7)))-1)),61|t))|t)&(-(((t+Math.imul(((t|(t>>>7))&(-((t)&((t>>>7)))-1)),61|t)))&(t))-1));return((((t|(t>>>14))&(-((t)&((t>>>14)))-1)))>>>0)/4294967296}}
=ex{createBlindRun,unmap,shuffle,seededRng}