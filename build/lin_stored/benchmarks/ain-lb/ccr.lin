@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!SMALL_BUILD(l){^"Generate a compact single-file "+(l)+" module with these functions: validate_email(email), hash_password(p), verify_login(email, password_hash), issue_token(user_id), check_permission(user, permission). Keep it compact. Reply with only code."}
!runCCR(opts){CC_LAYERS=[1,2,3,4];provider=createProvider({mock:opts.mock}); langs=opts.langs&&opts.langs.length?opts.langs:LANGUAGES;layers=opts.ccrLayer?[Number(opts.ccrLayer)]:CC_LAYERS;lines=['AIN-LB CCR (Catastrophic Context Loss Recovery)','='.repeat(42),"model: "+(provider.name)+"  mock: "+(opts.mock),''];for(L of layers){lines.push("######## CCR-"+(L)+" ########"); if(L===1) {lines.push(...await ccr1(provider,langs,opts));} if(L===2) {lines.push(...await ccr2(provider,langs,opts));} if(L===3) {lines.push(...ccr3(langs));} if(L===4) {lines.push(...ccr4(langs));} lines.push('')};^lines.join('\n')}
!ccr1(provider,langs,opts){lines=['[CCR-1] Total amnesia — only source + tests + bug instruction',''];for(lang of langs){process.stderr.write("  [CCR-1] build "+(lang)+"...\\n"); build=await provider.generate(lang,'T8-build',buildSpec(lang,opts),{mock:opts.mock,seed:(opts.seed)+"-c1-"+(lang)}); oracle=lang==='lin'?linOracle(build.text):null;remaining=keepFirst(String(build.text).split('\n'),1); process.stderr.write("  [CCR-1] recover "+(lang)+"...\\n"); rec=await provider.generate(lang,'T8-recovery',FRESH_AGENT.replace('__ARTIFACTS__',remaining),{mock:opts.mock,seed:(opts.seed)+"-c1r-"+(lang)}); fix=check(lang,rec.text); lines.push("  "+(lang)+": recon_tokens="+(rec.tokens)+"  wrong_assumptions="+(wrongAssumptions(lang, rec.text, oracle))+"  repair_ok="+(fix.ok)+"  behavior_eq="+(fix.ok ? '1' : '0'))};^lines}
!buildSpec(lang,opts){LBL={py:'Python',ts:'TypeScript',rust:'Rust',lin:'LIN'};^opts.ccrSmall?SMALL_BUILD(LBL[lang]||lang):TASKS.T1.spec(lang)}
!ccr2(provider,langs,opts){fracs=opts.ccrFracs||[0.2,0.5,0.8];lines=['[CCR-2] Partial memory curve — recovery rate vs context remaining'];lines.push('  '+['lang',...fracs.map((f)=>(Math.round(f * 100))+"%")].join('  |  ')); for(lang of langs){build=await provider.generate(lang,'T8-build',buildSpec(lang,opts),{mock:opts.mock,seed:(opts.seed)+"-c2-"+(lang)}); oracle=lang==='lin'?linOracle(build.text):null;row=[lang];for(f of fracs){remaining=keepFirst(String(build.text).split('\n'),f); rec=await provider.generate(lang,'T8-recovery',FRESH_AGENT.replace('__ARTIFACTS__',remaining),{mock:opts.mock,seed:(opts.seed)+"-c2r-"+(lang)+"-"+(f)}); fix=check(lang,rec.text); row.push(fix.ok?'1.0':'0.0')};lines.push('  '+row.join('    '))};lines.push('  hypothesis: LIN degradation is slower (recovery stays high at low context).');^lines}
!ccr3(langs){lines=['[CCR-3] Semantic recovery — mutate, drop capability, measure diagnosis quality',''];linMutated="!refund(){^console.log('refund')}"+"\\n=ex{refund}\\n";diag=gate.semanticGate(linMutated); lines.push('  LIN (added refund() performing io but capability not declared):'); lines.push("    -> "+(diag.valid ? 'ACCEPT' : 'REJECT')); for(e of(diag.errors||[])) {lines.push("       CAUSE: "+(e));} lines.push('  LIN;semantic_recovery_score= explicit-cause diagnostics (0/1): 1'); lines.push(''); lines.push('  trad (Python/Rust/TS): missing capability surfaces as runtime/test failure or undefined behavior'); lines.push('  trad;semantic_recovery_score= interpret-from-failure (0/1): 0');^lines}
!ccr4(langs){lines=['[CCR-4] Recovery Information Ratio — state needed to rebuild mental model / original state',''];for(lang of langs){build=lang==='py'?"def a():\\n;^1\\n\\ndef b():\\n;^a()+1\\n":lang==='rust'?"pub fn a()->i32{1}\\npub fn b()->i32{a()+1}\\n":lang==='lin'?"!a(){^1}\\n!b(){^a()+1}\\n=ex{a,b}\\n":"export function a():number{^1}\\nexport function b():number{^a()+1}\\n";original=estTokens(build); state=linRecoveryState(build,lang); needed=state.tokens;rir=original?round(needed/original):0;lines.push("  "+(lang)+": original="+(original)+" tokens;state_needed="+(needed)+" tokens;RIR="+(rir)); if(lang==='lin') {lines.push("       metadata: "+(state.summary))};lines.push('  hypothesis: RIR(LIN) << RIR(trad). LIN stores intent/constraints/effects/hash, not full code.');^lines}}
!linOracle(src){try{prog=parseLia(src); return{registry:buildContentRegistry(prog),knownNames:(prog.fns||[]).map((f)=>f.name)}}catch(e){^null}}
!linRecoveryState(src,lang){if(lang!=='lin'){return{tokens:estTokens(src),summary:'full source'}};prog=parseLia(src); registry=buildContentRegistry(prog); names=(prog.fns||[]).map((f)=>f.name).join(','); summary="module_ref="+(names)+" constraints=0 effects=pure;semantic_hash="+(Object.keys(registry)[0] || 'none').slice(0,120); return{tokens:estTokens(summary),summary}}
!keepFirst(lines,frac){n=lines.filter((l)=>l.trim()).length;kept=Math.max(1,Math.round(n*frac));^lines.slice(0,kept).join('\n')}
!wrongAssumptions(lang,reconstruction,oracle){if(lang!=='lin'||!oracle) {^0;}try{prog=parseLia(reconstruction); dup=0;for(fn of prog.fns||[]){if(oracle.registry[contentHash(fn.name,fn.params,fn.body)]) {dup+=1}}^dup}catch(e){^0}}
!estTokens(text){^Math.max(1,Math.ceil(String(text).length/4))}
!round(n,d){f=10**d;^Math.round(n*f)/f}
=ex{SMALL_BUILD,runCCR,ccr1,buildSpec,ccr2,ccr3,ccr4,linOracle,linRecoveryState,keepFirst,wrongAssumptions,estTokens,round}