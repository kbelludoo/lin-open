@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!check(lang,code,opts){^lang==='lin'?checkLin(code,opts):checkSyntax(lang,code)}
!checkLin(source,opts){target=opts.target||'ts';g=gate;gateResult=g.semanticGate(source); if(!gateResult.valid){return{ok:false,stage:'LIN_SEMANTIC',reason:(gateResult.errors||[]).join('; ').slice(0,200)}};code;try{res=compileLia(source,{target}); code=res.code}catch(e){return{ok:false,stage:'LIN_COMPILE',reason:String(e&&e.message||e).slice(0,200)}};t=checkSyntax(target,code); return{ok:t.ok,stage:t.ok?'LIN_EMIT_TS':'LIN_EMIT_TS_FAIL',reason:t.reason,target}}
!checkSyntax(lang,code){dir=mkdtempSync(join(tmpdir(),'ainlb-')); try{file=join(dir,"probe."+(extFor(lang))); writeFileSync(file,code);^runCheck(lang,file)}finally{rmSync(dir,{recursive:true,force:true})}}
!extFor(lang){^lang==='py'?'py':lang==='rust'?'rs':'ts'}
!runCheck(lang,file){cmd=cmdFor(lang,file); if(!cmd) {return{ok:false,reason:'no-toolchain'};}r=spawnSync(cmd.bin,cmd.args,{encoding:'utf8',timeout:30000,shell:false}); return{ok:r.status===0,reason:r.status===0?'ok':(r.stderr||r.stdout||'').slice(0,200).trim()}}
!cmdFor(lang,file){if(lang==='py') {return{bin:'python',args:['-m','py_compile',file]};}if(lang==='rust') {return{bin:'rustc',args:['--edition','2021','--crate-type','lib',file,'-o',(file)+".rlib"]};}if(lang==='ts') {return{bin:process.execPath,args:[tscBin(),'--noEmit','--skipLibCheck','--target','es2020','--module','esnext',file]};}^null}
!tscBin(){^resolve(process.cwd(),'node_modules','typescript','bin','tsc')}
=ex{check,checkLin,checkSyntax,extFor,runCheck,cmdFor,tscBin}