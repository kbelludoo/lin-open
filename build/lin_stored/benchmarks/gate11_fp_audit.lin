@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!isDeepEquivalent(a,b){if(Object.is(a,b)) {^true;}if(typeof a==='function'&&typeof b==='function'){cleanA=a.toString().replace(/\/\*[\s\S]*?\*\/|\/\/[^\r\n]*/g,'').replace(/\s+/g,'');cleanB=b.toString().replace(/\/\*[\s\S]*?\*\/|\/\/[^\r\n]*/g,'').replace(/\s+/g,'');^cleanA===cleanB;};if(typeof a==='object'&&a!==null&&typeof b==='object'&&b!==null){try{^JSON.stringify(a)===JSON.stringify(b);}catch(e){^false;}};^false}
!evaluateDeepAdversarialOracle(origSource,mutatedSource){try{jsOrig=compileLiaToJs(origSource).js;jsMut=compileLiaToJs(mutatedSource).js;evalMod=(jsCode)=>{logs=[];fakeConsole={log:(...args)=>logs.push(args.join(' ')),warn:(...args)=>logs.push(args.join(' ')),error:(...args)=>logs.push(args.join(' ')),info:(...args)=>logs.push(args.join(' ')),};env={console:fakeConsole,process:{env:{NODE_ENV:'test'},exit:()=>{}},module:{exports:{}},setTimeout:()=>0,clearTimeout:()=>{},setInterval:()=>0,clearInterval:()=>{},setImmediate:()=>0,clearImmediate:()=>{},};fn=new Function('console','process','module','exports','setTimeout','clearTimeout','setInterval','clearInterval','setImmediate','clearImmediate',(jsCode)+";^module.exports;");exp=fn(env.console,env.process,env.module,env.module.exports,env.setTimeout,env.clearTimeout,env.setInterval,env.clearInterval,env.setImmediate,env.clearImmediate);normalizedExports=typeof exp==='function'?{[exp.name||'default']:exp}:(exp||{});return{exports:normalizedExports,logs,fakeConsole};};o1=evalMod(jsOrig);o2=evalMod(jsMut);keys1=Object.keys(o1.exports).sort();keys2=Object.keys(o2.exports).sort();if(JSON.stringify(keys1)!==JSON.stringify(keys2)){return{semanticChanged:true,reason:"EXPORT_KEYS_CHANGED: ["+(keys1)+"] vs ["+(keys2)+"]"};};for(k of keys1){f1=o1.exports[k];f2=o2.exports[k];if(typeof f1==='function'&&typeof f2==='function'){if(f1.length!==f2.length){return{semanticChanged:true,reason:"ARITY_CHANGED_FOR_"+(k)+": ("+(f1.length)+" vs "+(f2.length)+")"};}}};extractFnTypes=(src)=>{matches=src.match(/![A-Za-z0-9_]+\([^)]*\)/g)||[];^matches.map(m=>{params=m.replace(/![A-Za-z0-9_]+\(/,'').replace(/\)$/,'');^params.split(',').map(p=>p.includes(':')?p.split(':')[1].trim():'').join(',');}).join(';');};if(extractFnTypes(origSource)!==extractFnTypes(mutatedSource)){return{semanticChanged:true,reason:'TYPE_CONTRACT_CHANGED'};};adversarialMatrix=[[0,0],[1,2],[10,-5],[-40,80],[100,200],[7,3],[1000,1],[-1000,-1],[0.1+0.2,0.3],[1e-15,2e-15],[Math.PI,Math.E],[0,-0],[NaN,0],[0],[1],[-42],[1000],[Math.PI],[NaN],["test_str"],];for(k of keys1){f1=o1.exports[k];f2=o2.exports[k];if(typeof f1==='function'&&typeof f2==='function'){for(inp of adversarialMatrix){l1=[],l2=[];origConsole=console.log;res1,res2,err1=null,err2=null;try{console.log=(...a)=>l1.push(a.join(' '));o1.fakeConsole.log=(...a)=>l1.push(a.join(' '));res1=f1(...inp);}catch(e){err1=e.message;}finally{console.log=origConsole;};try{console.log=(...a)=>l2.push(a.join(' '));o2.fakeConsole.log=(...a)=>l2.push(a.join(' '));res2=f2(...inp);}catch(e){err2=e.message;}finally{console.log=origConsole;};resultsIdentical=isDeepEquivalent(res1,res2);errorsIdentical=(err1===err2);logsIdentical=JSON.stringify(l1)===JSON.stringify(l2);if(!resultsIdentical||!errorsIdentical||!logsIdentical){return{semanticChanged:true,reason:"ADVERSARIAL_DISCREPANCY_"+(k)+"_ON_["+(inp)+"]: res:("+(res1)+" vs "+(res2)+"), err:("+(err1)+" vs "+(err2)+"), logs_diff:("+(l1.length)+" vs "+(l2.length)+")"};}}}};return{semanticChanged:false,reason:'IDENTICAL_BEHAVIOR_AND_CONTRACT'};}catch(e){return{semanticChanged:true,reason:"PARSE_ERROR: "+(e.message)};}}
!classifyFP(origSource,mutatedSource,mutatorNames,oracleReason){prog=parseLia(origSource);mutProg=parseLia(mutatedSource);origExports=new Set((prog.exports||[]).map(e=>{m=e.match(/^(\S+)\s+as\s+(\S+)$/);^m?m[2]:e.trim();}));origFnNames=new Set((prog.fns||[]).map(f=>f.name));origFnMap={};for(f of(prog.fns||[])) {origFnMap[f.name]=f;}mutFnMap={};for(f of(mutProg.fns||[])) {mutFnMap[f.name]=f;}changedFnNames=[];for(name of Object.keys(mutFnMap)){origFn=origFnMap[name];if(!origFn){changedFnNames.push(name);continue;};origCanon=JSON.stringify({p:origFn.params,b:origFn.body});mutCanon=JSON.stringify({p:mutFnMap[name].params,b:mutFnMap[name].body});if(origCanon!==mutCanon) {changedFnNames.push(name);}};addedFnNames=Object.keys(mutFnMap).filter(n=>!(n in origFnMap));allChangedAreInternal=changedFnNames.every(n=>!origExports.has(n))&&addedFnNames.every(n=>!origExports.has(n));anyExportChanged=changedFnNames.some(n=>origExports.has(n));mutExports=new Set((mutProg.exports||[]).map(e=>{m=e.match(/^(\S+)\s+as\s+(\S+)$/);^m?m[2]:e.trim();}));exportListChanged=JSON.stringify([...origExports].sort())!==JSON.stringify([...mutExports].sort());paramChanged=changedFnNames.some(n=>{o=origFnMap[n];m=mutFnMap[n];^o&&m&&o.params!==m.params;});effectInjected=mutatorNames.includes('alter_effect');deadCodeInjected=mutatorNames.includes('alter_exported_symbol')||mutatorNames.includes('dependency_edge');bodyOperatorChanged=mutatorNames.includes('body_semantics');typeChanged=mutatorNames.includes('alter_type');if(exportListChanged&&anyExportChanged){if(mutatorNames.includes('alias_reexport')){^'EXPORT_ALIAS_CONSERVatism';};if(mutatorNames.includes('reorder_exports')){^'EXPORT_ORDER_HASH_IMPACT';};^'EXPORT_LIST_CHANGE';};if(paramChanged){^'PARAMETER_SIGNATURE_CHANGE';};if(typeChanged){^'TYPE_ANNOTATION_CHANGE';};if(allChangedAreInternal&&changedFnNames.length>0){if(effectInjected){^'EFFECT_TO_NON_EXPORTED';};if(deadCodeInjected){^'DEAD_CODE_IN_NON_EXPORTED';};if(bodyOperatorChanged){^'BODY_SEMANTICS_IN_HELPER';};^'INTERNAL_FUNCTION_CHANGE';};if(deadCodeInjected&&anyExportChanged){^'DEAD_CODE_IN_EXPORTED';};if(effectInjected&&anyExportChanged){^'EFFECT_IN_EXPORTED';};if(bodyOperatorChanged&&anyExportChanged){^'BODY_SEMANTICS_IN_EXPORTED';};if(mutatorNames.includes('comment')||mutatorNames.includes('dependency_edge')){^'ANNOTATION_INERT';};if(mutatorNames.includes('formatting')){^'FORMATTING_CANONICALIZATION_GAP';};if(mutatorNames.includes('rename_local')){^'LOCAL_RENAME_ALPHA_GAP';};if(changedFnNames.length===0&&addedFnNames.length===0){if(exportListChanged) {^'EXPORT_REORDER_OR_HASH';}^'CONST_OR_HEADER_CHANGE';};^'MIXED_CAUSE'}
!walkFiles(dir,exts,excludes){results=[];function walk(current){for(item of fs.readdirSync(current)){full=path.join(current,item);stat=fs.statSync(full);if(stat.isDirectory()){if(!excludes.some(ex=>item===ex||full.includes("/"+(ex)+"/"))) {walk(full);}}:( stat.isFile()&&exts.some(ext=>item.endsWith(ext)) ){results.push(full)}}};walk(dir);^results}
!runAudit(){console.log('=== Gate 11 False Positive Audit — Real-World;Corpus===\n');allFP=[];totalEvaluated=0;totalTP=0,totalTN=0,totalFP=0,totalFN=0;totalSemantic=0,totalNonSemantic=0;for(repo of REPOS){console.log("\\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");console.log("Repository: ["+(repo.name)+"]");console.log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");cloneDir=path.join(os.tmpdir(),"gate11_fp_"+(repo.name)+"_"+(Date.now().toString(36)));try{execSync("git clone --depth 1 "+(repo.url)+" \""+(cloneDir)+"\"",{stdio:'pipe'});srcFiles=walkFiles(cloneDir,repo.filterExt,repo.exclude);modules=[];for(file of srcFiles){if(modules.length>=repo.sampleCap) {break;}srcText=fs.readFileSync(file,'utf8');try{lin=emitAilFromSource(srcText,{shortenLocals:false});if(lin&&/![A-Za-z_]/.test(lin)){relPath=path.relative(cloneDir,file);linText=lin.replace(/^@LIA:/,'@LIN:').replace(/^@AIL:/,'@LIN:');jsRes=compileLiaToJs(linText);if(jsRes&&jsRes.js){modules.push({file:relPath,sourceText:srcText,linText});}}}catch(e){}};console.log("[CORPUS] Extracted "+(modules.length)+" production LIN modules");repoFP=0;for(idx=0;idx<modules.length;idx++){m=modules[idx];k=2+(idx%3);chosenIndices=[];for(j=0;j<k;j++){mIdx=(idx*7+j*13)%MUTATOR_POOL.length;if(!chosenIndices.includes(mIdx)) {chosenIndices.push(mIdx);}};selectedMutators=chosenIndices.map(i=>MUTATOR_POOL[i]);mutatedLin=m.linText;for(mut of selectedMutators){mutatedLin=mut.apply(mutatedLin,idx);};oracleVerdict=evaluateDeepAdversarialOracle(m.linText,mutatedLin);isGroundTruthSemantic=oracleVerdict.semanticChanged;hOrig=computeSourceSemanticHash(m.linText);hMut=computeSourceSemanticHash(mutatedLin);linRebuilt=(hOrig!==hMut);totalEvaluated++;if(isGroundTruthSemantic){totalSemantic++;if(linRebuilt) {totalTP++;}:{totalFN++;console.error("[FN] "+(m.file)+" — "+(oracleVerdict.reason))}}:{totalNonSemantic++;if(!linRebuilt) {totalTN++;}:{totalFP++;repoFP++;category=classifyFP(m.linText,mutatedLin,selectedMutators.map(x=>x.name),oracleVerdict.reason);allFP.push({repo:repo.name,file:m.file,trialIdx:idx,mutators:selectedMutators.map(x=>x.name),category,oracleReason:oracleVerdict.reason,hOrig,hMut,origLinPreview:m.linText.slice(0,300),mutatedLinPreview:mutatedLin.slice(0,300),})}}};console.log("[RESULTS] FP in "+(repo.name)+": "+(repoFP)+"/"+(modules.length - (totalTP + totalFN - allFP.length)));}catch(e){console.error("Error processing "+(repo.name)+":",e.message);}finally{try{fs.rmSync(cloneDir,{recursive:true,force:true});}catch(e){}}};taxonomy={};for(fp of allFP){taxonomy[fp.category]=(taxonomy[fp.category]||0)+1;};sortedTaxonomy=Object.entries(taxonomy).sort((a,b)=>b[1]-a[1]);console.log('\n╔══════════════════════════════════════════════════════════╗');console.log('║        GATE 11 FALSE POSITIVE AUDIT — RESULTS          ║');console.log('╚══════════════════════════════════════════════════════════╝\n');console.log("Total modules evaluated:  "+(totalEvaluated));console.log("Semantic mutations:       "+(totalSemantic));console.log("Cosmetic equivalences:    "+(totalNonSemantic));console.log('────────────────────────────────────────────────────────');console.log("TP:  "+(totalTP)+"    TN: "+(totalTN));console.log("FP:  "+(totalFP)+"    FN: "+(totalFN));console.log('────────────────────────────────────────────────────────');console.log("Recall:     "+((totalTP / (totalSemantic || 1) * 100).toFixed(2))+"%");console.log("Precision:  "+((totalTP / ((totalTP + totalFP) || 1) * 100).toFixed(2))+"%");console.log("Over-invalidation: "+((totalFP / (totalNonSemantic || 1) * 100).toFixed(2))+"%");console.log("Accuracy:   "+(((totalTP + totalTN) / (totalEvaluated || 1) * 100).toFixed(2))+"%");console.log('\n┌──────────────────────────────────────────────────────────┐');console.log('│              FP ROOT-CAUSE TAXONOMY                     │');console.log('├──────────────────────────────────────────────────────────┤');for(const[cat,count] of  sortedTaxonomy){pct=(count/(totalFP||1)*100).toFixed(1);bar='█'.repeat(Math.round(count/(totalFP||1)*40));console.log("│ "+(cat.padEnd(38))+" "+(String(count).padStart(3))+" ("+(pct.padStart(5))+"%) "+(bar));};console.log('└──────────────────────────────────────────────────────────┘');console.log('\n┌──────────────────────────────────────────────────────────┐');console.log('│           PER-CATEGORY FP DETAILS                       │');console.log('└──────────────────────────────────────────────────────────┘');for(const[cat] of  sortedTaxonomy){cases=allFP.filter(fp=>fp.category===cat);console.log("\\n▸ "+(cat)+" ("+(cases.length)+" cases)");for(c of cases.slice(0,5)){console.log("  ["+(c.repo)+"] "+(c.file));console.log("    mutators: "+(c.mutators.join(', ')));console.log("    oracle: "+(c.oracleReason.slice(0, 80)));};if(cases.length>5) {console.log("  ... and "+(cases.length - 5)+" more");}};artifact={gate:'GATE_11_FP_AUDIT',timestamp:new Date().toISOString(),summary:{totalEvaluated,totalSemantic,totalNonSemantic,totalTP,totalTN,totalFP,totalFN,recall:totalTP/(totalSemantic||1),precision:totalTP/((totalTP+totalFP)||1),overInvalidation:totalFP/(totalNonSemantic||1),accuracy:(totalTP+totalTN)/(totalEvaluated||1),},taxonomy:Object.fromEntries(sortedTaxonomy),fpCases:allFP,};outPath=path.join(process.cwd(),'gate11_fp_audit.json');fs.writeFileSync(outPath,JSON.stringify(artifact,null,2));console.log("\\n[ARTIFACT] Written to "+(outPath));^artifact}
=ex{isDeepEquivalent,evaluateDeepAdversarialOracle,classifyFP,walkFiles,runAudit}