@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(substrate,hypothesisLedger){this.substrate=substrate;this.ledger=hypothesisLedger;this.refutedSet=new Set();this.causalHistory=[]}
!reset(){this.refutedSet.clear();this.causalHistory=[];this.ledger.clear()}
!findCallPath(src,target){queue=[[src,[src]]];visited=new Set([src]);while(queue.length>0){const[curr,path]=queue.shift();if(curr===target) {^path;}callees=this.substrate.dependencyGraph.get(curr)||new Set();for(c of callees){if(!visited.has(c)){visited.add(c);queue.push([c,[...path,c]]);}}};return[src,target]}
!getTransitiveCallees(startSymbol){callees=[];queue=[startSymbol];visited=new Set([startSymbol]);while(queue.length>0){curr=queue.shift();direct=this.substrate.dependencyGraph.get(curr)||new Set();for(d of direct){if(!visited.has(d)){visited.add(d);callees.push(d);queue.push(d);}}};^callees}
!expandFrontier(entrySymbol,attempt){transitiveCallees=this.getTransitiveCallees(entrySymbol);if(attempt===1){if(!this.refutedSet.has(entrySymbol)){node=this.substrate.symbolIndex.get(entrySymbol);return{symbol:entrySymbol,module:node.module,depth:1,path:[entrySymbol],role:'entry'};}};unrefuted=transitiveCallees.filter(c=>!this.refutedSet.has(c));rankedCandidates=unrefuted.map(sym=>{path=this.findCallPath(entrySymbol,sym);node=this.substrate.symbolIndex.get(sym);isLeaf=(this.substrate.dependencyGraph.get(sym)||new Set()).size===0;score=path.length*1.5;if(isLeaf) {score+=2.0;}return{symbol:sym,module:node?node.module:'src/comparator.js',depth:path.length,path,isLeaf,score};});rankedCandidates.sort((a,b)=>b.score-a.score);if(rankedCandidates.length>0){^rankedCandidates[0];};node=this.substrate.symbolIndex.get(entrySymbol);return{symbol:entrySymbol,module:node?node.module:'src/ranges.js',depth:1,path:[entrySymbol],role:'fallback'}}
!recordRefutation(symbol,errorOutput){this.refutedSet.add(symbol);this.causalHistory.push({symbol,error:String(errorOutput).slice(0,150)})}
!generateCausalNarrative(candidate){narrative="[LIN Explicit Causal Path Exploration]\\n";narrative+="* Active Call Chain: "+(candidate.path.join(' -> '))+"\\n";narrative+="* Frontier Target: '"+(candidate.symbol)+"' in '"+(candidate.module)+"' (Causal Depth: "+(candidate.depth)+")\\n";if(candidate.isLeaf){narrative+="* Target Role: LEAF UTILITY (Root Cause Foundation Node)\\n";};if(this.refutedSet.size>0){narrative+="* Refuted Upstream Wrappers: ["+(Array.from(this.refutedSet).join(', '))+"]\\n";narrative+="* Causal Inference: Upstream wrappers were refuted. The root-cause bug originates inside leaf dependency '"+(candidate.symbol)+"'.\\n";};^narrative}
=ex{constructor,reset,findCallPath,getTransitiveCallees,expandFrontier,recordRefutation,generateCausalNarrative}