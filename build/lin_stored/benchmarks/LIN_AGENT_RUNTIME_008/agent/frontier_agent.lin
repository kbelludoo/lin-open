@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new SemanticSubstrate();this.ledger=new HypothesisLedger();this.verifier=new VerifierGate(this.substrate);this.cumulativeReRanker=new CumulativeStateReRanker(this.substrate,this.ledger);this.frontierEngine=new CausalFrontierEngine(this.substrate,this.ledger)}
!queryLLM(prompt){t0=performance.now();for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:800,stream:false}),signal:AbortSignal.timeout(6000)});if(res.ok){data=await res.json();if(data.choices&&data.choices[0]&&data.choices[0].message){text=data.choices[0].message.content.trim();durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};try{res=await fetch((this.ollamaUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.ollamaModel,prompt,temperature:0.1,stream:false,options:{num_predict:350,num_thread:8}}),signal:AbortSignal.timeout(10000)});if(res.ok){data=await res.json();durationMs=performance.now()-t0;return{response:data.response||'',promptTokens:data.prompt_eval_count||Math.ceil(prompt.length/4),evalTokens:data.eval_count||0,durationMs,modelUsed:this.ollamaModel};}}catch(e){};throw new Error("All LLM providers unavailable")}
!extractFileAndPatch(llmResponse,defaultFile,availableFiles){targetFile=defaultFile;for(f of availableFiles){if(llmResponse.includes(f)||llmResponse.includes("FILE: "+(f))){targetFile=f;break;}};match=llmResponse.match(/```(?:javascript|js)?\s*([\s\S]*?)```/i);code=match?match[1].trim():null;if(code){code=code.replace(/^FILE:[^\n]*\n+/i,'').trim();};return{targetFile,code}}
!runTests(repoDir){try{out=execSync("node "+(path.join(repoDir, 'tests/test_runner.js')),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!identifyEntrySymbol(testErrorOutput){for(const[symbolName] of  this.substrate.symbolIndex.entries()){if(testErrorOutput.includes(symbolName)) {^symbolName;}};^'satisfiesRange'}
!runTask(task,repoDir,arm,maxAttempts){this.cumulativeReRanker.resetTaskState();this.frontierEngine.reset();historyBuffer=[];initialSuccess=false;recoveredSuccess=false;rootCauseFound=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;attemptsCount=0;wrongFileEdits=0;availableFiles=['src/parser.js','src/comparator.js','src/ranges.js','src/satisfier.js'];originalFiles={};for(f of availableFiles){originalFiles[f]=fs.readFileSync(path.join(repoDir,f),'utf8');};resetFiles=()=>{for(f of availableFiles){fs.writeFileSync(path.join(repoDir,f),originalFiles[f],'utf8');}};entrySym=this.identifyEntrySymbol(task.test_assertion_error);this.cumulativeReRanker.initializeBaseScores(entrySym,task.test_assertion_error);for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;prompt='';activeCandidate=null;if(arm==='RAW'){prompt="You are an expert debugger fixing a bug in an open-source SemVer repository.\\n\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n[Repository Files]\\n";for(f of availableFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Identify which file contains the bug and provide the complete fixed file code in a single \\`\\`\\`javascript code block with header 'FILE: <filepath>'.";}:( arm==='CHAT_HISTORY' ){histText=historyBuffer.map(h=>"[Attempt "+(h.attempt)+" Failed on "+(h.file)+"]:\\n"+(h.testOutput)).join('\n\n');prompt="You are an expert debugger fixing a bug in an open-source SemVer repository.\\n\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";if(histText) {prompt+="[Previous Attempt Failure Output]\\n"+(histText)+"\\n\\n";};prompt+="[Repository Files]\\n";for(f of availableFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Identify which file contains the bug and provide the complete fixed file code in a single \\`\\`\\`javascript code block with header 'FILE: <filepath>'."}:( arm==='LIN_CUMULATIVE' ){candidates=this.cumulativeReRanker.getRankedCandidates();activeCandidate=candidates[0]||{symbol:entrySym,module:'src/ranges.js',score:0.5};focused=this.substrate.generateFocusedContext(activeCandidate.symbol);prompt="[LIN Cumulative State (Attempt "+(attempt)+")]\\n";prompt+="* Target Candidate: "+(activeCandidate.symbol)+" in '"+(activeCandidate.module)+"' (Cumulative Score: "+(activeCandidate.score)+")\\n";prompt+="* Declared Effect: *("+(focused.effect)+")\\n";prompt+="\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Target Module Code: "+(activeCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, activeCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(activeCandidate.module)+" inside a single \\`\\`\\`javascript code block."}:( arm==='LIN_FRONTIER' ){activeCandidate=this.frontierEngine.expandFrontier(entrySym,attempt);causalNarrative=this.frontierEngine.generateCausalNarrative(activeCandidate);focused=this.substrate.generateFocusedContext(activeCandidate.symbol);prompt=(causalNarrative)+"\\n";prompt+="* Declared Effect: *("+(focused.effect)+")\\n";prompt+="* Invariant Contracts: ["+((this.substrate.invariants || []).filter(i => i.symbol === activeCandidate.symbol).map(i => i.expr).join('; '))+"]\\n\\n";prompt+="[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Target Module Code: "+(activeCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, activeCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(activeCandidate.module)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;defaultTargetFile=activeCandidate?activeCandidate.module:availableFiles[0];__d4227=this.extractFileAndPatch(llm.response,defaultTargetFile,availableFiles);targetFile=__d4227.targetFile;code=__d4227.code;if(!code) {continue;}if(targetFile===task.ground_truth.file){rootCauseFound=true;}:{wrongFileEdits++};fs.writeFileSync(path.join(repoDir,targetFile),code,'utf8');testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}break;}:{resetFiles();historyBuffer.push({attempt,file:targetFile,testOutput:testRes.output.slice(0,200)});if(activeCandidate){this.cumulativeReRanker.updateCumulativeStateOnRefutation(activeCandidate.symbol);this.frontierEngine.recordRefutation(activeCandidate.symbol,testRes.output);}}};resetFiles();return{task_id:task.task_id,depth:task.depth,arm,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,rootCauseFound,attempts:attemptsCount,wrongFileEdits,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs}}
=ex{constructor,queryLLM,extractFileAndPatch,runTests,identifyEntrySymbol,runTask}