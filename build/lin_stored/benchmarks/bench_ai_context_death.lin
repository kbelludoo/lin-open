@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!assertLinFixtureExports(){fixturesDir=path.join(root,'tests','ain_lb','fixtures','ccr002');expected={auth:['moduleRef','dependencies','declaredEffects','caps','contract','semanticHash','verify'],storage:['moduleRef','dependencies','declaredEffects','caps','contract','semanticHash','write'],};for(const[name,exports] of  Object.entries(expected)){file=path.join(fixturesDir,'group_b',(name)+".lin");source=fs.readFileSync(file,'utf8');__d362=compileLiaToJs(source,{exportMode:'multiple'});program=__d362.program;actual=new Set(program.exports);missing=exports.filter((exportName)=>!actual.has(exportName));if(missing.length){throw new Error("CCR-002 fixture export mismatch: "+(name)+".lin missing "+(missing.join(', ')));}}}
!runCcr002BenchmarkV2(opts){TASKS=[{id:'CCR-002-A',name:'Security / OAuth',targetModule:'Auth'},{id:'CCR-002-B',name:'Optimization / Cache',targetModule:'Storage'},{id:'CCR-002-C',name:'Evolution / MFA',targetModule:'Auth'},{id:'CCR-002-D',name:'Adversarial Optimization',targetModule:'Storage'},];assertLinFixtureExports();numRuns=opts.runs||20;initialSeed=opts.seed||100;rawResults=[];manifests=[];for(run=0;run<numRuns;run++){seed=initialSeed+run*7;for(personalityKey of Object.keys(PERSONALITIES)){personality=PERSONALITIES[personalityKey];agent=new MockAgent(personality,seed);for(group of GROUPS){for(task of TASKS){repoHash=computeRepoHash({group:group.id,scenario:task.id,seed});evalRes=agent.evaluateTask(task,group.id,{totalTokens:group.tokens,repoHash});blindEval=evaluatePatchAnonymous({proposal:evalRes.proposal,repoHash},task,{group:group.id});manifests.push(evalRes.manifest);rawResults.push({run,group:group.id,groupName:group.name,agent:personality.name,taskId:task.id,taskName:task.name,repoHash,...evalRes,...blindEval,});}}}};summary={};for(g of GROUPS){gResults=rawResults.filter((r)=>r.group===g.id);avgTotalCost=Math.round(gResults.reduce((a,b)=>a+b.totalContextCost,0)/gResults.length);avgUnderstanding=Number((gResults.reduce((a,b)=>a+b.understandingRate,0)/gResults.length).toFixed(2));avgCompliance=Number((gResults.reduce((a,b)=>a+b.complianceRate,0)/gResults.length).toFixed(2));totalWrongAssumptions=gResults.reduce((a,b)=>a+b.wrongAssumptions,0);totalUnsafeAttempts=gResults.reduce((a,b)=>a+b.unsafeAttempt,0);totalIgnoredSignal=gResults.reduce((a,b)=>a+b.ignoredSemanticSignal,0);totalHumanInquiries=gResults.reduce((a,b)=>a+b.humanInquiryCount,0);blindPassCount=gResults.filter((r)=>r.blindPass).length;passRate=Number(((blindPassCount/gResults.length)*100).toFixed(1));avgCognitiveEfficiency=Number((gResults.reduce((a,b)=>a+b.cognitiveEfficiency,0)/gResults.length).toFixed(3));summary[g.id]={groupName:g.name,avgTotalCost,avgUnderstanding,avgCompliance,totalWrongAssumptions,totalUnsafeAttempts,totalIgnoredSignal,totalHumanInquiries,passRate,avgCognitiveEfficiency,};};proto=getCcr002Signal();claimBrake={mockProves:proto.mockProves(),mockDoesNotProve:proto.mockDoesNotProve(),noMockConclusion:proto.noMockConclusion()===1,thesis:proto.thesisNow(),question:proto.questionNow(),realPhase:proto.realPhase(),modelUnobserved:proto.modelUnobserved()===1,};return{rawResults,summary,manifests,claimBrake}}
!printReportV2(data){console.log('\n==================================================================================================');console.log('                 AIN-LB / CCR-002 v2.1: AI CONTEXT DEATH (CLAIM BRAKE)                              ');console.log('==================================================================================================\n');console.log('| Group | Description                 | Total Cost | Underst % | Compl % | Unsafe Att | Ignored Sig | Human Inq | Pass Rate | Cog Efficiency |');console.log('|-------|-----------------------------|------------|-----------|---------|------------|-------------|-----------|-----------|----------------|');for(const[gid,s] of  Object.entries(data.summary)){console.log("| "+(gid.padEnd(5))+" | "+(s.groupName.slice(0, 27).padEnd(27))+" | "+(String(s.avgTotalCost).padStart(10))+" | "+((s.avgUnderstanding * 100 + '%').padStart(9))+" | "+((s.avgCompliance * 100 + '%').padStart(7))+" | "+(String(s.totalUnsafeAttempts).padStart(10))+" | "+(String(s.totalIgnoredSignal).padStart(11))+" | "+(String(s.totalHumanInquiries).padStart(9))+" | "+((s.passRate + '%').padStart(9))+" | "+(String(s.avgCognitiveEfficiency).padStart(14))+" |");};console.log('\nClaim brake: mock proves architecture can represent rules; it does not prove real models will use them.');console.log("Thesis: "+(data.claimBrake.thesis));console.log('\n==================================================================================================\n')}
!runCcr002Benchmark(opts){^runCcr002BenchmarkV2(opts)}
=ex{assertLinFixtureExports,runCcr002BenchmarkV2,printReportV2,runCcr002Benchmark}