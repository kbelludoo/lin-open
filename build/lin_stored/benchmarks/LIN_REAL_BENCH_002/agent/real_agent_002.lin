@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new RealBlindSubstrate()}
!queryLLM(prompt){t0=performance.now();for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:800,stream:false}),signal:AbortSignal.timeout(6000)});if(res.ok){data=await res.json();if(data.choices&&data.choices[0]&&data.choices[0].message){text=data.choices[0].message.content.trim();durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};try{res=await fetch((this.ollamaUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.ollamaModel,prompt,temperature:0.1,stream:false,options:{num_predict:350,num_thread:8}}),signal:AbortSignal.timeout(10000)});if(res.ok){data=await res.json();durationMs=performance.now()-t0;return{response:data.response||'',promptTokens:data.prompt_eval_count||Math.ceil(prompt.length/4),evalTokens:data.eval_count||0,durationMs,modelUsed:this.ollamaModel};}}catch(e){};throw new Error("All LLM providers unavailable")}
!extractCleanPatch(llmResponse){match=llmResponse.match(/```(?:javascript|js|lin)?\s*([\s\S]*?)```/i);code=match?match[1].trim():llmResponse.trim();code=code.replace(/^FILE:[^\n]*\n+/i,'').trim();^code}
!applyFunctionPatch(filePath,codePatch,targetSymbol){original=fs.readFileSync(filePath,'utf8');if(codePatch.includes('export function')&&codePatch.split('export function').length>2){fs.writeFileSync(filePath,codePatch,'utf8');return;};fnRegex=new RegExp("(?:export\\\\s+)?function\\\\s+"+(targetSymbol)+"\\\\s*\\\\([\\\\s\\\\S]*?\\\\n\\\\}",'g');if(fnRegex.test(original)&&codePatch.includes("function "+(targetSymbol))){updated=original.replace(fnRegex,codePatch);fs.writeFileSync(filePath,updated,'utf8');}:{fs.writeFileSync(filePath,codePatch,'utf8')}}
!runTests(repoDir){try{runnerPath=fs.existsSync(path.join(repoDir,'test/test_runner.js'))?path.join(repoDir,'test/test_runner.js'):path.join(repoDir,'tests/test_runner.js');out=execSync("node "+(runnerPath),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!findMatchingSymbol(testErrorOutput){for(const[sym,node] of  this.substrate.symbolIndex.entries()){if(testErrorOutput.includes(sym)) {return{symbol:sym,file:node.file};}};firstKey=this.substrate.symbolIndex.keys().next().value;if(firstKey){node=this.substrate.symbolIndex.get(firstKey);return{symbol:firstKey,file:node.file};};return{symbol:'unknown',file:'src/index.js'}}
!runTask(task,repoDir,arm,maxAttempts){this.substrate.indexRepository(repoDir);historyBuffer=[];initialSuccess=false;recoveredSuccess=false;rootCauseFound=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;attemptsCount=0;wrongFileEdits=0;sourceFiles=[];function scanFiles(dir){for(e of fs.readdirSync(dir,{withFileTypes:true})){if(e.name==='node_modules'||e.name==='test'||e.name==='tests') {continue;}full=path.join(dir,e.name);if(e.isDirectory()) {scanFiles(full);}:( e.name.endsWith('.js') ){sourceFiles.push(path.relative(repoDir,full))}}};scanFiles(repoDir);originalContents={};for(f of sourceFiles){originalContents[f]=fs.readFileSync(path.join(repoDir,f),'utf8');};resetFiles=()=>{for(f of sourceFiles){fs.writeFileSync(path.join(repoDir,f),originalContents[f],'utf8');}};for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;prompt='';matched=this.findMatchingSymbol(task.test_assertion_error);defaultTargetFile=matched.file||sourceFiles[0];if(arm==='RAW'){prompt="You are debugging an open-source library \\`"+(task.repo)+"\\`.\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Repository Source Code]\\n";for(f of sourceFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Provide the complete fixed JavaScript code for the modified function/file inside a single \\`\\`\\`javascript code block.";}:( arm==='CHAT_HISTORY' ){histText=historyBuffer.map(h=>"[Attempt "+(h.attempt)+" Failed]:\\n"+(h.testOutput)).join('\n\n');prompt="You are debugging an open-source library \\`"+(task.repo)+"\\`.\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";if(histText) {prompt+="[Previous Attempt History]\\n"+(histText)+"\\n\\n";};prompt+="[Repository Source Code]\\n";for(f of sourceFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Provide the complete fixed JavaScript code for the modified function/file inside a single \\`\\`\\`javascript code block."}:( arm==='FULL_LIN' ){focused=this.substrate.generateFocusedContext(matched.symbol);prompt="[LIN 50K Canonical Semantic Substrate (Attempt "+(attempt)+")]\\n";prompt+="* Target Canonical Symbol: "+(matched.symbol)+" in '"+(defaultTargetFile)+"'\\n";prompt+="* Declared Effect: *("+(focused ? focused.effect : 'Pure')+")\\n";prompt+="* Active Invariants: ["+(focused ? focused.invariants.join('; ') : 'ret !== undefined')+"]\\n";prompt+="* Transitive Dependents: ["+(focused ? focused.dependents.join(', ') : 'None')+"]\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Target File Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(matched.symbol)+" or "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;codePatch=this.extractCleanPatch(llm.response);if(!codePatch) {continue;}targetFilePath=path.join(repoDir,defaultTargetFile);if(defaultTargetFile===task.ground_truth.file){rootCauseFound=true;}:{wrongFileEdits++};this.applyFunctionPatch(targetFilePath,codePatch,matched.symbol);testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}break;}:{resetFiles();historyBuffer.push({attempt,file:defaultTargetFile,testOutput:testRes.output.slice(0,150)})}};resetFiles();return{task_id:task.task_id,repo:task.repo,arm,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,rootCauseFound,attempts:attemptsCount,wrongFileEdits,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs}}
=ex{constructor,queryLLM,extractCleanPatch,applyFunctionPatch,runTests,findMatchingSymbol,runTask}