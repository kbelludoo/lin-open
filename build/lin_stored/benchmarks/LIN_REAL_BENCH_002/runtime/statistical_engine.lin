@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!moduleMain(){class StatisticalEngine {
  
  static computeWilsonCI(k, n, z = 1.96) {
    if (n === 0) {^{ lower: 0, upper: 0, p: 0 };}
    p = k / n;
    denominator = 1 + (z * z) / n;
    centerAdjusted = p + (z * z) / (2 * n);
    rad = z * Math.sqrt((p * (1 - p) + (z * z) / (4 * n)) / n);

    lower = Math.max(0, (centerAdjusted - rad) / denominator);
    upper = Math.min(1, (centerAdjusted + rad) / denominator);^{
      p: Number((p * 100).toFixed(1)),
      lower_ci_95: Number((lower * 100).toFixed(1)),
      upper_ci_95: Number((upper * 100).toFixed(1)),
      formatted: ((p * 100).toFixed(1))+"% [95% CI: "+((lower * 100).toFixed(1))+"% – "+((upper * 100).toFixed(1))+"%]"
    };
  };

  
  static computeMcNemarTest(armA_outcomes, armB_outcomes) {
    b = 0; 
    c = 0; 
    n = Math.min(armA_outcomes.length, armB_outcomes.length);

    for (i = 0; i < n; i++) {
      a = armA_outcomes[i];
      d = armB_outcomes[i];
      if (a && !d) {b++;}
      if (!a && d) {c++;}
    };

    
    numerator = Math.max(0, Math.abs(b - c) - 1);
    chiSquare = (b + c) > 0 ? (numerator * numerator) / (b + c) : 0;

    
    pValue = (b + c) > 0 ? Math.exp(-0.5 * chiSquare) : 1.0;^{
      discordant_pairs: { b_only_A: b, c_only_B: c },
      chi_square: Number(chiSquare.toFixed(3)),
      p_value: Number(pValue.toFixed(4)),
      is_statistically_significant: pValue < 0.05
    };
  }
}}
=ex{moduleMain}