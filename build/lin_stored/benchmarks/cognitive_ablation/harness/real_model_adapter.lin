@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(baseUrl,provider,model,temperature,seed,systemPrompt,promptMode){this.baseUrl=baseUrl.replace(/\/+$/,'');this.provider=provider;this.model=model;this.temperature=temperature;this.seed=seed;this.systemPrompt=systemPrompt;this.promptMode=promptMode}
!getModelMetadata(){if(this.provider==='ollama'){try{res=await fetch((this.baseUrl)+"/api/show",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:this.model})});if(res.ok){info=await res.json();return{provider:'ollama',model:this.model,digest:info.digest||'unknown',details:info.details||{},parameters:info.parameters||''};}}catch(e){}};return{provider:this.provider,model:this.model,digest:'unknown',details:{}}}
!buildPrompt(task,attempt,traumaHistory){if(this.promptMode==='NATURAL_JS'){^"Task ID: "+(task.id)+" ("+(task.family)+")\nSpecification: "+(task.specification)+"\nConstraints: Write a pure JavaScript function named \"solve\" that accepts \"input\" and returns the result. Do not use external libraries.\n\nOutput ONLY valid JavaScript code for function solve(input):";};prompt="@LIN:1.0\nTask: "+(task.id)+" ("+(task.family)+")\nSpec: "+(task.specification)+"\nForbidden effects: "+(task.forbidden_effects && task.forbidden_effects.length ? task.forbidden_effects.join(', ') : 'none')+"\n\nGrammar rules:\n- Function: !solve(input){ ... }\n- Return: ^expression\n- Conditionals: ?(cond){ ... } or ?(cond){ ... }:(cond2){ ... }:{ ... }\n- Loops: #(i=0; i<len; i++){ ... }\n- Pure assignments: a = 1; b = 2;\n\nOutput ONLY the raw LIN function !solve(input){ ... } without markdown or explanations.";if(attempt>1&&traumaHistory.length>0){if(this.promptMode==='LIN_UNSTRUCTURED'){lastErr=traumaHistory[traumaHistory.length-1];prompt+="\\n\\n[RETRY FEEDBACK]: Previous attempt failed. Error: "+(lastErr.error_message || 'Verification failed')+". Fix the error and;try again.";}:( this.promptMode==='LIN_TRAUMA' ){lastTrauma=traumaHistory[traumaHistory.length-1];prompt+="\\n\\n[TRAUMA CONSTRAINTS - DO NOT REPEAT]:\n.trauma {\n  .stage = \""+(lastTrauma.stage)+"\"\n  .violation = \""+(lastTrauma.violation_class)+"\"\n  .rule = \""+(lastTrauma.constraint_rule)+"\"\n  .invariant = \""+(lastTrauma.invariant_broken)+"\"\n  .hint = \""+(lastTrauma.remedy_hint)+"\"\n}\nYou MUST obey these constraints on this retry. Output fixed !solve(input){ ... }:"}};^prompt}
!extractCode(rawText){text=rawText.trim();codeBlockMatch=text.match(/```(?:lin|lia|js|javascript)?\s*([\s\S]*?)```/);if(codeBlockMatch){text=codeBlockMatch[1].trim();};^text}
!generateCandidate(task,attempt,traumaHistory){prompt=this.buildPrompt(task,attempt,traumaHistory);startTime=Date.now();rawText='';promptTokens='UNAVAILABLE';completionTokens='UNAVAILABLE';totalTokens='UNAVAILABLE';if(this.provider==='ollama'){res=await fetch((this.baseUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.model,prompt,system:this.systemPrompt||undefined,stream:false,options:{temperature:this.temperature,seed:this.seed}})});if(!res.ok){throw new Error("Ollama error ("+(res.status)+"): "+(await res.text()));};data=await res.json();rawText=data.response||'';promptTokens=typeof data.prompt_eval_count==='number'?data.prompt_eval_count:'UNAVAILABLE';completionTokens=typeof data.eval_count==='number'?data.eval_count:'UNAVAILABLE';totalTokens=typeof promptTokens==='number'&&typeof completionTokens==='number'?promptTokens+completionTokens:'UNAVAILABLE';}:{res=await fetch((this.baseUrl)+"/v1/chat/completions",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.model,messages:[...(this.systemPrompt?[{role:'system',content:this.systemPrompt}]:[]),{role:'user',content:prompt}],temperature:this.temperature,seed:this.seed})});if(!res.ok){throw new Error("API error ("+(res.status)+"): "+(await res.text()));};data=await res.json();choice=data.choices&&data.choices[0];rawText=choice&&choice.message?choice.message.content:'';if(data.usage){promptTokens=data.usage.prompt_tokens??'UNAVAILABLE';completionTokens=data.usage.completion_tokens??'UNAVAILABLE';totalTokens=data.usage.total_tokens??'UNAVAILABLE';}};latency_ms=Date.now()-startTime;candidateCode=this.extractCode(rawText);candidate_hash=createHash('sha256').update(candidateCode).digest('hex').slice(0,16);return{candidate_code:candidateCode,raw_output:rawText,candidate_hash,prompt_tokens:promptTokens,completion_tokens:completionTokens,tokens:typeof totalTokens==='number'?totalTokens:0,latency_ms}}
=ex{constructor,getModelMetadata,buildPrompt,extractCode,generateCandidate}