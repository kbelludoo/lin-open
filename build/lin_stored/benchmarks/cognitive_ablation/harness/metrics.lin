@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!calculateMetrics(taskResults){N=taskResults.length;if(N===0){throw new Error('Não é possível calcular métricas sobre um conjunto vazio de tarefas.');};P1=0;PR=0;FF=0;F1=0;totalTokensSuccess=0;totalAttemptsSuccess=0;successCount=0;repeatedErrorCount=0;totalRetryFailures=0;for(res of taskResults){attempts=res.attempts||[];k1=attempts[0];initialPassed=k1&&k1.oracle_passed===true&&k1.verifier_passed===true;if(initialPassed){P1++;}:{F1++};if(res.outcome==='P1'){successCount++;totalTokensSuccess+=res.total_tokens||0;totalAttemptsSuccess+=res.attempts_count||1;}:( res.outcome==='PR' ){PR++;successCount++;totalTokensSuccess+=res.total_tokens||0;totalAttemptsSuccess+=res.attempts_count||attempts.length}:( res.outcome==='FF' ){FF++}:{throw new Error("Desfecho desconhecido: "+(res.outcome))};for(i=1;i<attempts.length;i++){prev=attempts[i-1];curr=attempts[i];if(prev&&!prev.verifier_passed&&curr&&!curr.verifier_passed){totalRetryFailures++;if(prev.violation_class&&curr.violation_class&&prev.violation_class===curr.violation_class){repeatedErrorCount++;}}}};if(P1+PR+FF!==N){throw new Error("Invariante violada: P1 ("+(P1)+") + PR ("+(PR)+") + FF ("+(FF)+") !== N ("+(N)+")");};pass_at_1=P1/N;pass_at_k=(P1+PR)/N;recovery_success_rate=F1>0?PR/F1:null;avg_tokens_per_pass=successCount>0?totalTokensSuccess/successCount:0;avg_attempts_per_pass=successCount>0?totalAttemptsSuccess/successCount:0;error_repetition_rate=totalRetryFailures>0?repeatedErrorCount/totalRetryFailures:0;return{total_tasks:N,initial_pass_p1:P1,initial_fail_f1:F1,recovered_pass_pr:PR,final_fail_ff:FF,pass_at_1:Number(pass_at_1.toFixed(6)),pass_at_k:Number(pass_at_k.toFixed(6)),recovery_success_rate:recovery_success_rate!==null?Number(recovery_success_rate.toFixed(6)):null,avg_tokens_per_pass:Number(avg_tokens_per_pass.toFixed(2)),avg_attempts_per_pass:Number(avg_attempts_per_pass.toFixed(4)),error_repetition_rate:Number(error_repetition_rate.toFixed(6)),counters:{repeated_error_count:repeatedErrorCount,total_retry_failures:totalRetryFailures}}}
=ex{calculateMetrics}