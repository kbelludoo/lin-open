@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!runFull30Audit(){BASE_DIR='/home/k/Downloads/lin-master/benchmarks/cognitive_ablation';MANIFEST_PATH=path.join(BASE_DIR,'MANIFEST.json');console.log('🔬 Iniciando Auditoria Completa das 30 Tarefas do Dataset V1...');manifest=JSON.parse(fs.readFileSync(MANIFEST_PATH,'utf-8'));assert.strictEqual(manifest.total_tasks,30,'O manifesto deve conter exatamente 30 tarefas');tasks=[];oracles={};for(entry of manifest.tasks){taskPath=path.join(BASE_DIR,'tasks',(entry.id)+".json");task=JSON.parse(fs.readFileSync(taskPath,'utf-8'));tasks.push(task);oracleModulePath=path.join(BASE_DIR,entry.oracle_entrypoint);mod=await import("file://"+(oracleModulePath));oracles[entry.id]=mod.oracle;};console.log('  ✅ 30 tarefas e 30 oráculos independentes carregados com sucesso.');solutions=JSON.parse(fs.readFileSync(path.join(BASE_DIR,'task_solutions.json'),'utf-8'));trajectoryMap={};for(i=1;i<=12;i++){id="T"+(String(i).padStart(3, '0'));trajectoryMap[id]='M01';};for(i=13;i<=20;i++){id="T"+(String(i).padStart(3, '0'));trajectoryMap[id]='M02';};for(i=21;i<=22;i++){id="T"+(String(i).padStart(3, '0'));trajectoryMap[id]='M03';};for(i=23;i<=30;i++){id="T"+(String(i).padStart(3, '0'));trajectoryMap[id]='M04';};mockAdapter=new MockModelAdapter(trajectoryMap,solutions);verifierAdapter=new LinVerifierAdapter();runner=new CognitiveBenchmarkRunner({modelAdapter:mockAdapter,verifierAdapter,feedbackMode:'TRAUMA'});console.log('  🚀 Executando Benchmark Runner sobre as 30 tarefas...');runResult=await runner.runBenchmark({tasks,oracles,manifestSha256:manifest.global_sha256,systemId:'E',modelId:'mock-audit-v1'});s=runResult.summary;console.log('\n📊 Resumo das Métricas Obtidas:');console.log("  Total Tasks (N): "+(s.total_tasks));console.log("  P1 (Initial Pass): "+(s.initial_pass_p1));console.log("  F1 (Initial Fail): "+(s.initial_fail_f1));console.log("  PR (Recovered Pass): "+(s.recovered_pass_pr));console.log("  FF (Final Fail): "+(s.final_fail_ff));console.log("  pass@1: "+(s.pass_at_1));console.log("  pass@3: "+(s.pass_at_k));console.log("  RSR (Recovery Success Rate): "+(s.recovery_success_rate));console.log("  Média de tentativas em sucesso: "+(s.avg_attempts_per_pass));assert.strictEqual(s.total_tasks,30,'N deve ser 30');assert.strictEqual(s.initial_pass_p1,12,'P1 deve ser 12');assert.strictEqual(s.initial_fail_f1,18,'F1 deve ser 18');assert.strictEqual(s.recovered_pass_pr,10,'PR deve ser 10');assert.strictEqual(s.final_fail_ff,8,'FF deve ser 8');assert.strictEqual(s.pass_at_1,0.40,'pass@1 deve ser 0.40');assert.strictEqual(s.pass_at_k,Number((22/30).toFixed(6)),'pass@3 deve ser 22/30 (~0.733333)');assert.strictEqual(s.recovery_success_rate,Number((10/18).toFixed(6)),'RSR deve ser 10/18 (~0.555556)');console.log('\n🔒 AUDITORIA DAS 30 TAREFAS PASSOU COM SUCESSO ABSOLUTO!');console.log("🔒 Dataset Congelado: "+(manifest.dataset_id)+" | SHA-256: "+(manifest.global_sha256))}
!_anon1(err){console.error('❌ ERRO NA AUDITORIA COMPLETA:',err);process.exit(1)}
=ex{runFull30Audit,_anon1}