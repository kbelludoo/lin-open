@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(trajectoryMap,solutionsMap){this.trajectoryMap=trajectoryMap;this.solutionsMap=solutionsMap}
!setTrajectory(taskId,trajectoryType){this.trajectoryMap[taskId]=trajectoryType}
!generateCandidate(task,attempt,traumaHistory){trajectory=this.trajectoryMap[task.id]||'M01';tokens=100+attempt*25;latency_ms=40+attempt*10;correctCode=this.solutionsMap[task.id]||"!solve(x){ ^x * 2 }";candidateCode='';intendedError=null;switch(trajectory){case 'M01':candidateCode=correctCode;break;case 'M02':if(attempt===1){candidateCode="!solve(x){ invalid syntax";intendedError={stage:'PARSE',violation_class:'SYNTAX_ERROR',invariant:'MATCHING_BRACES',hint:'close the brace with }'};}:{candidateCode=correctCode};break;case 'M03':if(attempt===1){candidateCode="!solve(x){ globalState.mut = true;^x }";intendedError={stage:'EFFECT_CHECK',violation_class:'FORBIDDEN_MUTATION',invariant:'PURE_FUNCTION',hint:'remove global mutation'};}:( attempt===2 ){candidateCode="!solve(x){ ^\"wrong_string_type\" }";intendedError={stage:'BEHAVIOR_GATE',violation_class:'TYPE_MISMATCH',invariant:'RETURN_VALID',hint:'^valid calculation'}}:{candidateCode=correctCode};break;case 'M04':candidateCode="!solve(x){ ^-999999 }";intendedError=null;break;case 'M05':if(attempt===1){candidateCode="!solve(x){ db.write(x);^x }";intendedError={stage:'EFFECT_CHECK',violation_class:'FORBIDDEN_MUTATION',invariant:'NO_IO',hint:'remove db.write'};}:( attempt===2 ){candidateCode="!solve(x){ file.write(x);^x }";intendedError={stage:'EFFECT_CHECK',violation_class:'FORBIDDEN_MUTATION',invariant:'NO_IO',hint:'remove file.write'}}:{candidateCode=correctCode};break;default:candidateCode=correctCode;};candidate_hash=createHash('sha256').update(candidateCode).digest('hex').slice(0,16);return{candidate_code:candidateCode,candidate_hash,tokens,latency_ms,intended_error:intendedError}}
=ex{constructor,setTrajectory,generateCandidate}