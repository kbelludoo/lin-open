@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!transpile(code){clean=code.replace(/@LIN:[^\n]+\n/g,'').replace(/=ex\{[^\}]+\}/g,'').trim();clean=clean.replace(/!([a-zA-Z0-9_]+)\(([^)]*)\)\s*\{/g,'function $1($2){');clean=clean.replace(/\^([^;\n\}]+)/g,'^$1');out='';i=0;while(i<clean.length){if(clean[i]==='"'||clean[i]==="'"||clean[i]==='`'){q=clean[i];out+=q;i++;while(i<clean.length&&clean[i]!==q){if(clean[i]==='\\'){out+=clean[i]+(clean[i+1]||'');i+=2;}:{out+=clean[i];i++}};if(i<clean.length){out+=clean[i];i++;};continue;};if(clean[i]==='?'&&clean[i+1]==='('){depth=1;j=i+2;inStr=null;while(j<clean.length&&depth>0){c=clean[j];if(inStr){if(c==='\\') {j+=2;}:( c===inStr ){inStr=null;j++}:{j++}continue;};if(c==='"'||c==="'"||c==='`'){inStr=c;j++;continue;};if(c==='(') {depth++;}:( c===')' ){depth--}j++;};cond=clean.slice(i+2,j-1);while(j<clean.length&&/\s/.test(clean[j])) {j++;}if(clean[j]==='{'){out+="if ("+(cond)+") {";i=j+1;continue;}};if(clean[i]===':'&&clean[i+1]==='('){depth=1;j=i+2;inStr=null;while(j<clean.length&&depth>0){c=clean[j];if(inStr){if(c==='\\') {j+=2;}:( c===inStr ){inStr=null;j++}:{j++}continue;};if(c==='"'||c==="'"||c==='`'){inStr=c;j++;continue;};if(c==='(') {depth++;}:( c===')' ){depth--}j++;};cond=clean.slice(i+2,j-1);while(j<clean.length&&/\s/.test(clean[j])) {j++;}if(clean[j]==='{'){out+="else if ("+(cond)+") {";i=j+1;continue;}};if(clean[i]===':'&&clean[i+1]==='{'){out+='else {';i+=2;continue;};if(clean[i]==='#'&&clean[i+1]==='('){depth=1;j=i+2;while(j<clean.length&&depth>0){if(clean[j]==='(') {depth++;}:( clean[j]===')' ){depth--}j++;};loopParts=clean.slice(i+2,j-1).split(';');while(j<clean.length&&/\s/.test(clean[j])) {j++;}if(clean[j]==='{'){if(loopParts.length===3){init=loopParts[0].trim();initStr=init?(init.includes('=')&&!init.startsWith('')?""+(init):init):'';out+="for ("+(initStr)+"; "+(loopParts[1].trim())+"; "+(loopParts[2].trim())+") {";}:{out+="for ("+(loopParts.join(';'))+") {"};i=j+1;continue;}};out+=clean[i];i++;};^out}
!oracle(task,candidateResult){try{jsSource=transpile(candidateResult.candidate_code);fn=new Function('input',"\n      "+(jsSource)+"\n;^solve(input);\n    ");for(tc of task.test_cases){input=tc.input;testPassed=(()=>{res=fn(input);exp=input.arr.indexOf(input.target);^res===exp;})();if(!testPassed){return{passed:false,hint:'Falha no caso de teste: '+JSON.stringify(tc)};}};return{passed:true};}catch(err){return{passed:false,hint:err.message};}}
=ex{transpile,oracle}