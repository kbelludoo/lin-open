^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.substrate=new SemanticSubstrate();this.trauma=new TraumaLedger();this.verifier=new VerifierGate(this.substrate);this.localizer=new SemanticLocalizer(this.substrate,this.trauma)}
!parseSSE(response){raw=await response.text();text="";for(line of raw.split("\n")){if(line.startsWith("data: ")){chunk=line.slice(6).trim();if(chunk==="[DONE]") {continue;}try{p=JSON.parse(chunk);if(p.choices&&p.choices[0]){if(p.choices[0].delta&&p.choices[0].delta.content){text+=p.choices[0].delta.content;}:( p.choices[0].text ){text+=p.choices[0].text}}}catch(e){}}};if(!text){try{p=JSON.parse(raw);if(p.choices&&p.choices[0]){text=p.choices[0].message?p.choices[0].message.content:p.choices[0].text;}}catch(e){}};^text.trim()}
!queryLLM(prompt){t0=performance.now();for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:800}),signal:AbortSignal.timeout(10000)});if(res.ok){text=await this.parseSSE(res);if(text){durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};throw new Error("All LLM providers unavailable")}
!extractFileAndPatch(llmResponse,availableFiles){targetFile=null;for(f of availableFiles){if(llmResponse.includes(f)||llmResponse.includes(path.basename(f))){targetFile=f;break;}};if(!targetFile) {targetFile=availableFiles[0];}match=llmResponse.match(/```(?:javascript|js)?\s*([\s\S]*?)```/i);code=match?match[1].trim():null;return{targetFile,code}}
!runTests(repoDir){try{out=execSync("node "+(path.join(repoDir, 'tests/test_runner.js')),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!runBlindTask(task,repoDir,group,maxAttempts){this.trauma.clear();historyBuffer=[];initialSuccess=false;recoveredSuccess=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;attemptsCount=0;wrongFileEdits=0;rootCauseFound=false;availableFiles=['src/parser.js','src/comparator.js','src/ranges.js','src/satisfier.js'];originalFiles={};for(f of availableFiles){originalFiles[f]=fs.readFileSync(path.join(repoDir,f),'utf8');};resetFiles=()=>{for(f of availableFiles){fs.writeFileSync(path.join(repoDir,f),originalFiles[f],'utf8');}};for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;prompt='';if(group==='RAW'){prompt="You are an expert debugger fixing a bug in an open-source SemVer repository.\\n\\n";prompt+="[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Repository Files]\\n";for(f of availableFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Identify which file contains the root cause bug and provide the complete fixed file code.\\n";prompt+="Format response:\\nFILE: <filepath>\\n\\`\\`\\`javascript\\n<complete fixed code>\\n\\`\\`\\`";}:( group==='CHAT_HISTORY' ){histText=historyBuffer.map(h=>"[Attempt "+(h.attempt)+" Failed Patch on "+(h.file)+"]:\\n"+(h.testOutput)).join('\n\n');prompt="You are an expert debugger fixing a bug in an open-source SemVer repository.\\n\\n";prompt+="[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";if(histText){prompt+="[Previous Attempt Failures & Terminal Errors]\\n"+(histText)+"\\n\\n";};prompt+="[Repository Files]\\n";for(f of availableFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Identify which file contains the root cause bug and provide the complete fixed file code.\\n";prompt+="Format response:\\nFILE: <filepath>\\n\\`\\`\\`javascript\\n<complete fixed code>\\n\\`\\`\\`"}:( group==='LIN' ){entrySym=this.localizer.identifyEntrySymbol(task.test_assertion_error);candidates=this.localizer.localizeCandidates(entrySym);traumaPrompt=this.trauma.generateTraumaPrompt();topCandidate=candidates.find(c=>!c.isRefuted)||candidates[0];focusedContext=this.substrate.generateFocusedContext(topCandidate.symbol);prompt="[LIN Semantic State Context]\\n";prompt+="* Entry Failure Symbol: "+(entrySym)+"\\n";prompt+="* Active Call-DAG Search Candidates: ["+(candidates.map(c => (c.symbol)+" ("+(c.module)+")"+(c.isRefuted ? ' [REFUTED]' : '')).join(', '))+"]\\n";prompt+="* Primary Candidate: "+(topCandidate.symbol)+" in '"+(topCandidate.module)+"'\\n";prompt+="* Declared Effect: *("+(focusedContext.effect)+")\\n";prompt+="* Downstream Transitive Dependents: ["+(focusedContext.dependents.join(', '))+"]\\n";if(traumaPrompt){prompt+="\\n"+(traumaPrompt)+"\\n";};prompt+="\\n[Bug Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Error]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Candidate Module Code: "+(topCandidate.module)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, topCandidate.module), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(topCandidate.module)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;__d3545=this.extractFileAndPatch(llm.response,availableFiles);targetFile=__d3545.targetFile;code=__d3545.code;if(!code){continue;};if(targetFile===task.ground_truth.file){rootCauseFound=true;}:{wrongFileEdits++};fs.writeFileSync(path.join(repoDir,targetFile),code,'utf8');testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}break;}:{resetFiles();historyBuffer.push({attempt,file:targetFile,testOutput:testRes.output.slice(0,250)});this.trauma.recordFailure({attempt,targetSymbol:targetFile,brokenInvariant:'TEST_ASSERTION_FAILED',errorDiagnostic:testRes.output.slice(0,180),refutedHypothesis:"Attempt "+(attempt)+" edited '"+(targetFile)+"' but failed to satisfy test suite"})}};resetFiles();return{task_id:task.task_id,group,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,rootCauseFound,attempts:attemptsCount,wrongFileEdits,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs}}
=ex{constructor,parseSSE,queryLLM,extractFileAndPatch,runTests,runBlindTask}