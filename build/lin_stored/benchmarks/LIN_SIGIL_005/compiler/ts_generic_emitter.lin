@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!emitTypeScript(ir){code="// Auto-generated Generic TypeScript from LIN IR\\n\\n";function emitFn(fn,schemaInvariants=[]){paramsList=fn.params.map(p=>p.name).join(', ');fnCode="export function "+(fn.name)+"("+(paramsList)+") {\\n";isPure=fn.effects.some(e=>e.toLowerCase()==='pure');for(c of fn.contracts){if(c.kind==='pre'){fnCode+="  if (!("+(c.expr)+")) throw new Error(\"PRECONDITION_VIOLATED\");\\n";}};fnCode+="  __old = (typeof self !== 'undefined' && self) ? JSON.parse(JSON.stringify(self)) : {};\\n";bodyCode=fn.body.replace(/\^/g,'^').replace(/Math\.floor/g,'Math.floor');fnCode+="  __exec = () => {\\n    "+(bodyCode)+"\\n  };\\n";fnCode+="  result = __exec();\\n";for(inv of schemaInvariants){fnCode+="  if (typeof self !== 'undefined' && self && !("+(inv.expr)+")) throw new Error(\"INVARIANT_VIOLATED\");\\n";};for(c of fn.contracts){if(c.kind==='post'){postExpr=c.expr.replace(/old\(self\.(\w+)\)/g,'__old.$1');fnCode+="  if (!("+(postExpr)+")) throw new Error(\"POSTCONDITION_VIOLATED\");\\n";}};fnCode+="  ^result;\\n}\\n\\n";^fnCode;};for(schema of ir.schemas){for(method of schema.methods){code+=emitFn(method,schema.invariants);}};for(fn of ir.functions){code+=emitFn(fn,[]);};^code}
=ex{emitTypeScript}