@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!parseLinToIR(source){lines=source.split('\n');schemas=[];functions=[];currentSchema=null;currentFn=null;for(i=0;i<lines.length;i++){line=lines[i].trim();if(!line||line.startsWith('@')||line.startsWith('~G')) {continue;}if(line.startsWith('~')&&!line.startsWith('~G')){match=line.match(/^~([A-Za-z_][\w]*)/);if(match){currentSchema={name:match[1],invariants:[],effects:['HeapMut'],methods:[]};schemas.push(currentSchema);}}:( line.startsWith('!')&&(line.includes('(')&&line.includes(')')) ){match=line.match(/^!([A-Za-z_][\w]*)\s*\(([^)]*)\)(?:\s*->\s*([A-Za-z_][\w]*))?/);if(match){fnName=match[1];paramsRaw=match[2].trim();retType=match[3]||'i32';params=paramsRaw?paramsRaw.split(',').map(p=>{parts=p.trim().split(':');return{name:parts[0].trim(),type:(parts[1]||'i32').trim()};}):[];currentFn={name:fnName,params,returnType:retType,contracts:[],effects:['Pure'],body:''};if(currentSchema){currentSchema.methods.push(currentFn);}:{functions.push(currentFn)}}}:( line.startsWith('%') ){clean=line.substring(1).trim().replace(/^\(/,'').replace(/\)$/,'').trim();colonIdx=clean.indexOf(':');if(colonIdx>0){kind=clean.slice(0,colonIdx).trim();expr=clean.slice(colonIdx+1).trim();contractNode={kind,expr};if(currentFn){currentFn.contracts.push(contractNode);}:( currentSchema ){currentSchema.invariants.push(contractNode)}}}:( line.startsWith('*') ){clean=line.substring(1).trim().replace(/[()]/g,'').trim();if(currentFn){currentFn.effects=[clean];}:( currentSchema ){currentSchema.effects=[clean]}}:( currentFn&&line.startsWith('{') ){bodyLines=[];i++;while(i<lines.length&&!lines[i].trim().startsWith('}')){bodyLines.push(lines[i]);i++;};currentFn.body=bodyLines.join('\n').trim();currentFn=null}:( line==='}'&&currentSchema ){currentSchema=null}};return{protocol:'LIN_TYPED_IR/1.0',schemas,functions}}
=ex{parseLinToIR}