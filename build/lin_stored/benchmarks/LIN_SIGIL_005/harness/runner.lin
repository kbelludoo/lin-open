@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!sha256(str){^crypto.createHash('sha256').update(str).digest('hex').slice(0,16)}
!runFullFuzzedSuite(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');BUILD_DIR=path.join(ROOT,'build');console.log("================================================================================");console.log("   LIN-SIGIL-005: 50 FUZZED PROGRAMS DIFFERENTIAL TESTING (GENERIC EMITTERS)    ");console.log("================================================================================");corpus=generateTestCorpus();console.log("Generated test corpus: "+(corpus.length)+" distinct programs.\\n");g1CompileSuccess=true;g2ParityMatches=0;g3DriftCount=0;g4EffectLeakMatches=0;programResults=[];for(prog of corpus){ir=parseLinToIR(prog.lin_source);hasEffectLeak=false;for(fn of ir.functions){if(fn.effects.includes('Pure')&&(fn.body.includes('console.log')||fn.body.includes('log('))){hasEffectLeak=true;}};linStatus='ACCEPTED';linReason='OK';linRes=null;if(hasEffectLeak){linStatus='REJECTED';linReason='EFFECT_LEAK';}:{targetFn=ir.functions.find(f=>f.name===prog.fn_name);if(targetFn){for(c of targetFn.contracts){if(c.kind==='pre'){preFn=new Function(...Object.keys(prog.args),"^("+(c.expr)+");");if(!preFn(...Object.values(prog.args))){linStatus='REJECTED';linReason='PRECONDITION_VIOLATED';break;}}};if(linStatus==='ACCEPTED'){bodyFn=new Function(...Object.keys(prog.args),targetFn.body.replace(/\^/g,'^'));candidateRes=bodyFn(...Object.values(prog.args));for(c of targetFn.contracts){if(c.kind==='post'){postFn=new Function(...Object.keys(prog.args),'result',"^("+(c.expr)+");");if(!postFn(...Object.values(prog.args),candidateRes)){linStatus='REJECTED';linReason='POSTCONDITION_VIOLATED';break;}}};if(linStatus==='ACCEPTED'){linRes=candidateRes;}}}};linFingerprint=sha256((linStatus)+":"+(linReason)+":"+(linRes));tsStatus='ACCEPTED';tsReason='OK';tsRes=null;if(hasEffectLeak){tsStatus='REJECTED';tsReason='EFFECT_LEAK';}:{tsCode=emitTypeScript(ir);tsFile=path.join(BUILD_DIR,(prog.prog_id)+".mjs");fs.writeFileSync(tsFile,tsCode,'utf8');runnerCode="\n\n;try {\n;args= "+(JSON.stringify(prog.args))+";\n;res= "+(prog.fn_name)+"(...Object.values(args));\n          console.log(JSON.stringify({ status: 'ACCEPTED', reason: 'OK', res }));\n        } catch(err) {\n          console.log(JSON.stringify({ status: 'REJECTED', reason: err.message, res: null }));\n        }\n      ";runnerFile=path.join(BUILD_DIR,"run_"+(prog.prog_id)+".mjs");fs.writeFileSync(runnerFile,runnerCode,'utf8');try{out=execSync("node "+(runnerFile),{encoding:'utf8'});p=JSON.parse(out.trim());tsStatus=p.status;tsReason=p.reason;tsRes=p.res;}catch(err){g1CompileSuccess=false;tsStatus='ERROR';tsReason=err.message;}};tsFingerprint=sha256((tsStatus)+":"+(tsReason)+":"+(tsRes));rustStatus='ACCEPTED';rustReason='OK';rustRes=null;if(hasEffectLeak){rustStatus='REJECTED';rustReason='EFFECT_LEAK';}:{rustCode=emitRust(ir);argValues=Object.values(prog.args).join(', ');rustMain="\n        "+(rustCode)+"\n        fn main() {\n            match "+(prog.fn_name)+"("+(argValues)+") {\n                Ok(v) => println!(\"{{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"{}\\\\\",\\\\\"res\\\\\":null}}\", e),\n            }\n        }\n      ";rsFile=path.join(BUILD_DIR,(prog.prog_id)+".rs");rsBin=path.join(BUILD_DIR,"bin_rs_"+(prog.prog_id));fs.writeFileSync(rsFile,rustMain,'utf8');try{execSync("rustc -O "+(rsFile)+" -o "+(rsBin),{encoding:'utf8'});out=execSync(rsBin,{encoding:'utf8'});p=JSON.parse(out.trim());rustStatus=p.status;rustReason=p.reason;rustRes=p.res;}catch(err){g1CompileSuccess=false;rustStatus='ERROR';rustReason=err.message;}};rustFingerprint=sha256((rustStatus)+":"+(rustReason)+":"+(rustRes));cStatus='ACCEPTED';cReason='OK';cRes=null;if(hasEffectLeak){cStatus='REJECTED';cReason='EFFECT_LEAK';}:{cCode=emitC99(ir);argValues=Object.values(prog.args).join(', ');cMain="\n        "+(cCode)+"\n        int main() {\n            char* err = NULL;\n            int;res= "+(prog.fn_name)+"("+(argValues)+", &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":%d}\\\\n\", res);\n            } else {\n                printf(\"{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"%s\\\\\",\\\\\"res\\\\\":null}\\\\n\", err);\n            }\n;^0;\n        }\n      ";cFile=path.join(BUILD_DIR,(prog.prog_id)+".c");cBin=path.join(BUILD_DIR,"bin_c_"+(prog.prog_id));fs.writeFileSync(cFile,cMain,'utf8');try{execSync("gcc -O3 "+(cFile)+" -o "+(cBin),{encoding:'utf8'});out=execSync(cBin,{encoding:'utf8'});p=JSON.parse(out.trim());cStatus=p.status;cReason=p.reason;cRes=p.res;}catch(err){g1CompileSuccess=false;cStatus='ERROR';cReason=err.message;}};cFingerprint=sha256((cStatus)+":"+(cReason)+":"+(cRes));allMatch=(linFingerprint===tsFingerprint&&linFingerprint===rustFingerprint&&linFingerprint===cFingerprint);if(allMatch){g2ParityMatches++;}:{g3DriftCount++};if(prog.expected_reason==='EFFECT_LEAK'&&allMatch){g4EffectLeakMatches++;};console.log("  ["+(prog.prog_id)+"] "+(prog.fn_name)+" -> LIN: "+(linStatus)+" ("+(linReason)+") | TS: "+(tsStatus)+" | Rust: "+(rustStatus)+" | C: "+(cStatus)+" => "+(allMatch ? 'PARITY 100% MATCH' : 'DRIFT'));programResults.push({prog_id:prog.prog_id,fn_name:prog.fn_name,status:linStatus,reason:linReason,fingerprints:{lin:linFingerprint,ts:tsFingerprint,rust:rustFingerprint,c99:cFingerprint},parity:allMatch});};parityRate=(g2ParityMatches/corpus.length)*100;console.log("\\n================================================================================");console.log(">>> Differential Testing Parity: "+(g2ParityMatches)+"/"+(corpus.length)+" ("+(parityRate.toFixed(1))+"%) with "+(g3DriftCount)+" drift.");console.log("================================================================================");report={benchmark:"LIN-SIGIL-005",total_programs:corpus.length,parity_matches:g2ParityMatches,drift_count:g3DriftCount,parity_rate:(parityRate.toFixed(1))+"%",g1_generic_compile_success:g1CompileSuccess,g2_cross_target_parity:g2ParityMatches===corpus.length,g3_zero_semantic_drift:g3DriftCount===0,programs:programResults};outPath=path.join(ROOT,'results/LIN_SIGIL_005_REPORT.json');fs.writeFileSync(outPath,JSON.stringify(report,null,2));console.log("[+] Report saved to: "+(outPath));^report}
=ex{sha256,runFullFuzzedSuite}