@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(substrate,hypothesisLedger){this.substrate=substrate;this.ledger=hypothesisLedger;this.sessionHistory=new Map()}
!recordAttemptOutcome(symbol,passed){hist=this.sessionHistory.get(symbol)||{successes:0,attempts:0};hist.attempts++;if(passed) {hist.successes++;}this.sessionHistory.set(symbol,hist)}
!getDAGDistance(src,target){if(src===target) {^0;}queue=[[src,0]];visited=new Set([src]);while(queue.length>0){const[curr,dist]=queue.shift();callees=this.substrate.dependencyGraph.get(curr)||new Set();callers=this.substrate.getAffectedSubtree(curr);neighbors=new Set([...callees,...callers]);for(n of neighbors){if(n===target) {^dist+1;}if(!visited.has(n)){visited.add(n);queue.push([n,dist+1]);}}};^5}
!computeDynamicRankings(entrySymbol,testErrorOutput,refutedCandidates){candidateList=[];allSymbols=Array.from(this.substrate.symbolIndex.keys());for(sym of allSymbols){node=this.substrate.symbolIndex.get(sym);if(!node) {continue;}if(refutedCandidates.includes(sym)){continue;};distToEntry=this.getDAGDistance(entrySymbol,sym);sGraph=Math.max(0.1,1.0-(distToEntry*0.25));sError=0.0;if(testErrorOutput.includes(sym)) {sError+=0.60;}if(testErrorOutput.includes(node.module)) {sError+=0.40;}sError=Math.min(1.0,sError);invariants=(this.substrate.invariants||[]).filter(i=>i.symbol===sym);sInvariant=invariants.length>0?0.90:0.40;hist=this.sessionHistory.get(sym);sHistory=hist?(hist.successes/Math.max(1,hist.attempts)):0.50;sEffect=node.effect==='Pure'?0.95:0.50;baseScore=(0.30*sGraph+0.25*sError+0.20*sInvariant+0.15*sHistory+0.10*sEffect);if(refutedCandidates.length>0){lastRefuted=refutedCandidates[refutedCandidates.length-1];distToRefuted=this.getDAGDistance(lastRefuted,sym);if(distToRefuted>0){boost=0.35/(1+distToRefuted);baseScore+=boost;}};candidateList.push({symbol:sym,module:node.module,effect:node.effect,score:Number(baseScore.toFixed(3)),invariantsCount:invariants.length});};candidateList.sort((a,b)=>b.score-a.score);^candidateList}
=ex{constructor,recordAttemptOutcome,getDAGDistance,computeDynamicRankings}