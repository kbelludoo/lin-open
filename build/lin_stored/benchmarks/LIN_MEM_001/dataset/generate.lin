@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!createPRNG(seed){s=seed>>>0;^function next(){s=(s+0x6D2B79F5)>>>0;t=Math.imul(((s|(s>>>15))&(-((s)&((s>>>15)))-1)),1|s);t=(((t+Math.imul(((t|(t>>>7))&(-((t)&((t>>>7)))-1)),61|t))|t)&(-(((t+Math.imul(((t|(t>>>7))&(-((t)&((t>>>7)))-1)),61|t)))&(t))-1));return((((t|(t>>>14))&(-((t)&((t>>>14)))-1)))>>>0)/4294967296;}}
!pick(arr,rand){^arr[Math.floor(rand()*arr.length)]}
!generateDataset(scale,regime,seed){TIERS=["FREE","STARTER","PRO","ENTERPRISE"];FEATURES_POOL=["sso","audit_logs","custom_domain","unlimited_backups","api_access","sla_999"];ROLES=[{name:"VIEWER",level:1},{name:"EDITOR",level:2},{name:"DEVELOPER",level:3},{name:"ADMIN",level:4},{name:"OWNER",level:5}];STATUSES=["ACTIVE","INACTIVE","SUSPENDED","PENDING_VERIFICATION"];DEPARTMENTS=["Engineering","Product","Sales","Security","Finance","Legal"];REGIONS=["us-east-1","us-west-2","eu-west-1","ap-southeast-1","sa-east-1"];RESOURCE_KINDS=["DATABASE","BUCKET","COMPUTE_INSTANCE","QUEUE","SECRET"];ACTIONS=["READ","WRITE","DELETE","ADMINISTER","EXECUTE"];rand=createPRNG(seed);numAccounts=regime==="shared"?10:Math.max(10,Math.floor(scale*0.05));numPolicies=regime==="shared"?8:Math.max(8,Math.floor(scale*0.05));numUsers=Math.floor(scale*0.40);numResources=scale-numAccounts-numPolicies-numUsers;accounts=[];for(i=0;i<numAccounts;i++){tier=regime==="shared"?TIERS[i%TIERS.length]:pick(TIERS,rand);accounts.push({id:i+1,name:"Account_"+(i + 1),tier,limits:{max_users:regime==="shared"?(i+1)*100:Math.floor(rand()*1000)+10,max_storage_mb:regime==="shared"?(i+1)*10240:Math.floor(rand()*100000)+1024,features:regime==="shared"?FEATURES_POOL.slice(0,(i%FEATURES_POOL.length)+1):[pick(FEATURES_POOL,rand),pick(FEATURES_POOL,rand)]}});};policies=[];for(i=0;i<numPolicies;i++){account_id=(i%numAccounts)+1;rules=[];numRules=regime==="shared"?3:Math.floor(rand()*4)+1;for(r=0;r<numRules;r++){rules.push({action:regime==="shared"?ACTIONS[r%ACTIONS.length]:pick(ACTIONS,rand),effect:r%2===0?"ALLOW":"DENY",min_role_level:(r%5)+1,max_size_kb:regime==="shared"?(r+1)*50000:Math.floor(rand()*100000)+1000});};policies.push({id:i+1,account_id,name:"Policy_"+(i + 1),rules});};users=[];for(i=0;i<numUsers;i++){account_id=(i%numAccounts)+1;policy_id=(i%numPolicies)+1;roleObj=regime==="shared"?ROLES[i%ROLES.length]:pick(ROLES,rand);users.push({id:i+1,account_id,policy_id,username:"user_"+(i + 1),role:roleObj.name,role_level:roleObj.level,status:regime==="shared"?STATUSES[i%STATUSES.length]:pick(STATUSES,rand),metadata:{department:regime==="shared"?DEPARTMENTS[i%DEPARTMENTS.length]:pick(DEPARTMENTS,rand),region:regime==="shared"?REGIONS[i%REGIONS.length]:pick(REGIONS,rand)}});};resources=[];for(i=0;i<numResources;i++){user_id=(i%numUsers)+1;user=users[user_id-1];resources.push({id:i+1,user_id,account_id:user.account_id,kind:regime==="shared"?RESOURCE_KINDS[i%RESOURCE_KINDS.length]:pick(RESOURCE_KINDS,rand),size_kb:regime==="shared"?((i%100)+1)*1024:Math.floor(rand()*50000)+10,tags:regime==="shared"?["env:prod","team:core"]:["tag_"+(Math.floor(rand() * 500)),"env:prod"]});};return{meta:{scale,regime,seed,generated_at:new Date().toISOString()},accounts,policies,users,resources}}
=ex{createPRNG,pick,generateDataset}