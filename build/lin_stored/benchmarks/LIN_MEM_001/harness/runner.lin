@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!runNodeBackend(BackendClass,backendName,dataset,workload){loadStart=performance.now();backend;memLoad=measureMemoryDelta(()=>{backend=new BackendClass();backend.load(dataset);});coldLoadMs=performance.now()-loadStart;for(i=0;i<Math.min(500,workload.L0.length);i++){backend.executeL0(workload.L0[i]);};l0Latencies=[];l0Results=[];l0Start=performance.now();for(op of workload.L0){t0=process.hrtime.bigint();res=backend.executeL0(op);dt=Number(process.hrtime.bigint()-t0);l0Latencies.push(dt);l0Results.push(res);};l0DurationS=(performance.now()-l0Start)/1000;l0OpsSec=workload.L0.length/l0DurationS;l1Latencies=[];l1Results=[];l1Start=performance.now();for(op of workload.L1){t0=process.hrtime.bigint();res=backend.executeL1(op);dt=Number(process.hrtime.bigint()-t0);l1Latencies.push(dt);l1Results.push(res);};l1DurationS=(performance.now()-l1Start)/1000;l1OpsSec=workload.L1.length/l1DurationS;l2Latencies=[];l2Results=[];l2Start=performance.now();for(op of workload.L2){t0=process.hrtime.bigint();res=backend.executeL2(op);dt=Number(process.hrtime.bigint()-t0);l2Latencies.push(dt);l2Results.push(res);};l2DurationS=(performance.now()-l2Start)/1000;l2OpsSec=workload.L2.length/l2DurationS;l3Latencies=[];l3Results=[];l3Start=performance.now();for(op of workload.L3){t0=process.hrtime.bigint();res=backend.executeL3(op);dt=Number(process.hrtime.bigint()-t0);l3Latencies.push(dt);l3Results.push(res);};l3DurationS=(performance.now()-l3Start)/1000;l3OpsSec=workload.L3.length/l3DurationS;totalEntities=dataset.accounts.length+dataset.policies.length+dataset.users.length+dataset.resources.length;totalRelations=dataset.users.length*2+dataset.resources.length*2;residentMemoryBytes=memLoad.deltaRssBytes||memLoad.deltaHeapBytes;if(backend.close){backend.close();};return{backend:backendName,cold_load_ms:coldLoadMs,resident_memory_bytes:residentMemoryBytes,total_entities:totalEntities,total_relations:totalRelations,bytes_per_entity:residentMemoryBytes/totalEntities,bytes_per_relation:residentMemoryBytes/totalRelations,L0:{ops_per_sec:l0OpsSec,...computePercentiles(l0Latencies)},L1:{ops_per_sec:l1OpsSec,...computePercentiles(l1Latencies)},L2:{ops_per_sec:l2OpsSec,...computePercentiles(l2Latencies)},L3:{ops_per_sec:l3OpsSec,...computePercentiles(l3Latencies)},results:{L0:l0Results,L1:l1Results,L2:l2Results,L3:l3Results}}}
!runRustBackend(mode,datasetFile,workloadFile){RUST_BIN=path.join(ROOT_DIR,"backends/rust_engine/target/release/rust_engine");tmpOut=path.join("/tmp","rust_"+(mode)+"_out.json");execFileSync(RUST_BIN,[mode,datasetFile,workloadFile,tmpOut]);data=JSON.parse(fs.readFileSync(tmpOut,"utf-8"));try{fs.unlinkSync(tmpOut);}catch(e){};^data}
!runBenchmarkSuite(scales,regimes,opCount,seed){ROOT_DIR=path.resolve(path.dirname(new URL('file:///lin-in-memory.js').pathname),"..");console.log("================================================================================");console.log("               LIN-MEM-001: SEMANTIC MEMORY ENGINE BENCHMARK                     ");console.log("================================================================================");suiteResults=[];for(scale of scales){for(regime of regimes){console.log("\\n>>> EXECUTING RUN: Scale="+(scale)+", Regime="+(regime)+", Ops="+(opCount)+", Seed="+(seed));dataset=generateDataset({scale,regime,seed});workload=generateWorkload({dataset,opCount,seed});datasetPath=path.join("/tmp","dataset_"+(scale)+"_"+(regime)+".json");workloadPath=path.join("/tmp","workload_"+(scale)+"_"+(regime)+".json");fs.writeFileSync(datasetPath,JSON.stringify(dataset));fs.writeFileSync(workloadPath,JSON.stringify(workload));console.log("  [1/6] Running Golden Oracle reference...");oracle=new GoldenOracle(dataset);oracleResults=oracle.runAll(workload);console.log("  [2/6] Running Node Map backend...");nodeMapData=await runNodeBackend(NodeMapBackend,"node_map",dataset,workload);vNodeMap=validateBackendResults("node_map",oracleResults,nodeMapData.results);console.log("        -> Node Map Correctness: "+(vNodeMap.passed ? "PASS (100%)" : "FAIL"));console.log("  [3/6] Running SQLite :memory: backend...");sqliteData=await runNodeBackend(SqliteMemoryBackend,"sqlite_memory",dataset,workload);vSqlite=validateBackendResults("sqlite_memory",oracleResults,sqliteData.results);console.log("        -> SQLite Correctness: "+(vSqlite.passed ? "PASS (100%)" : "FAIL"));console.log("  [4/6] Running Rust HashMap backend...");rustHashMapData=runRustBackend("hashmap",datasetPath,workloadPath);vRustHash=validateBackendResults("rust_hashmap",oracleResults,rustHashMapData.results);console.log("        -> Rust HashMap Correctness: "+(vRustHash.passed ? "PASS (100%)" : "FAIL"));console.log("  [5/6] Running Rust Arena + String Interning backend...");rustArenaData=runRustBackend("arena_interned",datasetPath,workloadPath);vRustArena=validateBackendResults("rust_arena_interned",oracleResults,rustArenaData.results);console.log("        -> Rust Arena Correctness: "+(vRustArena.passed ? "PASS (100%)" : "FAIL"));console.log("  [6/6] Running LIN Semantic Engine (HashCons DAG) backend...");linData=runRustBackend("lin_semantic_engine",datasetPath,workloadPath);vLin=validateBackendResults("lin_semantic_engine",oracleResults,linData.results);console.log("        -> LIN Semantic Engine Correctness: "+(vLin.passed ? "PASS (100%)" : "FAIL"));delete nodeMapData.results;delete sqliteData.results;delete rustHashMapData.results;delete rustArenaData.results;delete linData.results;runSummary={meta:{scale,regime,opCount,seed},validations:{node_map:vNodeMap,sqlite_memory:vSqlite,rust_hashmap:vRustHash,rust_arena_interned:vRustArena,lin_semantic_engine:vLin},backends:{node_map:nodeMapData,sqlite_memory:sqliteData,rust_hashmap:rustHashMapData,rust_arena_interned:rustArenaData,lin_semantic_engine:linData}};suiteResults.push(runSummary);try{fs.unlinkSync(datasetPath);}catch(e){};try{fs.unlinkSync(workloadPath);}catch(e){}}};outSummaryPath=path.join(ROOT_DIR,"results/LIN_MEM_001_SUMMARY.json");fs.writeFileSync(outSummaryPath,JSON.stringify(suiteResults,null,2));console.log("\\n[+] Suite complete! Full results saved to: "+(outSummaryPath));^suiteResults}
=ex{runNodeBackend,runRustBackend,runBenchmarkSuite}