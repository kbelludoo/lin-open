@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!generateWorkload(dataset,opCount,seed){rand=createPRNG(seed);__d28=dataset;accounts=__d28.accounts;policies=__d28.policies;users=__d28.users;resources=__d28.resources;l0Ops=[];for(i=0;i<opCount;i++){r=rand();if(r<0.5){u=users[Math.floor(rand()*users.length)];l0Ops.push({op:"GET",entityType:"User",id:u.id});}:( r<0.8 ){res=resources[Math.floor(rand()*resources.length)];l0Ops.push({op:"GET",entityType:"Resource",id:res.id})}:( r<0.9 ){p=policies[Math.floor(rand()*policies.length)];l0Ops.push({op:"GET",entityType:"Policy",id:p.id})}:{a=accounts[Math.floor(rand()*accounts.length)];l0Ops.push({op:"GET",entityType:"Account",id:a.id})}};l1Ops=[];for(i=0;i<opCount;i++){isSame=rand()<0.5;if(isSame){idx=Math.floor(rand()*users.length);l1Ops.push({op:"EQ",entityType:"User",idA:users[idx].id,idB:users[idx].id});}:{idxA=Math.floor(rand()*users.length);idxB=(idxA+1+Math.floor(rand()*(users.length-1)))%users.length;l1Ops.push({op:"EQ",entityType:"User",idA:users[idxA].id,idB:users[idxB].id})}};l2Ops=[];ROLES=["VIEWER","EDITOR","DEVELOPER","ADMIN","OWNER"];STATUSES=["ACTIVE","INACTIVE","SUSPENDED","PENDING_VERIFICATION"];DEPARTMENTS=["Engineering","Product","Sales","Security","Finance","Legal"];for(i=0;i<opCount;i++){account_id=accounts[Math.floor(rand()*accounts.length)].id;status=pick(STATUSES,rand);department=pick(DEPARTMENTS,rand);l2Ops.push({op:"FILTER",entityType:"User",predicate:{account_id,status,department}});};l3Ops=[];ACTIONS=["READ","WRITE","DELETE","ADMINISTER","EXECUTE"];for(i=0;i<opCount;i++){user=users[Math.floor(rand()*users.length)];resource=resources[Math.floor(rand()*resources.length)];action=pick(ACTIONS,rand);l3Ops.push({op:"TRAVERSE_RULE",user_id:user.id,resource_id:resource.id,action});};return{meta:{opCount,seed,generated_at:new Date().toISOString()},L0:l0Ops,L1:l1Ops,L2:l2Ops,L3:l3Ops}}
=ex{generateWorkload}