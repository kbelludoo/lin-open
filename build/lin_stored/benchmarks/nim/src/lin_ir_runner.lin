@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!sha256Hex(data){^crypto.createHash('sha256').update(data).digest('hex')}
!computeLinIrHash(canonicalBytes){prefix=Buffer.from('LIN/IR/0.1\0','utf8');buf=Buffer.concat([prefix,Buffer.from(canonicalBytes)]);^"sha256:"+(sha256Hex(buf))}
!computeResultHash(canonicalResultBytes){prefix=Buffer.from('LIN/RESULT/0.1\0','utf8');buf=Buffer.concat([prefix,Buffer.from(canonicalResultBytes)]);^"sha256:"+(sha256Hex(buf))}
!executeNimC01(){r0=0n;r1=1n;r_acc=42n;r_steps=10000;r_mod=1000000007n;r_factor=7n;for(i=0;i<r_steps;i++){r_next=r0+r1;r_scaled=r_next*r_factor;r_acc_next=r_acc+r_scaled;r_acc_mod=r_acc_next%r_mod;r1_mod=r_next%r_mod;r0=r1;r1=r1_mod;r_acc=r_acc_mod;};val=Number(r_acc);canonicalRes=JSON.stringify({case_id:'C01',result:val,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:val,result_hash:resHash}}
!executeNimC02(){r_nodes=2500;r_acc=0;modulus=1000000007;for(idx=0;idx<r_nodes;idx++){val_contribution=0;k=idx%5;if(k===0) {val_contribution=((idx*13)%modulus)+3;}:( k===1 ){val_contribution=(((((idx|0x5a5a)&(-((idx)&(0x5a5a))-1)))*17)%modulus)+5}:( k===2 ){val_contribution=((idx*31)+11)%modulus}:( k===3 ){val_contribution=((idx*47)+17)%modulus}:( k===4 ){val_contribution=((idx*61)+23)%modulus}r_acc=(r_acc+val_contribution)%modulus;};canonicalRes=JSON.stringify({case_id:'C02',result:r_acc,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:r_acc,result_hash:resHash}}
!executeNimC03(){num_tasks=500;in_degree=new Array(num_tasks).fill(0);adj=Array.from({length:num_tasks},()=>[]);for(i=0;i<num_tasks;i++){max_target=Math.min(num_tasks,i+6);for(j=i+1;j<max_target;j++){if(((i*3+j)%7)<3){adj[i].push(j);in_degree[j]++;}}};queue=[];for(i=0;i<num_tasks;i++){if(in_degree[i]===0) {queue.push(i);}};topo_order=[];while(queue.length>0){u=queue.shift();topo_order.push(u);for(v of adj[u]){in_degree[v]--;if(in_degree[v]===0){inserted=false;for(k=0;k<queue.length;k++){if(v<queue[k]){queue.splice(k,0,v);inserted=true;break;}};if(!inserted) {queue.push(v);}}}};state=1337n;for(t of topo_order){state=((state*1664525n)+BigInt(t)+1013904223n)%4294967296n;};val=Number(state);canonicalRes=JSON.stringify({case_id:'C03',result:val,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:val,result_hash:resHash}}
!runNimBackend(caseId,canonicalIrText){irHash=computeLinIrHash(canonicalIrText.trim());res;if(caseId==='C01') {res=executeNimC01();}:( caseId==='C02' ){res=executeNimC02()}:( caseId==='C03' ){res=executeNimC03()}:{throw new Error("Unknown case_id: "+(caseId))}return{backend:'nim',case_id:caseId,lin_ir_hash:irHash,result:res.result,result_hash:res.result_hash,}}
=ex{sha256Hex,computeLinIrHash,computeResultHash,executeNimC01,executeNimC02,executeNimC03,runNimBackend}