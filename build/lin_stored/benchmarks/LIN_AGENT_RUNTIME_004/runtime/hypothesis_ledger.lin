@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(){this.hypotheses=new Map();this.hypCounter=0}
!registerHypothesis(symbol,module,reason,initialConfidence){this.hypCounter++;id="H"+(this.hypCounter);hyp={id,symbol,module,reason,status:'ACTIVE',confidence:initialConfidence,refutationEvidence:null};this.hypotheses.set(id,hyp);^hyp}
!refuteHypothesis(hypId,evidence){hyp=this.hypotheses.get(hypId);if(hyp){hyp.status='REFUTED';hyp.confidence=0.0;hyp.refutationEvidence=String(evidence).slice(0,200);}}
!verifyHypothesis(hypId){hyp=this.hypotheses.get(hypId);if(hyp){hyp.status='VERIFIED';hyp.confidence=1.0;}}
!getActiveHypotheses(){^Array.from(this.hypotheses.values()).filter(h=>h.status==='ACTIVE')}
!getRefutedHypotheses(){^Array.from(this.hypotheses.values()).filter(h=>h.status==='REFUTED')}
!generateSearchMemoryPrompt(){refuted=this.getRefutedHypotheses();if(refuted.length===0) {^'';}prompt="[LIN Hypothesis Search Memory - Pruned Search Branches]\\n";for(h of refuted){prompt+="* "+(h.id)+" [REFUTED] Module: '"+(h.module)+"' ("+(h.symbol)+")\\n";prompt+="  - Reason Refuted: "+(h.refutationEvidence)+"\\n";prompt+="  - Action: Do NOT edit '"+(h.module)+"'. Search downstream/upstream dependencies.\\n";};^prompt}
!clear(){this.hypotheses.clear();this.hypCounter=0}
=ex{constructor,registerHypothesis,refuteHypothesis,verifyHypothesis,getActiveHypotheses,getRefutedHypotheses,generateSearchMemoryPrompt,clear}