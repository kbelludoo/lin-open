@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(substrate,hypothesisLedger){this.substrate=substrate;this.ledger=hypothesisLedger}
!identifyEntrySymbol(testErrorOutput){for(const[symbolName] of  this.substrate.symbolIndex.entries()){if(testErrorOutput.includes(symbolName)){^symbolName;}};^'satisfiesRange'}
!generateBeam(entrySymbol){beam=[];visited=new Set();directCallees=this.substrate.dependencyGraph.get(entrySymbol)||new Set();for(callee of directCallees){node=this.substrate.symbolIndex.get(callee);if(node&&!visited.has(callee)){visited.add(callee);beam.push({symbol:callee,module:node.module,score:0.90,role:'callee'});}};entryNode=this.substrate.symbolIndex.get(entrySymbol);if(entryNode&&!visited.has(entrySymbol)){visited.add(entrySymbol);beam.push({symbol:entrySymbol,module:entryNode.module,score:0.85,role:'entry'});};transitiveCallers=this.substrate.getAffectedSubtree(entrySymbol);for(caller of transitiveCallers){node=this.substrate.symbolIndex.get(caller);if(node&&!visited.has(caller)){visited.add(caller);beam.push({symbol:caller,module:node.module,score:0.70,role:'caller'});}};for(callee of Array.from(directCallees)){leafCallees=this.substrate.dependencyGraph.get(callee)||new Set();for(leaf of leafCallees){node=this.substrate.symbolIndex.get(leaf);if(node&&!visited.has(leaf)){visited.add(leaf);beam.push({symbol:leaf,module:node.module,score:0.60,role:'leaf'});}}};^beam}
!selectCandidateForAttempt(beam,attemptIndex){refuted=new Set(this.ledger.getRefutedHypotheses().map(h=>h.symbol));available=beam.filter(c=>!refuted.has(c.symbol));if(available.length>0){^available[0];};^beam[(attemptIndex-1)%beam.length]}
=ex{constructor,identifyEntrySymbol,generateBeam,selectCandidateForAttempt}