@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!runRealAblationBenchmark(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');TASKS_FILE=path.join(ROOT,'dataset/historical_bugs.json');console.log("================================================================================");console.log("   LIN-REAL-BENCH-001: REAL-WORLD OPEN-SOURCE BUGS & 7-STAGE ABLATION           ");console.log("================================================================================");tasks=JSON.parse(fs.readFileSync(TASKS_FILE,'utf8'));ablationArms=[{id:'ARM_A_RAW',name:'Arm A: Raw LLM Text Retrieval'},{id:'ARM_B_CHAT',name:'Arm B: Chat History Buffer'},{id:'ARM_C_HASHCONS',name:'Arm C: HashCons Memory Indexing'},{id:'ARM_D_DAG',name:'Arm D: HashCons + Dependency DAG'},{id:'ARM_E_CONTRACTS_EFFECTS',name:'Arm E: DAG + Contracts (%) + Effects (*)'},{id:'ARM_F_TRAUMA',name:'Arm F: Contracts + Effects + Trauma Ledger'},{id:'ARM_G_FULL_LIN',name:'Arm G: Full LIN Causal Frontier Navigation'}];agent=new RealAblationAgent();armSummaries={};for(arm of ablationArms){console.log("\\n================================================================================");console.log(">>> Executing "+(arm.name)+" on Real-World Repositories...");console.log("================================================================================");totalTasks=tasks.length;initialSuccessCount=0;recoveredSuccessCount=0;rootCauseFoundCount=0;totalAttempts=0;totalWrongFileEdits=0;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;taskLogs=[];for(task of tasks){repoDir=path.join(ROOT,task.repo_dir);targetFilePath=path.join(repoDir,task.ground_truth.file);content=fs.readFileSync(targetFilePath,'utf8');content=content.replace(task.ground_truth.bug_find,task.ground_truth.bug_replace);fs.writeFileSync(targetFilePath,content,'utf8');res=await agent.runAblationTask({task,repoDir,arm:arm.id,maxAttempts:3});if(res.initialSuccess) {initialSuccessCount++;}if(res.recoveredSuccess) {recoveredSuccessCount++;}if(res.rootCauseFound) {rootCauseFoundCount++;}totalAttempts+=res.attempts;totalWrongFileEdits+=res.wrongFileEdits;totalPromptTokens+=res.promptTokens;totalEvalTokens+=res.evalTokens;totalDurationMs+=res.durationMs;console.log("  ["+(task.task_id)+"] ("+(task.repo)+") "+(task.title.slice(0, 36))+"... -> Success: "+(res.success)+" (Init: "+(res.initialSuccess)+", Rec: "+(res.recoveredSuccess)+") | Localized: "+(res.rootCauseFound)+" | Tokens: "+(res.promptTokens)+" | Time: "+((res.durationMs / 1000).toFixed(1))+"s");taskLogs.push(res);};failedInitial=totalTasks-initialSuccessCount;recoveryRate=failedInitial>0?(recoveredSuccessCount/failedInitial):0;taskSuccessRate=(initialSuccessCount+recoveredSuccessCount)/totalTasks;localizationRate=rootCauseFoundCount/totalTasks;avgAttempts=totalAttempts/totalTasks;avgTokens=totalPromptTokens/totalTasks;summary={arm_id:arm.id,arm_name:arm.name,total_tasks:totalTasks,root_cause_localization_rate:localizationRate,initial_success:initialSuccessCount,recovered_success:recoveredSuccessCount,persistent_failures:totalTasks-(initialSuccessCount+recoveredSuccessCount),task_success_rate:taskSuccessRate,hypothesis_recovery_rate:recoveryRate,total_wrong_file_edits:totalWrongFileEdits,avg_attempts_per_task:avgAttempts,avg_prompt_tokens_per_task:avgTokens,total_duration_s:totalDurationMs/1000,tasks:taskLogs};armSummaries[arm.id]=summary;console.log("\\n>>> ["+(arm.id)+" Summary] Success: "+((taskSuccessRate * 100).toFixed(1))+"% | Localized: "+((localizationRate * 100).toFixed(1))+"% | Recovery: "+((recoveryRate * 100).toFixed(1))+"% | Avg Tokens: "+(avgTokens.toFixed(0))+" | Total Time: "+((totalDurationMs / 1000).toFixed(1))+"s");};outPath=path.join(ROOT,'results/LIN_REAL_BENCH_001_REPORT.json');fs.writeFileSync(outPath,JSON.stringify(armSummaries,null,2));console.log("\\n[+] LIN-REAL-BENCH-001 Complete! Final Report saved to: "+(outPath));^armSummaries}
=ex{runRealAblationBenchmark}