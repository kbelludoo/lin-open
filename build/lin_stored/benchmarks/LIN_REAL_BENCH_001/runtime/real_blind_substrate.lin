@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(){this.dagNodes=new Map();this.symbolIndex=new Map();this.dependencyGraph=new Map();this.reverseDependencyGraph=new Map();this.invariants=[];this.effects=new Map()}
!reset(){this.dagNodes.clear();this.symbolIndex.clear();this.dependencyGraph.clear();this.reverseDependencyGraph.clear();this.invariants=[];this.effects.clear()}
!hashNode(data){^crypto.createHash('sha256').update(JSON.stringify(data)).digest('hex').slice(0,16)}
!registerSymbol(name,file,contracts,effect,body){nodeData={name,file,contracts,effect,body:String(body).slice(0,500)};hash=this.hashNode(nodeData);canonicalNode=this.dagNodes.get(hash);if(!canonicalNode){canonicalNode={id:hash,...nodeData};this.dagNodes.set(hash,canonicalNode);};this.symbolIndex.set(name,canonicalNode);this.effects.set(name,effect);for(c of contracts){this.invariants.push({symbol:name,...c});};^canonicalNode}
!addDependency(caller,callee){if(!this.dependencyGraph.has(caller)) {this.dependencyGraph.set(caller,new Set());}this.dependencyGraph.get(caller).add(callee);if(!this.reverseDependencyGraph.has(callee)) {this.reverseDependencyGraph.set(callee,new Set());}this.reverseDependencyGraph.get(callee).add(caller)}
!indexRepository(repoPath){this.reset();sourceFiles=[];function walk(dir){entries=fs.readdirSync(dir,{withFileTypes:true});for(e of entries){if(e.name==='node_modules'||e.name==='.git'||e.name==='test'||e.name==='tests') {continue;}full=path.join(dir,e.name);if(e.isDirectory()){walk(full);}:( e.name.endsWith('.js')||e.name.endsWith('.mjs') ){sourceFiles.push(full)}}};walk(repoPath);for(filePath of sourceFiles){relPath=path.relative(repoPath,filePath);code=fs.readFileSync(filePath,'utf8');fnRegex=/(?:export\s+)?function\s+([a-zA-Z0-9_$]+)\s*\(([^)]*)\)\s*\{([\s\S]*?)(?=\nfunction|\nexport|\n$)/g;match;fnsInFile=[];while((match=fnRegex.exec(code))!==null){fnName=match[1];params=match[2];body=match[3];fnsInFile.push(fnName);this.registerSymbol({name:fnName,file:relPath,effect:body.includes('console.')||body.includes('fs.')?'Write':'Pure',contracts:[{kind:'inv',expr:'ret !== undefined'}],body});};for(fn of fnsInFile){for(other of fnsInFile){if(fn!==other){body=this.symbolIndex.get(fn)?.body||'';if(body.includes(other+'(')){this.addDependency(fn,other);}}}}}}
!generateFocusedContext(symbolName){node=this.symbolIndex.get(symbolName);if(!node) {^null;}callees=Array.from(this.dependencyGraph.get(symbolName)||[]);callers=Array.from(this.reverseDependencyGraph.get(symbolName)||[]);invs=this.invariants.filter(i=>i.symbol===symbolName).map(i=>i.expr);return{symbol:symbolName,file:node.file,effect:node.effect,invariants:invs,dependencies:callees,dependents:callers}}
=ex{constructor,reset,hashNode,registerSymbol,addDependency,indexRepository,generateFocusedContext}