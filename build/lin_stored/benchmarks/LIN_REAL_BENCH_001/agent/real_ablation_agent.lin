@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(routerUrl,apiKey,primaryModel,secondaryModel,ollamaUrl,ollamaModel){this.routerUrl=routerUrl;this.apiKey=apiKey;this.primaryModel=primaryModel;this.secondaryModel=secondaryModel;this.ollamaUrl=ollamaUrl;this.ollamaModel=ollamaModel;this.substrate=new RealBlindSubstrate()}
!queryLLM(prompt){t0=performance.now();for(model of[this.primaryModel,this.secondaryModel]){try{res=await fetch((this.routerUrl)+"/chat/completions",{method:'POST',headers:{'Content-Type':'application/json','Authorization':"Bearer "+(this.apiKey)},body:JSON.stringify({model,messages:[{role:'user',content:prompt}],temperature:0.1,max_tokens:800,stream:false}),signal:AbortSignal.timeout(6000)});if(res.ok){data=await res.json();if(data.choices&&data.choices[0]&&data.choices[0].message){text=data.choices[0].message.content.trim();durationMs=performance.now()-t0;promptTokens=Math.ceil(prompt.length/4);evalTokens=Math.ceil(text.length/4);return{response:text,promptTokens,evalTokens,durationMs,modelUsed:model};}}}catch(e){}};try{res=await fetch((this.ollamaUrl)+"/api/generate",{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:this.ollamaModel,prompt,temperature:0.1,stream:false,options:{num_predict:350,num_thread:8}}),signal:AbortSignal.timeout(10000)});if(res.ok){data=await res.json();durationMs=performance.now()-t0;return{response:data.response||'',promptTokens:data.prompt_eval_count||Math.ceil(prompt.length/4),evalTokens:data.eval_count||0,durationMs,modelUsed:this.ollamaModel};}}catch(e){};throw new Error("All LLM providers unavailable")}
!extractFileAndPatch(llmResponse,defaultFile,availableFiles){targetFile=defaultFile;for(f of availableFiles){if(llmResponse.includes(f)||llmResponse.includes("FILE: "+(f))){targetFile=f;break;}};match=llmResponse.match(/```(?:javascript|js|lin)?\s*([\s\S]*?)```/i);code=match?match[1].trim():null;if(code){code=code.replace(/^FILE:[^\n]*\n+/i,'').trim();};return{targetFile,code}}
!runTests(repoDir){try{runnerPath=fs.existsSync(path.join(repoDir,'test/test_runner.js'))?path.join(repoDir,'test/test_runner.js'):path.join(repoDir,'tests/test_runner.js');out=execSync("node "+(runnerPath),{encoding:'utf8',timeout:5000});return{passed:out.includes('Overall: PASS'),output:out};}catch(err){return{passed:false,output:err.stdout||err.message};}}
!findMatchingSymbolFromError(testErrorOutput){for(const[sym,node] of  this.substrate.symbolIndex.entries()){if(testErrorOutput.includes(sym)) {return{symbol:sym,file:node.file};}};firstKey=this.substrate.symbolIndex.keys().next().value;if(firstKey){node=this.substrate.symbolIndex.get(firstKey);return{symbol:firstKey,file:node.file};};return{symbol:'unknown',file:'lib/index.js'}}
!runAblationTask(task,repoDir,arm,maxAttempts){this.substrate.indexRepository(repoDir);historyBuffer=[];refutedSet=new Set();initialSuccess=false;recoveredSuccess=false;rootCauseFound=false;totalPromptTokens=0;totalEvalTokens=0;totalDurationMs=0;attemptsCount=0;wrongFileEdits=0;sourceFiles=[];function scanFiles(dir){for(e of fs.readdirSync(dir,{withFileTypes:true})){if(e.name==='node_modules'||e.name==='test'||e.name==='tests') {continue;}full=path.join(dir,e.name);if(e.isDirectory()) {scanFiles(full);}:( e.name.endsWith('.js') ){sourceFiles.push(path.relative(repoDir,full))}}};scanFiles(repoDir);originalContents={};for(f of sourceFiles){originalContents[f]=fs.readFileSync(path.join(repoDir,f),'utf8');};resetFiles=()=>{for(f of sourceFiles){fs.writeFileSync(path.join(repoDir,f),originalContents[f],'utf8');}};for(attempt=1;attempt<=maxAttempts;attempt++){attemptsCount++;prompt='';matched=this.findMatchingSymbolFromError(task.test_assertion_error);defaultTargetFile=matched.file||sourceFiles[0];if(arm==='ARM_A_RAW'){prompt="You are an expert open-source maintainer fixing a real historical bug in \\`"+(task.repo)+"\\`.\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Repository Files]\\n";for(f of sourceFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Provide the complete fixed code for the target file inside a single \\`\\`\\`javascript code block with header 'FILE: <filepath>'.";}:( arm==='ARM_B_CHAT' ){histText=historyBuffer.map(h=>"[Attempt "+(h.attempt)+" Failed on "+(h.file)+"]:\\n"+(h.testOutput)).join('\n\n');prompt="You are an expert open-source maintainer fixing a real historical bug in \\`"+(task.repo)+"\\`.\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";if(histText) {prompt+="[Previous Attempt History]\\n"+(histText)+"\\n\\n";};prompt+="[Repository Files]\\n";for(f of sourceFiles){prompt+="--- "+(f)+" ---\\n"+(fs.readFileSync(path.join(repoDir, f), 'utf8'))+"\\n\\n";};prompt+="Provide the complete fixed code for the target file inside a single \\`\\`\\`javascript code block with header 'FILE: <filepath>'."}:( arm==='ARM_C_HASHCONS' ){prompt="[LIN HashCons Index]\\nTarget File: "+(defaultTargetFile)+"\\nCanonical Node: "+(matched.symbol)+"\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Source Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."}:( arm==='ARM_D_DAG' ){focused=this.substrate.generateFocusedContext(matched.symbol);prompt="[LIN Dependency DAG]\\n";prompt+="* Target Symbol: "+(matched.symbol)+" in '"+(defaultTargetFile)+"'\\n";prompt+="* Callee Dependencies: ["+(focused ? focused.dependencies.join(', ') : 'None')+"]\\n";prompt+="* Upstream Callers: ["+(focused ? focused.dependents.join(', ') : 'None')+"]\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Source Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."}:( arm==='ARM_E_CONTRACTS_EFFECTS' ){focused=this.substrate.generateFocusedContext(matched.symbol);prompt="[LIN Contracts % & Effects *]\\n";prompt+="* Target Symbol: "+(matched.symbol)+" in '"+(defaultTargetFile)+"'\\n";prompt+="* Declared Effect: *("+(focused ? focused.effect : 'Pure')+")\\n";prompt+="* Active Invariants: ["+(focused ? focused.invariants.join('; ') : 'ret !== undefined')+"]\\n\\n";prompt+="[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Source Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."}:( arm==='ARM_F_TRAUMA' ){focused=this.substrate.generateFocusedContext(matched.symbol);traumaText=Array.from(refutedSet).map(s=>"* Refuted Hypothesis: '"+(s)+"' failed test").join('\n');prompt="[LIN Trauma Ledger (Attempt "+(attempt)+")]\\n";prompt+="* Target Symbol: "+(matched.symbol)+" in '"+(defaultTargetFile)+"'\\n";prompt+="* Effect: *("+(focused ? focused.effect : 'Pure')+")\\n";if(traumaText) {prompt+="\\n[Trauma Memory]\\n"+(traumaText)+"\\n";};prompt+="\\n[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Source Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."}:( arm==='ARM_G_FULL_LIN' ){focused=this.substrate.generateFocusedContext(matched.symbol);prompt="[Full LIN Causal Frontier Navigation (Attempt "+(attempt)+")]\\n";prompt+="* Canonical Symbol: "+(matched.symbol)+" in '"+(defaultTargetFile)+"'\\n";prompt+="* Declared Effect: *("+(focused ? focused.effect : 'Pure')+")\\n";prompt+="* Invariant Contracts: ["+(focused ? focused.invariants.join('; ') : 'ret !== undefined')+"]\\n";prompt+="* Transitive Dependents: ["+(focused ? focused.dependents.join(', ') : 'None')+"]\\n";if(refutedSet.size>0){prompt+="* Causal Frontier Note: Upstream wrapper '"+(Array.from(refutedSet).join(', '))+"' was refuted. Focusing on leaf symbol logic.\\n";};prompt+="\\n[Issue Report]\\n"+(task.issue_description)+"\\n\\n";prompt+="[Failing Test Assertion]\\n"+(task.test_assertion_error)+"\\n\\n";prompt+="[Source Code: "+(defaultTargetFile)+"]\\n\\`\\`\\`javascript\\n"+(fs.readFileSync(path.join(repoDir, defaultTargetFile), 'utf8'))+"\\n\\`\\`\\`\\n\\n";prompt+="Provide the complete fixed code for "+(defaultTargetFile)+" inside a single \\`\\`\\`javascript code block."};llm=await this.queryLLM(prompt);totalPromptTokens+=llm.promptTokens;totalEvalTokens+=llm.evalTokens;totalDurationMs+=llm.durationMs;__d6725=this.extractFileAndPatch(llm.response,defaultTargetFile,sourceFiles);targetFile=__d6725.targetFile;code=__d6725.code;if(!code) {continue;}if(targetFile===task.ground_truth.file){rootCauseFound=true;}:{wrongFileEdits++};fs.writeFileSync(path.join(repoDir,targetFile),code,'utf8');testRes=this.runTests(repoDir);if(testRes.passed){if(attempt===1) {initialSuccess=true;}:{recoveredSuccess=true}break;}:{resetFiles();historyBuffer.push({attempt,file:targetFile,testOutput:testRes.output.slice(0,150)});refutedSet.add(matched.symbol)}};resetFiles();return{task_id:task.task_id,repo:task.repo,arm,success:initialSuccess||recoveredSuccess,initialSuccess,recoveredSuccess,rootCauseFound,attempts:attemptsCount,wrongFileEdits,promptTokens:totalPromptTokens,evalTokens:totalEvalTokens,durationMs:totalDurationMs}}
=ex{constructor,queryLLM,extractFileAndPatch,runTests,findMatchingSymbolFromError,runAblationTask}