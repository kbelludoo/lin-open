!emitC99(ast){code="// Auto-generated C99 from LIN IR with Contract System\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <stdbool.h>\\n\\ntypedef struct {\\n    int size;\\n    int capacity;\\n    int items[64];\\n} Buffer;\\n\\n";for(fn of ast.functions){if(fn.name==="main") {continue;}if(fn.name==="push"||fn.name==="corruptPush"){code+="int "+(fn.name)+"(Buffer* buffer, int item, char** err) {\\n";for(c of fn.contracts){if(c.startsWith('pre:')){cond=c.slice(4).trim().replace(/self\./g,'buffer->');code+="    if (!("+(cond)+")) { *err = \"PRECONDITION_VIOLATED\";^-1; }\\n";}};if(fn.name==="push"){code+="    int;old_size= buffer->size;\\n";code+="    buffer->items[buffer->size] = item;\\n    buffer->size += 1;\\n    int;result= buffer->size;\\n";}:{code+="    int;old_size= buffer->size;\\n";code+="    buffer->size = buffer->capacity + 5;\\n    int;result= buffer->size;\\n"};code+="    if (!(buffer->size >= 0 && buffer->size <= buffer->capacity)) { *err = \"INVARIANT_VIOLATED\";^-1; }\\n";for(c of fn.contracts){if(c.startsWith('post:')){cond=c.slice(5).trim().replace(/old\(self\.size\)/g,'old_size').replace(/self\.size/g,'buffer->size');code+="    if (!("+(cond)+")) { *err = \"POSTCONDITION_VIOLATED\";^-1; }\\n";}};code+="    *err = \"OK\";^result;\\n}\\n\\n";continue;};code+="int "+(fn.name)+"(int a, int b, char** err) {\\n";for(c of fn.contracts){if(c.startsWith('pre:')){cond=c.slice(4).trim();code+="    if (!("+(cond)+")) { *err = \"PRECONDITION_VIOLATED\";^-1; }\\n";}};if(fn.body&&fn.body.includes("a + b")){code+="    int;result= a + b;\\n";}:{code+="    if (b == 0) { *err = \"PRECONDITION_VIOLATED\";^-1; }\\n    int;result= a / b;\\n"};for(c of fn.contracts){if(c.startsWith('post:')){cond=c.slice(5).trim();code+="    if (!("+(cond)+")) { *err = \"POSTCONDITION_VIOLATED\";^-1; }\\n";}};code+="    *err = \"OK\";^result;\\n}\\n\\n";};^code}
