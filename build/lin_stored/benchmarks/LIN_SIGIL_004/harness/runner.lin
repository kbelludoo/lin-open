@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!stripSigilWrapper(line){s=line.substring(1).trim();if(s.startsWith('(')&&s.endsWith(')')) {s=s.slice(1,-1).trim();}^s}
!parseLin(src){lines=src.split('\n');functions=[];schemaInvariants=[];currentFn=null;for(i=0;i<lines.length;i++){line=lines[i].trim();if(line.startsWith('~')){}:( line.startsWith('%')&&!currentFn ){schemaInvariants.push(stripSigilWrapper(line))}:( line.startsWith('!') ){openParen=line.indexOf('(');closeParen=line.indexOf(')');if(openParen>1&&closeParen>openParen){name=line.substring(1,openParen).trim();params=line.substring(openParen+1,closeParen).split(',').map(p=>p.trim().split(':')[0].trim()).filter(Boolean);currentFn={name,params,contracts:[],effects:['pure'],body:''};functions.push(currentFn);}}:( line.startsWith('%')&&currentFn ){currentFn.contracts.push(stripSigilWrapper(line))}:( line.startsWith('*')&&currentFn ){currentFn.effects=[stripSigilWrapper(line)]}:( currentFn&&line.startsWith('{') ){bodyLines=[];i++;while(i<lines.length&&!lines[i].trim().startsWith('}')){bodyLines.push(lines[i]);i++;};currentFn.body=bodyLines.join('\n').replace(/\^/g,'^');currentFn=null}};return{functions,schemaInvariants}}
!runMultiTargetTrial(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');CASES_DIR=path.resolve(ROOT,'../LIN_SIGIL_003/cases');BUILD_DIR=path.join(ROOT,'build');console.log("================================================================================");console.log("   LIN-SIGIL-004: MULTI-TARGET COMPILATION & CROSS-BACKEND EQUIVALENCE         ");console.log("================================================================================");verifier=new LinSemanticVerifier();caseSpecs=[{id:"case_01",file:"01_pure_contract_pass.lin",fnName:"divide",args:{a:10,b:2},expectedStatus:"ACCEPTED",expectedReason:"OK"},{id:"case_02",file:"02_precondition_fail.lin",fnName:"divide",args:{a:10,b:0},expectedStatus:"REJECTED",expectedReason:"PRECONDITION_VIOLATED"},{id:"case_03",file:"03_postcondition_fail.lin",fnName:"divide",args:{a:10,b:2},expectedStatus:"REJECTED",expectedReason:"POSTCONDITION_VIOLATED"},{id:"case_04",file:"04_effect_leak_fail.lin",fnName:"compute",args:{x:5},expectedStatus:"REJECTED",expectedReason:"EFFECT_LEAK"},{id:"case_05",file:"05_invariant_struct_pass.lin",fnName:"push",args:{self:{size:0,capacity:5,items:[]},item:42},expectedStatus:"ACCEPTED",expectedReason:"OK"},{id:"case_06",file:"06_invariant_violation_fail.lin",fnName:"corruptPush",args:{self:{size:0,capacity:5,items:[]},item:42},expectedStatus:"REJECTED",expectedReason:"INVARIANT_VIOLATED"}];results=[];g1CompileSuccess=true;g2ValidAccepted=true;g3InvalidRejected=true;g4EffectLeakRejected=true;g5CrossTargetEq=true;g6FalseAcceptance=0;g7FalseRejection=0;g8SemanticDrift=0;g9RustReleaseCorrectness=true;g10RustDebugReleaseEquivalence=true;for(spec of caseSpecs){src=fs.readFileSync(path.join(CASES_DIR,spec.file),'utf8');ast=parseLin(src);verifier.registerSignatures(ast);effectCheck=verifier.verifyEffectIsolation(ast);hasStaticEffectLeak=!effectCheck.valid;tsStatus='ACCEPTED';tsReason='OK';if(hasStaticEffectLeak){tsStatus='REJECTED';tsReason='EFFECT_LEAK';}:{tsCode=emitTypeScript(ast);tsFile=path.join(BUILD_DIR,(spec.id)+".mjs");fs.writeFileSync(tsFile,tsCode,'utf8');try{evalTs="\n\n;try {\n;args= "+(JSON.stringify(spec.args))+";\n            res;\n            if (args.self) {\n;res= "+(spec.fnName)+"(args.self, args.item);\n            } :{\n;res= "+(spec.fnName)+"(args.a, args.b);\n}\n            console.log(JSON.stringify({ status: 'ACCEPTED', reason: 'OK', res }));\n          } catch(err) {\n            console.log(JSON.stringify({ status: 'REJECTED', reason: err.message }));\n          }\n        ";runnerFile=path.join(BUILD_DIR,"run_"+(spec.id)+".mjs");fs.writeFileSync(runnerFile,evalTs,'utf8');out=execSync("node "+(runnerFile),{encoding:'utf8'});parsed=JSON.parse(out.trim());tsStatus=parsed.status;tsReason=parsed.reason;}catch(err){g1CompileSuccess=false;tsStatus='ERROR';tsReason=err.message;}};rustDebugStatus='ACCEPTED';rustDebugReason='OK';rustReleaseStatus='ACCEPTED';rustReleaseReason='OK';if(hasStaticEffectLeak){rustDebugStatus='REJECTED';rustDebugReason='EFFECT_LEAK';rustReleaseStatus='REJECTED';rustReleaseReason='EFFECT_LEAK';}:{rustCode=emitRust(ast,'release_safe');rustMain="\n        "+(rustCode)+"\n        fn main() {\n            "+(spec.args.self ? "\n            mut;buf= Buffer { size: "+(spec.args.self.size)+", capacity: "+(spec.args.self.capacity)+", items: vec![] };\n            match "+(spec.fnName)+"(&mut buf, "+(spec.args.item)+") {\n                Ok(v) => println!(\"{{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"{}\\\\\"}}\", e),\n            }\n            " : "\n            match "+(spec.fnName)+"("+(spec.args.a)+", "+(spec.args.b)+") {\n                Ok(v) => println!(\"{{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"{}\\\\\"}}\", e),\n            }\n            ")+"\n        }\n      ";rsFile=path.join(BUILD_DIR,(spec.id)+".rs");fs.writeFileSync(rsFile,rustMain,'utf8');binDebug=path.join(BUILD_DIR,"rust_dbg_"+(spec.id));binRelease=path.join(BUILD_DIR,"rust_rel_"+(spec.id));try{execSync("rustc "+(rsFile)+" -o "+(binDebug),{encoding:'utf8'});execSync("rustc -O "+(rsFile)+" -o "+(binRelease),{encoding:'utf8'});outDbg=execSync(binDebug,{encoding:'utf8'});pDbg=JSON.parse(outDbg.trim());rustDebugStatus=pDbg.status;rustDebugReason=pDbg.reason;outRel=execSync(binRelease,{encoding:'utf8'});pRel=JSON.parse(outRel.trim());rustReleaseStatus=pRel.status;rustReleaseReason=pRel.reason;}catch(err){g1CompileSuccess=false;rustDebugStatus='ERROR';rustReleaseStatus='ERROR';}};cStatus='ACCEPTED';cReason='OK';if(hasStaticEffectLeak){cStatus='REJECTED';cReason='EFFECT_LEAK';}:{cCode=emitC99(ast);cMain="\n        "+(cCode)+"\n        int main() {\n            char* err = NULL;\n            "+(spec.args.self ? "\n            Buffer buf;\n            buf.size = "+(spec.args.self.size)+";\n            buf.capacity = "+(spec.args.self.capacity)+";\n            int;res= "+(spec.fnName)+"(&buf, "+(spec.args.item)+", &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":%d}\\\\n\", res);\n            } else {\n                printf(\"{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"%s\\\\\"}\\\\n\", err);\n            }\n            " : "\n            int;res= "+(spec.fnName)+"("+(spec.args.a)+", "+(spec.args.b)+", &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\\\"status\\\\\":\\\\\"ACCEPTED\\\\\",\\\\\"reason\\\\\":\\\\\"OK\\\\\",\\\\\"res\\\\\":%d}\\\\n\", res);\n            } else {\n                printf(\"{\\\\\"status\\\\\":\\\\\"REJECTED\\\\\",\\\\\"reason\\\\\":\\\\\"%s\\\\\"}\\\\n\", err);\n            }\n            ")+"\n;^0;\n        }\n      ";cFile=path.join(BUILD_DIR,(spec.id)+".c");cBin=path.join(BUILD_DIR,"c99_"+(spec.id));fs.writeFileSync(cFile,cMain,'utf8');try{execSync("gcc -O3 "+(cFile)+" -o "+(cBin),{encoding:'utf8'});outC=execSync(cBin,{encoding:'utf8'});pC=JSON.parse(outC.trim());cStatus=pC.status;cReason=pC.reason;}catch(err){g1CompileSuccess=false;cStatus='ERROR';}};allMatchExpected=(tsStatus===spec.expectedStatus&&tsReason===spec.expectedReason&&rustDebugStatus===spec.expectedStatus&&rustDebugReason===spec.expectedReason&&rustReleaseStatus===spec.expectedStatus&&rustReleaseReason===spec.expectedReason&&cStatus===spec.expectedStatus&&cReason===spec.expectedReason);if(spec.expectedStatus==='ACCEPTED'&&!allMatchExpected){g2ValidAccepted=false;g7FalseRejection++;};if(spec.expectedStatus==='REJECTED'&&!allMatchExpected){g3InvalidRejected=false;g6FalseAcceptance++;};if(spec.expectedReason==='EFFECT_LEAK'&&(tsReason!=='EFFECT_LEAK'||rustReleaseReason!=='EFFECT_LEAK'||cReason!=='EFFECT_LEAK')){g4EffectLeakRejected=false;};if(rustDebugReason!==rustReleaseReason){g10RustDebugReleaseEquivalence=false;};if(rustReleaseStatus!==spec.expectedStatus||rustReleaseReason!==spec.expectedReason){g9RustReleaseCorrectness=false;};if(!allMatchExpected){g5CrossTargetEq=false;g8SemanticDrift++;};console.log("  [Case "+(spec.file)+"] Expected: "+(spec.expectedStatus)+" ("+(spec.expectedReason)+")");console.log("    -> TS:   "+(tsStatus)+" ("+(tsReason)+")");console.log("    -> Rust: "+(rustReleaseStatus)+" ("+(rustReleaseReason)+") [Release-Safe]");console.log("    -> C99:  "+(cStatus)+" ("+(cReason)+")");console.log("    -> Parity: "+(allMatchExpected ? '100% MATCH' : 'DIVERGENCE')+"\\n");results.push({case:spec.file,expected:{status:spec.expectedStatus,reason:spec.expectedReason},targets:{typescript:{status:tsStatus,reason:tsReason},rust_debug:{status:rustDebugStatus,reason:rustDebugReason},rust_release:{status:rustReleaseStatus,reason:rustReleaseReason},c99_native:{status:cStatus,reason:cReason}},parity:allMatchExpected});};report={benchmark:"LIN-SIGIL-004",gates:{G1_compile_success:g1CompileSuccess,G2_valid_programs_accepted:g2ValidAccepted,G3_invalid_contracts_rejected:g3InvalidRejected,G4_effect_violations_rejected:g4EffectLeakRejected,G5_cross_target_equivalence:g5CrossTargetEq,G6_false_acceptance_count:g6FalseAcceptance,G7_false_rejection_count:g7FalseRejection,G8_semantic_drift_count:g8SemanticDrift,G9_rust_release_correctness:g9RustReleaseCorrectness,G10_rust_debug_release_equivalence:g10RustDebugReleaseEquivalence},cases:results};outPath=path.join(ROOT,'results/LIN_SIGIL_004_REPORT.json');fs.writeFileSync(outPath,JSON.stringify(report,null,2));console.log("[+] Full Trial Complete! Report saved to "+(outPath));^report}
=ex{stripSigilWrapper,parseLin,runMultiTargetTrial}