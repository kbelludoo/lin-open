@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!canonicalizeJson(obj){if(obj===null||typeof obj!=='object'){^JSON.stringify(obj);};if(Array.isArray(obj)){^"["+(obj.map(canonicalizeJson).join(','))+"]";};keys=Object.keys(obj).sort();pairs=keys.map((k)=>(JSON.stringify(k))+":"+(canonicalizeJson(obj[k])));^"{"+(pairs.join(','))+"}"}
!sha256Hex(data){^crypto.createHash('sha256').update(data).digest('hex')}
!computeLinIrHash(canonicalIrText){prefix=Buffer.from('LIN/IR/0.1\0','utf8');buf=Buffer.concat([prefix,Buffer.from(canonicalIrText,'utf8')]);^"sha256:"+(sha256Hex(buf))}
!computeResultHash(canonicalResultText){prefix=Buffer.from('LIN/RESULT/0.1\0','utf8');buf=Buffer.concat([prefix,Buffer.from(canonicalResultText,'utf8')]);^"sha256:"+(sha256Hex(buf))}
!fileSha256(filePath){^sha256Hex(fs.readFileSync(filePath))}
!oracleC01(){r0=0n;r1=1n;r_acc=42n;r_steps=10000;r_mod=1000000007n;r_factor=7n;for(i=0;i<r_steps;i++){r_next=r0+r1;r_scaled=r_next*r_factor;r_acc_next=r_acc+r_scaled;r_acc_mod=r_acc_next%r_mod;r1_mod=r_next%r_mod;r0=r1;r1=r1_mod;r_acc=r_acc_mod;};val=Number(r_acc);canonicalRes=canonicalizeJson({case_id:'C01',result:val,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:val,canonical_json:canonicalRes,result_hash:resHash}}
!oracleC02(){r_nodes=2500;r_acc=0;modulus=1000000007;for(idx=0;idx<r_nodes;idx++){val_contribution=0;k=idx%5;if(k===0) {val_contribution=((idx*13)%modulus)+3;}:( k===1 ){val_contribution=(((((idx|0x5a5a)&(-((idx)&(0x5a5a))-1)))*17)%modulus)+5}:( k===2 ){val_contribution=((idx*31)+11)%modulus}:( k===3 ){val_contribution=((idx*47)+17)%modulus}:( k===4 ){val_contribution=((idx*61)+23)%modulus}r_acc=(r_acc+val_contribution)%modulus;};canonicalRes=canonicalizeJson({case_id:'C02',result:r_acc,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:r_acc,canonical_json:canonicalRes,result_hash:resHash}}
!oracleC03(){num_tasks=500;in_degree=new Array(num_tasks).fill(0);adj=Array.from({length:num_tasks},()=>[]);for(i=0;i<num_tasks;i++){max_target=Math.min(num_tasks,i+6);for(j=i+1;j<max_target;j++){if(((i*3+j)%7)<3){adj[i].push(j);in_degree[j]++;}}};queue=[];for(i=0;i<num_tasks;i++){if(in_degree[i]===0) {queue.push(i);}};topo_order=[];while(queue.length>0){u=queue.shift();topo_order.push(u);for(v of adj[u]){in_degree[v]--;if(in_degree[v]===0){inserted=false;for(k=0;k<queue.length;k++){if(v<queue[k]){queue.splice(k,0,v);inserted=true;break;}};if(!inserted) {queue.push(v);}}}};state=1337n;for(t of topo_order){state=((state*1664525n)+BigInt(t)+1013904223n)%4294967296n;};val=Number(state);canonicalRes=canonicalizeJson({case_id:'C03',result:val,status:'OK'});resHash=computeResultHash(canonicalRes);return{result:val,canonical_json:canonicalRes,result_hash:resHash}}
!runProtocolE8E9(){ROOT=path.resolve(path.dirname(fileURLToPath('file:///lin-in-memory.js')),'..');SPEC_FILE=path.join(ROOT,'spec','WORKLOAD_SPEC_V1.json');RUST_SRC=path.join(ROOT,'benchmarks','rust','src','lin_ir_runner.rs');RUST_BIN=path.join(ROOT,'benchmarks','rust','lin_ir_runner.exe');NIM_SRC=path.join(ROOT,'benchmarks','nim','src','lin_ir_runner.nim');NIM_BIN=path.join(ROOT,'benchmarks','nim','lin_ir_runner.exe');EVIDENCE_FILE=path.join(ROOT,'evidence.json');ARTIFACT_EVIDENCE_FILE=path.join(ARTIFACTS_DIR,'evidence_e8_e9.json');console.log('=== RUNNING PROTOCOL E8/E9: LIN-IR v0.1 CROSS-BACKEND EQUIVALENCE (RUST & NIM NATIVE) ===\n');if(!fs.existsSync(SPEC_FILE)){throw new Error("WORKLOAD_SPEC_V1 not found at "+(SPEC_FILE));};specText=fs.readFileSync(SPEC_FILE,'utf8');spec=JSON.parse(specText);if(!fs.existsSync(RUST_BIN)){throw new Error("Rust native runner binary not found at "+(RUST_BIN));};if(!fs.existsSync(NIM_BIN)){throw new Error("Nim native runner binary not found at "+(NIM_BIN));};tmpDir=path.join(ROOT,'artifacts','tmp_ir');fs.mkdirSync(tmpDir,{recursive:true});casesResults=[];allCasesPass=true;for(workload of spec.workloads){caseId=workload.case_id;console.log("[E8/E9] Evaluating Case: "+(caseId)+" ("+(workload.name)+")");canonicalIr=canonicalizeJson(workload.ir);linIrHashExpected=computeLinIrHash(canonicalIr);rawCanonicalSha256="sha256:"+(sha256Hex(Buffer.from(canonicalIr, 'utf8')));tmpIrPath=path.join(tmpDir,(caseId)+"_canonical.json");fs.writeFileSync(tmpIrPath,canonicalIr,'utf8');rustProc=spawnSync(RUST_BIN,[caseId,tmpIrPath],{encoding:'utf8'});if(rustProc.status!==0){console.error("Rust native execution failed for "+(caseId)+":",rustProc.stderr);throw new Error("Rust runner failed for "+(caseId));};rustOutput=JSON.parse(rustProc.stdout.trim());nimProc=spawnSync(NIM_BIN,[caseId,tmpIrPath],{encoding:'utf8'});if(nimProc.status!==0){console.error("Nim native execution failed for "+(caseId)+":",nimProc.stderr);throw new Error("Nim runner failed for "+(caseId));};nimOutput=JSON.parse(nimProc.stdout.trim());oracleOutput;if(caseId==='C01') {oracleOutput=oracleC01();}:( caseId==='C02' ){oracleOutput=oracleC02()}:( caseId==='C03' ){oracleOutput=oracleC03()}:{throw new Error("Unknown case: "+(caseId))}integrity=(rustOutput.lin_ir_hash===linIrHashExpected)&&(nimOutput.lin_ir_hash===linIrHashExpected);rustCorrect=rustOutput.result_hash===oracleOutput.result_hash;nimCorrect=nimOutput.result_hash===oracleOutput.result_hash;equivalent=rustOutput.result_hash===nimOutput.result_hash;gateEligible=integrity&&rustCorrect&&nimCorrect&&equivalent;if(!gateEligible) {allCasesPass=false;}caseRecord={case_id:caseId,name:workload.name,canonical_bytes_len:Buffer.byteLength(canonicalIr,'utf8'),canonical_bytes_sha256:rawCanonicalSha256,lin_ir_hash_expected:linIrHashExpected,lin_ir_hash_rust:rustOutput.lin_ir_hash,lin_ir_hash_nim:nimOutput.lin_ir_hash,oracle_expected:oracleOutput.result_hash,rust_result:rustOutput.result_hash,nim_result:nimOutput.result_hash,values:{oracle_value:oracleOutput.result,rust_value:rustOutput.result,nim_value:nimOutput.result,},checks:{integrity,rust_correct:rustCorrect,nim_correct:nimCorrect,equivalent,},gate_eligible:gateEligible,};casesResults.push(caseRecord);console.log("  integrity    : "+(integrity ? '✅ PASS' : '❌ FAIL'));console.log("  rust_correct : "+(rustCorrect ? '✅ PASS' : '❌ FAIL'));console.log("  nim_correct  : "+(nimCorrect ? '✅ PASS' : '❌ FAIL'));console.log("  equivalent   : "+(equivalent ? '✅ PASS' : '❌ FAIL'));console.log("  gate_eligible: "+(gateEligible ? '✅ 4/4 PASS' : '❌ FAIL')+"\\n");};gateE11=allCasesPass;thisScriptPath=fileURLToPath('file:///lin-in-memory.js');evidence={protocol:'E8_E9_CROSS_BACKEND_EQUIVALENCE',run_id:'RUN-E8-E9-20260816-002',spec_version:'WORKLOAD_SPEC_V1',ir_version:'LIN/IR/0.1',timestamp_utc:new Date().toISOString(),environment_lock:{host_os:(os.platform())+" ("+(os.type())+" "+(os.release())+"; "+(os.arch())+")",node_version:process.version,rustc_version:'1.97.1 (8bab26f4f 2026-07-14)',cargo_version:'1.97.1 (c980f4866 2026-06-30)',nim_version:'2.2.0 (native compiler: orc, release, opt:speed)',gcc_version:'16.2.0 (MinGW-w64 x86_64-posix-seh-ucrt)',opt_level_rust:'release (-O)',opt_level_nim:'release (-d:release --opt:speed)',baseline_compatibility:'ENVIRONMENT_CHANGED_DO_NOT_COMPARE_WITH_RUST_1.75_NIM_2.0_BASELINE',},provenance_manifest:{workload_spec_file:'spec/WORKLOAD_SPEC_V1.json',workload_spec_sha256:fileSha256(SPEC_FILE),rust_runner_src_file:'benchmarks/rust/src/lin_ir_runner.rs',rust_runner_src_sha256:fileSha256(RUST_SRC),rust_runner_bin_file:'benchmarks/rust/lin_ir_runner.exe',rust_runner_bin_sha256:fileSha256(RUST_BIN),rust_compiler_cmd:'rustc -O benchmarks/rust/src/lin_ir_runner.rs -o benchmarks/rust/lin_ir_runner.exe',nim_runner_src_file:'benchmarks/nim/src/lin_ir_runner.nim',nim_runner_src_sha256:fileSha256(NIM_SRC),nim_runner_bin_file:'benchmarks/nim/lin_ir_runner.exe',nim_runner_bin_sha256:fileSha256(NIM_BIN),nim_compiler_cmd:'nim c -d:release --opt:speed -o:benchmarks/nim/lin_ir_runner.exe benchmarks/nim/src/lin_ir_runner.nim',orchestrator_script_file:'scripts/run_e8_e9_ir_equivalence.mjs',orchestrator_script_sha256:fileSha256(thisScriptPath),},cases:casesResults,gate_e11:gateE11,summary:{total_cases:casesResults.length,passed_cases:casesResults.filter((c)=>c.gate_eligible).length,gate_status:gateE11?'GATE_E11 = TRUE':'GATE_E11 = FALSE',conclusion:'E8/E9 demonstrou conformidade semântica do LIN-IR v0.1 entre os executores nativos Rust 1.97.1 e Nim 2.2.0 para C01–C03, sob o protocolo executado, e habilitou formalmente E11 com custódia criptográfica completa de fontes e binários compilados.',},};fs.writeFileSync(EVIDENCE_FILE,JSON.stringify(evidence,null,2),'utf8');fs.writeFileSync(ARTIFACT_EVIDENCE_FILE,JSON.stringify(evidence,null,2),'utf8');console.log('============================================================');console.log("FINAL RESULT: GATE_E11 = "+(gateE11 ? 'TRUE' : 'FALSE'));console.log("Evidence persisted to: "+(EVIDENCE_FILE)+" and "+(ARTIFACT_EVIDENCE_FILE));console.log('============================================================\n');^evidence}
=ex{canonicalizeJson,sha256Hex,computeLinIrHash,computeResultHash,fileSha256,oracleC01,oracleC02,oracleC03,runProtocolE8E9}