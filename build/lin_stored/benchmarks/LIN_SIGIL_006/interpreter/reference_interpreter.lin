@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(ast){this.ast=ast;this.fnMap=new Map();for(fn of ast.functions){this.fnMap.set(fn.name,fn);}}
!evalExpr(exprStr,scope){s=exprStr.trim();for(const[k,v] of  Object.entries(scope)){regex=new RegExp("\\\\b"+(k)+"\\\\b",'g');s=s.replace(regex,v);};try{sanitized=s.replace(/[^0-9+\-*/%><=!&|() ]/g,'');fn=new Function("^Boolean("+(s)+");");^fn();}catch(e){^false;}}
!evalArithmetic(bodyStr,scope){s=bodyStr.replace(/^\^/g,'').replace(/let result = /g,'').trim();for(const[k,v] of  Object.entries(scope)){regex=new RegExp("\\\\b"+(k)+"\\\\b",'g');s=s.replace(regex,v);};try{fn=new Function("^Number("+(s)+");");^Math.floor(fn());}catch(e){^0;}}
!execute(entryFnName,initialArgs){trace=[];fnMap=this.fnMap;self=this;function invokeFn(fnName,args,callerEffect='Pure'){fn=fnMap.get(fnName);if(!fn){trace.push("ABORT:FN_NOT_FOUND:"+(fnName));return{ok:false,reason:'FN_NOT_FOUND',trace};};trace.push("ENTER:"+(fnName));fnEffect=fn.effects[0]||'Pure';if(callerEffect==='Pure'&&fnEffect!=='Pure'){trace.push("EFFECT_LEAK:Pure_calls_"+(fnEffect));trace.push("ABORT:EFFECT_LEAK");return{ok:false,reason:'EFFECT_LEAK',trace};};for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='pre'){pass=self.evalExpr(c.expr,args);if(pass){trace.push("PRE_PASS:c"+(i));}:{trace.push("PRE_FAIL:c"+(i));trace.push("ABORT:PRECONDITION_VIOLATED");return{ok:false,reason:'PRECONDITION_VIOLATED',trace}}}};res=0;if(fn.calls){trace.push("CALL:"+(fn.calls.target));callRes=invokeFn(fn.calls.target,fn.calls.args(args),fnEffect);if(!callRes.ok) {^callRes;}res=callRes.result;}:{res=self.evalArithmetic(fn.body,args)};postScope={...args,result:res};for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='post'){pass=self.evalExpr(c.expr,postScope);if(pass){trace.push("POST_PASS:c"+(i));}:{trace.push("POST_FAIL:c"+(i));trace.push("ABORT:POSTCONDITION_VIOLATED");return{ok:false,reason:'POSTCONDITION_VIOLATED',trace}}}};trace.push("RETURN:"+(res));return{ok:true,result:res,trace};};execRes=invokeFn(entryFnName,initialArgs,'Pure');return{status:execRes.ok?'ACCEPTED':'REJECTED',reason:execRes.reason||'OK',result:execRes.ok?execRes.result:null,trace}}
=ex{constructor,evalExpr,evalArithmetic,execute}