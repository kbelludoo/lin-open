@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!emitTypeScript(ast){code="// Generic TS Emit with Semantic Trace Execution\\n\\n";code+="export;TRACE= [];\\n\\n";effMap={};for(fn of ast.functions){effMap[fn.name]=fn.effects[0]||'Pure';};code+="EFFECTS = "+(JSON.stringify(effMap))+";\\n\\n";for(fn of ast.functions){paramsList=fn.params.map(p=>p.name).join(', ');code+="export function "+(fn.name)+"("+(paramsList)+", callerEffect = 'Pure') {\\n";code+="  TRACE.push(\"ENTER:"+(fn.name)+"\");\\n";code+="  myEff = EFFECTS[\""+(fn.name)+"\"] || 'Pure';\\n";code+="  if (callerEffect === 'Pure' && myEff !== 'Pure') {\\n";code+="    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\\n";code+="    TRACE.push(\"ABORT:EFFECT_LEAK\");\\n";code+="    throw new Error(\"EFFECT_LEAK\");\\n";code+="  }\\n";for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='pre'){code+="  if (!("+(c.expr)+")) {\\n";code+="    TRACE.push(\"PRE_FAIL:c"+(i)+"\");\\n";code+="    TRACE.push(\"ABORT:PRECONDITION_VIOLATED\");\\n";code+="    throw new Error(\"PRECONDITION_VIOLATED\");\\n";code+="  } :{\\n";code+=";    TRACE.push(\"PRE_PASS:c"+(i)+"\");\\n";code+="  }\\n"}};if(fn.calls){code+="  TRACE.push(\"CALL:"+(fn.calls.target)+"\");\\n";code+="  result = "+(fn.calls.target)+"("+(paramsList)+", myEff);\\n";}:{bodyExpr=fn.body.replace(/^\^/g,'').replace(/let result = /g,'').trim();code+="  result = "+(bodyExpr)+";\\n"};for(i=0;i<fn.contracts.length;i++){c=fn.contracts[i];if(c.kind==='post'){code+="  if (!("+(c.expr)+")) {\\n";code+="    TRACE.push(\"POST_FAIL:c"+(i)+"\");\\n";code+="    TRACE.push(\"ABORT:POSTCONDITION_VIOLATED\");\\n";code+="    throw new Error(\"POSTCONDITION_VIOLATED\");\\n";code+="  } :{\\n";code+=";    TRACE.push(\"POST_PASS:c"+(i)+"\");\\n";code+="  }\\n"}};code+="  TRACE.push(\"RETURN:\" + result);\\n";code+="  ^result;\\n}\\n\\n";};^code}
=ex{emitTypeScript}