@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!runRustBackend(mode,datasetFile,workloadFile){RUST_BIN=path.join(ROOT_DIR,"backends/rust_engine/target/release/rust_engine_v3");tmpOut=path.join("/tmp","rust_v3_"+(mode)+"_out.json");execFileSync(RUST_BIN,[mode,datasetFile,workloadFile,tmpOut]);data=JSON.parse(fs.readFileSync(tmpOut,"utf-8"));try{fs.unlinkSync(tmpOut);}catch(e){};^data}
!runSuite(){ROOT_DIR=path.resolve(path.dirname(new URL('file:///lin-in-memory.js').pathname),"..");console.log("================================================================================");console.log("    LIN-MEM-003: CANONICAL COMPOSITE INDEXES & MULTI-HOP (100K -> 500K -> 1M)   ");console.log("================================================================================");scales=[100000,500000,1000000];regimes=["shared","unique"];opCount=20000;seed=424242;results=[];for(scale of scales){for(regime of regimes){console.log("\\n>>> [SCALE: "+(scale)+" | REGIME: "+(regime.toUpperCase())+"]");dataset=generateDataset({scale,regime,seed});workload=generateWorkload({dataset,opCount,seed});datasetPath=path.join("/tmp","d3_"+(scale)+"_"+(regime)+".json");workloadPath=path.join("/tmp","w3_"+(scale)+"_"+(regime)+".json");fs.writeFileSync(datasetPath,JSON.stringify(dataset));fs.writeFileSync(workloadPath,JSON.stringify(workload));console.log("  -> Running Rust HashMap (compound tuple index)...");rustHash=runRustBackend("hashmap",datasetPath,workloadPath);delete rustHash.results;console.log("  -> Running Rust Arena (interned ID compound index)...");rustArena=runRustBackend("arena_interned",datasetPath,workloadPath);delete rustArena.results;console.log("  -> Running LIN Semantic Engine V3 (Canonical Composite Index)...");linEngine=runRustBackend("lin_semantic_engine",datasetPath,workloadPath);delete linEngine.results;console.log("     [Density] Rust HashMap: "+((rustHash.resident_heap_bytes / 1024 / 1024).toFixed(2))+" MB ("+(rustHash.bytes_per_entity.toFixed(1))+" B/ent)");console.log("     [Density] LIN Engine:   "+((linEngine.resident_heap_bytes / 1024 / 1024).toFixed(2))+" MB ("+(linEngine.bytes_per_entity.toFixed(1))+" B/ent) [DAG Nodes: "+(linEngine.unique_dag_nodes)+"]");console.log("     [Throughput L2] Rust HashMap: "+((rustHash.L2.ops_per_sec / 1e6).toFixed(2))+"M ops/s | LIN Engine V3: "+((linEngine.L2.ops_per_sec / 1e6).toFixed(2))+"M ops/s");console.log("     [Throughput L3] Rust HashMap: "+((rustHash.L3.ops_per_sec / 1e6).toFixed(2))+"M ops/s | LIN Engine V3: "+((linEngine.L3.ops_per_sec / 1e6).toFixed(2))+"M ops/s");results.push({scale,regime,rust_hashmap:rustHash,rust_arena:rustArena,lin_semantic_engine:linEngine});try{fs.unlinkSync(datasetPath);}catch(e){};try{fs.unlinkSync(workloadPath);}catch(e){}}};outPath=path.join(ROOT_DIR,"results/LIN_MEM_003_COMPOSITE_SUMMARY.json");fs.writeFileSync(outPath,JSON.stringify(results,null,2));console.log("\\n[+] LIN-MEM-003 Complete! Saved to "+(outPath))}
=ex{runRustBackend,runSuite}