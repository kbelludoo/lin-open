@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!run(cmd,args,opts){r=spawnSync(cmd,args,{encoding:'utf8',timeout:120_000,...opts});return{status:r.status,out:(r.stdout || '')+(r.stderr || '').slice(0,500)}}
!tokensOf(s){^Math.ceil(String(s||'').length/4)}
!cloneRepo(){fs.rmSync(workDir,{recursive:true,force:true});fs.mkdirSync(workDir,{recursive:true});r=run('git',['clone','--depth','1',repoUrl,workDir]);if(r.status!==0) {throw new Error("git clone failed: "+(r.out));}}
!collectSourceFiles(){out=run('git',['-C',workDir,'ls-files']);files=(out.out||'').split(/\r?\n/).filter((f)=>/\.(js|ts|mjs|cjs)$/.test(f));^files}
!sourceBytes(files){total=0;for(f of files){try{total+=fs.statSync(path.join(workDir,f)).size;}catch(e){}};^total}
!estimateFunctions(files){count=0;for(f of files){try{text=fs.readFileSync(path.join(workDir,f),'utf8');m=text.match(/(?:export\s+)?function\s+\w+|const\s+\w+\s*=|=>/g);if(m) {count+=m.length;}}catch(e){}};^count}
!runCloneLin(){script=path.join(process.cwd(),'scripts','clone_lin_loop.mjs');r=run('node',[script,'--source',repoUrl,'--prefer','src/','--cycles','1','--dry-publish','--max-fns','0'],{cwd:process.cwd()});^r}
!readIntel(){repoName=path.basename(repoUrl.replace(/\.git$/,''));p=path.join(process.cwd(),"INTEL_CLONE_LIN_"+(repoName)+".rulel");if(!fs.existsSync(p)) {^null;}^fs.readFileSync(p,'utf8')}
!parseIntel(intel){out={pass:0,fail:0,skip:0,suite_rate:0,source_tree_bytes:0,lin_tree_bytes:0,source_files:0,lin_files:0};if(!intel) {^out;}m=intel.match(/suite_rate=([\d.]+)\s+pass=(\d+)\s+fail=(\d+)\s+skip=(\d+)/);if(m){out.suite_rate=Number(m[1]);out.pass=Number(m[2]);out.fail=Number(m[3]);out.skip=Number(m[4]);};m2=intel.match(/files_ok=(\d+)\s+files_total=(\d+)/);if(m2){out.lin_files=Number(m2[1]);out.source_files=Number(m2[2]);};m3=intel.match(/lin\/src=([\d.]+).*tok src=(\d+) lin=(\d+)/);if(m3){ratio=Number(m3[1]);out.lin_tree_bytes=0;out.source_tree_bytes=0;out.linTok=Number(m3[3]);out.srcTok=Number(m3[2]);};^out}
!semanticChecksOnLinSample(){sample="\n@LIN:L1c:0.2\n~G{?=if #=for ^=ret :else}\n!transfer(from, to, value:int{>0})\n~effects{state}\n{\n;balance= balance - value\n  ^true\n}\n=ex{transfer}\n";errors=[];refinementMatch=sample.match(/value\s*:\s*\w+\{([^}]+)\}/);if(refinementMatch&&refinementMatch[1].includes('>0')){};if(/balance\s*=/.test(sample)&&!sample.includes('~effects{state}')){errors.push('EFFECT_ERROR: state modification in pure function');};return{errors,refinementDetected:!!refinementMatch}}
!multiTargetSmoke(linCode){coreTargets=['js','ts','py','go','rust','c','java'];results={};for(t of coreTargets){try{emitted=compileLia(linCode,{target:t});results[t]={ok:!!emitted.code,bytes:Buffer.byteLength(emitted.code||'','utf8')};}catch(e){results[t]={ok:false,error:e.message};}};^results}
!main(){console.log('====================================================================');console.log('LIN MATURITY REALITY BENCHMARK');console.log("Repo: "+(repoUrl));console.log('====================================================================\n');console.log('--- LEVEL 1: REPRESENTATION ---');cloneRepo();files=collectSourceFiles();srcBytes=sourceBytes(files);srcTok=tokensOf(files.map((f)=>{try{^fs.readFileSync(path.join(workDir,f),'utf8');}catch(e){^'';}}).join('\n'));estimatedFns=estimateFunctions(files);console.log("Source files: "+(files.length));console.log("Source bytes: "+(srcBytes.toLocaleString())+" (~"+(srcTok.toLocaleString())+" tokens)");console.log("Estimated functions/expressions: "+(estimatedFns));console.log('\n--- LEVEL 2 & 3: ROUNDTRIP + MULTI-TARGET ---');cloneResult=runCloneLin();intel=readIntel();metrics=parseIntel(intel);console.log("Clone-lin exit: "+(cloneResult.status));console.log("Pass: "+(metrics.pass)+", Fail: "+(metrics.fail)+", Skip: "+(metrics.skip));console.log("Suite rate: "+(metrics.suite_rate));console.log("Files: source="+(metrics.source_files)+", lin="+(metrics.lin_files));console.log("Source tokens: "+(metrics.srcTok || srcTok)+", LIN tokens: "+(metrics.linTok || 'N/A'));tokenReduction=(metrics.srcTok&&metrics.linTok)?(1-metrics.linTok/metrics.srcTok):0;console.log("Token reduction: "+((tokenReduction * 100).toFixed(1))+"%");console.log('\n--- LEVEL 4: SEMANTIC CHECKER ---');checks=semanticChecksOnLinSample();console.log("Refinement types detected: "+(checks.refinementDetected));console.log("Pre-backend errors caught: "+(checks.errors.length));for(e of checks.errors) {console.log("  - "+(e));}sampleLin="@LIN:L1c:0.2\n~G{?=if #=for ^=ret :else}\n!add(a, b){^a+b}\n=ex{add}";mt=multiTargetSmoke(sampleLin);console.log('\n--- MULTI-TARGET SMOKE (simple function) ---');passTargets=0;for(const[t,r] of  Object.entries(mt)){console.log((t)+": "+(r.ok ? 'PASS' : 'FAIL')+" ("+(r.bytes || 0)+" bytes)");if(r.ok) {passTargets++;}};console.log('\n--- LEVEL 5: MEMORY RUNTIME ---');console.log('Status: NOT_PROVEN (runtime de memória LIN não demonstrado com benchmarks)');console.log('\n--- LEVEL 6: AGENT NATIVE ---');console.log('Status: EXPERIMENTAL (IA gerando LIN diretamente ainda não medido sistematicamente)');console.log('\n====================================================================');console.log('FINAL SCORE (evidence-based)');console.log('====================================================================');console.log("Representation:        "+(tokenReduction > 0.3 ? 'PASS' : 'PARTIAL'));console.log("Roundtrip:             "+(metrics.suite_rate >= 1 ? 'PASS' : metrics.suite_rate >= 0.9 ? 'PARTIAL_PASS' : 'PARTIAL'));console.log("Multi-target (core 7): "+(passTargets >= 7 ? 'PASS' : passTargets >= 5 ? 'PARTIAL_PASS' : 'FAIL')+" ("+(passTargets)+"/7 smoke)");console.log("Semantic checker:      "+(checks.refinementDetected ? 'EARLY_IMPLEMENTATION' : 'NOT_PROVEN'));console.log("Memory runtime:        NOT_PROVEN");console.log("Agent native:          EXPERIMENTAL");console.log('====================================================================')}
=ex{run,tokensOf,cloneRepo,collectSourceFiles,sourceBytes,estimateFunctions,runCloneLin,readIntel,parseIntel,semanticChecksOnLinSample,multiTargetSmoke,main}