@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!parseArgs(argv){DEFAULT_ROOT='C:\\Users\\k\\Documents\\ail-bench\\clone-400k\\TypeScript\\src';out={root:DEFAULT_ROOT,maxFns:0,holdoutN:8,alsoLodash:true};for(i=0;i<argv.length;i++){a=argv[i];if(a==='--root'&&argv[i+1]) {out.root=path.resolve(argv[++i]);}:( a==='--max-fns'&&argv[i+1] ){out.maxFns=Number(argv[++i])||0}:( a==='--holdout-n'&&argv[i+1] ){out.holdoutN=Number(argv[++i])||8}:( a==='--no-lodash' ){out.alsoLodash=false}};^out}
!hashOutputs(outputs){json=JSON.stringify(outputs.map((o)=>String(o)));^crypto.createHash('sha256').update(json).digest('hex')}
!generateHoldout(arity,count){seeded=[[0],[1],[2],[-1],[''],['a'],['foo'],['bar'],[10],[42],[0,0],[1,2],[2,3],[5,7],['a','a'],['a','b'],['foo','foo'],['foo','bar'],['',''],['prefix','pre'],[0,1,2],[1,2,3],['a','b','c'],[true,false,0],];inputs=[];for(i=0;i<count;i++){base=seeded[i%seeded.length];args=[];for(j=0;j<arity;j++) {args.push(base[j%base.length]);}inputs.push(args);};^inputs}
!walkSourceFiles(root){files=[];function walk(dir){entries;try{entries=fs.readdirSync(dir,{withFileTypes:true});}catch(e){return;};for(e of entries){p=path.join(dir,e.name);if(e.isDirectory()){if(SKIP_DIR_RE.test(p+path.sep)) {continue;}walk(p);}:( e.isFile()&&SRC_EXT_RE.test(e.name) ){if(SKIP_DIR_RE.test(p)) {continue;};files.push(p)}}};walk(root);^files}
!countLoc(text){^String(text).split(/\r?\n/).length}
!stripLightTs(src){s=String(src);s=s.replace(/\/\*[\s\S]*?\*\//g,'');s=s.replace(/(^|[^:])\/\/.*$/gm,'$1');s=s.replace(/\bfunction\s+([A-Za-z_$][\w$]*)\s*<[^>]+>\s*\(/g,'function $1(');s=s.replace(/\)\s*:\s*[^{;]+\{/g,'){');for(i=0;i<8;i++){next=s.replace(/([A-Za-z_$][\w$]*)\s\?\s*:\s*[^,)=]+/g,'$1',).replace(/([A-Za-z_$][\w$]*)\s*:\s*[^,)=]+/g,'$1',);if(next===s) {break;}s=next;};s=s.replace(/\s+as\s+const\b/g,'');s=s.replace(/\s+as\s+[A-Za-z_$][\w$<>\[\]|&.,\s]*/g,'');s=s.replace(/\s+satisfies\s+[A-Za-z_$][\w$<>\[\]|&.\s]*/g,'');s=s.replace(/([A-Za-z_$0-9)\]])\!(?=\s*([.;,)\]\}\[]|$))/g,'$1');s=s.replace(/\breadonly\s+/g,'');s=s.replace(/\bpublic\s+|\bprivate\s+|\bprotected\s+|\babstract\s+/g,'');s=s.replace(/<(?:string|number|boolean|any|unknown|object|never|void)>\s*/g,'');^s}
!looksLikeTsResidue(js){return/:\s*(string|number|boolean|any|unknown|void|never|object|Error|Node)\b/.test(js)||/\sas\s+[A-Za-z_$]/.test(js)||/\)\s*:\s*[A-Za-z_$]/.test(js)}
!unsupportedReason(fn){body=String(fn.body||'');params=(fn.params||[]).join(',');if(/\basync\b/.test(body)||/\basync\b/.test(params)) {^'async';}if(/\byield\b/.test(body)) {^'generator';}if(/\bawait\b/.test(body)) {^'await';}if(/:\s*(string|number|boolean|any|unknown|void|never|object|this)\b/.test(params)){};if(/<[A-Z]/.test(params)) {^'generics_params';}if(/\.\.\./.test(params)) {^'rest_params';}if(/[{[]/.test(params)) {^'destructure_params';}if(/\bimport\s*\(/.test(body)) {^'dynamic_import';}if(/\bnew\s+target\b/.test(body)) {^'new_target';}if(/`[^`]*\$\{/.test(body)&&body.length>4000) {^'heavy_template';}^null}
!runHoldout(fn,holdout){^holdout.map((args)=>{try{^fn(...args);}catch(e){^"ERROR:"+(e && e.message ? e.message : e);}})}
!loadIsolatedFn(jsSource,name){WORK_DIR=path.join(LIA_ROOT,'.bench_400k_tmp');fs.mkdirSync(WORK_DIR,{recursive:true});tmp=path.join(WORK_DIR,"fn_"+(name)+"_"+(crypto.randomBytes(4).toString('hex'))+".cjs");fs.writeFileSync(tmp,jsSource,'utf8');try{delete require.cache[require.resolve(tmp)];mod=require(tmp);fn=typeof mod==='function'?mod:mod[name];if(typeof fn!=='function'){return{ok:false,reason:'export_not_fn',tmp};};return{ok:true,fn,tmp};}catch(e){return{ok:false,reason:"load:"+(e.message || e),tmp};}}
!cleanupTmp(tmp){try{if(tmp) {fs.unlinkSync(tmp);}}catch(e){}}
!verifyOneFn(fn,relFile){skip=unsupportedReason(fn);if(skip) {return{status:'skip',reason:skip,file:relFile,fn:fn.name};}arity=(fn.params||[]).length;holdout=generateHoldout(arity,8);origSrcRaw="function "+(fn.name)+"("+(fn.params.join(','))+"){"+(fn.body)+"}";stripped=stripLightTs(origSrcRaw);if(looksLikeTsResidue(stripped)){return{status:'skip',reason:'ts_residue',file:relFile,fn:fn.name};};origSrc=(stripped)+"\\nmodule.exports="+(fn.name)+";\\n";LIA;try{LIA=emitAilFromSource(stripped,{shortenLocals:true});}catch(e){return{status:'fail',reason:"emit:"+(e.message || e),file:relFile,fn:fn.name};};if(!LIA||!LIA.includes("!"+(fn.name)+"(")){return{status:'skip',reason:'emit_empty',file:relFile,fn:fn.name};};compiledJs;try{compiled=compileLiaToJs(LIA,{exportMode:'single'});compiledJs=compiled.js;}catch(e){return{status:'fail',reason:"compile:"+(e.message || e),file:relFile,fn:fn.name};};origLoad=loadIsolatedFn(origSrc,fn.name);if(!origLoad.ok){cleanupTmp(origLoad.tmp);return{status:'skip',reason:"orig_"+(origLoad.reason),file:relFile,fn:fn.name};};compLoad=loadIsolatedFn(compiledJs,fn.name);if(!compLoad.ok){cleanupTmp(origLoad.tmp);cleanupTmp(compLoad.tmp);return{status:'fail',reason:"comp_"+(compLoad.reason),file:relFile,fn:fn.name};};oOut=runHoldout(origLoad.fn,holdout);cOut=runHoldout(compLoad.fn,holdout);oHash=hashOutputs(oOut);cHash=hashOutputs(cOut);eq=oHash===cHash&&oOut.every((v,i)=>String(v)===String(cOut[i]));cleanupTmp(origLoad.tmp);cleanupTmp(compLoad.tmp);return{status:eq?'pass':'fail',reason:eq?'behavior_eq':'hash_mismatch',file:relFile,fn:fn.name,original_hash:oHash,compiled_hash:cHash,ail_chars:LIA.length,compiled_chars:compiledJs.length,holdout_n:holdout.length,}}
!inventoryRoot(root){files=walkSourceFiles(root);loc=0;fnsExtracted=0;fileRows=[];for(f of files){text='';try{text=fs.readFileSync(f,'utf8');}catch(e){continue;};n=countLoc(text);loc+=n;fns=extractJsFunctions(text);fnsExtracted+=fns.length;fileRows.push({path:f,loc:n,fns});};return{files,loc,fnsExtracted,fileRows}}
!summarizeReasons(rows){map={};for(r of rows){k=r.reason||r.status;map[k]=(map[k]||0)+1;};^Object.entries(map).sort((a,b)=>b[1]-a[1]).slice(0,20).map(([k,v])=>({reason:k,n:v}))}
=ex{parseArgs,hashOutputs,generateHoldout,walkSourceFiles,countLoc,stripLightTs,looksLikeTsResidue,unsupportedReason,runHoldout,loadIsolatedFn,cleanupTmp,verifyOneFn,inventoryRoot,summarizeReasons}