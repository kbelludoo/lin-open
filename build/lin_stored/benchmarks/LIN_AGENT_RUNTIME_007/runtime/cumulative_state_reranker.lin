@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(substrate,hypothesisLedger){this.substrate=substrate;this.ledger=hypothesisLedger;this.currentScoreMap=new Map()}
!resetTaskState(){this.currentScoreMap.clear();this.ledger.clear()}
!getDAGDistance(src,target){if(src===target) {^0;}queue=[[src,0]];visited=new Set([src]);while(queue.length>0){const[curr,dist]=queue.shift();callees=this.substrate.dependencyGraph.get(curr)||new Set();callers=this.substrate.getAffectedSubtree(curr);neighbors=new Set([...callees,...callers]);for(n of neighbors){if(n===target) {^dist+1;}if(!visited.has(n)){visited.add(n);queue.push([n,dist+1]);}}};^5}
!initializeBaseScores(entrySymbol,testErrorOutput){this.currentScoreMap.clear();allSymbols=Array.from(this.substrate.symbolIndex.keys());for(sym of allSymbols){node=this.substrate.symbolIndex.get(sym);if(!node) {continue;}dist=this.getDAGDistance(entrySymbol,sym);sGraph=Math.max(0.1,1.0-(dist*0.22));sError=0.0;if(testErrorOutput.includes(sym)) {sError+=0.60;}if(testErrorOutput.includes(node.module)) {sError+=0.40;}sError=Math.min(1.0,sError);invariants=(this.substrate.invariants||[]).filter(i=>i.symbol===sym);sInv=invariants.length>0?0.90:0.40;sEffect=node.effect==='Pure'?0.95:0.50;score0=(0.35*sGraph+0.30*sError+0.25*sInv+0.10*sEffect);this.currentScoreMap.set(sym,Number(score0.toFixed(3)));}}
!updateCumulativeStateOnRefutation(refutedSymbol){this.currentScoreMap.set(refutedSymbol,0.0);for(const[sym,currScore] of  this.currentScoreMap.entries()){if(sym===refutedSymbol||currScore===0.0) {continue;}dist=this.getDAGDistance(refutedSymbol,sym);if(dist>0&&dist<=3){delta=0.35/(1+dist);this.currentScoreMap.set(sym,Number((currScore+delta).toFixed(3)));}}}
!getRankedCandidates(){candidates=[];for(const[sym,score] of  this.currentScoreMap.entries()){if(score===0.0) {continue;}node=this.substrate.symbolIndex.get(sym);if(node){candidates.push({symbol:sym,module:node.module,effect:node.effect,score});}};candidates.sort((a,b)=>b.score-a.score);^candidates}
=ex{constructor,resetTaskState,getDAGDistance,initializeBaseScores,updateCumulativeStateOnRefutation,getRankedCandidates}