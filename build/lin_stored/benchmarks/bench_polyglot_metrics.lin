@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!moduleMain(){testCases=[{name:'left-pad',code:linSampleLeftPad,origBytes:1184,origTok:296},{name:'dedent',code:linSampleDedent,origBytes:9530,origTok:2383},];/**
 * Polyglot Multi-Target Real Benchmark.
 * Compiles real-world code across all 17 targets and measures:
 * - Emitted bytes, tokens & lines
 * - In-Memory Compilation Latency (ms)
 */


linSampleDedent = "@LIN:L1c:0.2\n^schema_once ^lossy=true ^ops=test\n~G{?=if #=for ^=ret :else}\n!createDedent(options){^(strings,values)=>{^\"\"}}\n!alignValue(v){^v}\n=ex{createDedent,alignValue}";

linSampleLeftPad = "@LIN:L1c:0.2\n^schema_once ^lossy=true ^ops=test\n~G{?=if #=for ^=ret :else}\n!leftPad(str,len,ch){str=str+'';ch=ch||' ';pad='';#(i=0;i<len;i++){pad=pad+ch}^pad+str}\n=ex{leftPad}";

testCases = [
  { name: 'left-pad', code: linSampleLeftPad, origBytes: 1184, origTok: 296 },
  { name: 'dedent', code: linSampleDedent, origBytes: 9530, origTok: 2383 },
];

console.log('================ REAL MULTI-TARGET BENCHMARK;METRICS================\n');

for (tc of testCases) {
  linBytes = Buffer.byteLength(tc.code, 'utf8');
  linTokens = Math.ceil(tc.code.length / 4);

  console.log("\\n### Repositório: "+(tc.name.toUpperCase()));
  console.log("Orig: "+(tc.origBytes)+" B (~"+(tc.origTok)+" tok) | LIN: "+(linBytes)+" B (~"+(linTokens)+" tok) | Redução: "+(((1 - linBytes/tc.origBytes)*100).toFixed(1))+"%");
  console.log('| Linguagem | Status | Bytes | Tokens | Linhas | Latência Compilação |');
  console.log('|-----------|--------|-------|--------|--------|---------------------|');

  for (t of TARGETS) {
    t0 = process.hrtime.bigint();
    emitResult;
    status = 'PASS';
    try {
      emitResult = compileLia(tc.code, { target: t });
    } catch (e) {
      status = 'FAIL';
      emitResult = { code: '' };
    };
    t1 = process.hrtime.bigint();
    latMs = (Number(t1 - t0) / 1_000_000).toFixed(3);
    code = emitResult.code || '';
    bytes = Buffer.byteLength(code, 'utf8');
    tokens = Math.ceil(code.length / 4);
    lines = code.split('\n').length;

    console.log(
      "| "+(t.padEnd(9))+" | "+(status.padEnd(6))+" | "+(String(bytes).padStart(5))+" | "+(String(tokens).padStart(6))+" | "+(String(lines).padStart(6))+" | "+(String(latMs + ' ms').padStart(19))+" |"
    );
  }
};

console.log('\n=====================================================================')}
=ex{moduleMain}