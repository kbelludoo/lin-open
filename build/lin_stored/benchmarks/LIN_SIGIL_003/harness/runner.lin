@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!stripSigilWrapper(line){s=line.substring(1).trim();if(s.startsWith('(')&&s.endsWith(')')){s=s.slice(1,-1).trim();};^s}
!parseLinWithContracts(src){lines=src.split('\n');functions=[];schemaInvariants=[];currentFn=null;for(i=0;i<lines.length;i++){line=lines[i].trim();if(line.startsWith('~')){}:( line.startsWith('%')&&!currentFn ){schemaInvariants.push(stripSigilWrapper(line))}:( line.startsWith('!') ){openParen=line.indexOf('(');closeParen=line.indexOf(')');if(openParen>1&&closeParen>openParen){name=line.substring(1,openParen).trim();params=line.substring(openParen+1,closeParen).split(',').map(p=>p.trim().split(':')[0].trim()).filter(Boolean);currentFn={name,params,contracts:[],effects:['pure'],body:''};functions.push(currentFn);}}:( line.startsWith('%')&&currentFn ){currentFn.contracts.push(stripSigilWrapper(line))}:( line.startsWith('*')&&currentFn ){currentFn.effects=[stripSigilWrapper(line)]}:( currentFn&&line.startsWith('{') ){bodyLines=[];i++;while(i<lines.length&&!lines[i].trim().startsWith('}')){bodyLines.push(lines[i]);i++;};currentFn.body=bodyLines.join('\n').replace(/\^/g,'^');currentFn=null}};return{functions,schemaInvariants}}
!runSemanticSuite(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');console.log("================================================================================");console.log("    LIN-SIGIL-003: SEMANTIC EXECUTION & CONTRACT/EFFECT VERIFICATION            ");console.log("================================================================================");verifier=new LinSemanticVerifier();casesDir=path.join(ROOT,'cases');caseSpecs=[{file:"01_pure_contract_pass.lin",fnName:"divide",args:{a:10,b:2},expectedStatus:"ACCEPTED"},{file:"02_precondition_fail.lin",fnName:"divide",args:{a:10,b:0},expectedStatus:"REJECTED",expectedReason:"PRECONDITION_VIOLATED"},{file:"03_postcondition_fail.lin",fnName:"divide",args:{a:10,b:2},expectedStatus:"REJECTED",expectedReason:"POSTCONDITION_VIOLATED"},{file:"04_effect_leak_fail.lin",fnName:"compute",args:{x:5},expectedStatus:"REJECTED",expectedReason:"EFFECT_LEAK"},{file:"05_invariant_struct_pass.lin",fnName:"push",args:{self:{size:0,capacity:5,items:[]},item:42},expectedStatus:"ACCEPTED"},{file:"06_invariant_violation_fail.lin",fnName:"corruptPush",args:{self:{size:0,capacity:5,items:[]},item:42},expectedStatus:"REJECTED",expectedReason:"INVARIANT_VIOLATED"}];results=[];passedCount=0;for(spec of caseSpecs){src=fs.readFileSync(path.join(casesDir,spec.file),'utf8');ast=parseLinWithContracts(src);verifier.registerSignatures(ast);effectCheck=verifier.verifyEffectIsolation(ast);finalStatus='ACCEPTED';finalReason='OK';resultValue=null;if(!effectCheck.valid){finalStatus='REJECTED';finalReason='EFFECT_LEAK';}:{targetFn=ast.functions.find(f=>f.name===spec.fnName);if(targetFn){evalRes=verifier.verifyContractExecution({fnName:targetFn.name,args:spec.args,fnBody:targetFn.body,contracts:targetFn.contracts,schemaInvariants:ast.schemaInvariants});finalStatus=evalRes.status;finalReason=evalRes.reason||'OK';resultValue=evalRes.result;}};matchedExpected=finalStatus===spec.expectedStatus&&(!spec.expectedReason||finalReason===spec.expectedReason);if(matchedExpected) {passedCount++;}console.log("  [Case "+(spec.file)+"] Result: "+(finalStatus)+" ("+(finalReason)+") | Expected: "+(spec.expectedStatus)+" -> "+(matchedExpected ? 'PASS' : 'FAIL'));results.push({case:spec.file,fnName:spec.fnName,status:finalStatus,reason:finalReason,expectedStatus:spec.expectedStatus,expectedReason:spec.expectedReason,matched:matchedExpected,resultValue});};successRate=(passedCount/caseSpecs.length)*100;console.log("\\nSemantic Gate: "+(passedCount)+"/"+(caseSpecs.length)+" test vectors accurately enforced ("+(successRate.toFixed(1))+"%).");summary={total_vectors:caseSpecs.length,passed_vectors:passedCount,success_rate:(successRate.toFixed(1))+"%",cases:results};outPath=path.join(ROOT,'results/LIN_SIGIL_003_REPORT.json');fs.writeFileSync(outPath,JSON.stringify(summary,null,2));console.log("[+] Results written to: "+(outPath));^summary}
=ex{stripSigilWrapper,parseLinWithContracts,runSemanticSuite}