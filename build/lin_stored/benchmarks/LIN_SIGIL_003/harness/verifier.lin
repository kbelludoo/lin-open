@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(){this.functionSignatures=new Map();this.schemaInvariants=new Map()}
!registerSignatures(ast){for(fn of ast.functions){this.functionSignatures.set(fn.name,{effects:fn.effects||['pure'],contracts:fn.contracts||[]});}}
!verifyEffectIsolation(ast){violations=[];for(fn of ast.functions){isPure=fn.effects.some(e=>e.toLowerCase()==='pure');if(isPure&&fn.body){for(const[calleeName,calleeSig] of  this.functionSignatures){if(calleeName!==fn.name&&fn.body.includes(calleeName)){calleeHasIO=calleeSig.effects.some(e=>e.toLowerCase()==='io');calleeHasHeapMut=calleeSig.effects.some(e=>e.toLowerCase()==='heapmut');if(calleeHasIO||calleeHasHeapMut){violations.push({type:'EFFECT_LEAK',caller:fn.name,callee:calleeName,reason:"Pure function '"+(fn.name)+"' calls non-pure function '"+(calleeName)+"' with effects ["+(calleeSig.effects.join(', '))+"]"});}}}}};return{valid:violations.length===0,violations}}
!verifyContractExecution(fnName,args,fnBody,contracts,schemaInvariants){preConditions=[];postConditions=[];invariants=[];for(inv of schemaInvariants){clean=inv.startsWith('inv:')?inv.slice(4).trim():inv.trim();invariants.push(clean);};for(c of contracts){if(c.startsWith('pre:')) {preConditions.push(c.slice(4).trim());}:( c.startsWith('post:') ){postConditions.push(c.slice(5).trim())}:( c.startsWith('inv:') ){invariants.push(c.slice(4).trim())}};oldSnapshot=args.self?JSON.parse(JSON.stringify(args.self)):null;for(pre of preConditions){try{preFn=new Function(...Object.keys(args),"^("+(pre)+");");ok=preFn(...Object.values(args));if(!ok){return{status:'REJECTED',reason:'PRECONDITION_VIOLATED',contract:pre};}}catch(err){return{status:'REJECTED',reason:'PRECONDITION_ERROR',error:err.message};}};result;try{bodyFn=new Function(...Object.keys(args),fnBody);result=bodyFn(...Object.values(args));}catch(err){return{status:'RUNTIME_ERROR',error:err.message};};for(post of postConditions){try{transformedPost=post.replace(/old\(self\.(\w+)\)/g,'oldSelf.$1');postFn=new Function(...Object.keys(args),'oldSelf','result',"^("+(transformedPost)+");");ok=postFn(...Object.values(args),oldSnapshot,result);if(!ok){return{status:'REJECTED',reason:'POSTCONDITION_VIOLATED',contract:post,result};}}catch(err){return{status:'REJECTED',reason:'POSTCONDITION_ERROR',error:err.message};}};if(args.self){for(inv of invariants){try{invFn=new Function('self',"^("+(inv)+");");ok=invFn(args.self);if(!ok){return{status:'REJECTED',reason:'INVARIANT_VIOLATED',contract:inv,state:args.self};}}catch(err){return{status:'REJECTED',reason:'INVARIANT_ERROR',error:err.message};}}};return{status:'ACCEPTED',result}}
=ex{constructor,registerSignatures,verifyEffectIsolation,verifyContractExecution}