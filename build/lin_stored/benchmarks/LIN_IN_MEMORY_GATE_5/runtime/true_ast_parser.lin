@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(type,props){this.type=type;Object.assign(this,props)}
!peek(){^tokens[pos]||{type:'EOF',value:''}}
!next(){^tokens[pos++]}
!match(value){if(peek().value===value){^next();};^null}
!expect(value){tok=next();if(!tok||tok.value!==value){throw new Error("Expected '"+(value)+"', got '"+(tok ? tok.value : 'EOF')+"' at pos "+(pos));};^tok}
!parseFunction(){expect('function');id=null;if(peek().type==='IDENTIFIER'){id=next().value;};expect('(');params=[];while(peek().value!==')'&&peek().type!=='EOF'){if(peek().type==='IDENTIFIER'){params.push(next().value);};if(peek().value===',') {next();}};expect(')');body=parseBlockStatement();^new AstNode('FunctionDeclaration',{id,params,body})}
!parseBlockStatement(){expect('{');body=[];while(peek().value!=='}'&&peek().type!=='EOF'){body.push(parseStatement());};expect('}');^new AstNode('BlockStatement',{body})}
!parseStatement(){tok=peek();if(tok.value==='if'){next();expect('(');test=parseExpression();expect(')');consequent=parseStatement();alternate=null;if(match('else')){alternate=parseStatement();};^new AstNode('IfStatement',{test,consequent,alternate});};if(tok.value==='while'){next();expect('(');test=parseExpression();expect(')');body=parseStatement();^new AstNode('WhileStatement',{test,body});};if(tok.value==='for'){next();expect('(');init=null;if(peek().value==='let'||peek().value==='var'||peek().value==='const'){init=parseVariableDeclaration();match(';');}:( peek().value!==';' ){init=parseExpression();match(';')}:{match(';')};test=null;if(peek().value!==';') {test=parseExpression();}match(';');update=null;if(peek().value!==')') {update=parseExpression();}expect(')');body=parseStatement();^new AstNode('ForStatement',{init,test,update,body});};if(tok.value==='try'){next();block=parseBlockStatement();handler=null;if(match('catch')){expect('(');param=next().value;expect(')');catchBody=parseBlockStatement();handler=new AstNode('CatchClause',{param,body:catchBody});};^new AstNode('TryStatement',{block,handler});};if(tok.value==='{'){^parseBlockStatement();};if(tok.value==='return'){next();argument=null;if(peek().value!==';'&&peek().value!=='}'){argument=parseExpression();};match(';');^new AstNode('ReturnStatement',{argument});};if(tok.value==='let'||tok.value==='const'||tok.value==='var'){decl=parseVariableDeclaration();match(';');^decl;};if(tok.value==='function'){^parseFunction();};expr=parseExpression();match(';');^new AstNode('ExpressionStatement',{expression:expr})}
!parseVariableDeclaration(){kind=next().value;declarations=[];while(peek().type==='IDENTIFIER'||peek().value==='['){id;if(peek().value==='['){next();items=[];while(peek().value!==']'&&peek().type!=='EOF'){if(peek().type==='IDENTIFIER') {items.push(next().value);}if(peek().value===',') {next();}};expect(']');id=items;}:{id=next().value};init=null;if(match('=')){init=parseExpression();};declarations.push(new AstNode('VariableDeclarator',{id,init}));if(!match(',')) {break;}};^new AstNode('VariableDeclaration',{kind,declarations})}
!parseExpression(){^parseAssignment()}
!parseAssignment(){left=parseConditional();tok=peek();if(tok.type==='PUNCTUATOR'&&['=','+=','-=','*=','/=','>>>=','>>=','<<=','&=','|=','^='].includes(tok.value)){op=next().value;right=parseAssignment();^new AstNode('AssignmentExpression',{operator:op,left,right});};^left}
!parseConditional(){expr=parseBinary(0);if(match('?')){consequent=parseExpression();expect(':');alternate=parseConditional();^new AstNode('ConditionalExpression',{test:expr,consequent,alternate});};^expr}
!parseBinary(minPrec){left=parsePrimary();while(peek().type==='PUNCTUATOR'&&isBinaryOp(peek().value)){op=peek().value;prec=getPrecedence(op);if(prec<minPrec) {break;}next();right=parseBinary(prec+1);left=new AstNode('BinaryExpression',{operator:op,left,right});};^left}
!isBinaryOp(op){return['===','!==','==','!=','<=','>=','<','>','+','-','*','/','%','&&','||','**','^','&','|','>>>','>>','<<'].includes(op)}
!getPrecedence(op){if(op==='||') {^1;}if(op==='&&') {^2;}if(['|','^','&'].includes(op)) {^3;}if(['===','!==','==','!='].includes(op)) {^4;}if(['<','>','<=','>='].includes(op)) {^5;}if(['>>>','>>','<<'].includes(op)) {^6;}if(op==='+'||op==='-') {^7;}if(op==='*'||op==='/'||op==='%'||op==='**') {^8;}^0}
!parsePrimary(){tok=peek();node=null;if(tok.value==='new'){next();callee=parsePrimary();^new AstNode('NewExpression',{callee});};if(tok.value==='...'){next();arg=parsePrimary();^new AstNode('SpreadElement',{argument:arg});};if(tok.value==='!'||tok.value==='-'||tok.value==='+'||tok.value==='typeof'||tok.value==='~'){op=next().value;arg=parsePrimary();^new AstNode('UnaryExpression',{operator:op,argument:arg,prefix:true});};if(tok.value==='function'){^parseFunction();};if(tok.value==='['){next();elements=[];while(peek().value!==']'&&peek().type!=='EOF'){elements.push(parseExpression());if(!match(',')) {break;}};expect(']');node=new AstNode('ArrayExpression',{elements});}:( tok.type==='STRING_LITERAL' ){next();node=new AstNode('Literal',{value:tok.value,raw:tok.value})}:( tok.type==='NUMERIC_LITERAL' ){next();node=new AstNode('Literal',{value:Number(tok.value),raw:tok.value})}:( tok.value==='{' ){next();properties=[];while(peek().value!=='}'&&peek().type!=='EOF'){keyTok=next();val=null;if(match(':')){val=parseExpression();}:{val=new AstNode('Identifier',{name:keyTok.value})};properties.push(new AstNode('Property',{key:keyTok.value,value:val}));if(!match(',')) {break;}};expect('}');node=new AstNode('ObjectExpression',{properties})}:( tok.value==='(' ){next();inner=[];while(peek().value!==')'&&peek().type!=='EOF'){inner.push(parseExpression());if(!match(',')) {break;}};expect(')');if(peek().value==='=>'){next();arrowBody=peek().value==='{'?parseBlockStatement():parseExpression();arrowParams=inner.map(i=>(i.name?i.name:String(i.value||'')));^new AstNode('FunctionDeclaration',{id:null,params:arrowParams,body:arrowBody});};node=inner.length===1?inner[0]:new AstNode('ArrayExpression',{elements:inner})}:( tok.type==='IDENTIFIER' ){idName=next().value;if(peek().value==='=>'){next();arrowBody=peek().value==='{'?parseBlockStatement():parseExpression();^new AstNode('FunctionDeclaration',{id:null,params:[idName],body:arrowBody});};node=new AstNode('Identifier',{name:idName})}:{throw new Error("Unexpected token '"+(tok.value)+"' at pos "+(pos))}while(peek().value==='('||peek().value==='.'||peek().value==='['){if(match('(')){args=[];while(peek().value!==')'&&peek().type!=='EOF'){args.push(parseExpression());if(!match(',')) {break;}};expect(')');node=new AstNode('CallExpression',{callee:node,arguments:args});}:( match('.') ){prop=next().value;node=new AstNode('MemberExpression',{object:node,property:prop,computed:false})}:( match('[') ){propExpr=parseExpression();expect(']');node=new AstNode('MemberExpression',{object:node,property:propExpr,computed:true})}};if(peek().value==='++'||peek().value==='--'){op=next().value;node=new AstNode('UpdateExpression',{operator:op,argument:node,prefix:false});};^node}
=ex{constructor,peek,next,match,expect,parseFunction,parseBlockStatement,parseStatement,parseVariableDeclaration,parseExpression,parseAssignment,parseConditional,parseBinary,isBinaryOp,getPrecedence,parsePrimary}