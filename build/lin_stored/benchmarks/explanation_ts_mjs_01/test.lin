@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!benchmark(fn,iterations,warmup){for(i=0;i<warmup;i++) {fn();}start=process.hrtime.bigint();for(i=0;i<iterations;i++) {fn();}end=process.hrtime.bigint();totalNs=Number(end-start);avgUs=(totalNs/iterations)/1000;^avgUs}
!testStringCreation(){BODY='^a+b';canon=BODY.trim();canon=canon.replace(/\s+/g,' ');^canon}
!testRegexExecution(){PARAMS='a,b';paramList=PARAMS.split(',');clean=[];for(i=0;i<paramList.length;i++){p=paramList[i].trim().replace(/:.+$/,'');if(p) {clean.push(p);}};canon=EXPECTED_CANONICAL;for(j=0;j<clean.length;j++){re=new RegExp('\\b'+clean[j]+'\\b','g');canon=canon.replace(re,'$'+j);};^canon}
!testSerialization(){canon=EXPECTED_CANONICAL;canon=canon.replace(/'/g,'"');canon=canon.replace(/===/g,'===').replace(/!==/g,'!==');canon=canon.replace(/;\s*/g,';');^'('+2+')'+canon}
!testBufferConversion(){canonical=EXPECTED_CANONICAL;buffer=Buffer.from(canonical,'utf8');^buffer}
!testCryptoCall(){canonical=EXPECTED_CANONICAL;hash=createHash('sha256').update(canonical,'utf8').digest('hex');^hash.slice(0,16)}
!testFullPipeline(){PARAMS='a,b';BODY='^a+b';canon=BODY.trim();canon=canon.replace(/\s+/g,' ');paramList=PARAMS.split(',');clean=[];for(i=0;i<paramList.length;i++){p=paramList[i].trim().replace(/:.+$/,'');if(p) {clean.push(p);}};for(j=0;j<clean.length;j++){re=new RegExp('\\b'+clean[j]+'\\b','g');canon=canon.replace(re,'$'+j);};canon=canon.replace(/'/g,'"');canon=canon.replace(/===/g,'===').replace(/!==/g,'!==');canon=canon.replace(/;\s*/g,';');canonical='('+clean.length+')'+canon;hash=createHash('sha256').update(canonical,'utf8').digest('hex');^hash.slice(0,16)}
=ex{benchmark,testStringCreation,testRegexExecution,testSerialization,testBufferConversion,testCryptoCall,testFullPipeline}