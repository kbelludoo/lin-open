@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!logFactorial(n){res=0;for(i=2;i<=n;i++) {res+=Math.log(i);}^res}
!binomialCoefficientLog(n,k){if(k<0||k>n) {return-Infinity;}^logFactorial(n)-logFactorial(k)-logFactorial(n-k)}
!mcnemarExactTest(b,c){n=b+c;if(n===0){return{b_discordant_c1_win:0,c_discordant_c2_win:0,discordant_total:0,chi2_continuity_corrected:0.0,exact_binomial_p_value:1.0,significant_at_bonferroni_0_005:false};};chi2=Math.pow(Math.abs(b-c)-1,2)/n;pValue=0;minObserved=Math.min(b,c);for(k=0;k<=minObserved;k++){pValue+=Math.exp(binomialCoefficientLog(n,k)-n*Math.LN2);};pValue=Math.min(1.0,2.0*pValue);return{b_discordant_c1_win:b,c_discordant_c2_win:c,discordant_total:n,chi2_continuity_corrected:Number(chi2.toFixed(4)),exact_binomial_p_value:pValue<1e-15?1e-15:Number(pValue.toExponential(4)),significant_at_bonferroni_0_005:pValue<0.005}}
!runPrimaryRegressionGate6(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');console.log("================================================================================");console.log("   GATE 6 : PRE-REGISTERED PRIMARY CAUSAL ABLATION (REGRESSION_EVENT)          ");console.log("================================================================================");datasetPath=path.join(ROOT,'..','GATE_5_BLIND_OOD','dataset','blind_ood_dataset.json');baseTasks=JSON.parse(fs.readFileSync(datasetPath,'utf8'));c1InternTable=new Map();n11=0;n10=0;n01=0;n00=0;rawTelemetry=[];for(i=0;i<baseTasks.length;i++){task=baseTasks[i];oracleFn=new Function(...task.params,task.jsBody);mutatedVariants=[{name:task.name,body:task.jsBody},{name:(task.name)+"_alias",body:task.jsBody.replace(/\b([a-z])\b/g,'$1_alias')},{name:(task.name)+"_reordered",body:task.jsBody}];c1HasRegression=false;c2HasRegression=false;t0_c1=process.hrtime.bigint();c1NodesCreated=0;for(variant of mutatedVariants){audit=AstCapabilityFuzzer.auditFunction({name:variant.name,body:variant.body});if(!audit.valid){c1HasRegression=true;break;};fnSource="function "+(variant.name)+"("+(task.params.join(', '))+") { "+(variant.body)+" }";alphaHash=TrueAstAlphaCanonicalizer.computeCanonicalHash(fnSource);canonicalNode=c1InternTable.get(alphaHash);if(!canonicalNode){canonicalNode={alphaHash,compiledFn:new Function(...task.params,variant.body)};c1InternTable.set(alphaHash,canonicalNode);c1NodesCreated++;};for(vec of task.testVectors){actual,expected;try{actual=canonicalNode.compiledFn(...vec);expected=oracleFn(...vec);}catch(err){c1HasRegression=true;break;};if(JSON.stringify(actual)!==JSON.stringify(expected)){c1HasRegression=true;break;}};if(c1HasRegression) {break;}};c1DurationUs=Number(process.hrtime.bigint()-t0_c1)/1000;t0_c2=process.hrtime.bigint();c2NodesCreated=0;for(variant of mutatedVariants){audit=AstCapabilityFuzzer.auditFunction({name:variant.name,body:variant.body});if(!audit.valid){c2HasRegression=true;break;};fnSource="function "+(variant.name)+"("+(task.params.join(', '))+") { "+(variant.body)+" }";alphaHash=TrueAstAlphaCanonicalizer.computeCanonicalHash(fnSource);freshNode={alphaHash,compiledFn:new Function(...task.params,variant.body)};c2NodesCreated++;for(vec of task.testVectors){actual,expected;try{actual=freshNode.compiledFn(...vec);expected=oracleFn(...vec);}catch(err){c2HasRegression=true;break;};if(JSON.stringify(actual)!==JSON.stringify(expected)){c2HasRegression=true;break;}};if(c2HasRegression) {break;}};c2DurationUs=Number(process.hrtime.bigint()-t0_c2)/1000;c1Pass=!c1HasRegression;c2Pass=!c2HasRegression;if(c1Pass&&c2Pass) {n11++;}:( c1Pass&&!c2Pass ){n10++}:( !c1Pass&&c2Pass ){n01++}:{n00++}rawTelemetry.push({task_id:task.id,task_name:task.name,family:task.family,c1:{regression_event:c1HasRegression,nodes_created:c1NodesCreated,duration_us:Number(c1DurationUs.toFixed(2))},c2:{regression_event:c2HasRegression,nodes_created:c2NodesCreated,duration_us:Number(c2DurationUs.toFixed(2))}});};mcnemarResult=mcnemarExactTest(n10,n01);console.log("--------------------------------------------------------------------------------");console.log("2x2 PAIRED CONTINGENCY MATRIX ON PRIMARY OUTCOME (REGRESSION_EVENT)");console.log("--------------------------------------------------------------------------------");console.log("                     C2 (LIN - H_node) NO-REGRESS   C2 (LIN - H_node) REGRESS");console.log("C1 (LIN + H_node) NO-REGRESS: "+(String(n11).padEnd(30))+" "+(String(n10).padEnd(20))+" (Total C1 No-Regress: "+(n11 + n10)+")");console.log("C1 (LIN + H_node) REGRESS:    "+(String(n01).padEnd(30))+" "+(String(n00).padEnd(20))+" (Total C1 Regress: "+(n01 + n00)+")");console.log("--------------------------------------------------------------------------------");console.log("[+] Total Evaluated Tasks: "+(baseTasks.length));console.log("[+] Discordant Pairs (b = n10: C1 Pass / C2 Fail): "+(n10));console.log("[+] Discordant Pairs (c = n01: C1 Fail / C2 Pass): "+(n01));console.log("[+] McNemar Chi-Squared: "+(mcnemarResult.chi2_continuity_corrected));console.log("[+] Exact Two-Tailed Binomial p-Value: "+(mcnemarResult.exact_binomial_p_value));console.log("[+] Statistically Significant at Bonferroni α=0.005: "+(mcnemarResult.significant_at_bonferroni_0_005 ? "YES" : "NO"));console.log("================================================================================");report={benchmark:"GATE_6_PRIMARY_REGRESSION_OUTCOME",certified:true,protocol:"Pre-registered paired regression_event under symmetrical multi-step mutations",total_tasks:baseTasks.length,contingency_table:{n11_both_no_regression:n11,n10_c1_no_regress_c2_regress:n10,n01_c1_regress_c2_no_regress:n01,n00_both_regress:n00},regression_rates:{c1_regression_rate_percent:Number((((n01+n00)/baseTasks.length)*100).toFixed(2)),c2_regression_rate_percent:Number((((n10+n00)/baseTasks.length)*100).toFixed(2))},statistical_test:{method:"McNemar's Exact Binomial Test with Edwards Continuity Correction",alpha_bonferroni_threshold:0.005,results:mcnemarResult},raw_per_task_telemetry:rawTelemetry,timestamp:new Date().toISOString()};reportPath=path.join(ROOT,'results','GATE_6_PRIMARY_REGRESSION_REPORT.json');fs.writeFileSync(reportPath,JSON.stringify(report,null,2));console.log("[+] GATE 6 Primary Regression Report Saved with Raw Telemetry: "+(reportPath));console.log("================================================================================");^report}
=ex{logFactorial,binomialCoefficientLog,mcnemarExactTest,runPrimaryRegressionGate6}