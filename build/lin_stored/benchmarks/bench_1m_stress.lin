@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!moduleMain(){TARGET_LINES=1_000_000;LINES_PER_FN=10;TOTAL_FNS=TARGET_LINES/LINES_PER_FN;chunks=['@LIN:L1c:0.2','^schema_once ^lossy=true ^ops=stress_1m','~G{?=if #=for ^=ret :else}',];genDurationMs=Number(tGen1-tGen0);linBytes=Buffer.byteLength(linCode,'utf8');estTokens=Math.ceil(linCode.length/4);testTargets=['js','ts','c','rust','lua','julia'];/**
 * 1 Million Lines Stress Benchmark for LIN & Polyglot Multi-Target Engine.
 * Tests:
 * - Parsing & compilation of 1,000,000 lines equivalent
 * - Memory footprint (Heap Used / Total)
 * - Compilation throughput (lines/sec & MB/sec)
 * - Token density vs Raw Source
 */

console.log('================ 1 MILLION LINES LIN;BENCHMARK================');

TARGET_LINES = 1_000_000;
LINES_PER_FN = 10;
TOTAL_FNS = TARGET_LINES / LINES_PER_FN;

console.log("Gerando código sintético em LIN correspondente a "+(TARGET_LINES.toLocaleString())+" linhas ("+(TOTAL_FNS.toLocaleString())+" funções)...");

tGen0 = process.hrtime.bigint();


chunks = [
  '@LIN:L1c:0.2',
  '^schema_once ^lossy=true ^ops=stress_1m',
  '~G{?=if #=for ^=ret :else}',
];

for (i = 0; i < TOTAL_FNS; i++) {
  chunks.push("!calc_"+(i)+"(x,y){a=x+"+(i)+";b=y*2;?(a>b){^a-b}::{^b-a}}");
};

linCode = chunks.join('\n');
tGen1 = process.hrtime.bigint();
genDurationMs = Number(tGen1 - tGen0) / 1_000_000;

linBytes = Buffer.byteLength(linCode, 'utf8');
linMb = (linBytes / (1024 * 1024)).toFixed(2);
estTokens = Math.ceil(linCode.length / 4);

console.log("LIN gerado em "+(genDurationMs.toFixed(1))+" ms | Tamanho: "+(linMb)+" MB ("+(linBytes.toLocaleString())+" bytes) | ~"+(estTokens.toLocaleString())+" tokens\\n");

testTargets = ['js', 'ts', 'c', 'rust', 'lua', 'julia'];

console.log('| Target | Compilação (s) | Vazão (linhas/s) | Vazão (MB/s) | Memória Heap (MB) | Status |');
console.log('|--------|----------------|------------------|--------------|-------------------|--------|');

for (target of testTargets) {
  if (global.gc) {global.gc();}
  memBefore = process.memoryUsage().heapUsed;
  t0 = process.hrtime.bigint();

  status = 'PASS';
  emittedCode = '';
  try {
    res = compileLia(linCode, { target, stubRuntime: false });
    emittedCode = res.code || '';
  } catch (err) {
    status = 'FAIL';
  };

  t1 = process.hrtime.bigint();
  memAfter = process.memoryUsage().heapUsed;
  durSec = Number(t1 - t0) / 1_000_000_000;
  linesPerSec = Math.round(TARGET_LINES / durSec);
  mbPerSec = (Number(linMb) / durSec).toFixed(1);
  heapDiffMb = ((memAfter - memBefore) / (1024 * 1024)).toFixed(1);

  console.log(
    "| "+(target.padEnd(6))+" | "+(durSec.toFixed(3).padStart(14))+" | "+(linesPerSec.toLocaleString().padStart(16))+" | "+((mbPerSec + ' MB/s').padStart(12))+" | "+((heapDiffMb + ' MB').padStart(17))+" | "+(status.padEnd(6))+" |"
  );
};

console.log('================================================================')}
=ex{moduleMain}