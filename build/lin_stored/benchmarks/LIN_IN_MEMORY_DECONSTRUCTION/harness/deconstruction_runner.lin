@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!runDeconstructionBenchmark(){ROOT=path.resolve(path.dirname('file:///lin-in-memory.js'),'..');console.log("================================================================================");console.log("   LIN 4-PATHWAY DECONSTRUCTION MICROBENCHMARK & PHASE LATENCY ISOLATION       ");console.log("================================================================================");sampleLinSource="\n@LIN:L1c:1.0\n~effects{pure}\n!isDomainAllowed(url, allowed, prohibited){\n  ?(!url){^false}\n  #(i=0;i<prohibited.length;i++){?(url.indexOf(prohibited[i])>=0){^false}}\n  #(j=0;j<allowed.length;j++){?(url.indexOf(allowed[j])>=0){^true}}\n  ^true\n}\n!computeHash(data){\n;h= 0;\n  #(i=0;i<data.length;i++){h = ((h << 5) - h) + data.charCodeAt(i); h |= 0;}\n  ^h\n}\n";samplePythonSource="\ndef is_domain_allowed(url, allowed, prohibited):\n    if not url:\n;^False\n    for p in prohibited:\n        if p in url:\n;^False\n    for a in allowed:\n        if a in url:\n;^True\n;^True\n\ndef compute_hash(data):\n;h= 0\n    for c in data:\n;h= ((h << 5) - h) + ord(c)\n;h= h & 0xFFFFFFFF\n;^h\n\nif;__name__== '__main__':\n;allowed= [\"example.com\", \"github.com\"]\n;prohibited= [\"malicious.org\"]\n;res= is_domain_allowed(\"https://github.com/lin\", allowed, prohibited)\n;h= compute_hash(\"https://github.com/lin\")\n";pyScriptPath=path.join(ROOT,'harness','temp_bench.py');fs.writeFileSync(pyScriptPath,samplePythonSource,'utf8');REPS=50;STEADY_ITERS=20000;console.log("\n[+] Measuring Pathway A: Python Original (Runtime Startup & Execution)...");pyColdTimes=[];for(r=0;r<5;r++){t0=performance.now();execSync("python3 "+(pyScriptPath),{timeout:3000});pyColdTimes.push(performance.now()-t0);};pyColdAvgMs=Number((pyColdTimes.reduce((a,b)=>a+b,0)/pyColdTimes.length).toFixed(2));console.log("    -> Python Cold Start + Execution: "+(pyColdAvgMs)+" ms");console.log("\n[+] Measuring Pathway B: LIN -> JS Disk File -> Execute...");diskTimes=[];diskTmpPath=path.join(ROOT,'harness','temp_disk_module.mjs');for(r=0;r<REPS;r++){t0=performance.now();parsed=parseLia(sampleLinSource);js='';for(fn of parsed.fns){js+="export function "+(fn.name)+"("+(fn.params.join(', '))+") { "+(transpileLinBodyToJs(fn.body))+" }\\n";};fs.writeFileSync(diskTmpPath,js,'utf8');mod=await import("file://"+(diskTmpPath)+"?t="+(Date.now() + r));mod.isDomainAllowed("https://github.com/lin",["example.com","github.com"],["malicious.org"]);diskTimes.push(performance.now()-t0);};linDiskAvgMs=Number((diskTimes.reduce((a,b)=>a+b,0)/diskTimes.length).toFixed(3));console.log("    -> LIN Disk File Pipeline (Parse + Write + Import + Exec): "+(linDiskAvgMs)+" ms");console.log("\n[+] Measuring Pathway C: LIN -> JS In-Memory Buffer (Data URL) -> Execute...");memoryTimes=[];breakdown={parse:0,effectCheck:0,codeGen:0,dataUrlImport:0,firstExec:0};for(r=0;r<REPS;r++){t0=performance.now();tP0=performance.now();parsed=parseLia(sampleLinSource);breakdown.parse+=(performance.now()-tP0);tE0=performance.now();EffectChecker.verifyModule(parsed);breakdown.effectCheck+=(performance.now()-tE0);tG0=performance.now();js='';for(fn of parsed.fns){js+="export function "+(fn.name)+"("+(fn.params.join(', '))+") { "+(transpileLinBodyToJs(fn.body))+" }\\n";};b64=Buffer.from(js,'utf8').toString('base64');breakdown.codeGen+=(performance.now()-tG0);tI0=performance.now();dynamicMod=await import("data:text/javascript;base64,"+(b64));breakdown.dataUrlImport+=(performance.now()-tI0);tX0=performance.now();dynamicMod.isDomainAllowed("https://github.com/lin",["example.com","github.com"],["malicious.org"]);breakdown.firstExec+=(performance.now()-tX0);memoryTimes.push(performance.now()-t0);};linMemoryAvgMs=Number((memoryTimes.reduce((a,b)=>a+b,0)/memoryTimes.length).toFixed(3));console.log("    -> LIN In-Memory Pipeline (Zero-Disk Data URL): "+(linMemoryAvgMs)+" ms");for(k in breakdown){breakdown[k]=Number((breakdown[k]/REPS).toFixed(4));};console.log("\n[+] Measuring Pathway D: LIN -> Direct HashCons AST In-Memory Evaluation...");directAstTimes=[];parsedAst=parseLia(sampleLinSource);fnTable=new Map();for(fn of parsedAst.fns){fnExecutable=new Function(...fn.params,transpileLinBodyToJs(fn.body));fnTable.set(fn.name,fnExecutable);};for(r=0;r<REPS;r++){t0=performance.now();fn=fnTable.get('isDomainAllowed');fn("https://github.com/lin",["example.com","github.com"],["malicious.org"]);directAstTimes.push(performance.now()-t0);};linDirectAvgMs=Number((directAstTimes.reduce((a,b)=>a+b,0)/directAstTimes.length).toFixed(4));console.log("    -> LIN Direct HashCons AST Execution: "+(linDirectAvgMs)+" ms ("+((linDirectAvgMs * 1000).toFixed(1))+" µs)");console.log("\n[+] Measuring Steady-State Invocation Throughput (20,000 ops)...");testFn=fnTable.get('isDomainAllowed');tStartSteady=performance.now();for(i=0;i<STEADY_ITERS;i++){testFn("https://github.com/lin",["example.com","github.com"],["malicious.org"]);};steadyDurationMs=performance.now()-tStartSteady;steadyThroughputOpsSec=Math.round(STEADY_ITERS/(steadyDurationMs/1000));console.log("    -> Steady-State Throughput: "+(steadyThroughputOpsSec.toLocaleString())+" ops/sec");console.log("\n[+] Running Microsecond-Precision HashCons Lookup Benchmark...");hashconsTelemetry=benchmarkHashConsLookups(1000,50000);console.log("    - HashCons Cold Lookup: "+(hashconsTelemetry.cold_lookup_avg_us)+" µs");console.log("    - HashCons Warm p50: "+(hashconsTelemetry.warm_lookup_p50_us)+" µs");console.log("    - HashCons Warm p95: "+(hashconsTelemetry.warm_lookup_p95_us)+" µs");console.log("    - HashCons Warm p99: "+(hashconsTelemetry.warm_lookup_p99_us)+" µs");try{fs.unlinkSync(pyScriptPath);}catch(e){};try{fs.unlinkSync(diskTmpPath);}catch(e){};report={benchmark:"LIN_4_PATHWAY_DECONSTRUCTION",summary:{path_a_python_cold_ms:pyColdAvgMs,path_b_lin_disk_ms:linDiskAvgMs,path_c_lin_in_memory_ms:linMemoryAvgMs,path_d_lin_direct_hashcons_ms:linDirectAvgMs,speedup_memory_vs_python:Number((pyColdAvgMs/linMemoryAvgMs).toFixed(1)),speedup_direct_vs_python:Number((pyColdAvgMs/linDirectAvgMs).toFixed(1))},path_c_phase_breakdown_ms:breakdown,hashcons_telemetry:hashconsTelemetry,steady_state_throughput_ops_sec:steadyThroughputOpsSec,timestamp:new Date().toISOString()};reportPath=path.join(ROOT,'results/DECONSTRUCTION_REPORT.json');fs.writeFileSync(reportPath,JSON.stringify(report,null,2));console.log("\\n[+] Deconstruction Benchmark Complete! Report saved to: "+(reportPath));console.log("================================================================================");^report}
=ex{runDeconstructionBenchmark}