@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!constructor(){this.internTable=new Map();this.symbolIndex=new Map();this.telemetry={totalInternRequests:0,rejectedByCapabilityChecker:0,uniqueCanonicalNodes:0,structuralAlphaHits:0}}
!reset(){this.internTable.clear();this.symbolIndex.clear();this.telemetry={totalInternRequests:0,rejectedByCapabilityChecker:0,uniqueCanonicalNodes:0,structuralAlphaHits:0}}
!computeAlphaCanonicalHash(astNode){rawParams=astNode.params||[];alphaBody=String(astNode.body||'').replace(/\s+/g,' ').trim();for(i=0;i<rawParams.length;i++){p=rawParams[i].trim();if(p){paramRegex=new RegExp("\\\\b"+(p)+"\\\\b",'g');alphaBody=alphaBody.replace(paramRegex,"$p"+(i));}};canonicalTree={kind:astNode.kind||'FUNCTION',arity:rawParams.length,effect:astNode.effect||'Pure',contracts:astNode.contracts||[],alphaBody};^crypto.createHash('sha256').update(JSON.stringify(canonicalTree)).digest('hex')}
!internNode(moduleName,astNode){this.telemetry.totalInternRequests++;try{AstCapabilityChecker.enforcePurityOrThrow(astNode);}catch(err){this.telemetry.rejectedByCapabilityChecker++;throw err;};alphaHash=this.computeAlphaCanonicalHash(astNode);canonicalNode=this.internTable.get(alphaHash);if(!canonicalNode){canonicalNode={alphaHash,primaryName:astNode.name,params:(astNode.params||[]).map((_,i)=>"$p"+(i)),originalParams:astNode.params||[],effect:astNode.effect||'Pure',contracts:astNode.contracts||[],body:astNode.body,compiledFn:null};this.internTable.set(alphaHash,canonicalNode);this.telemetry.uniqueCanonicalNodes++;}:{this.telemetry.structuralAlphaHits++};symbolKey=(moduleName)+":"+(astNode.name);this.symbolIndex.set(symbolKey,alphaHash);^canonicalNode}
!resolveSymbol(moduleName,symbolName){symbolKey=(moduleName)+":"+(symbolName);hash=this.symbolIndex.get(symbolKey);if(!hash) {^null;}^this.internTable.get(hash)||null}
!executeCanonicalNode(canonicalNode,...args){if(!canonicalNode) {throw new Error("Null canonical node execution");}if(!canonicalNode.compiledFn){canonicalNode.compiledFn=new Function(...canonicalNode.originalParams,canonicalNode.body);};^canonicalNode.compiledFn(...args)}
!resolveAndExecute(moduleName,symbolName,...args){node=this.resolveSymbol(moduleName,symbolName);if(!node) {throw new Error("Symbol '"+(moduleName)+":"+(symbolName)+"' not found in HashCons");}^this.executeCanonicalNode(node,...args)}
=ex{constructor,reset,computeAlphaCanonicalHash,internNode,resolveSymbol,executeCanonicalNode,resolveAndExecute}