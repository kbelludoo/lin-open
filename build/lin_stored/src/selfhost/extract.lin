@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!stripJsComments(src){toks=tokenize(String(src||'').replace(/^#!.*\n/,''));out='';lastEnd=0;for(t of toks){if(t.type==='comment'){out+=src.slice(lastEnd,t.start);lastEnd=t.end;}};out+=src.slice(lastEnd);^out}
!extractJsFunctions(src){s=String(src||'');clean=stripJsComments(s).replace(/^\s*export\s+default\s+/gm,'').replace(/^\s*export\s+\{[^}]*\}\s*;?\s*$/gm,'').replace(/^\s*export\s+/gm,'').replace(/^\s*import\s+type\s+[^;]+;\s*$/gm,'').replace(/^\s*import\s+[^;]+;\s*$/gm,'');fns=[];seen=new Set();pushFn=(name,params,body,kind)=>{if(!name||seen.has(name)) {return;}fns.push({name,params:splitParams(params),rawParams:params.trim(),body:body.trim(),kind});seen.add(name);};kwRe=/(?:^|[;{}\n])\s*(?:export\s+)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)\s*\(/g;m;while((m=kwRe.exec(clean))!==null){name=m[1];openParen=clean.indexOf('(',m.index+m[0].length-1);closeParen=matchBracket(clean,openParen,'(',')');if(closeParen<0) {continue;}j=closeParen+1;while(j<clean.length&&/\s/.test(clean[j])) {j++;}if(clean[j]!=='{') {continue;}closeBrace=matchBracket(clean,j,'{','}');if(closeBrace<0) {continue;}pushFn(name,clean.slice(openParen+1,closeParen),clean.slice(j+1,closeBrace),'declaration');kwRe.lastIndex=closeBrace;};varRe=/(?:^|[;{}\n])\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s*)?(?:function\b\s*\*?\s*[A-Za-z_$][\w$]*\s*)?\(/g;while((m=varRe.exec(clean))!==null){name=m[1];openParen=clean.indexOf('(',m.index+m[0].length-1);closeParen=matchBracket(clean,openParen,'(',')');if(closeParen<0) {continue;}j=closeParen+1;while(j<clean.length&&/\s/.test(clean[j])) {j++;}if(clean[j]!=='{') {continue;}closeBrace=matchBracket(clean,j,'{','}');if(closeBrace<0) {continue;}pushFn(name,clean.slice(openParen+1,closeParen),clean.slice(j+1,closeBrace),'assigned');varRe.lastIndex=closeBrace;};return{fns,rest:clean}}
!splitParams(raw){^String(raw||'').split(',').map((p)=>p.replace(/\s*=\s*[\s\S]+$/,'').trim().replace(/\s*:.*$/,'').trim()).filter(Boolean)}
!matchBracket(s,openIdx,openCh,closeCh){if(openIdx<0||s[openIdx]!==openCh) {return-1;}depth=0;quote=null;for(i=openIdx;i<s.length;i++){c=s[i];if(quote){if(c==='\\') {i++;}:( c===quote ){quote=null}continue;};if(c==='"'||c==="'"||c==='`'){quote=c;continue;};if(c===openCh) {depth++;}:( c===closeCh ){depth--;if(depth===0) {^i;}}};return-1}
!siblingsPrelude(fns,targetName){parts=[];for(fn of fns||[]){if(!fn.name||fn.name===targetName) {continue;}try{new Function("function "+(fn.name)+"(){"+(fn.body)+"}");parts.push("function "+(fn.name)+"("+(fn.rawParams)+"){"+(fn.body)+"}");}catch(e){}};^parts.join('\n')}
!extractTopLevelVars(src){toks=tokenize(stripJsComments(String(src||'')));vars=[];firstFn=toks.length;{depth=0;for(k=0;k<toks.length;k++){t=toks[k];if(t.type==='punct'){if('([{'.includes(t.value)) {depth++;}:( ')]}'.includes(t.value) ){depth--}:( depth===0&&t.value==='!' ){firstFn=k;break}};if(t.type==='id'&&t.value==='function'&&depth===0){firstFn=k;break;}}};i=0;while(i<firstFn&&toks[i].type!=='eof'){t=toks[i];if(t.type==='nl'||t.type==='punct'&&t.value===';'){i++;continue;};if(t.type==='id'&&['var','let','const'].includes(t.value)){nameTok=toks[i+1];if(nameTok&&nameTok.type==='id'&&toks[i+2]?.value==='='){initStart=i+3;j=initStart;depth=0;for(;j<toks.length;j++){tk=toks[j];if(tk.type==='punct'){if('([{'.includes(tk.value)) {depth++;}:( ')]}'.includes(tk.value) ){depth--;if(depth===0){j++;break;}}:( depth===0&&tk.value===';' ){break}}:( tk.type==='nl'&&depth===0 ){break}};initText=joinToks(toks,initStart,j);if(initText&&!/\bfunction\b/.test(initText)){vars.push({name:nameTok.value,init:initText});};i=j;continue;}};i++;};^vars}
!joinToks(toks,from,toExclusive){parts=[];for(i=from;i<toExclusive&&i<toks.length;i++){t=toks[i];if(t.type==='nl') {continue;}parts.push(t.value);};^parts.join(' ').trim()}
=ex{stripJsComments,extractJsFunctions,splitParams,matchBracket,siblingsPrelude,extractTopLevelVars,joinToks}