@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!fnBodyText(fn){if(typeof fn.body==='string') {^fn.body;}^renderBody(fn.body||[])}
!inferEffect(fn,allFns){collectAssignedIds=linCollectAssignedIds;body=fnBodyText(fn);paramNames=Array.isArray(fn.params)?fn.params.map((p)=>(typeof p==='string'?p:p.name)):String(fn.params||'').split(',').map((p)=>p.replace(/:[\w\[\]|,]+$/g,'').trim()).filter(Boolean);params=new Set(paramNames);locals=new Set(collectAssignedIds(body));for(p of params) {locals.add(p);}effects=new Set();if(/\bthrow\b/.test(body)) {effects.add('Throw');}if(NATIVE_BUILTINS.test(body)) {effects.add('Native');}allOtherRefs=(allFns||[]).filter((g)=>g.name!==fn.name).map((g)=>fnBodyText(g)).join('\n');assignRe=/(?:^|[;{},])\s*([A-Za-z_$][\w$]*)\s*=(?!=)/g;am;while((am=assignRe.exec(body))!==null){id=am[1];if(['return','if','for','else','function','var','let','const'].includes(id)) {continue;}if(!locals.has(id)){effects.add('Write');}:( new RegExp("\\\\b"+(id)+"\\\\b").test(allOtherRefs) ){effects.add('Write')}};idRe=/\b([A-Za-z_$][\w$]*)\b/g;rm;while((rm=idRe.exec(body))!==null){id=rm[1];if(!params.has(id)&&!locals.has(id)&&!BUILTIN_SET.has(id)){effects.add('Read');}};for(other of allFns||[]){if(other.name===fn.name) {continue;}callRe=new RegExp("\\\\b"+(other.name)+"\\\\s*\\\\(");if(callRe.test(body)){for(e of String(other.effect||inferEffectOnce(other,allFns)).split(/\|/)){if(e) {effects.add(e);}}}};if(effects.has('Write')) {^'Write';}if(effects.has('Throw')) {^'Throw';}if(effects.has('Native')) {^'Native';}if(effects.has('Read')) {^'Read';}^'Pure'}
!inferEffectOnce(fn,allFns){collectAssignedIds=linCollectAssignedIds;body=fnBodyText(fn);params=new Set(Array.isArray(fn.params)?fn.params.map((p)=>(typeof p==='string'?p:p.name)):String(fn.params||'').split(',').map((p)=>p.trim()).filter(Boolean),);locals=new Set(collectAssignedIds(body));for(p of params) {locals.add(p);}if(/\bthrow\b/.test(body)) {^'Throw';}if(NATIVE_BUILTINS.test(body)) {^'Native';}assignRe=/(?:^|[;{},])\s*([A-Za-z_$][\w$]*)\s*=(?!=)/g;am;while((am=assignRe.exec(body))!==null){id=am[1];if(['return','if','for','else','function','var','let','const'].includes(id)) {continue;}if(!locals.has(id)) {^'Write';}};idRe=/\b([A-Za-z_$][\w$]*)\b/g;rm;while((rm=idRe.exec(body))!==null){id=rm[1];if(!params.has(id)&&!locals.has(id)&&!BUILTIN_SET.has(id)) {^'Read';}};^'Pure'}
=ex{fnBodyText,inferEffect,inferEffectOnce}