@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!hashCanonicalNode(irNode){CANONICALIZATION_VERSION='1.0';if(!irNode) {^hashString('Null');}switch(irNode.kind){case 'Literal':^hashString("Lit:"+(irNode.type)+":"+(JSON.stringify(irNode.value)));case 'LocalRef':^hashString("Local:"+(irNode.ref));case 'CaptureRef':^hashString("Cap:"+(irNode.ref));case 'GlobalRef':^hashString("Global:"+(irNode.name));case 'Binary':{leftH=hashCanonicalNode(irNode.left);rightH=hashCanonicalNode(irNode.right);^hashString("Bin:"+(irNode.operator)+":"+(leftH)+":"+(rightH));};case 'Unary':{argH=hashCanonicalNode(irNode.argument);^hashString("Un:"+(irNode.operator)+":"+(irNode.prefix)+":"+(argH));};case 'Update':{argH=hashCanonicalNode(irNode.argument);^hashString("Upd:"+(irNode.operator)+":"+(irNode.prefix)+":"+(argH));};case 'Assign':{leftH=hashCanonicalNode(irNode.left);rightH=hashCanonicalNode(irNode.right);^hashString("Assign:"+(irNode.operator)+":"+(leftH)+":"+(rightH));};case 'Call':{calleeH=hashCanonicalNode(irNode.callee);argsH=(irNode.args||[]).map(hashCanonicalNode).join(',');^hashString("Call:"+(calleeH)+":["+(argsH)+"]");};case 'Member':{objH=hashCanonicalNode(irNode.object);propH=typeof irNode.property==='object'?hashCanonicalNode(irNode.property):"lit:"+(irNode.property);^hashString("Member:"+(objH)+":"+(propH)+":"+(irNode.computed)+":"+(irNode.optional));};case 'Array':{elemH=(irNode.elements||[]).map(hashCanonicalNode).join(',');^hashString("Arr:["+(elemH)+"]");};case 'Object':{propsH=(irNode.properties||[]).map(p=>(p.key)+"="+(hashCanonicalNode(p.value))).join(';');^hashString("Obj:{"+(propsH)+"}");};case 'If':{testH=hashCanonicalNode(irNode.test);consH=hashCanonicalNode(irNode.consequent);altH=irNode.alternate?hashCanonicalNode(irNode.alternate):'none';^hashString("If:"+(testH)+":"+(consH)+":"+(altH));};case 'Conditional':{testH=hashCanonicalNode(irNode.test);consH=hashCanonicalNode(irNode.consequent);altH=hashCanonicalNode(irNode.alternate);^hashString("Cond:"+(testH)+":"+(consH)+":"+(altH));};case 'While':{testH=hashCanonicalNode(irNode.test);bodyH=hashCanonicalNode(irNode.body);^hashString("While:"+(testH)+":"+(bodyH));};case 'For':{initH=irNode.init?hashCanonicalNode(irNode.init):'none';testH=irNode.test?hashCanonicalNode(irNode.test):'none';updH=irNode.update?hashCanonicalNode(irNode.update):'none';bodyH=hashCanonicalNode(irNode.body);^hashString("For:"+(initH)+":"+(testH)+":"+(updH)+":"+(bodyH));};case 'Return':{argH=irNode.argument?hashCanonicalNode(irNode.argument):'void';^hashString("Ret:"+(argH));};case 'Block':{stmtsH=(irNode.statements||[]).map(hashCanonicalNode).join(';');^hashString("Block:["+(stmtsH)+"]");};case 'VariableDeclaration':{declsH=(irNode.declarations||[]).map(d=>{if(d.kind==='Destructure'){initH=d.init?hashCanonicalNode(d.init):'none';^"Destruct:["+(d.indexes.join(','))+"]="+(initH);};initH=d.init?hashCanonicalNode(d.init):'none';^"Var:"+(d.index)+"="+(initH);}).join(';');^hashString("VarDecl:["+(declsH)+"]");};case 'Function':{bodyH=hashCanonicalNode(irNode.body);capsH=(irNode.captures||[]).map(c=>(c.outerRef)+"->"+(c.ref)).join(',');^hashString("Fn:v"+(CANONICALIZATION_VERSION)+":"+(irNode.effect)+":p"+(irNode.paramCount)+":["+(capsH)+"]:"+(bodyH));};default:^hashString("Unknown:"+(JSON.stringify(irNode)));}}
!hashAppMerkleRoot(exportHashMap){CANONICALIZATION_VERSION='1.0';sortedEntries=Object.entries(exportHashMap).sort(([a],[b])=>a.localeCompare(b));entriesStr=sortedEntries.map(([name,hash])=>(name)+":"+(hash)).join('|');^hashString("AppRoot:v"+(CANONICALIZATION_VERSION)+":{"+(entriesStr)+"}")}
!hashJsFunctionSource(fnSource){ast=TrueAstParser.parse(fnSource);fnNode=ast.body.find(s=>s.type==='FunctionDeclaration'||s.type==='VariableDeclaration'||s.type==='ExpressionStatement');target=fnNode&&fnNode.type==='VariableDeclaration'?fnNode.declarations[0].init:(fnNode&&fnNode.type==='ExpressionStatement'?fnNode.expression:fnNode);if(!target){throw new Error("No function definition found in source: "+(fnSource.slice(0, 50)));};ir=CanonicalIrSerializer.serializeFunction(target);return{hash:hashCanonicalNode(ir),ir,effect:ir.effect}}
!hashString(content){^createHash('sha256').update(content,'utf8').digest('hex').slice(0,16)}
=ex{hashCanonicalNode,hashAppMerkleRoot,hashJsFunctionSource,hashString}