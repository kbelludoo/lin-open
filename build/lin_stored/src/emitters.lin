!emitZigFn(lines,fn){prepareNativeFn(fn);strP=new Set(strParamNames(fn));isBool=retIsBool(fn);ps=paramList(fn);for(p of ps){if(strP.has(p.name)) {p.type='@str';}:( !p.type||p.type==='any' ){p.type='int'}};sig=ps.map((p)=>(safeEmitId(p.name))+": "+(zigType(p.type))).join(', ');retT=fn.returnType?zigType(fn.returnType.replace(/^[^A-Za-z]+/,'')):null;if(!retT&&isBool) {retT='bool';}if(!retT&&retIsStringy(fn)) {retT='[]u8';}if(!retT) {retT=zigType(ps[0]?ps[0].type:'int');}stringIds=new Set();for(p of ps) {if(zigType(p.type)==='[]u8') {stringIds.add(p.name);}}ctx={stringIds,params:ps};lines.push("pub fn "+(safeEmitId(snakeCase(fn.name)))+"("+(sig)+") "+(retT)+" {");locals=new Set();for(st of fn.body) {collectLocalsGo(st,locals,ps.map((p)=>p.name));}bodyRaw=zigStmts(fn.body,1,ctx);for(p of ps){pId=safeEmitId(p.name);reUsed=new RegExp("\\\\b"+(pId)+"\\\\b",'m');if(!reUsed.test(bodyRaw)){lines.push("    _ = "+(pId)+";");}};for(l of locals){t='i64';reAssign=new RegExp("\\\\b"+(l)+"\\\\b\\\\s*=\\\\s*([^;\\\\n]+)",'m').exec(bodyRaw);if(reAssign&&/"|_lia_cat\(|String\(/.test(reAssign[1])) {t='[]u8';}:( reAssign&&/^(true|false)\b/.test(reAssign[1].trim()) ){t='bool'}if(t==='[]u8'||t===''){};sid=safeEmitId(l);if(t==='[]u8') {ctx.stringIds.add(l);}lines.push("    "+(sid)+": "+(t)+" = "+(t === '[]u8' ? '""' : t === 'bool' ? 'false' : '0')+";");};lines.push(bodyRaw);lines.push('}');lines.push('')}
