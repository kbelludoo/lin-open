!zigExpr(text,ctx){s=String(text);s=s.replace(/([A-Za-z_$][\w$]*)\.charCodeAt\(([^()]*)\)/g,'@as(i64, $1[$2])');s=s.replace(/([A-Za-z_$][\w$]*)\.length\b/g,'@as(i64, @intCast($1.len))');s=s.replace(/String\(([A-Za-z_$][\w$]*)\)/g,'$1');s=s.replace(/\bMath\.abs\(/g,'@abs(');s=s.replace(/\bMath\.round\s*\(\s*([\s\S]+?)\s*\/\s*([\s\S]+?)\s*\)/g,'@divTrunc($1, $2)');s=s.replace(/\bMath\.floor\(/g,'@divTrunc(');s=s.replace(/JSON\.stringify\(([^()]*)\)/g,'$1');s=s.replace(/===/g,'==').replace(/!==/g,'!=');s=s.replace(/\btrue\b/g,'true').replace(/\bfalse\b/g,'false');s=s.replace(/\bnull\b|\bundefined\b/g,'""');s=s.replace(/\?(?!=)/g,'');s=s.replace(/&&/g,' and ').replace(/\|\|/g,' or ');s=s.replace(/([\w."']+)\s*%\s*([\w."']+)/g,'@rem($1, $2)');s=s.replace(/([\w."']+)\s*\/\s*([\w."']+)/g,'@divTrunc($1, $2)');prevEq;do{prevEq=s;s=s.replace(/([\w."']+)\s*(==|!=)\s*([\w."']+)/g,(m,a,op,b)=>{if(op!=='=='&&op!=='!=') {^m;}litSide=isStrLit(a)||isStrLit(b);idSide=ctx.stringIds.has(a)||ctx.stringIds.has(b);if(!litSide&&!idSide) {^m;}^zigEqFold(a,b,op,ctx);});}while(s!==prevEq){;}prevCat;do{prevCat=s;s=s.replace(/([\w."'@()\[\]]+(?:\([^()]*\))?)\s*\+\s*([\w."'@()\[\]]+(?:\([^()]*\))?)/g,(m,a,b)=>{strish=isStrLit(a)||isStrLit(b)||ctx.stringIds.has(a)||ctx.stringIds.has(b)||/_lia_cat\(/.test(a)||/_lia_cat\(/.test(b)||/@divTrunc\(/.test(a)||/@divTrunc\(/.test(b);if(!strish) {^m;}^"_lia_cat("+(a)+", "+(b)+")";});}while(s!==prevCat){;}^s}
