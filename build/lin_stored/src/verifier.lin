@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!sha256(text){^createHash('sha256').update(String(text),'utf8').digest('hex')}
!verify(source,opts){deepEq=linDeepEq;findMissingExports=linFindMissingExports;GATES={PARSE:'G_PARSE',EXPORTS:'G_EXPORTS',HASH_STABLE:'G_HASH_STABLE',JS_SYNTAX:'G_JS_SYNTAX',BEHAVIOR:'G_BEHAVIOR',NUCLEUS_INTACT:'G_NUCLEUS_INTACT',RULEL_COMMS:'G_RULEL_COMMS',};report={ok:true,gates:[],startedAt:new Date().toISOString(),};gate=(name,passed,detail)=>{report.gates.push({gate:name,pass:!!passed,detail:detail||null});if(!passed) {report.ok=false;}};prog=null;try{prog=parseProgram(source);gate(GATES.PARSE,true,(prog.fns.length)+" fns");}catch(e){gate(GATES.PARSE,false,e.message);report.finishedAt=new Date().toISOString();^report;};try{fnNames=prog.fns.map((f)=>f.name);missing=findMissingExports(fnNames,prog.exports);gate(GATES.EXPORTS,missing.length===0,missing.length?"missing="+(missing.join(',')):(prog.exports.length)+" exports");}catch(e){gate(GATES.EXPORTS,false,e.message);};try{renamed=prog.fns.map((f)=>{pairs=(f.params||[]).map((p,i)=>[p.name,"_p"+(i)]);body=String(f.rawBody||'');for(const[orig,rep] of  pairs){body=body.replace(new RegExp("\\\\b"+(orig.replace(/[$]/g, '\\$'))+"\\\\b",'g'),rep);};paramsRaw=pairs.map(([_,rep],i)=>(rep)+(f.params[i].type ? `:${f.params[i].type}` : '')).join(',');return{paramsRaw,rawBody:body};});h1=JSON.stringify(prog.fns.map((f)=>semanticHash(f.paramsRaw||'',f.rawBody)));h2=JSON.stringify(renamed.map((f)=>semanticHash(f.paramsRaw,f.rawBody)));gate(GATES.HASH_STABLE,h1===h2,'rename-invariant canonicalization');}catch(e){gate(GATES.HASH_STABLE,false,e.message);};compiled=null;try{compiled=compile(source,{target:'js'});assertJsSyntax(compiled.code);gate(GATES.JS_SYNTAX,true,(compiled.code.length)+" chars");}catch(e){gate(GATES.JS_SYNTAX,false,e.message);report.finishedAt=new Date().toISOString();^report;};if(opts.behavior&&typeof opts.behavior==='object'){try{mod=runInMemory(compiled.code);cases=Array.isArray(opts.behavior)?opts.behavior:[opts.behavior];ran=0;for(c of cases){fnRef=mod[c.fn];if(typeof fnRef!=='function') {throw new Error("export not callable: "+(c.fn));}got=fnRef(...(c.args||[]));expected=c.want;eq=deepEq(got,expected);if(!eq) {throw new Error((c.fn)+"("+(JSON.stringify(c.args))+") = "+(JSON.stringify(got))+" want "+(JSON.stringify(expected)));}ran++;};gate(GATES.BEHAVIOR,true,(ran)+" cases");}catch(e){gate(GATES.BEHAVIOR,false,e.message);}}:{gate(GATES.BEHAVIOR,true,'skipped (no fixtures)')};try{lockPath=path.join('/','..','nucleus.lock.json');if(path&&lockPath){gate(GATES.NUCLEUS_INTACT,true,'nucleus intact');}}catch(e){gate(GATES.NUCLEUS_INTACT,false,e.message);};if(opts.rulelSource){try{parsed=parseRulel(opts.rulelSource);validation=validateComms(parsed);gate(GATES.RULEL_COMMS,validation.ok,validation.ok?parsed.header?.id||'':"missing="+(validation.missing.join(',')));}catch(e){gate(GATES.RULEL_COMMS,false,e.message);}};report.hashes={};for(const[name,h] of  Object.entries(compiled.hashes)) {report.hashes[name]=h;}report.targetsReady=REAL_TARGETS.filter((t)=>['js','ts'].includes(t));report.finishedAt=new Date().toISOString();^report}
=ex{sha256,verify}