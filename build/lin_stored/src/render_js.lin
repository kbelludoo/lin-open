^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!renderFnBodyJs(fn,lossyClone){astBody=renderBody(fn.body);if(!lossyClone) {^astBody;}try{assertJsSyntax("function __lin_probe("+(fnParamsText(fn))+"){"+(astBody)+"}");^astBody;}catch(e){^renderLossyFnBody(fn);}}
!renderProgramJs(prog,opts){s=String(bodyText||'');parts=[];parts.push("");if(opts.prelude) {parts.push(String(opts.prelude).trim());}if(prog.consts){obj=Object.entries(prog.consts).map(([k,v])=>(JSON.stringify(k))+":"+(v)).join(',');parts.push("$K={"+(obj)+"};");cnames=Object.keys(prog.consts);if(cnames.length) {parts.push(""+(cnames.map((n) => `${n}=$K[${JSON.stringify(n)}]`).join(','))+";");}};for(en of prog.enums||[]){parts.push(""+(en.name)+" = {};");variantNames=new Set((en.variants||[]).map(v=>v.name));for(v of en.variants||[]){valStr=v.value!==undefined?String(v.value):JSON.stringify(v.name);if(!valStr.startsWith('"')&&!valStr.startsWith("'")){valStr=valStr.replace(/\b([A-Za-z_$][\w$]*)\b/g,(m)=>{if(variantNames.has(m)){^(en.name)+"["+(JSON.stringify(m))+"]";};^m;});};parts.push((en.name)+"["+(JSON.stringify(v.name))+"] = "+(valStr)+";");}};for(mod of prog.modules||[]){parts.push(""+(mod.name)+" = "+(renderModuleObj(mod))+";");};for(u of prog.uses||[]){for(sym of u.symbols){parts.push(""+(sym)+" = "+(u.module)+"."+(sym)+";");}};allFns=prog.fns;effects=new Map();lossyClone=isLossyCloneProgram(prog);for(fn of allFns){effects.set(fn.name,inferEffect(fnTextStub(fn),allFns.map(fnTextStub)));};for(fn of allFns){fn.effect=effects.get(fn.name);bodyText=renderFnBodyJs(fn,lossyClone);params=new Set((fn.params||[]).map((p)=>p.name));bareIds=collectBareStmtIds(bodyText);cleaned=stripBareIdStmts(bodyText);assigned=collectAssignedIds(cleaned);selfDeclared=new Set();for(id of[...assigned,...bareIds]){if(new RegExp("\\\\b(?:const|let|var)\\\\s+"+(id)+"\\\\b").test(cleaned)||new RegExp("\\\\bfor\\\\s*\\\\(\\\\s*(?:const|let|var)\\\\s+"+(id)+"\\\\b").test(cleaned)||new RegExp("\\\\b(?:const|let|var)\\\\b[^;]*?,\\\\s*"+(id)+"\\\\s*=").test(cleaned)) {selfDeclared.add(id);}};locals=[...new Set([...assigned,...bareIds])].filter((id)=>{if(params.has(id)) {^false;}if(selfDeclared.has(id)) {^false;}if(bareIds.has(id)) {^true;}if(firstUseIsRead(cleaned,id)) {^false;}^true;});decl=locals.length?""+(locals.join(','))+";":'';isAsync=Boolean(fn.isAsync)||/\bawait\s+[\w$(]/.test(bodyText.replace(/"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/g,''));parts.push((isAsync ? 'async ' : '')+"function "+(fn.name)+"("+(fnParamsText(fn))+"){"+(decl)+(bodyText)+"}");};for(st of prog.stmts||[]){parts.push(renderStmt(st));};if(opts.epilogue){parts.push(String(opts.epilogue).trim());}:{rawEx=prog.exports.length?prog.exports:prog.fns.map((f)=>f.name);ex=rawEx.map((e)=>{if(e.includes(' as ')){const[src,alias]=e.split(/\s+as\s+/).map((s)=>s.trim());^(alias)+":"+(src);};^e;});if(opts.exportMode==='multiple'){parts.push("module.exports={"+(ex.join(','))+"};");}:( opts.exportMode==='single'&&ex[0] ){parts.push("module.exports="+(ex[0])+";")}:( ex.length===1&&!rawEx[0].includes(' as ') ){parts.push("module.exports="+(ex[0])+";")}:{parts.push("module.exports={"+(ex.join(','))+"};")}};^parts.join('\n')}
!fnTextStub(fn){if(!fn.__text){fn.__text={name:fn.name,params:(fn.params||[]).map((p)=>p.name),get body(){if(typeof fn.rawBody==='string') {^fn.rawBody;}^renderBody(fn.body||[]);},effect:fn.effect,};};^fn.__text}
!stripBareIdStmts(bodyText){s=String(bodyText||'');s=String(bodyText||'');for(guard=0;guard<200;guard++){re=new RegExp(BARE_ID_STMT_RE.source,'');m=re.exec(s);if(!m) {break;}s=s.slice(0,m.index)+m[1]+s.slice(m.index+m[0].length);};^s}
!renderModuleObj(mod){modFns=[];for(fn of mod.program.fns||[]){modFns.push((fn.name)+": function("+(fnParamsText(fn))+"){"+(renderBody(fn.body))+"}");};for(inner of mod.program.modules||[]){modFns.push((inner.name)+": "+(renderModuleObj(inner)));};^"{\\n  "+(modFns.join(',\n  '))+"\\n}"}
=ex{renderFnBodyJs,renderProgramJs,fnTextStub,stripBareIdStmts,renderModuleObj}