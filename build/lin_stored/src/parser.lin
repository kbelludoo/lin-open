!text(fromTok,toTokExclusive){^this.src.slice(fromTok.start,toTokExclusive.start)}
!skipTrivia(){while(this.at('nl')||this.at('comment')) {this.next();}}
!skipLine(){while(!this.at('nl')&&!this.at('eof')) {this.next();}}
!findMatching(openIdx,openCh,closeCh){depth=0;for(i=openIdx;i<this.toks.length;i++){t=this.toks[i];if(t.type==='punct'){if(t.value===openCh) {depth++;}:( t.value===closeCh ){depth--;if(depth===0) {^i;}}}};throw new LinParseError("unmatched "+(openCh),this.toks[openIdx])}
