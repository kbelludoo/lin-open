  nonEquivalentPairs.push({
    category: 'Call Argument Order / Arity',
    left: "function callA_"+(i)+"(a, b) { ^customFn(a, b, "+(i)+"); }",
    right: "function callB_"+(i)+"(a, b) { ^customFn(b, a, "+(i)+"); }"
  });
};

assert.equal(nonEquivalentPairs.length, 100, 'Must have exactly 100 non-equivalent test pairs');

for (i = 0; i < nonEquivalentPairs.length; i++) {
  __d5997=nonEquivalentPairs[i];category=__d5997.category;left=__d5997.left;right=__d5997.right;
  hL = hashJsFunctionSource(left).hash;
  hR = hashJsFunctionSource(right).hash;

