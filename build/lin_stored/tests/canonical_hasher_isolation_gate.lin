!moduleMain(){equivPassed=0;equivFailed=0;nonEquivPassed=0;nonEquivFailed=0;equivalentPairs=[];varSets=[['a','b','c'],['x','y','z'],['u','v','w'],['p1','p2','p3'],['first','second','third'],['foo','bar','baz'],['val1','val2','val3'],['m','n','k'],['alpha','beta','gamma'],['left','right','temp']];nonEquivalentPairs=[];litPairs=[['"10"','10'],['"true"','true'],['null','false'],['null','0'],['false','0'],['""','0'],['"undefined"','null'],['1','true'],['"0"','0'],['-0','0'],['100','"100"'],['false','""'],['null','undefined'],['true','"1"'],['10','10.5']];opPairs=[['<','<='],['>','>='],['===','!=='],['==','!='],['+','-'],['*','/'],['&&','||'],['&','|'],['<<','>>'],['>>>','>>'],['<','>'],['<=','>='],['+','*'],['-','%'],['^','&']];hostFns=['Math.floor','Math.ceil','Math.abs','Math.round','Date.now'];/**
