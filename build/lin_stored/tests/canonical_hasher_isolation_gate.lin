  ['m', 'n', 'k'], ['alpha', 'beta', 'gamma'], ['left', 'right', 'temp']
];

for (i = 0; i < 20; i++) {
  [p1, p2, p3] = varSets[i % varSets.length];
  [q1, q2, q3] = varSets[(i + 3) % varSets.length];
  equivalentPairs.push({
    category: 'Alpha-Renaming',
    left: "function fnA_"+(i)+"("+(p1)+", "+(p2)+") { "+(p3)+" = "+(p1)+" * "+(p2)+";^"+(p3)+" + 10; }",
    right: "function fnB_"+(i)+"("+(q1)+", "+(q2)+") { "+(q3)+" = "+(q1)+" * "+(q2)+";^"+(q3)+" + 10; }"
  });
};


for (i = 0; i < 20; i++) {
  op = ['+', '-', '*', '%'][i % 4];
  equivalentPairs.push({
    category: 'Function vs Arrow',
    left: "function calc_"+(i)+"(x, y) { ^(x "+(op)+" y) + "+(i)+"; }",
    right: "calc_"+(i)+" = (a, b) => (a "+(op)+" b) + "+(i)+";"
  });
};


for (i = 0; i < 20; i++) {
  equivalentPairs.push({
    category: 'Syntax Formatting & Parens',
    left: "function clean_"+(i)+"(x) { if (x > "+(i)+") { ^true; } :{^false} }",
    right: "function clean_"+(i)+"(val) { /* comment */ if (((val > "+(i)+"))) ^true; :{^false} }"
  });
};


for (i = 0; i < 20; i++) {
  equivalentPairs.push({
    category: 'Closure & Capture Isolation',
    left: "function outerA_"+(i)+"(base) { inner = (x) => x + base + "+(i)+";^inner(10); }",
    right: "function outerB_"+(i)+"(root) { sub = (delta) => delta + root + "+(i)+";^sub(10); }"
  });
};


for (i = 0; i < 20; i++) {
  equivalentPairs.push({
    category: 'Declaration & Destructuring Equivalence',
    left: "function destA_"+(i)+"(pair) { [a, b] = pair;^(a * "+(i)+") + b; }",
    right: "function destB_"+(i)+"(tuple) { [x, y] = tuple;^(x * "+(i)+") + y; }"
  });
};

assert.equal(equivalentPairs.length, 100, 'Must have exactly 100 equivalent test pairs');

for (i = 0; i < equivalentPairs.length; i++) {
  __d2703=equivalentPairs[i];category=__d2703.category;left=__d2703.left;right=__d2703.right;
