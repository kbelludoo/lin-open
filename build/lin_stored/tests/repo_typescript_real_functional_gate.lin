@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!_anon0(f){^f.endsWith('.enum.ts')}
!getAllTestFiles(dir){results=[];if(!fs.existsSync(dir)) {^results;}list=fs.readdirSync(dir);for(file of list){fullPath=path.join(dir,file);stat=fs.statSync(fullPath);if(stat&&stat.isDirectory()) {results=results.concat(getAllTestFiles(fullPath));}:( file.endsWith('.ts')||file.endsWith('.js') ){results.push(fullPath)}};^results}
!_anon2(a,b){^a-b}
=ex{_anon0,getAllTestFiles,_anon2}