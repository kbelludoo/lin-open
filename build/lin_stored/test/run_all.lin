!_anon7(){effectLia="@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!pureAdd(a,b){^a+b}\\n!nativeLen(s){^String(s).length}\\n!throwIfNeg(x){?(x<0){throw new Error('neg')};^x}\\n=ex{pureAdd,nativeLen,throwIfNeg}";r=compile(effectLia,{target:'js'});fx=Object.fromEntries(r.program.fns.map((f)=>[f.name,f.effect]));assert.equal(fx.pureAdd,'Pure');assert.equal(fx.nativeLen,'Native');assert.equal(fx.throwIfNeg,'Throw');sandboxed=compile(effectLia,{target:'js',sandbox:['Pure']});mod=runInMemory(sandboxed.code);assert.equal(mod.pureAdd(2,3),5);assert.throws(()=>mod.nativeLen('x'),/LIN_SANDBOX.*Native/)}
