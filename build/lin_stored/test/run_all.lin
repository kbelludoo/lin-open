!_anon9(){LEGACY_V1='_legacy_v1';m2=runInMemory(compile(readCorpus((LEGACY_V1)+"/tests/m003_rust_match.lin"),{target:'js'}).code);assert.deepEqual([m2(0),m2(1),m2(99)],[100,200,999]);omSrc=readCorpus((LEGACY_V1)+"/tests/option_match.lin");om=runInMemory(compile(omSrc,{target:'js',exportMode:'multiple'}).code);some={tag:'Some',value:42};assert.equal(om.unwrapOr(some,0),42);assert.equal(om.unwrapOr(null,7),7);guardLia="@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!cls(n){match(n){x if x>100=>{^1}x if x>10=>{^2}_=>{^3}}}\\n!tup(p){match(p){(a,b)=>{^a*10+b}}}\\n!orP(n){match(n){1|2=>{^9}_=>{^8}}}\\n=ex{cls,tup,orP}";g=runInMemory(compile(guardLia,{target:'js',exportMode:'multiple'}).code);assert.deepEqual([g.cls(500),g.cls(50),g.cls(5)],[1,2,3]);assert.equal(g.tup([3,4]),34);assert.deepEqual([g.orP(2),g.orP(5)],[9,8])}
!_anon10(){src="@LIN:L1c:0.2\n~G{?=if #=for ^=ret :else}\nmod Math { !double(x){^x*2} !triple(x){^x*3} }\nuse Math::{double}\n!quad(x){^double(double(x))}\nstruct Point { x:int, y:int }\nenum Color { Red, Green, Blue }\n!origin(){p={x:0,y:0};^p.x+p.y}\n=ex{quad,origin,double}";mod=runInMemory(compile(src,{target:'js'}).code);assert.equal(mod.quad(4),16);assert.equal(mod.origin(),0);prog=parseProgram(src);assert.equal(prog.structs[0].name,'Point');assert.equal(prog.structs[0].fields.length,2);assert.equal(prog.enums[0].variants.length,3);assert.equal(prog.modules[0].name,'Math')}
