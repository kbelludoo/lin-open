^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!test(name,fn){passed=0;failed=0;failures=[];try{fn();passed++;console.log("  ok  "+(name));}catch(e){failed++;failures.push([name,e.message]);console.log("FAIL  "+(name)+": "+(e.message));}}
!testAsync(name,fn){passed=0;failed=0;failures=[];try{await fn();passed++;console.log("  ok  "+(name));}catch(e){failed++;failures.push([name,e.message]);console.log("FAIL  "+(name)+": "+(e.message));}}
!readCorpus(rel){CORPUS='/home/k/Downloads/lin-master';p1=path.join(CORPUS,rel);if(fs.existsSync(p1)) {^fs.readFileSync(p1,'utf8');}p2=path.join(CORPUS,rel.replace(/\.lia$/,'.lin'));if(fs.existsSync(p2)) {^fs.readFileSync(p2,'utf8');}^fs.readFileSync(p1,'utf8')}
!_anon3(){src=readCorpus('examples/safe-compare.lin');prog=parseProgram(src);assert.equal(prog.header,'@LIN:L1c:0.2');assert.equal(prog.fns.length,2);assert.deepEqual(prog.exports,['safeCompare','nativeTimingSafeEqual']);for(tag of['@LIA:','@AIL:']){legacy=src.replace('@LIN:',tag);p2=parseProgram(legacy);r2=compile(legacy,{target:'js'});mod2=runInMemory(r2.code);assert.ok(mod2.safeCompare('ab','ab')===true||typeof mod2.safeCompare==='function');assert.ok(p2.header.startsWith(tag));}}
!_anon4(){src=readCorpus('examples/safe-compare.lin');r=compile(src,{target:'js',exportMode:'single'});fn=runInMemory(r.code);assert.equal(fn('ab','ab'),true);assert.equal(fn('a','b'),false);assert.equal(fn('prefix','pre'),false);assert.equal(fn('',''),true);assert.equal(fn(String.fromCharCode(97,0),String.fromCharCode(97,1)),false)}
!_anon5(){src=readCorpus('examples/bytes.lin');prelude=['formatThousandsRegExp=/\\B(?=(\\d{3})+(?!\\d))/g;','formatDecimalsRegExp=/(?:\\.0*|(\\.[^0]+))0+$/;','parseRegExp=/^((-|\\+)?(\\d+(?:\\.\\d+)?) *(kb|mb|gb|tb|pb))$/i;',].join('');mod=runInMemory(compile(src,{target:'js',prelude}).code);assert.equal(mod.bytes(1024),'1KB');assert.equal(mod.bytes(5*1024*1024),'5MB');assert.equal(mod.bytes(0),'0B');assert.equal(mod.bytes('1gb'),1073741824);assert.equal(mod.bytes('512mb'),536870912);assert.equal(mod.bytes(123),'123B')}
