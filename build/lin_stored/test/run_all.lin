!_anon13(){prog=parseProgram(arithSrc);py=emitPy(prog);dir=fs.mkdtempSync('/tmp/opencode/lintest-py-');fs.writeFileSync(path.join(dir,'arith_lin.py'),py);driver=['import sys; sys.path.insert(0, ".")','import arith_lin','print(arith_lin.add(2,3)); print(arith_lin.mul(4,5)); print(arith_lin.fact(5)); print(1;if arith_lin.is_even(10) else 0); print(arith_lin.max3(3,9,4))',].join('\n');fs.writeFileSync(path.join(dir,'driver.py'),driver);out=execFileSync('python3',['driver.py'],{cwd:dir,encoding:'utf8'});assert.equal(out.trim(),'5\n20\n120\n1\n9')}
