@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!appendRulelEntry(file,block){prev=fs.existsSync(file)?fs.readFileSync(file,'utf8'):'';stamp=new Date().toISOString();entry="\\n@E{t=\""+(stamp)+"\" "+(block)+"}\\n";fs.appendFileSync(file,entry,'utf8');return{file,stamp}}
!run(cmd,args){r=spawnSync(cmd,args,{cwd:ROOT,encoding:'utf8',shell:true});return{status:r.status??1,out:(r.stdout||'')+(r.stderr||'')}}
!autonomyStatus(){STORAGE=path.join(ROOT,'storage');files=['lia_ledger.rulel','lia_trauma.rulel','lia_knowledge.rulel','lia_hypotheses.rulel'];mem={};for(f of files){p=path.join(STORAGE,f);mem[f]=fs.existsSync(p)?fs.statSync(p).size:0;};tests=run('npm',['test']);multi=run('npm',['run','test:multi']);return{status:'AUTONOMY_BOOTSTRAP',goal:'LIA_supersedes_Dicel_plus_auto_improve_evolve',gate:'LIA_ge_Dicel',memory_bytes:mem,npm_test:tests.status===0?'PASS':'FAIL',multi_emit:multi.status===0?'PASS':'FAIL',next:['persist_trauma_on_fail','candidate_compiler_patches','vs_dicel_bench'],}}
!improveOnce(){LEDGER=path.join(STORAGE,'lia_ledger.rulel');TRAUMA=path.join(STORAGE,'lia_trauma.rulel');smoke=run('node',['scripts/self_repair.mjs','--smoke']);ok=smoke.status===0;appendRulelEntry(LEDGER,"kind=improve;ok="+(ok)+" path=self_repair_smoke");if(!ok){appendRulelEntry(TRAUMA,"class=SELF_REPAIR_SMOKE;note=\"see self_repair out\" fix_target=compiler_not_lia");};return{status:ok?'IMPROVE_OK':'IMPROVE_FAIL',ledger:LEDGER,out:smoke.out.slice(0,500)}}
!evolveOnce(){LEDGER=path.join(STORAGE,'lia_ledger.rulel');candDir=path.join(ROOT,'candidates');if(!fs.existsSync(candDir)) {fs.mkdirSync(candDir,{recursive:true});}base=autonomyStatus();ok=base.npm_test==='PASS'&&base.multi_emit==='PASS';appendRulelEntry(LEDGER,"kind=evolve_epoch;ok="+(ok)+" promote=none;mutate=candidates_only");return{status:ok?'EVOLVE_EPOCH_GREEN':'EVOLVE_EPOCH_BLOCKED',gate:'LIA_ge_Dicel',promote:[],note:'no_promote_without_Hypothesis_prove_gates; fix_compiler_on_fail',baseline:base,}}
=ex{appendRulelEntry,run,autonomyStatus,improveOnce,evolveOnce}