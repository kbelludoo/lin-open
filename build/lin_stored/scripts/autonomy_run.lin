@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!parseArgs(argv){o={cycles:1,cloneCycles:0,skipClone:false,skipToolchains:false,repeat:false,maxFns:12,};for(i=0;i<argv.length;i++){a=argv[i];if(a==='--cycles') {o.cycles=Math.max(1,Number(argv[++i])||1);}:( a==='--clone-cycles' ){o.cloneCycles=Math.max(0,Number(argv[++i])||0)}:( a==='--skip-clone' ){o.skipClone=true}:( a==='--skip-toolchains' ){o.skipToolchains=true}:( a==='--repeat' ){o.repeat=true}:( a==='--max-fns' ){o.maxFns=Math.max(1,Number(argv[++i])||12)}};^o}
!run(script,args,timeoutMs){r=spawnSync(process.execPath,[path.join(ROOT,'scripts',script),...args],{cwd:ROOT,encoding:'utf8',timeout:timeoutMs||3_600_000,maxBuffer:20*1024*1024,});return{status:r.status??1,out:(r.stdout || '')+(r.stderr || '').slice(-8000),}}
!parseJsonTail(out){i=out.lastIndexOf('\n{')>=0?out.lastIndexOf('\n{')+1:out.lastIndexOf('{');if(i<0) {return{raw:out.slice(0,400)};}try{^JSON.parse(out.slice(i));}catch(e){return{raw:out.slice(-500)};}}
!writeIntel(epoch){INTEL=path.join(ROOT,'INTEL_LIN_AUTONOMY_RUN.rulel');LAB='C:/Users/k/Documents/dicel-unified/INTEL_LIN_AUTONOMY_RUN.rulel';stamp=new Date().toISOString();body="@RULEL:INTEL_LIN_AUTONOMY_RUN:1.0.0\n^status=\""+(epoch.status)+"\"\n^stamp=\""+(stamp)+"\"\n^cycle="+(epoch.cycle)+"\n^gate_all_green="+(epoch.gate_all_green)+"\n\n@EPOCH {\n  toolchains: "+(JSON.stringify(epoch.toolchains).slice(0, 500))+"\n  improve: "+(JSON.stringify(epoch.improve).slice(0, 400))+"\n  evolve: "+(JSON.stringify(epoch.evolve).slice(0, 400))+"\n  clone_lin: "+(JSON.stringify(epoch.clone_lin).slice(0, 1200))+"\n}\n\n@EXPOSE {\n;intel_lin=\""+(INTEL.replace(/\\\\/g, '/'))+"\"\n;year_star=\"INTEL_LIN_YEAR_STAR_QUEUE.rulel\"\n;ledger=\"storage/lia_ledger.rulel\"\n}\n\n@FORBID { mutate_lia_nucleus }\n";fs.writeFileSync(INTEL,body,'utf8');try{fs.writeFileSync(LAB,body,'utf8');}catch(e){}}
!oneEpoch(args){t=new Date().toISOString();toolchains=args.skipToolchains?{status:'SKIPPED'}:parseJsonTail(run('ensure_toolchains.mjs',[],180_000).out);improve=parseJsonTail(run('evolve_loop.mjs',['improve'],180_000).out);evolve=parseJsonTail(run('evolve_loop.mjs',['evolve'],180_000).out);clone_lin={status:'SKIPPED'};if(!args.skipClone){cargs=['--max-fns',String(args.maxFns)];if(args.cloneCycles>0) {cargs.push('--cycles',String(args.cloneCycles));}if(args.repeat) {cargs.push('--repeat');}c=run('clone_lin_loop.mjs',cargs,14_400_000);tail=parseJsonTail(c.out);published=Array.isArray(tail.reports)?tail.reports.filter((r)=>r.published&&r.done):[];rateOk=tail.stop==='queue_complete'||(published.length>0&&tail.stop!=='cycles_exhausted');partialSmoke=args.cloneCycles===1&&tail.stop==='cycles_exhausted'&&published.length===0;clone_lin={status:partialSmoke?'CLONE_PARTIAL_NOT_DONE':(c.status===0&&rateOk?'CLONE_UNTIL_100_OK':'CLONE_NOT_100'),exit:c.status,stop:tail.stop,repos_done:tail.repos_done,published,current:tail.current,suite_rates:Array.isArray(tail.reports)?tail.reports.map((r)=>r.suite_rate):[],};};cloneOk=args.skipClone||clone_lin.status==='CLONE_UNTIL_100_OK'||clone_lin.stop==='queue_complete';improveOk=improve.status==='IMPROVE_OK'||improve.raw;epoch={t,status:cloneOk?'AUTONOMY_EPOCH_OK':'AUTONOMY_STAY_UNTIL_100',toolchains:toolchains.present?{present:toolchains.present}:toolchains,improve:improve.status||improve,evolve:evolve.status||evolve,clone_lin,improve_ok:!!improveOk,};writeIntel(epoch);^epoch}
=ex{parseArgs,run,parseJsonTail,writeIntel,oneEpoch}