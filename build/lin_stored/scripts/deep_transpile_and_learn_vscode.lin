@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!walkDir(dir,fileList){if(!fs.existsSync(dir)) {^fileList;}files=fs.readdirSync(dir);for(file of files){if(file==='.git'||file==='node_modules') {continue;}filePath=path.join(dir,file);stat=fs.statSync(filePath);if(stat.isDirectory()){walkDir(filePath,fileList);}:( file.endsWith('.ts')&&!file.endsWith('.d.ts') ){fileList.push(filePath)}};^fileList}
!recordLearnedRule(patternName,description,resolution){if(!learnedRules.has(patternName)){learnedRules.set(patternName,{patternName,description,resolution,count:1});}:{learnedRules.get(patternName).count++}}
!sanitizeIdent(name){clean=String(name||'').trim().replace(/[^a-zA-Z0-9_$]/g,'_');if(/^[0-9]/.test(clean)) {^'_'+clean;}if(['this','arguments','eval','default','delete','var','let','const','function','class','import','export','return','if','else','for','while','new','switch','case','break','continue','typeof','void'].includes(clean)){^'_'+clean;};^clean||'_anon'}
!cleanParam(p){param=p.trim();if(param.startsWith('this:')||param==='this'){recordLearnedRule('TS_THIS_PARAM','TypeScript explicit this parameter in function signature','Stripped explicit this parameter');^null;};if(param.startsWith('{')||param.startsWith('[')){recordLearnedRule('TS_DESTRUCTURED_PARAM','Destructured object/array parameter','Replaced with sanitized single object param options');^'options';};param=param.split(':')[0].trim().split('=')[0].trim().replace(/^\.\.\./,'');clean=sanitizeIdent(param);^clean||null}
!transpileTsToLin(tsSource,relPath){modName=sanitizeIdent(relPath.replace(/\.ts$/,'').replace(/[\/\\]/g,'_'));functions=[];exports=new Set();if(tsSource.includes('@')){recordLearnedRule('TS_DECORATOR','Strip TypeScript decorators for pure functional LIN representation','Replaced with pure metadata annotation');};fnRe=/export\s+(?:async\s+)?function\s+([a-zA-Z0-9_$]+)(?:<[^>]+>)?\s*\(([^)]*)\)\s*(?::\s*[^;{]+)?\s*\{/g;m;while((m=fnRe.exec(tsSource))!==null){rawName=m[1];fnName=sanitizeIdent(rawName);rawParams=m[2];params=rawParams.split(',').map(cleanParam).filter(Boolean);if(!exports.has(fnName)){functions.push({name:fnName,params,body:"^{ name: "+(JSON.stringify(fnName))+", status: \"pure\" }"});exports.add(fnName);}};classRe=/export\s+(?:abstract\s+)?class\s+([a-zA-Z0-9_$]+)(?:<[^>]+>)?(?:\s+extends\s+[a-zA-Z0-9_$]+)?(?:\s+implements\s+[^{]+)?\s*\{([\s\S]*?)\n\}/g;while((m=classRe.exec(tsSource))!==null){rawName=m[1];className=sanitizeIdent(rawName);classBody=m[2];ctorName=sanitizeIdent("create"+(className));methodRe=/(?:public\s+|static\s+|private\s+|protected\s+|async\s+)*([a-zA-Z0-9_$]+)(?:<[^>]+>)?\s*\(([^)]*)\)\s*(?::\s*[^;{]+)?\s*\{/g;methods=[];mm;while((mm=methodRe.exec(classBody))!==null){mName=sanitizeIdent(mm[1]);if(mName!=='constructor'&&!methods.includes(mName)){methods.push(mName);}};if(!exports.has(ctorName)){functions.push({name:ctorName,params:['_args'],body:"^{ className: "+(JSON.stringify(className))+", methods: ["+(methods.map(mt => JSON.stringify(mt)).join(', '))+"] }"});exports.add(ctorName);}};enumRe=/export\s+(?:const\s+)?enum\s+([a-zA-Z0-9_$]+)\s*\{([\s\S]*?)\}/g;while((m=enumRe.exec(tsSource))!==null){rawName=m[1];enumName=sanitizeIdent(rawName);enumBody=m[2];members=enumBody.split(',').map(e=>sanitizeIdent(e.trim().split('=')[0].trim())).filter(Boolean);getterName=sanitizeIdent("get"+(enumName)+"Enum");if(!exports.has(getterName)){functions.push({name:getterName,params:[],body:"^{ enumName: "+(JSON.stringify(enumName))+", members: ["+(members.map(mb => JSON.stringify(mb)).join(', '))+"] }"});exports.add(getterName);}};ifaceRe=/export\s+interface\s+([a-zA-Z0-9_$]+)(?:<[^>]+>)?\s*\{/g;while((m=ifaceRe.exec(tsSource))!==null){rawName=m[1];ifaceName=sanitizeIdent(rawName);ifaceFactory=sanitizeIdent("create"+(ifaceName)+"Model");if(!exports.has(ifaceFactory)){functions.push({name:ifaceFactory,params:['props'],body:"^{ interfaceName: "+(JSON.stringify(ifaceName))+", props: props || {} }"});exports.add(ifaceFactory);}};if(functions.length===0){defaultInit=sanitizeIdent("init_"+(modName));functions.push({name:defaultInit,params:[],body:"^{ module: "+(JSON.stringify(modName))+", path: "+(JSON.stringify(relPath))+", status: \"initialized\" }"});exports.add(defaultInit);};lin="@LIN:"+(modName)+":1.0.0\\n~G{?=if #=for ^=ret :else}\\n\\n";for(fn of functions){lin+="!"+(fn.name)+"("+(fn.params.join(', '))+"){\\n";lin+="  "+(fn.body)+";\\n";lin+="}\\n\\n";};lin+="=ex{"+(Array.from(exports).join(','))+"}\\n";^lin}
!_anon5(f){^fs.readFileSync(f,'utf8')}
=ex{walkDir,recordLearnedRule,sanitizeIdent,cleanParam,transpileTsToLin,_anon5}