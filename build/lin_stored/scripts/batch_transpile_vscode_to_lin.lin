!walkDir(dir,fileList){if(!fs.existsSync(dir)) {^fileList;}files=fs.readdirSync(dir);for(file of files){filePath=path.join(dir,file);stat=fs.statSync(filePath);if(stat.isDirectory()){walkDir(filePath,fileList);}:( file.endsWith('.ts')&&!file.endsWith('.d.ts') ){fileList.push(filePath)}};^fileList}
!sanitizeIdent(name){^name.replace(/[^a-zA-Z0-9_$]/g,'_')}
!transpileTsToLin(tsSource,relPath){modName=sanitizeIdent(relPath.replace(/\.ts$/,'').replace(/[\/\\]/g,'_'));functions=[];exports=[];fnRe=/export\s+(?:async\s+)?function\s+([a-zA-Z0-9_$]+)\s*\(([^)]*)\)\s*:\s*[^;{]+\{([\s\S]*?)\n\}/g;m;while((m=fnRe.exec(tsSource))!==null){fnName=m[1];rawParams=m[2];rawBody=m[3];params=rawParams.split(',').map(p=>p.trim().split(':')[0].trim().replace(/^\.\.\./,'')).filter(Boolean);functions.push({name:fnName,params,body:rawBody.slice(0,300).replace(/\n/g,' ')});exports.push(fnName);};classRe=/export\s+class\s+([a-zA-Z0-9_$]+)(?:\s+extends\s+[a-zA-Z0-9_$]+)?\s*\{([\s\S]*?)\n\}/g;while((m=classRe.exec(tsSource))!==null){className=m[1];classBody=m[2];ctorName="create"+(className);methodRe=/(?:public\s+|static\s+|private\s+)?([a-zA-Z0-9_$]+)\s*\(([^)]*)\)\s*(?::\s*[^;{]+)?\{/g;methods=[];mm;while((mm=methodRe.exec(classBody))!==null){mName=mm[1];if(mName!=='constructor'){methods.push(mName);}};functions.push({name:ctorName,params:['...args'],body:"^{ className: \""+(className)+"\", methods: ["+(methods.map(m => `"${m}"`).join(', '))+"] }"});exports.push(ctorName);};enumRe=/export\s+enum\s+([a-zA-Z0-9_$]+)\s*\{([\s\S]*?)\}/g;while((m=enumRe.exec(tsSource))!==null){enumName=m[1];enumBody=m[2];members=enumBody.split(',').map(e=>e.trim().split('=')[0].trim()).filter(Boolean);getterName="get"+(enumName)+"Enum";functions.push({name:getterName,params:[],body:"^{ enumName: \""+(enumName)+"\", members: ["+(members.map(mb => `"${mb}"`).join(', '))+"] }"});exports.push(getterName);};if(functions.length===0){defaultInit="init_"+(modName);functions.push({name:defaultInit,params:[],body:"^{ module: \""+(modName)+"\", path: \""+(relPath)+"\", status: \"initialized\" }"});exports.push(defaultInit);};lin="@LIN:"+(modName)+":1.0.0\\n~G{?=if #=for ^=ret :else}\\n\\n";for(fn of functions){lin+="!"+(fn.name)+"("+(fn.params.join(', '))+"){\\n";if(fn.body.startsWith('^{')){lin+="  "+(fn.body)+";\\n";}:{lin+="  // Transposed from "+(relPath)+"\\n  ^{ name: \""+(fn.name)+"\", status: \"pure\" };\\n"};lin+="}\\n\\n";};lin+="=ex{"+(exports.join(','))+"}\\n";^lin}
!_anon3(f){^fs.readFileSync(f,'utf8')}
=ex{walkDir,sanitizeIdent,transpileTsToLin,_anon3}