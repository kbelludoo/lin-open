.source{content="; ============================================================================\n; EMITTED DETERMINISTICALLY BY SOVEREIGN LIN NATIVE COMPILER (ELF32)\n; Target: x86_32 Freestanding | Multiboot1 | Libc: 0 | Runtime: 0\n; ============================================================================\n\nBITS 32\nsection .text\nglobal _start\n_start:\n    mov eax, 1\n    xor ebx, ebx\n    int 0x80\n\n\n; Fn: !tokenize(src)\n\n; Fn: !src || src.length === 0)\n\n; Fn: !l || l.startsWith(\"//\"))\n\n; Fn: !\"))\n\n; Fn: !parse(tokens)\n\n; Fn: !([a-zA-Z0-9_$]+)\\s*\\(([^)]*)\\)/);\n\n; Fn: !verify(ast)\n\n; Fn: !ast || !ast.functions)\n\n; Fn: !fn.name)\n\n; Fn: !compile(src)\n\n; Fn: !v.valid)\n\n; --- Canonical End of Compiled LIN Module ---\n"}
