@LIN:L1c:0.2
@COMPOUND_SEIZE_TOKENS{
  version=1
  repo="compound-finance/compound-protocol"
  source="contracts/Comptroller.sol liquidateCalculateSeizeTokens + contracts/ExponentialNoError.sol"
  license="BSD-3-Clause"
  commit="a3214f67b73310d547e00fc578e8355911c9d376"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_compound_liquidation_seize_with_128bit_muldiv"
  note="Not mainnet uint256. Real deltas: oracle prices, exchangeRate and liquidationIncentive are arguments; Exp mul_/div_/mul_ScalarTruncate uses 128-bit product and fail-closes if a quotient exceeds uint64."
}

!cls_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cls_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cls_u_lt(s, a));
}

!cls_mask32() -> int {
  ^ 4294967295;
}

!cls_base() -> int {
  ^ 1000000000000000000;
}

!cls_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = cls_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cls_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cls_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cls_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cls_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!cls_muldiv(a: int, b: int, d: int) -> int {
  ^ cls_muldiv_part(a, b, d, 0);
}

!cls_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ cls_muldiv_part(a, b, d, 1);
}

!cls_price_ok(price_borrowed: int, price_collateral: int) -> int {
  ?(price_borrowed == 0) { ^ 0; };
  ?(price_collateral == 0) { ^ 0; };
  ?(cls_u_lt(price_borrowed, 0) == 1) { ^ 0; };
  ?(cls_u_lt(price_collateral, 0) == 1) { ^ 0; };
  ^ 1;
}

!cls_exp_mul(a: int, b: int) -> int {
  ^ cls_muldiv(a, b, cls_base());
}

!cls_exp_div(a: int, b: int) -> int {
  ?(b == 0) { ^ 0; };
  ^ cls_muldiv(a, cls_base(), b);
}

!cls_mul_scalar_truncate(ratio: int, scalar: int) -> int {
  ^ cls_muldiv(ratio, scalar, cls_base());
}

!cls_seize(repay: int, incentive: int, price_borrowed: int, price_collateral: int, exchange_rate: int) -> int {
  ?(cls_price_ok(price_borrowed, price_collateral) == 0) { ^ 0; };
  ?(cls_u_lt(repay, 0) == 1) { ^ 0; };
  ?(cls_u_lt(incentive, 0) == 1) { ^ 0; };
  ?(cls_u_lt(exchange_rate, 0) == 1) { ^ 0; };
  ?(exchange_rate == 0) { ^ 0; };
  num_m = cls_exp_mul(incentive, price_borrowed);
  den_m = cls_exp_mul(price_collateral, exchange_rate);
  ?(den_m == 0) { ^ 0; };
  ratio_m = cls_exp_div(num_m, den_m);
  ^ cls_mul_scalar_truncate(ratio_m, repay);
}

!cls_test_suite() -> int {
  ?(cls_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(cls_muldiv(7, 9, 1) != 63) { ^ -2; };
  ?(cls_muldiv(1000000000000000000, 1, 2) != 500000000000000000) { ^ -3; };
  ?(cls_muldiv(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -4; };
  ?(cls_muldiv_rem(7, 9, 2) != 1) { ^ -5; };
  ?(cls_price_ok(0, 1000000000000000000) != 0) { ^ -6; };
  ?(cls_price_ok(1000000000000000000, 0) != 0) { ^ -7; };
  ?(cls_seize(1000, 1000000000000000000, 0, 1000000000000000000, 1000000000000000000) != 0) { ^ -8; };
  s1 = cls_seize(1000, 1000000000000000000, 1000000000000000000, 1000000000000000000, 1000000000000000000);
  ?(s1 != 1000) { ^ -9; };
  s8 = cls_seize(1000, 1080000000000000000, 1000000000000000000, 1000000000000000000, 200000000000000000);
  ?(s8 != 5400) { ^ -10; };
  ?(cls_seize(1000, 1080000000000000000, 1000000000000000000, 1000000000000000000, 0) != 0) { ^ -11; };
  ^ 1;
}

=ex{
  cls_u_lt,
  cls_u_add_carry,
  cls_mask32,
  cls_base,
  cls_muldiv_part,
  cls_muldiv,
  cls_muldiv_rem,
  cls_price_ok,
  cls_exp_mul,
  cls_exp_div,
  cls_mul_scalar_truncate,
  cls_seize,
  cls_test_suite
}
