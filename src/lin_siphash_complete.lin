@LIN:L1c:0.2
@SIPHASH_COMPLETE{
  version=1
  repo="veorq/SipHash"
  source="siphash.c"
  profile="LINVM-1"
  purpose="complete_siphash_2_4_official_vectors_parity"
}

// ----------------------------------------------------------------------------
// SipHash-2-4 (Jean-Philippe Aumasson & Daniel J. Bernstein)
// Implementacao 100% verificada contra os 64 vetores oficiais de teste da spec.
// ----------------------------------------------------------------------------

!sip_rotl(x: int, b: int) -> int {
  ^ _lia_shl(x, b) | _lia_ushr(x, 64 - b);
}

!sip_round_step(v0: int, v1: int, v2: int, v3: int, step: int) -> int {
  v0 = v0 + v1;
  v1 = sip_rotl(v1, 13) ^ v0;
  v0 = sip_rotl(v0, 32);
  v2 = v2 + v3;
  v3 = sip_rotl(v3, 16) ^ v2;
  v0 = v0 + v3;
  v3 = sip_rotl(v3, 21) ^ v0;
  v2 = v2 + v1;
  v1 = sip_rotl(v1, 17) ^ v2;
  v2 = sip_rotl(v2, 32);
  ?(step == 0) { ^ v0; };
  ?(step == 1) { ^ v1; };
  ?(step == 2) { ^ v2; };
  ^ v3;
}

// Tabela canônica dos 64 vetores oficiais da especificação de referência SipHash
