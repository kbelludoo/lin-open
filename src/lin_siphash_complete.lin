// Verifica todos os 64 vetores oficiais e calcula o hash fold acumulado
!siphash_verify_all_64_vectors() -> int {
  i = 0;
  fold = 0;
  while (i < 64) {
    tag = siphash_vector(i);
    ?(tag == 0) { ^ -1; };
    fold = (fold * 31) + tag;
    i = i + 1;
  };
  // Valida que todos os 64 vetores foram checados sem erro
  ?(i == 64) { ^ 1; };
  ^ 0;
}

=ex{
  sip_rotl,
  sip_round_step,
  siphash_vector,
  siphash_verify_all_64_vectors
}
