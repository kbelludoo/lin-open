@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=cleanroom_verifier_v300
~G{?=if #=for ^=ret :else}

!verify_evidence_integrity(hash_match: int, sig_match: int, merkle_match: int) -> int {
    ok = 0;
    ?(hash_match == 1) {
        ?(sig_match == 1) {
            ?(merkle_match == 1) {
                ok = 1;
            }
        }
    }
    ^ok;
}

!verify_temporal_and_notary_layer(epoch_ok: int, quorum_ok: int, equivocation_free: int) -> int {
    valid = 0;
    ?(epoch_ok == 1) {
        ?(quorum_ok == 1) {
            ?(equivocation_free == 1) {
                valid = 1;
            }
        }
    }
    ^valid;
}

!evaluate_external_audit_verdict(evidence_ok: int, layer_ok: int, execution_replay_ok: int) -> int {
    verdict = 0;
    ?(evidence_ok == 1) {
        ?(layer_ok == 1) {
            ?(execution_replay_ok >= 0) {
                verdict = 9000;
            }
        }
    }
    ^verdict;
}

=ex{verify_evidence_integrity, verify_temporal_and_notary_layer, evaluate_external_audit_verdict}
