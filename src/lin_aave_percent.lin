@LIN:L1c:0.2
@AAVE_V3_PERCENT{
  version=1
  repo="aave/aave-v3-core"
  source="contracts/protocol/libraries/math/PercentageMath.sol percentMul/percentDiv"
  license="MIT"
  license_note="BUSL-1.1 Change Date 2023-01-27 elapsed; Change License MIT"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_aave_percent_half_up_128bit"
  note="Not mainnet uint256. PERCENTAGE_FACTOR=1e4 half-up. Distinct from floor (a*b)/1e4 and from naive i64 a*b. Yul overflow check is explicit 128-bit fail-closed."
}

!apc_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!apc_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(apc_u_lt(s, a));
}

!apc_mask32() -> int {
  ^ 4294967295;
}

!apc_factor() -> int {
  ^ 10000;
}

!apc_half() -> int {
  ^ 5000;
}

!apc_muldiv_add_part(a: int, b: int, add: int, d: int, want_ov: int) -> int {
  ?(d == 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  m32 = apc_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = apc_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = apc_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + apc_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(apc_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = apc_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want_ov == 1) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!apc_percent_mul_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(apc_muldiv_add_part(a, b, apc_half(), apc_factor(), 1) == 1) { ^ 0; };
  ^ 1;
}

!apc_percent_mul(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ^ apc_muldiv_add_part(a, b, apc_half(), apc_factor(), 0);
}

!apc_percent_div_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ?(apc_muldiv_add_part(a, apc_factor(), b / 2, b, 1) == 1) { ^ 0; };
  ^ 1;
}

!apc_percent_div(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ^ apc_muldiv_add_part(a, apc_factor(), b / 2, b, 0);
}

!apc_wrong_floor_mul(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ^ apc_muldiv_add_part(a, b, 0, apc_factor(), 0);
}

!apc_wrong_floor_div(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ^ apc_muldiv_add_part(a, apc_factor(), 0, b, 0);
}

!apc_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!apc_test_suite() -> int {
  f = apc_factor();
  h = apc_half();
  w = 3000000000000000000;
  ?(apc_percent_mul(f, f) != f) { ^ -1; };
  ?(apc_percent_mul(f, h) != h) { ^ -2; };
  ?(apc_percent_mul(3, h) != 2) { ^ -3; };
  ?(apc_wrong_floor_mul(3, h) != 1) { ^ -4; };
  ?(apc_percent_div(2, 3) != 6667) { ^ -5; };
  ?(apc_wrong_floor_div(2, 3) != 6666) { ^ -6; };
  ?(apc_percent_mul(1, h) != 1) { ^ -7; };
  ?(apc_percent_mul(1, 4999) != 0) { ^ -8; };
  ?(apc_percent_mul(0, f) != 0) { ^ -9; };
  ?(apc_percent_mul(w, h) != 1500000000000000000) { ^ -10; };
  ?(apc_naive_i64_mul(w, h) != 2797068074134536192) { ^ -11; };
  ?(apc_percent_div(f, f) != f) { ^ -12; };
  ?(apc_percent_mul_ok(4000000000000000000, 30000) != 0) { ^ -13; };
  ?(apc_percent_mul(4000000000000000000, 30000) != 0) { ^ -14; };
  ?(apc_percent_div(1, 0) != 0) { ^ -15; };
  ?(apc_percent_mul(1, 1) != 0) { ^ -16; };
  ?(apc_percent_mul(w, 0) != 0) { ^ -17; };
  ?(apc_percent_div_ok(1, 0) != 0) { ^ -18; };
  ?(apc_percent_mul_ok(0, f) != 1) { ^ -19; };
  ?(apc_percent_div(1, 3) != 3333) { ^ -20; };
  ^ 1;
}

=ex{
  apc_u_lt,
  apc_u_add_carry,
  apc_mask32,
  apc_factor,
  apc_half,
  apc_muldiv_add_part,
  apc_percent_mul_ok,
  apc_percent_mul,
  apc_percent_div_ok,
  apc_percent_div,
  apc_wrong_floor_mul,
  apc_wrong_floor_div,
  apc_naive_i64_mul,
  apc_test_suite
}
