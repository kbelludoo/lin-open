@LIN:L1c:0.2
@GMX_V2_POSITION_PNL{
  version=1
  repo="gmx-io/gmx-synthetics"
  source="contracts/position/PositionUtils.sol getPositionPnlUsd"
  price="contracts/price/Price.sol pickPriceForPnl"
  calc="contracts/utils/Calc.sol roundUpDivision"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_gmx_v2_uncapped_getPositionPnlUsd"
  note="Not mainnet uint256. Not pool-capped PnL. Kernel is pickPriceForPnl(isLong,false) then tokens*price vs sizeInUsd, then long round-up sizeDeltaInTokens. Distinct from GMX V1 funding/fee/liquidation."
}

!g2p_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!g2p_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(g2p_u_lt(s, a));
}

!g2p_mask32() -> int {
  ^ 4294967295;
}

!g2p_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  m32 = g2p_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = g2p_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = g2p_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(g2p_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = g2p_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!g2p_muldiv(a: int, b: int, d: int) -> int {
  ^ g2p_muldiv_part(a, b, d, 0);
}

!g2p_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ g2p_muldiv_part(a, b, d, 1);
}

!g2p_smuldiv(a: int, b: int, d: int) -> int {
  neg = 0;
  aa = a;
  ?(a < 0) { neg = 1; aa = 0 - a; };
  q = g2p_muldiv(aa, b, d);
  ?(neg == 1) { ^ 0 - q; };
  ^ q;
}

!g2p_pick(is_long: int, maximize: int, pmin: int, pmax: int) -> int {
  ?(pmin <= 0) { ^ 0; };
  ?(pmax <= 0) { ^ 0; };
  ?(g2p_u_lt(pmax, pmin) == 1) { ^ 0; };
  ?(is_long != 0) {
    ?(maximize != 0) { ^ pmax; };
    ^ pmin;
  };
  ?(maximize != 0) { ^ pmin; };
  ^ pmax;
}

!g2p_round_up(a: int, b: int) -> int {
  ?(b <= 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  q = g2p_muldiv(a, 1, b);
  r = g2p_muldiv_rem(a, 1, b);
  ?(r != 0) { ^ q + 1; };
  ^ q;
}

!g2p_size_delta_tokens(is_long: int, tokens: int, size_usd: int, size_delta_usd: int) -> int {
  ?(tokens <= 0) { ^ 0; };
  ?(size_usd <= 0) { ^ 0; };
  ?(size_delta_usd < 0) { ^ 0; };
  ?(size_delta_usd == 0) { ^ 0; };
  ?(size_delta_usd == size_usd) { ^ tokens; };
  q = g2p_muldiv(tokens, size_delta_usd, size_usd);
  r = g2p_muldiv_rem(tokens, size_delta_usd, size_usd);
  ?(is_long != 0) {
    ?(r != 0) { ^ q + 1; };
    ^ q;
  };
  ^ q;
}

!g2p_floor_delta(tokens: int, size_usd: int, size_delta_usd: int) -> int {
  ?(tokens <= 0) { ^ 0; };
  ?(size_usd <= 0) { ^ 0; };
  ?(size_delta_usd < 0) { ^ 0; };
  ^ g2p_muldiv(tokens, size_delta_usd, size_usd);
}

!g2p_pnl(is_long: int, tokens: int, size_usd: int, price: int) -> int {
  ?(tokens <= 0) { ^ 0; };
  ?(size_usd < 0) { ^ 0; };
  ?(price <= 0) { ^ 0; };
  val = g2p_muldiv(tokens, price, 1);
  ?(is_long != 0) { ^ val - size_usd; };
  ^ size_usd - val;
}

!g2p_pnl_usd(is_long: int, tokens: int, size_usd: int, size_delta_usd: int, pmin: int, pmax: int) -> int {
  ?(tokens <= 0) { ^ 0; };
  ?(size_usd <= 0) { ^ 0; };
  price = g2p_pick(is_long, 0, pmin, pmax);
  ?(price == 0) { ^ 0; };
  pnl = g2p_pnl(is_long, tokens, size_usd, price);
  dt = g2p_size_delta_tokens(is_long, tokens, size_usd, size_delta_usd);
  ?(dt == 0) { ^ 0; };
  ^ g2p_smuldiv(pnl, dt, tokens);
}

!g2p_wrong_max(is_long: int, tokens: int, size_usd: int, size_delta_usd: int, pmin: int, pmax: int) -> int {
  ?(tokens <= 0) { ^ 0; };
  ?(size_usd <= 0) { ^ 0; };
  price = g2p_pick(is_long, 1, pmin, pmax);
  ?(price == 0) { ^ 0; };
  pnl = g2p_pnl(is_long, tokens, size_usd, price);
  dt = g2p_size_delta_tokens(is_long, tokens, size_usd, size_delta_usd);
  ?(dt == 0) { ^ 0; };
  ^ g2p_smuldiv(pnl, dt, tokens);
}

!g2p_v1_style(size_usd: int, entry: int, price: int) -> int {
  ?(entry <= 0) { ^ 0; };
  ?(size_usd < 0) { ^ 0; };
  d = price - entry;
  ^ g2p_smuldiv(d, size_usd, entry);
}

!g2p_naive_i64(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ^ (a * b) / d;
}

!g2p_test_suite() -> int {
  ?(g2p_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(g2p_muldiv_rem(7, 9, 2) != 1) { ^ -2; };
  ?(g2p_pick(1, 0, 2000, 2100) != 2000) { ^ -3; };
  ?(g2p_pick(1, 1, 2000, 2100) != 2100) { ^ -4; };
  ?(g2p_pick(0, 0, 2000, 2100) != 2100) { ^ -5; };
  ?(g2p_pick(0, 1, 2000, 2100) != 2000) { ^ -6; };
  ?(g2p_round_up(150, 100) != 2) { ^ -7; };
  ?(g2p_size_delta_tokens(1, 3, 100, 50) != 2) { ^ -8; };
  ?(g2p_size_delta_tokens(0, 3, 100, 50) != 1) { ^ -9; };
  ?(g2p_size_delta_tokens(1, 3, 100, 100) != 3) { ^ -10; };
  ?(g2p_pnl(1, 1000000, 2000000000000000, 2100000000) != 100000000000000) { ^ -11; };
  ?(g2p_pnl(1, 1000000, 2000000000000000, 1900000000) != 0 - 100000000000000) { ^ -12; };
  ?(g2p_pnl_usd(1, 1000000, 2000000000000000, 2000000000000000, 2100000000, 2100000000) != 100000000000000) { ^ -13; };
  ?(g2p_pnl_usd(0, 1000000, 2000000000000000, 2000000000000000, 1900000000, 1950000000) != 50000000000000) { ^ -14; };
  ?(g2p_wrong_max(1, 1000000, 2000000000000000, 2000000000000000, 2000000000, 2100000000) != 100000000000000) { ^ -15; };
  ?(g2p_pnl_usd(1, 1000000, 2000000000000000, 2000000000000000, 2000000000, 2100000000) != 0) { ^ -16; };
  ?(g2p_pnl(1, 3, 3001, 1100) != 299) { ^ -17; };
  ?(g2p_v1_style(3001, 1000, 1100) != 300) { ^ -18; };
  ?(g2p_size_delta_tokens(1, 3, 3000, 1500) != 2) { ^ -19; };
  ?(g2p_pnl_usd(1, 3, 3000, 1500, 1100, 1100) != 200) { ^ -20; };
  ?(g2p_floor_delta(3, 3000, 1500) != 1) { ^ -21; };
  ?(g2p_muldiv(7000000000, 2000000000, 1000000) != 14000000000000) { ^ -22; };
  ?(g2p_naive_i64(7000000000, 2000000000, 1000000) == 14000000000000) { ^ -23; };
  ?(g2p_pnl_usd(0, 0, 2000000000000000, 2000000000000000, 2100000000, 2100000000) != 0) { ^ -24; };
  ^ 1;
}

=ex{
  g2p_u_lt,
  g2p_u_add_carry,
  g2p_mask32,
  g2p_muldiv_part,
  g2p_muldiv,
  g2p_muldiv_rem,
  g2p_smuldiv,
  g2p_pick,
  g2p_round_up,
  g2p_size_delta_tokens,
  g2p_floor_delta,
  g2p_pnl,
  g2p_pnl_usd,
  g2p_wrong_max,
  g2p_v1_style,
  g2p_naive_i64,
  g2p_test_suite
}
