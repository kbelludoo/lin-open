!ak_sum4(): int {
  xs: [4]int;
  xs[0] = 1;
  xs[1] = 2;
  xs[2] = 3;
  xs[3] = 4;
  ^xs[0] + xs[1] + xs[2] + xs[3];
}

!ak_index(i: int): int {
  xs: [4]int;
  xs[0] = 10;
  xs[1] = 20;
  xs[2] = 30;
  xs[3] = 40;
  ^xs[i];
}

!ak_len(): int {
  xs: [4]int;
  xs[0] = 4;
  ^xs.length;
}

!ak_pop4(): int {
  xs: [4]int;
  xs[0] = 1;
  xs[1] = 3;
  xs[2] = 7;
  xs[3] = 15;
  s = 0;
  i = 0;
  while (i < xs.length) {
    x = xs[i];
    c = 0;
    while (x != 0) {
      c = c + (x & 1);
      x = _lia_shr(x, 1);
    };
    s = s + c;
    i = i + 1;
  };
  ^s;
}

