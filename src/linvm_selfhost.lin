  ft: [128]int = [2, 6, 0, 0, 385, 6, 0, 0, 769, 17, 0, 0, 1858, 10, 0, 0, 2498, 9, 0, 0, 3074, 15, 0, 0, 4033, 16, 0, 0, 5057, 37, 0, 0, 7425, 8, 0, 0, 7937, 6, 0, 0, 8321, 6, 0, 0, 8705, 6, 0, 0, 9090, 18, 0, 0, 10242, 18, 0, 0, 11393, 16, 0, 0, 12418, 13, 0, 0, 13252, 23, 0, 0, 14721, 13, 0, 0, 15552, 1050, 256, 0, 17217, 1041, 257, 0, 18304, 1031, 256, 0, 18752, 1077, 256, 0, 22144, 56, 0, 0, 25728, 1049, 256, 0, 27328, 10, 0, 0, 27968, 10, 0, 0, 28608, 7, 0, 0, 29056, 3, 0, 0, 29248, 3, 0, 0, 29440, 16, 0, 0, 30464, 1, 0, 0, 0, 0, 0, 0];
  st: [256]int;
  loc: [64]int;
  pl: [256]int;
  pc = 0;
  sp = 0;
  steps = steps_in;
  h = h_in;
