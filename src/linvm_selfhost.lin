      sp = sp - 2;
      x = st[sp];
      y = st[sp + 1];
      ?(x != y) { st[sp] = 1 ;} : { st[sp] = 0 ;};
      sp = sp + 1;
    } : (o == 18) { // cmp_lt
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
      x = st[sp];
      y = st[sp + 1];
      ?(x < y) { st[sp] = 1 ;} : { st[sp] = 0 ;};
      sp = sp + 1;
    } : (o == 19) { // cmp_gt
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
      x = st[sp];
      y = st[sp + 1];
      ?(x > y) { st[sp] = 1 ;} : { st[sp] = 0 ;};
      sp = sp + 1;
    } : (o == 20) { // cmp_le
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
      x = st[sp];
      y = st[sp + 1];
      ?(x <= y) { st[sp] = 1 ;} : { st[sp] = 0 ;};
      sp = sp + 1;
    } : (o == 21) { // cmp_ge
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
      x = st[sp];
      y = st[sp + 1];
      ?(x >= y) { st[sp] = 1 ;} : { st[sp] = 0 ;};
      sp = sp + 1;
    } : (o == 22) { // log_not
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      ?(st[sp - 1] == 0) { st[sp - 1] = 1 ;} : { st[sp - 1] = 0 ;};
    } : (o == 23) { // jump
      pc = av;
    } : (o == 24) { // jump_if_false (pops)
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 1;
      ?(st[sp] == 0) { pc = av ;};
    } : (o == 25) { // jump_if_false_keep
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      ?(st[sp - 1] == 0) { pc = av ;};
    } : (o == 26) { // jump_if_true_keep
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      ?(st[sp - 1] != 0) { pc = av ;};
    } : (o == 27) { // pop
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 1;
    } : (o == 28) { // call
      ti = av;
      ?(ti < 0 || ti >= 31) { ?(mode == 2) { ^4 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      n = ft[ti * 4] & 63;
      ?(sp < n) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - n;
      c0 = st[sp];
      c1 = st[sp + 1];
      c2 = st[sp + 2];
      c3 = st[sp + 3];
      ?(depth + 1 > 192) { ?(mode == 2) { ^5 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      v2 = vms_core(sel, ti, depth + 1, steps, 0, h, c0, c1, c2, c3);
      ?(mode == 0 || mode == 1) {
        s2 = vms_core(sel, ti, depth + 1, steps, 1, 0, c0, c1, c2, c3);
        ?(s2 < 0) {
          steps = steps + (0 - s2);
          ?(mode == 1) { ^((steps_in - steps) + s2) ;};
        } : {
          steps = steps + s2;
        };
      };
      ?(mode == 2) {
        st2 = vms_core(sel, ti, depth + 1, steps, 2, 0, c0, c1, c2, c3);
        ?(st2 != 0) { ^st2 ;};
      };
      ?(mode == 3) {
        h = vms_core(sel, ti, depth + 1, steps, 3, h, c0, c1, c2, c3);
      };
      st[sp] = v2;
      sp = sp + 1;
    } : (o == 29) { // ret
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      ?(mode == 0) { ^st[sp - 1] ;};
      ?(mode == 1) { ^(steps - steps_in) ;};
      ?(mode == 2) { ^0 ;};
      ?(mode == 3) { h = ((h + po) * 31) + sp; ^h ;};
      ?(mode == 4) { ^sp ;};
      ^0;
    } : (o == 30) { // load_index (out-of-bounds -> 0)
      ?(sp == 0) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 1;
      ix = st[sp];
      v = 0;
      ?(loc[av] >= 0 && loc[av] < 8) {
        ?(ix >= 0 && ix < loc[56 + loc[av]]) {
          b = 0;
          s3 = 0;
          while (s3 < loc[av]) { b = b + loc[56 + s3]; s3 = s3 + 1; };
          v = pl[b + ix];
        };
      };
      ?(sp >= 256) { ?(mode == 2) { ^2 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      st[sp] = v;
      sp = sp + 1;
    } : (o == 31) { // store_index (out-of-bounds -> no-op)
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
      ix = st[sp];
      v = st[sp + 1];
      ?(loc[av] >= 0 && loc[av] < 8) {
        ?(ix >= 0 && ix < loc[56 + loc[av]]) {
          b = 0;
          s3 = 0;
          while (s3 < loc[av]) { b = b + loc[56 + s3]; s3 = s3 + 1; };
          pl[b + ix] = v;
        };
      };
    } : (o == 32) { // arr_len
      ?(sp >= 256) { ?(mode == 2) { ^2 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      v = 0;
      ?(loc[av] >= 0 && loc[av] < 8) { v = loc[56 + loc[av]] ;};
      st[sp] = v;
      sp = sp + 1;
    } : { // unknown opcode -> VmBadFunction
      ?(mode == 2) { ^4 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;};
    };
  };
  // fallthrough: val 0, sp_at_ret = sp
  ?(po >= 0) { h = ((h + po) * 31) + sp ;};
  ?(mode == 0) { ^0 ;};
  ?(mode == 1) { ^(steps - steps_in) ;};
  ?(mode == 2) { ^0 ;};
  ?(mode == 3) { ^h ;};
  ?(mode == 4) { ^sp ;};
  ^0;
}

// -------- scalar helpers (pure int, no arrays) --------
!vms_i64min(): int {
  ^0 - 9223372036854775807 - 1;
}

!vms_uge(a: int, b: int): int {
  ?(a == b) { ^1 ;};
  sa = _lia_ushr(a, 63);
  sb = _lia_ushr(b, 63);
  ?(sa != sb) { ?(sb == 1) { ^0 ;} : { ^1 ;} };
  ?(a > b) { ^1 ;};
  ^0;
}

!vms_udiv(nn: int, dd: int): int {
  q = 0;
  r = 0;
  i = 63;
  while (i >= 0) {
    r = _lia_shl(r, 1);
    r = r | (_lia_ushr(nn, i) & 1);
    ?(vms_uge(r, dd) == 1) {
      r = r - dd;
      q = q | _lia_shl(1, i);
    };
    i = i - 1;
  };
  ^q;
}

!vms_div(x: int, y: int): int {
  neg = 0;
  ax = x;
  ?(x < 0) { ax = 0 - x; neg = 1 ;};
  ay = y;
  ?(y < 0) { ay = 0 - ay; ?(neg == 1) { neg = 0 ;} : { neg = 1 ;} };
  q = vms_udiv(ax, ay);
  ?(neg == 1) { q = 0 - q ;};
  ^q;
}

// -------- runner API --------
!vms_value(sel: int): int { ^vms_core(sel, -1, 0, 0, 0, 0, 0, 0, 0, 0); }
!vms_steps(sel: int): int { ^vms_core(sel, -1, 0, 0, 1, 0, 0, 0, 0, 0); }
!vms_status(sel: int): int { ^vms_core(sel, -1, 0, 0, 2, 0, 0, 0, 0, 0); }
!vms_trace(sel: int): int { ^vms_core(sel, -1, 0, 0, 3, 0, 0, 0, 0, 0); }
!vms_sp(sel: int): int { ^vms_core(sel, -1, 0, 0, 4, 0, 0, 0, 0, 0); }
!vms_value_sweep(sel: int, x0: int): int { ^vms_core(sel, -1, 0, 0, 0, 0, x0, 0, 0, 0); }
!vms_steps_sweep(sel: int, x0: int): int { ^vms_core(sel, -1, 0, 0, 1, 0, x0, 0, 0, 0); }
!vms_status_sweep(sel: int, x0: int): int { ^vms_core(sel, -1, 0, 0, 2, 0, x0, 0, 0, 0); }
!vms_trace_sweep(sel: int, x0: int): int { ^vms_core(sel, -1, 0, 0, 3, 0, x0, 0, 0, 0); }
!vms_sp_sweep(sel: int, x0: int): int { ^vms_core(sel, -1, 0, 0, 4, 0, x0, 0, 0, 0); }
!vms_sweep_sel(sel: int): int { ^vms_value_sweep(sel, sel - 100000); }

!vms_expect(sel: int, es: int, ev: int, et: int, eh: int, esp: int): int {
  ?(vms_status(sel) != es) { ^0 ;};
  ?(es != 0) { ^1 ;};
  ?(vms_value(sel) != ev) { ^0 ;};
  ?(vms_steps(sel) != et) { ^0 ;};
  ?(vms_trace(sel) != eh) { ^0 ;};
  ?(vms_sp(sel) != esp) { ^0 ;};
  ^1;
}

!vms_expect_sweep(sel: int, x0: int, es: int, ev: int, et: int, eh: int, esp: int): int {
  ?(vms_status_sweep(sel, x0) != es) { ^0 ;};
  ?(es != 0) { ^1 ;};
  ?(vms_value_sweep(sel, x0) != ev) { ^0 ;};
  ?(vms_steps_sweep(sel, x0) != et) { ^0 ;};
  ?(vms_trace_sweep(sel, x0) != eh) { ^0 ;};
  ?(vms_sp_sweep(sel, x0) != esp) { ^0 ;};
  ^1;
}

