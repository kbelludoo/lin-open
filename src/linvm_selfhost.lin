      st[sp] = x - y;
      sp = sp + 1;
    } : (o == 5) { // mul
      ?(sp < 2) { ?(mode == 2) { ^3 ;} : (mode == 1) { ^(0 - (steps - steps_in)) ;} : (mode == 3) { ^h ;} : (mode == 4) { ^sp ;} : { ^0 ;} };
      sp = sp - 2;
