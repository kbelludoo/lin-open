  ?(fn_idx < 0) {
  ?(sel == 0) { fi = 0; x0 = 20; x1 = 22; x2 = 0; x3 = 0; };
  ?(sel == 1) { fi = 0; x0 = 1; x1 = 2; x2 = 0; x3 = 0; };
