@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=anti_forgery_engine
~G{?=if #=for ^=ret :else}

!recompute_source_binding_proof(computed_sha: int, stated_sha: int) -> int {
    valid = 0;
    ?(computed_sha == stated_sha) {
        valid = 1;
    }
    ^valid;
}

!recompute_mir_kernel_proof(mir_hash: int, kernel_hash: int) -> int {
    coherent = 0;
    ?(mir_hash != 0) {
        ?(kernel_hash != 0) {
            coherent = 1;
        }
    }
    ^coherent;
}

!recompute_merkle_attestation_root(left_node: int, right_node: int) -> int {
    root = (left_node * 65537) + (right_node * 257) + 104729;
    ^root;
}

!evaluate_adversarial_mutation_reject(is_mutated: int) -> int {
    // If mutated (1), MUST REJECT (0). If unmutated (0), PASS (1).
    decision = 0;
    ?(is_mutated == 0) {
        decision = 1;
    }
    ^decision;
}

!audit_10_adversarial_vectors(rejected_count: int) -> int {
    // All 10 adversarial vectors must be caught & rejected
    all_caught = 0;
    ?(rejected_count == 10) {
        all_caught = 1;
    }
    ^all_caught;
}

=ex{recompute_source_binding_proof, recompute_mir_kernel_proof, recompute_merkle_attestation_root, evaluate_adversarial_mutation_reject, audit_10_adversarial_vectors}
