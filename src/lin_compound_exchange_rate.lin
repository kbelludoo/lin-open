@LIN:L1c:0.2
@COMPOUND_CTOKEN_EXCHANGE_RATE{
  version=1
  repo="compound-finance/compound-protocol"
  source="contracts/CToken.sol"
  function="exchangeRateStoredInternal"
  license="BSD-3-Clause"
  commit="a3214f67b73310d547e00fc578e8355911c9d376"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_ctoken_exchange_rate_with_128bit_muldiv"
  note="Not mainnet uint256. Real deltas: cash/borrows/reserves/supply/initial are arguments; (underlying*1e18)/supply uses a 128-bit product; cash+borrows-reserves underflow fail-closes to 0."
}

!cer_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cer_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cer_u_lt(s, a));
}

!cer_mask32() -> int {
  ^ 4294967295;
}

!cer_exp_scale() -> int {
  ^ 1000000000000000000;
}

!cer_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = cer_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cer_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cer_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cer_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cer_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!cer_muldiv(a: int, b: int, d: int) -> int {
  ^ cer_muldiv_part(a, b, d, 0);
}

!cer_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ cer_muldiv_part(a, b, d, 1);
}

!cer_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(cer_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!cer_neg(x: int) -> int {
  ?(x < 0) { ^ 1; };
  ^ 0;
}

!cer_underlying_ok(cash: int, borrows: int, reserves: int) -> int {
  ?(cer_neg(cash) == 1) { ^ 0; };
  ?(cer_neg(borrows) == 1) { ^ 0; };
  ?(cer_neg(reserves) == 1) { ^ 0; };
  ?(cer_u_add_ok(cash, borrows) == 0) { ^ 0; };
  sum = cash + borrows;
  ?(cer_u_lt(sum, reserves) == 1) { ^ 0; };
  ^ 1;
}

!cer_underlying(cash: int, borrows: int, reserves: int) -> int {
  ?(cer_underlying_ok(cash, borrows, reserves) == 0) { ^ 0; };
  ^ (cash + borrows) - reserves;
}

!cer_ok(cash: int, borrows: int, reserves: int, total_supply: int, initial_rate: int) -> int {
  ?(cer_neg(total_supply) == 1) { ^ 0; };
  ?(cer_neg(initial_rate) == 1) { ^ 0; };
  ?(total_supply == 0) { ^ 1; };
  ^ cer_underlying_ok(cash, borrows, reserves);
}

!cer_exchange_rate(cash: int, borrows: int, reserves: int, total_supply: int, initial_rate: int) -> int {
  ?(cer_neg(total_supply) == 1) { ^ 0; };
  ?(cer_neg(initial_rate) == 1) { ^ 0; };
  ?(total_supply == 0) { ^ initial_rate; };
  ?(cer_underlying_ok(cash, borrows, reserves) == 0) { ^ 0; };
  under = (cash + borrows) - reserves;
  ^ cer_muldiv(under, cer_exp_scale(), total_supply);
}

!cer_test_suite() -> int {
  ?(cer_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(cer_muldiv(7, 9, 1) != 63) { ^ -2; };
  init = 200000000000000000;
  ?(cer_exchange_rate(0, 0, 0, 0, init) != init) { ^ -3; };
  ?(cer_ok(0, 0, 0, 0, init) != 1) { ^ -4; };
  ?(cer_exchange_rate(1000, 0, 0, 1000, init) != 1000000000000000000) { ^ -5; };
  ?(cer_exchange_rate(1000, 1000, 0, 1000, init) != 2000000000000000000) { ^ -6; };
  ?(cer_exchange_rate(1, 1, 3, 1, init) != 0) { ^ -7; };
  ?(cer_ok(1, 1, 3, 1, init) != 0) { ^ -8; };
  ?(cer_underlying_ok(1, 1, 3) != 0) { ^ -9; };
  ?(cer_underlying(1000, 1000, 0) != 2000) { ^ -10; };
  ?(cer_muldiv(1000000000000000000, 1000000000000000000, 1000000000000000000) != 1000000000000000000) { ^ -11; };
  ?(cer_muldiv(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -12; };
  ?(cer_muldiv_rem(7, 9, 2) != 1) { ^ -13; };
  ?(cer_exchange_rate(-1, 0, 0, 1, init) != 0) { ^ -14; };
  ?(cer_exchange_rate(0, 0, 0, 0, -1) != 0) { ^ -15; };
  ?(cer_ok(0, 0, 0, -1, init) != 0) { ^ -16; };
  ^ 1;
}

=ex{
  cer_u_lt,
  cer_u_add_carry,
  cer_mask32,
  cer_exp_scale,
  cer_muldiv_part,
  cer_muldiv,
  cer_muldiv_rem,
  cer_u_add_ok,
  cer_neg,
  cer_underlying_ok,
  cer_underlying,
  cer_ok,
  cer_exchange_rate,
  cer_test_suite
}
