@LIN:L1c:0.2
@BITCOIN_CORE_DUST{
  version=1
  repo="bitcoin/bitcoin"
  source="src/policy/policy.cpp GetDustThreshold+IsDust + src/policy/feerate.cpp GetFee + src/policy/policy.h DUST_RELAY_TX_FEE"
  license="MIT"
  tag="v27.1"
  commit="1088a98f5aad080cc6cca2da174f206509fcda6c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="integer_ceil_GetDustThreshold_IsDust_default_3000sat_kvB"
  note="Not a wallet or consensus. Core GetFee uses std::ceil(double); LIN uses integer ceil. Taproot uses the P2WPKH 107-byte dummy spend (PR 22779), not BIP340 keypath weight. Negative fee rates fail-closed (-1)."
}

!btd_coin() -> int {
  ^ 100000000;
}

!btd_btc_max() -> int {
  ^ 21000000;
}

!btd_max_money() -> int {
  ^ (21000000 * 100000000);
}

!btd_witness_scale() -> int {
  ^ 4;
}

!btd_dust_relay_fee() -> int {
  ^ 3000;
}

!btd_min_relay_fee() -> int {
  ^ 1000;
}

!btd_p2pkh_script() -> int {
  ^ 25;
}

!btd_p2wpkh_script() -> int {
  ^ 22;
}

!btd_p2tr_script() -> int {
  ^ 34;
}

!btd_p2sh_script() -> int {
  ^ 23;
}

!btd_money_range(n: int) -> int {
  ?(n < 0) { ^ 0; };
  ?(n > (21000000 * 100000000)) { ^ 0; };
  ^ 1;
}

!btd_overflow_mul(a: int, b: int) -> int {
  p = 0;
  ?(a < 0) { ^ -1; };
  ?(b < 0) { ^ -1; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  p = a * b;
  ?(p < 0) { ^ -1; };
  ?(p / a != b) { ^ -1; };
  ^ p;
}

!btd_ceil_div(n: int, d: int) -> int {
  q = 0;
  r = 0;
  ?(d <= 0) { ^ -1; };
  ?(n < 0) { ^ -1; };
  ?(n == 0) { ^ 0; };
  q = n / d;
  r = n - (q * d);
  ?(r == 0) { ^ q; };
  ^ (q + 1);
}

!btd_get_fee(sat_per_kvb: int, nbytes: int) -> int {
  num = 0;
  fee = 0;
  ?(sat_per_kvb < 0) { ^ -1; };
  ?(nbytes < 0) { ^ -1; };
  ?(nbytes == 0) { ^ 0; };
  num = btd_overflow_mul(sat_per_kvb, nbytes);
  ?(num < 0) { ^ -1; };
  fee = btd_ceil_div(num, 1000);
  ?(fee < 0) { ^ -1; };
  ?(fee == 0) {
    ?(sat_per_kvb > 0) { ^ 1; };
  };
  ^ fee;
}

!btd_compact_size(n: int) -> int {
  ?(n < 0) { ^ -1; };
  ?(n < 253) { ^ 1; };
  ?(n <= 65535) { ^ 3; };
  ?(n <= 4294967295) { ^ 5; };
  ^ 9;
}

!btd_txout_size(script_len: int) -> int {
  cs = 0;
  ?(script_len < 0) { ^ -1; };
  cs = btd_compact_size(script_len);
  ?(cs < 0) { ^ -1; };
  ^ (8 + cs + script_len);
}

!btd_spend_overhead(is_witness: int) -> int {
  ?(is_witness < 0) { ^ -1; };
  ?(is_witness == 0) { ^ (32 + 4 + 1 + 107 + 4); };
  ^ (32 + 4 + 1 + (107 / 4) + 4);
}

!btd_dust_nsize(script_len: int, is_witness: int, is_unspendable: int) -> int {
  out_sz = 0;
  oh = 0;
  ?(is_unspendable != 0) { ^ 0; };
  out_sz = btd_txout_size(script_len);
  ?(out_sz < 0) { ^ -1; };
  oh = btd_spend_overhead(is_witness);
  ?(oh < 0) { ^ -1; };
  ^ (out_sz + oh);
}

!btd_get_dust_threshold(script_len: int, is_witness: int, is_unspendable: int, sat_per_kvb: int) -> int {
  nsz = 0;
  ?(is_unspendable != 0) { ^ 0; };
  nsz = btd_dust_nsize(script_len, is_witness, 0);
  ?(nsz < 0) { ^ -1; };
  ^ btd_get_fee(sat_per_kvb, nsz);
}

!btd_is_dust(nvalue: int, script_len: int, is_witness: int, is_unspendable: int, sat_per_kvb: int) -> int {
  thr = 0;
  thr = btd_get_dust_threshold(script_len, is_witness, is_unspendable, sat_per_kvb);
  ?(thr < 0) { ^ 0; };
  ?(nvalue < thr) { ^ 1; };
  ^ 0;
}

!btd_dust_gate() -> int {
  ?(btd_coin() != 100000000) { ^ -1; };
  ?(btd_max_money() != 2100000000000000) { ^ -2; };
  ?(btd_dust_relay_fee() != 3000) { ^ -3; };
  ?(btd_min_relay_fee() != 1000) { ^ -4; };
  ?(btd_witness_scale() != 4) { ^ -5; };
  ?(btd_spend_overhead(0) != 148) { ^ -6; };
  ?(btd_spend_overhead(1) != 67) { ^ -7; };
  ?(btd_txout_size(25) != 34) { ^ -8; };
  ?(btd_txout_size(22) != 31) { ^ -9; };
  ?(btd_txout_size(34) != 43) { ^ -10; };
  ?(btd_txout_size(23) != 32) { ^ -11; };
  ?(btd_dust_nsize(25, 0, 0) != 182) { ^ -12; };
  ?(btd_dust_nsize(22, 1, 0) != 98) { ^ -13; };
  ?(btd_dust_nsize(34, 1, 0) != 110) { ^ -14; };
  ?(btd_dust_nsize(23, 0, 0) != 180) { ^ -15; };
  ?(btd_get_dust_threshold(25, 0, 0, 3000) != 546) { ^ -16; };
  ?(btd_get_dust_threshold(22, 1, 0, 3000) != 294) { ^ -17; };
  ?(btd_get_dust_threshold(34, 1, 0, 3000) != 330) { ^ -18; };
  ?(btd_get_dust_threshold(23, 0, 0, 3000) != 540) { ^ -19; };
  ?(btd_is_dust(545, 25, 0, 0, 3000) != 1) { ^ -20; };
  ?(btd_is_dust(546, 25, 0, 0, 3000) != 0) { ^ -21; };
  ?(btd_is_dust(293, 22, 1, 0, 3000) != 1) { ^ -22; };
  ?(btd_is_dust(294, 22, 1, 0, 3000) != 0) { ^ -23; };
  ?(btd_is_dust(329, 34, 1, 0, 3000) != 1) { ^ -24; };
  ?(btd_is_dust(330, 34, 1, 0, 3000) != 0) { ^ -25; };
  ?(btd_get_dust_threshold(25, 0, 1, 3000) != 0) { ^ -26; };
  ?(btd_is_dust(1, 25, 0, 1, 3000) != 0) { ^ -27; };
  ?(btd_get_fee(-1, 10) != -1) { ^ -28; };
  ?(btd_get_fee(1000, 200) != 200) { ^ -29; };
  ?(btd_compact_size(252) != 1) { ^ -30; };
  ?(btd_compact_size(253) != 3) { ^ -31; };
  ^ 1;
}

=ex{
  btd_coin,
  btd_btc_max,
  btd_max_money,
  btd_witness_scale,
  btd_dust_relay_fee,
  btd_min_relay_fee,
  btd_p2pkh_script,
  btd_p2wpkh_script,
  btd_p2tr_script,
  btd_p2sh_script,
  btd_money_range,
  btd_overflow_mul,
  btd_ceil_div,
  btd_get_fee,
  btd_compact_size,
  btd_txout_size,
  btd_spend_overhead,
  btd_dust_nsize,
  btd_get_dust_threshold,
  btd_is_dust,
  btd_dust_gate
}
