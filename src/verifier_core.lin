@LIN:verifier_core:1.0.0
^schema_once ^lossy=true ^ops=verifier_core
~G{?=if #=for ^=ret :else}

!deepEq(a, b){
  ?(a === b){ ^true }
  ?(typeof a !== typeof b){ ^false }
  ?(a === null || b === null){ ^false }
  ?(Array.isArray(a) && Array.isArray(b)){
    ?(a.length !== b.length){ ^false }
    #(i = 0; i < a.length; i++){
      ?(!deepEq(a[i], b[i])){ ^false }
    }
    ^true
  }
  ?(typeof a === "object" && typeof b === "object"){
    ka = Object.keys(a);
    kb = Object.keys(b);
    ?(ka.length !== kb.length){ ^false }
    #(j = 0; j < ka.length; j++){
      k = ka[j];
      ?(!deepEq(a[k], b[k])){ ^false }
    }
    ^true
  }
  ^(Number.isNaN(a) && Number.isNaN(b))
}

!findMissingExports(fnNamesList, exportsList){
  fnSet = fnNamesList;
  missing = [];
  #(k = 0; k < exportsList.length; k++){
    e = exportsList[k].split(/\s+as\s+/)[0].trim();
    ?(!fnSet.includes(e)){
      missing.push(e)
    }
  }
  ^missing
}

=ex{deepEq, findMissingExports}
