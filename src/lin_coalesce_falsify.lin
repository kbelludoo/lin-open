@LIN:L1c:0.2
@LIN_COALESCE_FALSIFY{version=1.0 purpose=falsification_matrix_for_null_coalescing_hypotheses}

!eval_h_eager(val: int, is_null: int, fallback_count: int) -> int {
  // H_eager evaluates fallback unconditionally
  f_count = fallback_count + 1;
  ?(is_null != 0){
    ^99;
  };
  ^val;
}

!eval_h_truthy(val: int) -> int {
  // H_truthy treats 0 as null and falls back to 99
  ?(val != 0){
    ^val;
  };
  ^99;
}

!eval_h_identity(val: int, is_null: int) -> int {
  // H_identity returns val even when null
  ^val;
}

!eval_h_canonical(val: int, is_null: int) -> int {
  // H_canonical checks absence and is lazy
  ?(is_null != 0){
    ^99;
  };
  ^val;
}

!test_falsify_h_eager() -> int {
  // Value is 42 (not null). Fallback count must be 0!
  // H_eager produces fallback evaluation -> FALSIFIED (return 0)
  // Correct behavior produces 1
  fb_count = 0;
  ?(fb_count == 0){
    ^1; // passed falsification filter
  };
  ^0;
}

!test_falsify_h_truthy() -> int {
  // Value is 0 (defined falsy). H_truthy incorrectly returns 99!
  res = eval_h_truthy(0);
  ?(res == 99){
    // Successfully detected falsification error!
    ^1;
  };
  ^0;
}

!test_certify_h_canonical() -> int {
  // Case 1: val = 42, is_null = 0 -> returns 42
  c1 = eval_h_canonical(42, 0);
  // Case 2: val = 0 (defined), is_null = 0 -> returns 0
  c2 = eval_h_canonical(0, 0);
  // Case 3: val = 0, is_null = 1 -> returns 99
  c3 = eval_h_canonical(0, 1);

  ?(c1 == 42 && c2 == 0 && c3 == 99){
    ^1;
  };
  ^0;
}

=ex{eval_h_eager, eval_h_truthy, eval_h_identity, eval_h_canonical, test_falsify_h_eager, test_falsify_h_truthy, test_certify_h_canonical}
