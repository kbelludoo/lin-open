@LIN:semantic_hash_core:1.0.0
^schema_once ^lossy=true ^ops=semantic_hash_core
~G{?=if #=for ^=ret :else}

!escapeRe(s){
  ^(s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"))
}

!canonicalize(params, body){
  canon = String(body || "").trim();
  canon = canon.replace(/\/\*[\s\S]*?\*\/|\/\/[^\r\n]*/g, "");
  canon = canon.replace(/\s+/g, " ").replace(/\s*([=+\-*/%&|^<>(),;!?:{}\[\]])\s*/g, "$1").trim();
  rawParams = String(params || "").split(",").map(function(p){ ^p.trim() }).filter(Boolean);
  paramTypes = rawParams.map(function(p){ ^(p.includes(":") ? p.split(":")[1].trim() : "") }).join(",");
  paramList = rawParams.map(function(p){ ^p.replace(/:.+$/, "").trim() });
  
  #(i = 0; i < paramList.length; i++){
    re = new RegExp("\\b" + escapeRe(paramList[i]) + "\\b", "g");
    canon = canon.replace(re, "$" + i)
  }
  
  reserved = ["var", "let", "const", "return", "if", "else", "while", "for", "in", "of", "null", "true", "false", "undefined", "void", "typeof"];
  locals = [];
  assignRe = /(?:^|[;{(])\s*([a-zA-Z_$][\w$]*)\s*=(?!=)/g;
  m = null;
  while ((m = assignRe.exec(canon)) !== null) {
    id = m[1];
    ?(!locals.includes(id) && !id.startsWith("$") && !reserved.includes(id)){
      locals.push(id)
    }
  }
  
  #(j = 0; j < locals.length; j++){
    reLoc = new RegExp("\\b" + escapeRe(locals[j]) + "\\b", "g");
    canon = canon.replace(reLoc, "_l" + j)
  }
  
  canon = canon.replace(/'/g, "\"");
  canon = canon.replace(/===/g, "==").replace(/!==/g, "!=");
  canon = canon.replace(/;+/g, ";").replace(/;+$/, "");
  ^("(" + paramList.length + ":" + paramTypes + ")" + canon)
}

=ex{escapeRe, canonicalize}
