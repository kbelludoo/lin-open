@LIN:L1c:0.2
!escapeRe(s){^(s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));}
!canonicalize(params,body){var canon,rawParams,paramTypes,paramList,re,reserved,locals,assignRe,m,id,reLoc,i,j;canon = String(body || "").trim();canon = canon.replace(/\/\*[\s\S]*?\*\/|\/\/[^\r\n]*/g, "");canon = canon.replace(/\s+/g, " ").replace(/\s*([=+\-*/%&|^<>(),;!?:{}\[\]])\s*/g, "$1").trim();rawParams = String(params || "").split(",").map(function(p){^p.trim();}).filter(Boolean);paramTypes = rawParams.map(function(p){^(p.includes(":") ? p.split(":")[1].trim() : "");}).join(",");paramList = rawParams.map(function(p){^p.replace(/:.+$/, "").trim();});for(i = 0;i < paramList.length;i++){re = new RegExp("\\b" + escapeRe(paramList[i]) + "\\b", "g");canon = canon.replace(re, "$" + i);}reserved = ["var", "let", "const", "return", "if", "else", "while", "for", "in", "of", "null", "true", "false", "undefined", "void", "typeof"];locals = [];assignRe = /(?:^|[;{(])\s*([a-zA-Z_$][\w$]*)\s*=(?!=)/g;m = null;while((m = assignRe.exec(canon)) !== null){id = m[1];?(!locals.includes(id) && !id.startsWith("$") && !reserved.includes(id)){locals.push(id);}}for(j = 0;j < locals.length;j++){reLoc = new RegExp("\\b" + escapeRe(locals[j]) + "\\b", "g");canon = canon.replace(reLoc, "_l" + j);}canon = canon.replace(/'/g, "\"");canon = canon.replace(/===/g, "==").replace(/!==/g, "!=");canon = canon.replace(/;+/g, ";").replace(/;+$/, "");^("(" + paramList.length + ":" + paramTypes + ")" + canon);}
module.exports={escapeRe,canonicalize};
module.exports={escapeRe,canonicalize};}
