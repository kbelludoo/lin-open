@LIN:L1c:0.2
@OPENZEPPELIN_MULDIV{
  version=1
  repo="OpenZeppelin/openzeppelin-contracts"
  source="contracts/utils/math/Math.sol"
  license="MIT"
  tag="v5.0.2"
  commit="dbb6104ce834628e473d2173bbc9d47f81a9eec3"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_oz_muldiv_with_explicit_rounding"
  note="Not Solidity uint256. OZ mulDiv uses Yul mulmod/CRT 512-bit product and reverts. LIN takes Rounding as 0/1/2/3, uses a visible 128-bit schoolbook product, and fail-closes to 0 on div0/overflow/bad flags. unsignedRoundsUp is rounding%2 after a 0..3 check (no uint8 enum cast)."
}

!ozmd_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!ozmd_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(ozmd_u_lt(s, a));
}

!ozmd_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(ozmd_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!ozmd_mask32() -> int {
  ^ 4294967295;
}

!ozmd_ok_nn(v: int) -> int {
  ?(v < 0) { ^ 0; };
  ^ 1;
}

!ozmd_ok_round(r: int) -> int {
  ?(r < 0) { ^ 0; };
  ?(r > 3) { ^ 0; };
  ^ 1;
}

!ozmd_floor_mode() -> int {
  ^ 0;
}

!ozmd_ceil_mode() -> int {
  ^ 1;
}

!ozmd_trunc_mode() -> int {
  ^ 2;
}

!ozmd_expand_mode() -> int {
  ^ 3;
}

!ozmd_rounds_up(rounding: int) -> int {
  ?(ozmd_ok_round(rounding) == 0) { ^ 0; };
  ^ rounding % 2;
}

!ozmd_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = ozmd_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = ozmd_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = ozmd_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(ozmd_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = ozmd_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want == 1) { ^ r_lo; };
  ?(want == 2) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!ozmd_floor(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(ozmd_ok_nn(x) == 0) { ^ 0; };
  ?(ozmd_ok_nn(y) == 0) { ^ 0; };
  ^ ozmd_muldiv_part(x, y, d, 0);
}

!ozmd_rem(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(ozmd_ok_nn(x) == 0) { ^ 0; };
  ?(ozmd_ok_nn(y) == 0) { ^ 0; };
  ^ ozmd_muldiv_part(x, y, d, 1);
}

!ozmd_ov(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 1; };
  ?(ozmd_ok_nn(x) == 0) { ^ 1; };
  ?(ozmd_ok_nn(y) == 0) { ^ 1; };
  ^ ozmd_muldiv_part(x, y, d, 2);
}

!ozmd_ceil(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(ozmd_ok_nn(x) == 0) { ^ 0; };
  ?(ozmd_ok_nn(y) == 0) { ^ 0; };
  ?(ozmd_muldiv_part(x, y, d, 2) == 1) { ^ 0; };
  q = ozmd_muldiv_part(x, y, d, 0);
  r = ozmd_muldiv_part(x, y, d, 1);
  ?(r == 0) { ^ q; };
  ?(ozmd_u_add_ok(q, 1) == 0) { ^ 0; };
  ^ q + 1;
}

!ozmd_muldiv(x: int, y: int, d: int, rounding: int) -> int {
  ?(ozmd_ok_round(rounding) == 0) { ^ 0; };
  ?(ozmd_rounds_up(rounding) == 1) { ^ ozmd_ceil(x, y, d); };
  ^ ozmd_floor(x, y, d);
}

!ozmd_ceil_div(a: int, b: int) -> int {
  ?(b == 0) { ^ 0; };
  ?(ozmd_ok_nn(a) == 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ^ ((a - 1) / b) + 1;
}

!ozmd_convert_to_shares(assets: int, supply: int, total_assets: int) -> int {
  ?(total_assets == 0) { ^ 0; };
  ^ ozmd_floor(assets, supply, total_assets);
}

!ozmd_preview_mint(shares: int, supply: int, total_assets: int) -> int {
  ?(supply == 0) { ^ 0; };
  ^ ozmd_ceil(shares, total_assets, supply);
}

!ozmd_test_suite() -> int {
  ?(ozmd_floor(100, 200, 50) != 400) { ^ -1; };
  ?(ozmd_floor(7, 9, 2) != 31) { ^ -2; };
  ?(ozmd_rem(7, 9, 2) != 1) { ^ -3; };
  ?(ozmd_ceil(7, 9, 2) != 32) { ^ -4; };
  ?(ozmd_ceil(100, 200, 50) != 400) { ^ -5; };
  ?(ozmd_floor(1, 1, 2) != 0) { ^ -6; };
  ?(ozmd_ceil(1, 1, 2) != 1) { ^ -7; };
  ?(ozmd_rounds_up(0) != 0) { ^ -8; };
  ?(ozmd_rounds_up(1) != 1) { ^ -9; };
  ?(ozmd_rounds_up(2) != 0) { ^ -10; };
  ?(ozmd_rounds_up(3) != 1) { ^ -11; };
  ?(ozmd_muldiv(7, 9, 2, 0) != 31) { ^ -12; };
  ?(ozmd_muldiv(7, 9, 2, 1) != 32) { ^ -13; };
  ?(ozmd_muldiv(7, 9, 2, 2) != 31) { ^ -14; };
  ?(ozmd_muldiv(7, 9, 2, 3) != 32) { ^ -15; };
  ?(ozmd_floor(1000000000000000000, 1, 2) != 500000000000000000) { ^ -16; };
  ?(ozmd_floor(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -17; };
  ?(ozmd_ov(1000000000000000000, 1000000000000000000, 1) != 1) { ^ -18; };
  ?(ozmd_floor(7, 9, 0) != 0) { ^ -19; };
  ?(ozmd_ceil(7, 9, 0) != 0) { ^ -20; };
  ?(ozmd_muldiv(7, 9, 2, 4) != 0) { ^ -21; };
  ?(ozmd_floor(-1, 9, 2) != 0) { ^ -22; };
  ?(ozmd_ceil_div(7, 3) != 3) { ^ -23; };
  ?(ozmd_muldiv(7, 2, 3, 1) != 5) { ^ -24; };
  ?(ozmd_convert_to_shares(100, 50, 200) != 25) { ^ -25; };
  ?(ozmd_preview_mint(25, 50, 200) != 100) { ^ -26; };
  ?(ozmd_preview_mint(1, 3, 100) != 34) { ^ -27; };
  ?(ozmd_convert_to_shares(1, 3, 100) != 0) { ^ -28; };
  ^ 1;
}

=ex{
  ozmd_u_lt,
  ozmd_u_add_carry,
  ozmd_u_add_ok,
  ozmd_mask32,
  ozmd_ok_nn,
  ozmd_ok_round,
  ozmd_floor_mode,
  ozmd_ceil_mode,
  ozmd_trunc_mode,
  ozmd_expand_mode,
  ozmd_rounds_up,
  ozmd_muldiv_part,
  ozmd_floor,
  ozmd_rem,
  ozmd_ov,
  ozmd_ceil,
  ozmd_muldiv,
  ozmd_ceil_div,
  ozmd_convert_to_shares,
  ozmd_preview_mint,
  ozmd_test_suite
}
