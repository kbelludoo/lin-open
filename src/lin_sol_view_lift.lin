@LIN:L1c:0.2
@SOL_VIEW_LIFT{
  version=1
  purpose="lift Solidity view storage identifiers to explicit LIN arguments"
  class="EXPERIMENTAL"
  note="Does not rewrite (a*b)/d to 128-bit muldiv and does not claim uint256/cToken parity. JumpRate clone does muldiv separately."
}

!svl_is_type(nm: string): int {
  ?(starts_lit(nm, 0, "uint256") == 1 && nm.length == 7) { ^1 };
  ?(starts_lit(nm, 0, "uint128") == 1 && nm.length == 7) { ^1 };
  ?(starts_lit(nm, 0, "uint64") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "uint32") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "uint") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "int") == 1 && nm.length == 3) { ^1 };
  ?(starts_lit(nm, 0, "bool") == 1 && nm.length == 4) { ^1 };
  ^0;
}

!svl_is_kw(nm: string): int {
  ?(starts_lit(nm, 0, "function") == 1 && nm.length == 8) { ^1 };
  ?(starts_lit(nm, 0, "returns") == 1 && nm.length == 7) { ^1 };
  ?(starts_lit(nm, 0, "return") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "internal") == 1 && nm.length == 8) { ^1 };
  ?(starts_lit(nm, 0, "public") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "view") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "pure") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "if") == 1 && nm.length == 2) { ^1 };
  ?(starts_lit(nm, 0, "else") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "while") == 1 && nm.length == 5) { ^1 };
  ^0;
}

!svl_csv_has(csv: string, id: string): int {
  wrap = ",";
  wrap = wrap + csv;
  wrap = wrap + ",";
  needle = ",";
  needle = needle + id;
  needle = needle + ",";
  ?(rg_count_lit(wrap, needle) > 0) { ^1 };
  ^0;
}

!svl_param_names(params: string): string {
  known = "";
  n = params.length;
  i = 0;
  last = "";
  id = "";
  while (i < n) {
    id = read_ident(params, i);
    ?(id.length > 0) {
      ?(svl_is_type(id) == 0 && svl_is_kw(id) == 0) { last = id };
      i = i + id.length;
      continue;
    };
    ?(params.charCodeAt(i) == 44 || i + 1 >= n) {
      ?(last.length > 0) { known = rgs_csv_add(known, last); last = ""; };
    };
    i = i + 1;
  };
  ?(last.length > 0) { known = rgs_csv_add(known, last) };
  ^known;
}

!svl_free(params: string, body: string): string {
  known = svl_param_names(params);
  locals = "";
  extra = "";
  n = body.length;
  i = 0;
  j = 0;
  id = "";
  loc = "";
  while (i < n) {
    id = read_ident(body, i);
    ?(id.length > 0) {
      ?(svl_is_type(id) == 1) {
        j = skip_ws(body, i + id.length);
        loc = read_ident(body, j);
        ?(loc.length > 0) { locals = rgs_csv_add(locals, loc); i = j + loc.length; continue };
      };
      j = skip_ws(body, i + id.length);
      ?(j < n && body.charCodeAt(j) == 40) { i = i + id.length; continue };
      ?(svl_is_kw(id) == 0) {
        ?(svl_csv_has(known, id) == 0 && svl_csv_has(locals, id) == 0 && svl_csv_has(extra, id) == 0) {
          extra = rgs_csv_add(extra, id);
        };
      };
      i = i + id.length;
      continue;
    };
    i = i + 1;
  };
  ^extra;
}

!sol_view_lift_gate(): int {
  params = "uint cash, uint borrows, uint reserves";
  body = "uint util = utilizationRate(cash, borrows, reserves); if (util <= kink) { return ((util * multiplierPerBlock) / BASE) + baseRatePerBlock; }";
  extra = svl_free(params, body);
  ?(rg_count_lit(extra, "kink") == 0) { ^0 };
  ?(rg_count_lit(extra, "multiplierPerBlock") == 0) { ^0 };
  ?(rg_count_lit(extra, "baseRatePerBlock") == 0) { ^0 };
  ?(rg_count_lit(extra, "BASE") == 0) { ^0 };
  ?(rg_count_lit(extra, "utilizationRate") > 0) { ^0 };
  ?(rg_count_lit(extra, "util") > 0) { ^0 };
  ?(rg_count_lit(extra, "cash") > 0) { ^0 };
  ^1;
}

=ex{svl_param_names, svl_free, sol_view_lift_gate}
