@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=federation_engine_v250
~G{?=if #=for ^=ret :else}

!compute_federation_leaf_hash(bundle_id: int, repo_oid: int, arch_id: int, root_hash: int) -> int {
    leaf = (bundle_id * 104729) + (repo_oid * 65537) + (arch_id * 1009) + (root_hash * 31) + 42;
    ^leaf;
}

!verify_spec_migration_equivalence(v1_hash: int, v2_hash: int, is_declared_compatible: int) -> int {
    valid = 0;
    ?(is_declared_compatible == 1) {
        ?(v1_hash == v2_hash) {
            valid = 1;
        }
    }
    ^valid;
}

!evaluate_federation_closure(bundle_count: int, verified_count: int, migration_ok: int) -> int {
    status = 0;
    ?(bundle_count > 0) {
        ?(bundle_count == verified_count) {
            ?(migration_ok == 1) {
                status = 4000;
            }
        }
    }
    ^status;
}

=ex{compute_federation_leaf_hash, verify_spec_migration_equivalence, evaluate_federation_closure}
