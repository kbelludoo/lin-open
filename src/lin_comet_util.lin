@LIN:L1c:0.2
@COMET_GET_UTILIZATION{
  version=1
  repo="compound-finance/comet"
  source="contracts/CometWithExtendedAssetList.sol"
  license="GPL-2.0-or-later"
  license_note="Upstream BUSL-1.1 Change Date 2025-12-31 elapsed; Change License GPL-2.0-or-later. This run is 2026-10-12."
  commit="f766f51583c23acc33b2a7824654ef2029a96804"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_comet_getUtilization_present_value_wrap"
  note="Not mainnet uint256. Not presentValue/principalValue. Not accruedInterestIndices. Not a Comet / USDC market / PriceFeed. PV totals are arguments; (borrow_pv*FACTOR_SCALE)/supply_pv uses 128-bit product, fail-closed if quotient exceeds uint64. Empty supply fail-closes 0. Two-step floor(borrow/supply)*FACTOR is a named rejected path."
}

!c3u_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!c3u_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(c3u_u_lt(s, a));
}

!c3u_mask32() -> int {
  ^ 4294967295;
}

!c3u_factor_scale() -> int {
  ^ 1000000000000000000;
}

!c3u_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = c3u_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = c3u_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = c3u_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(c3u_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = c3u_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!c3u_muldiv(a: int, b: int, d: int) -> int {
  ^ c3u_muldiv_part(a, b, d, 0);
}

!c3u_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ c3u_muldiv_part(a, b, d, 1);
}

!c3u_util_ok(supply_pv: int, borrow_pv: int) -> int {
  ?(supply_pv <= 0) { ^ 0; };
  ?(borrow_pv < 0) { ^ 0; };
  ^ 1;
}

!c3u_utilization(supply_pv: int, borrow_pv: int) -> int {
  ?(c3u_util_ok(supply_pv, borrow_pv) == 0) { ^ 0; };
  ^ c3u_muldiv(borrow_pv, c3u_factor_scale(), supply_pv);
}

!c3u_twostep(supply_pv: int, borrow_pv: int) -> int {
  ?(c3u_util_ok(supply_pv, borrow_pv) == 0) { ^ 0; };
  ^ ((borrow_pv / supply_pv) * c3u_factor_scale());
}

!c3u_test_suite() -> int {
  ?(c3u_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(c3u_muldiv(7, 9, 1) != 63) { ^ -2; };
  ?(c3u_utilization(0, 100) != 0) { ^ -3; };
  ?(c3u_utilization(1000000000000000000, 1000000000000000000) != 1000000000000000000) { ^ -4; };
  ?(c3u_utilization(2000000000000000000, 1000000000000000000) != 500000000000000000) { ^ -5; };
  ?(c3u_utilization(1000000000000000000, 0) != 0) { ^ -6; };
  ?(c3u_twostep(2000000000000000000, 1000000000000000000) != 0) { ^ -7; };
  ?(c3u_utilization(2000000000000000000, 1000000000000000000) == c3u_twostep(2000000000000000000, 1000000000000000000)) { ^ -8; };
  ?(c3u_muldiv(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -9; };
  ?(c3u_util_ok(0, 1) != 0) { ^ -10; };
  ?(c3u_util_ok(1, 0) != 1) { ^ -11; };
  ?(c3u_utilization(1000000000000000000, 2000000000000000000) != 2000000000000000000) { ^ -12; };
  ?(c3u_muldiv_rem(7, 9, 2) != 1) { ^ -13; };
  ?(c3u_factor_scale() != 1000000000000000000) { ^ -14; };
  ^ 1;
}

=ex{
  c3u_u_lt,
  c3u_u_add_carry,
  c3u_mask32,
  c3u_factor_scale,
  c3u_muldiv_part,
  c3u_muldiv,
  c3u_muldiv_rem,
  c3u_util_ok,
  c3u_utilization,
  c3u_twostep,
  c3u_test_suite
}
