@LIN:L1c:0.2
@GMX_V2_FUNDING_APS{
  version=1
  repo="gmx-io/gmx-synthetics"
  source="contracts/market/MarketUtils.sol getNextFundingAmountPerSize"
  delta="contracts/market/MarketUtils.sol getFundingAmountPerSizeDelta"
  divisor="contracts/market/MarketUtils.sol getPoolDivisor"
  precision="contracts/utils/Precision.sol applyFactor FLOAT_PRECISION_SQRT"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_gmx_v2_funding_usd_per_size_vs_v1_interval_rate"
  note="Not mainnet uint256. Not FLOAT=1e30. FLOAT prime=1e6, SQRT prime=1e3, STORE prime=1e9. DataStore duration and fps are arguments. Zero OI on either side yields 0. Single-token divisor=2. Distinct from V1 getNextFundingRate (factor*reserved*intervals/pool)."
}

!g2f_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!g2f_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(g2f_u_lt(s, a));
}

!g2f_mask32() -> int {
  ^ 4294967295;
}

!g2f_float() -> int {
  ^ 1000000;
}

!g2f_sqrt() -> int {
  ^ 1000;
}

!g2f_store() -> int {
  ^ 1000000000;
}

!g2f_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  m32 = g2f_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = g2f_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = g2f_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(g2f_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = g2f_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!g2f_muldiv(a: int, b: int, d: int) -> int {
  ^ g2f_muldiv_part(a, b, d, 0);
}

!g2f_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ g2f_muldiv_part(a, b, d, 1);
}

!g2f_muldiv_up(a: int, b: int, d: int) -> int {
  q = g2f_muldiv(a, b, d);
  r = g2f_muldiv_rem(a, b, d);
  ?(r == 0) { ^ q; };
  s = q + 1;
  ?(g2f_u_lt(s, q) == 1) { ^ 0; };
  ^ s;
}

!g2f_div_up(a: int, b: int) -> int {
  ?(b == 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  q = a / b;
  ?(a == (q * b)) { ^ q; };
  s = q + 1;
  ?(g2f_u_lt(s, q) == 1) { ^ 0; };
  ^ s;
}

!g2f_divisor(same_token: int) -> int {
  ?(same_token == 1) { ^ 2; };
  ^ 1;
}

!g2f_paying(long_oi: int, short_oi: int, longs_pay: int) -> int {
  ?(longs_pay == 0) { ^ short_oi; };
  ^ long_oi;
}

!g2f_funding(long_oi: int, short_oi: int, longs_pay: int, duration: int, fps: int, same_token: int) -> int {
  ?(long_oi <= 0) { ^ 0; };
  ?(short_oi <= 0) { ^ 0; };
  size = g2f_paying(long_oi, short_oi, longs_pay);
  rate = g2f_muldiv(duration, fps, 1);
  raw = g2f_muldiv(size, rate, g2f_float());
  ^ g2f_muldiv(raw, 1, g2f_divisor(same_token));
}

!g2f_wrong_zero(long_oi: int, short_oi: int, longs_pay: int, duration: int, fps: int, same_token: int) -> int {
  size = g2f_paying(long_oi, short_oi, longs_pay);
  ?(size <= 0) { ^ 0; };
  rate = g2f_muldiv(duration, fps, 1);
  raw = g2f_muldiv(size, rate, g2f_float());
  ^ g2f_muldiv(raw, 1, g2f_divisor(same_token));
}

!g2f_wrong_nofps(long_oi: int, short_oi: int, longs_pay: int, duration: int, fps: int, same_token: int) -> int {
  ?(long_oi <= 0) { ^ 0; };
  ?(short_oi <= 0) { ^ 0; };
  size = g2f_paying(long_oi, short_oi, longs_pay);
  raw = g2f_muldiv(size, duration, g2f_float());
  ^ g2f_muldiv(raw, 1, g2f_divisor(same_token));
}

!g2f_wrong_nodiv(long_oi: int, short_oi: int, longs_pay: int, duration: int, fps: int, same_token: int) -> int {
  ?(long_oi <= 0) { ^ 0; };
  ?(short_oi <= 0) { ^ 0; };
  size = g2f_paying(long_oi, short_oi, longs_pay);
  rate = g2f_muldiv(duration, fps, 1);
  ^ g2f_muldiv(size, rate, g2f_float());
}

!g2f_split(funding: int, col_oi: int, total_oi: int) -> int {
  ?(total_oi == 0) { ^ 0; };
  ?(funding < 0) { ^ 0; };
  ?(col_oi < 0) { ^ 0; };
  ^ g2f_muldiv(funding, col_oi, total_oi);
}

!g2f_aps(funding: int, oi: int, price: int, round_up: int) -> int {
  ?(funding == 0) { ^ 0; };
  ?(oi == 0) { ^ 0; };
  ?(price <= 0) { ^ 0; };
  ?(round_up == 1) {
    fpsz = g2f_muldiv_up(funding, g2f_store(), oi);
    ^ g2f_div_up(fpsz, price);
  };
  fpsz = g2f_muldiv(funding, g2f_store(), oi);
  ^ fpsz / price;
}

!g2f_naive_i64(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ^ (a * b) / d;
}

!g2f_test_suite() -> int {
  ?(g2f_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(g2f_muldiv_rem(7, 9, 2) != 1) { ^ -2; };
  ?(g2f_float() != 1000000) { ^ -3; };
  ?(g2f_store() != 1000000000) { ^ -4; };
  ?(g2f_divisor(1) != 2) { ^ -5; };
  ?(g2f_divisor(0) != 1) { ^ -6; };
  ?(g2f_funding(200000000, 100000000, 1, 4000, 10, 0) != 8000000) { ^ -7; };
  ?(g2f_funding(200000000, 100000000, 1, 4000, 10, 1) != 4000000) { ^ -8; };
  ?(g2f_wrong_nodiv(200000000, 100000000, 1, 4000, 10, 1) != 8000000) { ^ -9; };
  ?(g2f_funding(0, 100000000, 0, 4000, 10, 0) != 0) { ^ -10; };
  ?(g2f_wrong_zero(0, 100000000, 0, 4000, 10, 0) != 4000000) { ^ -11; };
  ?(g2f_funding(200000000, 100000000, 0, 4000, 10, 0) != 4000000) { ^ -12; };
  ?(g2f_wrong_nofps(200000000, 100000000, 1, 4000, 10, 0) != 800000) { ^ -13; };
  ?(g2f_split(500, 1000, 5000) != 100) { ^ -14; };
  ?(g2f_split(500, 4000, 5000) != 400) { ^ -15; };
  ?(g2f_aps(100, 10000, 2000, 1) != 5000) { ^ -16; };
  ?(g2f_aps(100, 5000, 2000, 0) != 10000) { ^ -17; };
  ?(g2f_aps(1, 3, 2, 0) != 166666666) { ^ -18; };
  ?(g2f_aps(1, 3, 2, 1) != 166666667) { ^ -19; };
  ?(g2f_aps(0, 10000, 2000, 1) != 0) { ^ -20; };
  ?(g2f_muldiv(7000000000, 2000000000, 1000000) != 14000000000000) { ^ -21; };
  ?(g2f_naive_i64(7000000000, 2000000000, 1000000) == 14000000000000) { ^ -22; };
  ^ 1;
}

=ex{
  g2f_u_lt,
  g2f_u_add_carry,
  g2f_mask32,
  g2f_float,
  g2f_sqrt,
  g2f_store,
  g2f_muldiv_part,
  g2f_muldiv,
  g2f_muldiv_rem,
  g2f_muldiv_up,
  g2f_div_up,
  g2f_divisor,
  g2f_paying,
  g2f_funding,
  g2f_wrong_zero,
  g2f_wrong_nofps,
  g2f_wrong_nodiv,
  g2f_split,
  g2f_aps,
  g2f_naive_i64,
  g2f_test_suite
}
