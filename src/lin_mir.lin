@LIN:L1c:0.2
@RULEL:LIN_MIR_SPEC:1.0.0

// MIR Opcode Constants
// 1: CONST, 2: MOV, 3: ADD, 4: SUB, 5: MUL, 6: AND, 7: OR, 8: XOR, 9: SHL, 10: USHR, 11: SHR, 12: JMP, 13: JZ, 14: JNZ, 15: CALL, 16: RET

!mir_op_name(op: int): string {
  ?(op == 1){ ^"CONST" };
  ?(op == 2){ ^"MOV" };
  ?(op == 3){ ^"ADD" };
  ?(op == 4){ ^"SUB" };
  ?(op == 5){ ^"MUL" };
  ?(op == 6){ ^"AND" };
  ?(op == 7){ ^"OR" };
  ?(op == 8){ ^"XOR" };
  ?(op == 9){ ^"SHL" };
  ?(op == 10){ ^"USHR" };
  ?(op == 11){ ^"SHR" };
  ?(op == 12){ ^"JMP" };
  ?(op == 13){ ^"JZ" };
  ?(op == 14){ ^"JNZ" };
  ?(op == 15){ ^"CALL" };
  ?(op == 16){ ^"RET" };
  ^"UNKNOWN";
}

!mir_eval_op(op: int, a: int, b: int): int {
  ?(op == 3){ ^(a + b) };
  ?(op == 4){ ^(a - b) };
  ?(op == 5){ ^(a * b) };
  ?(op == 6){ ^(a & b) };
  ?(op == 7){ ^(a | b) };
  ?(op == 8){ ^(a ^ b) };
  ?(op == 9){ ^(_lia_shl(a, b & 63)) };
  ?(op == 10){ ^(_lia_ushr(a, b & 63)) };
  ?(op == 11){ ^(_lia_shr(a, b & 63)) };
  ^0;
}

!test_mir_eval(): int {
  r_add = mir_eval_op(3, 10, 20);
  r_xor = mir_eval_op(8, 255, 15);
  r_ushr = mir_eval_op(10, 16, 2);

  ?(r_add != 30){ ^0 };
  ?(r_xor != 240){ ^0 };
  ?(r_ushr != 4){ ^0 };
  ^1;
}

=ex{mir_op_name, mir_eval_op, test_mir_eval}
