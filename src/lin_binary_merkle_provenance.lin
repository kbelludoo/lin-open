@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=binary_merkle_provenance
~G{?=if #=for ^=ret :else}

!compute_merkle_leaf_hash(tag_id: int, content_hash: int) -> int {
    leaf = (tag_id * 104729) + (content_hash * 31) + 17;
    ^leaf;
}

!compute_merkle_parent_node(left_child: int, right_child: int) -> int {
    parent = (left_child * 65537) + (right_child * 1009) + 42;
    ^parent;
}

!verify_merkle_tree_root(h01: int, h23: int, expected_root: int) -> int {
    root = (h01 * 65537) + (h23 * 1009) + 42;
    valid = 0;
    ?(root == expected_root) {
        valid = 1;
    }
    ^valid;
}

!validate_hardware_fingerprint(vendor_id: int, device_id: int, compute_units: int) -> int {
    fp = (vendor_id * 1000000) + (device_id * 1000) + compute_units;
    ^fp;
}

=ex{compute_merkle_leaf_hash, compute_merkle_parent_node, verify_merkle_tree_root, validate_hardware_fingerprint}
