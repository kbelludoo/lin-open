@LIN:L1c:0.2
@LIDO_STETH_SHARE_RATE{
  version=1
  repo="lidofinance/lido-dao"
  source="contracts/0.4.24/StETH.sol"
  math="contracts/common/lib/Math256.sol"
  license="GPL-3.0"
  math_license="MIT"
  tag="v4.1.0"
  commit="1440c830eb1d0916a436468a71cd73bc8b8deffb"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_lido_share_rate_with_128bit_muldiv"
  note="Not Solidity uint256. Lido view converters have no virtual offset: shares=eth*totalShares/totalEther. Empty numerator is on-chain div0; LIN fail-closes to 0. ceilDiv is remainder+1, not (a+b-1)/b wrap. Hidden _getShareRate* getters are arguments. Named contrast vs Morpho VIRTUAL_SHARES=1e6 and OZ ERC-4626 +1/+1."
}

!lds_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!lds_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(lds_u_lt(s, a));
}

!lds_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(lds_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!lds_mask32() -> int {
  ^ 4294967295;
}

!lds_ok_nn(v: int) -> int {
  ?(v < 0) { ^ 0; };
  ^ 1;
}

!lds_morpho_virt_shares() -> int {
  ^ 1000000;
}

!lds_morpho_virt_assets() -> int {
  ^ 1;
}

!lds_oz_virt_shares() -> int {
  ^ 1;
}

!lds_oz_virt_assets() -> int {
  ^ 1;
}

!lds_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = lds_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = lds_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = lds_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(lds_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = lds_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want == 1) { ^ r_lo; };
  ?(want == 2) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!lds_floor(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(lds_ok_nn(x) == 0) { ^ 0; };
  ?(lds_ok_nn(y) == 0) { ^ 0; };
  ^ lds_muldiv_part(x, y, d, 0);
}

!lds_rem(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(lds_ok_nn(x) == 0) { ^ 0; };
  ?(lds_ok_nn(y) == 0) { ^ 0; };
  ^ lds_muldiv_part(x, y, d, 1);
}

!lds_ov(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 1; };
  ?(lds_ok_nn(x) == 0) { ^ 1; };
  ?(lds_ok_nn(y) == 0) { ^ 1; };
  ^ lds_muldiv_part(x, y, d, 2);
}

!lds_ceil(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(lds_ok_nn(x) == 0) { ^ 0; };
  ?(lds_ok_nn(y) == 0) { ^ 0; };
  ?(lds_muldiv_part(x, y, d, 2) == 1) { ^ 0; };
  q = lds_muldiv_part(x, y, d, 0);
  r = lds_muldiv_part(x, y, d, 1);
  ?(r == 0) { ^ q; };
  ?(lds_u_add_ok(q, 1) == 0) { ^ 0; };
  ^ q + 1;
}

!lds_shares_by_eth(eth: int, total_ether: int, total_shares: int) -> int {
  ?(lds_ok_nn(eth) == 0) { ^ 0; };
  ?(lds_ok_nn(total_shares) == 0) { ^ 0; };
  ?(total_ether <= 0) { ^ 0; };
  ^ lds_floor(eth, total_shares, total_ether);
}

!lds_eth_by_shares(shares: int, total_ether: int, total_shares: int) -> int {
  ?(lds_ok_nn(shares) == 0) { ^ 0; };
  ?(lds_ok_nn(total_ether) == 0) { ^ 0; };
  ?(total_shares <= 0) { ^ 0; };
  ^ lds_floor(shares, total_ether, total_shares);
}

!lds_eth_by_shares_up(shares: int, total_ether: int, total_shares: int) -> int {
  ?(lds_ok_nn(shares) == 0) { ^ 0; };
  ?(lds_ok_nn(total_ether) == 0) { ^ 0; };
  ?(total_shares <= 0) { ^ 0; };
  ^ lds_ceil(shares, total_ether, total_shares);
}

!lds_oz_shares_by_eth(eth: int, total_ether: int, total_shares: int) -> int {
  ?(lds_ok_nn(eth) == 0) { ^ 0; };
  ?(lds_ok_nn(total_ether) == 0) { ^ 0; };
  ?(lds_ok_nn(total_shares) == 0) { ^ 0; };
  ?(lds_u_add_ok(total_ether, lds_oz_virt_assets()) == 0) { ^ 0; };
  ?(lds_u_add_ok(total_shares, lds_oz_virt_shares()) == 0) { ^ 0; };
  ^ lds_floor(eth, total_shares + lds_oz_virt_shares(), total_ether + lds_oz_virt_assets());
}

!lds_morpho_shares_by_eth(eth: int, total_ether: int, total_shares: int) -> int {
  ?(lds_ok_nn(eth) == 0) { ^ 0; };
  ?(lds_ok_nn(total_ether) == 0) { ^ 0; };
  ?(lds_ok_nn(total_shares) == 0) { ^ 0; };
  ?(lds_u_add_ok(total_ether, lds_morpho_virt_assets()) == 0) { ^ 0; };
  ?(lds_u_add_ok(total_shares, lds_morpho_virt_shares()) == 0) { ^ 0; };
  ^ lds_floor(eth, total_shares + lds_morpho_virt_shares(), total_ether + lds_morpho_virt_assets());
}

!lds_test_suite() -> int {
  ?(lds_floor(100, 200, 50) != 400) { ^ -1; };
  ?(lds_floor(7, 9, 2) != 31) { ^ -2; };
  ?(lds_rem(7, 9, 2) != 1) { ^ -3; };
  ?(lds_ceil(7, 9, 2) != 32) { ^ -4; };
  ?(lds_floor(1000000000000000000, 1, 2) != 500000000000000000) { ^ -5; };
  ?(lds_floor(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -6; };
  ?(lds_ov(1000000000000000000, 1000000000000000000, 1) != 1) { ^ -7; };
  ?(lds_shares_by_eth(1000, 0, 0) != 0) { ^ -8; };
  ?(lds_eth_by_shares(1000, 0, 0) != 0) { ^ -9; };
  ?(lds_oz_shares_by_eth(1000, 0, 0) != 1000) { ^ -10; };
  ?(lds_morpho_shares_by_eth(1000, 0, 0) != 1000000000) { ^ -11; };
  ?(lds_shares_by_eth(1000000, 1000001, 1) != 0) { ^ -12; };
  ?(lds_oz_shares_by_eth(1000000, 1000001, 1) != 1) { ^ -13; };
  ?(lds_morpho_shares_by_eth(1000000, 1000001, 1000000) != 1999996) { ^ -14; };
  ?(lds_shares_by_eth(1000, 5000, 2000) != 400) { ^ -15; };
  ?(lds_eth_by_shares(400, 5000, 2000) != 1000) { ^ -16; };
  ?(lds_eth_by_shares(1, 3, 100) != 0) { ^ -17; };
  ?(lds_eth_by_shares_up(1, 3, 100) != 1) { ^ -18; };
  ?(lds_shares_by_eth(lds_eth_by_shares_up(1, 3, 2), 3, 2) != 1) { ^ -19; };
  ?(lds_shares_by_eth(-1, 5, 5) != 0) { ^ -20; };
  ?(lds_floor(7, 9, 0) != 0) { ^ -21; };
  ?(lds_ceil(7, 9, 0) != 0) { ^ -22; };
  ^ 1;
}

=ex{
  lds_u_lt,
  lds_u_add_carry,
  lds_u_add_ok,
  lds_mask32,
  lds_ok_nn,
  lds_morpho_virt_shares,
  lds_morpho_virt_assets,
  lds_oz_virt_shares,
  lds_oz_virt_assets,
  lds_muldiv_part,
  lds_floor,
  lds_rem,
  lds_ov,
  lds_ceil,
  lds_shares_by_eth,
  lds_eth_by_shares,
  lds_eth_by_shares_up,
  lds_oz_shares_by_eth,
  lds_morpho_shares_by_eth,
  lds_test_suite
}
