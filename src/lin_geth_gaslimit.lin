@LIN:L1c:0.2
@GETH_CALCGASLIMIT{
  version=1
  repo="ethereum/go-ethereum"
  tag="v1.14.12"
  commit="293a300d64be3d9a1c2cc92c26fcff4089deadcd"
  source="core/block_validator.go CalcGasLimit + consensus/misc/gaslimit.go VerifyGaslimit"
  license="LGPL-3.0"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="explicit_args_ethereum_block_gas_limit_adjust_and_verify"
  note="Not a Geth node. params.GasLimitBoundDivisor/MinGasLimit become arguments. Geth uint64 (parent/div)-1 wrap and int64 header-diff casts fail-closed. Domain is Geth MaxGasLimit=2^63-1, which fits LIN i64."
}

!gl_divisor() -> int {
  ^ 1024;
}

!gl_min() -> int {
  ^ 5000;
}

!gl_max() -> int {
  ^ 9223372036854775807;
}

!gl_neg(x: int) -> int {
  ?(x < 0) { ^ 1; };
  ^ 0;
}

!gl_abs_diff(a: int, b: int) -> int {
  ?(a >= b) { ^ a - b; };
  ^ b - a;
}

!gl_add_ok(a: int, b: int) -> int {
  ?(gl_neg(a) == 1) { ^ 0; };
  ?(gl_neg(b) == 1) { ^ 0; };
  s = a + b;
  ?(s < a) { ^ 0; };
  ^ 1;
}

!gl_delta(parent: int, divisor: int) -> int {
  ?(divisor <= 0) { ^ 0; };
  ?(gl_neg(parent) == 1) { ^ 0; };
  q = parent / divisor;
  ?(q == 0) { ^ 0; };
  ^ q - 1;
}

!gl_delta_ok(parent: int, divisor: int) -> int {
  ?(divisor <= 0) { ^ 0; };
  ?(gl_neg(parent) == 1) { ^ 0; };
  q = parent / divisor;
  ?(q == 0) { ^ 0; };
  ^ 1;
}

!gl_calc_ok(parent: int, desired: int, divisor: int, min_limit: int) -> int {
  ?(gl_neg(parent) == 1) { ^ 0; };
  ?(gl_neg(desired) == 1) { ^ 0; };
  ?(gl_neg(min_limit) == 1) { ^ 0; };
  ?(gl_delta_ok(parent, divisor) == 0) { ^ 0; };
  delta = gl_delta(parent, divisor);
  ?(gl_add_ok(parent, delta) == 0) { ^ 0; };
  ^ 1;
}

!gl_calc(parent: int, desired: int, divisor: int, min_limit: int) -> int {
  ?(gl_calc_ok(parent, desired, divisor, min_limit) == 0) { ^ 0; };
  d = desired;
  ?(d < min_limit) { d = min_limit; };
  delta = gl_delta(parent, divisor);
  ?(parent < d) {
    limit = parent + delta;
    ?(limit > d) { ^ d; };
    ^ limit;
  };
  ?(parent > d) {
    limit = parent - delta;
    ?(limit < d) { ^ d; };
    ^ limit;
  };
  ^ parent;
}

!gl_verify(parent: int, header: int, divisor: int, min_limit: int) -> int {
  ?(gl_neg(parent) == 1) { ^ 0; };
  ?(gl_neg(header) == 1) { ^ 0; };
  ?(divisor <= 0) { ^ 0; };
  ?(header < min_limit) { ^ 0; };
  bound = parent / divisor;
  diff = gl_abs_diff(parent, header);
  ?(diff >= bound) { ^ 0; };
  ^ 1;
}

!gl_calc_default(parent: int, desired: int) -> int {
  ^ gl_calc(parent, desired, gl_divisor(), gl_min());
}

!gl_verify_default(parent: int, header: int) -> int {
  ^ gl_verify(parent, header, gl_divisor(), gl_min());
}

!gl_test_suite() -> int {
  ?(gl_delta(20000000, 1024) != 19530) { ^ 0; };
  ?(gl_delta(40000000, 1024) != 39061) { ^ 0; };
  ?(gl_calc_default(20000000, 40000000) != 20019530) { ^ 0; };
  ?(gl_calc_default(20000000, 0) != 19980470) { ^ 0; };
  ?(gl_calc_default(20000000, 19999999) != 19999999) { ^ 0; };
  ?(gl_calc_default(20000000, 20000001) != 20000001) { ^ 0; };
  ?(gl_calc_default(20000000, 20000000) != 20000000) { ^ 0; };
  ?(gl_calc_default(40000000, 80000000) != 40039061) { ^ 0; };
  ?(gl_calc_default(40000000, 0) != 39960939) { ^ 0; };
  ?(gl_calc_default(40000000, 39999999) != 39999999) { ^ 0; };
  ?(gl_calc_default(40000000, 40000001) != 40000001) { ^ 0; };
  ?(gl_verify_default(20000000, 20019530) != 1) { ^ 0; };
  ?(gl_verify_default(20000000, 19980470) != 1) { ^ 0; };
  ?(gl_verify_default(20000000, 20019531) != 0) { ^ 0; };
  ?(gl_verify_default(20000000, 4999) != 0) { ^ 0; };
  ?(gl_calc_ok(500, 5000, 1024, 5000) != 0) { ^ 0; };
  ?(gl_calc(500, 5000, 1024, 5000) != 0) { ^ 0; };
  ?(gl_verify(-1, 5000, 1024, 5000) != 0) { ^ 0; };
  ?(gl_delta_ok(1023, 1024) != 0) { ^ 0; };
  ?(gl_delta_ok(1024, 1024) != 1) { ^ 0; };
  ^ 1;
}

=ex{
  gl_divisor,
  gl_min,
  gl_max,
  gl_neg,
  gl_abs_diff,
  gl_add_ok,
  gl_delta,
  gl_delta_ok,
  gl_calc_ok,
  gl_calc,
  gl_verify,
  gl_calc_default,
  gl_verify_default,
  gl_test_suite
}
