@LIN:L1c:0.2
@AAVE_LIQ_AVAILABLE_COLLATERAL{
  version=1
  repo="aave/aave-v3-core"
  source="contracts/protocol/libraries/logic/LiquidationLogic.sol _calculateAvailableCollateralToLiquidate/_calculateDebt + PercentageMath percentMul/percentDiv"
  license="MIT_after_BUSL_Change_Date_2023-01-27"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_aave_v3_liquidation_available_collateral_128bit"
  note="Not mainnet uint256/WAD=1e18/oracle/aToken. WAD'=1e9, PERCENTAGE_FACTOR=1e4 (same bps). Oracle prices, decimals, bonus and protocol fee are arguments (not storage / getAssetPrice). percentMul uses 128-bit half-up. Zero price/unit fail-closes. Upstream Solidity is hash-pinned, not vendored."
}

!aliq_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!aliq_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(aliq_u_lt(s, a));
}

!aliq_mask32() -> int {
  ^ 4294967295;
}

!aliq_pct() -> int {
  ^ 10000;
}

!aliq_half_pct() -> int {
  ^ 5000;
}

!aliq_hf_thr() -> int {
  ^ 950000000;
}

!aliq_default_close() -> int {
  ^ 5000;
}

!aliq_max_close() -> int {
  ^ 10000;
}

!aliq_hf18() -> int {
  ^ 950000000000000000;
}

!aliq_hf18_fits() -> int {
  ^ 1;
}

!aliq_half_ray27_fits() -> int {
  ^ 0;
}

!aliq_muldiv_add_part(a: int, b: int, add: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = aliq_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = aliq_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = aliq_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + aliq_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(aliq_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = aliq_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!aliq_muldiv(a: int, b: int, d: int) -> int {
  ^ aliq_muldiv_add_part(a, b, 0, d, 0);
}

!aliq_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ aliq_muldiv_add_part(a, b, 0, d, 1);
}

!aliq_percent_mul(v: int, p: int) -> int {
  ?(p == 0) { ^ 0; };
  ?(v == 0) { ^ 0; };
  ^ aliq_muldiv_add_part(v, p, aliq_half_pct(), aliq_pct(), 0);
}

!aliq_wrong_floor_percent_mul(v: int, p: int) -> int {
  ?(p == 0) { ^ 0; };
  ^ aliq_muldiv_add_part(v, p, 0, aliq_pct(), 0);
}

!aliq_percent_div(v: int, p: int) -> int {
  ?(p == 0) { ^ 0; };
  half = p / 2;
  ^ aliq_muldiv_add_part(v, aliq_pct(), half, p, 0);
}

!aliq_wrong_floor_percent_div(v: int, p: int) -> int {
  ?(p == 0) { ^ 0; };
  ^ aliq_muldiv_add_part(v, aliq_pct(), 0, p, 0);
}

!aliq_mul3div1(a: int, b: int, c: int, den: int) -> int {
  ?(den == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(c < 0) { ^ 0; };
  ov = aliq_muldiv_add_part(a, b, 0, den, 2);
  ?(ov == 1) { ^ 0; };
  q_ab = aliq_muldiv_add_part(a, b, 0, den, 0);
  r_ab = aliq_muldiv_add_part(a, b, 0, den, 1);
  qc = aliq_muldiv_add_part(q_ab, c, 0, 1, 0);
  ?(q_ab != 0) {
    ?(c != 0) {
      ?(qc == 0) { ^ 0; };
    };
  };
  extra = aliq_muldiv_add_part(r_ab, c, 0, den, 0);
  s = qc + extra;
  ?(aliq_u_lt(s, qc) == 1) { ^ 0; };
  ?(s < 0) { ^ 0; };
  ^ s;
}

!aliq_base_collateral(dp: int, debt: int, cu: int, cp: int, du: int) -> int {
  ?(dp <= 0) { ^ 0; };
  ?(debt < 0) { ^ 0; };
  ?(cu <= 0) { ^ 0; };
  ?(cp <= 0) { ^ 0; };
  ?(du <= 0) { ^ 0; };
  den = cp * du;
  ?(den / cp != du) { ^ 0; };
  ?(den <= 0) { ^ 0; };
  ^ aliq_mul3div1(dp, debt, cu, den);
}

!aliq_avail(dp: int, debt: int, cu: int, cp: int, du: int, user_bal: int, bonus: int, fee_pct: int, want: int) -> int {
  ?(bonus <= 0) { ^ 0; };
  ?(user_bal < 0) { ^ 0; };
  ?(fee_pct < 0) { ^ 0; };
  base = aliq_base_collateral(dp, debt, cu, cp, du);
  maxc = aliq_percent_mul(base, bonus);
  coll = maxc;
  dneed = debt;
  ?(aliq_u_lt(user_bal, maxc) == 1) {
    coll = user_bal;
    t = aliq_mul3div1(cp, coll, du, dp);
    dneed = aliq_percent_div(aliq_muldiv(t, 1, cu), bonus);
  };
  fee = 0;
  ?(fee_pct != 0) {
    unbonus = aliq_percent_div(coll, bonus);
    ?(aliq_u_lt(coll, unbonus) == 1) { ^ 0; };
    bonus_coll = coll - unbonus;
    fee = aliq_percent_mul(bonus_coll, fee_pct);
    ?(aliq_u_lt(coll, fee) == 1) { ^ 0; };
    coll = coll - fee;
  };
  ?(want == 1) { ^ dneed; };
  ?(want == 2) { ^ fee; };
  ^ coll;
}

!aliq_close_factor(hf: int) -> int {
  ?(hf > aliq_hf_thr()) { ^ aliq_default_close(); };
  ^ aliq_max_close();
}

!aliq_close_debt(total: int, cover: int, hf: int) -> int {
  ?(total < 0) { ^ 0; };
  ?(cover < 0) { ^ 0; };
  maxd = aliq_percent_mul(total, aliq_close_factor(hf));
  ?(aliq_u_lt(maxd, cover) == 1) { ^ maxd; };
  ^ cover;
}

!aliq_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!aliq_test_suite() -> int {
  e9 = 1000000000;
  ?(aliq_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(aliq_percent_mul(1, 5000) != 1) { ^ -2; };
  ?(aliq_wrong_floor_percent_mul(1, 5000) != 0) { ^ -3; };
  ?(aliq_percent_div(2, 3) != 6667) { ^ -4; };
  ?(aliq_wrong_floor_percent_div(2, 3) != 6666) { ^ -5; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 10000000000, 10500, 0, 0) != 1050000000) { ^ -6; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 10000000000, 10500, 0, 1) != e9) { ^ -7; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 10000000000, 10500, 1000, 0) != 1045000000) { ^ -8; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 10000000000, 10500, 1000, 2) != 5000000) { ^ -9; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 500000000, 10500, 0, 0) != 500000000) { ^ -10; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 500000000, 10500, 0, 1) != 476190476) { ^ -11; };
  ?(aliq_avail(1000, e9, e9, 0, e9, 10000000000, 10500, 0, 0) != 0) { ^ -12; };
  ?(aliq_avail(1000, e9, e9, 2000, e9, 10000000000, 10500, 0, 0) != 525000000) { ^ -13; };
  ?(aliq_avail(1000, e9, e9, 1000, e9, 10000000000, 10000, 0, 0) != e9) { ^ -14; };
  ?(aliq_close_factor(960000000) != 5000) { ^ -15; };
  ?(aliq_close_factor(950000000) != 10000) { ^ -16; };
  ?(aliq_close_debt(e9, e9, 960000000) != 500000000) { ^ -17; };
  ?(aliq_close_debt(e9, e9, 900000000) != e9) { ^ -18; };
  ?(aliq_naive_i64_mul(1000000000000000, 10500) != 0 - 7946744073709551616) { ^ -19; };
  ?(aliq_percent_mul(1000000000000000, 10500) != 1050000000000000) { ^ -20; };
  ?(aliq_hf18_fits() != 1) { ^ -21; };
  ?(aliq_half_ray27_fits() != 0) { ^ -22; };
  ?(aliq_hf18() != 950000000000000000) { ^ -23; };
  ?(aliq_percent_mul(0, 10500) != 0) { ^ -24; };
  ^ 1;
}

=ex{
  aliq_u_lt,
  aliq_u_add_carry,
  aliq_mask32,
  aliq_pct,
  aliq_half_pct,
  aliq_hf_thr,
  aliq_default_close,
  aliq_max_close,
  aliq_hf18,
  aliq_hf18_fits,
  aliq_half_ray27_fits,
  aliq_muldiv_add_part,
  aliq_muldiv,
  aliq_muldiv_rem,
  aliq_percent_mul,
  aliq_wrong_floor_percent_mul,
  aliq_percent_div,
  aliq_wrong_floor_percent_div,
  aliq_mul3div1,
  aliq_base_collateral,
  aliq_avail,
  aliq_close_factor,
  aliq_close_debt,
  aliq_naive_i64_mul,
  aliq_test_suite
}
