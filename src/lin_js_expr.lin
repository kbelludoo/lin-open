@LIN:L1c:0.2
@LIN_JS_EXPR{version=1 purpose=lower_js_expressions_to_lin_preserving_int32_semantics}

!jsx_has(set: string, ch: int): int {
  k = 0;
  while (k < set.length) {
    ?(set.charCodeAt(k) == ch){ ^1 };
    k = k + 1;
  };
  ^0;
}

!jsx_prev_value(s: string, i: int): int {
  k = i - 1;
  while (k >= 0 && (s.charCodeAt(k) == 32 || s.charCodeAt(k) == 9 || s.charCodeAt(k) == 10)){ k = k - 1 };
  ?(k < 0){ ^0 };
  c = s.charCodeAt(k);
  ?(c == 41){ ^1 };
  ?(c == 93){ ^1 };
  ?(c >= 48 && c <= 57){ ^1 };
  ?(is_ident(c) == true){ ^1 };
  ^0;
}

!jsx_scan(s: string, op: string, follow: string, bin: int, want_first: int): int {
  n = s.length;
  m = op.length;
  i = 0;
  d = 0;
  c = 0;
  best = -1;
  ok = 0;
  while (i < n) {
    c = s.charCodeAt(i);
    ?(c == 34 || c == 39){
      i = i + 1;
      while (i < n && s.charCodeAt(i) != c){ i = i + 1 };
      i = i + 1;
      continue;
    };
    ?(c == 40 || c == 91){ d = d + 1; i = i + 1; continue };
    ?(c == 41 || c == 93){ d = d - 1; i = i + 1; continue };
    ?(d == 0 && starts_lit(s, i, op) == 1){
      ok = 1;
      ?(i > 0 && s.charCodeAt(i - 1) == op.charCodeAt(0)){ ok = 0 };
      ?(i + m < n && jsx_has(follow, s.charCodeAt(i + m)) == 1){ ok = 0 };
      ?(bin == 1 && jsx_prev_value(s, i) == 0){ ok = 0 };
      ?(ok == 1){
        ?(want_first == 1){ ^i };
        best = i;
      };
    };
    i = i + 1;
  };
  ^best;
}

!jsx_colon(s: string, pq: int): int {
  n = s.length;
  i = pq + 1;
  d = 0;
  t = 0;
  c = 0;
  while (i < n) {
    c = s.charCodeAt(i);
    ?(c == 40 || c == 91){ d = d + 1; i = i + 1; continue };
    ?(c == 41 || c == 93){ d = d - 1; i = i + 1; continue };
    ?(d == 0 && c == 63){ t = t + 1 };
    ?(d == 0 && c == 58){
      ?(t == 0){ ^i };
      t = t - 1;
    };
    i = i + 1;
  };
  ^-1;
}

!jss_trim(s: string): string {
  a = 0;
  b = s.length;
  while (a < b && (s.charCodeAt(a) == 32 || s.charCodeAt(a) == 9 || s.charCodeAt(a) == 10 || s.charCodeAt(a) == 13)){ a = a + 1 };
  while (b > a && (s.charCodeAt(b - 1) == 32 || s.charCodeAt(b - 1) == 9 || s.charCodeAt(b - 1) == 10 || s.charCodeAt(b - 1) == 13)){ b = b - 1 };
  ^slice2(s, a, b);
}

!jss_bin(fname: string, a: string, b: string): string {
  out = "";
  out = out + fname;
  out = out + "(";
  out = out + a;
  out = out + ", ";
  out = out + b;
  out = out + ")";
  ^out;
}

!jss_lvl(s: string, n: int): string {
  ?(n == 0){ ^jss_e0(s) };
  ?(n == 1){ ^jss_e1(s) };
  ?(n == 2){ ^jss_e2(s) };
  ?(n == 3){ ^jss_e3(s) };
  ?(n == 4){ ^jss_e4(s) };
  ?(n == 5){ ^jss_e5(s) };
  ?(n == 6){ ^jss_e6(s) };
  ?(n == 7){ ^jss_e7(s) };
  ?(n == 8){ ^jss_e8(s) };
  ?(n == 9){ ^jss_e9(s) };
  ?(n == 10){ ^jss_e10(s) };
  ?(n == 11){ ^jss_e11(s) };
  ^jss_e12(s);
}

!jss_split(e: string, at: int, oplen: int, fname: string, ll: int, rl: int): string {
  a = jss_lvl(slice2(e, 0, at), ll);
  b = jss_lvl(slice2(e, at + oplen, e.length), rl);
  ^jss_bin(fname, a, b);
}

!jss_split_native(e: string, at: int, oplen: int, ops: string, ll: int, rl: int): string {
  out = "(";
  out = out + jss_lvl(slice2(e, 0, at), ll);
  out = out + " ";
  out = out + ops;
  out = out + " ";
  out = out + jss_lvl(slice2(e, at + oplen, e.length), rl);
  out = out + ")";
  ^out;
}

!jss_e0(s: string): string {
  e = jss_trim(s);
  pq = jsx_scan(e, "?", "", 0, 1);
  ?(pq < 0){ ^jss_e1(e) };
  pc = jsx_colon(e, pq);
  ?(pc < 0){ ^jss_e1(e) };
  out = "js_sel(";
  out = out + jss_e1(slice2(e, 0, pq));
  out = out + ", ";
  out = out + jss_e0(slice2(e, pq + 1, pc));
  out = out + ", ";
  out = out + jss_e0(slice2(e, pc + 1, e.length));
  out = out + ")";
  ^out;
}

!jss_e1(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "||", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_lor", 1, 2) };
  ^jss_e2(e);
}

!jss_e2(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "&&", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_land", 2, 3) };
  ^jss_e3(e);
}

!jss_e3(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "|", "|=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 1, "js_or", 3, 4) };
  ^jss_e4(e);
}

!jss_e4(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "^", "=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 1, "js_xor", 4, 5) };
  ^jss_e5(e);
}

!jss_e5(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "&", "&=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 1, "js_and", 5, 6) };
  ^jss_e6(e);
}

!jss_e6(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "===", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 3, "js_eq", 6, 7) };
  i = jsx_scan(e, "!==", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 3, "js_ne", 6, 7) };
  i = jsx_scan(e, "==", "=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_eq", 6, 7) };
  i = jsx_scan(e, "!=", "=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_ne", 6, 7) };
  ^jss_e7(e);
}

!jss_e7(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "<=", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_le", 7, 8) };
  i = jsx_scan(e, ">=", "", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_ge", 7, 8) };
  i = jsx_scan(e, "<", "<=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 1, "js_lt", 7, 8) };
  i = jsx_scan(e, ">", ">=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 1, "js_gt", 7, 8) };
  ^jss_e8(e);
}

!jss_e8(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, ">>>", "=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 3, "js_ushr", 8, 9) };
  i = jsx_scan(e, "<<", "=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_shl", 8, 9) };
  i = jsx_scan(e, ">>", ">=", 1, 0);
  ?(i >= 0){ ^jss_split(e, i, 2, "js_shr", 8, 9) };
  ^jss_e9(e);
}

!jss_e9(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "+", "+=", 1, 0);
  j = jsx_scan(e, "-", "-=", 1, 0);
  ?(i >= 0 && i > j){ ^jss_split_native(e, i, 1, "+", 9, 10) };
  ?(j >= 0){ ^jss_split_native(e, j, 1, "-", 9, 10) };
  ^jss_e10(e);
}

!jss_e10(s: string): string {
  e = jss_trim(s);
  i = jsx_scan(e, "*", "*=", 1, 0);
  ?(i >= 0){ ^jss_split_native(e, i, 1, "*", 10, 11) };
  ^jss_e11(e);
}

!jss_e11(s: string): string {
  e = jss_trim(s);
  n = e.length;
  ?(n == 0){ ^"0" };
  c = e.charCodeAt(0);
  out = "";
  ?(c == 126){
    out = "js_bnot(";
    out = out + jss_e11(slice2(e, 1, n));
    out = out + ")";
    ^out;
  };
  ?(c == 33){
    out = "js_lnot(";
    out = out + jss_e11(slice2(e, 1, n));
    out = out + ")";
    ^out;
  };
  ?(c == 45){
    out = "js_neg(";
    out = out + jss_e11(slice2(e, 1, n));
    out = out + ")";
    ^out;
  };
  ?(c == 43){ ^jss_e11(slice2(e, 1, n)) };
  ^jss_e12(e);
}

!jss_args(a: string): string {
  out = "";
  n = a.length;
  i = 0;
  d = 0;
  st = 0;
  c = 0;
  first = 1;
  seg = "";
  while (i <= n) {
    ?(i == n){
      seg = jss_trim(slice2(a, st, n));
      ?(seg.length > 0){
        ?(first == 0){ out = out + ", " };
        out = out + jss_e0(slice2(a, st, n));
        first = 0;
      };
      i = i + 1;
      continue;
    };
    c = a.charCodeAt(i);
    ?(c == 40 || c == 91){ d = d + 1 };
    ?(c == 41 || c == 93){ d = d - 1 };
    ?(d == 0 && c == 44){
      ?(first == 0){ out = out + ", " };
      out = out + jss_e0(slice2(a, st, i));
      first = 0;
      st = i + 1;
    };
    i = i + 1;
  };
  ^out;
}

!jss_hex_digit(c: int): int {
  ?(c >= 48 && c <= 57){ ^c - 48 };
  ?(c >= 65 && c <= 70){ ^c - 55 };
  ?(c >= 97 && c <= 102){ ^c - 87 };
  ^-1;
}

!jss_cons_ch(ch: int, rest: string): string {
  out = "";
  out = out + rgs_ch(ch);
  out = out + rest;
  ^out;
}

!jss_u32_dec(v: int): string {
  ?(v == 0){ ^"0" };
  ?(v == -9223372036854775808){ ^"-9223372036854775808" };
  neg = "";
  x = v;
  ?(x < 0){ neg = "-"; x = 0 - x };
  out = "";
  d = 0;
  while (x > 0) {
    d = rg_rem(x, 10);
    out = jss_cons_ch(48 + d, out);
    x = rg_digit(x, 10);
  };
  ^neg + out;
}

!jss_rewrite_hex(s: string): string {
  out = "";
  n = s.length;
  i = 0;
  c = 0;
  d = 0;
  v = 0;
  prev = 0;
  while (i < n) {
    c = s.charCodeAt(i);
    ?(c == 34 || c == 39){
      out = out + s.charAt(i);
      i = i + 1;
      while (i < n && s.charCodeAt(i) != c){ out = out + s.charAt(i); i = i + 1 };
      ?(i < n){ out = out + s.charAt(i); i = i + 1 };
      continue;
    };
    ?(c == 48 && i + 1 < n && (s.charCodeAt(i + 1) == 120 || s.charCodeAt(i + 1) == 88)){
      prev = 0;
      ?(i > 0){ prev = s.charCodeAt(i - 1) };
      ?(is_ident(prev) == false){
        i = i + 2;
        v = 0;
        d = -1;
        ?(i < n){ d = jss_hex_digit(s.charCodeAt(i)) };
        while (i < n && d >= 0){
          v = v * 16 + d;
          i = i + 1;
          ?(i < n){ d = jss_hex_digit(s.charCodeAt(i)) } : { d = -1 };
        };
        out = out + jss_u32_dec(v);
        continue;
      };
    };
    out = out + s.charAt(i);
    i = i + 1;
  };
  ^out;
}

!jss_e12(s: string): string {
  e = jss_trim(s);
  n = e.length;
  ?(n == 0){ ^"0" };
  cl = 0;
  ?(e.charCodeAt(0) == 40){
    cl = match_paren(e, 0);
    ?(cl == n - 1){ ^jss_e0(slice2(e, 1, cl)) };
  };
  id = read_ident(e, 0);
  out = "";
  ?(id.length > 0){
    p = skip_ws(e, id.length);
    ?(p < n && e.charCodeAt(p) == 40){
      cl = match_paren(e, p);
      ?(cl == n - 1){
        out = out + id;
        out = out + "(";
        out = out + jss_args(slice2(e, p + 1, cl));
        out = out + ")";
        ^out;
      };
    };
    ?(p < n && e.charCodeAt(p) == 91){
      cl = match_brack(e, p);
      ?(cl == n - 1){
        out = out + id;
        out = out + "[";
        out = out + jss_e0(slice2(e, p + 1, cl));
        out = out + "]";
        ^out;
      };
    };
  };
  out = out + e;
  ^out;
}

=ex{jss_trim, jss_e0, jss_e12, jss_args, jss_lvl, jss_rewrite_hex}
