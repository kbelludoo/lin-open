@LIN:rulel_core:1.0.0
^schema_once ^lossy=true ^ops=rulel_core
~G{?=if #=for ^=ret :else}

!splitTopEntries(s){
  out = [];
  cur = "";
  depth = 0;
  quote = null;
  #(i = 0; i < s.length; i++){
    c = s.charAt(i);
    ?(quote){
      cur = cur + c;
      ?(c === "\\" && i + 1 < s.length){
        i++;
        cur = cur + s.charAt(i)
      }:(c === quote){
        quote = null
      }
      continue
    }
    ?(c === "\"" || c === "'"){
      quote = c;
      cur = cur + c;
      continue
    }
    ?(c === "(" || c === "{" || c === "["){ depth++ }
    :(c === ")" || c === "}" || c === "]"){ depth-- }
    ?(c === " " && depth === 0){
      ?(cur.trim()){ out.push(cur.trim()) }
      cur = "";
      continue
    }
    cur = cur + c
  }
  ?(cur.trim()){ out.push(cur.trim()) }
  ^out
}

!parseValuePairs(body){
  entries = splitTopEntries(body);
  obj = {};
  #(k = 0; k < entries.length; k++){
    e = entries[k];
    m = e.match(/^([A-Za-z_][\w_-]*)=(.+)$/);
    ?(m){
      obj[m[1]] = m[2]
    }:{
      obj[e] = true
    }
  }
  ^obj
}

!parseRulel(text){
  s = String(text || "").trim();
  out = { header: null, sigils: {}, blocks: {} };
  hm = s.match(/^@RULEL:([^:\s]+):([^\s]+)/);
  ?(hm){ out.header = { id: hm[1], semver: hm[2] } }
  sigilRe = /~R\{([\s\S]*?)\}/g;
  m = null;
  while ((m = sigilRe.exec(s)) !== null) {
    parsedSig = parseValuePairs(m[1]);
    Object.assign(out.sigils, parsedSig)
  }
  blockRe = /\.([a-z])\{([^{}]*)\}/g;
  while ((m = blockRe.exec(s)) !== null) {
    out.blocks[m[1]] = parseValuePairs(m[2])
  }
  ^out
}

!validateComms(parsed){
  required = ["m", "r", "f", "a", "c", "s", "p"];
  missing = required.filter(function(k){ ^(!parsed.blocks[k]) });
  ridVal = (parsed.blocks.r && (parsed.blocks.r.R20 || parsed.blocks.r.rid)) || null;
  ^{
    ok: missing.length === 0,
    missing: missing,
    header: parsed.header,
    rid: ridVal
  }
}

=ex{splitTopEntries, parseValuePairs, parseRulel, validateComms}
