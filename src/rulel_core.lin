@LIN:L1c:0.2
!splitTopEntries(s){
  var out,cur,depth,quote,c,i;
  out = []; cur = ""; depth = 0; quote = null;
  for(i = 0; i < s.length; i++){
    c = s.charAt(i);
    ?(quote){
      cur = cur + c;
      ?(c === "\\" && i + 1 < s.length){ i++; cur = cur + s.charAt(i); }
      :(c === quote){ quote = null; }
    }:?(c === "\"" || c === "'"){
      quote = c; cur = cur + c;
    }:?(c === " " && depth === 0){
      ?(cur.trim()){ out.push(cur.trim()); }
      cur = "";
    }:{
      ?(c === "(" || c === "{" || c === "["){ depth++; }
      :(c === ")" || c === "}" || c === "]"){ depth--; }
      cur = cur + c;
    }
  }
  ?(cur.trim()){ out.push(cur.trim()); }
  ^out;
}
!parseValuePairs(body){var entries,obj,e,m,k;entries = splitTopEntries(body);obj = {};for(k = 0;k < entries.length;k++){e = entries[k];m = e.match(/^([A-Za-z_][\w_-]*)=(.+)$/);?(m){obj[m[1]] = m[2];}:{obj[e] = true;}}^obj;}
!parseRulel(text){var s,out,hm,sigilRe,m,parsedSig,blockRe;s = String(text || "").trim();out = { header: null, sigils: {}, blocks: {} };hm = s.match(/^@RULEL:([^:\s]+):([^\s]+)/);?(hm){out.header = { id: hm[1], semver: hm[2] };}sigilRe = /~R\{([\s\S]*?)\}/g;m = null;while((m = sigilRe.exec(s)) !== null){parsedSig = parseValuePairs(m[1]);Object.assign(out.sigils, parsedSig);}blockRe = /\.([a-z])\{([^{}]*)\}/g;while((m = blockRe.exec(s)) !== null){out.blocks[m[1]] = parseValuePairs(m[2]);}^out;}
!validateComms(parsed){var required,missing,ridVal;required = ["m", "r", "f", "a", "c", "s", "p"];missing = required.filter(function(k){^(!parsed.blocks[k]);});ridVal = (parsed.blocks.r && (parsed.blocks.r.R20 || parsed.blocks.r.rid)) || null;^{
    ok: missing.length === 0,
    missing: missing,
    header: parsed.header,
    rid: ridVal
  };}
=ex{splitTopEntries, parseValuePairs, parseRulel, validateComms}
