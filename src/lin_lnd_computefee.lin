@LIN:L1c:0.2
@LND_BOLT07_COMPUTE_FEE{
  version=1
  repo="lightningnetwork/lnd"
  source="graph/db/models/cached_edge_policy.go"
  inbound="graph/db/models/inbound_fee.go"
  license="MIT"
  tag="v0.21.3-beta"
  commit="572b561bf05f03dfe6135110970c4d858c3482dc"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="bolt07_htlc_forwarding_fee_uint64_scale_128bit_muldiv"
  note="Not a routing node. Real deltas: receiver/storage fields are arguments; amt*ppm uses 128-bit product; fail-closed if quotient or fee add exceeds uint64. Inbound CalcFee keeps Go toward-zero rounding and the +/-10x rate cap."
}

!lnf_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!lnf_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(lnf_u_lt(s, a));
}

!lnf_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(lnf_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!lnf_mask32() -> int {
  ^ 4294967295;
}

!lnf_parts() -> int {
  ^ 1000000;
}

!lnf_max_rate() -> int {
  ^ 10000000;
}

!lnf_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = lnf_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = lnf_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = lnf_u_add_carry(p0, t);
  hi = p3 + _lia_ushr(mid, 32);
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(lnf_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = lnf_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!lnf_muldiv(a: int, b: int, d: int) -> int {
  ^ lnf_muldiv_part(a, b, d, 0);
}

!lnf_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ lnf_muldiv_part(a, b, d, 1);
}

!lnf_compute_fee(base: int, ppm: int, amt: int) -> int {
  ?(base < 0 || ppm < 0 || amt < 0) { ^ 0; };
  prop = lnf_muldiv(amt, ppm, lnf_parts());
  ?(lnf_u_add_ok(base, prop) == 0) { ^ 0; };
  ^ base + prop;
}

!lnf_incoming(base: int, ppm: int, outgoing: int) -> int {
  f = lnf_compute_fee(base, ppm, outgoing);
  ?(outgoing < 0) { ^ 0; };
  ?(lnf_u_add_ok(outgoing, f) == 0) { ^ 0; };
  ^ outgoing + f;
}

!lnf_inbound_calc(base: int, rate: int, amt: int) -> int {
  ?(amt < 0) { ^ 0; };
  r = rate;
  cap = lnf_max_rate();
  ?(r > cap) { r = cap; };
  ?(r < 0 - cap) { r = 0 - cap; };
  mag = r;
  ?(mag < 0) { mag = 0 - mag; };
  p = lnf_muldiv(amt, mag, lnf_parts());
  ?(r < 0) { p = 0 - p; };
  ^ base + p;
}

!lnf_test_suite() -> int {
  ?(lnf_parts() != 1000000) { ^ -1; };
  ?(lnf_muldiv(100, 200, 50) != 400) { ^ -2; };
  ?(lnf_muldiv_rem(7, 9, 2) != 1) { ^ -3; };
  ?(lnf_compute_fee(1000, 1, 1000000) != 1001) { ^ -4; };
  ?(lnf_compute_fee(0, 0, 123) != 0) { ^ -5; };
  ?(lnf_compute_fee(1000, 0, 999) != 1000) { ^ -6; };
  ?(lnf_compute_fee(1000, 100, 100000000) != 11000) { ^ -7; };
  ?(lnf_incoming(1000, 100, 100000000) != 100011000) { ^ -8; };
  ?(lnf_inbound_calc(5, 500000, 2) != 6) { ^ -9; };
  ?(lnf_inbound_calc(5, 500000, 3) != 6) { ^ -10; };
  ?(lnf_inbound_calc(-5, -500000, 2) != -6) { ^ -11; };
  ?(lnf_inbound_calc(-5, -500000, 3) != -6) { ^ -12; };
  ?(lnf_inbound_calc(0, 20000000, 1000000) != 10000000) { ^ -13; };
  ?(lnf_compute_fee(-1, 0, 1) != 0) { ^ -14; };
  wrap_q = lnf_muldiv(4294967296, 4294967296, 1000000);
  ?(wrap_q != 18446744073709) { ^ -15; };
  ^ 1;
}

=ex{
  lnf_u_lt,
  lnf_u_add_carry,
  lnf_u_add_ok,
  lnf_mask32,
  lnf_parts,
  lnf_max_rate,
  lnf_muldiv_part,
  lnf_muldiv,
  lnf_muldiv_rem,
  lnf_compute_fee,
  lnf_incoming,
  lnf_inbound_calc,
  lnf_test_suite
}
