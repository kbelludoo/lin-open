@LIN:L1c:0.2
!createClient(message,line,col){
    super(`LIN_LEX:${line}:${col}: ${message}`);
    this.name = 'LinSyntaxError';
    this.line = line;
    this.col = col;
  }
!tokenize(src){
  const s = String(src || '');
  const toks = [];
  let i = 0;
  let line = 1;
  let lineStart = 0;
  const SL = lexerSlices();

  function push(type, value, start, end) {
    toks.push({ type, value, start, end, line, col: start - lineStart + 1 });
  }

  while (i < s.length) {
    const c = s[i];
    ?(c === '\n'){
      push('nl', '\n', i, i + 1);
      i++;
      line++;
      lineStart = i;
      continue;
    }
    ?(c === ' ' || c === '\t' || c === '\r'){
      ?(SL){
        const run = SL.wsRunAt(s, i);
        i += run > 0 ? run : 1;
        continue;
      }
      i++;
      continue;
    }
    ?(c === '/' && s[i + 1] === '/'){
      let j = s.indexOf('\n', i);
      ?(j < 0){ j = s.length; }
      push('comment', s.slice(i, j), i, j);
      i = j;
      continue;
    }
    ?(c === '/' && s[i + 1] === '*'){
      let j = s.indexOf('*/', i + 2);
      j = j < 0 ? s.length : j + 2;
      push('comment', s.slice(i, j), i, j);
      for (let k = i; k < j; k++) {
        ?(s[k] === '\n'){
          line++;
          lineStart = k + 1;
        }
      }
      i = j;
      continue;
    }
    ?(c === '"' || c === "'" || c === '`'){
      const q = c;
      const start = i;
      i++;
      let closed = false;
      while (i < s.length) {
        const ch = s[i];
        ?(ch === '\\'){
          i += 2;
          continue;
        }
        ?(q === '`' && ch === '$' && s[i + 1] === '{'){
          let depth = 1;
          i += 2;
          while (i < s.length && depth > 0) {
            ?(s[i] === '{'){ depth++; }:(s[i] === '}'){ depth--; }:(s[i] === '\n'){
              line++;
              lineStart = i + 1;
            }:(s[i] === '"' || s[i] === "'" || s[i] === '`'){
              const innerQ = s[i];
              i++;
              while (i < s.length && s[i] !== innerQ) {
                ?(s[i] === '\\'){ i++; }
                i++;
              }
            }
            i++;
          }
          continue;
        }
        ?(ch === '\n' && q !== '`'){ throw new LinSyntaxError('unterminated string', line, i - lineStart + 1); }
        ?(ch === q){
          i++;
          closed = true;
          break;
        }
        ?(ch === '\n'){
          line++;
          lineStart = i + 1;
        }
        i++;
      }
      ?(!closed && q !== '`'){ throw new LinSyntaxError('unterminated string', line, i - lineStart + 1); }
      push(q === '`' ? 'template' : 'str', s.slice(start, i), start, i);
      continue;
    }
    ?(c === '/'){
      const prev = lastSignificant(toks);
      const regexAllowed = !prev || (prev.type === 'punct' && REGEX_PREV_OK.has(prev.value)) ||
        (prev.type === 'id' && REGEX_PREV_OK.has(prev.value));
      ?(regexAllowed){
        const start = i;
        let j = i + 1;
        let inClass = false;
        let ok = false;
        while (j < s.length) {
          const ch = s[j];
          ?(ch === '\\'){
            j += 2;
            continue;
          }
          ?(ch === '\n'){ break; }
          ?(ch === '['){ inClass = true; }:(ch === ']'){ inClass = false; }:(ch === '/' && !inClass){
            j++;
            while (j < s.length && /[gimsuyvd]/.test(s[j])) j++;
            ok = true;
            break;
          }
          j++;
        }
        ?(ok){
          push('regex', s.slice(start, j), start, j);
          i = j;
          continue;
        }
      }
    }
    ?(SL){
      const nl = SL.numLenAt(s, i);
      ?(nl > 0){
        const start = i;
        i += nl;
        push('num', s.slice(start, i), start, i);
        continue;
      }
    } else ?(/[0-9]/.test(c) || (c === '.' && /[0-9]/.test(s[i + 1] || ''))){
      const start = i;
      ?(c === '0' && /[xXbBoO]/.test(s[i + 1] || '')){
        i += 2;
        while (i < s.length && /[0-9a-fA-F_]/.test(s[i])) i++;
      }:{
        while (i < s.length && /[0-9_]/.test(s[i])) i++;
        ?(s[i] === '.'){
          i++;
          while (i < s.length && /[0-9_]/.test(s[i])) i++;
        }
        ?(/[eE]/.test(s[i] || '') && /[0-9+\-]/.test(s[i + 1] || '')){
          i += 2;
          while (i < s.length && /[0-9_]/.test(s[i])) i++;
        }
      }
      ?(s[i] === 'n'){ i++; }
      push('num', s.slice(start, i), start, i);
      continue;
    }
    ?(SL){
      const il = SL.identLenAt(s, i);
      ?(il > 0){
        const start = i;
        i += il;
        push('id', s.slice(start, i), start, i);
        continue;
      }
    } else ?(/[A-Za-z_$]/.test(c)){
      const start = i;
      i++;
      while (i < s.length && /[A-Za-z0-9_$]/.test(s[i])) i++;
      push('id', s.slice(start, i), start, i);
      continue;
    }
    const three = s.slice(i, i + 3);
    ?(PUNCT3.includes(three)){
      push('punct', three, i, i + 3);
      i += 3;
      continue;
    }
    const two = s.slice(i, i + 2);
    ?(PUNCT2.includes(two)){
      push('punct', two, i, i + 2);
      i += 2;
      continue;
    }
    ?(PUNCT1.includes(c)){
      push('punct', c, i, i + 1);
      i++;
      continue;
    }
    throw new LinSyntaxError(`unexpected char ${JSON.stringify(c)}`, line, i - lineStart + 1);
  }
  push('eof', '', s.length, s.length);
  ^toks;
}

function lastSignificant(toks) {
  for (let k = toks.length - 1; k >= 0; k--) {
    const t = toks[k];
    ?(t.type === 'nl' || t.type === 'comment'){ continue; }
    ^t;
  }
  ^null;
}}
!push(type,value,start,end){
    toks.push({ type, value, start, end, line, col: start - lineStart + 1 });
  }
!lastSignificant(toks){
  for (let k = toks.length - 1; k >= 0; k--) {
    const t = toks[k];
    ?(t.type === 'nl' || t.type === 'comment'){ continue; }
    ^t;
  }
  ^null;
}
=ex{createClient, tokenize, push, lastSignificant}