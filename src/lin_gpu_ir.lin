@LIN:L1c:0.2
@RULEL:LIN_GPU_IR:1.0.0

// ============================================================================
// LIN-GPU-007A: Canonical Declarative Target-Neutral LIN GPU IR
//
// Architectural Invariants:
//   1. "GPU IR nunca conhece o backend; o emitter conhece o backend."
//   2. Target-neutral instructions: parallel_for, load, store, reduce, barrier.
//   3. H_gpuIR = SHA256("LIN-GPU-IR-V1" || schema_version || CanonicalEncode(GpuModule)).
//
// Source of Normative Semantic Authority: pure .lin
// ============================================================================

// --- GPU Address Spaces ---
// 1: GENERIC, 2: GLOBAL, 3: WORKGROUP_LOCAL, 4: PRIVATE
!gpu_address_space_is_valid(space: int): int {
  ?(space >= 1 && space <= 4){ ^1 };
  ^0;
}

// --- GPU Data Types ---
// 1: I32, 2: U32, 3: I64, 4: U64, 5: F32, 6: F64, 7: BOOL
!gpu_data_type_is_valid(dtype: int): int {
  ?(dtype >= 1 && dtype <= 7){ ^1 };
  ^0;
}

// --- GPU Opcodes ---
// 1: PARALLEL_FOR, 2: LOAD, 3: STORE, 4: ADD, 5: SUB, 6: MUL, 7: DIV,
// 8: REDUCE, 9: BARRIER, 10: INDEX, 11: CAST
!gpu_op_is_valid(op: int): int {
  ?(op >= 1 && op <= 11){ ^1 };
  ^0;
}

// --- Numeric Contract ---
// 1: MODULAR_I32, 2: MODULAR_U32, 3: IEEE754_STRICT
!numeric_contract_is_valid(contract: int): int {
  ?(contract >= 1 && contract <= 3){ ^1 };
  ^0;
}

// --- Lowering Legality Verification Rule ---
!gpu_ir_lowering_is_legal(is_associative: int, is_commutative: int, has_aliasing: int, address_space_valid: int): int {
  ?(is_associative == 0 || is_commutative == 0){
    ^0; // Rejects non-associative parallel reductions
  };
  ?(has_aliasing != 0){
    ^0; // Rejects unproven memory aliasing
  };
  ?(address_space_valid == 0){
    ^0; // Rejects invalid address spaces
  };
  ^1;
}

// --- Formal Self-Contained Verification Tests ---
!test_gpu_ir_validation(): int {
  // Validate address spaces
  ?(gpu_address_space_is_valid(2) != 1){ ^0 }; // GLOBAL
  ?(gpu_address_space_is_valid(3) != 1){ ^0 }; // WORKGROUP_LOCAL
  ?(gpu_address_space_is_valid(99) != 0){ ^0 }; // INVALID

  // Validate data types
  ?(gpu_data_type_is_valid(1) != 1){ ^0 }; // I32
  ?(gpu_data_type_is_valid(0) != 0){ ^0 }; // INVALID

  // Validate opcodes
  ?(gpu_op_is_valid(1) != 1){ ^0 }; // PARALLEL_FOR
  ?(gpu_op_is_valid(8) != 1){ ^0 }; // REDUCE

  // Validate numeric contracts
  ?(numeric_contract_is_valid(1) != 1){ ^0 }; // MODULAR_I32

  // Validate lowering legality logic
  legal_pass = gpu_ir_lowering_is_legal(1, 1, 0, 1);
  ?(legal_pass != 1){ ^0 };

  legal_fail_alias = gpu_ir_lowering_is_legal(1, 1, 1, 1);
  ?(legal_fail_alias != 0){ ^0 };

  legal_fail_non_assoc = gpu_ir_lowering_is_legal(0, 1, 0, 1);
  ?(legal_fail_non_assoc != 0){ ^0 };

  ^1;
}

=ex{gpu_address_space_is_valid, gpu_data_type_is_valid, gpu_op_is_valid, numeric_contract_is_valid, gpu_ir_lowering_is_legal, test_gpu_ir_validation}
