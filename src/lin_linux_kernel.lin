@LIN:L1c:0.2
@LINUX_KERNEL_OPTIMIZATION{source="linux-kernel" version="6.x" scope="core_math_and_bitops"}

// 1. Linux Kernel Bitwise Rotations (include/linux/bitops.h)
!lk_rol32(word: int, shift: int): int {
  w = word & 4294967295;
  s = shift & 31;
  ^((_lia_shl(w, s)) | (_lia_shr(w, (32 - s)))) & 4294967295;
}

!lk_ror32(word: int, shift: int): int {
  w = word & 4294967295;
  s = shift & 31;
  ^((_lia_shr(w, s)) | (_lia_shl(w, (32 - s)))) & 4294967295;
}

// 2. Linux Kernel jhash_1word (include/linux/jhash.h)
!lk_jhash_1word(a_in: int, initval: int): int {
  init = initval & 4294967295;
  b = (3735928559 + init) & 4294967295;
  c = (3735928559 + init + 4) & 4294967295;
  a = ((a_in & 4294967295) + 3735928559 + init) & 4294967295;

  c = (c ^ b) - lk_rol32(b, 14);
  c = c & 4294967295;
  a = (a ^ c) - lk_rol32(c, 11);
  a = a & 4294967295;
  b = (b ^ a) - lk_rol32(a, 25);
  b = b & 4294967295;
  c = (c ^ b) - lk_rol32(b, 16);
  c = c & 4294967295;
  a = (a ^ c) - lk_rol32(c, 4);
  a = a & 4294967295;
  b = (b ^ a) - lk_rol32(a, 14);
  b = b & 4294967295;
  c = (c ^ b) - lk_rol32(b, 24);
  ^c & 4294967295;
}

// 3. Linux Kernel Binary GCD (lib/math/gcd.c)
!lk_gcd(a_in: int, b_in: int): int {
  a = a_in & 4294967295;
  b = b_in & 4294967295;
  ?(a == 0){ ^b };
  ?(b == 0){ ^a };

  r = 0;
  while (((a | b) & 1) == 0) {
    a = _lia_shr(a, 1);
    b = _lia_shr(b, 1);
    r = r + 1;
  };

  while ((a & 1) == 0) {
    a = _lia_shr(a, 1);
  };

  while (b != 0) {
    while ((b & 1) == 0) {
      b = _lia_shr(b, 1);
    };
    ?(a > b){
      t = b;
      b = a;
      a = t;
    };
    b = b - a;
  };

  ^(_lia_shl(a, r)) & 4294967295;
}

// 4. Linux Kernel Integer Sqrt (lib/math/int_sqrt.c)
!lk_int_sqrt(x_in: int): int {
  x = x_in & 4294967295;
  ?(x <= 1){ ^x };

  b = 0;
  m = 1073741824;
  y = 0;

  while (m > x) {
    m = _lia_shr(m, 2);
  };

  while (m != 0) {
    b = y + m;
    y = _lia_shr(y, 1);
    ?(x >= b){
      x = x - b;
      y = y + m;
    };
    m = _lia_shr(m, 2);
  };

  ^y & 4294967295;
}

// 5. Linux Kernel Hamming Weight (lib/hweight.c)
!lk_hweight32(w_in: int): int {
  w = w_in & 4294967295;
  res = (w - ((_lia_shr(w, 1)) & 1431655765)) & 4294967295;
  res = ((res & 858993459) + ((_lia_shr(res, 2)) & 858993459)) & 4294967295;
  res = (res + (_lia_shr(res, 4))) & 252645135;
  res = (res + (_lia_shr(res, 8))) & 4294967295;
  ^(res + (_lia_shr(res, 16))) & 255;
}

// 6. Linux Kernel fls - Find Last Set (include/linux/bitops.h)
!lk_fls(x_in: int): int {
  x = x_in & 4294967295;
  ?(x == 0){ ^0 };
  r = 32;
  ?((x & 4294901760) == 0){
    x = _lia_shl(x, 16);
    r = r - 16;
  };
  ?((x & 4278190080) == 0){
    x = _lia_shl(x, 8);
    r = r - 8;
  };
  ?((x & 4026531840) == 0){
    x = _lia_shl(x, 4);
    r = r - 4;
  };
  ?((x & 3221225472) == 0){
    x = _lia_shl(x, 2);
    r = r - 2;
  };
  ?((x & 2147483648) == 0){
    x = _lia_shl(x, 1);
    r = r - 1;
  };
  ^r;
}

// --- OPTIMIZED VERSIONS IN LIN ---

// Optimized Branchless FLS / ilog2 using parallel bit-folding (eliminates branch mispredictions)
!lin_opt_fls(x_in: int): int {
  x = x_in & 4294967295;
  ?(x == 0){ ^0 };
  x = x | _lia_shr(x, 1);
  x = x | _lia_shr(x, 2);
  x = x | _lia_shr(x, 4);
  x = x | _lia_shr(x, 8);
  x = x | _lia_shr(x, 16);
  ^lk_hweight32(x);
}

// Optimized Binary GCD with fast 4-bit trailing zero elimination
!lin_opt_gcd(a_in: int, b_in: int): int {
  a = a_in & 4294967295;
  b = b_in & 4294967295;
  ?(a == 0){ ^b };
  ?(b == 0){ ^a };

  // Fast common power of 2 elimination
  common_zeros = 0;
  while (((a | b) & 15) == 0) {
    a = _lia_shr(a, 4);
    b = _lia_shr(b, 4);
    common_zeros = common_zeros + 4;
  };
  while (((a | b) & 1) == 0) {
    a = _lia_shr(a, 1);
    b = _lia_shr(b, 1);
    common_zeros = common_zeros + 1;
  };

  while ((a & 15) == 0){ a = _lia_shr(a, 4); };
  while ((a & 1) == 0){ a = _lia_shr(a, 1); };

  while (b != 0) {
    while ((b & 15) == 0){ b = _lia_shr(b, 4); };
    while ((b & 1) == 0){ b = _lia_shr(b, 1); };
    ?(a > b){
      t = b;
      b = a;
      a = t;
    };
    b = b - a;
  };

  ^(_lia_shl(a, common_zeros)) & 4294967295;
}

// Test validation suite
!test_linux_kernel_vectors(): int {
  // GCD tests
  ?(lk_gcd(1071, 462) != 21){ ^0 };
  ?(lin_opt_gcd(1071, 462) != 21){ ^0 };
  ?(lk_gcd(48, 18) != 6){ ^0 };
  ?(lin_opt_gcd(48, 18) != 6){ ^0 };

  // Integer sqrt tests
  ?(lk_int_sqrt(0) != 0){ ^0 };
  ?(lk_int_sqrt(1) != 1){ ^0 };
  ?(lk_int_sqrt(144) != 12){ ^0 };
  ?(lk_int_sqrt(1000000) != 1000){ ^0 };
  ?(lk_int_sqrt(2147483647) != 46340){ ^0 };

  // Hamming weight tests
  ?(lk_hweight32(0) != 0){ ^0 };
  ?(lk_hweight32(15) != 4){ ^0 };
  ?(lk_hweight32(3935318504) != 14){ ^0 };

  // FLS (Find Last Set) tests
  ?(lk_fls(0) != 0){ ^0 };
  ?(lk_fls(1) != 1){ ^0 };
  ?(lk_fls(16) != 5){ ^0 };
  ?(lk_fls(2147483648) != 32){ ^0 };
  ?(lin_opt_fls(0) != 0){ ^0 };
  ?(lin_opt_fls(1) != 1){ ^0 };
  ?(lin_opt_fls(16) != 5){ ^0 };
  ?(lin_opt_fls(2147483648) != 32){ ^0 };

  // JHash tests
  ?(lk_jhash_1word(12345, 0) == 0){ ^0 };

  ^1;
}

=ex{lk_rol32, lk_ror32, lk_jhash_1word, lk_gcd, lk_int_sqrt, lk_hweight32, lk_fls, lin_opt_fls, lin_opt_gcd, test_linux_kernel_vectors}
