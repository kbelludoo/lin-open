@LIN:L1c:0.2
@CURVE_TRICRYPTO_NEWTON_D{
  version=1
  repo="curvefi/tricrypto-ng"
  source="contracts/main/CurveCryptoMathOptimized3.vy newton_D"
  license="all_rights_reserved_informational_upstream"
  commit="ecaa8161c240f21dd7c3712eefc5637e1dac742b"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_curve_crypto_newton_D_128bit"
  note="Not mainnet uint256. N=3 explicit x0,x1,x2. ANN,gamma arguments. SCALE=1e9. K0_prev!=0 fail-closes. S*mul2 uses 128-bit product. Non-convergence fail-closes to 0."
}

!cnd_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cnd_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cnd_u_lt(s, a));
}

!cnd_mask32() -> int {
  ^ 4294967295;
}

!cnd_prec() -> int {
  ^ 1000000000;
}

!cnd_n() -> int {
  ^ 3;
}

!cnd_amul() -> int {
  ^ 10000;
}

!cnd_prod128(a: int, b: int, want: int) -> int {
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = cnd_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cnd_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cnd_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  ?(want == 1) { ^ hi; };
  ^ lo;
}

!cnd_div128(hi: int, lo: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(d < 0) { ^ 0; };
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cnd_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cnd_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(ov == 1) { ^ 0; };
  ?(q < 0) { ^ 0; };
  ^ q;
}

!cnd_muldiv(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  hi = cnd_prod128(a, b, 1);
  lo = cnd_prod128(a, b, 0);
  ^ cnd_div128(hi, lo, d);
}

!cnd_lt128(h1: int, l1: int, h2: int, l2: int) -> int {
  ?(h1 != h2) { ^ cnd_u_lt(h1, h2); };
  ^ cnd_u_lt(l1, l2);
}

!cnd_icbrt128(hi: int, lo: int) -> int {
  l = 0;
  h = 4294967296;
  ?(hi == 0) {
    ?(cnd_u_lt(lo, h) == 1) { h = lo; };
  };
  iter = 0;
  while (iter < 40) {
    ?(cnd_u_lt(l, h) == 1) {
      mid = l + _lia_ushr((h - l) + 1, 1);
      sh = cnd_prod128(mid, mid, 1);
      sl = cnd_prod128(mid, mid, 0);
      ?(sh != 0) { h = mid - 1; };
      ?(sh == 0) {
        ch = cnd_prod128(sl, mid, 1);
        cl = cnd_prod128(sl, mid, 0);
        ?(cnd_lt128(hi, lo, ch, cl) == 1) { h = mid - 1; };
        ?(cnd_lt128(hi, lo, ch, cl) == 0) { l = mid; };
      };
    };
    iter = iter + 1;
  };
  ^ l;
}

!cnd_newton_d(ann: int, gamma: int, x0: int, x1: int, x2: int, k0_prev: int) -> int {
  ?(ann <= 0) { ^ 0; };
  ?(gamma <= 0) { ^ 0; };
  ?(k0_prev != 0) { ^ 0; };
  ?(x0 <= 0) { ^ 0; };
  ?(x1 <= 0) { ^ 0; };
  ?(x2 <= 0) { ^ 0; };
  h = x0;
  m = x1;
  l = x2;
  ?(cnd_u_lt(h, m) == 1) { t = h; h = m; m = t; };
  ?(cnd_u_lt(h, l) == 1) { t = h; h = l; l = t; };
  ?(cnd_u_lt(m, l) == 1) { t = m; m = l; l = t; };
  S = h + m;
  ?(cnd_u_lt(S, h) == 1) { ^ 0; };
  S = S + l;
  ?(cnd_u_lt(S, l) == 1) { ^ 0; };
  ph = cnd_prod128(h, m, 1);
  ?(ph != 0) { ^ 0; };
  pl = cnd_prod128(h, m, 0);
  ph = cnd_prod128(pl, l, 1);
  pl = cnd_prod128(pl, l, 0);
  gm = cnd_icbrt128(ph, pl);
  D = cnd_n() * gm;
  ?(D <= 0) { ^ 0; };
  n = cnd_n();
  P = cnd_prec();
  conv = 0;
  outd = 0;
  iter = 0;
  while (iter < 255) {
    ?(conv == 0) {
      skip = 0;
      D_prev = D;
      K0 = cnd_muldiv(P, h * n, D);
      K0 = cnd_muldiv(K0, m * n, D);
      K0 = cnd_muldiv(K0, l * n, D);
      ?(K0 <= 0) { conv = 2; };
      ?(conv == 0) {
        orig = gamma + P;
        g1 = orig;
        ?(cnd_u_lt(orig, K0) == 1) { g1 = (K0 - orig) + 1; };
        ?(cnd_u_lt(orig, K0) == 0) { g1 = (orig - K0) + 1; };
        t = cnd_muldiv(P, D, gamma);
        t = cnd_muldiv(t, g1, gamma);
        t = cnd_muldiv(t, g1, 1);
        mul1 = cnd_muldiv(t, cnd_amul(), ann);
        ?(mul1 <= 0) { conv = 2; };
        ?(conv == 0) {
          mul2 = cnd_muldiv(P + P, n * K0, g1);
          t2 = cnd_muldiv(S, mul2, P);
          t3 = cnd_muldiv(mul1, n, K0);
          t4 = cnd_muldiv(mul2, D, P);
          lhs = S + t2;
          ?(cnd_u_lt(lhs, S) == 1) { conv = 2; };
          ?(conv == 0) {
            lhs = lhs + t3;
            ?(cnd_u_lt(lhs, t3) == 1) { conv = 2; };
            ?(conv == 0) {
              ?(cnd_u_lt(lhs, t4) == 1) { D = cnd_muldiv(D_prev, 1, 2); skip = 1; };
              ?(cnd_u_lt(lhs, t4) == 0) {
                neg = lhs - t4;
                ?(neg <= 0) { conv = 2; };
                ?(conv == 0) {
                  D_plus = cnd_muldiv(D, neg + S, neg);
                  D_minus = cnd_muldiv(D, D, neg);
                  ?(cnd_u_lt(K0, P) == 1) {
                    extra = cnd_muldiv(cnd_muldiv(D, mul1 / neg, P), P - K0, K0);
                    D_minus = D_minus + extra;
                    ?(cnd_u_lt(D_minus, extra) == 1) { conv = 2; };
                  };
                  ?(cnd_u_lt(K0, P) == 0) {
                    extra = cnd_muldiv(cnd_muldiv(D, mul1 / neg, P), K0 - P, K0);
                    ?(cnd_u_lt(D_minus, extra) == 1) { D = cnd_muldiv(D_prev, 1, 2); skip = 1; };
                    ?(cnd_u_lt(D_minus, extra) == 0) { D_minus = D_minus - extra; };
                  };
                  ?(conv == 0) {
                    ?(skip == 0) {
                      ?(cnd_u_lt(D_plus, D_minus) == 1) { D = cnd_muldiv(D_minus - D_plus, 1, 2); };
                      ?(cnd_u_lt(D_plus, D_minus) == 0) { D = D_plus - D_minus; };
                      diff = D - D_prev;
                      ?(cnd_u_lt(D, D_prev) == 1) { diff = D_prev - D; };
                      lim = cnd_muldiv(D, 1, 100000);
                      ?(cnd_u_lt(lim, 100) == 1) { lim = 100; };
                      ?(cnd_u_lt(diff, lim) == 1) { outd = D; conv = 1; };
                    };
                  };
                };
              };
            };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ outd;
}

!cnd_get_vp(ann: int, gamma: int, x0: int, x1: int, x2: int) -> int {
  D = cnd_newton_d(ann, gamma, x0, x1, x2, 0);
  ?(D <= 0) { ^ 0; };
  S = (x0 + x1) + x2;
  ?(S <= 0) { ^ 0; };
  ^ cnd_muldiv(D, cnd_prec(), S);
}

!cnd_cbrt3(a: int, b: int, c: int) -> int {
  ?(a <= 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ?(c <= 0) { ^ 0; };
  ph = cnd_prod128(a, b, 1);
  ?(ph != 0) { ^ 0; };
  pl = cnd_prod128(a, b, 0);
  ph = cnd_prod128(pl, c, 1);
  pl = cnd_prod128(pl, c, 0);
  ^ cnd_icbrt128(ph, pl);
}

!cnd_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!cnd_test_suite() -> int {
  e9 = 1000000000;
  ann = 1707629;
  g = 11809;
  ?(cnd_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(cnd_cbrt3(e9, e9, e9) != e9) { ^ -2; };
  ?(cnd_newton_d(ann, g, e9, e9, e9, 0) != 3000000000) { ^ -3; };
  ?(cnd_newton_d(ann, g, 1100000000, e9, e9, 0) != 3096846429) { ^ -4; };
  ?(cnd_get_vp(ann, g, 1100000000, e9, e9) != 998982719) { ^ -5; };
  ?(cnd_newton_d(ann, g, 1200000000, 900000000, e9, 0) != 3077962761) { ^ -6; };
  ?(cnd_newton_d(ann, g, 1010000000, e9, e9, 0) != 3009971862) { ^ -7; };
  ?(cnd_newton_d(ann, 0, e9, e9, e9, 0) != 0) { ^ -8; };
  ?(cnd_newton_d(2700, g, e9, e9, e9, 0) != 0) { ^ -9; };
  ?(cnd_newton_d(ann, g, e9, e9, e9, 1) != 0) { ^ -10; };
  ?(cnd_newton_d(ann, g, 0, e9, e9, 0) != 0) { ^ -11; };
  ?(cnd_get_vp(ann, g, e9, e9, e9) != e9) { ^ -12; };
  ?(cnd_naive_i64_mul(3000000000, 508044030482641) != 6755845818716831232) { ^ -13; };
  ?(cnd_newton_d(ann, g, 100000000, 100000000, 100000000, 0) != 300000000) { ^ -14; };
  ^ 1;
}

=ex{
  cnd_u_lt,
  cnd_u_add_carry,
  cnd_mask32,
  cnd_prec,
  cnd_n,
  cnd_amul,
  cnd_prod128,
  cnd_div128,
  cnd_muldiv,
  cnd_lt128,
  cnd_icbrt128,
  cnd_newton_d,
  cnd_get_vp,
  cnd_cbrt3,
  cnd_naive_i64_mul,
  cnd_test_suite
}
