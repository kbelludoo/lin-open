@LIN:L1c:0.2
@AAVE_V3_WADRAY{
  version=1
  repo="aave/aave-v3-core"
  source="contracts/protocol/libraries/math/WadRayMath.sol wadMul/wadDiv"
  license="MIT"
  license_note="BUSL-1.1 Change Date 2023-01-27 elapsed; Change License MIT"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_aave_wad_half_up_128bit_not_ray_1e27"
  note="Not mainnet uint256. WAD=1e18 half-up. RAY=1e27 does not fit i64/u64 (awr_ray_fits=0). Distinct from Solady/OZ floor mulWad and from naive i64 a*b."
}

!awr_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!awr_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(awr_u_lt(s, a));
}

!awr_mask32() -> int {
  ^ 4294967295;
}

!awr_wad() -> int {
  ^ 1000000000000000000;
}

!awr_half_wad() -> int {
  ^ 500000000000000000;
}

!awr_ratio() -> int {
  ^ 1000000000;
}

!awr_sray() -> int {
  ^ 1000000000;
}

!awr_half_sray() -> int {
  ^ 500000000;
}

!awr_ray_fits() -> int {
  ^ 0;
}

!awr_muldiv_add_part(a: int, b: int, add: int, d: int, want_ov: int) -> int {
  ?(d == 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  m32 = awr_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = awr_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = awr_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + awr_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(awr_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = awr_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want_ov == 1) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!awr_muldiv_add(a: int, b: int, add: int, d: int) -> int {
  ^ awr_muldiv_add_part(a, b, add, d, 0);
}

!awr_wad_mul_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(awr_muldiv_add_part(a, b, awr_half_wad(), awr_wad(), 1) == 1) { ^ 0; };
  ^ 1;
}

!awr_wad_mul(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ^ awr_muldiv_add_part(a, b, awr_half_wad(), awr_wad(), 0);
}

!awr_wad_div_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ?(awr_muldiv_add_part(a, awr_wad(), b / 2, b, 1) == 1) { ^ 0; };
  ^ 1;
}

!awr_wad_div(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ^ awr_muldiv_add_part(a, awr_wad(), b / 2, b, 0);
}

!awr_wad_to_ray_ok(a: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(a == 0) { ^ 1; };
  q = 9223372036854775807 / awr_ratio();
  ?(awr_u_lt(q, a) == 1) { ^ 0; };
  ^ 1;
}

!awr_wad_to_ray(a: int) -> int {
  ?(awr_wad_to_ray_ok(a) == 0) { ^ 0; };
  ^ a * awr_ratio();
}

!awr_sray_mul(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ^ awr_muldiv_add_part(a, b, awr_half_sray(), awr_sray(), 0);
}

!awr_wrong_floor_mul(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ^ awr_muldiv_add_part(a, b, 0, awr_wad(), 0);
}

!awr_wrong_floor_div(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ^ awr_muldiv_add_part(a, awr_wad(), 0, b, 0);
}

!awr_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!awr_wrong_wad_to_ray(a: int) -> int {
  ^ a * awr_ratio();
}

!awr_test_suite() -> int {
  w = awr_wad();
  h = awr_half_wad();
  ?(awr_wad_mul(w, w) != w) { ^ -1; };
  ?(awr_wad_mul(w + w, w + w) != (w + w + w + w)) { ^ -2; };
  ?(awr_wad_mul(3, h) != 2) { ^ -3; };
  ?(awr_wrong_floor_mul(3, h) != 1) { ^ -4; };
  ?(awr_wad_div(2, 3) != 666666666666666667) { ^ -5; };
  ?(awr_wrong_floor_div(2, 3) != 666666666666666666) { ^ -6; };
  ?(awr_wad_div(1, 3) != 333333333333333333) { ^ -7; };
  ?(awr_wrong_floor_div(1, 3) != 333333333333333333) { ^ -8; };
  ?(awr_wad_mul(0, w) != 0) { ^ -9; };
  ?(awr_wad_div(w, w + w) != h) { ^ -10; };
  ?(awr_wad_mul(w + w + w, w + w + w) != 9000000000000000000) { ^ -11; };
  ?(awr_naive_i64_mul(w + w + w, w + w + w) != 5595889181738926080) { ^ -12; };
  ?(awr_wad_mul_ok(w + w + w + w, w + w + w) != 0) { ^ -13; };
  ?(awr_wad_mul(w + w + w + w, w + w + w) != 0) { ^ -14; };
  ?(awr_ray_fits() != 0) { ^ -15; };
  ?(awr_wad_to_ray_ok(w) != 0) { ^ -16; };
  ?(awr_wad_to_ray(w) != 0) { ^ -17; };
  ?(awr_wrong_wad_to_ray(w) != -6930898827444486144) { ^ -18; };
  ?(awr_sray_mul(3, awr_half_sray()) != 2) { ^ -19; };
  ?(awr_wad_mul(1, 1) != 0) { ^ -20; };
  ?(awr_wad_div(w, w) != w) { ^ -21; };
  ?(awr_wad_mul_ok(0, w) != 1) { ^ -22; };
  ?(awr_wad_div_ok(1, 0) != 0) { ^ -23; };
  ?(awr_wad_to_ray(0) != 0) { ^ -24; };
  ?(awr_wad_to_ray(1) != 1000000000) { ^ -25; };
  ^ 1;
}

=ex{
  awr_u_lt,
  awr_u_add_carry,
  awr_mask32,
  awr_wad,
  awr_half_wad,
  awr_ratio,
  awr_sray,
  awr_half_sray,
  awr_ray_fits,
  awr_muldiv_add_part,
  awr_muldiv_add,
  awr_wad_mul_ok,
  awr_wad_mul,
  awr_wad_div_ok,
  awr_wad_div,
  awr_wad_to_ray_ok,
  awr_wad_to_ray,
  awr_sray_mul,
  awr_wrong_floor_mul,
  awr_wrong_floor_div,
  awr_naive_i64_mul,
  awr_wrong_wad_to_ray,
  awr_test_suite
}
