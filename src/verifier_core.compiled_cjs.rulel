.source{content="/* generated by lin-rewrite 2.0.0 */\n/* effect:Write */function deepEq(a,b){var ka,kb,k,i,j;if(a === b){return true;}if(typeof a !== typeof b){return false;}if(a === null || b === null){return false;}if(Array.isArray(a) && Array.isArray(b)){if(a.length !== b.length){return false;}for(i = 0;i < a.length;i++){if(!deepEq(a[i], b[i])){return false;}}return true;}if(typeof a === \"object\" && typeof b === \"object\"){ka = Object.keys(a);kb = Object.keys(b);if(ka.length !== kb.length){return false;}for(j = 0;j < ka.length;j++){k = ka[j];if(!deepEq(a[k], b[k])){return false;}}return true;}return (Number.isNaN(a) && Number.isNaN(b));}\n/* effect:Read */function findMissingExports(fnNamesList,exportsList){var fnSet,missing,e,k;fnSet = fnNamesList;missing = [];for(k = 0;k < exportsList.length;k++){e = exportsList[k].split(/\\s+as\\s+/)[0].trim();if(!fnSet.includes(e)){missing.push(e);}}return missing;}\nmodule.exports={deepEq,findMissingExports};\nmodule.exports={deepEq,findMissingExports};\n"}
