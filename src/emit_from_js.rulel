@RULEL:BOOTSTRAP_EMIT_FROM_JS:1.0.0
~METADATA{original="./src/emit_from_js.mjs" lang="mjs" role="bootstrap_reference"}
.source{
import { tokenize } from './lexer.mjs';

export class EmitJsUnsupportedError extends Error {
  constructor(message) {
    super(`LIN_EMIT_JS_UNSUPPORTED: ${message}`);
    this.name = 'EmitJsUnsupportedError';
  }
}

export function emitLinFromJs(jsSource, opts = {}) {
  const toks = tokenize(stripComments(jsSource));
  const fns = [];
  const topLevelVars = [];
  const consts = {};
  let i = 0;
  while (i < toks.length && toks[i].type !== 'eof') {
    const t = toks[i];
    if (t.type === 'nl') {
      i++;
      continue;
    }
    if (t.type === 'id' && t.value === 'var' && toks[i + 1]?.value === '$K') {
      i = parseConstObj(toks, i + 3, consts);
      continue;
    }
    if (t.type === 'id' && t.value === 'function') {
      let nameTok = toks[i + 1];
      let k = i + 1;
      let fname;
      if (toks[k]?.type === 'id') {
        fname = toks[k].value;
        k++;
      } else if (toks[k]?.value === '(') {
        fname = `_anon${fns.length}`;
      } else {
        throw new EmitJsUnsupportedError('bad function decl');
      }
      const openParenF = toks[k];
      if (!openParenF || openParenF.value !== '(') throw new EmitJsUnsupportedError('bad function decl');
      const closeParenF = matchBracket(toks, k);
      const params = sliceToks(toks, k + 1, closeParenF).trim();
      let openBrace = closeParenF + 1;
      while (openBrace < toks.length && toks[openBrace].value !== '{' && toks[openBrace].value !== ';') openBrace++;
      if (toks[openBrace]?.value === ';') {
        i = openBrace + 1;
        continue;
      }
      if (!toks[openBrace] || toks[openBrace].value !== '{') throw new EmitJsUnsupportedError('fn missing body');
      const closeBrace = matchBracket(toks, openBrace);
      fns.push({ name: fname, params: normalizeParams(params), body: sliceToks(toks, openBrace + 1, closeBrace) });
      i = closeBrace + 1;
      if (toks[i]?.value === ';') i++;
      continue;
    }
    if (t.type === 'id' && ['var', 'let', 'const'].includes(t.value)) {
      const nameTok = toks[i + 1];
      const isArrow = toks[i + 3]?.value === '(' ;
      const isNamedFn = toks[i + 3]?.value === 'function';
      if (!nameTok || nameTok.type !== 'id' || toks[i + 2]?.value !== '=' ) {
        i = skipStatement(toks, i);
        continue;
      }
      if (!isNamedFn) {
        const bareParam = toks[i + 3];
        const bareArrow = toks[i + 4];
        if (bareParam && bareParam.type === 'id' && bareArrow && bareArrow.value === '=>') {
          const paramsRaw = bareParam.value;
          let bodyOut;
          let after;
          if (toks[i + 5]?.value === '{') {
            const cb = matchBracket(toks, i + 5);
            bodyOut = sliceToks(toks, i + 6, cb);
            after = cb + 1;
          } else {
            let e = i + 5;
            let d2 = 0;
            for (; e < toks.length; e++) {
              const tk = toks[e];
              if (tk.type === 'punct') {
                if ('([{'.includes(tk.value)) d2++;
                else if (')]}'.includes(tk.value)) {
                  d2--;
                  if (d2 < 0) break;
                } else if (d2 === 0 && tk.value === ';') break;
              } else if (tk.type === 'nl' && d2 === 0) break;
            }
            bodyOut = `return ${sliceToks(toks, i + 5, e)};`;
            after = e;
          }
          fns.push({ name: nameTok.value, params: normalizeParams(paramsRaw), body: bodyOut });
          i = after;
          if (toks[i]?.value === ';') i++;
          continue;
        }
        const initStart = i + 3;
        let j = initStart;
        let depth = 0;
        for (; j < toks.length; j++) {
          const tk = toks[j];
          if (tk.type === 'punct') {
            if ('([{'.includes(tk.value)) depth++;
            else if (')]}'.includes(tk.value)) {
              depth--;
              if (depth === 0) {
                j++;
                break;
              }
            } else if (depth === 0 && tk.value === ';') break;
          } else if (tk.type === 'nl' && depth === 0) break;
        }
        const initText = sliceToks(toks, initStart, j).trim();
        if (/^\(/.test(initText)) {
          const arrowBodyIdx = findArrowAfterParamsToks(toks, initStart, j);
          if (arrowBodyIdx >= 0) {
            const closeParen = matchBracket(toks, initStart);
            const paramsRaw = sliceToks(toks, initStart + 1, closeParen).trim();
            let bodyOut;
            let after;
            let pArrow = closeParen + 1;
            while (toks[pArrow]?.type === 'nl') pArrow++;
            const arrowTok = toks[pArrow];
            const splitEq = toks[pArrow];
            const splitGt = toks[pArrow + 1];
            const isArrowTok = arrowTok && arrowTok.value === '=>';
            const isSplitArrow = splitEq && splitEq.value === '=' && splitGt && splitGt.value === '>';
            let bodyStart = isArrowTok ? pArrow + 1 : (isSplitArrow ? pArrow + 2 : -1);
            while (bodyStart >= 0 && toks[bodyStart]?.type === 'nl') bodyStart++;
            if (bodyStart >= 0 && toks[bodyStart]?.value === '{') {
              const cb = matchBracket(toks, bodyStart);
              bodyOut = sliceToks(toks, bodyStart + 1, cb);
              after = cb + 1;
            } else if (bodyStart >= 0) {
              let e = bodyStart;
              let d2 = 0;
              for (; e < toks.length; e++) {
                const tk = toks[e];
                if (tk.type === 'punct') {
                  if ('([{'.includes(tk.value)) d2++;
                  else if (')]}'.includes(tk.value)) {
                    d2--;
                    if (d2 < 0) break;
                  } else if (d2 === 0 && tk.value === ';') break;
                } else if (tk.type === 'nl' && d2 === 0) break;
              }
              bodyOut = `return ${sliceToks(toks, bodyStart, e)};`;
              after = e;
            } else {
              throw new EmitJsUnsupportedError(`top-level ${t.value} ${nameTok.value} = ${initText.slice(0, 40)}`);
            }
            fns.push({ name: nameTok.value, params: normalizeParams(paramsRaw), body: bodyOut });
            topLevelVars.length;
            i = after;
            if (toks[i]?.value === ';') i++;
            continue;
          }
        }
        if (/\bfunction\b/.test(initText)) {
          let eq = i + 2;
          while (eq < toks.length && toks[eq].value !== '=' && toks[eq].value !== '{') eq++;
          let brace = eq;
          while (brace < toks.length && toks[brace].value !== '{') brace++;
          if (toks[brace]?.value === '{') {
            i = brace + 1;
            continue;
          }
          i = skipStatement(toks, i);
          continue;
        }
        topLevelVars.push({ name: nameTok.value, init: initText });
        i = j;
        if (toks[i]?.value === ';') i++;
        continue;
      }
      const openParen = toks[i + 4];
      void isArrow;
      const fnKwTok = toks[i + 3];
      if (!fnKwTok || fnKwTok.value !== 'function') {
        i = skipStatement(toks, i);
        continue;
      }
      let k = i + 5;
      if (toks[k]?.type === 'id') k++;
      const openParenF = toks[k];
      if (!openParenF || openParenF.value !== '(') throw new EmitJsUnsupportedError('fn missing params');
      const closeParenF = matchBracket(toks, k);
      const params = sliceToks(toks, k + 1, closeParenF).trim();
      const openBrace = closeParenF + 1;
      if (!toks[openBrace] || toks[openBrace].value !== '{') throw new EmitJsUnsupportedError('fn missing body');
      const closeBrace = matchBracket(toks, openBrace);
      fns.push({ name: nameTok.value, params: normalizeParams(params), body: sliceToks(toks, openBrace + 1, closeBrace) });
      i = closeBrace + 1;
      if (toks[i]?.value === ';') i++;
      continue;
    }
    if (t.type === 'id' && (t.value === 'export' || t.value === 'default')) {
      if (toks[i + 1] && toks[i + 1].type === 'id' && ['function', 'default', 'const', 'let', 'var', 'async', 'class'].includes(toks[i + 1].value)) {
        i++;
        continue;
      }
      i = skipStatement(toks, i);
      continue;
    }
    if (t.type === 'id' && (t.value === 'import' || t.value === 'from' || t.value === 'try' || t.value === 'catch' || t.value === 'finally' || t.value === 'class' || t.value === 'async' || t.value === 'if' || t.value === 'else')) {
      let n = i + 1;
      while (n < toks.length && toks[n].type === 'nl') n++;
      if (toks[n]?.value === ':' || toks[n]?.value === '=') {
        if (toks[n + 1]?.value === 'function' || (toks[n + 1]?.type === 'nl')) {
          let m = n + 1;
          while (m < toks.length && toks[m].type === 'nl') m++;
          if (toks[m]?.value === 'function') {
            i = m;
            continue;
          }
        }
      } else {
      if (t.value === 'async' && toks[i + 1] && toks[i + 1].value === 'function') {
        i++;
        continue;
      }
      if (t.value === 'class') {
        while (i < toks.length && toks[i].value !== '{') i++;
        if (toks[i]?.value === '{') i++;
        continue;
      }
      if (t.value === 'if' || t.value === 'else') {
        while (i < toks.length && toks[i].value !== '{') i++;
        if (toks[i]?.value === '{') i++;
        continue;
      }
      i = skipStatement(toks, i);
      continue;
      }
    }
    if (t.type === 'comment') {
      i++;
      continue;
    }
    if (t.type === 'punct' && t.value === '=>') {
      i = skipStatement(toks, i);
      continue;
    }
    if (t.type === 'id' && (t.value === 'module' || t.value === 'exports')) {
      if (t.value === 'module' && toks[i + 1]?.value === '.' && toks[i + 2]?.value === 'exports' && toks[i + 3]?.value === '=') {
        let n = i + 4;
        while (n < toks.length && toks[n].type === 'nl') n++;
        if (toks[n]?.value === 'function') {
          i = n;
          continue;
        }
        if (toks[n]?.value === '{') {
          i = n + 1;
          continue;
        }
      }
      i = skipStatement(toks, i);
      continue;
    }
    if (t.type === 'punct' && t.value === '}') {
      i++;
      continue;
    }
    if (t.type === 'punct' && t.value === '(') {
      let k = i + 1;
      while (k < toks.length && toks[k].type === 'nl') k++;
      if (toks[k]?.value === 'function') {
        while (k < toks.length && toks[k].value !== '{') k++;
        if (toks[k]?.value === '{') { i = k + 1; continue; }
      }
      i = skipStatement(toks, i);
      continue;
    }
    if (t.type === 'punct' && (t.value === '.' || t.value === ')' || t.value === ']')) {
      i++;
      continue;
    }
    if (t.type === 'punct' && (t.value === '{' || t.value === '=' || t.value === '>' || t.value === '*')) {
      i = skipStatement(toks, i);
      continue;
    }
    if (t.type === 'punct') {
      i++;
      continue;
    }
    if (t.type === 'str' && /^['"]use strict['"]$/.test(t.value)) {
      i++;
      if (this && this.eat) {}
      while (i < toks.length && toks[i].type === 'punct' && toks[i].value === ';') i++;
      continue;
    }
    if (t.type === 'str') {
      i++;
      continue;
    }
    if (t.type === 'id') {
      let n0 = i + 1;
      while (n0 < toks.length && toks[n0].type === 'nl') n0++;
      if (toks[n0]?.value === '(') {
        const closeParenF = matchBracket(toks, n0);
        const params = sliceToks(toks, n0 + 1, closeParenF).trim();
        let openBrace = closeParenF + 1;
        while (openBrace < toks.length && toks[openBrace].type === 'nl') openBrace++;
        if (toks[openBrace]?.value === '{') {
          const closeBrace = matchBracket(toks, openBrace);
          fns.push({ name: t.value, params: normalizeParams(params), body: sliceToks(toks, openBrace + 1, closeBrace) });
          i = closeBrace + 1;
          continue;
        }
      }
      let k = i + 1;
      while (k < toks.length && (toks[k].type === 'nl' || toks[k].value === '.' || toks[k].type === 'id' || toks[k].value === '[' || toks[k].value === ']')) k++;
      if (toks[k]?.value === ':' || toks[k]?.value === '=') {
        let n = k + 1;
        while (n < toks.length && toks[n].type === 'nl') n++;
        if (toks[n]?.value === 'function') {
          i = n;
          continue;
        }
      }
      let depth = 0;
      let sawFn = -1;
      let sawArrow = -1;
      for (let n = i; n < toks.length; n++) {
        const tk = toks[n];
        if (tk.value === '(' || tk.value === '{') depth++;
        else if (tk.value === ')' || tk.value === '}') {
          depth--;
          if (depth < 0) break;
        } else if (tk.value === 'function') {
          sawFn = n;
          break;
        } else if (tk.value === '=>') {
          sawArrow = n;
          break;
        } else if (depth === 0 && tk.value === ';') break;
      }
      if (sawFn >= 0) {
        i = sawFn;
        continue;
      }
      if (sawArrow >= 0) {
        let p = sawArrow - 1;
        while (p > i && toks[p].type === 'nl') p--;
        let paramsRaw = '';
        if (toks[p]?.value === ')') {
          let d2 = 0;
          let open = p;
          for (let q = p; q >= i; q--) {
            if (toks[q].value === ')') d2++;
            else if (toks[q].value === '(') {
              d2--;
              if (d2 === 0) { open = q; break; }
            }
          }
          paramsRaw = sliceToks(toks, open + 1, p).trim();
        } else if (toks[p]?.type === 'id') {
          paramsRaw = toks[p].value;
        }
        let bodyStart = sawArrow + 1;
        while (bodyStart < toks.length && toks[bodyStart].type === 'nl') bodyStart++;
        let bodyOut;
        let after;
        if (toks[bodyStart]?.value === '{') {
          const cb = matchBracket(toks, bodyStart);
          bodyOut = sliceToks(toks, bodyStart + 1, cb);
          after = cb + 1;
        } else {
          let e = bodyStart;
          let d3 = 0;
          for (; e < toks.length; e++) {
            const tk = toks[e];
            if (tk.value === '(' || tk.value === '{') d3++;
            else if (tk.value === ')' || tk.value === '}') {
              d3--;
              if (d3 < 0) break;
            } else if (d3 === 0 && (tk.value === ';' || tk.value === ',')) break;
          }
          bodyOut = `^${sliceToks(toks, bodyStart, e)}`;
          after = e;
        }
        fns.push({ name: `_anon${fns.length}`, params: normalizeParams(paramsRaw), body: bodyOut });
        i = after;
        continue;
      }
      i = skipStatement(toks, i);
      if (i <= k && i === i) i = Math.max(i, k) + 1;
      continue;
    }
    i++;
  }
  if (!fns.length) throw new EmitJsUnsupportedError('no functions found');
  void opts;
  const lines = ['@LIN:L1c:0.2', '^schema_once ^lossy=true ^ops=emit_from_js', '~G{?=if #=for ^=ret :else}'];
  for (const fn of fns) {
    let __body = rewriteBody(fn.body);
    if (topLevelVars.length) {
      __body = topLevelVars.map((tv) => `${tv.name}=${tv.init};`).join('') + __body;
    }
    lines.push(`!${fn.name}(${fn.params}){${__body}}`);
  }
  lines.push(`=ex{${fns.map((f) => f.name).join(',')}}`);
  return { lin: lines.join('\n'), fns: fns.map((f) => f.name), consts, topLevelVars };
}

function stripComments(src) {
  return String(src || '').replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/[^\n]*$/gm, '');
}

function parseConstObj(toks, start, out) {
  let depth = 1;
  let i = start;
  let key = null;
  for (; i < toks.length && depth > 0; i++) {
    const t = toks[i];
    if (t.value === '{') depth++;
    else if (t.value === '}') {
      depth--;
      continue;
    }
    if (depth === 0) break;
    if (t.type === 'str' && toks[i + 1]?.value === ':') {
      key = unquote(t.value);
      i++;
      continue;
    }
    if (key != null && t.value !== ',') {
      out[key] = collectValueText(toks, i);
      const nextI = skipValueToks(toks, i);
      i = nextI - 1;
      key = null;
    }
  }
  return i;
}

function collectValueText(toks, i) {
  let text = '';
  let j = i;
  while (j < toks.length && !['}', ','].includes(toks[j].value)) {
    text += (text ? '' : '') + toks[j].value;
    j++;
    if (toks[j] && !['}', ',', ':'].includes(toks[j].value) && toks[j].type !== 'nl') continue;
    break;
  }
  return text;
}

function skipValueToks(toks, i) {
  let j = i;
  while (j < toks.length && !['}', ','].includes(toks[j].value)) j++;
  return j;
}

function unquote(s) {
  return String(s).replace(/^["']|["']$/g, '');
}

function matchBracket(toks, openIdx) {
  const openCh = toks[openIdx].value;
  const pairs = { '(': ')', '[': ']', '{': '}' };
  let depth = 0;
  for (let i = openIdx; i < toks.length; i++) {
    const t = toks[i];
    if (t.type !== 'punct') continue;
    if ('([{'.includes(t.value)) depth++;
    else if (')]}'.includes(t.value)) {
      depth--;
      if (depth === 0 && t.value === pairs[openCh]) return i;
    }
  }
  throw new EmitJsUnsupportedError(`unmatched ${openCh}`);
}

function sliceToks(toks, from, toExclusive) {
  if (toExclusive <= from) return '';
  const parts = [];
  for (let i = from; i < toExclusive; i++) {
    const t = toks[i];
    if (t.type === 'nl') continue;
    const prev = parts[parts.length - 1];
    const needsSpace = prev && /[A-Za-z0-9_$)]$/.test(prev) && /^[A-Za-z0-9_$'\"`]/.test(t.value);
    parts.push((needsSpace ? ' ' : '') + t.value);
  }
  return parts.join('').trim();
}

export function normalizeParams(paramsRaw) {
  const s = String(paramsRaw || '');
  const parts = [];
  let cur = '';
  let d = 0;
  for (const ch of s) {
    if ('{[('.includes(ch)) d++;
    else if (']})'.includes(ch)) d--;
    if (ch === ',' && d === 0) {
      parts.push(cur);
      cur = '';
    } else cur += ch;
  }
  if (cur) parts.push(cur);
  return parts
    .map((p) => p.trim())
    .filter(Boolean)
    .map((p) => {
      let depth = 0;
      let lastEq = -1;
      for (let i = 0; i < p.length; i++) {
        const ch = p[i];
        if ('{[('.includes(ch)) depth++;
        else if (']})'.includes(ch)) depth--;
        else if (ch === '=' && depth === 0) lastEq = i;
      }
      if (lastEq >= 0) p = p.slice(0, lastEq).trim();
      const dm = p.match(/^\{([^}]*)\}$/);
      if (dm) {
        return dm[1]
          .split(',')
          .map((x) => {
            const eq = x.indexOf('=');
            const core = (eq >= 0 ? x.slice(0, eq) : x).trim();
            return core.split(':')[0].trim();
          })
          .filter(Boolean)
          .join(',');
      }
      return p.replace(/:[^,]+$/, '').replace(/\?$/, '').trim();
    })
    .filter(Boolean)
    .join(',');
}

export function rewriteBody(body) {
  const lowered = lowerSwitches(String(body));
  const { masked, restore } = maskRegexLiterals(lowered);
  let s = masked;
  s = s.replace(/\breturn\s+(?=[A-Za-z_$0-9(\[\-+!'"`{])/g, '\u0001');
  s = s.replace(/(^|[;{}])\^/g, '$1\u0001');
  s = s.replace(/\u0001/g, '^');
  s = rewriteSigilBlocks(s, '?');
  s = rewriteElseBlocks(s);
  s = rewriteSigilBlocks(s, '#');
  s = normalizeBracelessControl(s);
  s = s.replace(/;\s*\^/g, ';^');
  return restore(s.trim().replace(/;+$/, ''));
}

export function lowerSwitches(src) {
  let out = String(src || '');
  let guard = 0;
  for (;;) {
    if (guard++ > 20) break;
    const idx = findTopLevelSwitch(out);
    if (idx < 0) break;
    const conv = tryConvertSwitch(out, idx);
    if (!conv) break;
    out = conv;
  }
  return out;
}

function maskSwitchBlocks(src) {
  const table = [];
  let out = '';
  let i = 0;
  while (i < src.length) {
    const m = /\bswitch\s*\(/.exec(src.slice(i));
    if (!m) {
      out += src[i];
      i++;
      continue;
    }
    const openParen = i + src.slice(i).indexOf('(');
    const closeParen = findMatchingIn(src, openParen, '(', ')');
    if (closeParen < 0) {
      out += src[i];
      i++;
      continue;
    }
    let j = closeParen + 1;
    while (j < src.length && /\\s/.test(src[j])) j++;
    if (src[j] !== '{') {
      out += src[i];
      i++;
      continue;
    }
    const closeBrace = findMatchingIn(src, j, '{', '}');
    if (closeBrace < 0) {
      out += src[i];
      i++;
      continue;
    }
    table.push(src.slice(i, closeBrace + 1));
    out += `\u0004S${table.length - 1}\u0004`;
    i = closeBrace + 1;
  }
  return {
    masked: out,
    restore: (text) => text.replace(/\u0004S(\d+)\u0004/g, (_, n) => table[Number(n)] ?? ''),
  };
}

const CTRL_OPEN = /(?:^|[;{}])\s*(?:else\s+)?(if|while|for)\s*\(/g;
const ELSE_OPEN = /(?:^|[;{}])\s*else\b(?!\s*(?:\{|if\b))/g;

function normalizeBracelessControl(s) {
  for (let guard = 0; guard < 100; guard++) {
    let changed = false;
    const re = new RegExp(CTRL_OPEN.source, 'g');
    let m;
    while ((m = re.exec(s)) !== null) {
      const openParen = m.index + m[0].length - 1;
      const closeParen = findMatchingIn(s, openParen, '(', ')');
      if (closeParen < 0) continue;
      let j = closeParen + 1;
      while (j < s.length && /\s/.test(s[j])) j++;
      if (s[j] === '{') continue;
      const stmtEnd = findStmtEnd(s, j);
      const wrapped = `${s.slice(0, j)}{${s.slice(j, stmtEnd)}}${s.slice(stmtEnd)}`;
      s = wrapped;
      changed = true;
      break;
    }
    if (!changed) {
      const re2 = new RegExp(ELSE_OPEN.source, 'g');
      let m2;
      while ((m2 = re2.exec(s)) !== null) {
        let j = m2.index + m2[0].length;
        while (j < s.length && /\s/.test(s[j])) j++;
        if (s[j] === '{' || s.slice(j, j + 3) === 'if ') continue;
        const stmtEnd = findStmtEnd(s, j);
        const wrapped = `${s.slice(0, j)}{${s.slice(j, stmtEnd)}}${s.slice(stmtEnd)}`;
        s = wrapped;
        changed = true;
        break;
      }
    }
    if (!changed) break;
  }
  return s;
}

const REGEX_PREV_RE = /[=(:,;!?{[&|^~+\-*%<>\[]$/;
function maskRegexLiterals(src) {
  const table = [];
  let out = '';
  let i = 0;
  while (i < src.length) {
    const c = src[i];
    if (c === '"' || c === "'" || c === '`') {
      const q = c;
      out += c;
      i++;
      while (i < src.length) {
        if (src[i] === '\\') {
          out += src[i] + (src[i + 1] || '');
          i += 2;
          continue;
        }
        out += src[i];
        if (src[i] === q) {
          i++;
          break;
        }
        i++;
      }
      continue;
    }
    if (c === '/' && src[i + 1] !== '/' && src[i + 1] !== '*') {
      const before = out.replace(/\s+$/, '');
      const kwMatch = before.match(/([A-Za-z_$][\w$]*)$/);
      let isRegex;
      if (kwMatch) {
        isRegex = ['return', 'typeof', 'instanceof', 'in', 'of', 'new', 'delete', 'void', 'do', 'else', 'case', 'yield', 'await', 'match'].includes(kwMatch[1]);
      } else {
        isRegex = before.length === 0 || REGEX_PREV_RE.test(before);
      }
      if (isRegex) {
        let j = i + 1;
        let inClass = false;
        let ok = false;
        while (j < src.length) {
          const ch = src[j];
          if (ch === '\\') {
            j += 2;
            continue;
          }
          if (ch === '\n') break;
          if (ch === '[') inClass = true;
          else if (ch === ']') inClass = false;
          else if (ch === '/' && !inClass) {
            j++;
            while (j < src.length && /[gimsuyvd]/.test(src[j])) j++;
            ok = true;
            break;
          }
          j++;
        }
        if (ok) {
          table.push(src.slice(i, j));
          out += `\u0003R${table.length - 1}\u0003`;
          i = j;
          continue;
        }
      }
    }
    out += c;
    i++;
  }
  return {
    masked: out,
    restore: (text) => text.replace(/\u0003R(\d+)\u0003/g, (_, n) => table[Number(n)] ?? ''),
  };
}

function findMatchingIn(s, openIdx, openCh, closeCh) {
  let depth = 0;
  let quote = null;
  for (let i = openIdx; i < s.length; i++) {
    const c = s[i];
    if (quote) {
      if (c === '\\') i++;
      else if (c === quote) quote = null;
      continue;
    }
    if (c === '"' || c === "'" || c === '`') {
      quote = c;
      continue;
    }
    if (c === openCh) depth++;
    else if (c === closeCh) {
      depth--;
      if (depth === 0) return i;
    }
  }
  return -1;
}

function rewriteSigilBlocks(s, sigil) {
  let out = '';
  let i = 0;
  const token = sigil + '(';
  while (i < s.length) {
    const idx = s.indexOf(token, i);
    if (idx < 0) {
      out += s.slice(i);
      break;
    }
    const prevChar = idx > 0 ? s[idx - 1] : '';
    if (sigil === '?' && /[A-Za-z0-9_)$\]]/.test(prevChar)) {
      out += s.slice(i, idx + 1);
      i = idx + 1;
      continue;
    }
    if (sigil === '#' && /[A-Za-z0-9_)$\]]/.test(prevChar)) {
      out += s.slice(i, idx + 1);
      i = idx + 1;
      continue;
    }
    const openParen = idx + 1;
    const closeParen = findMatchingIn(s, openParen, '(', ')');
    if (closeParen < 0) {
      out += s.slice(i, idx + token.length);
      i = idx + token.length;
      continue;
    }
    let j = closeParen + 1;
    while (j < s.length && /\s/.test(s[j])) j++;
    let inner;
    let after;
    if (s[j] === '{') {
      const closeBrace = findMatchingIn(s, j, '{', '}');
      if (closeBrace < 0) {
        out += s.slice(i, idx + token.length);
        i = idx + token.length;
        continue;
      }
      inner = rewriteBody(s.slice(j + 1, closeBrace));
      after = closeBrace + 1;
    } else {
      const stmtEnd = findStmtEnd(s, j);
      inner = rewriteBody(s.slice(j, stmtEnd));
      inner = inner.trim().replace(/;$/, '');
      after = stmtEnd;
    }
    const head = s.slice(openParen + 1, closeParen);
    out += s.slice(i, idx) + `${sigil}(${head}){${inner}}`;
    i = after;
  }
  return out;
}

function findStmtEnd(s, from) {
  let depth = 0;
  let quote = null;
  for (let i = from; i < s.length; i++) {
    const c = s[i];
    if (quote) {
      if (c === '\\') i++;
      else if (c === quote) quote = null;
      continue;
    }
    if (c === '"' || c === "'" || c === '`') {
      quote = c;
      continue;
    }
    if ('([{'.includes(c)) depth++;
    else if (')]}'.includes(c)) depth--;
    else if (depth === 0 && c === ';') return i + 1;
    else if (depth === 0 && c === '}' ) return i;
  }
  return s.length;
}

function rewriteElseBlocks(s) {
  let out = '';
  let i = 0;
  while (i < s.length) {
    const idx = s.indexOf('else', i);
    if (idx < 0) {
      out += s.slice(i);
      break;
    }
    const beforeOk = idx === 0 || /[^A-Za-z0-9_$]/.test(s[idx - 1]);
    if (!beforeOk) {
      out += s.slice(i, idx + 4);
      i = idx + 4;
      continue;
    }
    let j = idx + 4;
    while (j < s.length && /\s/.test(s[j])) j++;
    if (s.slice(j, j + 2) === 'if' ) {
      let k = j + 2;
      while (k < s.length && /\s/.test(s[k])) k++;
      if (s[k] === '(') {
        const closeParen = findMatchingIn(s, k, '(', ')');
        if (closeParen >= 0) {
          let m = closeParen + 1;
          while (m < s.length && /\s/.test(s[m])) m++;
          if (s[m] === '{') {
            const closeBrace = findMatchingIn(s, m, '{', '}');
            if (closeBrace >= 0) {
              const head = s.slice(k + 1, closeParen);
              const inner = rewriteBody(s.slice(m + 1, closeBrace));
              out += s.slice(i, idx) + `:( ${head} ){${inner}}`;
              i = closeBrace + 1;
              continue;
            }
          }
        }
      }
    }
    if (s[j] === '{') {
      const closeBrace = findMatchingIn(s, j, '{', '}');
      if (closeBrace >= 0) {
        const inner = rewriteBody(s.slice(j + 1, closeBrace));
        out += s.slice(i, idx) + `:{${inner}}`;
        i = closeBrace + 1;
        continue;
      }
    }
    out += s.slice(i, idx + 4);
    i = idx + 4;
  }
  return out;
}

function skipStatement(toks, from) {
  let depth = 0;
  let i = from;
  for (; i < toks.length; i++) {
    const t = toks[i];
    if (t.type === 'punct') {
      if ('([{'.includes(t.value)) depth++;
      else if (')]}'.includes(t.value)) {
        depth--;
        if (depth <= 0 && [';', 'nl', 'eof'].includes(toks[i + 1]?.type) ) return i + 1;
        if (depth < 0) return i + 1;
      } else if (depth === 0 && t.value === ';') return i + 1;
    }
  }
  return i;
}


function findArrowAfterParamsToks(toks, from, toExclusive) {
  let depth = 0;
  for (let j = from; j < Math.min(toExclusive + 2, toks.length); j++) {
    const tk = toks[j];
    if (tk.type === 'punct') {
      if ('([{'.includes(tk.value)) depth++;
      else if (')]}'.includes(tk.value)) depth--;
      else if (depth === 0 && tk.value === '=>') return j;
      else if (depth === 0 && tk.value === '=' && toks[j + 1]?.value === '>') return j;
    }
  }
  return -1;
}

function findTopLevelSwitch(s) {
  const re = /\bswitch\s*\(/g;
  let m;
  let depth = 0;
  let i = 0;
  while (i < s.length) {
    const c = s[i];
    if (c === '"' || c === "'" || c === '`') {
      const q = c;
      i++;
      while (i < s.length && s[i] !== q) {
        if (s[i] === '\\') i++;
        i++;
      }
      i++;
      continue;
    }
    if (c === '{') depth++;
    else if (c === '}') depth--;
    else {
      re.lastIndex = i;
      const mm = re.exec(s);
      if (mm && mm.index === i && depth === 0) return i;
    }
    i++;
  }
  void m;
  return -1;
}

function tryConvertSwitch(s, idx) {
  const openParen = s.indexOf('(', idx);
  const closeParen = matchBracketChar(s, openParen);
  if (closeParen < 0) return null;
  const disc = s.slice(openParen + 1, closeParen).trim();
  let j = closeParen + 1;
  while (j < s.length && /\s/.test(s[j])) j++;
  if (s[j] !== '{') return null;
  const closeBrace = matchBracketChar(s, j);
  if (closeBrace < 0) return null;
  const inner = s.slice(j + 1, closeBrace);

  const arms = [];
  let cur = { labels: [], body: [] };
  let i = 0;
  const n = inner.length;
  while (i < n) {
    while (i < n && /[\s;]/.test(inner[i])) i++;
    if (i >= n) break;
    if (startsWithWord(inner, i, 'case')) {
      i += 4;
      while (i < n && /[\s]/.test(inner[i])) i++;
      const vStart = i;
      let q = null;
      for (; i < n; i++) {
        const c = inner[i];
        if (q) {
          if (c === '\\') i++;
          else if (c === q) q = null;
          continue;
        }
        if (c === '"' || c === "'") q = c;
        else if (c === ':') break;
      }
      if (q || inner[i] !== ':') return null;
      cur = { labels: [], body: [] };
      arms.push(cur);
      cur.labels.push(inner.slice(vStart, i).trim());
      i++;
      continue;
    }
    if (startsWithWord(inner, i, 'default')) {
      i += 7;
      while (i < n && inner[i] !== ':') i++;
      i++;
      cur = { labels: [], body: [], def: true };
      arms.push(cur);
      continue;
    }
    let stmtEnd = i;
    let d2 = 0;
    let q2 = null;
    for (; stmtEnd < n; stmtEnd++) {
      const c = inner[stmtEnd];
      if (q2) {
        if (c === '\\') stmtEnd++;
        else if (c === q2) q2 = null;
        continue;
      }
      if (c === '"' || c === "'" || c === '`') {
        q2 = c;
        continue;
      }
      if ('([{'.includes(c)) d2++;
      else if (')]}'.includes(c)) d2--;
      else if (d2 === 0 && c === ';') {
        stmtEnd++;
        break;
      }
      if (d2 === 0) {
        const rest = inner.slice(stmtEnd);
        if (startsWithWord(rest, 0, 'case') || startsWithWord(rest, 0, 'default')) break;
      }
    }
    let stmt = inner.slice(i, stmtEnd).trim();
    stmt = stmt.replace(/^break\s*;?\s*$/, '').replace(/;\s*break\s*;?$/, ';');
    if (stmt) cur.body.push(stmt);
    i = stmtEnd;
  }

  if (!arms.length) return null;
  for (const arm of arms) {
    if (!arm.def && !arm.labels.length) return null;
    const last = arm.body[arm.body.length - 1] || '';
    if (arm.body.length && !/^(\^|return|throw|break)/.test(last.trim()) && !/^\^\s/.test(last.trim())) {
      if (!/^(return|\^)/.test(arm.body.join(';').trim())) return null;
    }
  }
  const hasDefault = arms.some((a) => a.def);
  const parts = [];
  let first = true;
  for (const arm of arms) {
    if (arm.def) continue;
    const condExpr = arm.labels.map((l) => `${disc}===${l}`).join('||');
    const bodyStr = arm.body.join(';');
    const prefix = first ? '?(' : ':?(';
    parts.push(`${prefix}${condExpr}){${bodyStr}}`);
    first = false;
  }
  const defArm = arms.find((a) => a.def);
  if (defArm && defArm.body.length) {
    parts.push(`:{${defArm.body.join(';')}}`);
  } else if (defArm) {
    parts.push(':{break}');
  }
  if (!first) {
    let chain = parts.join('');
    if (!hasDefault) chain += '';
    return s.slice(0, idx) + chain + s.slice(closeBrace + 1);
  }
  return s.slice(0, idx) + '/*switch_empty*/' + s.slice(closeBrace + 1);
}

function startsWithWord(text, i, word) {
  if (!text.startsWith(word, i)) return false;
  const before = i === 0 ? '' : text[i - 1];
  const after = text[i + word.length];
  if (/[\w$]/.test(before)) return false;
  if (/[\w$]/.test(after || '')) return false;
  return true;
}

function matchBracketChar(s, openIdx) {
  if (openIdx < 0 || openIdx >= s.length) return -1;
  const openCh = s[openIdx];
  const pairs = { '(': ')', '[': ']', '{': '}' };
  let depth = 0;
  let quote = null;
  for (let i = openIdx; i < s.length; i++) {
    const c = s[i];
    if (quote) {
      if (c === '\\') i++;
      else if (c === quote) quote = null;
      continue;
    }
    if (c === '"' || c === "'" || c === '`') {
      quote = c;
      continue;
    }
    if (c === openCh) depth++;
    else if (c === pairs[openCh]) {
      depth--;
      if (depth === 0) return i;
    }
  }
  return -1;
}

}
