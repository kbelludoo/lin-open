@LIN:L1c:0.2
@ROCKET_RETH_EXCHANGE{
  version=1
  repo="rocket-pool/rocketpool"
  source="contracts/contract/token/RocketTokenRETH.sol"
  license="GPL-3.0-only"
  tag="v1.4"
  commit="fb7d9c428dc3dddc3fbd3e634e3cb365655df89e"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_rocket_reth_exchange_with_128bit_muldiv"
  note="Not Solidity uint256. Empty rethSupply is 1:1 (not Lido empty-div0). Hidden getTotalETHBalance/getTotalRETHSupply become arguments. SafeMath .mul.div is 128-bit fail-closed. totalEth==0 with supply>0 fail-closes 0 (Solidity getRethValue reverts). Named contrast vs Lido / OZ +1/+1 / Morpho 1e6. getExchangeRate is getEthValue(1e18). 1e18*20/1 overflows uint64."
}

!rrt_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!rrt_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(rrt_u_lt(s, a));
}

!rrt_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(rrt_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!rrt_mask32() -> int {
  ^ 4294967295;
}

!rrt_ok_nn(v: int) -> int {
  ?(v < 0) { ^ 0; };
  ^ 1;
}

!rrt_ether() -> int {
  ^ 1000000000000000000;
}

!rrt_morpho_virt_shares() -> int {
  ^ 1000000;
}

!rrt_morpho_virt_assets() -> int {
  ^ 1;
}

!rrt_oz_virt_shares() -> int {
  ^ 1;
}

!rrt_oz_virt_assets() -> int {
  ^ 1;
}

!rrt_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = rrt_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = rrt_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = rrt_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(rrt_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = rrt_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want == 1) { ^ r_lo; };
  ?(want == 2) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!rrt_floor(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(rrt_ok_nn(x) == 0) { ^ 0; };
  ?(rrt_ok_nn(y) == 0) { ^ 0; };
  ^ rrt_muldiv_part(x, y, d, 0);
}

!rrt_rem(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(rrt_ok_nn(x) == 0) { ^ 0; };
  ?(rrt_ok_nn(y) == 0) { ^ 0; };
  ^ rrt_muldiv_part(x, y, d, 1);
}

!rrt_ov(x: int, y: int, d: int) -> int {
  ?(d == 0) { ^ 1; };
  ?(rrt_ok_nn(x) == 0) { ^ 1; };
  ?(rrt_ok_nn(y) == 0) { ^ 1; };
  ^ rrt_muldiv_part(x, y, d, 2);
}

!rrt_get_reth(eth: int, total_eth: int, reth_supply: int) -> int {
  ?(rrt_ok_nn(eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(reth_supply) == 0) { ^ 0; };
  ?(reth_supply == 0) { ^ eth; };
  ?(total_eth == 0) { ^ 0; };
  ^ rrt_floor(eth, reth_supply, total_eth);
}

!rrt_get_eth(reth: int, total_eth: int, reth_supply: int) -> int {
  ?(rrt_ok_nn(reth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(reth_supply) == 0) { ^ 0; };
  ?(reth_supply == 0) { ^ reth; };
  ^ rrt_floor(reth, total_eth, reth_supply);
}

!rrt_exchange_rate(total_eth: int, reth_supply: int) -> int {
  ^ rrt_get_eth(rrt_ether(), total_eth, reth_supply);
}

!rrt_lido_shares(eth: int, total_eth: int, total_shares: int) -> int {
  ?(rrt_ok_nn(eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_shares) == 0) { ^ 0; };
  ?(total_eth <= 0) { ^ 0; };
  ^ rrt_floor(eth, total_shares, total_eth);
}

!rrt_oz_shares(eth: int, total_eth: int, total_shares: int) -> int {
  ?(rrt_ok_nn(eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_shares) == 0) { ^ 0; };
  ?(rrt_u_add_ok(total_eth, rrt_oz_virt_assets()) == 0) { ^ 0; };
  ?(rrt_u_add_ok(total_shares, rrt_oz_virt_shares()) == 0) { ^ 0; };
  ^ rrt_floor(eth, total_shares + rrt_oz_virt_shares(), total_eth + rrt_oz_virt_assets());
}

!rrt_morpho_shares(eth: int, total_eth: int, total_shares: int) -> int {
  ?(rrt_ok_nn(eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_eth) == 0) { ^ 0; };
  ?(rrt_ok_nn(total_shares) == 0) { ^ 0; };
  ?(rrt_u_add_ok(total_eth, rrt_morpho_virt_assets()) == 0) { ^ 0; };
  ?(rrt_u_add_ok(total_shares, rrt_morpho_virt_shares()) == 0) { ^ 0; };
  ^ rrt_floor(eth, total_shares + rrt_morpho_virt_shares(), total_eth + rrt_morpho_virt_assets());
}

!rrt_test_suite() -> int {
  ?(rrt_floor(100, 200, 50) != 400) { ^ -1; };
  ?(rrt_floor(7, 9, 2) != 31) { ^ -2; };
  ?(rrt_rem(7, 9, 2) != 1) { ^ -3; };
  ?(rrt_floor(1000000000000000000, 1, 2) != 500000000000000000) { ^ -4; };
  ?(rrt_floor(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -5; };
  ?(rrt_ov(1000000000000000000, 1000000000000000000, 1) != 1) { ^ -6; };
  ?(rrt_get_reth(1000, 0, 0) != 1000) { ^ -7; };
  ?(rrt_get_eth(1000, 0, 0) != 1000) { ^ -8; };
  ?(rrt_lido_shares(1000, 0, 0) != 0) { ^ -9; };
  ?(rrt_oz_shares(1000, 0, 0) != 1000) { ^ -10; };
  ?(rrt_morpho_shares(1000, 0, 0) != 1000000000) { ^ -11; };
  ?(rrt_exchange_rate(0, 0) != 1000000000000000000) { ^ -12; };
  ?(rrt_get_reth(1000000, 1000001, 1) != 0) { ^ -13; };
  ?(rrt_lido_shares(1000000, 1000001, 1) != 0) { ^ -14; };
  ?(rrt_oz_shares(1000000, 1000001, 1) != 1) { ^ -15; };
  ?(rrt_morpho_shares(1000000, 1000001, 1000000) != 1999996) { ^ -16; };
  ?(rrt_get_reth(1000, 5000, 2000) != 400) { ^ -17; };
  ?(rrt_get_eth(400, 5000, 2000) != 1000) { ^ -18; };
  ?(rrt_get_reth(1000, 0, 2000) != 0) { ^ -19; };
  ?(rrt_get_eth(1000, 0, 2000) != 0) { ^ -20; };
  ?(rrt_get_reth(-1, 5, 5) != 0) { ^ -21; };
  ?(rrt_floor(7, 9, 0) != 0) { ^ -22; };
  ?(rrt_exchange_rate(20, 1) != 0) { ^ -23; };
  ^ 1;
}

=ex{
  rrt_u_lt,
  rrt_u_add_carry,
  rrt_u_add_ok,
  rrt_mask32,
  rrt_ok_nn,
  rrt_ether,
  rrt_morpho_virt_shares,
  rrt_morpho_virt_assets,
  rrt_oz_virt_shares,
  rrt_oz_virt_assets,
  rrt_muldiv_part,
  rrt_floor,
  rrt_rem,
  rrt_ov,
  rrt_get_reth,
  rrt_get_eth,
  rrt_exchange_rate,
  rrt_lido_shares,
  rrt_oz_shares,
  rrt_morpho_shares,
  rrt_test_suite
}
