@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=compatibility_matrix
~G{?=if #=for ^=ret :else}

!verify_behavior_equivalence(zig_result: int, lin_result: int) -> int {
    equiv = 0;
    ?(zig_result == lin_result) {
        equiv = 1;
    }
    ^equiv;
}

!evaluate_fuzz_differential_pass(test_id: int, input_scalar: int, zig_sum: int, lin_sum: int) -> int {
    match = 0;
    ?(zig_sum == lin_sum) {
        match = 1;
    }
    fuzz_audit_hash = (test_id * 65537) + (input_scalar * 257) + match;
    ^fuzz_audit_hash;
}

!audit_17_subgates_closure(subgates_mask: int) -> int {
    all_passed = 0;
    ?(subgates_mask == 131071) {
        all_passed = 1;
    }
    ^all_passed;
}

=ex{verify_behavior_equivalence, evaluate_fuzz_differential_pass, audit_17_subgates_closure}
