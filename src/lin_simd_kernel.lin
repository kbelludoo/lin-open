@LIN:L1c:0.2
@SIMD_KERNEL{version=1 scope=simd8_hardware_vectorization}

!simd_avalanche8(h: simd8_u32) -> simd8_u32 {
  hash: simd8_u32 = h;
  prime2: u32 = 2246822519;
  prime3: u32 = 3266489917;
  p2_vec: simd8_u32 = @splat(prime2);
  p3_vec: simd8_u32 = @splat(prime3);
  s15: simd8_u5 = @splat(15);
  s13: simd8_u5 = @splat(13);
  s16: simd8_u5 = @splat(16);

  hash = hash ^ (hash >> s15);
  hash = hash *% p2_vec;
  hash = hash ^ (hash >> s13);
  hash = hash *% p3_vec;
  ^hash ^ (hash >> s16);
}

=ex{simd_avalanche8}
