@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="src/transpile_hash_verify.mjs" lang="mjs"}
.source{content="// LIN Transpile Hash Verification — mandatory semantic + code hash gates on emit/transpile\nimport { createHash } from 'node:crypto';\nimport { compile } from './compiler.mjs';\nimport { parseProgram } from './parser.mjs';\nimport { programHashes } from './semantic_hash.mjs';\n\nexport const G_TRANSPIL_SEMANTIC_HASH = 'G_TRANSPIL_SEMANTIC_HASH';\nexport const G_TRANSPIL_CODE_HASH = 'G_TRANSPIL_CODE_HASH';\nexport const G_TRANSPIL_HASH = 'G_TRANSPIL_HASH';\n\nfunction sha256(text) {\n  return createHash('sha256').update(String(text), 'utf8').digest('hex');\n}\n\nexport function verifyTranspileOutput(linSource, opts = {}) {\n  if (opts.skipHashVerify) {\n    return { ok: true, gate: G_TRANSPIL_HASH, skipped: true };\n  }\n  const errors = [];\n  let prog;\n  try {\n    prog = parseProgram(linSource);\n  } catch (e) {\n    return { ok: false, gate: G_TRANSPIL_SEMANTIC_HASH, error: `parse: ${e.message}` };\n  }\n\n  const hashes1 = programHashes(prog);\n  const hashes2 = programHashes(prog);\n  const semanticOk = JSON.stringify(hashes1) === JSON.stringify(hashes2);\n  const hashValues = Object.values(hashes1);\n  const semanticNonEmpty = hashValues.length > 0 && hashValues.every((h) => /^[0-9a-f]{16}$/.test(h));\n\n  if (!semanticOk) errors.push('semantic hash unstable across re-computation');\n  if (!semanticNonEmpty) errors.push('semantic hash empty or invalid format');\n\n  let codeHash1;\n  let codeHash2;\n  try {\n    codeHash1 = sha256(compile(linSource, { target: 'js' }).code);\n    codeHash2 = sha256(compile(linSource, { target: 'js' }).code);\n  } catch (e) {\n    return {\n      ok: false,\n      gate: G_TRANSPIL_CODE_HASH,\n      semantic_hashes: hashes1,\n      error: `compile: ${e.message}`,\n    };\n  }\n\n  const codeOk = codeHash1 === codeHash2 && /^[0-9a-f]{64}$/.test(codeHash1);\n  if (!codeOk) errors.push('code hash unstable or invalid');\n\n  const ok = semanticOk && semanticNonEmpty && codeOk;\n  return {\n    ok,\n    gate: ok ? G_TRANSPIL_HASH : errors[0] || G_TRANSPIL_HASH,\n    semantic_hashes: hashes1,\n    semantic_hash: sha256(JSON.stringify(hashes1)).slice(0, 16),\n    code_hash: codeHash1,\n    code_hash_stable: codeOk,\n    semantic_hash_stable: semanticOk && semanticNonEmpty,\n    errors: ok ? [] : errors,\n  };\n}\n\nexport function verifyTranspileOutputOrThrow(linSource, opts = {}) {\n  const report = verifyTranspileOutput(linSource, opts);\n  if (!report.ok) {\n    throw new Error(`LIN_TRANSPIL_HASH: ${report.error || report.errors?.join('; ') || 'verification failed'}`);\n  }\n  return report;\n}\n\nexport function finalizeTranspileLin(lin, opts = {}) {\n  if (!opts.skipHashVerify) {\n    verifyTranspileOutputOrThrow(lin, opts);\n  }\n  return lin;\n}\n"}
