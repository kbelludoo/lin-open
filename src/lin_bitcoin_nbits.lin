@LIN:L1c:0.2
@BITCOIN_NBITS{
  version=1
  repo="bitcoin/bitcoin"
  source="src/pow.cpp CalculateNextWorkRequired + src/arith_uint256.cpp SetCompact/GetCompact"
  license="MIT"
  tag="v27.1"
  commit="1088a98f5aad080cc6cca2da174f206509fcda6c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="compact_nbits_difficulty_retarget_matching_core_pow_tests"
  note="Not a Bitcoin node. Compact nBits in/out. CBlockIndex and Consensus::Params are explicit arguments. Overflow/negative compact is fail-closed in btc_compact_ok, not silently flagged."
}

!btc_mask32() -> int {
  ^ 4294967295;
}

!btc_u32(x: int) -> int {
  ^ x & btc_mask32();
}

!btc_mant() -> int {
  ^ 8388607;
}

!btc_signbit() -> int {
  ^ 8388608;
}

!btc_get(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int, i: int) -> int {
  ?(i == 0) { ^ btc_u32(l0); };
  ?(i == 1) { ^ btc_u32(l1); };
  ?(i == 2) { ^ btc_u32(l2); };
  ?(i == 3) { ^ btc_u32(l3); };
  ?(i == 4) { ^ btc_u32(l4); };
  ?(i == 5) { ^ btc_u32(l5); };
  ?(i == 6) { ^ btc_u32(l6); };
  ^ btc_u32(l7);
}

!btc_word_bits(w: int) -> int {
  w = btc_u32(w);
  ?(w == 0) { ^ 0; };
  nbits = 31;
  while (nbits > 0) {
    ?( (w & _lia_shl(1, nbits)) != 0 ) { ^ nbits + 1; };
    nbits = nbits - 1;
  };
  ^ 1;
}

!btc_bits(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int) -> int {
  pos = 7;
  while (pos >= 0) {
    w = btc_get(l0, l1, l2, l3, l4, l5, l6, l7, pos);
    ?(w != 0) { ^ 32 * pos + btc_word_bits(w); };
    pos = pos - 1;
  };
  ^ 0;
}

!btc_shl_want(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int, shift: int, want: int) -> int {
  ?(shift <= 0) { ^ btc_get(l0, l1, l2, l3, l4, l5, l6, l7, want); };
  ?(want < 0) { ^ 0; };
  ?(want > 7) { ^ 0; };
  k = shift / 32;
  s = shift - k * 32;
  acc = 0;
  i = 0;
  while (i < 8) {
    a = btc_get(l0, l1, l2, l3, l4, l5, l6, l7, i);
    ?(i + k + 1 == want) {
      ?(s != 0) { acc = acc | _lia_ushr(a, 32 - s); };
    };
    ?(i + k == want) { acc = acc | _lia_shl(a, s); };
    i = i + 1;
  };
  ^ btc_u32(acc);
}

!btc_shr_want(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int, shift: int, want: int) -> int {
  ?(shift <= 0) { ^ btc_get(l0, l1, l2, l3, l4, l5, l6, l7, want); };
  ?(want < 0) { ^ 0; };
  ?(want > 7) { ^ 0; };
  k = shift / 32;
  s = shift - k * 32;
  acc = 0;
  i = 0;
  while (i < 8) {
    a = btc_get(l0, l1, l2, l3, l4, l5, l6, l7, i);
    ?(i - k - 1 == want) {
      ?(s != 0) { acc = acc | btc_u32(_lia_shl(a, 32 - s)); };
    };
    ?(i - k == want) { acc = acc | _lia_ushr(a, s); };
    i = i + 1;
  };
  ^ btc_u32(acc);
}

!btc_mul32_want(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int, m: int, want: int) -> int {
  carry = 0;
  i = 0;
  outw = 0;
  mm = btc_u32(m);
  while (i < 8) {
    a = btc_get(l0, l1, l2, l3, l4, l5, l6, l7, i);
    n = carry + a * mm;
    lo = btc_u32(n);
    carry = _lia_ushr(n, 32);
    ?(i == want) { outw = lo; };
    i = i + 1;
  };
  ^ outw;
}

!btc_cmp(a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, b0: int, b1: int, b2: int, b3: int, b4: int, b5: int, b6: int, b7: int) -> int {
  i = 7;
  while (i >= 0) {
    av = btc_get(a0, a1, a2, a3, a4, a5, a6, a7, i);
    bv = btc_get(b0, b1, b2, b3, b4, b5, b6, b7, i);
    ?(av < bv) { ^ -1; };
    ?(av > bv) { ^ 1; };
    i = i - 1;
  };
  ^ 0;
}

!btc_sub_want(a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, b0: int, b1: int, b2: int, b3: int, b4: int, b5: int, b6: int, b7: int, want: int) -> int {
  borrow = 0;
  i = 0;
  outw = 0;
  while (i < 8) {
    x = btc_get(a0, a1, a2, a3, a4, a5, a6, a7, i);
    y = btc_get(b0, b1, b2, b3, b4, b5, b6, b7, i) + borrow;
    ?(x < y) {
      d = (x + 4294967296) - y;
      borrow = 1;
    } : {
      d = x - y;
      borrow = 0;
    };
    ?(i == want) { outw = btc_u32(d); };
    i = i + 1;
  };
  ^ outw;
}

!btc_div_want(n0: int, n1: int, n2: int, n3: int, n4: int, n5: int, n6: int, n7: int, d0: int, d1: int, d2: int, d3: int, d4: int, d5: int, d6: int, d7: int, want: int) -> int {
  nb = btc_bits(n0, n1, n2, n3, n4, n5, n6, n7);
  db = btc_bits(d0, d1, d2, d3, d4, d5, d6, d7);
  ?(db == 0) { ^ 0; };
  ?(db > nb) { ^ 0; };
  shift = nb - db;
  s0 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 0);
  s1 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 1);
  s2 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 2);
  s3 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 3);
  s4 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 4);
  s5 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 5);
  s6 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 6);
  s7 = btc_shl_want(d0, d1, d2, d3, d4, d5, d6, d7, shift, 7);
  q0 = 0;
  q1 = 0;
  q2 = 0;
  q3 = 0;
  q4 = 0;
  q5 = 0;
  q6 = 0;
  q7 = 0;
  while (shift >= 0) {
    ge = btc_cmp(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7);
    ?(ge >= 0) {
      t0 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 0);
      t1 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 1);
      t2 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 2);
      t3 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 3);
      t4 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 4);
      t5 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 5);
      t6 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 6);
      t7 = btc_sub_want(n0, n1, n2, n3, n4, n5, n6, n7, s0, s1, s2, s3, s4, s5, s6, s7, 7);
      n0 = t0;
      n1 = t1;
      n2 = t2;
      n3 = t3;
      n4 = t4;
      n5 = t5;
      n6 = t6;
      n7 = t7;
      qi = shift / 32;
      bit = _lia_shl(1, shift - qi * 32);
      ?(qi == 0) { q0 = q0 | bit; };
      ?(qi == 1) { q1 = q1 | bit; };
      ?(qi == 2) { q2 = q2 | bit; };
      ?(qi == 3) { q3 = q3 | bit; };
      ?(qi == 4) { q4 = q4 | bit; };
      ?(qi == 5) { q5 = q5 | bit; };
      ?(qi == 6) { q6 = q6 | bit; };
      ?(qi == 7) { q7 = q7 | bit; };
    };
    z0 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 0);
    z1 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 1);
    z2 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 2);
    z3 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 3);
    z4 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 4);
    z5 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 5);
    z6 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 6);
    z7 = btc_shr_want(s0, s1, s2, s3, s4, s5, s6, s7, 1, 7);
    s0 = z0;
    s1 = z1;
    s2 = z2;
    s3 = z3;
    s4 = z4;
    s5 = z5;
    s6 = z6;
    s7 = z7;
    shift = shift - 1;
  };
  ^ btc_get(q0, q1, q2, q3, q4, q5, q6, q7, want);
}

!btc_timespan_clamp(actual: int, target: int) -> int {
  ?(target <= 0) { ^ 0; };
  lo = target / 4;
  hi = target * 4;
  ?(actual < lo) { actual = lo; };
  ?(actual > hi) { actual = hi; };
  ^ actual;
}

!btc_compact_negative(ncompact: int) -> int {
  nWord = ncompact & btc_mant();
  ?(nWord != 0) {
    ?( (ncompact & btc_signbit()) != 0 ) { ^ 1; };
  };
  ^ 0;
}

!btc_compact_overflow(ncompact: int) -> int {
  nSize = _lia_ushr(btc_u32(ncompact), 24);
  nWord = ncompact & btc_mant();
  ?(nWord == 0) { ^ 0; };
  ?(nSize > 34) { ^ 1; };
  ?(nWord > 255) {
    ?(nSize > 33) { ^ 1; };
  };
  ?(nWord > 65535) {
    ?(nSize > 32) { ^ 1; };
  };
  ^ 0;
}

!btc_setcompact_limb(ncompact: int, want: int) -> int {
  nSize = _lia_ushr(btc_u32(ncompact), 24);
  nWord = ncompact & btc_mant();
  ?(nSize <= 3) {
    nWord = _lia_ushr(nWord, 8 * (3 - nSize));
    ?(want == 0) { ^ nWord; };
    ^ 0;
  };
  l0 = nWord;
  sh = 8 * (nSize - 3);
  ^ btc_shl_want(l0, 0, 0, 0, 0, 0, 0, 0, sh, want);
}

!btc_getcompact(l0: int, l1: int, l2: int, l3: int, l4: int, l5: int, l6: int, l7: int) -> int {
  nSize = (btc_bits(l0, l1, l2, l3, l4, l5, l6, l7) + 7) / 8;
  nCompact = 0;
  ?(nSize <= 3) {
    low = btc_u32(l0) | _lia_shl(btc_u32(l1), 32);
    nCompact = btc_u32(_lia_shl(low, 8 * (3 - nSize)));
  } : {
    t0 = btc_shr_want(l0, l1, l2, l3, l4, l5, l6, l7, 8 * (nSize - 3), 0);
    t1 = btc_shr_want(l0, l1, l2, l3, l4, l5, l6, l7, 8 * (nSize - 3), 1);
    nCompact = btc_u32(t0) | _lia_shl(btc_u32(t1), 32);
    nCompact = btc_u32(nCompact);
  };
  ?( (nCompact & btc_signbit()) != 0 ) {
    nCompact = _lia_ushr(nCompact, 8);
    nSize = nSize + 1;
  };
  nCompact = (nCompact & btc_mant()) | _lia_shl(nSize, 24);
  ^ btc_u32(nCompact);
}

!btc_compact_ok(ncompact: int, pow_limit_nbits: int) -> int {
  ?(btc_compact_negative(ncompact) == 1) { ^ 0; };
  ?(btc_compact_overflow(ncompact) == 1) { ^ 0; };
  l0 = btc_setcompact_limb(ncompact, 0);
  l1 = btc_setcompact_limb(ncompact, 1);
  l2 = btc_setcompact_limb(ncompact, 2);
  l3 = btc_setcompact_limb(ncompact, 3);
  l4 = btc_setcompact_limb(ncompact, 4);
  l5 = btc_setcompact_limb(ncompact, 5);
  l6 = btc_setcompact_limb(ncompact, 6);
  l7 = btc_setcompact_limb(ncompact, 7);
  ?(btc_bits(l0, l1, l2, l3, l4, l5, l6, l7) == 0) { ^ 0; };
  p0 = btc_setcompact_limb(pow_limit_nbits, 0);
  p1 = btc_setcompact_limb(pow_limit_nbits, 1);
  p2 = btc_setcompact_limb(pow_limit_nbits, 2);
  p3 = btc_setcompact_limb(pow_limit_nbits, 3);
  p4 = btc_setcompact_limb(pow_limit_nbits, 4);
  p5 = btc_setcompact_limb(pow_limit_nbits, 5);
  p6 = btc_setcompact_limb(pow_limit_nbits, 6);
  p7 = btc_setcompact_limb(pow_limit_nbits, 7);
  ?(btc_cmp(l0, l1, l2, l3, l4, l5, l6, l7, p0, p1, p2, p3, p4, p5, p6, p7) > 0) { ^ 0; };
  ^ 1;
}

!btc_roundtrip(ncompact: int) -> int {
  l0 = btc_setcompact_limb(ncompact, 0);
  l1 = btc_setcompact_limb(ncompact, 1);
  l2 = btc_setcompact_limb(ncompact, 2);
  l3 = btc_setcompact_limb(ncompact, 3);
  l4 = btc_setcompact_limb(ncompact, 4);
  l5 = btc_setcompact_limb(ncompact, 5);
  l6 = btc_setcompact_limb(ncompact, 6);
  l7 = btc_setcompact_limb(ncompact, 7);
  ^ btc_getcompact(l0, l1, l2, l3, l4, l5, l6, l7);
}

!btc_next_work(last_nbits: int, last_time: int, first_time: int, target_timespan: int, pow_limit_nbits: int, no_retarget: int) -> int {
  ?(no_retarget != 0) { ^ btc_u32(last_nbits); };
  ?(target_timespan <= 0) { ^ 0; };
  actual = btc_timespan_clamp(last_time - first_time, target_timespan);
  l0 = btc_setcompact_limb(last_nbits, 0);
  l1 = btc_setcompact_limb(last_nbits, 1);
  l2 = btc_setcompact_limb(last_nbits, 2);
  l3 = btc_setcompact_limb(last_nbits, 3);
  l4 = btc_setcompact_limb(last_nbits, 4);
  l5 = btc_setcompact_limb(last_nbits, 5);
  l6 = btc_setcompact_limb(last_nbits, 6);
  l7 = btc_setcompact_limb(last_nbits, 7);
  t0 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 0);
  t1 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 1);
  t2 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 2);
  t3 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 3);
  t4 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 4);
  t5 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 5);
  t6 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 6);
  t7 = btc_mul32_want(l0, l1, l2, l3, l4, l5, l6, l7, actual, 7);
  d0 = btc_u32(target_timespan);
  d1 = _lia_ushr(target_timespan, 32);
  q0 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 0);
  q1 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 1);
  q2 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 2);
  q3 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 3);
  q4 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 4);
  q5 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 5);
  q6 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 6);
  q7 = btc_div_want(t0, t1, t2, t3, t4, t5, t6, t7, d0, d1, 0, 0, 0, 0, 0, 0, 7);
  p0 = btc_setcompact_limb(pow_limit_nbits, 0);
  p1 = btc_setcompact_limb(pow_limit_nbits, 1);
  p2 = btc_setcompact_limb(pow_limit_nbits, 2);
  p3 = btc_setcompact_limb(pow_limit_nbits, 3);
  p4 = btc_setcompact_limb(pow_limit_nbits, 4);
  p5 = btc_setcompact_limb(pow_limit_nbits, 5);
  p6 = btc_setcompact_limb(pow_limit_nbits, 6);
  p7 = btc_setcompact_limb(pow_limit_nbits, 7);
  ?(btc_cmp(q0, q1, q2, q3, q4, q5, q6, q7, p0, p1, p2, p3, p4, p5, p6, p7) > 0) {
    q0 = p0;
    q1 = p1;
    q2 = p2;
    q3 = p3;
    q4 = p4;
    q5 = p5;
    q6 = p6;
    q7 = p7;
  };
  ^ btc_getcompact(q0, q1, q2, q3, q4, q5, q6, q7);
}

!btc_mainnet_timespan() -> int {
  ^ 1209600;
}

!btc_mainnet_limit() -> int {
  ^ 486604799;
}

!btc_test_suite() -> int {
  ts = btc_mainnet_timespan();
  lim = btc_mainnet_limit();
  ?(btc_timespan_clamp(100, ts) != 302400) { ^ -1; };
  ?(btc_compact_overflow(4286578687) != 1) { ^ -2; };
  ?(btc_compact_ok(lim, lim) != 1) { ^ -3; };
  ?(btc_compact_ok(4286578687, lim) != 0) { ^ -4; };
  ?(btc_roundtrip(lim) != lim) { ^ -5; };
  g1 = btc_next_work(lim, 1262152739, 1261130161, ts, lim, 0);
  ?(g1 != 486594666) { ^ -6; };
  g2 = btc_next_work(lim, 1233061996, 1231006505, ts, lim, 0);
  ?(g2 != lim) { ^ -7; };
  g3 = btc_next_work(470131700, 1279297671, 1279008237, ts, lim, 0);
  ?(g3 != 469854461) { ^ -8; };
  g4 = btc_next_work(473464687, 1269211443, 1263163443, ts, lim, 0);
  ?(g4 != 486597117) { ^ -9; };
  ?(btc_next_work(lim, 0, 0, ts, lim, 1) != lim) { ^ -10; };
  ^ 1;
}

=ex{
  btc_mask32, btc_u32, btc_mant, btc_signbit, btc_get, btc_word_bits, btc_bits,
  btc_shl_want, btc_shr_want, btc_mul32_want, btc_cmp, btc_sub_want, btc_div_want,
  btc_timespan_clamp, btc_compact_negative, btc_compact_overflow, btc_setcompact_limb,
  btc_getcompact, btc_compact_ok, btc_roundtrip, btc_next_work,
  btc_mainnet_timespan, btc_mainnet_limit, btc_test_suite
}
