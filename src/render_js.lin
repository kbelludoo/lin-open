@LIN:L1c:0.2
!renderProgramJs(prog,opts){
  const parts = [];
  parts.push(``);
  ?(opts.prelude){ parts.push(String(opts.prelude).trim()); }
  ?(prog.consts){
    const obj = Object.entries(prog.consts)
      .map(([k, v]) => `${JSON.stringify(k)}:${v}`)
      .join(',');
    parts.push(`var $K={${obj}};`);
    // LIN_REGEX_001/T3 descobriu: corpos usam nomes soltos; vincula identificadores
    const cnames = Object.keys(prog.consts);
    ?(cnames.length){ parts.push(`var ${cnames.map((n) => `${n}=$K[${JSON.stringify(n)}]`).join(',')}; }`);
  }
  for (const en of prog.enums || []) {
    parts.push(`const ${en.name} = {};`);
    const variantNames = new Set((en.variants || []).map(v => v.name));
    for (const v of en.variants || []) {
      let valStr = v.value !== undefined ? String(v.value) : JSON.stringify(v.name);
      ?(!valStr.startsWith('"') && !valStr.startsWith("'")){
        valStr = valStr.replace(/\b([A-Za-z_$][\w$]*)\b/g, (m) => {
          ?(variantNames.has(m)){
            ^`${en.name}[${JSON.stringify(m)}]`;
          }
          ^m;
        });
      }
      parts.push(`${en.name}[${JSON.stringify(v.name)}] = ${valStr};`);
    }
  }
  for (const mod of prog.modules || []) {
    parts.push(`const ${mod.name} = ${renderModuleObj(mod)};`);
  }
  for (const u of prog.uses || []) {
    for (const sym of u.symbols) {
      parts.push(`const ${sym} = ${u.module}.${sym};`);
    }
  }
  const allFns = prog.fns;
  const effects = new Map();
  for (const fn of allFns) {
    effects.set(fn.name, inferEffect(fnTextStub(fn), allFns.map(fnTextStub)));
  }
  for (const fn of allFns) {
    fn.effect = effects.get(fn.name);
    const bodyText = renderBody(fn.body);
    const params = new Set((fn.params || []).map((p) => p.name));
    const bareIds = collectBareStmtIds(bodyText);
    const cleaned = stripBareIdStmts(bodyText);
    const assigned = collectAssignedIds(cleaned);
    const selfDeclared = new Set();
    for (const id of [...assigned, ...bareIds]) {
      ?(new RegExp(`\\b(?:const|let|var)\\s+${id}\\b`).test(cleaned)){ selfDeclared.add(id); }
    }
    const locals = [...new Set([...assigned, ...bareIds])].filter((id) => {
      ?(params.has(id)){ ^false; }
      ?(selfDeclared.has(id)){ ^false; }
      ?(bareIds.has(id)){ ^true; }
      ?(firstUseIsRead(cleaned, id)){ ^false; }
      ^true;
    });
    const decl = locals.length ? `var ${locals.join(',')};` : '';
    const isAsync = Boolean(fn.isAsync) || /\bawait\s+[\w$(]/.test(bodyText.replace(/"(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'/g, ''));
    parts.push(`${isAsync ? 'async ' : ''}function ${fn.name}(${fnParamsText(fn)}){${decl}${bodyText}}`);
  }
  for (const st of prog.stmts || []) {
    parts.push(renderStmt(st));
  }
  ?(opts.epilogue){
    parts.push(String(opts.epilogue).trim());
  }:{
    const rawEx = prog.exports.length ? prog.exports : prog.fns.map((f) => f.name);
    const ex = rawEx.map((e) => {
      ?(e.includes(' as ')){
        const [src, alias] = e.split(/\s+as\s+/).map((s) => s.trim());
        ^`${alias}:${src}`;
      }
      ^e;
    });
    ?(opts.exportMode === 'multiple'){
      parts.push(`module.exports={${ex.join(',')}};`);
    }:(opts.exportMode === 'single' && ex[0]){
      parts.push(`module.exports=${ex[0]};`);
    } else ?(ex.length === 1 && !rawEx[0].includes(' as ')){
      parts.push(`module.exports=${ex[0]};`);
    }:{
      parts.push(`module.exports={${ex.join(',')}};`);
    }
  }
  ^parts.join('\n');
}
!fnTextStub(fn){
  ?(!fn.__text){
    fn.__text = {
      name: fn.name,
      params: (fn.params || []).map((p) => p.name),
      get body() {
        ?(typeof fn.rawBody === 'string'){ ^fn.rawBody; }
        ^renderBody(fn.body || []);
      },
      effect: fn.effect,
    };
  }
  ^fn.__text;
}
!collectBareStmtIds(bodyText){
  const ids = new Set();
  let s = String(bodyText || '');
  for (let guard = 0; guard < 50; guard++) {
    const re = new RegExp(BARE_ID_STMT_RE.source, 'g');
    const m = re.exec(s);
    ?(!m){ break; }
    const id = m[2];
    ?(/^[A-Za-z_$][\w$]*$/.test(id) && !JS_KEYWORDS.has(id)){ ids.add(id); }
    s = s.slice(0, m.index) + m[1] + '\u0000' + s.slice(m.index + m[0].length);
  }
  ^ids;
}
!stripBareIdStmts(bodyText){
  let s = String(bodyText || '');
  for (let guard = 0; guard < 200; guard++) {
    const re = new RegExp(BARE_ID_STMT_RE.source, '');
    const m = re.exec(s);
    ?(!m){ break; }
    s = s.slice(0, m.index) + m[1] + s.slice(m.index + m[0].length);
  }
  ^s;
}
!renderModuleObj(mod){
  const modFns = [];
  for (const fn of mod.program.fns || []) {
    modFns.push(`${fn.name}: function(${fnParamsText(fn)}){${renderBody(fn.body)}}`);
  }
  for (const inner of mod.program.modules || []) {
    modFns.push(`${inner.name}: ${renderModuleObj(inner)}`);
  }
  ^`{\n  ${modFns.join(',\n  ')}\n}`;
}
=ex{renderProgramJs, fnTextStub, collectBareStmtIds, stripBareIdStmts, renderModuleObj}