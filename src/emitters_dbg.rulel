~METADATA{original="src/emitters_dbg.mjs" lang="mjs"}
.source{content="import { renderBody as jsBody, normalizeElse } from './render_core.mjs';\nimport { snakeCase, safeEmitId, prepareNativeFn } from './emit_shared.mjs';\n\nexport class EmitUnsupportedError extends Error {\n  constructor(message) {\n    super(`LIN_EMIT_UNSUPPORTED: ${message}`);\n    this.name = 'EmitUnsupportedError';\n  }\n}\n\nconst JS_RUNTIME_ONLY = /\\b(Buffer|crypto|bufferAllocUnsafe|timingSafeEqual|process|Intl|arguments)\\b|\\bthis\\.|\\bthis\\[|\\bswitch\\b|\\bnew\\s+Date\\b|Object\\.(setPrototypeOf|defineProperty|entries|create)/;\n\nexport function isJsRuntimeOnly(body) {\n  return JS_RUNTIME_ONLY.test(String(body || ''));\n}\n\nexport function stmtsText(fn) {\n  if (fn.__bodyText) return fn.__bodyText;\n  return typeof fn.rawBody === 'string' ? fn.rawBody : jsBody(fn.body || []);\n}\n\n\nfunction inlineStrAliases(text) {\n  let out = String(text || '');\n  const aliases = [];\n  const re = /([A-Za-z_$][\\w$]*)\\s*=\\s*String\\(([A-Za-z_$][\\w$]*)\\)\\s*;/g;\n  let m;\n  while ((m = re.exec(out)) !== null) {\n    aliases.push([m[1], m[2]]);\n  }\n  for (const [alias, real] of aliases) {\n    out = out.replace(new RegExp(`\\\\b${alias}\\\\b`, 'g'), real);\n  }\n  return { text: out, aliases };\n}\n\nfunction strParamNames(fn) {\n  const text = stmtsText(fn);\n  if (process.env.DBG) console.error('strParamNames text:', text.slice(0,80));\n  const out = [];\n  for (const p of paramList(fn)) {\n    if (new RegExp(`\\\\b${p.name}\\\\s*\\\\.\\\\s*(charCodeAt|length)\\\\b`).test(text) || new RegExp(`String\\\\(\\\\s*${p.name}\\\\s*\\\\)`).test(text)) {\n      out.push(p.name);\n    }\n  }\n  return out;\n}\n\nfunction retIsBool(fn) {\n  const text = stmtsText(fn);\n  const rets = text.match(/\\^\\s*([^;{}]+)|\\breturn\\s+([^;{}]+)/g) || [];\n  if (!rets.length) return false;\n  return rets.every((rr) => /[=!<>]==?|&&|\\|\\|/.test(rr));\n}\n\nfunction paramList(fn) {\n  return (fn.params || []).map((p) => ({ name: p.name, type: normType(p.type), def: p.def }));\n}\n\nfunction normType(t) {\n  const s = String(t || '').trim();\n  if (!s) return 'any';\n  if (/^(int|i32|i64|integer)$/.test(s)) return 'int';\n  if (/^(float|f64|double|number)$/.test(s)) return 'float';\n  if (/^(str|string)$/.test(s)) return 'string';\n  if (/^bool(ean)?$/.test(s)) return 'bool';\n  return 'any';\n}\n\nfunction defaultFor(t) {\n  switch (t) {\n    case 'int': return '0';\n    case 'float': return '0.0';\n    case 'bool': return 'false';\n    case 'string': return '\"\"';\n    default: return null;\n  }\n}\n\nexport function emitTs(prog, opts = {}) {\n  const parts = [`/* generated by lin-rewrite → ts */`];\n  if (prog.consts) {\n    parts.push(`const $K: Record<string, number> = { ${Object.entries(prog.consts).map(([k, v]) => `${JSON.stringify(k)}:${v}`).join(',')} };`);\n  }\n  const exported = new Set(prog.exports.map((e) => e.split(/\\s+as\\s+/)[0].trim()));\n  for (const mod of prog.modules || []) {\n    parts.push(`const ${mod.name}: Record<string, (...a: unknown[]) => unknown> = ${moduleObjTs(mod)};`);\n  }\n  for (const u of prog.uses || []) {\n    for (const sym of u.symbols) parts.push(`const ${sym} = ${u.module}.${sym};`);\n  }\n  for (const fn of prog.fns) {\n    const ps = (fn.params || []).map((p) => {\n      const t = p.type && normType(p.type) !== 'any' ? mapTsType(normType(p.type)) : 'unknown';\n      return `${safeEmitId(p.name)}${p.def != null && p.def !== '' ? `: ${t} = ${p.def}` : `: ${t}`}`;\n    }).join(', ');\n    const rt = fn.returnType ? `: ${mapTsType(normType(fn.returnType.replace(/^[^A-Za-z]+/, '')))}` : ': unknown';\n    const kw = exported.has(fn.name) ? 'export function' : 'function';\n    parts.push(`${kw} ${fn.name}(${ps})${rt} {${jsBody(fn.body)}}`);\n  }\n  void opts;\n  return parts.join('\\n');\n}\n\nfunction mapTsType(t) {\n  switch (t) {\n    case 'int': case 'float': return 'number';\n    case 'string': return 'string';\n    case 'bool': return 'boolean';\n    default: return 'unknown';\n  }\n}\n\nfunction moduleObjTs(mod) {\n  const fns = (mod.program.fns || []).map((fn) => `${fn.name}: (${(fn.params || []).map(() => 'a: unknown').join(',') || ''}) => unknown`);\n  void fns;\n  const body = (mod.program.fns || []).map((fn) => `${fn.name}: function(...a: unknown[]): unknown { return (${fn.name}_impl)(...a); }`);\n  void body;\n  const defs = (mod.program.fns || []).map((fn) => `function ${mod.name}_${fn.name}(...a: unknown[]): unknown { throw new Error('stub'); }`);\n  void defs;\n  return `{ ${(mod.program.fns || []).map((fn) => `${fn.name}: ${mod.name}_${fn.name}`).join(', ')} }`;\n}\n\nexport function emitPy(prog, opts = {}) {\n  const lines = ['# generated by lin-rewrite → py'];\n  lines.push(PY_RUNTIME);\n  if (prog.consts) {\n    for (const [k, v] of Object.entries(prog.consts)) lines.push(`${safeEmitId(k)} = ${v}`);\n    lines.push('$K = {' + Object.entries(prog.consts).map(([k]) => `${JSON.stringify(k)}: ${safeEmitId(k)}`).join(', ') + '}');\n  }\n  for (const u of prog.uses || []) {\n    for (const sym of u.symbols) lines.push(`${sym} = ${u.module}.${sym}`);\n  }\n  for (const fn of prog.fns) {\n    emitPyFn(lines, prog, fn);\n  }\n  void opts;\n  return lines.join('\\n');\n}\n\nfunction emitPyFn(lines, prog, fn) {\n  prepareNativeFn(fn);\n  const text = stmtsText(fn);\n  if (prog.__stubNames && prog.__stubNames.has(fn.name)) {\n    const ps0 = paramList(fn).map((x) => safeEmitId(x.name)).join(', ');\n    lines.push(`def ${safeEmitId(snakeCase(fn.name))}(${ps0}):`);\n    lines.push(`    raise NotImplementedError('${fn.name}: js_runtime_only')`);\n    lines.push('');\n    return;\n  }\n  const name = safeEmitId(snakeCase(fn.name));\n  const ps = paramList(fn);\n  const sig = ps.map((p) => {\n    const id = safeEmitId(p.name);\n    return p.def != null && p.def !== '' ? `${id}=${pyExpr(p.def)}` : id;\n  }).join(', ');\n  lines.push(`def ${name}(${sig}):`);\n  if (isJsRuntimeOnly(text)) {\n    lines.push(`    raise NotImplementedError('${fn.name}: js_runtime_only')`);\n    return;\n  }\n  const bodyLines = pyStmts(fn.body, 1, prog);\n  lines.push(...(bodyLines.length ? bodyLines : ['    pass']));\n  lines.push('');\n}\n\nfunction pyStmts(stmts, indent, prog) {\n  const pad = '    '.repeat(indent);\n  const out = [];\n  for (const st of stmts) {\n    switch (st.type) {\n      case 'return':\n        out.push(`${pad}return ${pyStmtTail(st.expr, indent)}`);\n        break;\n      case 'throw':\n        out.push(`${pad}raise Exception(${pyExpr(stripThrow(st.expr))})`);\n        break;\n      case 'break':\n        out.push(`${pad}break`);\n        break;\n      case 'continue':\n        out.push(`${pad}continue`);\n        break;\n      case 'assign':\n        out.push(`${pad}${pyLhs(st.idPath)} ${pyAssignOp(st.op)} ${pyStmtRhs(st.rhs, indent)}`);\n        break;\n      case 'expr':\n        out.push(`${pad}${pyStmtTail(st.expr, indent)}`);\n        break;\n      case 'if': {\n        out.push(`${pad}if ${pyCond(st.cond)}:`);\n        pushBlock(out, pyStmts(st.then, indent + 1, prog), pad);\n        for (const ei of st.elseIf || []) {\n          out.push(`${pad}elif ${pyCond(ei.cond)}:`);\n          pushBlock(out, pyStmts(collectChainBodies(ei), indent + 1, prog), pad);\n        }\n        if (st.else) {\n          out.push(`${pad}else:`);\n          pushBlock(out, pyStmts(normalizeElse(st.else), indent + 1, prog), pad);\n        }\n        break;\n      }\n      case 'blockternary': {\n        out.push(`${pad}${pyLhs('_lt')} = (${pyBody(st.then)} if ${pyCond(st.cond)} else ${pyBody(st.elseExpr)})`.replace('_lt = ', '_lt = '));\n        out.push(`${pad}pass`);\n        break;\n      }\n      case 'for': {\n        const initM = st.init.match(/^([A-Za-z_$][\\w$]*)\\s*=\\s*([\\s\\S]+)$/);\n        if (initM) {\n          out.push(`${pad}${safeEmitId(initM[1])} = ${pyExpr(initM[2])}`);\n        }\n        out.push(`${pad}while ${pyCond(st.cond)}:`);\n        const inner = pyStmts(st.body, indent + 1, prog);\n        const stepM = st.step.match(/^([A-Za-z_$][\\w$]*)\\s*(\\+\\+|--)$/);\n        if (stepM) {\n          inner.push(`${'    '.repeat(indent + 1)}${safeEmitId(stepM[1])} ${stepM[2] === '++' ? '+' : '-'}= 1`);\n        } else if (st.step.trim()) {\n          inner.push(`${'    '.repeat(indent + 1)}${pyExpr(st.step)}`);\n        }\n        pushBlock(out, inner, pad);\n        break;\n      }\n      case 'while':\n        out.push(`${pad}while ${pyCond(st.cond)}:`);\n        pushBlock(out, pyStmts(st.body, indent + 1, prog), pad);\n        break;\n      case 'match':\n        pyMatch(out, st, indent, prog);\n        break;\n      default:\n        throw new EmitUnsupportedError(`py stmt ${st.type}`);\n    }\n  }\n  return out;\n}\n\nfunction collectChainBodies(ei) {\n  return ei.body;\n}\n\nfunction pushBlock(out, inner, pad) {\n  out.push(...(inner.length ? inner : [`${pad}    pass`]));\n}\n\nfunction stripThrow(expr) {\n  const t = pyExprRaw(expr).trim();\n  return t.replace(/^new\\s+/, '').replace(/^Error\\((.*)\\)$/, '$1');\n}\n\nfunction pyCond(cond) {\n  return pyExprRaw(cond);\n}\n\nfunction pyStmtRhs(rhs, indent) {\n  void indent;\n  return pyExprRaw(rhs);\n}\n\nfunction pyStmtTail(expr, indent) {\n  void indent;\n  return pyExprRaw(expr);\n}\n\nfunction pyBody(blockternaryOrExpr) {\n  if (blockternaryOrExpr && blockternaryOrExpr.parts) return pyExprRaw(blockternaryOrExpr);\n  return '';\n}\n\nfunction pyLhs(path) {\n  return String(path).split('.').map(safeEmitId).join('.');\n}\n\nfunction pyAssignOp(op) {\n  switch (op) {\n    case '=': return '=';\n    case '+=': return '+=';\n    case '-=': return '-=';\n    case '*=': return '*=';\n    case '/=': return '/=';\n    case '%=': return '%=';\n    default: return '=';\n  }\n}\n\nexport function pyExprRaw(expr) {\n  const text = expr && expr.parts\n    ? expr.parts.map((p) => (p.kind === 'raw' ? p.text : nodeToJs(p.node))).join(' ')\n    : String(expr ?? '');\n  return pyExpr(text);\n}\n\nfunction nodeToJs(node) {\n  return jsBodyNodeInline(node);\n}\n\nfunction jsBodyNodeInline(node) {\n  if (node.kind === 'closure' || node.kind === 'fnlit') return `lambda: None`;\n  if (node.kind === 'arrow') return `lambda: None`;\n  throw new EmitUnsupportedError(`py inline ${node.kind}`);\n}\n\nexport function pyExpr(text) {\n  let s = String(text);\n  s = s.replace(/([A-Za-z_$][\\w$]*)\\.charCodeAt\\(([^()]*)\\)/g, '_lia_ord($1[$2])');\n  s = s.replace(/([A-Za-z_$][\\w$]*)\\.length\\b/g, '_lia_len($1)');\n  s = s.replace(/String\\(([A-Za-z_$][\\w$]*)\\)/g, '_lia_str($1)');\n  s = s.replace(/\\btypeof\\s+([A-Za-z_$][\\w$]*(?:\\([^()]*\\))?)/g, '_lia_typeof($1)');\n  s = s.replace(/\\bundefined\\b/g, 'None').replace(/\\bnull\\b/g, 'None');\n  s = s.replace(/\\btrue\\b/g, 'True').replace(/\\bfalse\\b/g, 'False');\n  s = s.replace(/\\bnew\\s+Error\\(([^()]*)\\)/g, 'Exception($1)');\n  s = s.replace(/\\bMath\\.floor\\(/g, '_lia_floor(');\n  s = s.replace(/\\bMath\\.abs\\(/g, 'abs(');\n  s = s.replace(/\\bMath\\.min\\(/g, 'min(');\n  s = s.replace(/\\bMath\\.max\\(/g, 'max(');\n  s = s.replace(/\\bMath\\.round\\(/g, '_lia_round(');\n  s = s.replace(/\\bString\\(/g, '_lia_str(');\n  s = s.replace(/\\bNumber\\(/g, '_lia_num(');\n  s = s.replace(/\\bisNaN\\(/g, '_lia_isnan(');\n  s = s.replace(/\\bNumber\\.isFinite\\(/g, '_lia_isfinite(');\n  s = s.replace(/===/g, '==').replace(/!==/g, '!=');\n  s = s.replace(/\\s*&&\\s*/g, ' and ').replace(/\\s*\\|\\|\\s*/g, ' or ');\n  s = replaceNot(s);\n  s = replaceTernariesPy(s);\n  return s;\n}\n\nfunction replaceNot(s) {\n  let out = '';\n  let i = 0;\n  while (i < s.length) {\n    if (s[i] === '!' && /[A-Za-z_(]/.test(s[i + 1] || '')) {\n      out += 'not ';\n      i++;\n      continue;\n    }\n    out += s[i];\n    i++;\n  }\n  return out;\n}\n\nexport function replaceTernariesPy(s) {\n  let guard = 0;\n  for (;;) {\n    if (guard++ > 50) break;\n    const t = findTopTernary(s);\n    if (!t) break;\n    const cond = s.slice(t.condStart, t.qIdx).trim();\n    const thenE = s.slice(t.qIdx + 1, t.colonIdx).trim();\n    const elseE = s.slice(t.colonIdx + 1, t.end).trim();\n    s = s.slice(0, t.condStart) + `(${thenE} if (${cond}) else ${elseE})` + s.slice(t.end);\n  }\n  return s;\n}\n\nfunction findTopTernary(s) {\n  let depth = 0;\n  let quote = null;\n  let qIdx = -1;\n  for (let i = 0; i < s.length; i++) {\n    const c = s[i];\n    if (quote) {\n      if (c === '\\\\') i++;\n      else if (c === quote) quote = null;\n      continue;\n    }\n    if (c === '\"' || c === \"'\" || c === '`') {\n      quote = c;\n      continue;\n    }\n    if ('([{'.includes(c)) depth++;\n    else if (')]}'.includes(c)) depth--;\n    else if (depth === 0 && c === '?' ) qIdx = i;\n    else if (depth === 0 && c === ':' && qIdx >= 0) {\n      return { condStart: 0, qIdx, colonIdx: i, end: s.length };\n    }\n  }\n  return null;\n}\n\nconst PY_RUNTIME = `def _lia_typeof(x):\n    if x is None: return 'object'\n    if isinstance(x, bool): return 'boolean'\n    if isinstance(x, (int, float)): return 'number'\n    if isinstance(x, str): return 'string'\n    if callable(x): return 'function'\n    try:\n        len(x)\n        return 'object'\n    except Exception:\n        return 'object'\ndef _lia_isfinite(x):\n    try:\n        return x == x and abs(float(x)) != float('inf')\n    except Exception:\n        return False\ndef _lia_isnan(x):\n    try:\n        return x != x\n    except Exception:\n        return True\ndef _lia_floor(x):\n    import math\n    try: return int(math.floor(float(x)))\n    except Exception: return 0\ndef _lia_round(x):\n    try: return int(round(x))\n    except Exception: return 0\ndef _lia_abs(x):\n    try: return abs(x)\n    except Exception: return 0\ndef _lia_str(x):\n    if isinstance(x, bool): return 'true' if x else 'false'\n    if isinstance(x, float) and x == int(x): return str(int(x))\n    return str(x)\ndef _lia_num(x):\n    try: return float(x)\n    except Exception:\n        try: return float(int(str(x)))\n        except Exception: return 0\ndef _lia_len(x):\n    try: return len(x)\n    except Exception: return 0\ndef _lia_ord(x):\n    try: return ord(x)\n    except Exception: return 0\ndef _lia_or(a, b):\n    return b if a is None or a == \"\" or a is False else a`;\n\nfunction pyMatch(out, st, indent, prog) {\n  void prog;\n  const pad = '    '.repeat(indent);\n  const target = pyExprRaw(st.target);\n  for (let idx = 0; idx < st.arms.length; idx++) {\n    const arm = st.arms[idx];\n    const condTxt = pyArmCond(target, arm.pat, arm.guard);\n    const kw = idx === 0 ? 'if' : 'elif';\n    out.push(`${pad}${kw} ${condTxt}:`);\n    pushBlock(out, pyStmts(arm.body, indent + 1), pad);\n  }\n}\n\nfunction pyArmCond(target, pat, guard) {\n  if (pat === '_') return guard ? `(${guard})` : 'True';\n  const enumMatch = pat.match(/^([A-Za-z_$][\\w$]*)\\(([^)]+)\\)$/);\n  const tupleMatch = pat.match(/^\\(([^)]+)\\)$/);\n  let base;\n  if (enumMatch) {\n    const tag = enumMatch[1];\n    const v = safeEmitId(enumMatch[2].trim());\n    base = `getattr(${target}, 'tag', None) == '${tag}'`;\n    base += ` # binds ${v}`;\n  } else if (tupleMatch) {\n    base = `isinstance(${target}, (list, tuple)) and len(${target}) >= ${tupleMatch[1].split(',').length}`;\n  } else {\n    base = `${target} == ${pat}`;\n  }\n  if (guard) base += ` and (${guard})`;\n  return base;\n}\n\nexport function emitGo(prog, opts = {}) {\n  const fnLines = [];\n  for (const fn of prog.fns) {\n    if (opts.__stubNames && opts.__stubNames.has(fn.name)) {\n      fnLines.push(`func ${safeEmitId(snakeCase(fn.name))}(...interface{}) interface{} { panic(\"${fn.name}: js_runtime_only\") }`);\n      continue;\n    }\n    emitGoFn(fnLines, fn);\n  }\n  const lines = ['// generated by lin-rewrite → go'];\n  lines.push('package main');\n  const bodyText = fnLines.join('\\n');\n  const needsMath = /\\bmath\\.Abs\\b|\\bmath\\.Floor\\b/.test(bodyText);\n  const needsFmt = true;\n  lines.push('');\n  lines.push('import (');\n  if (needsFmt) lines.push('\\t\"fmt\"');\n  if (needsMath) lines.push('\\t\"math\"');\n  lines.push(')');\n  lines.push('');\n  lines.push(...fnLines);\n  if (opts.main !== false && prog.exports.length) {\n    lines.push('func main() {');\n    lines.push('\\t_ = fmt.Sprint');\n    if (needsMath) lines.push('\\t_ = math.Abs');\n    lines.push('}');\n  }\n  return lines.join('\\n');\n}\n\nfunction goType(t) {\n  if (t === '@str') return 'string';\n  if (t === '@bool') return 'bool';\n  switch (t) {\n    case 'int': return 'int';\n    case 'float': return 'float64';\n    case 'string': return 'string';\n    case 'bool': return 'bool';\n    default: return 'interface{}';\n  }\n}\n\nfunction zeroFor(t) {\n  switch (goType(t)) {\n    case 'int': return '0';\n    case 'float64': return '0.0';\n    case 'string': return '\"\"';\n    case 'bool': return 'false';\n    default: return 'nil';\n  }\n}\n\nfunction emitGoFn(lines, fn, opts) {\n  prepareNativeFn(fn);\n  const strP = new Set(strParamNames(fn));\n  const ps = paramList(fn);\n  const sig = ps.map((p) => `${safeEmitId(p.name)} ${strP.has(p.name) ? 'string' : goType(p.type)}`).join(', ');\n  const retTypes = fn.returnType ? goType(normType(fn.returnType.replace(/^[^A-Za-z]+/, ''))) : (retIsBool(fn) ? 'bool' : 'interface{}');\n  lines.push(`func ${safeEmitId(snakeCase(fn.name))}(${sig}) ${retTypes} {`);\n  for (const p of ps) {\n    if (p.def != null && p.def !== '' && goType(p.type) === 'interface{}') {\n      lines.push(`\\tif ${safeEmitId(p.name)} == nil { ${safeEmitId(p.name)} = ${p.def} }`);\n    }\n  }\n  const locals = new Set();\n  for (const st of fn.body) collectLocalsGo(st, locals, ps.map((p) => p.name));\n  const localType = ps.find((p) => goType(p.type) !== 'interface{}');\n  const lt = localType ? goType(localType.type) : 'int';\n  for (const l of locals) {\n    lines.push(`\\tvar ${safeEmitId(l)} ${lt}`);\n  }\n  lines.push(goStmts(fn.body, 1));\n  lines.push('}');\n  lines.push('');\n}\n\nfunction collectLocalsGo(st, locals, params) {\n  const add = (id) => {\n    if (!params.includes(id) && !['return', 'if', 'for', 'else'].includes(id)) locals.add(id);\n  };\n  if (st.type === 'assign' && /^[A-Za-z_$][\\w$]*$/.test(st.idPath)) add(st.idPath);\n  for (const key of ['then', 'else', 'body']) {\n    if (Array.isArray(st[key])) for (const s2 of st[key]) collectLocalsGo(s2, locals, params);\n  }\n  if (Array.isArray(st.elseIf)) {\n    for (const ei of st.elseIf) {\n      for (const s2 of ei.body) collectLocalsGo(s2, locals, params);\n      let tail = ei.chainTail;\n      while (tail) {\n        for (const s2 of tail.body) collectLocalsGo(s2, locals, params);\n        tail = tail.chainTail;\n      }\n    }\n  }\n}\n\nfunction goIndent(depth) {\n  return '\\t'.repeat(depth);\n}\n\nfunction goStmts(stmts, depth) {\n  const out = [];\n  const pad = goIndent(depth);\n  for (const st of stmts) {\n    switch (st.type) {\n      case 'return':\n        out.push(`${pad}return ${goExpr(goExprRaw(st.expr))}`);\n        break;\n      case 'throw':\n        out.push(`${pad}panic(${goExpr(goExprRaw(st.expr))})`);\n        break;\n      case 'break':\n        out.push(`${pad}break`);\n        break;\n      case 'continue':\n        out.push(`${pad}continue`);\n        break;\n      case 'assign':\n        out.push(`${pad}${safeEmitId(st.idPath)} ${st.op} ${goExpr(goExprRaw(st.rhs))}`);\n        break;\n      case 'expr':\n        out.push(`${pad}_ = ${goExpr(goExprRaw(st.expr))}`);\n        break;\n      case 'if': {\n        out.push(`${pad}if (${goExpr(goExprRaw(st.cond))}) {`);\n        out.push(goStmts(st.then, depth + 1));\n        let closed = false;\n        for (const ei of st.elseIf || []) {\n          out.push(`${pad}} else if (${goExpr(goExprRaw(ei.cond))}) {`);\n          out.push(goStmts(collectChainBodies(ei), depth + 1));\n          closed = true;\n        }\n        void closed;\n        if (st.else) {\n          out.push(`${pad}} else {`);\n          out.push(goSt