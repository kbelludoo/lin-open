replace(/\\bfalse\\b/g, '0');\n  return s;\n}\n\nexport function emitJava(prog, opts = {}) {\n  const lines = ['// generated by lin-rewrite → java'];\n  lines.push('public class LinProgram {');\n  for (const fn of prog.fns) {\n    if (opts.__stubNames && opts.__stubNames.has(fn.name)) {\n      lines.push(`  public static long ${safeEmitId(snakeCase(fn.name))}() { throw new UnsupportedOperationException(\"${fn.name}: js_runtime_only\"); }`);\n      continue;\n    }\n    emitJavaFn(lines, fn);\n  }\n  lines.push('  public static void main(String[] args) {');\n  lines.push('  }');\n  lines.push('}');\n  void opts;\n  return lines.join('\\n');\n}\n\nfunction javaType(t) {\n  if (t === '@str') return 'String';\n  if (t === '@bool') return 'boolean';\n  switch (normType(t)) {\n    case 'int': return 'long';\n    case 'float': return 'double';\n    case 'bool': return 'boolean';\n    case 'string': return 'String';\n    default: return 'long';\n  }\n}\n\nfunction javaZero(t) {\n  switch (javaType(t)) {\n    case 'long': return '0L';\n    case 'double': return '0.0';\n    case 'boolean': return 'false';\n    case 'String': return '\"\"';\n    default: return '0L';\n  }\n}\n\nfunction emitJavaFn(lines, fn) {\n  prepareNativeFn(fn);\n  const strP = new Set(strParamNames(fn));\n  const isBool = retIsBool(fn);\n  const ps = paramList(fn);\n  for (const p of ps) {\n    if (!p.type && strP.has(p.name)) continue;\n    if (!p.type) p.type = 'int';\n  }\n  const sig = ps.map((p) => `${javaType(p.type)} ${safeEmitId(p.name)}`).join(', ');\n  const ret = fn.returnType ? javaType(fn.returnType.replace(/^[^A-Za-z]+/, '')) : javaType(ps[0] ? ps[0].type : 'int');\n  lines.push(`  public static ${ret} ${safeEmitId(snakeCase(fn.name))}(${sig}) {`);\n  const locals = new Set();\n  for (const st of fn.body) collectLocalsGo(st, locals, ps.map((p) => p.name));\n  for (const l of locals) {\n    const pt = ps.find((p) => p.name === l)?.type || 'int';\n    lines.push(`    ${javaType(pt)} ${safeEmitId(l)} = ${javaZero(pt)};`);\n  }\n  lines.push(javaStmts(fn.body, 2, fn));\n  lines.push('  }');\n}\n\nfunction javaIndent(d) {\n  return '  '.repeat(d);\n}\n\nfunction javaStmts(stmts, depth, fn) {\n  const out = [];\n  const pad = javaIndent(depth);\n  for (const st of stmts) {\n    switch (st.type) {\n      case 'return':\n        out.push(`${pad}return ${javaExpr(javaRaw(st.expr))};`);\n        break;\n      case 'throw':\n        throw new EmitUnsupportedError('java: throw (use unchecked)');\n      case 'break':\n        out.push(`${pad}break;`);\n        break;\n      case 'continue':\n        out.push(`${pad}continue;`);\n        break;\n      case 'assign':\n        out.push(`${pad}${safeEmitId(st.idPath)} ${st.op} ${javaExpr(javaRaw(st.rhs))};`);\n        break;\n      case 'expr':\n        out.push(`${pad}${javaExpr(javaRaw(st.expr))};`);\n        break;\n      case 'if': {\n        out.push(`${pad}if (${javaExpr(javaRaw(st.cond))}) {`);\n        out.push(javaStmts(st.then, depth + 1, fn));\n        for (const ei of st.elseIf || []) {\n          out.push(`${pad}} else if (${javaExpr(javaRaw(ei.cond))}) {`);\n          out.push(javaStmts(collectChainBodies(ei), depth + 1, fn));\n        }\n        if (st.else) {\n          out.push(`${pad}} else {`);\n          out.push(javaStmts(normalizeElse(st.else), depth + 1, fn));\n        }\n        out.push(`${pad}}`);\n        break;\n      }\n      case 'for': {\n        const initM = st.init.match(/^([A-Za-z_$][\\w$]*)\\s*=\\s*([\\s\\S]+)$/);\n        const stepM = st.step.match(/^([A-Za-z_$][\\w$]*)\\s*(\\+\\+|--)$/);\n        const init = initM ? `long ${initM[1]} = ${javaExpr(initM[2])}` : '';\n        const step = stepM ? `${stepM[1]}${stepM[2] === '++' ? '++' : '--'}` : javaExpr(st.step);\n        out.push(`${pad}for (${init}; ${javaExpr(javaRaw(st.cond))}; ${step}) {`);\n        out.push(javaStmts(st.body, depth + 1, fn));\n        out.push(`${pad}}`);\n        break;\n      }\n      case 'while':\n        out.push(`${pad}while (${javaExpr(javaRaw(st.cond))}) {`);\n        out.push(javaStmts(st.body, depth + 1, fn));\n        out.push(`${pad}}`);\n        break;\n      case 'match': {\n        const target = safeEmitId(javaRaw(st.target).trim());\n        for (let idx = 0; idx < st.arms.length; idx++) {\n          const arm = st.arms[idx];\n          const cond = javaArmCond(target, arm.pat, arm.guard);\n          if (idx === 0) out.push(`${pad}if (${cond}) {`);\n          else out.push(`${pad}} else if (${cond}) {`);\n          out.push(javaStmts(arm.body, depth + 1, fn));\n        }\n        out.push(`${pad}}`);\n        break;\n      }\n      default:\n        throw new EmitUnsupportedError(`java stmt ${st.type}`);\n    }\n  }\n  return out.join('\\n');\n}\n\nfunction javaArmCond(target, pat, guard) {\n  if (pat === '_') return guard ? guard : 'true';\n  let base = `${target} == ${pat}`;\n  if (guard) base += ` && (${guard})`;\n  return base;\n}\n\nfunction javaRaw(expr) {\n  return expr && expr.parts\n    ? expr.parts.map((p) => (p.kind === 'raw' ? p.text : javaInline(p.node))).join(' ')\n    : String(expr ?? '');\n}\n\nfunction javaInline(node) {\n  throw new EmitUnsupportedError(`java inline ${node.kind}`);\n}\n\nexport function javaExpr(text) {\n  let s = String(text);\n  s = s.replace(/([A-Za-z_$][\\w$]*)\\.charCodeAt\\(([^()]*)\\)/g, '(int)($1.charAt((int)($2)))');\n  s = s.replace(/String\\(([A-Za-z_$][\\w$]*)\\)/g, 'String.valueOf($1)');\n  s = s.replace(/===/g, '==').replace(/!==/g, '!=');\n  s = s.replace(/\\btrue\\b/g, 'true').replace(/\\bfalse\\b/g, 'false');\n  return s;\n}\n"}
