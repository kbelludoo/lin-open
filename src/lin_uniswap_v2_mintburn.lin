@LIN:L1c:0.2
@UNISWAP_V2_MINTBURN{
  version=1
  repo="Uniswap/v2-core"
  source="contracts/UniswapV2Pair.sol mint/burn + contracts/libraries/Math.sol min/sqrt"
  helpers="contracts/libraries/SafeMath.sol mul/sub"
  license="GPL-3.0-or-later"
  tag="v1.0.1"
  commit="4dd59067c76dea4a0e8e4bfdda41877a6b16dedc"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_uniswap_v2_lp_mint_burn_with_bounded_babylonian_and_128bit_muldiv"
  note="Not mainnet uint256/uint112. Real deltas: IERC20.balanceOf/getReserves/totalSupply/_mint/_burn are arguments; first-mint sqrt(amount0*amount1)-MINIMUM_LIQUIDITY fail-closes if sqrt<1000; subsequent mint is unsigned min of two 128-bit floor muldivs; burn is pro-rata liquidity*balance/supply; fail-closed if quotient exceeds uint64. GPL source is not vendored."
}

!uv2_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!uv2_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(uv2_u_lt(s, a));
}

!uv2_mask32() -> int {
  ^ 4294967295;
}

!uv2_muldiv_part(a: int, b: int, d: int, want_rem: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = uv2_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = uv2_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = uv2_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(uv2_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = uv2_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_rem == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!uv2_muldiv(a: int, b: int, d: int) -> int {
  ^ uv2_muldiv_part(a, b, d, 0);
}

!uv2_udiv(a: int, b: int) -> int {
  ?(b == 0) { ^ 0; };
  ^ uv2_muldiv(a, 1, b);
}

!uv2_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(uv2_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!uv2_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!uv2_u_min(a: int, b: int) -> int {
  ?(uv2_u_lt(a, b) == 1) { ^ a; };
  ^ b;
}

!uv2_signed_min_select(a: int, b: int) -> int {
  ^ ((a < b) * (a) + ((a < b) == 0) * (b));
}

!uv2_min_liq() -> int {
  ^ 1000;
}

!uv2_sqrt(y: int) -> int {
  ?(y == 0) { ^ 0; };
  ?(uv2_u_lt(y, 4) == 1) { ^ 1; };
  z = y;
  x = uv2_udiv(y, 2);
  ?(uv2_u_add_ok(x, 1) == 0) { ^ 0; };
  x = x + 1;
  i = 0;
  while (i < 80) {
    ?(uv2_u_lt(x, z) == 0) { ^ z; };
    z = x;
    ?(z == 0) { ^ 0; };
    q = uv2_udiv(y, z);
    ?(uv2_u_add_ok(q, z) == 0) { ^ 0; };
    s = q + z;
    x = uv2_udiv(s, 2);
    i = i + 1;
  };
  ^ 0;
}

!uv2_mint_liquidity(amount0: int, amount1: int, reserve0: int, reserve1: int, total_supply: int) -> int {
  ?(amount0 < 0 || amount1 < 0 || reserve0 < 0 || reserve1 < 0 || total_supply < 0) { ^ 0; };
  ?(total_supply == 0) {
    prod = uv2_muldiv(amount0, amount1, 1);
    ?(prod == 0 && (amount0 != 0 && amount1 != 0)) { ^ 0; };
    root = uv2_sqrt(prod);
    ?(uv2_u_lt(root, uv2_min_liq()) == 1) { ^ 0; };
    ^ root - uv2_min_liq();
  };
  ?(reserve0 == 0 || reserve1 == 0) { ^ 0; };
  q0 = uv2_muldiv(amount0, total_supply, reserve0);
  q1 = uv2_muldiv(amount1, total_supply, reserve1);
  ^ uv2_u_min(q0, q1);
}

!uv2_mint_ok(amount0: int, amount1: int, reserve0: int, reserve1: int, total_supply: int) -> int {
  liq = uv2_mint_liquidity(amount0, amount1, reserve0, reserve1, total_supply);
  ?(liq > 0) { ^ 1; };
  ^ 0;
}

!uv2_burn_amount(liquidity: int, balance: int, total_supply: int) -> int {
  ?(liquidity < 0 || balance < 0 || total_supply <= 0) { ^ 0; };
  ^ uv2_muldiv(liquidity, balance, total_supply);
}

!uv2_burn_ok(liquidity: int, balance0: int, balance1: int, total_supply: int) -> int {
  a0 = uv2_burn_amount(liquidity, balance0, total_supply);
  a1 = uv2_burn_amount(liquidity, balance1, total_supply);
  ?(a0 > 0 && a1 > 0) { ^ 1; };
  ^ 0;
}

!uv2_test_suite() -> int {
  ?(uv2_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(uv2_sqrt(0) != 0) { ^ -2; };
  ?(uv2_sqrt(1) != 1) { ^ -3; };
  ?(uv2_sqrt(4) != 2) { ^ -4; };
  ?(uv2_sqrt(9) != 3) { ^ -5; };
  ?(uv2_sqrt(16) != 4) { ^ -6; };
  ?(uv2_sqrt(1000000000000000000) != 1000000000) { ^ -7; };
  ?(uv2_u_min(3, 9) != 3) { ^ -8; };
  ?(uv2_u_min(9, 3) != 3) { ^ -9; };
  ?(uv2_signed_min_select(3, 9) != 3) { ^ -23; };
  ?(uv2_signed_min_select(9, 3) != 3) { ^ -24; };
  ?(uv2_mint_liquidity(1000, 1000, 0, 0, 0) != 0) { ^ -10; };
  ?(uv2_mint_ok(1000, 1000, 0, 0, 0) != 0) { ^ -11; };
  ?(uv2_mint_liquidity(1001, 1001, 0, 0, 0) != 1) { ^ -12; };
  ?(uv2_mint_liquidity(10000, 10000, 0, 0, 0) != 9000) { ^ -13; };
  ?(uv2_mint_liquidity(1000, 1000, 10000, 10000, 9000) != 900) { ^ -14; };
  ?(uv2_mint_liquidity(2000, 1000, 10000, 10000, 9000) != 900) { ^ -15; };
  ?(uv2_mint_liquidity(1000000000, 1000000000, 0, 0, 0) != 999999000) { ^ -16; };
  ?(uv2_burn_amount(1000, 10000, 10000) != 1000) { ^ -17; };
  ?(uv2_burn_amount(9000, 10000, 10000) != 9000) { ^ -18; };
  ?(uv2_burn_ok(1000, 10000, 10000, 10000) != 1) { ^ -19; };
  ?(uv2_burn_ok(0, 10000, 10000, 10000) != 0) { ^ -20; };
  ?(uv2_muldiv(7000000000000000000, 3000000000000000000, 1) != 0) { ^ -21; };
  ?(uv2_mint_liquidity(0, 10000, 0, 0, 0) != 0) { ^ -22; };
  ^ 1;
}

=ex{
  uv2_u_lt,
  uv2_u_add_carry,
  uv2_mask32,
  uv2_muldiv_part,
  uv2_muldiv,
  uv2_udiv,
  uv2_u_add_ok,
  uv2_naive_i64_mul,
  uv2_u_min,
  uv2_signed_min_select,
  uv2_min_liq,
  uv2_sqrt,
  uv2_mint_liquidity,
  uv2_mint_ok,
  uv2_burn_amount,
  uv2_burn_ok,
  uv2_test_suite
}
