@LIN:L1c:0.2
@CRVUSD_CONTROLLER_HEALTH{
  version=1
  repo="curvefi/curve-stablecoin"
  source="curve_stablecoin/controller.vy _health"
  license="informational_only_hash_pin_no_vendor"
  commit="81b3bea490e9b45221c82e78387920ccfeb05b33"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_crvusd_controller_health_128bit"
  note="Not mainnet uint256. SCALE=1e9 (not 1e18 SWAD). x_down, debt, liquidation_discount and full-oracle extras are arguments (no AMM/user storage). (a*b)/d uses 128-bit product; debt=0, discount>SCALE, overflow fail-close to 0. Signed health: liquidation when < 0."
}

!chl_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!chl_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(chl_u_lt(s, a));
}

!chl_mask32() -> int {
  ^ 4294967295;
}

!chl_scale() -> int {
  ^ 1000000000;
}

!chl_prod128(a: int, b: int, want: int) -> int {
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = chl_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = chl_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = chl_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  ?(want == 1) { ^ hi; };
  ^ lo;
}

!chl_div128(hi: int, lo: int, d: int, want_ov: int) -> int {
  ?(d == 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  ?(d < 0) { ?(want_ov == 1) { ^ 1; }; ^ 0; };
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(chl_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = chl_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want_ov == 1) {
    ?(ov == 1) { ^ 1; };
    ?(q < 0) { ^ 1; };
    ^ 0;
  };
  ?(ov == 1) { ^ 0; };
  ?(q < 0) { ^ 0; };
  ^ q;
}

!chl_muldiv(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  hi = chl_prod128(a, b, 1);
  lo = chl_prod128(a, b, 0);
  ^ chl_div128(hi, lo, d, 0);
}

!chl_muldiv_ov(a: int, b: int, d: int) -> int {
  ?(d <= 0) { ^ 1; };
  ?(a < 0) { ^ 1; };
  ?(b < 0) { ^ 1; };
  hi = chl_prod128(a, b, 1);
  lo = chl_prod128(a, b, 0);
  ^ chl_div128(hi, lo, d, 1);
}

!chl_health(x_down: int, debt: int, disc: int, full: int, ns0: int, active: int, p: int, p_up: int, y: int) -> int {
  ?(debt <= 0) { ^ 0; };
  ?(x_down < 0) { ^ 0; };
  ?(disc < 0) { ^ 0; };
  ?(chl_u_lt(chl_scale(), disc) == 1) { ^ 0; };
  hm = chl_scale() - disc;
  ?(chl_muldiv_ov(x_down, hm, debt) == 1) { ^ 0; };
  q = chl_muldiv(x_down, hm, debt);
  h = q - chl_scale();
  ?(full == 1) {
    ?(ns0 > active) {
      ?(p > p_up) {
        ?(p < 0) { ^ 0; };
        ?(p_up < 0) { ^ 0; };
        ?(y < 0) { ^ 0; };
        dp = p - p_up;
        ?(chl_muldiv_ov(dp, y, debt) == 1) { ^ 0; };
        extra = chl_muldiv(dp, y, debt);
        h = h + extra;
      };
    };
  };
  ^ h;
}

!chl_health_base(x_down: int, debt: int, disc: int) -> int {
  ^ chl_health(x_down, debt, disc, 0, 0, 0, 0, 0, 0);
}

!chl_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!chl_test_suite() -> int {
  e9 = 1000000000;
  ?(chl_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(chl_health_base(e9, e9, 0) != 0) { ^ -2; };
  ?(chl_health_base(2000000000, e9, 0) != e9) { ^ -3; };
  ?(chl_health_base(e9, e9, 60000000) != (0 - 60000000)) { ^ -4; };
  ?(chl_health_base(1200000000, e9, 60000000) != 128000000) { ^ -5; };
  ?(chl_health_base(e9, 0, 0) != 0) { ^ -6; };
  ?(chl_health(e9, e9, 0, 1, 10, 5, 1100000000, e9, e9) != 100000000) { ^ -7; };
  ?(chl_health(e9, e9, 0, 1, 3, 5, 1100000000, e9, e9) != 0) { ^ -8; };
  ?(chl_health(e9, e9, 0, 1, 10, 5, e9, 1100000000, e9) != 0) { ^ -9; };
  ?(chl_health_base(0, e9, 0) != (0 - e9)) { ^ -10; };
  ?(chl_health_base(1050000000, e9, 60000000) != (0 - 13000000)) { ^ -11; };
  ?(chl_health(e9, e9, 0, 1, 0 - 5, 0 - 10, 1100000000, e9, e9) != 100000000) { ^ -12; };
  ?(chl_naive_i64_mul(4000000000, 4000000000) != (0 - 2446744073709551616)) { ^ -13; };
  ?(chl_muldiv(4000000000, 4000000000, 1) != 0) { ^ -14; };
  ?(chl_muldiv_ov(4000000000, 4000000000, 1) != 1) { ^ -15; };
  ?(chl_health_base(10000000000, 1, 0) != 0) { ^ -16; };
  ?(chl_health_base(e9, e9, 1000000001) != 0) { ^ -17; };
  ^ 1;
}

=ex{
  chl_u_lt,
  chl_u_add_carry,
  chl_mask32,
  chl_scale,
  chl_prod128,
  chl_div128,
  chl_muldiv,
  chl_muldiv_ov,
  chl_health,
  chl_health_base,
  chl_naive_i64_mul,
  chl_test_suite
}
