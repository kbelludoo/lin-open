@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=roster_transition_v290
~G{?=if #=for ^=ret :else}

!verify_key_succession(is_voluntary: int, old_sig_valid: int, quorum_valid: int) -> int {
    ok = 0;
    ?(is_voluntary == 1) {
        ?(old_sig_valid == 1) {
            ?(quorum_valid == 1) {
                ok = 1;
            }
        }
    }
    ?(is_voluntary == 0) {
        // Emergency rotation: quorum override without old compromised key
        ?(quorum_valid == 1) {
            ok = 1;
        }
    }
    ^ok;
}

!verify_roster_threshold_policy(new_m: int, new_n: int, min_safe_m: int) -> int {
    safe = 0;
    ?(new_m <= new_n) {
        ?(new_m >= min_safe_m) {
            safe = 1;
        }
    }
    ^safe;
}

!evaluate_roster_transition_closure(succession_ok: int, policy_ok: int, continuity_ok: int) -> int {
    verdict = 0;
    ?(succession_ok == 1) {
        ?(policy_ok == 1) {
            ?(continuity_ok == 1) {
                verdict = 8000;
            }
        }
    }
    ^verdict;
}

=ex{verify_key_succession, verify_roster_threshold_policy, evaluate_roster_transition_closure}
