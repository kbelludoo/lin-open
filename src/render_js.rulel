@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="src/render_js.mjs" lang="mjs"}
.source{content="import { renderBody, renderExpr, renderStmt, fnParamsText } from './render_core.mjs';\nimport { collectAssignedIds, firstUseIsRead, inferEffect } from './effects.mjs';\n\nexport function renderProgramJs(prog, opts = {}) {\n  const parts = [];\n  parts.push(`/* generated by lin-rewrite ${opts.version || '2.0.0'} */`);\n  if (opts.prelude) parts.push(String(opts.prelude).trim());\n  if (prog.consts) {\n    const obj = Object.entries(prog.consts)\n      .map(([k, v]) => `${JSON.stringify(k)}:${v}`)\n      .join(',');\n    parts.push(`var $K={${obj}};`);\n    // LIN_REGEX_001/T3 descobriu: corpos usam nomes soltos; vincula identificadores\n    const cnames = Object.keys(prog.consts);\n    if (cnames.length) parts.push(`var ${cnames.map((n) => `${n}=$K[${JSON.stringify(n)}]`).join(',')};`);\n  }\n  for (const en of prog.enums || []) {\n    parts.push(`const ${en.name} = {};`);\n    const variantNames = new Set((en.variants || []).map(v => v.name));\n    for (const v of en.variants || []) {\n      let valStr = v.value !== undefined ? String(v.value) : JSON.stringify(v.name);\n      if (!valStr.startsWith('\"') && !valStr.startsWith(\"'\")) {\n        valStr = valStr.replace(/\\b([A-Za-z_$][\\w$]*)\\b/g, (m) => {\n          if (variantNames.has(m)) {\n            return `${en.name}[${JSON.stringify(m)}]`;\n          }\n          return m;\n        });\n      }\n      parts.push(`${en.name}[${JSON.stringify(v.name)}] = ${valStr};`);\n    }\n  }\n  for (const mod of prog.modules || []) {\n    parts.push(`const ${mod.name} = ${renderModuleObj(mod)};`);\n  }\n  for (const u of prog.uses || []) {\n    for (const sym of u.symbols) {\n      parts.push(`const ${sym} = ${u.module}.${sym};`);\n    }\n  }\n  const allFns = prog.fns;\n  const effects = new Map();\n  for (const fn of allFns) {\n    effects.set(fn.name, inferEffect(fnTextStub(fn), allFns.map(fnTextStub)));\n  }\n  for (const fn of allFns) {\n    fn.effect = effects.get(fn.name);\n    const bodyText = renderBody(fn.body);\n    const params = new Set((fn.params || []).map((p) => p.name));\n    const bareIds = collectBareStmtIds(bodyText);\n    const cleaned = stripBareIdStmts(bodyText);\n    const assigned = collectAssignedIds(cleaned);\n    const selfDeclared = new Set();\n    for (const id of [...assigned, ...bareIds]) {\n      if (new RegExp(`\\\\b(?:const|let|var)\\\\s+${id}\\\\b`).test(cleaned)) selfDeclared.add(id);\n    }\n    const locals = [...new Set([...assigned, ...bareIds])].filter((id) => {\n      if (params.has(id)) return false;\n      if (selfDeclared.has(id)) return false;\n      if (bareIds.has(id)) return true;\n      if (firstUseIsRead(cleaned, id)) return false;\n      return true;\n    });\n    const decl = locals.length ? `var ${locals.join(',')};` : '';\n    const isAsync = Boolean(fn.isAsync) || /\\bawait\\s+[\\w$(]/.test(bodyText.replace(/\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'/g, ''));\n    parts.push(`/* effect:${fn.effect} */${isAsync ? 'async ' : ''}function ${fn.name}(${fnParamsText(fn)}){${decl}${bodyText}}`);\n  }\n  for (const st of prog.stmts || []) {\n    parts.push(renderStmt(st));\n  }\n  if (opts.epilogue) {\n    parts.push(String(opts.epilogue).trim());\n  } else {\n    const rawEx = prog.exports.length ? prog.exports : prog.fns.map((f) => f.name);\n    const ex = rawEx.map((e) => {\n      if (e.includes(' as ')) {\n        const [src, alias] = e.split(/\\s+as\\s+/).map((s) => s.trim());\n        return `${alias}:${src}`;\n      }\n      return e;\n    });\n    if (opts.exportMode === 'multiple') {\n      parts.push(`module.exports={${ex.join(',')}};`);\n    } else if (opts.exportMode === 'single' && ex[0]) {\n      parts.push(`module.exports=${ex[0]};`);\n    } else if (ex.length === 1 && !rawEx[0].includes(' as ')) {\n      parts.push(`module.exports=${ex[0]};`);\n    } else {\n      parts.push(`module.exports={${ex.join(',')}};`);\n    }\n  }\n  return parts.join('\\n');\n}\n\nfunction fnTextStub(fn) {\n  if (!fn.__text) {\n    fn.__text = {\n      name: fn.name,\n      params: (fn.params || []).map((p) => p.name),\n      get body() {\n        if (typeof fn.rawBody === 'string') return fn.rawBody;\n        return renderBody(fn.body || []);\n      },\n      effect: fn.effect,\n    };\n  }\n  return fn.__text;\n}\n\nconst BARE_ID_STMT_RE = /(^|[;{}])\\s*([A-Za-z_$][\\w$]*)\\s*;/;\n\nconst JS_KEYWORDS = new Set([\n  'break', 'continue', 'return', 'throw', 'function', 'var', 'let', 'const',\n  'if', 'else', 'for', 'while', 'do', 'switch', 'case', 'default', 'new',\n  'typeof', 'delete', 'void', 'in', 'of', 'instanceof', 'true', 'false',\n  'null', 'undefined', 'this', 'try', 'catch', 'finally', 'class', 'extends',\n]);\n\nexport function collectBareStmtIds(bodyText) {\n  const ids = new Set();\n  let s = String(bodyText || '');\n  for (let guard = 0; guard < 50; guard++) {\n    const re = new RegExp(BARE_ID_STMT_RE.source, 'g');\n    const m = re.exec(s);\n    if (!m) break;\n    const id = m[2];\n    if (/^[A-Za-z_$][\\w$]*$/.test(id) && !JS_KEYWORDS.has(id)) ids.add(id);\n    s = s.slice(0, m.index) + m[1] + '\\u0000' + s.slice(m.index + m[0].length);\n  }\n  return ids;\n}\n\nexport function stripBareIdStmts(bodyText) {\n  let s = String(bodyText || '');\n  for (let guard = 0; guard < 200; guard++) {\n    const re = new RegExp(BARE_ID_STMT_RE.source, '');\n    const m = re.exec(s);\n    if (!m) break;\n    s = s.slice(0, m.index) + m[1] + s.slice(m.index + m[0].length);\n  }\n  return s;\n}\n\nfunction renderModuleObj(mod) {\n  const modFns = [];\n  for (const fn of mod.program.fns || []) {\n    modFns.push(`${fn.name}: function(${fnParamsText(fn)}){${renderBody(fn.body)}}`);\n  }\n  for (const inner of mod.program.modules || []) {\n    modFns.push(`${inner.name}: ${renderModuleObj(inner)}`);\n  }\n  return `{\\n  ${modFns.join(',\\n  ')}\\n}`;\n}\n\nexport { renderExpr };\n"}
