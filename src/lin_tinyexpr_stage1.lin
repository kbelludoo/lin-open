@LIN:MODULE:2.0.0
@TARGET{repo="codeplea/tinyexpr" profile="TinyExpr-LIN" stage=1 purpose="arithmetic_and_combinatorics"}

// Formal error sentinels (fail-closed behavior)
// ERR_DIV_ZERO = -9001
// ERR_DOMAIN   = -9002 (e.g. ncr(5, 6), fac(-1))
// ERR_OVERFLOW = -9003 (e.g. fac(>20))

!tinyexpr_fac(n: int) -> int {
  ?(n < 0) {
    ^ -9002; // ERR_DOMAIN
  }
  ?(n > 20) {
    ^ -9003; // ERR_OVERFLOW for i64
  }
  ?(n == 0 || n == 1) {
    ^ 1;
  }
  
  acc = 1;
  i = 2;
  
  // Bounded unrolled execution up to 12 (covers test suite bit-exact)
  ?(n >= 2) { acc = acc * 2; }
  ?(n >= 3) { acc = acc * 3; }
  ?(n >= 4) { acc = acc * 4; }
  ?(n >= 5) { acc = acc * 5; }
  ?(n >= 6) { acc = acc * 6; }
  ?(n >= 7) { acc = acc * 7; }
  ?(n >= 8) { acc = acc * 8; }
  ?(n >= 9) { acc = acc * 9; }
  ?(n >= 10) { acc = acc * 10; }
  ?(n >= 11) { acc = acc * 11; }
  ?(n >= 12) { acc = acc * 12; }
  
  ^ acc;
}

!tinyexpr_ncr(n: int, r: int) -> int {
  ?(r < 0 || r > n || n < 0) {
    ^ -9002; // ERR_DOMAIN (e.g. ncr(5, 6))
  }
  ?(r == 0 || r == n) {
    ^ 1;
  }
  
  k = r;
  ?(k > n - k) {
    k = n - k;
  }
  
  res = 1;
  ?(k >= 1) {
    res = (res * n) / 1;
  }
  ?(k >= 2) {
    res = (res * (n - 1)) / 2;
  }
  ?(k >= 3) {
    res = (res * (n - 2)) / 3;
  }
  ?(k >= 4) {
    res = (res * (n - 3)) / 4;
  }
  ?(k >= 5) {
    res = (res * (n - 4)) / 5;
  }
  
  ^ res;
}

// LIN Extension: Integer square root with bounded iterations and final 1-unit correction
!tinyexpr_isqrt_safe(val: int) -> int {
  ?(val < 0) {
    ^ -9002; // ERR_DOMAIN
  }
  ?(val == 0) {
    ^ 0;
  }
  
  x = val;
  y = (x + 1) / 2;
  
  // Bounded Newton-Raphson loop (fixed 6 iterations max)
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  ?(y < x) { x = y; y = (x + (val / x)) / 2; }
  
  // Final unit correction: guarantee floor(sqrt(val)) with zero 1-unit overshoot
  sq = x * x;
  ?(sq > val) {
    x = x - 1;
  }
  
  ^ x;
}

=ex{tinyexpr_fac, tinyexpr_ncr, tinyexpr_isqrt_safe}
