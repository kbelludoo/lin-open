@LIN:MODULE:2.0.0
@TARGET{repo="codeplea/tinyexpr" stage=1 purpose="arithmetic_and_combinatorics"}

!tinyexpr_fac(n: int) -> int {
  ?(n <= 1) {
    ^ 1;
  }
  
  acc = 1;
  i = 2;
  ?(n >= 2) {
    acc = acc * 2;
  }
  ?(n >= 3) {
    acc = acc * 3;
  }
  ?(n >= 4) {
    acc = acc * 4;
  }
  ?(n >= 5) {
    acc = acc * 5;
  }
  ?(n >= 6) {
    acc = acc * 6;
  }
  ?(n >= 7) {
    acc = acc * 7;
  }
  ?(n >= 8) {
    acc = acc * 8;
  }
  
  ^ acc;
}

!tinyexpr_ncr(n: int, r: int) -> int {
  ?(r < 0 || r > n) {
    ^ 0;
  }
  ?(r == 0 || r == n) {
    ^ 1;
  }
  
  // nCr calculation using bounded arithmetic
  k = r;
  ?(k > n - k) {
    k = n - k;
  }
  
  res = 1;
  i = 1;
  ?(k >= 1) {
    res = (res * (n - 0)) / 1;
  }
  ?(k >= 2) {
    res = (res * (n - 1)) / 2;
  }
  ?(k >= 3) {
    res = (res * (n - 2)) / 3;
  }
  ?(k >= 4) {
    res = (res * (n - 3)) / 4;
  }
  
  ^ res;
}

!tinyexpr_isqrt(val: int) -> int {
  ?(val <= 0) {
    ^ 0;
  }
  
  // Integer square root via Newton-Raphson
  x = val;
  y = (x + 1) / 2;
  
  ?(y < x) {
    x = y;
    y = (x + (val / x)) / 2;
  }
  ?(y < x) {
    x = y;
    y = (x + (val / x)) / 2;
  }
  ?(y < x) {
    x = y;
    y = (x + (val / x)) / 2;
  }
  ?(y < x) {
    x = y;
    y = (x + (val / x)) / 2;
  }
  
  ^ x;
}

=ex{tinyexpr_fac, tinyexpr_ncr, tinyexpr_isqrt}
