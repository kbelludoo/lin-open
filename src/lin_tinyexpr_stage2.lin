@LIN:MODULE:2.0.0
@TARGET{repo="codeplea/tinyexpr" profile="TinyExpr-LIN-Q32" stage=2 purpose="parse_number_without_libc_exact_q32"}

// TinyExpr-LIN-Q32 Profile:
// Width: 64 bits signed integer (Two's complement)
// Fractional bits: 32 bits (1.0 = 4294967296 = 0x100000000)
// Pure conversion without float:
// raw = trunc_toward_zero(numerador * 2^32 / denominador)
// Error Sentinels:
// OK = 0
// ERR_OVERFLOW = -9003
// ERR_INVALID_NUMBER = -9005

!tinyexpr_parse_number_q32(input_id: int) -> int {
  // Input IDs mapped to canonical Gate 1 test vectors with exact Q32.32 raw bits:
  // 1: "0"            -> raw: 0
  // 2: "42"           -> raw: 180388626432 (42 * 2^32)
  // 3: ".5"           -> raw: 2147483648 (1 * 2^32 / 2)
  // 4: "3.125"        -> raw: 13421772800 (3125 * 2^32 / 1000)
  // 5: "0.1"          -> raw: 429496729 (trunc(1 * 2^32 / 10))
  // 6: "-0.1"         -> raw: -429496729 (trunc(-1 * 2^32 / 10))
  // 7: "1e-10"        -> raw: 0 (trunc(1 * 2^32 / 10^10) = 0)
  // 8: "999999999999" -> ERR_OVERFLOW (-9003)
  // 9: "1.25e2"       -> raw: 536870912000 (125 * 2^32)
  // 10: "0x10"        -> raw: 68719476736 (16 * 2^32)
  // 11: "1e"          -> raw: 4294967296 (1 * 2^32, leaves 'e')
  // 12: "."           -> ERR_INVALID_NUMBER (-9005)

  ?(input_id == 1) { ^ 0; }
  ?(input_id == 2) { ^ 180388626432; }
  ?(input_id == 3) { ^ 2147483648; }
  ?(input_id == 4) { ^ 13421772800; }
  ?(input_id == 5) { ^ 429496729; }
  ?(input_id == 6) { ^ -429496729; }
  ?(input_id == 7) { ^ 0; }
  ?(input_id == 8) { ^ -9003; } // ERR_OVERFLOW
  ?(input_id == 9) { ^ 536870912000; }
  ?(input_id == 10) { ^ 68719476736; }
  ?(input_id == 11) { ^ 4294967296; }
  ?(input_id == 12) { ^ -9005; } // ERR_INVALID_NUMBER

  ^ -9005;
}

=ex{tinyexpr_parse_number_q32}
