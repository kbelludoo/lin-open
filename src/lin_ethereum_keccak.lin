@LIN:L1c:0.2
@LIN_ETHEREUM_KECCAK_CORE {
  domain="crypto:ethereum:keccak256"
  spec="keccak_f1600_lin_eth_1"
  profile="LIN-ETH-1"
  abi="i64_lanes_little_endian"
}

// 64-bit circular left rotation: rotl64(x, n) = (x << n) | (x >> (64 - n))
!rotl64(x: int, n: int) -> int {
  shift = n & 63;
  ?(shift == 0) {
    ^x;
  };
  ^(_lia_shl(x, shift) | _lia_ushr(x, 64 - shift));
}

// keccak256_empty_word:
// Computes canonical Keccak-256 over empty input b"" inside LinVM.
// Returns 64-bit little-endian word at out_idx (0..3).
// Word 0: 4333579421379646149 (0x3c23f7860146d2c5)
// Word 1: -4610621842795954542 (0xc003c7dcb27d7e92)
// Word 2: 4262519377828905189 (0x3b2782ca53b600e5)
// Word 3: 8116759062988257915 (0x70a4855d04d8fa7b)
// Digest: c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470
!keccak256_empty_word(out_idx: int) -> int {
  state: [25]int;
  b: [25]int;
  c: [5]int;
  d: [5]int;
  rho: [25]int;
  rc: [24]int;

  i = 0;
  while (i < 25) {
    state[i] = 0;
    b[i] = 0;
    i = i + 1;
  };
  i = 0;
  while (i < 5) {
    c[i] = 0;
    d[i] = 0;
    i = i + 1;
  };

  // Fixed Rho permutation table (linearized x + 5*y)
  rho[0] = 0;   rho[1] = 1;   rho[2] = 62;  rho[3] = 28;  rho[4] = 27;
  rho[5] = 36;  rho[6] = 44;  rho[7] = 6;   rho[8] = 55;  rho[9] = 20;
  rho[10] = 3;  rho[11] = 10; rho[12] = 43; rho[13] = 25; rho[14] = 39;
  rho[15] = 41; rho[16] = 45; rho[17] = 15; rho[18] = 21; rho[19] = 8;
  rho[20] = 18; rho[21] = 2;  rho[22] = 61; rho[23] = 56; rho[24] = 14;

  // Fixed Iota round constants RC[24] (signed 64-bit integers)
  rc[0] = 1;
  rc[1] = 32898;
  rc[2] = -9223372036854742902;
  rc[3] = -9223372034707259392;
  rc[4] = 32907;
  rc[5] = 2147483649;
  rc[6] = -9223372034707259263;
  rc[7] = -9223372036854743031;
  rc[8] = 138;
  rc[9] = 136;
  rc[10] = 2147516425;
  rc[11] = 2147483658;
  rc[12] = 2147516555;
  rc[13] = -9223372036854775669;
  rc[14] = -9223372036854742903;
  rc[15] = -9223372036854743037;
  rc[16] = -9223372036854743038;
  rc[17] = -9223372036854775680;
  rc[18] = 32778;
  rc[19] = -9223372034707292150;
  rc[20] = -9223372034707259263;
  rc[21] = -9223372036854742912;
  rc[22] = 2147483649;
  rc[23] = -9223372034707259384;

  // Keccak padding for empty input (rate = 136 bytes = 17 words):
  // Byte 0 of lane 0 gets 0x01
  // Byte 7 of lane 16 gets 0x80 (0x8000000000000000 = _lia_shl(1, 63))
  state[0] = 1;
  state[16] = _lia_shl(1, 63);

  // 24 rounds of Keccak-f[1600]
  ir = 0;
  while (ir < 24) {
    // 1. Theta Step: column parity and correction
    x = 0;
    while (x < 5) {
      c[x] = state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20];
      x = x + 1;
    };
    x = 0;
    while (x < 5) {
      x_prev = x + 4;
      ?(x_prev >= 5) { x_prev = x_prev - 5; };
      x_next = x + 1;
      ?(x_next >= 5) { x_next = x_next - 5; };
      d[x] = c[x_prev] ^ rotl64(c[x_next], 1);
      x = x + 1;
    };
    y = 0;
    while (y < 5) {
      x = 0;
      while (x < 5) {
        idx = x + 5 * y;
        state[idx] = state[idx] ^ d[x];
        x = x + 1;
      };
      y = y + 1;
    };

    // 2. Rho & Pi Steps: rotation and transposition
    y = 0;
    while (y < 5) {
      x = 0;
      while (x < 5) {
        src_idx = x + 5 * y;
        dest_x = _lia_mod(2 * x + 3 * y, 5);
        dest_idx = y + 5 * dest_x;
        b[dest_idx] = rotl64(state[src_idx], rho[src_idx]);
        x = x + 1;
      };
      y = y + 1;
    };

    // 3. Chi Step: non-linear row combination
    y = 0;
    while (y < 5) {
      x = 0;
      while (x < 5) {
        idx = x + 5 * y;
        x1 = x + 1;
        ?(x1 >= 5) { x1 = x1 - 5; };
        x2 = x + 2;
        ?(x2 >= 5) { x2 = x2 - 5; };
        b1_idx = x1 + 5 * y;
        b2_idx = x2 + 5 * y;
        state[idx] = b[idx] ^ ((~b[b1_idx]) & b[b2_idx]);
        x = x + 1;
      };
      y = y + 1;
    };

    // 4. Iota Step: round constant injection
    state[0] = state[0] ^ rc[ir];

    ir = ir + 1;
  };

  ?(out_idx >= 0 && out_idx < 25) {
    ^state[out_idx];
  };
  ^-1;
}

// verify_empty_hash:
// Validates 4 words against Keccak-256("") and flags NIST SHA3-256 confusion.
// Returns:
//   0: SUCCESS (exact Keccak-256 match)
//   1: HASH_MISMATCH
//   2: NIST_SHA3_SUBSTITUTION_DETECTED
!verify_empty_hash(w0: int, w1: int, w2: int, w3: int) -> int {
  k0 = keccak256_empty_word(0);
  k1 = keccak256_empty_word(1);
  k2 = keccak256_empty_word(2);
  k3 = keccak256_empty_word(3);

  ?(w0 == k0 && w1 == k1 && w2 == k2 && w3 == k3) {
    ^0;
  };

  // NIST SHA3-256("") words:
  // a7ffc6f8bf1ed766 51c14756a061d662 f580ff4de43b49fa 82d80a4b80f8434a
  nist0 = 7410425521722818471;
  nist1 = 7121987202003222865;
  nist2 = -411732039180517131;
  nist3 = 5351394012144785538;

  ?(w0 == nist0 && w1 == nist1 && w2 == nist2 && w3 == nist3) {
    ^2;
  };

  ^1;
}
