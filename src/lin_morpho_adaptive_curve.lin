@LIN:L1c:0.2
@MORPHO_ADAPTIVE_CURVE_IRM{
  version=1
  repo="morpho-org/morpho-blue-irm"
  source="src/adaptive-curve-irm/AdaptiveCurveIrm.sol"
  license="MIT"
  commit="58ce91fd04840372443a7080a5b32067b17b3d60"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_signed_morpho_adaptive_curve_irm_with_128bit_wmul"
  note="Not mainnet uint256. Real deltas: rateAtTarget and elapsed are arguments (no mapping, no block.timestamp); (x*y)/d uses signed 128-bit product, fail-closed if quotient exceeds i64; wExp fail-closes when 2^q overflows i64 instead of clipping to a 256-bit upper value."
}

!ac_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!ac_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(ac_u_lt(s, a));
}

!ac_mask32() -> int {
  ^ 4294967295;
}

!ac_wad() -> int {
  ^ 1000000000000000000;
}

!ac_steep() -> int {
  ^ 4000000000000000000;
}

!ac_target() -> int {
  ^ 900000000000000000;
}

!ac_speed() -> int {
  ^ 1585489599188;
}

!ac_init() -> int {
  ^ 1268391679;
}

!ac_min_rate() -> int {
  ^ 31709791;
}

!ac_max_rate() -> int {
  ^ 63419583967;
}

!ac_ln2() -> int {
  ^ 693147180559945309;
}

!ac_abs(x: int) -> int {
  ?(x >= 0) { ^ x; };
  n = 0 - x;
  ?(n <= 0) { ^ 0; };
  ^ n;
}

!ac_neg(x: int) -> int {
  ?(x < 0) { ^ 1; };
  ^ 0;
}

!ac_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  aa = ac_abs(a);
  bb = ac_abs(b);
  dd = ac_abs(d);
  ?(a < 0 && aa == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0 && bb == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(d < 0 && dd == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = ac_mask32();
  a0 = aa & m32;
  a1 = _lia_ushr(aa, 32);
  b0 = bb & m32;
  b1 = _lia_ushr(bb, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = ac_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = ac_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(ac_u_lt(r_lo, dd) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = ac_u_lt(r_lo, dd);
      r_lo = r_lo - dd;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  sg = ac_neg(a) + ac_neg(b) + ac_neg(d);
  ?((sg & 1) == 1) { ^ 0 - q; };
  ^ q;
}

!ac_muldiv(a: int, b: int, d: int) -> int {
  ^ ac_muldiv_part(a, b, d, 0);
}

!ac_wmul(x: int, y: int) -> int {
  ^ ac_muldiv(x, y, ac_wad());
}

!ac_wdiv(x: int, y: int) -> int {
  ?(y == 0) { ^ 0; };
  ^ ac_muldiv(x, ac_wad(), y);
}

!ac_bound(x: int, lo: int, hi: int) -> int {
  ?(x < lo) { ^ lo; };
  ?(x > hi) { ^ hi; };
  ^ x;
}

!ac_curve(rate: int, err: int) -> int {
  coeff = 0;
  ?(err < 0) {
    coeff = ac_wad() - ac_wdiv(ac_wad(), ac_steep());
  } : {
    coeff = ac_steep() - ac_wad();
  };
  ^ ac_wmul(ac_wmul(coeff, err) + ac_wad(), rate);
}

!ac_util(supply: int, borrow: int) -> int {
  ?(supply <= 0) { ^ 0; };
  ?(borrow < 0) { ^ 0; };
  ^ ac_muldiv(borrow, ac_wad(), supply);
}

!ac_err(util: int) -> int {
  den = ac_target();
  ?(util > ac_target()) { den = ac_wad() - ac_target(); };
  ^ ac_wdiv(util - ac_target(), den);
}

!ac_wexp(x: int) -> int {
  ln2 = ac_ln2();
  ?(x < (0 - (ln2 + ln2 + ln2 + ln2 + ln2 + ln2 + ln2 + ln2))) { ^ 0; };
  half = ac_muldiv(ln2, 1, 2);
  adj = half;
  ?(x < 0) { adj = 0 - half; };
  q = ac_muldiv(x + adj, 1, ln2);
  ?(q > 3) { ^ 0; };
  ?(q < (0 - 3)) { ^ 0; };
  r = x - ac_muldiv(q, ln2, 1);
  rr2 = ac_muldiv(ac_muldiv(r, r, ac_wad()), 1, 2);
  expr = ac_wad() + r + rr2;
  ?(expr <= 0) { ^ 0; };
  ?(q == 0) { ^ expr; };
  ?(q > 0) { ^ _lia_shl(expr, q); };
  ^ _lia_ushr(expr, 0 - q);
}

!ac_new_rate(start: int, linad: int) -> int {
  ?(start <= 0) { ^ 0; };
  ^ ac_bound(ac_wmul(start, ac_wexp(linad)), ac_min_rate(), ac_max_rate());
}

!ac_avg_rate(supply: int, borrow: int, start: int, elapsed: int) -> int {
  e = ac_err(ac_util(supply, borrow));
  ?(elapsed < 0) { ^ 0; };
  ?(start == 0) { ^ ac_curve(ac_init(), e); };
  speed = ac_wmul(ac_speed(), e);
  linad = ac_muldiv(speed, elapsed, 1);
  ?(linad == 0) { ^ ac_curve(start, e); };
  end = ac_new_rate(start, linad);
  mid = ac_new_rate(start, ac_muldiv(linad, 1, 2));
  avg = ac_muldiv(start + end + mid + mid, 1, 4);
  ^ ac_curve(avg, e);
}

!ac_end_rate(supply: int, borrow: int, start: int, elapsed: int) -> int {
  e = ac_err(ac_util(supply, borrow));
  ?(elapsed < 0) { ^ 0; };
  ?(start == 0) { ^ ac_init(); };
  speed = ac_wmul(ac_speed(), e);
  linad = ac_muldiv(speed, elapsed, 1);
  ?(linad == 0) { ^ start; };
  ^ ac_new_rate(start, linad);
}

!ac_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!ac_test_suite() -> int {
  w = ac_wad();
  init = ac_init();
  ?(ac_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(ac_muldiv(7, 9, 2) != 31) { ^ -2; };
  ?(ac_muldiv(0 - 7, 9, 2) != 0 - 31) { ^ -3; };
  ?(ac_wmul(w, w) != w) { ^ -4; };
  ?(ac_wdiv(w, ac_steep()) != 250000000000000000) { ^ -5; };
  ?(ac_curve(init, 0) != 1268391679) { ^ -6; };
  ?(ac_curve(init, w) != 5073566716) { ^ -7; };
  ?(ac_curve(init, 0 - w) != 317097919) { ^ -8; };
  ?(ac_util(w + w, 0) != 0) { ^ -9; };
  ?(ac_err(0) != (0 - w)) { ^ -10; };
  ?(ac_err(ac_target()) != 0) { ^ -11; };
  ?(ac_err(w) != w) { ^ -12; };
  ?(ac_wexp(0) != w) { ^ -13; };
  ?(ac_new_rate(init, 0) != init) { ^ -14; };
  ?(ac_avg_rate(w + w, 0, 0, 0) != 317097919) { ^ -15; };
  ?(ac_avg_rate(w + w, w + w, 0, 0) != 5073566716) { ^ -16; };
  ?(ac_avg_rate(w + w, w + ac_muldiv(8, w, 10), 0, 0) != 1268391679) { ^ -17; };
  ?(ac_avg_rate(w + w, w + w, init, 0) != 5073566716) { ^ -18; };
  ?(ac_end_rate(w + w, w + w, init, 86400) != 1454044805) { ^ -19; };
  ?(ac_avg_rate(w + w, w + w, init, 86400) != 5438922544) { ^ -20; };
  ?(ac_muldiv(3000000000000000000, w, 1) != 0) { ^ -21; };
  ?(ac_wmul(3000000000000000000, w) != 3000000000000000000) { ^ -22; };
  ?(ac_bound(10, 3, 7) != 7) { ^ -23; };
  ?(ac_bound(1, 3, 7) != 3) { ^ -24; };
  ^ 1;
}

=ex{
  ac_u_lt,
  ac_u_add_carry,
  ac_mask32,
  ac_wad,
  ac_steep,
  ac_target,
  ac_speed,
  ac_init,
  ac_min_rate,
  ac_max_rate,
  ac_ln2,
  ac_abs,
  ac_neg,
  ac_muldiv_part,
  ac_muldiv,
  ac_wmul,
  ac_wdiv,
  ac_bound,
  ac_curve,
  ac_util,
  ac_err,
  ac_wexp,
  ac_new_rate,
  ac_avg_rate,
  ac_end_rate,
  ac_naive_i64_mul,
  ac_test_suite
}
