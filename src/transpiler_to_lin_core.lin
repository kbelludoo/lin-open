function transpileZigToLin(zigSource){var clean,rawFns,fns,rf,params,body,exportNames,outLines,i,j;clean = zigSource.replace(/\/\/.*$/gm, "");rawFns = extractBracedFunctions(clean,/(?:pub\s+)?fn\s+([A-Za-z0-9_$]+)\s*\(([^)]*)\)/g);fns = [];for(i = 0;i < rawFns.length;i++){rf = rawFns[i];?(rf.name === "main"){continue;}params = rf.rawParams.split(",").map(function(p){^p.trim().split(":")[0].trim();}).filter(Boolean).join(",");body = rf.body;body = body.replace(/var\s+|const\s+/g, "");body = body.replace(/:\s*[^=;\n]+\s*=/g, "=");body = body.replace(/\}\s*else\s+if\s*\(([^)]+)\)\s*\{/g, "}:($1){");body = body.replace(/\}\s*else\s*\{/g, "}:{");body = body.replace(/\belse\s+if\s*\(([^)]+)\)\s*\{/g, ":($1){");body = body.replace(/\belse\s*\{/g, "}:{");body = body.replace(/\bif\s*\(([^)]+)\)\s*\{/g, "?($1){");body = body.replace(/\bwhile\s*\(([^)]+)\)\s*\{/g, ";while($1){");body = body.replace(/@rem\(([^,]+),\s*([^)]+)\)/g, "($1 % $2)");body = body.replace(/@divTrunc\(([^,]+),\s*([^)]+)\)/g, "($1 / $2)");body = body.replace(/\band\b/g, "&&").replace(/\bor\b/g, "||");body = body.replace(/\breturn\s+([^;]+);/g, "^$1;");fns.push({ name: rf.name, params: params, body: body });}exportNames = fns.map(function(f){^f.name;});outLines = ["@LIN:L1c:0.2"];for(j = 0;j < fns.length;j++){fn = fns[j];outLines.push("!" + fn.name + "(" + fn.params + "){" + fn.body + "}");}outLines.push("=ex{" + exportNames.join(", ") + "}");^outLines.join("\n");}
module.exports={detectLanguage,extractBracedFunctions,transpileRustToLin,transpileGoToLin,transpileCToLin,transpileZigToLin};
