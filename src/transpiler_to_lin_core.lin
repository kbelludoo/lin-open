@LIN:transpiler_to_lin_core:1.0.0
^schema_once ^lossy=true ^ops=transpiler_to_lin_core
~G{?=if #=for ^=ret :else}

!detectLanguage(code, filename){
  ?(filename.endsWith(".py")){ ^"py" }
  :(filename.endsWith(".rs")){ ^"rs" }
  :(filename.endsWith(".go")){ ^"go" }
  :(filename.endsWith(".c") || filename.endsWith(".h") || filename.endsWith(".cc") || filename.endsWith(".cpp") || filename.endsWith(".hpp") || filename.endsWith(".cxx")){ ^"c" }
  :(filename.endsWith(".zig")){ ^"zig" }
  :(filename.endsWith(".json")){ ^"json" }
  :(filename.endsWith(".ts")){ ^"ts" }
  :(filename.endsWith(".js") || filename.endsWith(".mjs") || filename.endsWith(".cjs")){ ^"js" }
  
  ?(code.indexOf("def ") >= 0){ ^"py" }
  :(code.indexOf("fn ") >= 0){ ^"rs" }
  :(code.indexOf("func ") >= 0){ ^"go" }
  :(code.indexOf("pub fn ") >= 0){ ^"zig" }
  ^"js"
}

!extractBracedFunctions(source, fnHeaderRe){
  fns = [];
  m = null;
  while ((m = fnHeaderRe.exec(source)) !== null) {
    fnName = m[1];
    i = m.index + m[0].length;
    while (i < source.length && /\s/.test(source.charAt(i))) { i++ }
    ?(source.charAt(i) === "<"){
      rawGen = sliceMatching(source, i, "<", ">");
      ?(rawGen == null){ continue }
      i = i + rawGen.length + 2;
      while (i < source.length && /\s/.test(source.charAt(i))) { i++ }
    }
    ?(source.charAt(i) !== "("){ continue }
    rawParams = sliceMatching(source, i, "(", ")");
    ?(rawParams == null){ continue }
    openBrace = indexOfBraceAfterHeader(source, m.index);
    ?(openBrace < 0){ continue }
    between = source.slice(m.index + m[0].length, openBrace);
    ?(between.indexOf(";") >= 0 && between.indexOf("{") < 0){ continue }
    body = sliceMatching(source, openBrace, "{", "}");
    ?(body == null){ continue }
    fns.push({ name: fnName, rawParams: rawParams, body: body })
  }
  ^fns
}

!sliceMatching(s, openIdx, openCh, closeCh){
  ?(s.charAt(openIdx) !== openCh){ ^null }
  depth = 0;
  quote = "";
  #(i = openIdx; i < s.length; i++){
    c = s.charAt(i);
    ?(quote !== ""){
      ?(c === "\\" ){ i++; continue }
      ?(c === quote){ quote = "" }
      continue
    }
    ?(c === "\"" || c === "'" || c === "`"){ quote = c; continue }
    ?(c === openCh){ depth++ }
    :(c === closeCh){
      depth--;
      ?(depth === 0){ ^s.slice(openIdx + 1, i) }
    }
  }
  ^null
}

!indexOfBraceAfterHeader(s, from){
  depthParen = 0;
  depthLt = 0;
  quote = "";
  #(i = from; i < s.length; i++){
    c = s.charAt(i);
    ?(quote !== ""){
      ?(c === "\\" ){ i++; continue }
      ?(c === quote){ quote = "" }
      continue
    }
    ?(c === "\"" || c === "'" || c === "`"){ quote = c; continue }
    ?(c === "("){ depthParen++ }
    :(c === ")"){ depthParen-- }
    :(c === "<"){ depthLt++ }
    :(c === ">"){ depthLt-- }
    :(c === "{" && depthParen <= 0){ ^i }
    :(c === ";" && depthParen <= 0 && depthLt <= 0){ ^-1 }
  }
  ^-1
}

!escapeBracesInQuoted(s){
  out = "";
  quote = "";
  #(i = 0; i < s.length; i++){
    c = s.charAt(i);
    ?(quote !== ""){
      ?(c === "\\"){ out = out + c + s.charAt(i + 1); i++; continue }
      ?(c === quote){ quote = ""; out = out + c; continue }
      ?(c === "{"){ out = out + "\\x7b"; continue }
      ?(c === "}"){ out = out + "\\x7d"; continue }
      out = out + c;
      continue
    }
    ?(c === "\"" || c === "'"){ quote = c; out = out + c; continue }
    out = out + c
  }
  ^out
}

!transpileRustToLin(rustSource){
  clean = rustSource.replace(/\/\/.*$/gm, "");
  rawFns = extractBracedFunctions(clean, /(?:pub\s+)?(?:async\s+)?fn\s+([A-Za-z0-9_$]+)/g);
  fns = [];
  #(i = 0; i < rawFns.length; i++){
    rf = rawFns[i];
    params = rf.rawParams.split(",").map(function(p){
      parts = p.split(":");
      ^parts[0].replace(/&(?:mut\s+)?/, "").trim()
    }).filter(Boolean).join(",");
    
    body = escapeBracesInQuoted(rf.body);
    body = body.replace(/([A-Za-z0-9_]+)!/g, "$1_macro");
    body = body.replace(/\blet\s+mut\s+/g, "").replace(/\blet\s+/g, "");
    body = body.replace(/\}\s*else\s+if\s+([^{]+)\{/g, "}:($1){");
    body = body.replace(/\}\s*else\s*\{/g, "}:{");
    body = body.replace(/\belse\s+if\s+([^{]+)\{/g, ":($1){");
    body = body.replace(/\belse\s*\{/g, "}:{");
    body = body.replace(/\bif\s+([^{]+)\{/g, "?($1){");
    body = body.replace(/\bwhile\s+([^{]+)\{/g, ";while($1){");
    body = body.replace(/\breturn\s+([^;]+);/g, "^$1;");
    body = body.replace(/([A-Za-z0-9_$]+)\.len\(\)/g, "$1.length");
    fns.push({ name: rf.name, params: params, body: body })
  }
  ?(fns.length === 0){
    fns.push({ name: "moduleMain", params: "", body: "^null;" })
  }
  exportNames = fns.map(function(f){ ^f.name });
  outLines = ["@LIN:L1c:0.2"];
  #(j = 0; j < fns.length; j++){
    fn = fns[j];
    outLines.push("!" + fn.name + "(" + fn.params + "){" + fn.body + "}")
  }
  outLines.push("=ex{" + exportNames.join(", ") + "}");
  ^outLines.join("\n")
}

!transpileGoToLin(goSource){
  clean = goSource.replace(/\/\/.*$/gm, "");
  rawFns = extractBracedFunctions(clean, /func\s+([A-Za-z0-9_$]+)/g);
  fns = [];
  #(i = 0; i < rawFns.length; i++){
    rf = rawFns[i];
    params = rf.rawParams.split(",").map(function(p){
      ^p.trim().split(/\s+/)[0]
    }).filter(Boolean).join(",");
    
    body = rf.body;
    body = body.replace(/var\s+/g, "");
    body = body.replace(/:=\s*/g, "= ");
    body = body.replace(/\}\s*else\s+if\s+([^{]+)\{/g, "}:($1){");
    body = body.replace(/\}\s*else\s*\{/g, "}:{");
    body = body.replace(/\belse\s+if\s+([^{]+)\{/g, ":($1){");
    body = body.replace(/\belse\s*\{/g, "}:{");
    body = body.replace(/\bif\s+([^{]+)\{/g, "?($1){");
    body = body.replace(/\bfor\s+([^{]+)\{/g, ";while($1){");
    body = body.replace(/\breturn\s+([^;]+);/g, "^$1;");
    fns.push({ name: rf.name, params: params, body: body })
  }
  exportNames = fns.map(function(f){ ^f.name });
  outLines = ["@LIN:L1c:0.2"];
  #(j = 0; j < fns.length; j++){
    fn = fns[j];
    outLines.push("!" + fn.name + "(" + fn.params + "){" + fn.body + "}")
  }
  outLines.push("=ex{" + exportNames.join(", ") + "}");
  ^outLines.join("\n")
}

!cppStripPreprocessor(cSource){
  joined = cSource.replace(/\\\r?\n/g, " ");
  joined = joined.replace(/\[\[(?:[^\[\]]|\[[^\]]*\])*\]\]/g, " ");
  joined = joined.replace(/([0-9a-fA-F])'([0-9a-fA-F])/g, "$1$2");
  lines = joined.split("\n");
  out = [];
  #(k = 0; k < lines.length; k++){
    line = lines[k];
    t = line.trim();
    ?(!t.startsWith("#")){ out.push(line); continue };
    ?(t.startsWith("#if") || t.startsWith("#ifdef") || t.startsWith("#ifndef")){
      out.push("?(CPP_TRUE){");
      continue
    };
    ?(t.startsWith("#elif")){
      out.push("}:{");
      continue
    };
    ?(t.startsWith("#else")){
      out.push("}:{");
      continue
    };
    ?(t.startsWith("#endif")){ out.push("}"); continue };
    ?(t.startsWith("#define")){ out.push("// cpp_define"); continue };
    ?(t.startsWith("#include") || t.startsWith("#pragma") || t.startsWith("#undef") || t.startsWith("#import") || t.startsWith("#error") || t.startsWith("#warning")){ continue };
  };
  ^out.join("\n")
}

!linSafeIdent(name){
  s = String(name || "");
  s = s.replace(/~/g, "dtor_");
  s = s.replace(/::/g, "_");
  s = s.replace(/[^A-Za-z0-9_$]/g, "_");
  ?(s.length === 0 || /^[0-9]/.test(s)){ ^("_" + s) }
  ^s
}

!extractDefaultedCpp(source){
  fns = [];
  re = /((?:[A-Za-z0-9_$]+::)+[~A-Za-z0-9_$]+)\s*\(([^)]*)\)[^{;]*=\s*default/g;
  m = null;
  while ((m = re.exec(source)) !== null) {
    fns.push({ name: m[1], rawParams: m[2], body: "^0;" })
  }
  ^fns
}

!gtestLinName(kind, rawParams){
  ^linSafeIdent(kind + "_" + String(rawParams || "").replace(/,/g, "_"))
}

!transpileCToLin(cSource){
  clean = cppStripPreprocessor(cSource).replace(/\/\/.*$/gm, "").replace(/\/\*[\s\S]*?\*\//g, "");
  rawFns = extractBracedFunctions(clean, /((?:[A-Za-z0-9_$]+::)*[~A-Za-z0-9_$]+)\s*(?=\()/g);
  rawFns = rawFns.concat(extractDefaultedCpp(clean));
  fns = [];
  seen = {};
  gtest = ["TEST", "TEST_F", "TEST_P", "TYPED_TEST", "TYPED_TEST_P", "IN_PROC_BROWSER_TEST_F", "IN_PROC_BROWSER_TEST_P"];
  #(i = 0; i < rawFns.length; i++){
    rf = rawFns[i];
    ?(gtest.includes(rf.name)){ name = gtestLinName(rf.name, rf.rawParams) }
    :{ name = linSafeIdent(rf.name) }
    ?(["if", "while", "for", "switch", "catch", "try", "sizeof", "return", "new", "delete"].includes(rf.name)){ continue }
    ?(seen[name]){ name = name + "_" + String(i) }
    ?(rf.rawParams.indexOf(";") >= 0){ continue }
    seen[name] = 1;
    params = rf.rawParams.split(",").map(function(p){
      parts = p.trim().split(/\s+/);
      ^linSafeIdent(parts[parts.length - 1].replace(/^\*/, "").replace(/[&\[\]]/g, ""))
    }).filter(Boolean).join(",");
    
    body = rf.body;
    body = body.replace(/\b(?:int|float|double|char|long|unsigned|void)\s+/g, "");
    body = body.replace(/\}\s*else\s+if\s*\(([^)]+)\)\s*\{/g, "}:($1){");
    body = body.replace(/\}\s*else\s*\{/g, "}:{");
    body = body.replace(/\belse\s+if\s*\(([^)]+)\)\s*\{/g, ":($1){");
    body = body.replace(/\belse\s*\{/g, "}:{");
    body = body.replace(/\bif\s*\(([^)]+)\)\s*\{/g, "?($1){");
    body = body.replace(/\bwhile\s*\(([^)]+)\)\s*\{/g, ";while($1){");
    body = body.replace(/\breturn\s+([^;]+);/g, "^$1;");
    fns.push({ name: name, params: params, body: body })
  }
  exportNames = fns.map(function(f){ ^f.name });
  outLines = ["@LIN:L1c:0.2"];
  #(j = 0; j < fns.length; j++){
    fn = fns[j];
    outLines.push("!" + fn.name + "(" + fn.params + "){" + fn.body + "}")
  }
  outLines.push("=ex{" + exportNames.join(", ") + "}");
  ^outLines.join("\n")
}

!transpileZigToLin(zigSource){
  clean = zigSource.replace(/\/\/.*$/gm, "");
  rawFns = extractBracedFunctions(clean, /(?:pub\s+)?(?:async\s+)?fn\s+([A-Za-z0-9_$]+)/g);
  fns = [];
  #(i = 0; i < rawFns.length; i++){
    rf = rawFns[i];
    ?(rf.name === "main"){ continue }
    params = rf.rawParams.split(",").map(function(p){
      ^p.trim().split(":")[0].trim()
    }).filter(Boolean).join(",");
    
    body = rf.body;
    body = body.replace(/var\s+|const\s+/g, "");
    body = body.replace(/:\s*[^=;\n]+\s*=/g, "=");
    body = body.replace(/\}\s*else\s+if\s*\(([^)]+)\)\s*\{/g, "}:($1){");
    body = body.replace(/\}\s*else\s*\{/g, "}:{");
    body = body.replace(/\belse\s+if\s*\(([^)]+)\)\s*\{/g, ":($1){");
    body = body.replace(/\belse\s*\{/g, "}:{");
    body = body.replace(/\bif\s*\(([^)]+)\)\s*\{/g, "?($1){");
    body = body.replace(/\bwhile\s*\(([^)]+)\)\s*\{/g, ";while($1){");
    body = body.replace(/@rem\(([^,]+),\s*([^)]+)\)/g, "($1 % $2)");
    body = body.replace(/@divTrunc\(([^,]+),\s*([^)]+)\)/g, "($1 / $2)");
    body = body.replace(/\band\b/g, "&&").replace(/\bor\b/g, "||");
    body = body.replace(/\breturn\s+([^;]+);/g, "^$1;");
    fns.push({ name: rf.name, params: params, body: body })
  }
  exportNames = fns.map(function(f){ ^f.name });
  outLines = ["@LIN:L1c:0.2"];
  #(j = 0; j < fns.length; j++){
    fn = fns[j];
    outLines.push("!" + fn.name + "(" + fn.params + "){" + fn.body + "}")
  }
  outLines.push("=ex{" + exportNames.join(", ") + "}");
  ^outLines.join("\n")
}

=ex{detectLanguage, extractBracedFunctions, sliceMatching, indexOfBraceAfterHeader, transpileRustToLin, transpileGoToLin, transpileCToLin, transpileZigToLin}
