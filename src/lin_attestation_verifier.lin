@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=attestation_verifier
~G{?=if #=for ^=ret :else}

!verify_source_binding(blob_oid_hash: int, expected_hash: int) -> int {
    match = 0;
    ?(blob_oid_hash == expected_hash) {
        match = 1;
    }
    ^match;
}

!verify_merkle_commitment(computed_root: int, stated_root: int) -> int {
    valid = 0;
    ?(computed_root == stated_root) {
        valid = 1;
    }
    ^valid;
}

!verify_deterministic_parity(cpu_res: int, gpu_res: int, oracle_res: int) -> int {
    parity = 0;
    ?(cpu_res == gpu_res) {
        ?(gpu_res == oracle_res) {
            parity = 1;
        }
    }
    ^parity;
}

!evaluate_9_gate_attestation_closure(gate_mask: int) -> int {
    // 9 gates (bits 0..8) => 0x1FF = 511
    all_valid = 0;
    ?(gate_mask == 511) {
        all_valid = 1;
    }
    ^all_valid;
}

=ex{verify_source_binding, verify_merkle_commitment, verify_deterministic_parity, evaluate_9_gate_attestation_closure}
