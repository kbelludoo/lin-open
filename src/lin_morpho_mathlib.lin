@LIN:L1c:0.2
@MORPHO_BLUE_MATHLIB{
  version=1
  repo="morpho-org/morpho-blue"
  source="src/libraries/MathLib.sol"
  license="MIT"
  license_note="file SPDX MIT; repository LICENSE is GPL-2.0"
  commit="339a885801972740eb27f51da110a4675b839d42"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_i64pos_morpho_wad_muldiv_and_wtaylor_with_128bit_product"
  note="Not mainnet uint256. Real deltas: 128-bit (x*y)/d; ceil via remainder+1 not (prod+d-1)/d; fail-closed if quotient exceeds i64; elapsed is an argument (no block.timestamp)."
}

!mm_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!mm_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(mm_u_lt(s, a));
}

!mm_mask32() -> int {
  ^ 4294967295;
}

!mm_wad() -> int {
  ^ 1000000000000000000;
}

!mm_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = mm_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = mm_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = mm_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(mm_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = mm_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!mm_muldiv(a: int, b: int, d: int) -> int {
  ^ mm_muldiv_part(a, b, d, 0);
}

!mm_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ mm_muldiv_part(a, b, d, 1);
}

!mm_muldiv_ceil(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(mm_muldiv_part(a, b, d, 2) == 1) { ^ 0; };
  q = mm_muldiv_part(a, b, d, 0);
  r = mm_muldiv_part(a, b, d, 1);
  ?(r == 0) { ^ q; };
  s = q + 1;
  ?(s <= 0) { ^ 0; };
  ^ s;
}

!mm_wmul_down(x: int, y: int) -> int {
  ^ mm_muldiv(x, y, mm_wad());
}

!mm_wdiv_down(x: int, y: int) -> int {
  ?(y == 0) { ^ 0; };
  ^ mm_muldiv(x, mm_wad(), y);
}

!mm_wdiv_up(x: int, y: int) -> int {
  ?(y == 0) { ^ 0; };
  ^ mm_muldiv_ceil(x, mm_wad(), y);
}

!mm_wtaylor(x: int, n: int) -> int {
  ?(x < 0) { ^ 0; };
  ?(n < 0) { ^ 0; };
  first = mm_muldiv(x, n, 1);
  ?(first == 0) { ^ 0; };
  second = mm_muldiv(first, first, mm_wad() + mm_wad());
  third = mm_muldiv(second, first, mm_wad() + mm_wad() + mm_wad());
  s1 = first + second;
  ?(mm_u_lt(s1, first) == 1) { ^ 0; };
  s2 = s1 + third;
  ?(mm_u_lt(s2, s1) == 1) { ^ 0; };
  ?(s2 < 0) { ^ 0; };
  ^ s2;
}

!mm_accrue_interest(total_borrow: int, rate: int, elapsed: int) -> int {
  ?(elapsed == 0) { ^ 0; };
  t = mm_wtaylor(rate, elapsed);
  ^ mm_wmul_down(total_borrow, t);
}

!mm_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!mm_test_suite() -> int {
  w = mm_wad();
  ?(mm_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(mm_muldiv(7, 9, 2) != 31) { ^ -2; };
  ?(mm_muldiv_ceil(7, 9, 2) != 32) { ^ -3; };
  ?(mm_muldiv_rem(7, 9, 2) != 1) { ^ -4; };
  ?(mm_wmul_down(w, w) != w) { ^ -5; };
  ?(mm_wdiv_down(2, 3) != 666666666666666666) { ^ -6; };
  ?(mm_wdiv_up(2, 3) != 666666666666666667) { ^ -7; };
  ?(mm_wdiv_down(1, 3) != 333333333333333333) { ^ -8; };
  ?(mm_wdiv_up(1, 3) != 333333333333333334) { ^ -9; };
  ?(mm_wdiv_down(10, w + w + w) != 3) { ^ -10; };
  ?(mm_wdiv_up(10, w + w + w) != 4) { ^ -11; };
  ?(mm_wmul_down(0, w) != 0) { ^ -12; };
  ?(mm_wdiv_down(w, 0) != 0) { ^ -13; };
  ?(mm_wdiv_up(w, 0) != 0) { ^ -14; };
  ?(mm_muldiv(w, w, 1) != 0) { ^ -15; };
  ?(mm_naive_i64_mul(w, w) != -5527149226598858752) { ^ -16; };
  ?(mm_wtaylor(0, 86400) != 0) { ^ -17; };
  ?(mm_wtaylor(3170979198, 0) != 0) { ^ -18; };
  ?(mm_wtaylor(3170979198, 86400) != 274010136628159) { ^ -19; };
  ?(mm_accrue_interest(w, 3170979198, 0) != 0) { ^ -20; };
  ?(mm_accrue_interest(w, 3170979198, 86400) != 274010136628159) { ^ -21; };
  ?(mm_accrue_interest(w + w + w + w + w, 3170979198, 86400) != 1370050683140795) { ^ -22; };
  ?(mm_wtaylor(3170979198, 3600) != 11415590270153) { ^ -23; };
  ^ 1;
}

=ex{
  mm_u_lt,
  mm_u_add_carry,
  mm_mask32,
  mm_wad,
  mm_muldiv_part,
  mm_muldiv,
  mm_muldiv_rem,
  mm_muldiv_ceil,
  mm_wmul_down,
  mm_wdiv_down,
  mm_wdiv_up,
  mm_wtaylor,
  mm_accrue_interest,
  mm_naive_i64_mul,
  mm_test_suite
}
