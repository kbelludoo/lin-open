@LIN:L1c:0.2
@LIN_TYPE_CHECK{version=1.0 purpose=static_type_checker}

!is_type_ident(s: string): bool {
  ?(s == "int" || s == "string" || s == "bool" || s == "any" || s == "void"){ ^true };
  ^false;
}

!extract_param_type(param: string): string {
  n = param.length;
  i = 0;
  while (i < n) {
    ?(param.charCodeAt(i) == 58){
      j = i + 1;
      while (j < n && (param.charCodeAt(j) == 32 || param.charCodeAt(j) == 9)){ j = j + 1 };
      k = j;
      while (k < n && param.charCodeAt(k) != 32 && param.charCodeAt(k) != 44){ k = k + 1 };
      ^param.slice(j, k);
    };
    i = i + 1;
  };
  ^"any";
}

!extract_return_type(hdr: string): string {
  n = hdr.length;
  i = 0;
  while (i < n) {
    ?(i + 1 < n && hdr.charCodeAt(i) == 45 && hdr.charCodeAt(i + 1) == 62){
      j = i + 2;
      while (j < n && (hdr.charCodeAt(j) == 32 || hdr.charCodeAt(j) == 9)){ j = j + 1 };
      k = j;
      while (k < n && hdr.charCodeAt(k) != 32 && hdr.charCodeAt(k) != 123){ k = k + 1 };
      ^hdr.slice(j, k);
    };
    i = i + 1;
  };
  ^"any";
}

!is_int_lit(s: string): bool {
  n = s.length;
  ?(n == 0){ ^false };
  i = 0;
  ?(s.charCodeAt(0) == 45 && n > 1){ i = 1 };
  while (i < n) {
    c = s.charCodeAt(i);
    ?(c < 48 || c > 57){ ^false };
    i = i + 1;
  };
  ^true;
}

!is_str_lit(s: string): bool {
  n = s.length;
  ?(n >= 2 && s.charCodeAt(0) == 34 && s.charCodeAt(n - 1) == 34){ ^true };
  ^false;
}

!is_bool_lit(s: string): bool {
  ?(s == "true" || s == "false"){ ^true };
  ^false;
}

!check_type_compat(expected: string, actual: string): int {
  ?(expected == "any" || actual == "any" || expected == actual){ ^1 };
  ^0;
}

=ex{is_type_ident, extract_param_type, extract_return_type, is_int_lit, is_str_lit, is_bool_lit, check_type_compat}
