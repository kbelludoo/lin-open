@LIN:vm_core:1.0.0
^schema_once ^lossy=true ^ops=vm_core
~G{?=if #=for ^=ret :else}

!assertJsSyntaxCore(code){
  ?(code == null || code.length == 0){ ^false }
  ^true
}

!validateSandboxSpec(spec){
  allowed = ["node:crypto", "crypto", "node:buffer", "buffer", "node:util", "util"];
  ?(allowed.includes(spec)){ ^true }
  ^false
}

=ex{assertJsSyntaxCore, validateSandboxSpec}
