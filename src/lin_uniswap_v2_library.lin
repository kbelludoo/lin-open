@LIN:MODULE:2.0.0
// ============================================================================
// STATUS (R5): TOY / PROTÓTIPO int64 — NÃO É O MOTOR CANÔNICO.
//
// Este módulo usa `int` de 64 bits com sinal e o operador `/`. Em valores reais
// da Mainnet (reservas de 18 decimais ~1e21, e o produto amount_in*997*reserve_out)
// TODOS os intermediários estouram 2^63-1 e o resultado é lixo silencioso
// (ver examples/defi_settlement_proof/README.md, vetores B2/B3 e reserve_in=2^62).
//
// É válido apenas no domínio em que todos os intermediários cabem em i64
// (fixtures pequenas / testes de gramática). Para Mainnet use o motor canônico:
//   examples/defi_settlement_proof/u256_settlement_engine.lin
// (16 limbs x 16 bits, sem `/`, fail-closed em overflow de 256 bits).
// ============================================================================
@UNISWAP_V2_OFFICIAL_PERIPHERY_SPEC{
  status="TOY_INT64_PROTOTYPE_NOT_FOR_MAINNET_VALUES"
  canonical_engine="examples/defi_settlement_proof/u256_settlement_engine.lin"
  cloned_repo="https://github.com/Uniswap/v2-periphery"
  source_file="contracts/libraries/UniswapV2Library.sol"
  test_spec="test/UniswapV2Router02.spec.ts"
  commit_hash="canonical_v2_periphery"
}

// 1. quote(amountA, reserveA, reserveB)
// Official Spec: amountB = (amountA * reserveB) / reserveA
!quote(amount_a: int, reserve_a: int, reserve_b: int) -> int {
  ?(amount_a <= 0 | reserve_a <= 0 | reserve_b <= 0) {
    ^ 0;
  } : {
    amount_b = (amount_a * reserve_b) / reserve_a;
    ^ amount_b;
  }
}

// 2. getAmountOut(amountIn, reserveIn, reserveOut)
// Official Spec:
// uint amountInWithFee = amountIn.mul(997);
// uint numerator = amountInWithFee.mul(reserveOut);
// uint denominator = reserveIn.mul(1000).add(amountInWithFee);
// amountOut = numerator / denominator;
!get_amount_out(amount_in: int, reserve_in: int, reserve_out: int) -> int {
  ?(amount_in <= 0 | reserve_in <= 0 | reserve_out <= 0) {
    ^ 0;
  } : {
    amount_in_with_fee = amount_in * 997;
    numerator = amount_in_with_fee * reserve_out;
    denominator = (reserve_in * 1000) + amount_in_with_fee;
    ?(denominator <= 0) {
      ^ 0;
    } : {
      amount_out = numerator / denominator;
      ^ amount_out;
    }
  }
}

// 3. getAmountIn(amountOut, reserveIn, reserveOut)
// Official Spec:
// uint numerator = reserveIn.mul(amountOut).mul(1000);
// uint denominator = reserveOut.sub(amountOut).mul(997);
// amountIn = (numerator / denominator).add(1);
!get_amount_in(amount_out: int, reserve_in: int, reserve_out: int) -> int {
  ?(amount_out <= 0 | reserve_in <= 0 | reserve_out <= 0 | amount_out >= reserve_out) {
    ^ 0;
  } : {
    numerator = reserve_in * amount_out * 1000;
    denominator = (reserve_out - amount_out) * 997;
    ?(denominator <= 0) {
      ^ 0;
    } : {
      amount_in = (numerator / denominator) + 1;
      ^ amount_in;
    }
  }
}

=ex{quote, get_amount_out, get_amount_in}
