@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=n_version_verifier_v240
~G{?=if #=for ^=ret :else}

!verify_three_way_consensus(v_a: int, v_b: int, v_c: int) -> int {
    consensus = 0;
    ?(v_a == v_b) {
        ?(v_b == v_c) {
            consensus = 1;
        }
    }
    ^consensus;
}

!evaluate_common_mode_divergence(agree_oracle: int, false_consensus_count: int, semantic_divergence_count: int) -> int {
    zero_divergence = 0;
    ?(agree_oracle == 1) {
        ?(false_consensus_count == 0) {
            ?(semantic_divergence_count == 0) {
                zero_divergence = 1;
            }
        }
    }
    ^zero_divergence;
}

!format_n_version_verdict(consensus_ok: int, zero_divergence: int, implementations_tested: int) -> int {
    verdict = 0;
    ?(consensus_ok == 1) {
        ?(zero_divergence == 1) {
            ?(implementations_tested == 3) {
                verdict = 3000;
            }
        }
    }
    ^verdict;
}

=ex{verify_three_way_consensus, evaluate_common_mode_divergence, format_n_version_verdict}
