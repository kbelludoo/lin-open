@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=gpu_ir_to_opencl
~G{?=if #=for ^=ret :else}

!get_reduce_op_identity(rop: int) -> int {
    // 0: sum (0), 1: product (1), 2: min (INT_MAX), 3: max (INT_MIN), 4: band (~0), 5: bor (0), 6: bxor (0)
    identity = 0;
    ?(rop == 0) {
        identity = 0;
    }
    ?(rop == 1) {
        identity = 1;
    }
    ?(rop == 2) {
        identity = 2147483647;
    }
    ?(rop == 3) {
        identity = -2147483648;
    }
    ?(rop == 4) {
        identity = -1;
    }
    ?(rop == 5) {
        identity = 0;
    }
    ?(rop == 6) {
        identity = 0;
    }
    ^identity;
}

!compute_kernel_semantic_hash(gpu_ir_hash: int, op_code: int) -> int {
    hash = (gpu_ir_hash * 31) + (op_code * 104729) + 42;
    ^hash;
}

!validate_opencl_kernel_signature(param_count: int, workgroup_size: int) -> int {
    valid = 0;
    ?(param_count > 0) {
        ?(workgroup_size >= 64) {
            valid = 1;
        }
    }
    ^valid;
}

=ex{get_reduce_op_identity, compute_kernel_semantic_hash, validate_opencl_kernel_signature}
