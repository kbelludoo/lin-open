@LIN:L1c:0.2
@ERC4626_VAULT{
  version=1
  repo="OpenZeppelin/openzeppelin-contracts"
  source="contracts/token/ERC20/extensions/ERC4626.sol"
  license="MIT"
  tag="v5.0.2"
  commit="dbb6104ce834628e473d2173bbc9d47f81a9eec3"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_erc4626_virtual_shares_with_128bit_muldiv"
  note="Not a vault, not uint256. Real deltas: totalSupply/totalAssets/offset are arguments; floor/ceil (a*b)/d uses a 128-bit product; overflow, negatives, and offset>18 fail-closed."
}

!e4626_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!e4626_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(e4626_u_lt(s, a));
}

!e4626_u_add_ok(a: int, b: int) -> int {
  s = a + b;
  ?(e4626_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!e4626_mask32() -> int {
  ^ 4294967295;
}

!e4626_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d <= 0) { ^ 0; };
  ?(a < 0 || b < 0) { ^ 0; };
  m32 = e4626_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = e4626_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = e4626_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(e4626_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = e4626_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want == 1) { ^ r_lo; };
  ?(want == 2) { ^ ov; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!e4626_muldiv(a: int, b: int, d: int) -> int {
  ^ e4626_muldiv_part(a, b, d, 0);
}

!e4626_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ e4626_muldiv_part(a, b, d, 1);
}

!e4626_muldiv_ceil(a: int, b: int, d: int) -> int {
  ?(e4626_muldiv_part(a, b, d, 2) != 0) { ^ 0; };
  q = e4626_muldiv(a, b, d);
  r = e4626_muldiv_rem(a, b, d);
  ?(r == 0) { ^ q; };
  s = q + 1;
  ?(e4626_u_lt(s, q) == 1) { ^ 0; };
  ^ s;
}

!e4626_pow10(exp: int) -> int {
  ?(exp < 0) { ^ 0; };
  ?(exp > 18) { ^ 0; };
  p = 1;
  i = 0;
  while (i < exp) {
    ?(e4626_u_lt(1844674407370955161, p) == 1) { ^ 0; };
    p = p * 10;
    i = i + 1;
  };
  ^ p;
}

!e4626_virtuals(supply: int, total_assets: int, offset: int) -> int {
  ?(supply < 0 || total_assets < 0) { ^ 0; };
  vs = e4626_pow10(offset);
  ?(vs == 0) {
    ?(offset != 0) { ^ 0; };
  };
  ?(e4626_u_add_ok(supply, vs) == 0) { ^ 0; };
  ?(e4626_u_add_ok(total_assets, 1) == 0) { ^ 0; };
  ^ 1;
}

!e4626_shares_floor(assets: int, supply: int, total_assets: int, offset: int) -> int {
  ?(assets < 0) { ^ 0; };
  ?(e4626_virtuals(supply, total_assets, offset) == 0) { ^ 0; };
  vs = e4626_pow10(offset);
  ^ e4626_muldiv(assets, supply + vs, total_assets + 1);
}

!e4626_shares_ceil(assets: int, supply: int, total_assets: int, offset: int) -> int {
  ?(assets < 0) { ^ 0; };
  ?(e4626_virtuals(supply, total_assets, offset) == 0) { ^ 0; };
  vs = e4626_pow10(offset);
  ^ e4626_muldiv_ceil(assets, supply + vs, total_assets + 1);
}

!e4626_assets_floor(shares: int, supply: int, total_assets: int, offset: int) -> int {
  ?(shares < 0) { ^ 0; };
  ?(e4626_virtuals(supply, total_assets, offset) == 0) { ^ 0; };
  vs = e4626_pow10(offset);
  ^ e4626_muldiv(shares, total_assets + 1, supply + vs);
}

!e4626_assets_ceil(shares: int, supply: int, total_assets: int, offset: int) -> int {
  ?(shares < 0) { ^ 0; };
  ?(e4626_virtuals(supply, total_assets, offset) == 0) { ^ 0; };
  vs = e4626_pow10(offset);
  ^ e4626_muldiv_ceil(shares, total_assets + 1, supply + vs);
}

!e4626_preview_deposit(assets: int, supply: int, total_assets: int, offset: int) -> int {
  ^ e4626_shares_floor(assets, supply, total_assets, offset);
}

!e4626_preview_mint(shares: int, supply: int, total_assets: int, offset: int) -> int {
  ^ e4626_assets_ceil(shares, supply, total_assets, offset);
}

!e4626_test_suite() -> int {
  ?(e4626_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(e4626_muldiv(7, 9, 2) != 31) { ^ -2; };
  ?(e4626_muldiv_ceil(7, 9, 2) != 32) { ^ -3; };
  ?(e4626_muldiv_rem(7, 9, 2) != 1) { ^ -4; };
  ?(e4626_pow10(0) != 1) { ^ -5; };
  ?(e4626_pow10(3) != 1000) { ^ -6; };
  ?(e4626_pow10(18) != 1000000000000000000) { ^ -7; };
  ?(e4626_pow10(19) != 0) { ^ -8; };
  ?(e4626_shares_floor(1000, 0, 0, 0) != 1000) { ^ -9; };
  ?(e4626_shares_floor(1000, 1000, 1000, 0) != 1000) { ^ -10; };
  ?(e4626_shares_floor(1000000000000, 1, 1000000000000, 0) != 1) { ^ -11; };
  ?(e4626_shares_floor(1000, 0, 0, 3) != 1000000) { ^ -12; };
  ?(e4626_assets_floor(1000, 0, 0, 0) != 1000) { ^ -13; };
  ?(e4626_preview_deposit(1000, 0, 0, 0) != 1000) { ^ -14; };
  ?(e4626_preview_mint(1, 0, 0, 0) != 1) { ^ -15; };
  ?(e4626_shares_floor(-1, 0, 0, 0) != 0) { ^ -16; };
  ?(e4626_muldiv(1000000000000000000, 1000000000000000000, 1) != 0) { ^ -17; };
  ?(e4626_assets_floor(e4626_shares_floor(1000, 0, 0, 0), 0, 0, 0) != 1000) { ^ -18; };
  ^ 1;
}

=ex{
  e4626_u_lt,
  e4626_u_add_carry,
  e4626_u_add_ok,
  e4626_mask32,
  e4626_muldiv_part,
  e4626_muldiv,
  e4626_muldiv_rem,
  e4626_muldiv_ceil,
  e4626_pow10,
  e4626_virtuals,
  e4626_shares_floor,
  e4626_shares_ceil,
  e4626_assets_floor,
  e4626_assets_ceil,
  e4626_preview_deposit,
  e4626_preview_mint,
  e4626_test_suite
}
