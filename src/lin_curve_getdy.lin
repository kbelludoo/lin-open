@LIN:L1c:0.2
@CURVE_3POOL_GETDY{
  version=1
  repo="curvefi/curve-contract"
  source="contracts/pools/3pool/StableSwap3Pool.vy get_dy"
  license="all_rights_reserved_informational_upstream"
  commit="bae23a2fc9a0302d174ea1ffce8219a44a92149c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_curve_3pool_get_dy_quote_fee_128bit"
  note="Not mainnet uint256. N=3 explicit x0,x1,x2. amp and fee are arguments (not self._A/self.fee/self._xp). SCALE=1e9 equal rates (RATES 1e30 does not fit i64). dx=0 fail-closes instead of wrapping xp[j]-y-1. Fee is floor(fee*dy/1e10). Upstream Curve.Fi is not vendored."
}

!cgd_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cgd_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cgd_u_lt(s, a));
}

!cgd_mask32() -> int {
  ^ 4294967295;
}

!cgd_n() -> int {
  ^ 3;
}

!cgd_fee_den() -> int {
  ^ 10000000000;
}

!cgd_rates_1e30_fits() -> int {
  ^ 0;
}

!cgd_close1(a: int, b: int) -> int {
  ?(a >= b) {
    ?(a - b <= 1) { ^ 1; };
    ^ 0;
  };
  ?(b - a <= 1) { ^ 1; };
  ^ 0;
}

!cgd_muldiv_add_part(a: int, b: int, add: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = cgd_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cgd_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cgd_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + cgd_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cgd_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cgd_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!cgd_muldiv(a: int, b: int, d: int) -> int {
  ^ cgd_muldiv_add_part(a, b, 0, d, 0);
}

!cgd_pick(i: int, x0: int, x1: int, x2: int) -> int {
  ?(i == 0) { ^ x0; };
  ?(i == 1) { ^ x1; };
  ?(i == 2) { ^ x2; };
  ^ 0;
}

!cgd_xp_ok(x0: int, x1: int, x2: int, amp: int) -> int {
  ?(amp <= 0) { ^ 0; };
  ?(x0 <= 0) { ^ 0; };
  ?(x1 <= 0) { ^ 0; };
  ?(x2 <= 0) { ^ 0; };
  ^ 1;
}

!cgd_accum_s(k: int, i: int, j: int, x: int, xk: int, s: int) -> int {
  ?(k == j) { ^ s; };
  _x = xk;
  ?(k == i) { _x = x; };
  ?(_x <= 0) { ^ 0; };
  t = s + _x;
  ?(cgd_u_lt(t, s) == 1) { ^ 0; };
  ^ t;
}

!cgd_accum_c(k: int, i: int, j: int, x: int, xk: int, d: int, c: int) -> int {
  ?(k == j) { ^ c; };
  _x = xk;
  ?(k == i) { _x = x; };
  ?(_x <= 0) { ^ 0; };
  den = _x * cgd_n();
  ?(den <= 0) { ^ 0; };
  ^ cgd_muldiv(c, d, den);
}

!cgd_get_d(x0: int, x1: int, x2: int, amp: int) -> int {
  ?(cgd_xp_ok(x0, x1, x2, amp) == 0) { ^ 0; };
  s = x0 + x1;
  ?(cgd_u_lt(s, x0) == 1) { ^ 0; };
  s = s + x2;
  ?(cgd_u_lt(s, x2) == 1) { ^ 0; };
  ?(s == 0) { ^ 0; };
  n = cgd_n();
  ann = amp * n;
  ?(ann <= amp) { ^ 0; };
  d = s;
  iter = 0;
  done = 0;
  while (iter < 255) {
    ?(done == 0) {
      dp = d;
      dp = cgd_muldiv(dp, d, x0 * n);
      dp = cgd_muldiv(dp, d, x1 * n);
      dp = cgd_muldiv(dp, d, x2 * n);
      ?(dp < 0) { d = 0; done = 1; };
      ?(done == 0) {
        dprev = d;
        dp_n = cgd_muldiv(dp, n, 1);
        ?(cgd_muldiv_add_part(ann, s, dp_n, 1, 2) == 1) { d = 0; done = 1; };
        ?(done == 0) {
          sum = cgd_muldiv_add_part(ann, s, dp_n, 1, 0);
          left = cgd_muldiv(ann - 1, d, 1);
          right = cgd_muldiv(n + 1, dp, 1);
          den = left + right;
          ?(cgd_u_lt(den, left) == 1) { d = 0; done = 1; };
          ?(done == 0) {
            ?(cgd_muldiv_add_part(sum, d, 0, den, 2) == 1) { d = 0; done = 1; };
            ?(done == 0) {
              d = cgd_muldiv(sum, d, den);
              ?(cgd_close1(d, dprev) == 1) { done = 1; };
            };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ d;
}

!cgd_get_y(i: int, j: int, x: int, x0: int, x1: int, x2: int, amp: int) -> int {
  ?(i == j) { ^ 0; };
  ?(i < 0) { ^ 0; };
  ?(j < 0) { ^ 0; };
  ?(i > 2) { ^ 0; };
  ?(j > 2) { ^ 0; };
  ?(x <= 0) { ^ 0; };
  ?(cgd_xp_ok(x0, x1, x2, amp) == 0) { ^ 0; };
  d = cgd_get_d(x0, x1, x2, amp);
  ?(d <= 0) { ^ 0; };
  n = cgd_n();
  ann = amp * n;
  c = d;
  s_ = 0;
  s_ = cgd_accum_s(0, i, j, x, x0, s_);
  s_ = cgd_accum_s(1, i, j, x, x1, s_);
  s_ = cgd_accum_s(2, i, j, x, x2, s_);
  c = cgd_accum_c(0, i, j, x, x0, d, c);
  c = cgd_accum_c(1, i, j, x, x1, d, c);
  c = cgd_accum_c(2, i, j, x, x2, d, c);
  ?(c <= 0) { ^ 0; };
  ?(cgd_muldiv_add_part(ann, n, 0, 1, 2) == 1) { ^ 0; };
  ann_n = cgd_muldiv(ann, n, 1);
  ?(ann_n <= 0) { ^ 0; };
  c = cgd_muldiv(c, d, ann_n);
  ?(c <= 0) { ^ 0; };
  d_ann = cgd_muldiv(d, 1, ann);
  b = s_ + d_ann;
  ?(cgd_u_lt(b, s_) == 1) { ^ 0; };
  y = d;
  iter = 0;
  done = 0;
  while (iter < 255) {
    ?(done == 0) {
      yprev = y;
      two_y = y + y;
      ?(cgd_u_lt(two_y, y) == 1) { y = 0; done = 1; };
      ?(done == 0) {
        num_ok = 1;
        ?(cgd_u_add_carry(two_y, b) == 1) { num_ok = 0; };
        tb = two_y + b;
        ?(cgd_u_lt(tb, d) == 1) { num_ok = 0; };
        ?(num_ok == 0) { y = 0; done = 1; };
        ?(done == 0) {
          den = tb - d;
          ?(den <= 0) { y = 0; done = 1; };
          ?(done == 0) {
            ?(cgd_muldiv_add_part(y, y, c, den, 2) == 1) { y = 0; done = 1; };
            ?(done == 0) {
              y = cgd_muldiv_add_part(y, y, c, den, 0);
              ?(cgd_close1(y, yprev) == 1) { done = 1; };
            };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ y;
}

!cgd_get_dy_nofee(i: int, j: int, dx: int, x0: int, x1: int, x2: int, amp: int) -> int {
  ?(dx < 0) { ^ 0; };
  xi = cgd_pick(i, x0, x1, x2);
  ?(xi <= 0) { ^ 0; };
  x = xi + dx;
  ?(cgd_u_lt(x, xi) == 1) { ^ 0; };
  y = cgd_get_y(i, j, x, x0, x1, x2, amp);
  ?(y <= 0) { ^ 0; };
  xj = cgd_pick(j, x0, x1, x2);
  ?(cgd_u_lt(xj, y) == 1) { ^ 0; };
  raw = xj - y;
  ?(raw <= 0) { ^ 0; };
  ^ raw - 1;
}

!cgd_wrong_omit_minus1(i: int, j: int, dx: int, x0: int, x1: int, x2: int, amp: int) -> int {
  ?(dx < 0) { ^ 0; };
  xi = cgd_pick(i, x0, x1, x2);
  ?(xi <= 0) { ^ 0; };
  x = xi + dx;
  ?(cgd_u_lt(x, xi) == 1) { ^ 0; };
  y = cgd_get_y(i, j, x, x0, x1, x2, amp);
  ?(y <= 0) { ^ 0; };
  xj = cgd_pick(j, x0, x1, x2);
  ?(cgd_u_lt(xj, y) == 1) { ^ 0; };
  ^ xj - y;
}

!cgd_fee_of(dy: int, fee: int) -> int {
  ?(dy <= 0) { ^ 0; };
  ?(fee < 0) { ^ 0; };
  ?(cgd_u_lt(cgd_fee_den(), fee) == 1) { ^ 0; };
  ^ cgd_muldiv(fee, dy, cgd_fee_den());
}

!cgd_get_dy(i: int, j: int, dx: int, x0: int, x1: int, x2: int, amp: int, fee: int) -> int {
  ?(fee < 0) { ^ 0; };
  ?(cgd_u_lt(cgd_fee_den(), fee) == 1) { ^ 0; };
  dy = cgd_get_dy_nofee(i, j, dx, x0, x1, x2, amp);
  ?(dy <= 0) { ^ 0; };
  f = cgd_fee_of(dy, fee);
  ?(cgd_u_lt(dy, f) == 1) { ^ 0; };
  ^ dy - f;
}

!cgd_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!cgd_test_suite() -> int {
  e9 = 1000000000;
  fee = 4000000;
  ?(cgd_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(cgd_get_d(e9, e9, e9, 100) != 3000000000) { ^ -2; };
  ?(cgd_get_y(0, 1, e9, e9, e9, e9, 100) != e9) { ^ -3; };
  ?(cgd_get_y(0, 1, 1100000000, e9, e9, e9, 100) != 900099889) { ^ -4; };
  ?(cgd_get_dy_nofee(0, 1, 100000000, e9, e9, e9, 100) != 99900110) { ^ -5; };
  ?(cgd_get_dy(0, 1, 100000000, e9, e9, e9, 100, fee) != 99860150) { ^ -6; };
  ?(cgd_get_dy(0, 1, 100000000, e9, e9, e9, 2000, fee) != 99954955) { ^ -7; };
  ?(cgd_get_dy(0, 1, 100000000, e9, e9, e9, 100, 0) != 99900110) { ^ -8; };
  ?(cgd_get_dy(0, 1, 0, e9, e9, e9, 100, fee) != 0) { ^ -9; };
  ?(cgd_get_y(0, 0, e9, e9, e9, e9, 100) != 0) { ^ -10; };
  ?(cgd_fee_of(99900110, fee) != 39960) { ^ -11; };
  ?(cgd_wrong_omit_minus1(0, 1, 100000000, e9, e9, e9, 100) != 99900111) { ^ -12; };
  ?(cgd_get_dy_nofee(0, 1, 100000000, 1200000000, 900000000, e9, 100) != 99599562) { ^ -13; };
  ?(cgd_get_dy(0, 1, 100000000, 1200000000, 900000000, e9, 100, fee) != 99559723) { ^ -14; };
  ?(cgd_naive_i64_mul(3099778671, 3099778671) != -8838116264523025375) { ^ -15; };
  ?(cgd_fee_den() != 10000000000) { ^ -16; };
  ?(cgd_rates_1e30_fits() != 0) { ^ -17; };
  ?(cgd_get_dy(0, 1, 100000000, e9, e9, e9, 100, 10000000001) != 0) { ^ -18; };
  ?(cgd_get_dy_nofee(0, 1, 100000000, e9, e9, e9, 2000) != 99994952) { ^ -19; };
  ^ 1;
}

=ex{
  cgd_u_lt,
  cgd_u_add_carry,
  cgd_mask32,
  cgd_n,
  cgd_fee_den,
  cgd_rates_1e30_fits,
  cgd_close1,
  cgd_muldiv_add_part,
  cgd_muldiv,
  cgd_pick,
  cgd_xp_ok,
  cgd_accum_s,
  cgd_accum_c,
  cgd_get_d,
  cgd_get_y,
  cgd_get_dy_nofee,
  cgd_wrong_omit_minus1,
  cgd_fee_of,
  cgd_get_dy,
  cgd_naive_i64_mul,
  cgd_test_suite
}
