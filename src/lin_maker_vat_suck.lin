@LIN:L1c:0.2
@MAKER_VAT_SUCK{
  version=1
  repo="makerdao/dss"
  source="src/vat.sol suck/_add(uint,uint)"
  license="AGPL-3.0-or-later"
  commit="fa4f6630afb0624d04a003e920b0d71a00331d98"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_maker_sky_vat_suck_unbacked_mint_128bit"
  note="Not mainnet uint256. RAY=1e27 and rad=wad*ray do not fit i64; RAY'=1e9. Storage sin/dai/vice/debt, rad and wards/auth are arguments. Unsigned _add of four accounts; overflow and i64-add wrap fail-close. Auth is explicit (unlike heal). No live gate (unlike frob). Upstream AGPL is not vendored."
}

!ms_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!ms_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(ms_u_lt(s, a));
}

!ms_mask32() -> int {
  ^ 4294967295;
}

!ms_ray() -> int {
  ^ 1000000000;
}

!ms_mainnet_ray_fits() -> int {
  ^ 0;
}

!ms_live_required() -> int {
  ^ 0;
}

!ms_auth_required() -> int {
  ^ 1;
}

!ms_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = ms_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = ms_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = ms_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(ms_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = ms_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!ms_muldiv(a: int, b: int, d: int) -> int {
  ^ ms_muldiv_part(a, b, d, 0);
}

!ms_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ ms_muldiv_part(a, b, d, 1);
}

!ms_u_sub_ok(x: int, y: int) -> int {
  ?(x < 0) { ^ 0; };
  ?(y < 0) { ^ 0; };
  ?(ms_u_lt(x, y) == 1) { ^ 0; };
  ^ 1;
}

!ms_u_sub(x: int, y: int) -> int {
  ?(ms_u_sub_ok(x, y) == 0) { ^ 0; };
  ^ x - y;
}

!ms_u_add_ok(x: int, y: int) -> int {
  ?(x < 0) { ^ 0; };
  ?(y < 0) { ^ 0; };
  s = x + y;
  ?(s < 0) { ^ 0; };
  ?(ms_u_lt(s, x) == 1) { ^ 0; };
  ^ 1;
}

!ms_u_add(x: int, y: int) -> int {
  ?(ms_u_add_ok(x, y) == 0) { ^ 0; };
  ^ x + y;
}

!ms_auth_ok(auth: int) -> int {
  ?(auth == 1) { ^ 1; };
  ^ 0;
}

!ms_suck_ok(sin_u: int, dai_v: int, vice: int, debt: int, rad: int, auth: int) -> int {
  ?(sin_u < 0) { ^ 0; };
  ?(dai_v < 0) { ^ 0; };
  ?(vice < 0) { ^ 0; };
  ?(debt < 0) { ^ 0; };
  ?(rad < 0) { ^ 0; };
  ?(ms_auth_ok(auth) == 0) { ^ 0; };
  ?(ms_u_add_ok(sin_u, rad) == 0) { ^ 0; };
  ?(ms_u_add_ok(dai_v, rad) == 0) { ^ 0; };
  ?(ms_u_add_ok(vice, rad) == 0) { ^ 0; };
  ?(ms_u_add_ok(debt, rad) == 0) { ^ 0; };
  ^ 1;
}

!ms_new_sin(sin_u: int, rad: int) -> int {
  ^ ms_u_add(sin_u, rad);
}

!ms_new_dai(dai_v: int, rad: int) -> int {
  ^ ms_u_add(dai_v, rad);
}

!ms_new_vice(vice: int, rad: int) -> int {
  ^ ms_u_add(vice, rad);
}

!ms_new_debt(debt: int, rad: int) -> int {
  ^ ms_u_add(debt, rad);
}

!ms_minted(sin_u: int, dai_v: int, vice: int, debt: int, rad: int, auth: int) -> int {
  ?(ms_suck_ok(sin_u, dai_v, vice, debt, rad, auth) == 0) { ^ 0; };
  ^ rad;
}

!ms_heal_restore(new_v: int, rad: int) -> int {
  ^ ms_u_sub(new_v, rad);
}

!ms_deltas_equal(sin_u: int, dai_v: int, vice: int, debt: int, rad: int, auth: int) -> int {
  ?(ms_suck_ok(sin_u, dai_v, vice, debt, rad, auth) == 0) { ^ 0; };
  ds = ms_u_sub(ms_new_sin(sin_u, rad), sin_u);
  dd = ms_u_sub(ms_new_dai(dai_v, rad), dai_v);
  dv = ms_u_sub(ms_new_vice(vice, rad), vice);
  db = ms_u_sub(ms_new_debt(debt, rad), debt);
  ?(ds != rad) { ^ 0; };
  ?(dd != rad) { ^ 0; };
  ?(dv != rad) { ^ 0; };
  ?(db != rad) { ^ 0; };
  ^ 1;
}

!ms_inverse_ok(sin_u: int, dai_v: int, vice: int, debt: int, rad: int, auth: int) -> int {
  ?(ms_suck_ok(sin_u, dai_v, vice, debt, rad, auth) == 0) { ^ 0; };
  ns = ms_new_sin(sin_u, rad);
  nd = ms_new_dai(dai_v, rad);
  nv = ms_new_vice(vice, rad);
  nb = ms_new_debt(debt, rad);
  ?(ms_heal_restore(ns, rad) != sin_u) { ^ 0; };
  ?(ms_heal_restore(nd, rad) != dai_v) { ^ 0; };
  ?(ms_heal_restore(nv, rad) != vice) { ^ 0; };
  ?(ms_heal_restore(nb, rad) != debt) { ^ 0; };
  ^ 1;
}

!ms_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!ms_naive_i64_add(a: int, b: int) -> int {
  ^ a + b;
}

!ms_test_suite() -> int {
  e18 = 1000000000000000000;
  e18_2 = 2000000000000000000;
  e18_3 = 3000000000000000000;
  e18_4 = 4000000000000000000;
  e18_5 = 5000000000000000000;
  e18_6 = 6000000000000000000;
  ?(ms_mainnet_ray_fits() != 0) { ^ -1; };
  ?(ms_live_required() != 0) { ^ -2; };
  ?(ms_auth_required() != 1) { ^ -3; };
  ?(ms_muldiv(100, 200, 50) != 400) { ^ -4; };
  ?(ms_muldiv_rem(3, 4, 5) != 2) { ^ -5; };
  ?(ms_suck_ok(e18_2, e18_3, e18_2, e18_5, e18, 1) != 1) { ^ -6; };
  ?(ms_new_sin(e18_2, e18) != e18_3) { ^ -7; };
  ?(ms_new_dai(e18_3, e18) != e18_4) { ^ -8; };
  ?(ms_new_vice(e18_2, e18) != e18_3) { ^ -9; };
  ?(ms_new_debt(e18_5, e18) != e18_6) { ^ -10; };
  ?(ms_suck_ok(e18_2, e18_3, e18_2, e18_5, e18_2, 1) != 1) { ^ -11; };
  ?(ms_new_vice(e18_2, e18_2) != e18_4) { ^ -12; };
  ?(ms_suck_ok(e18_2, e18_3, e18_2, e18_5, e18, 0) != 0) { ^ -13; };
  ?(ms_minted(e18_2, e18_3, e18_2, e18_5, e18, 0) != 0) { ^ -14; };
  ?(ms_suck_ok(e18_2, e18_3, e18_2, e18_5, 0, 1) != 1) { ^ -15; };
  ?(ms_auth_ok(1) != 1) { ^ -16; };
  ?(ms_auth_ok(0) != 0) { ^ -17; };
  ?(ms_deltas_equal(e18_2, e18_3, e18_2, e18_5, e18, 1) != 1) { ^ -18; };
  ?(ms_inverse_ok(e18_2, e18_3, e18_2, e18_5, e18, 1) != 1) { ^ -19; };
  ?(ms_heal_restore(e18_3, e18) != e18_2) { ^ -20; };
  ?(ms_minted(e18_2, e18_3, e18_2, e18_5, e18_2, 1) != e18_2) { ^ -21; };
  ?(ms_muldiv(7000000000000000000, 3000000000000000000, 1) != 0) { ^ -22; };
  ?(ms_naive_i64_mul(7000000000000000000, 3000000000000000000) != 0 - 5389669316318724096) { ^ -23; };
  ?(ms_u_add(7000000000000000000, 3000000000000000000) != 0) { ^ -24; };
  ?(ms_naive_i64_add(7000000000000000000, 3000000000000000000) != 0 - 8446744073709551616) { ^ -25; };
  ?(ms_suck_ok(7000000000000000000, e18, e18, e18, 3000000000000000000, 1) != 0) { ^ -26; };
  ^ 1;
}

=ex{
  ms_u_lt,
  ms_u_add_carry,
  ms_mask32,
  ms_ray,
  ms_mainnet_ray_fits,
  ms_live_required,
  ms_auth_required,
  ms_muldiv_part,
  ms_muldiv,
  ms_muldiv_rem,
  ms_u_sub_ok,
  ms_u_sub,
  ms_u_add_ok,
  ms_u_add,
  ms_auth_ok,
  ms_suck_ok,
  ms_new_sin,
  ms_new_dai,
  ms_new_vice,
  ms_new_debt,
  ms_minted,
  ms_heal_restore,
  ms_deltas_equal,
  ms_inverse_ok,
  ms_naive_i64_mul,
  ms_naive_i64_add,
  ms_test_suite
}
