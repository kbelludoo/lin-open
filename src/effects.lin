@LIN:L1c:0.2
!fnBodyText(fn){
  ?(typeof fn.body === 'string'){ ^fn.body; }
  ^renderBody(fn.body || []);
}
!inferEffect(fn,allFns){
  const body = fnBodyText(fn);
  const paramNames = Array.isArray(fn.params)
    ? fn.params.map((p) => (typeof p === 'string' ? p : p.name))
    : String(fn.params || '').split(',').map((p) => p.replace(/:[\w\[\]|,]+$/g, '').trim()).filter(Boolean);
  const params = new Set(paramNames);
  const locals = new Set(collectAssignedIds(body));
  for (const p of params) locals.add(p);
  const effects = new Set();

  ?(/\bthrow\b/.test(body)){ effects.add('Throw'); }
  ?(NATIVE_BUILTINS.test(body)){ effects.add('Native'); }

  const allOtherRefs = (allFns || [])
    .filter((g) => g.name !== fn.name)
    .map((g) => fnBodyText(g))
    .join('\n');
  const assignRe = /(?:^|[;{},])\s*([A-Za-z_$][\w$]*)\s*=(?!=)/g;
  let am;
  while ((am = assignRe.exec(body)) !== null) {
    const id = am[1];
    ?(['return', 'if', 'for', 'else', 'function', 'var', 'let', 'const'].includes(id)){ continue; }
    ?(!locals.has(id)){
      effects.add('Write');
    } else ?(new RegExp(`\\b${id}\\b`).test(allOtherRefs)){
      effects.add('Write');
    }
  }

  const idRe = /\b([A-Za-z_$][\w$]*)\b/g;
  let rm;
  while ((rm = idRe.exec(body)) !== null) {
    const id = rm[1];
    ?(!params.has(id) && !locals.has(id) && !BUILTIN_SET.has(id)){
      effects.add('Read');
    }
  }

  for (const other of allFns || []) {
    ?(other.name === fn.name){ continue; }
    const callRe = new RegExp(`\\b${other.name}\\s*\\(`);
    ?(callRe.test(body)){
      for (const e of String(other.effect || inferEffectOnce(other, allFns)).split(/\|/)) {
        ?(e){ effects.add(e); }
      }
    }
  }

  ?(effects.has('Write')){ ^'Write'; }
  ?(effects.has('Throw')){ ^'Throw'; }
  ?(effects.has('Native')){ ^'Native'; }
  ?(effects.has('Read')){ ^'Read'; }
  ^'Pure';
}
!inferEffectOnce(fn,allFns){
  const body = fnBodyText(fn);
  const params = new Set(
    Array.isArray(fn.params)
      ? fn.params.map((p) => (typeof p === 'string' ? p : p.name))
      : String(fn.params || '').split(',').map((p) => p.trim()).filter(Boolean),
  );
  const locals = new Set(collectAssignedIds(body));
  for (const p of params) locals.add(p);
  ?(/\bthrow\b/.test(body)){ ^'Throw'; }
  ?(NATIVE_BUILTINS.test(body)){ ^'Native'; }
  const assignRe = /(?:^|[;{},])\s*([A-Za-z_$][\w$]*)\s*=(?!=)/g;
  let am;
  while ((am = assignRe.exec(body)) !== null) {
    const id = am[1];
    ?(['return', 'if', 'for', 'else', 'function', 'var', 'let', 'const'].includes(id)){ continue; }
    ?(!locals.has(id)){ ^'Write'; }
  }
  const idRe = /\b([A-Za-z_$][\w$]*)\b/g;
  let rm;
  while ((rm = idRe.exec(body)) !== null) {
    const id = rm[1];
    ?(!params.has(id) && !locals.has(id) && !BUILTIN_SET.has(id)){ ^'Read'; }
  }
  ^'Pure';
}
=ex{fnBodyText, inferEffect, inferEffectOnce}