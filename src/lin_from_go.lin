@LIN:L1c:0.2
@LIN_FROM_GO{
  version=1
  purpose="extract_pure_scalar_go_functions_to_lin"
  profile="LINVM-1"
  status="EXPERIMENTAL_V1"
  note="Original geth IntrinsicGas is REJ_GO_SLICE. Eligible: uint64 functions with no selectors, slices, or error tuples."
}

!go_is_kw(nm: string): int {
  ?(starts_lit(nm, 0, "func") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "return") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "if") == 1 && nm.length == 2) { ^1 };
  ?(starts_lit(nm, 0, "else") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "for") == 1 && nm.length == 3) { ^1 };
  ?(starts_lit(nm, 0, "range") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "var") == 1 && nm.length == 3) { ^1 };
  ?(starts_lit(nm, 0, "const") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "package") == 1 && nm.length == 7) { ^1 };
  ^0;
}

!go_is_type(nm: string): int {
  ?(starts_lit(nm, 0, "uint64") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "uint32") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "uint16") == 1 && nm.length == 6) { ^1 };
  ?(starts_lit(nm, 0, "uint8") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "int64") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "int32") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "int16") == 1 && nm.length == 5) { ^1 };
  ?(starts_lit(nm, 0, "int8") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "byte") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "bool") == 1 && nm.length == 4) { ^1 };
  ?(starts_lit(nm, 0, "int") == 1 && nm.length == 3) { ^1 };
  ?(starts_lit(nm, 0, "uintptr") == 1 && nm.length == 7) { ^1 };
  ?(starts_lit(nm, 0, "error") == 1 && nm.length == 5) { ^1 };
  ^0;
}

!go_reason(sig: string, body: string): string {
  ?(rg_count_lit(sig, "[") > 0 || rg_count_lit(body, "[") > 0) { ^"REJ_GO_SLICE" };
  ?(rg_count_lit(sig, "*") > 0 || rg_count_lit(body, "*") > 0) { ^"REJ_GO_POINTER" };
  ?(rg_count_lit(sig, "map") > 0 || rg_count_lit(body, "map") > 0) { ^"REJ_GO_MAP" };
  ?(rg_count_lit(sig, "chan") > 0 || rg_count_lit(body, "chan") > 0) { ^"REJ_GO_CHAN" };
  ?(rg_count_lit(body, "defer") > 0) { ^"REJ_GO_DEFER" };
  ?(rg_count_lit(body, "make(") > 0) { ^"REJ_GO_ALLOC" };
  ?(rg_count_lit(body, "append(") > 0) { ^"REJ_GO_ALLOC" };
  ?(rg_count_lit(sig, "interface") > 0 || rg_count_lit(body, "interface") > 0) { ^"REJ_GO_INTERFACE" };
  ?(rg_count_lit(sig, "error") > 0) { ^"REJ_GO_ERROR" };
  ?(rg_count_lit(body, "select") > 0) { ^"REJ_GO_SELECT" };
  ?(rg_count_lit(body, "range") > 0) { ^"REJ_GO_RANGE" };
  ?(rg_count_lit(sig, "struct") > 0 || rg_count_lit(body, "struct") > 0) { ^"REJ_GO_STRUCT" };
  ?(rg_count_lit(sig, ".") > 0 || rg_count_lit(body, ".") > 0) { ^"REJ_GO_SELECTOR" };
  ?(rg_count_lit(sig, ",") > 0) {
    ?(rg_count_lit(sig, "(") > 1) { ^"REJ_GO_TUPLE_RET" };
  };
  ^"OK";
}

!go_parse_test_gate(): int {
  sig_ok = "func toWordSize(size uint64) uint64";
  body_ok = "if size > 9223372036854775776 { return 0; }; return (size + 31) / 32;";
  r1 = go_reason(sig_ok, body_ok);
  ?(r1.length != 2) { ^0 };
  sig_bad = "func IntrinsicGas(data []byte, accessList types.AccessList) (uint64, error)";
  body_bad = "z := uint64(bytes.Count(data, []byte{0})); return z, nil";
  r2 = go_reason(sig_bad, body_bad);
  ?(starts_lit(r2, 0, "REJ_GO_SLICE") == 0) { ^0 };
  sig_sel = "func toWordSize(size uint64) uint64";
  body_sel = "if size > math.MaxUint64-31 { return math.MaxUint64/32 + 1 }; return (size + 31) / 32";
  r3 = go_reason(sig_sel, body_sel);
  ?(starts_lit(r3, 0, "REJ_GO_SELECTOR") == 0) { ^0 };
  ^1;
}

!go_pdecl(params: string): string {
  out = "";
  n = params.length;
  i = 0;
  seen = 0;
  id = "";
  last = "";
  while (i < n) {
    id = read_ident(params, i);
    ?(id.length > 0) {
      ?(go_is_type(id) == 0 && go_is_kw(id) == 0) { last = id };
      i = i + id.length;
      continue;
    };
    ?(params.charCodeAt(i) == 44 || i + 1 >= n) {
      ?(last.length > 0) {
        ?(seen == 1) { out = out + ", " };
        out = out + last;
        out = out + ": int";
        seen = 1;
        last = "";
      };
    };
    i = i + 1;
  };
  ?(last.length > 0) {
    ?(seen == 1) { out = out + ", " };
    out = out + last;
    out = out + ": int";
  };
  ^out;
}

!go_assign(s: string): string {
  out = "";
  n = s.length;
  i = 0;
  while (i < n) {
    ?(starts_lit(s, i, ":=") == 1) {
      out = out + "=";
      i = i + 2;
      continue;
    };
    out = out + s.charAt(i);
    i = i + 1;
  };
  ^out;
}

!go_ifs(s: string): string {
  out = "";
  n = s.length;
  i = 0;
  p = 0;
  k = 0;
  cond = "";
  while (i < n) {
    ?(starts_lit(s, i, "if") == 1 && (i == 0 || is_ident(s.charCodeAt(i - 1)) == false) && (i + 2 >= n || is_ident(s.charCodeAt(i + 2)) == false)) {
      p = skip_ws(s, i + 2);
      k = p;
      while (k < n && s.charCodeAt(k) != 123) { k = k + 1 };
      ?(k < n) {
        cond = jss_trim(slice2(s, p, k));
        out = out + "?(";
        out = out + cond;
        out = out + ")";
        i = k;
        continue;
      };
    };
    out = out + s.charAt(i);
    i = i + 1;
  };
  ^out;
}

!go_returns(s: string): string {
  out = "";
  n = s.length;
  i = 0;
  while (i < n) {
    ?(starts_lit(s, i, "return") == 1 && (i == 0 || is_ident(s.charCodeAt(i - 1)) == false) && (i + 6 >= n || is_ident(s.charCodeAt(i + 6)) == false)) {
      out = out + "^";
      i = i + 6;
      continue;
    };
    out = out + s.charAt(i);
    i = i + 1;
  };
  ^out;
}

!go_fn(nm: string, params: string, body: string): string {
  bd = go_returns(go_ifs(go_assign(jss_trim(body))));
  out = "";
  out = out + "!";
  out = out + nm;
  out = out + "(";
  out = out + go_pdecl(params);
  out = out + ") -> int {";
  out = out + rgs_ch(10);
  out = out + "  ";
  out = out + jss_trim(bd);
  out = out + rgs_ch(10);
  out = out + "}";
  out = out + rgs_ch(10);
  ^out;
}

!go_from_go(src: string): string {
  pass = jss_trim(jss_strip_comments(src));
  out = "";
  out = jss_ln(out, "@LIN:L1c:0.2");
  out = jss_ln(out, "@FROM_GO{source=transpiled scope=scalar_uint64}");
  out = jss_ln(out, "");
  n = pass.length;
  i = 0;
  p = 0;
  cl = 0;
  b = 0;
  cb = 0;
  nm = "";
  pr = "";
  bd = "";
  sig = "";
  reason = "";
  names = "";
  while (i < n) {
    ?(starts_lit(pass, i, "func") == 1 && (i == 0 || is_ident(pass.charCodeAt(i - 1)) == false) && (i + 4 >= n || is_ident(pass.charCodeAt(i + 4)) == false)) {
      p = skip_ws(pass, i + 4);
      nm = read_ident(pass, p);
      ?(nm.length > 0) {
        p = skip_ws(pass, p + nm.length);
        ?(p < n && pass.charCodeAt(p) == 40) {
          cl = match_paren(pass, p);
          ?(cl > p) {
            b = skip_ws(pass, cl + 1);
            while (b < n && pass.charCodeAt(b) != 123) { b = b + 1 };
            ?(b < n && pass.charCodeAt(b) == 123) {
              cb = match_brace(pass, b);
              ?(cb > b) {
                pr = slice2(pass, p + 1, cl);
                bd = slice2(pass, b + 1, cb);
                sig = slice2(pass, i, b);
                reason = go_reason(sig, bd);
                ?(starts_lit(reason, 0, "OK") == 1 && reason.length == 2) {
                  out = out + go_fn(nm, pr, bd);
                  names = rgs_csv_add(names, nm);
                };
                i = cb + 1;
                continue;
              };
            };
          };
        };
      };
    };
    i = i + 1;
  };
  out = out + "=ex{";
  out = out + names;
  out = out + "}";
  out = out + rgs_ch(10);
  ^out;
}

!go_from_go_gate(): int {
  src = "func toWordSize(size uint64) uint64 { if size > 9223372036854775776 { return 0; }; return (size + 31) / 32; }";
  out = go_from_go(src);
  ?(rg_count_lit(out, "toWordSize") == 0) { ^0 };
  ?(rg_count_lit(out, "?(") == 0) { ^0 };
  ?(rg_count_lit(out, "IntrinsicGas") > 0) { ^0 };
  bad = "func IntrinsicGas(data []byte) (uint64, error) { return 0, nil }";
  r = go_reason("func IntrinsicGas(data []byte) (uint64, error)", "return 0, nil");
  ?(starts_lit(r, 0, "REJ_GO_SLICE") == 0) { ^0 };
  ^1;
}

=ex{go_is_kw, go_is_type, go_reason, go_parse_test_gate, go_pdecl, go_from_go, go_from_go_gate, go_fn, go_ifs, go_returns}
