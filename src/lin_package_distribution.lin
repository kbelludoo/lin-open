@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=pkg_dist_v330
~G{?=if #=for ^=ret :else}

!verify_bundle_manifest_roots(art_match: int, evid_match: int, trust_match: int, sbom_match: int) -> int {
    valid = 0;
    ?(art_match == 1) {
        ?(evid_match == 1) {
            ?(trust_match == 1) {
                ?(sbom_match == 1) {
                    valid = 1;
                }
            }
        }
    }
    ^valid;
}

!evaluate_monotonic_revocation_log(prev_epoch: int, curr_epoch: int, is_subset: int) -> int {
    monotonic_ok = 0;
    ?(curr_epoch >= prev_epoch) {
        ?(is_subset == 1) {
            monotonic_ok = 1;
        }
    }
    ^monotonic_ok;
}

!evaluate_enterprise_policy_gate(verdict_pass: int, min_epoch_met: int, not_revoked: int, sbom_ok: int) -> int {
    policy_verdict = 0;
    ?(verdict_pass == 1) {
        ?(min_epoch_met == 1) {
            ?(not_revoked == 1) {
                ?(sbom_ok == 1) {
                    policy_verdict = 9800;
                }
            }
        }
    }
    ^policy_verdict;
}

=ex{verify_bundle_manifest_roots, evaluate_monotonic_revocation_log, evaluate_enterprise_policy_gate}
