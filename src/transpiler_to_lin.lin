    const fnName = m[1];
    ?(['if', 'while', 'for', 'switch', 'catch', 'constructor', 'Error', 'Object', 'Array', 'typeof', 'instanceof'].includes(fnName)){ continue; }
    const rawParams = m[2];
    const openBrace = m.index + m[0].length - 1;
    let depth = 1;
    let k = openBrace + 1;
    while (k < s.length && depth > 0) {
      ?(s[k] === '{'){ depth++; }:(s[k] === '}'){ depth--; }
