@LIN:L1c:0.2
@GMX_V2_TOTAL_BORROWING{
  version=1
  repo="gmx-io/gmx-synthetics"
  source="contracts/market/MarketUtils.sol getNextTotalBorrowing"
  update_contrast="contracts/market/MarketUtils.sol updateTotalBorrowing"
  apply_contrast="contracts/utils/Precision.sol applyFactor"
  fee_contrast="contracts/market/MarketUtils.sol getBorrowingFees"
  pending_contrast="contracts/market/MarketUtils.sol getTotalPendingBorrowingFees"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_gmx_v2_next_total_borrowing_unsigned_sub_then_add_of_applyfactor"
  note="Not mainnet uint256. FLOAT is 1e6 not 1e30. Distinct from getBorrowingFees (applyFactor size*diff), from getTotalPendingBorrowingFees (applyFactor OI*cum minus total), from fused signed next-prev, and from applyFactor of the size delta."
}

!g2t_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!g2t_uadd_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  s = a + b;
  ?(s < 0) { ^ 0; };
  ?(g2t_u_lt(s, a) == 1) { ^ 0; };
  ^ 1;
}

!g2t_umul_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(a == 0) { ^ 1; };
  ?(b == 0) { ^ 1; };
  q = 9223372036854775807 / a;
  ?(g2t_u_lt(q, b) == 1) { ^ 0; };
  ^ 1;
}

!g2t_usub_ok(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(g2t_u_lt(a, b) == 1) { ^ 0; };
  ^ 1;
}

!g2t_float() -> int {
  ^ 1000000;
}

!g2t_apply(value: int, factor: int) -> int {
  ?(value < 0) { ^ 0; };
  ?(factor < 0) { ^ 0; };
  ?(g2t_umul_ok(value, factor) == 0) { ^ 0; };
  ^ (value * factor) / g2t_float();
}

!g2t_inputs_ok(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ?(total < 0) { ^ 0; };
  ?(ps < 0) { ^ 0; };
  ?(pf < 0) { ^ 0; };
  ?(ns < 0) { ^ 0; };
  ?(nf < 0) { ^ 0; };
  ?(g2t_umul_ok(ps, pf) == 0) { ^ 0; };
  ?(g2t_umul_ok(ns, nf) == 0) { ^ 0; };
  pc = g2t_apply(ps, pf);
  nc = g2t_apply(ns, nf);
  ?(g2t_usub_ok(total, pc) == 0) { ^ 0; };
  mid = total - pc;
  ?(g2t_uadd_ok(mid, nc) == 0) { ^ 0; };
  ^ 1;
}

!g2t_ok(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ^ g2t_inputs_ok(total, ps, pf, ns, nf);
}

!g2t_next(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ?(g2t_inputs_ok(total, ps, pf, ns, nf) == 0) { ^ 0; };
  pc = g2t_apply(ps, pf);
  nc = g2t_apply(ns, nf);
  ^ (total - pc) + nc;
}

!g2t_wrong_fused(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ?(ps < 0) { ^ 0; };
  ?(pf < 0) { ^ 0; };
  ?(ns < 0) { ^ 0; };
  ?(nf < 0) { ^ 0; };
  ?(g2t_umul_ok(ps, pf) == 0) { ^ 0; };
  ?(g2t_umul_ok(ns, nf) == 0) { ^ 0; };
  pc = g2t_apply(ps, pf);
  nc = g2t_apply(ns, nf);
  ^ (total - pc) + nc;
}

!g2t_wrong_muldiv(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ?(total < 0) { ^ 0; };
  ?(ps < 0) { ^ 0; };
  ?(pf < 0) { ^ 0; };
  ?(ns < 0) { ^ 0; };
  ?(nf < 0) { ^ 0; };
  ?(g2t_umul_ok(ps, pf) == 0) { ^ 0; };
  ?(g2t_umul_ok(ns, nf) == 0) { ^ 0; };
  pp = ps * pf;
  np = ns * nf;
  ?(g2t_u_lt(np, pp) == 1) {
    d = (pp - np) / g2t_float();
    ?(g2t_usub_ok(total, d) == 0) { ^ 0; };
    ^ total - d;
  };
  d2 = (np - pp) / g2t_float();
  ?(g2t_uadd_ok(total, d2) == 0) { ^ 0; };
  ^ total + d2;
}

!g2t_wrong_size(total: int, ps: int, pf: int, ns: int, nf: int) -> int {
  ?(pf < 0) { ^ 0; };
  ?(g2t_usub_ok(ns, ps) == 0) { ^ 0; };
  c = g2t_apply(ns - ps, nf);
  ?(g2t_uadd_ok(total, c) == 0) { ^ 0; };
  ^ total + c;
}

!g2t_wrong_fee(size: int, pf: int, nf: int) -> int {
  ?(g2t_usub_ok(nf, pf) == 0) { ^ 0; };
  ^ g2t_apply(size, nf - pf);
}

!g2t_wrong_pending(oi: int, cum: int, total: int) -> int {
  a = g2t_apply(oi, cum);
  ?(g2t_usub_ok(a, total) == 0) { ^ 0; };
  ^ a - total;
}

!g2t_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!g2t_naive_i64_add(a: int, b: int) -> int {
  ^ a + b;
}

!g2t_test_suite() -> int {
  ?(g2t_next(100000000, 50000000, 400000, 50000000, 500000) != 105000000) { ^ -1; };
  ?(g2t_wrong_fused(10000000, 50000000, 400000, 50000000, 500000) != 15000000) { ^ -2; };
  ?(g2t_ok(10000000, 50000000, 400000, 50000000, 500000) != 0) { ^ -3; };
  ?(g2t_wrong_fee(50000000, 400000, 500000) != 5000000) { ^ -4; };
  ?(g2t_wrong_pending(200000000, 600000, 100000000) != 20000000) { ^ -5; };
  ?(g2t_next(100000000, 50000000, 400000, 80000000, 500000) != 120000000) { ^ -6; };
  ?(g2t_wrong_size(100000000, 50000000, 400000, 80000000, 500000) != 115000000) { ^ -7; };
  ?(g2t_next(10, 3, 400000, 3, 700000) != 11) { ^ -8; };
  ?(g2t_wrong_muldiv(10, 3, 400000, 3, 700000) != 10) { ^ -9; };
  ?(g2t_next(100000000, 0, 0, 50000000, 500000) != 125000000) { ^ -10; };
  ?(g2t_next(100000000, 50000000, 400000, 0, 0) != 80000000) { ^ -11; };
  ?(g2t_next(20000000, 50000000, 400000, 50000000, 500000) != 25000000) { ^ -12; };
  ?(g2t_ok(0, 50000000, 400000, 0, 0) != 0) { ^ -13; };
  ?(g2t_ok(1, 7000000000, 2000000000, 0, 0) != 0) { ^ -14; };
  ?(g2t_naive_i64_mul(7000000000, 2000000000) != -4446744073709551616) { ^ -15; };
  ?(g2t_ok(9223372036850000000, 0, 0, 5000000, 1000000) != 0) { ^ -16; };
  ?(g2t_naive_i64_add(9223372036850000000, 5000000) != -9223372036854551616) { ^ -17; };
  ?(g2t_ok(100000000, 50000000, 400000, 50000000, 500000) != 1) { ^ -18; };
  ?(g2t_next(0, 0, 0, 50000000, 500000) != 25000000) { ^ -19; };
  ?(g2t_wrong_fused(100000000, 50000000, 400000, 50000000, 500000) != 105000000) { ^ -20; };
  ^ 1;
}

=ex{
  g2t_u_lt,
  g2t_uadd_ok,
  g2t_umul_ok,
  g2t_usub_ok,
  g2t_float,
  g2t_apply,
  g2t_inputs_ok,
  g2t_ok,
  g2t_next,
  g2t_wrong_fused,
  g2t_wrong_muldiv,
  g2t_wrong_size,
  g2t_wrong_fee,
  g2t_wrong_pending,
  g2t_naive_i64_mul,
  g2t_naive_i64_add,
  g2t_test_suite
}
