@LIN:L1c:0.2
@RULEL:LIN_MIR_SSA_SPEC:1.0.0

// Type Constants: 1: i1, 2: i32, 3: i64, 4: f64, 5: ptr, 6: v8u32
// Opcode Constants:
// 1: CONST, 2: PARAM, 3: ADD, 4: SUB, 5: MUL, 6: AND, 7: OR, 8: XOR,
// 9: SHL, 10: USHR, 11: SHR, 12: CMP_EQ, 13: CMP_LT, 14: SELECT, 15: PHI, 16: RET

!mir_type_name(t: int): string {
  ?(t == 1){ ^"i1" };
  ?(t == 2){ ^"i32" };
  ?(t == 3){ ^"i64" };
  ?(t == 4){ ^"f64" };
  ?(t == 5){ ^"ptr" };
  ?(t == 6){ ^"v8u32" };
  ^"unknown";
}

!mir_ssa_eval_binop(op: int, a: int, b: int): int {
  ?(op == 3){ ^(a + b) };
  ?(op == 4){ ^(a - b) };
  ?(op == 5){ ^(a * b) };
  ?(op == 6){ ^(a & b) };
  ?(op == 7){ ^(a | b) };
  ?(op == 8){ ^(a ^ b) };
  ?(op == 9){ ^(_lia_shl(a, b & 63)) };
  ?(op == 10){ ^(_lia_ushr(a, b & 63)) };
  ?(op == 11){ ^(_lia_shr(a, b & 63)) };
  ?(op == 12){ ?(a == b){ ^1 }; ^0 };
  ?(op == 13){ ?(a < b){ ^1 }; ^0 };
  ^0;
}

!mir_ssa_select(cond: int, val_true: int, val_false: int): int {
  ?(cond != 0){ ^val_true };
  ^val_false;
}

!test_mir_ssa(): int {
  // Test %0 = const.i64 42
  // %1 = const.i64 100
  // %2 = add.i64 %0, %1 -> 142
  // %3 = cmp.lt.i64 %0, %1 -> 1 (true)
  // %4 = select.i64 %3, %2, 0 -> 142
  v0 = 42;
  v1 = 100;
  v2 = mir_ssa_eval_binop(3, v0, v1);
  v3 = mir_ssa_eval_binop(13, v0, v1);
  v4 = mir_ssa_select(v3, v2, 0);

  ?(v2 != 142){ ^0 };
  ?(v3 != 1){ ^0 };
  ?(v4 != 142){ ^0 };
  ^1;
}

=ex{mir_type_name, mir_ssa_eval_binop, mir_ssa_select, test_mir_ssa}
