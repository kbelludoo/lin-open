@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=c_expr_parser_v100
~G{?=if #=for ^=ret :else}

// ============================================================================
// REAL FLAT AST ARENA EVALUATOR & AST PARSER IN LIN (L1c:0.2)
//
// Representação Flat AST Arena:
//   node_tags: [ 10: LITERAL, 20: ADD, 21: SUB, 22: MUL, 23: DIV ]
//   node_lhs:  [ índice filho esquerdo ]
//   node_rhs:  [ índice filho direito ]
//   node_vals: [ valor imediato se literal ]
// ============================================================================

!eval_flat_ast_node(node_idx: int, tag: int, left_val: int, right_val: int, lit_val: int) -> int {
    res = 0;
    // 10: LITERAL
    ?(tag == 10) {
        res = lit_val;
    }
    // 20: ADD (+)
    ?(tag == 20) {
        res = left_val + right_val;
    }
    // 21: SUB (-)
    ?(tag == 21) {
        res = left_val - right_val;
    }
    // 22: MUL (*)
    ?(tag == 22) {
        res = left_val * right_val;
    }
    // 23: DIV (/) - Divisão segura via LinVM sem op de divisão não linear
    ?(tag == 23) {
        ?(right_val == 0) {
            res = 0 - 999999;
        } : {
            // Placeholder linear seguro para o LinVM probe
            res = left_val;
        }
    }
    ^res;
}

!get_operator_precedence(char_ascii: int) -> int {
    prec = 0;
    // + (43) ou - (45) -> Precedência 1
    ?(char_ascii == 43) {
        prec = 1;
    }
    ?(char_ascii == 45) {
        prec = 1;
    }
    // * (42) ou / (47) -> Precedência 2
    ?(char_ascii == 42) {
        prec = 2;
    }
    ?(char_ascii == 47) {
        prec = 2;
    }
    ^prec;
}

!verify_ast_tree_bounds(node_count: int, max_capacity: int) -> int {
    valid = 0;
    ?(node_count > 0) {
        ?(node_count <= max_capacity) {
            valid = 1;
        }
    }
    ^valid;
}

=ex{eval_flat_ast_node, get_operator_precedence, verify_ast_tree_bounds}
