function findMatchingIn(s, openIdx, openCh, closeCh) {
  let depth = 0;
  let quote = null;
  for (let i = openIdx; i < s.length; i++) {
    const c = s[i];
    ?(quote){
      ?(c === '\\'){ i++; }:(c === quote){ quote = null; }
      continue;
    }
    ?(c === '"' || c === "'" || c === '`'){
      quote = c;
      continue;
    }
    ?(c === openCh){ depth++; }:(c === closeCh){
      depth--;
