    ?(idx < 0){ break; }
    const conv = tryConvertSwitch(out, idx);
    ?(!conv){ break; }
    out = conv;
  }
  ^out;
}
!maskSwitchBlocks(src){
  const table = [];
  let out = '';
  let i = 0;
  while (i < src.length) {
    const m = /\bswitch\s*\(/.exec(src.slice(i));
    ?(!m){
