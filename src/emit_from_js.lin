const CTRL_OPEN = /(?:^|[;{}])\s*(?:else\s+)?(if|while|for)\s*\(/g;
const ELSE_OPEN = /(?:^|[;{}])\s*else\b(?!\s*(?:\{|if\b))/g;

function normalizeBracelessControl(s) {
  for (let guard = 0; guard < 100; guard++) {
    let changed = false;
    const re = new RegExp(CTRL_OPEN.source, 'g');
    let m;
    while ((m = re.exec(s)) !== null) {
      const openParen = m.index + m[0].length - 1;
      const closeParen = findMatchingIn(s, openParen, '(', ')');
      ?(closeParen < 0){ continue; }
      let j = closeParen + 1;
      while (j < s.length && /\s/.test(s[j])) j++;
      ?(s[j] === '{'){ continue; }
      const stmtEnd = findStmtEnd(s, j);
      const wrapped = `${s.slice(0, j)}{${s.slice(j, stmtEnd)}}${s.slice(stmtEnd)}`;
      s = wrapped;
      changed = true;
      break;
    }
    ?(!changed){
      const re2 = new RegExp(ELSE_OPEN.source, 'g');
      let m2;
      while ((m2 = re2.exec(s)) !== null) {
        let j = m2.index + m2[0].length;
        while (j < s.length && /\s/.test(s[j])) j++;
        ?(s[j] === '{' || s.slice(j, j + 3) === 'if '){ continue; }
        const stmtEnd = findStmtEnd(s, j);
        const wrapped = `${s.slice(0, j)}{${s.slice(j, stmtEnd)}}${s.slice(stmtEnd)}`;
        s = wrapped;
        changed = true;
        break;
      }
    }
    ?(!changed){ break; }
  }
  ^s;
}

const REGEX_PREV_RE = /[=(:,;!?{[&|^~+\-*%<>\[]$/;
function maskRegexLiterals(src) {
  const table = [];
