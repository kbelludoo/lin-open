      out += c;
      i++;
      while (i < src.length) {
        ?(src[i] === '\\'){
          out += src[i] + (src[i + 1] || '');
          i += 2;
          continue;
        }
        out += src[i];
        ?(src[i] === q){
          i++;
          break;
        }
        i++;
      }
      continue;
    }
    ?(c === '/' && src[i + 1] !== '/' && src[i + 1] !== '*'){
      const before = out.replace(/\s+$/, '');
      const kwMatch = before.match(/([A-Za-z_$][\w$]*)$/);
      let isRegex;
      ?(kwMatch){
        isRegex = ['return', 'typeof', 'instanceof', 'in', 'of', 'new', 'delete', 'void', 'do', 'else', 'case', 'yield', 'await', 'match'].includes(kwMatch[1]);
