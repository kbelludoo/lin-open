    ?(sigil === '?' && /[A-Za-z0-9_){ $\]]/.test(prevChar)) {
      out += s.slice(i, idx + 1); }
      i = idx + 1;
      continue;
    }
    ?(sigil === '#' && /[A-Za-z0-9_){ $\]]/.test(prevChar)) {
      out += s.slice(i, idx + 1); }
