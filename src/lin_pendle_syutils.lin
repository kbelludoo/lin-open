@LIN:L1c:0.2
@PENDLE_SYUTILS{
  version=1
  repo="pendle-finance/pendle-core-v2-public"
  source="contracts/core/StandardizedYield/SYUtils.sol"
  license="GPL-3.0-or-later"
  commit="87685c89d05087535e9b9647eeda0e3d297d1f06"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_pendle_sy_asset_conversion_with_128bit_floor_and_ceil_muldiv"
  note="Not mainnet uint256. Upstream Solidity is hash-pinned, not vendored. Real deltas: 128-bit (a*b)/d; ceil via remainder not (a+b-1) add; fail-closed if quotient exceeds uint64 or rate=0."
}

!psy_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!psy_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(psy_u_lt(s, a));
}

!psy_mask32() -> int {
  ^ 4294967295;
}

!psy_one() -> int {
  ^ 1000000000000000000;
}

!psy_muldiv_part(a: int, b: int, d: int, want: int) -> int {
  ?(d == 0) { ^ 0; };
  m32 = psy_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = psy_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = psy_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(psy_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = psy_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!psy_muldiv(a: int, b: int, d: int) -> int {
  ^ psy_muldiv_part(a, b, d, 0);
}

!psy_muldiv_rem(a: int, b: int, d: int) -> int {
  ^ psy_muldiv_part(a, b, d, 1);
}

!psy_muldiv_ceil(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(psy_muldiv_part(a, b, d, 2) == 1) { ^ 0; };
  q = psy_muldiv_part(a, b, d, 0);
  r = psy_muldiv_part(a, b, d, 1);
  ?(r == 0) { ^ q; };
  ?(q == 0 - 1) { ^ 0; };
  ^ q + 1;
}

!psy_sy_to_asset(exchange_rate: int, sy_amount: int) -> int {
  ^ psy_muldiv(sy_amount, exchange_rate, psy_one());
}

!psy_sy_to_asset_up(exchange_rate: int, sy_amount: int) -> int {
  ^ psy_muldiv_ceil(sy_amount, exchange_rate, psy_one());
}

!psy_asset_to_sy(exchange_rate: int, asset_amount: int) -> int {
  ?(exchange_rate == 0) { ^ 0; };
  ^ psy_muldiv(asset_amount, psy_one(), exchange_rate);
}

!psy_asset_to_sy_up(exchange_rate: int, asset_amount: int) -> int {
  ?(exchange_rate == 0) { ^ 0; };
  ^ psy_muldiv_ceil(asset_amount, psy_one(), exchange_rate);
}

!psy_test_suite() -> int {
  one = psy_one();
  ?(psy_sy_to_asset(one, one) != one) { ^ -1; };
  ?(psy_asset_to_sy(one, one) != one) { ^ -2; };
  ?(psy_sy_to_asset(one + one, one) != one + one) { ^ -3; };
  ?(psy_asset_to_sy(one + one + one, 10) != 3) { ^ -4; };
  ?(psy_asset_to_sy_up(one + one + one, 10) != 4) { ^ -5; };
  ?(psy_sy_to_asset(3, 10) != 0) { ^ -6; };
  ?(psy_sy_to_asset_up(3, 10) != 1) { ^ -7; };
  ?(psy_asset_to_sy(0, 10) != 0) { ^ -8; };
  ?(psy_asset_to_sy_up(0, 10) != 0) { ^ -9; };
  ?(psy_muldiv(one, one, 1) != 0) { ^ -10; };
  ?(psy_asset_to_sy(one + one + one, 10) == psy_asset_to_sy_up(one + one + one, 10)) { ^ -11; };
  ?(psy_muldiv_rem(10, one, one + one + one) != one) { ^ -12; };
  ^ 1;
}

=ex{
  psy_u_lt,
  psy_u_add_carry,
  psy_mask32,
  psy_one,
  psy_muldiv_part,
  psy_muldiv,
  psy_muldiv_rem,
  psy_muldiv_ceil,
  psy_sy_to_asset,
  psy_sy_to_asset_up,
  psy_asset_to_sy,
  psy_asset_to_sy_up,
  psy_test_suite
}
