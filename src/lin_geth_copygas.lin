@LIN:L1c:0.2
@GETH_COPYGAS{
  version=1
  repo="ethereum/go-ethereum"
  source="core/vm/gas_table.go"
  license="LGPL-3.0"
  tag="v1.16.9"
  commit="95665d5703e1023995a0ff93e4ce9eb77e8a59bd"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="scalar_geth_memoryCopierGas_CopyGas_and_keccak_word_gas"
  note="Not a Geth node. Copy word gas only: CopyGas*((size+31)/32). Geth memoryCopierGas is a closure over stack.Back(stackpos); LIN takes size as an integer. KECCAK256 word gas (Keccak256WordGas*words) is the sibling opcode addend, distinct from CREATE2's InitCodeWordGas+Keccak256WordGas. Memory expansion is an explicit memgas argument, not *Memory."
}

!cg_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cg_copy_gas() -> int {
  ^ 3;
}

!cg_keccak_word() -> int {
  ^ 6;
}

!cg_ok(size: int) -> int {
  ?(size < 0) { ^ 0; };
  ^ 1;
}

!cg_words(size: int) -> int {
  ?(cg_ok(size) == 0) { ^ 0; };
  ^ (size + 31) / 32;
}

!cg_copy(size: int) -> int {
  ?(cg_ok(size) == 0) { ^ 0; };
  ^ cg_copy_gas() * cg_words(size);
}

!cg_keccak(size: int) -> int {
  ?(cg_ok(size) == 0) { ^ 0; };
  ^ cg_keccak_word() * cg_words(size);
}

!cg_with_mem(kind: int, memgas: int, size: int) -> int {
  ?(kind < 0) { ^ 0; };
  ?(memgas < 0) { ^ 0; };
  ?(cg_ok(size) == 0) { ^ 0; };
  more = cg_copy(size);
  ?(kind != 0) { more = cg_keccak(size); };
  s = memgas + more;
  ?(cg_u_lt(s, memgas) == 1) { ^ 0; };
  ^ s;
}

!cg_test_suite() -> int {
  ?(cg_copy_gas() != 3) { ^ -1; };
  ?(cg_keccak_word() != 6) { ^ -2; };
  ?(cg_words(0) != 0) { ^ -3; };
  ?(cg_words(1) != 1) { ^ -4; };
  ?(cg_words(31) != 1) { ^ -5; };
  ?(cg_words(32) != 1) { ^ -6; };
  ?(cg_words(33) != 2) { ^ -7; };
  ?(cg_words(64) != 2) { ^ -8; };
  ?(cg_copy(0) != 0) { ^ -9; };
  ?(cg_copy(1) != 3) { ^ -10; };
  ?(cg_copy(32) != 3) { ^ -11; };
  ?(cg_copy(33) != 6) { ^ -12; };
  ?(cg_copy(1024) != 96) { ^ -13; };
  ?(cg_copy(24576) != 2304) { ^ -14; };
  ?(cg_copy(-1) != 0) { ^ -15; };
  ?(cg_keccak(0) != 0) { ^ -16; };
  ?(cg_keccak(1) != 6) { ^ -17; };
  ?(cg_keccak(32) != 6) { ^ -18; };
  ?(cg_keccak(33) != 12) { ^ -19; };
  ?(cg_keccak(49152) != 9216) { ^ -20; };
  ?(cg_keccak(-1) != 0) { ^ -21; };
  ?(cg_with_mem(0, 100, 32) != 103) { ^ -22; };
  ?(cg_with_mem(1, 100, 32) != 106) { ^ -23; };
  ?(cg_with_mem(0, -1, 32) != 0) { ^ -24; };
  ?(cg_copy(65) != 9) { ^ -25; };
  ?(cg_copy(49152) != 4608) { ^ -26; };
  ^ 1;
}

=ex{
  cg_u_lt,
  cg_copy_gas,
  cg_keccak_word,
  cg_ok,
  cg_words,
  cg_copy,
  cg_keccak,
  cg_with_mem,
  cg_test_suite
}
