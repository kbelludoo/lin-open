@LIN:L1c:0.2
@LIN_ZIG_MATCH{version=1}

!rewrite_inc(inc: string): string {
  out = "";
  k = skip_ws(inc, 0);
  id = read_ident(inc, k);
  ?(id.length == 0){ ^inc };
  p = skip_ws(inc, k + id.length);
  ?(p + 1 < inc.length && inc.charCodeAt(p) == 43 && inc.charCodeAt(p + 1) == 43){
    out = id;
    out = out + " = ";
    out = out + id;
    out = out + " + 1";
    ^out;
  };
  ^inc;
}

!rewrite_cfor(s: string): string {
  out = "";
  chs = "";
  i = 0;
  n = s.length;
  cl = 0;
  b = 0;
  cb = 0;
  inner = "";
  s1 = 0;
  s2 = 0;
  k = 0;
  while (i < n) {
    ?(s.charCodeAt(i) == 34){
      out = out + q();
      i = i + 1;
      while (i < n && s.charCodeAt(i) != 34){
        chs = s.charAt(i);
        out = out + chs;
        i = i + 1;
      };
      ?(i < n){ out = out + q(); i = i + 1 };
      continue;
    };
    ?(s.charCodeAt(i) == 35 && i + 1 < n && s.charCodeAt(i + 1) == 40){
      cl = match_paren(s, i + 1);
      ?(cl > i + 1){
        b = find_brace(s, cl + 1);
        ?(b >= 0){
          cb = match_brace(s, b);
          ?(cb > b){
            inner = slice2(s, i + 2, cl);
            s1 = -1;
            s2 = -1;
            k = 0;
            while (k < inner.length) {
              ?(inner.charCodeAt(k) == 59){
                ?(s1 < 0){ s1 = k }
                : { s2 = k };
              };
              k = k + 1;
            };
            ?(s1 >= 0 && s2 > s1){
              out = out + slice2(inner, 0, s1);
              out = out + ";";
              out = out + "while";
              out = out + "(";
              out = out + slice2(inner, s1 + 1, s2);
              out = out + ")";
              out = out + "{";
              out = out + slice2(s, b + 1, cb);
              out = out + ";";
              out = out + rewrite_inc(slice2(inner, s2 + 1, inner.length));
              out = out + ";";
              out = out + "}";
              i = cb + 1;
              continue;
            };
          };
        };
      };
    };
    chs = s.charAt(i);
    out = out + chs;
    i = i + 1;
  };
  ^out;
}

!rewrite_match(s: string): string {
  out = "";
  chs = "";
  i = 0;
  n = s.length;
  cl = 0;
  b = 0;
  cb = 0;
  expr = "";
  inner = "";
  p = 0;
  first = 0;
  pat = "";
  j = 0;
  ab = 0;
  arm = "";
  while (i < n) {
    ?(s.charCodeAt(i) == 34){
      out = out + q();
      i = i + 1;
      while (i < n && s.charCodeAt(i) != 34){
        chs = s.charAt(i);
        out = out + chs;
        i = i + 1;
      };
      ?(i < n){ out = out + q(); i = i + 1 };
      continue;
    };
    ?(starts_lit(s, i, "match(") == 1){
      cl = match_paren(s, i + 5);
      ?(cl > i){
        b = find_brace(s, cl + 1);
        ?(b >= 0){
          cb = match_brace(s, b);
          ?(cb > b){
            expr = slice2(s, i + 6, cl);
            inner = slice2(s, b + 1, cb);
            p = 0;
            first = 1;
            while (p < inner.length) {
              p = skip_ws(inner, p);
              ?(p >= inner.length){ break };
              ?(inner.charCodeAt(p) == 95){
                p = skip_ws(inner, p + 1);
                ?(p + 1 < inner.length && inner.charCodeAt(p) == 61 && inner.charCodeAt(p + 1) == 62){
                  p = skip_ws(inner, p + 2);
                  ?(p < inner.length && inner.charCodeAt(p) == 123){
                    ab = match_brace(inner, p);
                    ?(ab > p){
                      arm = slice2(inner, p + 1, ab);
                      ?(first == 1){ out = out + "{" }
                      : { out = out + ":{" };
                      out = out + arm;
                      out = out + "}";
                      first = 0;
                      p = ab + 1;
                      continue;
                    };
                  };
                };
              };
              pat = "";
              ?(inner.charCodeAt(p) >= 48 && inner.charCodeAt(p) <= 57){
                j = p;
                while (j < inner.length && inner.charCodeAt(j) >= 48 && inner.charCodeAt(j) <= 57){ j = j + 1 };
                pat = slice2(inner, p, j);
                p = j;
              }
              : {
                pat = read_ident(inner, p);
                ?(pat.length == 0){ break };
                p = p + pat.length;
              };
              p = skip_ws(inner, p);
              ?(p + 1 < inner.length && inner.charCodeAt(p) == 61 && inner.charCodeAt(p + 1) == 62){
                p = skip_ws(inner, p + 2);
                ?(p < inner.length && inner.charCodeAt(p) == 123){
                  ab = match_brace(inner, p);
                  ?(ab > p){
                    arm = slice2(inner, p + 1, ab);
                    ?(first == 1){ out = out + "?(" }
                    : { out = out + ":?(" };
                    out = out + expr;
                    out = out + "==";
                    out = out + pat;
                    out = out + "){";
                    out = out + arm;
                    out = out + "}";
                    first = 0;
                    p = ab + 1;
                    continue;
                  };
                };
              };
              break;
            };
            i = cb + 1;
            continue;
          };
        };
      };
    };
    chs = s.charAt(i);
    out = out + chs;
    i = i + 1;
  };
  ^out;
}

=ex{rewrite_inc, rewrite_cfor, rewrite_match}
