@LIN:L1c:0.2
@BITCOIN_CORE_GETFEE{
  version=1
  repo="bitcoin/bitcoin"
  source="src/policy/feerate.cpp GetFee + src/policy/policy.cpp GetVirtualTransactionSize + src/consensus/amount.h"
  license="MIT"
  tag="v27.1"
  commit="1088a98f5aad080cc6cca2da174f206509fcda6c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="integer_ceil_CFeeRate_GetFee_and_vsize_weight_gap"
  note="Not a wallet. Core GetFee uses std::ceil(double) and integer vbytes; LIN uses integer ceil and makes the vsize-vs-weight gap explicit. Negative fee rates fail-closed (-1)."
}

!btc_coin() -> int {
  ^ 100000000;
}

!btc_btc_max() -> int {
  ^ 21000000;
}

!btc_max_money() -> int {
  ^ (21000000 * 100000000);
}

!btc_witness_scale() -> int {
  ^ 4;
}

!btc_money_range(n: int) -> int {
  ?(n < 0) { ^ 0; };
  ?(n > (21000000 * 100000000)) { ^ 0; };
  ^ 1;
}

!btc_overflow_mul(a: int, b: int) -> int {
  p = 0;
  ?(a < 0) { ^ -1; };
  ?(b < 0) { ^ -1; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  p = a * b;
  ?(p < 0) { ^ -1; };
  ?(p / a != b) { ^ -1; };
  ^ p;
}

!btc_ceil_div(n: int, d: int) -> int {
  q = 0;
  r = 0;
  ?(d <= 0) { ^ -1; };
  ?(n < 0) { ^ -1; };
  ?(n == 0) { ^ 0; };
  q = n / d;
  r = n - (q * d);
  ?(r == 0) { ^ q; };
  ^ (q + 1);
}

!btc_vsize_from_weight(wu: int) -> int {
  ?(wu < 0) { ^ -1; };
  ^ ((wu + 3) / 4);
}

!btc_get_fee(sat_per_kvb: int, vbytes: int) -> int {
  num = 0;
  fee = 0;
  ?(sat_per_kvb < 0) { ^ -1; };
  ?(vbytes < 0) { ^ -1; };
  ?(vbytes == 0) { ^ 0; };
  num = btc_overflow_mul(sat_per_kvb, vbytes);
  ?(num < 0) { ^ -1; };
  fee = btc_ceil_div(num, 1000);
  ?(fee < 0) { ^ -1; };
  ?(fee == 0) {
    ?(sat_per_kvb > 0) { ^ 1; };
  };
  ^ fee;
}

!btc_get_fee_from_weight(sat_per_kvb: int, wu: int) -> int {
  vs = 0;
  vs = btc_vsize_from_weight(wu);
  ?(vs < 0) { ^ -1; };
  ^ btc_get_fee(sat_per_kvb, vs);
}

!btc_fee_weight_native(sat_per_kwu: int, wu: int) -> int {
  num = 0;
  fee = 0;
  ?(sat_per_kwu < 0) { ^ -1; };
  ?(wu < 0) { ^ -1; };
  ?(wu == 0) { ^ 0; };
  num = btc_overflow_mul(sat_per_kwu, wu);
  ?(num < 0) { ^ -1; };
  fee = btc_ceil_div(num, 1000);
  ?(fee < 0) { ^ -1; };
  ?(fee == 0) {
    ?(sat_per_kwu > 0) { ^ 1; };
  };
  ^ fee;
}

!btc_feerate_from_fee(fee_paid: int, vbytes: int) -> int {
  num = 0;
  ?(vbytes <= 0) { ^ 0; };
  ?(fee_paid < 0) { ^ -1; };
  num = btc_overflow_mul(fee_paid, 1000);
  ?(num < 0) { ^ -1; };
  ^ (num / vbytes);
}

!btc_kwu_to_kvb(sat_per_kwu: int) -> int {
  ^ btc_overflow_mul(sat_per_kwu, 4);
}

!btc_gap_vsize_vs_weight(sat_per_kwu: int, wu: int) -> int {
  kvb = 0;
  core = 0;
  native = 0;
  kvb = btc_kwu_to_kvb(sat_per_kwu);
  ?(kvb < 0) { ^ -1; };
  core = btc_get_fee_from_weight(kvb, wu);
  native = btc_fee_weight_native(sat_per_kwu, wu);
  ?(core < 0) { ^ -1; };
  ?(native < 0) { ^ -1; };
  ^ (core - native);
}

!btc_getfee_gate() -> int {
  ?(btc_coin() != 100000000) { ^ -1; };
  ?(btc_max_money() != 2100000000000000) { ^ -2; };
  ?(btc_money_range(0) != 1) { ^ -3; };
  ?(btc_money_range(-1) != 0) { ^ -4; };
  ?(btc_money_range(2100000000000000) != 1) { ^ -5; };
  ?(btc_money_range(2100000000000001) != 0) { ^ -6; };
  ?(btc_vsize_from_weight(0) != 0) { ^ -7; };
  ?(btc_vsize_from_weight(1) != 1) { ^ -8; };
  ?(btc_vsize_from_weight(4) != 1) { ^ -9; };
  ?(btc_vsize_from_weight(381) != 96) { ^ -10; };
  ?(btc_get_fee(10, 500) != 5) { ^ -11; };
  ?(btc_get_fee(1, 1) != 1) { ^ -12; };
  ?(btc_get_fee(0, 100) != 0) { ^ -13; };
  ?(btc_get_fee(3456, 95) != 329) { ^ -14; };
  ?(btc_get_fee(3456, 96) != 332) { ^ -15; };
  ?(btc_fee_weight_native(864, 381) != 330) { ^ -16; };
  ?(btc_get_fee_from_weight(3456, 381) != 332) { ^ -17; };
  ?(btc_gap_vsize_vs_weight(864, 381) != 2) { ^ -18; };
  ?(btc_get_fee(100000, 96) != 9600) { ^ -19; };
  ?(btc_fee_weight_native(25000, 381) != 9525) { ^ -20; };
  ?(btc_gap_vsize_vs_weight(25000, 381) != 75) { ^ -21; };
  ?(btc_feerate_from_fee(1, 2000) != 0) { ^ -22; };
  ?(btc_feerate_from_fee(3, 2) != 1500) { ^ -23; };
  ?(btc_get_fee(-1, 10) != -1) { ^ -24; };
  ^ 1;
}

=ex{
  btc_coin,
  btc_btc_max,
  btc_max_money,
  btc_witness_scale,
  btc_money_range,
  btc_overflow_mul,
  btc_ceil_div,
  btc_vsize_from_weight,
  btc_get_fee,
  btc_get_fee_from_weight,
  btc_fee_weight_native,
  btc_feerate_from_fee,
  btc_kwu_to_kvb,
  btc_gap_vsize_vs_weight,
  btc_getfee_gate
}
