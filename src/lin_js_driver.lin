@LIN:L1c:0.2
@LIN_JS_DRIVER{version=1 purpose=emit_js_semantics_prelude_and_drive_function_extraction}

!jss_prelude(): string {
  out = "";
  out = jss_ln(out, "!js_i32(x: int): int {");
  out = jss_ln(out, "  m = x & 4294967295;");
  out = jss_ln(out, "  ?(m >= 2147483648){ ^m - 4294967296 };");
  out = jss_ln(out, "  ^m;");
  out = jss_ln(out, "}");
  out = jss_ln(out, "");
  out = jss_ln(out, "!js_u32(x: int): int { ^x & 4294967295 }");
  out = jss_ln(out, "!js_and(a: int, b: int): int { ^js_i32(a) & js_i32(b) }");
  out = jss_ln(out, "!js_or(a: int, b: int): int { ^js_i32(a) | js_i32(b) }");
  out = jss_ln(out, "!js_bnot(a: int): int { ^js_i32(~js_i32(a)) }");
  out = jss_ln(out, "!js_neg(a: int): int { ^0 - a }");
  out = jss_ln(out, "");
  out = jss_ln(out, "!js_xor(a: int, b: int): int {");
  out = jss_ln(out, "  x = js_i32(a);");
  out = jss_ln(out, "  y = js_i32(b);");
  out = jss_ln(out, "  ^(x | y) & ~(x & y);");
  out = jss_ln(out, "}");
  out = jss_ln(out, "");
  out = jss_ln(out, "!js_shl(a: int, b: int): int { ^js_i32(_lia_shl(js_i32(a), b & 31)) }");
  out = jss_ln(out, "!js_shr(a: int, b: int): int { ^_lia_shr(js_i32(a), b & 31) }");
  out = jss_ln(out, "!js_ushr(a: int, b: int): int { ^_lia_shr(js_u32(a), b & 31) }");
  out = jss_ln(out, "");
  out = jss_ln(out, "!js_lt(a: int, b: int): int { ?(a < b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_gt(a: int, b: int): int { ?(a > b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_le(a: int, b: int): int { ?(a <= b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_ge(a: int, b: int): int { ?(a >= b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_eq(a: int, b: int): int { ?(a == b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_ne(a: int, b: int): int { ?(a != b){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_lnot(a: int): int { ?(a == 0){ ^1 }; ^0 }");
  out = jss_ln(out, "!js_land(a: int, b: int): int { ?(a == 0){ ^0 }; ^b }");
  out = jss_ln(out, "!js_lor(a: int, b: int): int { ?(a != 0){ ^a }; ^b }");
  out = jss_ln(out, "!js_sel(c: int, a: int, b: int): int { ?(c != 0){ ^a }; ^b }");
  out = jss_ln(out, "");
  ^out;
}

!jss_helpers_csv(): string {
  ^"js_i32,js_u32,js_and,js_or,js_bnot,js_neg,js_xor,js_shl,js_shr,js_ushr,js_lt,js_gt,js_le,js_ge,js_eq,js_ne,js_lnot,js_land,js_lor,js_sel";
}

!jsd_paren_at(s: string, i: int): int {
  n = s.length;
  p = 0;
  nm = "";
  ?(starts_lit(s, i, "exports.") == 1){
    nm = read_ident(s, i + 8);
    ?(nm.length == 0){ ^-1 };
    p = skip_ws(s, i + 8 + nm.length);
    ?(p >= n || s.charCodeAt(p) != 61){ ^-1 };
    p = skip_ws(s, p + 1);
    ?(starts_lit(s, p, "function") == 1){
      p = skip_ws(s, p + 8);
      ?(p < n && s.charCodeAt(p) == 40){ ^p };
    };
    ^-1;
  };
  ?(starts_lit(s, i, "function") == 1 && (i == 0 || is_ident(s.charCodeAt(i - 1)) == false)){
    p = skip_ws(s, i + 8);
    nm = read_ident(s, p);
    ?(nm.length > 0){
      p = skip_ws(s, p + nm.length);
      ?(p < n && s.charCodeAt(p) == 40){ ^p };
    };
  };
  ^-1;
}

!jsd_fn_at(s: string, i: int): int {
  ^jsd_paren_at(s, i);
}

!jsd_name_at(s: string, i: int): string {
  ?(starts_lit(s, i, "exports.") == 1){ ^read_ident(s, i + 8) };
  ?(starts_lit(s, i, "function") == 1 && (i == 0 || is_ident(s.charCodeAt(i - 1)) == false)){
    p = skip_ws(s, i + 8);
    ^read_ident(s, p);
  };
  ^"";
}

!jsd_names(src: string): string {
  out = "";
  n = src.length;
  i = 0;
  fp = 0;
  cl = 0;
  b = 0;
  cb = 0;
  nm = "";
  while (i < n) {
    fp = jsd_fn_at(src, i);
    ?(fp >= 0){
      nm = jsd_name_at(src, i);
      cl = match_paren(src, fp);
      ?(cl > fp){
        b = find_brace(src, cl + 1);
        ?(b >= 0){
          cb = match_brace(src, b);
          ?(cb > b){
            out = rgs_csv_add(out, nm);
            i = b + 1;
            continue;
          };
        };
      };
    };
    i = i + 1;
  };
  ^out;
}

!jsd_fns(src: string, known: string, want: int): string {
  out = "";
  n = src.length;
  i = 0;
  fp = 0;
  cl = 0;
  b = 0;
  cb = 0;
  nm = "";
  pr = "";
  bd = "";
  pcsv = "";
  gen = "";
  while (i < n) {
    fp = jsd_fn_at(src, i);
    ?(fp >= 0){
      nm = jsd_name_at(src, i);
      cl = match_paren(src, fp);
      ?(cl > fp){
        b = find_brace(src, cl + 1);
        ?(b >= 0){
          cb = match_brace(src, b);
          ?(cb > b){
            pr = slice2(src, fp + 1, cl);
            bd = slice2(src, b + 1, cb);
            pcsv = jss_pcsv(pr);
            ?(jsf_eligible(pcsv, bd, known) == 1){
              gen = jss_fn(nm, pr, bd);
              ?(rg_count_lit(gen, "JS_UNSUPPORTED") == 0){
                ?(want == 1){ out = out + gen }
                : { out = rgs_csv_add(out, nm) };
              };
            };
            i = b + 1;
            continue;
          };
        };
      };
    };
    i = i + 1;
  };
  ^out;
}

!jsd_ncsv(s: string): int {
  ?(s.length == 0){ ^0 };
  ^rg_count_lit(s, ",") + 1;
}

!jsd_prep(src: string): string {
  clean = jss_strip_comments(src);
  pass = jss_rewrite_hex(clean);
  k = 0;
  while (k < 8) {
    pass = jss_one_const(pass);
    k = k + 1;
  };
  ^pass;
}

!jss_from_js(src: string): string {
  out = "";
  pass = jsd_prep(src);
  known = rgs_csv_merge(jss_helpers_csv(), jsd_names(pass));
  jss_emitted = jsd_fns(pass, known, 1);
  jss_oknames = jsd_fns(pass, known, 0);
  out = jss_ln(out, "@LIN:L1c:0.2");
  out = jss_ln(out, "@FROM_JS{source=transpiled scope=pure_scalar_int_functions semantics=js_int32}");
  out = jss_ln(out, "");
  out = out + jss_prelude();
  out = out + jss_emitted;
  out = out + "=ex{";
  out = out + rgs_csv_merge(jss_helpers_csv(), jss_oknames);
  out = out + "}";
  out = out + rgs_ch(10);
  ^out;
}

!jsd_gap(src: string): string {
  out = "";
  n = src.length;
  i = 0;
  fp = 0;
  cl = 0;
  b = 0;
  cb = 0;
  nm = "";
  pr = "";
  bd = "";
  pcsv = "";
  reason = "";
  gen = "";
  known = rgs_csv_merge(jss_helpers_csv(), jsd_names(src));
  while (i < n) {
    fp = jsd_fn_at(src, i);
    ?(fp >= 0){
      nm = jsd_name_at(src, i);
      cl = match_paren(src, fp);
      ?(cl > fp){
        b = find_brace(src, cl + 1);
        ?(b >= 0){
          cb = match_brace(src, b);
          ?(cb > b){
            pr = slice2(src, fp + 1, cl);
            bd = slice2(src, b + 1, cb);
            pcsv = jss_pcsv(pr);
            reason = jsf_eligible_reason(pcsv, bd, known);
            ?(starts_lit(reason, 0, "OK") == 1 && reason.length == 2){
              gen = jss_fn(nm, pr, bd);
              ?(rg_count_lit(gen, "JS_UNSUPPORTED") > 0){ reason = "REJ_STMT_UNSUPPORTED" };
            };
            out = out + "  .fn{ name=";
            out = out + q();
            out = out + nm;
            out = out + q();
            out = out + " reason=";
            out = out + reason;
            out = out + " }";
            out = out + rgs_ch(10);
            i = b + 1;
            continue;
          };
        };
      };
    };
    i = i + 1;
  };
  ^out;
}

!jss_report(src: string): string {
  out = "";
  pass = jsd_prep(src);
  known = rgs_csv_merge(jss_helpers_csv(), jsd_names(pass));
  jss_oknames = jsd_fns(pass, known, 0);
  out = jss_ln(out, "@RULEL:LIN_FROM_JS:1.0.0");
  out = out + ".found=";
  out = out + rgs_num(jsd_ncsv(jsd_names(pass)));
  out = out + " .eligible=";
  out = out + rgs_num(jsd_ncsv(jss_oknames));
  out = out + rgs_ch(10);
  out = out + ".names=";
  out = out + q();
  out = out + jss_oknames;
  out = out + q();
  out = out + rgs_ch(10);
  out = jss_ln(out, ".fns{");
  out = out + jsd_gap(pass);
  out = jss_ln(out, "}");
  ^out;
}

=ex{jss_prelude, jss_from_js, jss_report, jsd_names}
