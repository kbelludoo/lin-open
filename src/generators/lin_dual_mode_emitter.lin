@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=dual_mode_v100
~G{?=if #=for ^=ret :else}

// ============================================================================
// LIN DUAL-MODE COMPILATION & ERROR EFFECT BOUNDS (Inspirado em Mojo)
// Modos:
//   1: FN_TIGHT -> Strict types, zero allocation, deterministic, target=Zig/OpenCL
//   2: DEF_FLEX  -> Dynamic scripting, GC-safe, asynchronous, target=JS/Wasm
// Efeitos de Exceção:
//   1: NO_RAISES -> Prova formal de ausência de erros em runtime (essencial para GPU)
//   2: RAISES    -> Declaração explícita de erro propagável
// ============================================================================

!verify_function_mode_and_target(fn_mode: int, target_id: int, has_types: int) -> int {
    valid = 0;
    ?(fn_mode == 1) { // FN_TIGHT
        ?(has_types == 1) {
            ?(target_id == 1 || target_id == 3) { // 1: Zig Native, 3: OpenCL Silicon
                valid = 100;
            }
        }
    }
    ?(fn_mode == 2) { // DEF_FLEX
        ?(target_id == 2) { // 2: JS/Wasm
            valid = 200;
        }
    }
    ^valid;
}

!verify_error_effect_hierarchy(caller_raises: int, callee_raises: int) -> int {
    soundness = 0;
    // Invariante de Segurança: Função NO_RAISES (0) NUNCA pode chamar função RAISES (1)
    ?(caller_raises == 0) {
        ?(callee_raises == 0) {
            soundness = 1; // SOUND: Zero exceções garantidas em silício
        }
    }
    ?(caller_raises == 1) {
        soundness = 1; // SOUND: Função que declara raises pode chamar qualquer callee
    }
    ^soundness;
}

!eval_multi_level_ir_lowering(mir_op: int, target_lir_id: int) -> int {
    lowered_hash = (mir_op * 65537) + target_lir_id;
    ^lowered_hash;
}

=ex{verify_function_mode_and_target, verify_error_effect_hierarchy, eval_multi_level_ir_lowering}
