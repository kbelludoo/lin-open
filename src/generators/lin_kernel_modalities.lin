@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=kernel_modalities_v100
~G{?=if #=for ^=ret :else}

// ============================================================================
// LIN EXECUTION MODALITIES & SILICON OWNERSHIP CONTRACTS
// Modalidades:
//   1: FN_HOST      -> Execução na CPU/Host (Zig runtime, permite I/O, alocação e error unions)
//   2: KERNEL_DEVICE-> Execução no Silício/Device (OpenCL gfx1030, estritamente determinístico, ^no_alloc, ^no_io)
// Contratos de Memória / Ownership:
//   1: OWNED        -> Transferência de posse (gera defer free no Zig; no-op na GPU)
//   2: REF          -> Empréstimo imutável (*const no Zig; __global const no OpenCL)
//   3: MUT_REF      -> Empréstimo mutável (*mut no Zig; __global no OpenCL)
// ============================================================================

!verify_execution_modality(modality_id: int, has_io: int, has_alloc: int, is_deterministic: int) -> int {
    valid = 0;
    ?(modality_id == 1) { // FN_HOST
        valid = 100; // Válido para execução em CPU com Zig
    }
    ?(modality_id == 2) { // KERNEL_DEVICE (OpenCL ROCm gfx1030)
        // Regra estrita: Kernel em silício NUNCA pode conter I/O nem alocação dinâmica
        ?(has_io == 0) {
            ?(has_alloc == 0) {
                ?(is_deterministic == 1) {
                    valid = 200; // Válido para execução bit-exact em GPU
                }
            }
        }
    }
    ^valid;
}

!verify_ownership_semantics(ownership_mode: int, target_backend: int) -> int {
    status = 0;
    // 1: OWNED, 2: REF, 3: MUT_REF
    ?(ownership_mode >= 1) {
        ?(ownership_mode <= 3) {
            ?(target_backend == 1) { // 1: Zig Backend
                status = 10 + ownership_mode; // Gera defer free ou ponteiro const/mut
            }
            ?(target_backend == 3) { // 3: OpenCL Backend
                status = 30 + ownership_mode; // Mapeia para __global ou __constant
            }
        }
    }
    ^status;
}

!eval_simd_type_mapping(simd_width: int, is_float: int) -> int {
    type_code = 0;
    // Larguras SIMD suportadas: 2, 4, 8, 16
    ?(simd_width == 4) {
        ?(is_float == 1) {
            type_code = 404; // v4f -> float4 (OpenCL) e @Vector(4, f32) (Zig)
        }
        ?(is_float == 0) {
            type_code = 408; // v4i -> int4 (OpenCL) e @Vector(4, i32) (Zig)
        }
    }
    ?(simd_width == 8) {
        ?(is_float == 1) {
            type_code = 804; // v8f -> float8 (OpenCL) e @Vector(8, f32) (Zig)
        }
    }
    ^type_code;
}

=ex{verify_execution_modality, verify_ownership_semantics, eval_simd_type_mapping}
