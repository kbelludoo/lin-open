@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=nanopass_rewriter_v110
~G{?=if #=for ^=ret :else}

// ============================================================================
// LIN NANOPASS REWRITER & AUTO-OPTIMIZING IN-MEMORY COMPILER (LIN -> LIN)
// Semântica Estrita:
//   - ^ é exclusivamente RETORNO (Return) conforme ~G
//   - Operações binárias usam operadores aritméticos explícitos (+, -, *, ~ para xor/bitnot)
//   - Comportamento Fail-Closed: Contagens inconsistentes retornam erro sentinela (-1)
// ============================================================================

!pass_constant_fold_binop(op_code: int, is_lhs_const: int, lhs_val: int, is_rhs_const: int, rhs_val: int) -> int {
    folded_val = 0;
    // Se ambos são constantes literais, resolve em tempo de compilação
    ?(is_lhs_const == 1) {
        ?(is_rhs_const == 1) {
            ?(op_code == 1) { // ADD
                folded_val = lhs_val + rhs_val;
            }
            ?(op_code == 2) { // SUB
                folded_val = lhs_val - rhs_val;
            }
            ?(op_code == 3) { // MUL
                folded_val = lhs_val * rhs_val;
            }
            ?(op_code == 4) { // BITWISE_XOR (sem colisão com retorno ^)
                folded_val = (lhs_val + rhs_val) - (lhs_val * 2 * (lhs_val == rhs_val));
            }
        }
    }
    ^folded_val;
}

!pass_algebraic_identity(op_code: int, rhs_val: int) -> int {
    identity_flag = 0;
    // Identidades que reduzem para a própria variável (x + 0, x * 1, x ^ 0)
    ?(op_code == 1) { // ADD com 0
        ?(rhs_val == 0) {
            identity_flag = 1; // x + 0 -> x
        }
    }
    ?(op_code == 3) { // MUL com 1
        ?(rhs_val == 1) {
            identity_flag = 1; // x * 1 -> x
        }
    }
    ?(op_code == 4) { // XOR com 0
        ?(rhs_val == 0) {
            identity_flag = 1; // x xor 0 -> x
        }
    }
    ^identity_flag;
}

!eval_nanopass_pipeline(initial_inst_count: int, folds_applied: int, identities_reduced: int) -> int {
    total_reductions = folds_applied + identities_reduced;
    final_inst_count = initial_inst_count - total_reductions;
    
    // FAIL-CLOSED ESTREITO: Se mais reduções foram aplicadas do que instruções existiam, erro -1
    ?(final_inst_count < 1) {
        final_inst_count = 0 - 1; // Sentinela de Erro Estrito (-1)
    }
    ^final_inst_count;
}

=ex{pass_constant_fold_binop, pass_algebraic_identity, eval_nanopass_pipeline}
