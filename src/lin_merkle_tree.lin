@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=pairwise_merkle
~G{?=if #=for ^=ret :else}

!combine_merkle_pair(left_node, right_node) {
    // Pairwise binary Merkle node combination
    node_hash = (left_node * 16777619) ^ (right_node * 2166136261) + 0x517cc1b7;
    ^node_hash;
}

!reduce_merkle_level_4(leaf1, leaf2, leaf3, leaf4) {
    // Level 1: Pairwise reduction
    p1 = (leaf1 * 16777619) ^ (leaf2 * 2166136261) + 0x517cc1b7;
    p2 = (leaf3 * 16777619) ^ (leaf4 * 2166136261) + 0x517cc1b7;
    
    // Level 2: Root reduction
    root = (p1 * 16777619) ^ (p2 * 2166136261) + 0x517cc1b7;
    ^root;
}

=ex{combine_merkle_pair, reduce_merkle_level_4}
