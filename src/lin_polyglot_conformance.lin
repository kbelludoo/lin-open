@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=polyglot_conformance_v310
~G{?=if #=for ^=ret :else}

!check_blind_cleanroom_independence(compiler_invoked: int, planner_invoked: int, runtime_invoked: int) -> int {
    independent = 0;
    ?(compiler_invoked == 0) {
        ?(planner_invoked == 0) {
            ?(runtime_invoked == 0) {
                independent = 1;
            }
        }
    }
    ^independent;
}

!verify_polyglot_digest_parity(digest_lin: int, digest_ext: int, fail_code_match: int) -> int {
    parity_ok = 0;
    ?(digest_lin == digest_ext) {
        ?(fail_code_match == 1) {
            parity_ok = 1;
        }
    }
    ^parity_ok;
}

!evaluate_conformance_closure(independent_ok: int, parity_ok: int, adversarial_passed: int) -> int {
    verdict = 0;
    ?(independent_ok == 1) {
        ?(parity_ok == 1) {
            ?(adversarial_passed >= 10) {
                verdict = 9500;
            }
        }
    }
    ^verdict;
}

=ex{check_blind_cleanroom_independence, verify_polyglot_digest_parity, evaluate_conformance_closure}
