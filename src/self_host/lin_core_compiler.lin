@LIN:lin_core_compiler:2.0.0
~G{?=if #=for ^=ret :else}

!tokenizeFast(src){
  ?(!src || src.length === 0){ ^[] };
  lines = src.split("\n");
  out = [];
  #(i = 0; i < lines.length; i = i + 1){
    line = lines[i].trim();
    ?(!line || line.startsWith("//")){ continue };
    c0 = line.charCodeAt(0);
    ?(c0 === 64 && line.startsWith("@")){ out.push({ k: 1, text: line }) }
    : (c0 === 126 && line.startsWith("~")){ out.push({ k: 2, text: line }) }
    : (c0 === 33 && line.startsWith("!")){ out.push({ k: 3, text: line }) }
    : (c0 === 61 && line.startsWith("=ex")){ out.push({ k: 4, text: line }) }
    : { out.push({ k: 5, text: line }) };
  };
  ^out;
}

!parseAstCompact(tokens){
  ast = { name: "anonymous", functions: [], exports: [] };
  #(i = 0; i < tokens.length; i = i + 1){
    tok = tokens[i];
    ?(tok.k === 1){
      m = tok.text.match(/@LIN:([a-zA-Z0-9_$]+)/);
      ?(m){ ast.name = m[1] };
    }
    : (tok.k === 3){
      m = tok.text.match(/!([a-zA-Z0-9_$]+)\s*\(([^)]*)\)/);
      ?(m){
        params = m[2].split(",").map(function(p){ ^p.trim() }).filter(Boolean);
        ast.functions.push({ name: m[1], params: params });
      };
    }
    : (tok.k === 4){
      m = tok.text.match(/=ex\{([^}]+)\}/);
      ?(m){
        exs = m[1].split(",").map(function(e){ ^e.trim() }).filter(Boolean);
        ast.exports = exs;
      };
    };
  };
  ^ast;
}

!verifySemanticsFast(ast){
  ?(!ast || !ast.functions){ ^{ valid: false, error: "Invalid AST" } };
  #(i = 0; i < ast.functions.length; i = i + 1){
    fn = ast.functions[i];
    ?(!fn.name){ ^{ valid: false, error: "Missing function name" } };
  };
  ^{ valid: true, count: ast.functions.length };
}

!compileLinToJs(src){
  tokens = tokenizeFast(src);
  ast = parseAstCompact(tokens);
  v = verifySemanticsFast(ast);
  ?(!v.valid){ throw new Error("Verification Failed: " + v.error) };
  code = "/* generated by lin-selfhost */\n";
  #(i = 0; i < ast.functions.length; i = i + 1){
    fn = ast.functions[i];
    code = code + "function " + fn.name + "(" + fn.params.join(",") + "){ return null; }\n";
  };
  ?(ast.exports && ast.exports.length > 0){
    code = code + "module.exports={" + ast.exports.join(",") + "};";
  };
  ^code;
}

=ex{tokenizeFast,parseAstCompact,verifySemanticsFast,compileLinToJs}
