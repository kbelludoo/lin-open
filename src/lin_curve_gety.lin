@LIN:L1c:0.2
@CURVE_3POOL_GETY{
  version=1
  repo="curvefi/curve-contract"
  source="contracts/pools/3pool/StableSwap3Pool.vy get_D/get_y"
  license="all_rights_reserved_informational_upstream"
  commit="bae23a2fc9a0302d174ea1ffce8219a44a92149c"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_curve_3pool_newton_gety_128bit"
  note="Not mainnet uint256. N=3 explicit x0,x1,x2. amp is an argument (not a time-ramped pool field). SCALE=1e9 so Ann*S*D fits 128-bit. get_dy dx=0 fail-closes instead of uint256 wrap of xp[j]-y-1."
}

!cgy_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!cgy_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(cgy_u_lt(s, a));
}

!cgy_mask32() -> int {
  ^ 4294967295;
}

!cgy_n() -> int {
  ^ 3;
}

!cgy_close1(a: int, b: int) -> int {
  ?(a >= b) {
    ?(a - b <= 1) { ^ 1; };
    ^ 0;
  };
  ?(b - a <= 1) { ^ 1; };
  ^ 0;
}

!cgy_muldiv_add_part(a: int, b: int, add: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = cgy_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = cgy_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = cgy_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + cgy_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(cgy_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = cgy_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!cgy_muldiv(a: int, b: int, d: int) -> int {
  ^ cgy_muldiv_add_part(a, b, 0, d, 0);
}

!cgy_pick(i: int, x0: int, x1: int, x2: int) -> int {
  ?(i == 0) { ^ x0; };
  ?(i == 1) { ^ x1; };
  ?(i == 2) { ^ x2; };
  ^ 0;
}

!cgy_xp_ok(x0: int, x1: int, x2: int, amp: int) -> int {
  ?(amp <= 0) { ^ 0; };
  ?(x0 <= 0) { ^ 0; };
  ?(x1 <= 0) { ^ 0; };
  ?(x2 <= 0) { ^ 0; };
  ^ 1;
}

!cgy_accum_s(k: int, i: int, j: int, x: int, xk: int, s: int) -> int {
  ?(k == j) { ^ s; };
  _x = xk;
  ?(k == i) { _x = x; };
  ?(_x <= 0) { ^ 0; };
  t = s + _x;
  ?(cgy_u_lt(t, s) == 1) { ^ 0; };
  ^ t;
}

!cgy_accum_c(k: int, i: int, j: int, x: int, xk: int, d: int, c: int) -> int {
  ?(k == j) { ^ c; };
  _x = xk;
  ?(k == i) { _x = x; };
  ?(_x <= 0) { ^ 0; };
  den = _x * cgy_n();
  ?(den <= 0) { ^ 0; };
  ^ cgy_muldiv(c, d, den);
}

!cgy_get_d(x0: int, x1: int, x2: int, amp: int) -> int {
  ?(cgy_xp_ok(x0, x1, x2, amp) == 0) { ^ 0; };
  s = x0 + x1;
  ?(cgy_u_lt(s, x0) == 1) { ^ 0; };
  s = s + x2;
  ?(cgy_u_lt(s, x2) == 1) { ^ 0; };
  ?(s == 0) { ^ 0; };
  n = cgy_n();
  ann = amp * n;
  ?(ann <= amp) { ^ 0; };
  d = s;
  iter = 0;
  done = 0;
  while (iter < 255) {
    ?(done == 0) {
      dp = d;
      dp = cgy_muldiv(dp, d, x0 * n);
      dp = cgy_muldiv(dp, d, x1 * n);
      dp = cgy_muldiv(dp, d, x2 * n);
      ?(dp < 0) { d = 0; done = 1; };
      ?(done == 0) {
        dprev = d;
        dp_n = cgy_muldiv(dp, n, 1);
        ?(cgy_muldiv_add_part(ann, s, dp_n, 1, 2) == 1) { d = 0; done = 1; };
        ?(done == 0) {
          sum = cgy_muldiv_add_part(ann, s, dp_n, 1, 0);
          left = cgy_muldiv(ann - 1, d, 1);
          right = cgy_muldiv(n + 1, dp, 1);
          den = left + right;
          ?(cgy_u_lt(den, left) == 1) { d = 0; done = 1; };
          ?(done == 0) {
            ?(cgy_muldiv_add_part(sum, d, 0, den, 2) == 1) { d = 0; done = 1; };
            ?(done == 0) {
              d = cgy_muldiv(sum, d, den);
              ?(cgy_close1(d, dprev) == 1) { done = 1; };
            };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ d;
}

!cgy_get_y(i: int, j: int, x: int, x0: int, x1: int, x2: int, amp: int) -> int {
  ?(i == j) { ^ 0; };
  ?(i < 0) { ^ 0; };
  ?(j < 0) { ^ 0; };
  ?(i > 2) { ^ 0; };
  ?(j > 2) { ^ 0; };
  ?(x <= 0) { ^ 0; };
  ?(cgy_xp_ok(x0, x1, x2, amp) == 0) { ^ 0; };
  d = cgy_get_d(x0, x1, x2, amp);
  ?(d <= 0) { ^ 0; };
  n = cgy_n();
  ann = amp * n;
  c = d;
  s_ = 0;
  s_ = cgy_accum_s(0, i, j, x, x0, s_);
  s_ = cgy_accum_s(1, i, j, x, x1, s_);
  s_ = cgy_accum_s(2, i, j, x, x2, s_);
  c = cgy_accum_c(0, i, j, x, x0, d, c);
  c = cgy_accum_c(1, i, j, x, x1, d, c);
  c = cgy_accum_c(2, i, j, x, x2, d, c);
  ?(c <= 0) { ^ 0; };
  ?(cgy_muldiv_add_part(ann, n, 0, 1, 2) == 1) { ^ 0; };
  ann_n = cgy_muldiv(ann, n, 1);
  ?(ann_n <= 0) { ^ 0; };
  c = cgy_muldiv(c, d, ann_n);
  ?(c <= 0) { ^ 0; };
  d_ann = cgy_muldiv(d, 1, ann);
  b = s_ + d_ann;
  ?(cgy_u_lt(b, s_) == 1) { ^ 0; };
  y = d;
  iter = 0;
  done = 0;
  while (iter < 255) {
    ?(done == 0) {
      yprev = y;
      two_y = y + y;
      ?(cgy_u_lt(two_y, y) == 1) { y = 0; done = 1; };
      ?(done == 0) {
        num_ok = 1;
        ?(cgy_u_add_carry(two_y, b) == 1) { num_ok = 0; };
        tb = two_y + b;
        ?(cgy_u_lt(tb, d) == 1) { num_ok = 0; };
        ?(num_ok == 0) { y = 0; done = 1; };
        ?(done == 0) {
          den = tb - d;
          ?(den <= 0) { y = 0; done = 1; };
          ?(done == 0) {
            ?(cgy_muldiv_add_part(y, y, c, den, 2) == 1) { y = 0; done = 1; };
            ?(done == 0) {
              y = cgy_muldiv_add_part(y, y, c, den, 0);
              ?(cgy_close1(y, yprev) == 1) { done = 1; };
            };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ y;
}

!cgy_get_dy_nofee(i: int, j: int, dx: int, x0: int, x1: int, x2: int, amp: int) -> int {
  ?(dx < 0) { ^ 0; };
  xi = cgy_pick(i, x0, x1, x2);
  ?(xi <= 0) { ^ 0; };
  x = xi + dx;
  ?(cgy_u_lt(x, xi) == 1) { ^ 0; };
  y = cgy_get_y(i, j, x, x0, x1, x2, amp);
  ?(y <= 0) { ^ 0; };
  xj = cgy_pick(j, x0, x1, x2);
  ?(cgy_u_lt(xj, y) == 1) { ^ 0; };
  raw = xj - y;
  ?(raw <= 0) { ^ 0; };
  ^ raw - 1;
}

!cgy_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!cgy_test_suite() -> int {
  e9 = 1000000000;
  ?(cgy_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(cgy_get_d(e9, e9, e9, 100) != 3000000000) { ^ -2; };
  ?(cgy_get_d(e9, e9, e9, 2000) != 3000000000) { ^ -3; };
  ?(cgy_get_y(0, 1, e9, e9, e9, e9, 100) != e9) { ^ -4; };
  ?(cgy_get_y(0, 1, 1100000000, e9, e9, e9, 100) != 900099889) { ^ -5; };
  ?(cgy_get_y(0, 1, 1100000000, e9, e9, e9, 2000) != 900005047) { ^ -6; };
  ?(cgy_get_dy_nofee(0, 1, 100000000, e9, e9, e9, 100) != 99900110) { ^ -7; };
  ?(cgy_get_dy_nofee(0, 1, 100000000, e9, e9, e9, 2000) != 99994952) { ^ -8; };
  ?(cgy_get_y(0, 0, e9, e9, e9, e9, 100) != 0) { ^ -9; };
  ?(cgy_get_d(0, e9, e9, 100) != 0) { ^ -10; };
  ?(cgy_get_dy_nofee(0, 1, 0, e9, e9, e9, 100) != 0) { ^ -11; };
  ?(cgy_get_d(1200000000, 900000000, e9, 100) != 3099778671) { ^ -12; };
  ?(cgy_get_y(0, 1, 1100000000, 1200000000, 900000000, e9, 100) != 999810078) { ^ -13; };
  ?(cgy_naive_i64_mul(3099778671, 3099778671) != -8838116264523025375) { ^ -14; };
  ?(cgy_n() != 3) { ^ -15; };
  ?(cgy_get_y(1, 0, e9, e9, e9, e9, 100) != e9) { ^ -16; };
  ?(cgy_get_d(e9, e9, e9, 0) != 0) { ^ -17; };
  ?(cgy_get_y(3, 1, e9, e9, e9, e9, 100) != 0) { ^ -18; };
  ^ 1;
}

=ex{
  cgy_u_lt,
  cgy_u_add_carry,
  cgy_mask32,
  cgy_n,
  cgy_close1,
  cgy_muldiv_add_part,
  cgy_muldiv,
  cgy_pick,
  cgy_xp_ok,
  cgy_accum_s,
  cgy_accum_c,
  cgy_get_d,
  cgy_get_y,
  cgy_get_dy_nofee,
  cgy_naive_i64_mul,
  cgy_test_suite
}
