@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=workload_planner
~G{?=if #=for ^=ret :else}

!predict_execution_cost(element_count, op_type, target_device) {
    cost = 0;
    ?(target_device == 1) { // GPU (gfx1030)
        // Base launch latency 15000 ns + throughput 0.12 ns per elem
        cost = 15000 + (element_count / 8);
    } : { // CPU (Zen 3)
        // Base launch latency 500 ns + throughput 1.4 ns per elem
        cost = 500 + (element_count + (element_count / 3));
    }
    ^cost;
}

!select_optimal_device(element_count, transfer_cost) {
    gpu_cost = predict_execution_cost(element_count, 1, 1) + transfer_cost;
    cpu_cost = predict_execution_cost(element_count, 1, 2);
    
    selected_device = 2; // CPU
    ?(gpu_cost < cpu_cost) {
        selected_device = 1; // GPU
    }
    ^selected_device;
}

=ex{predict_execution_cost, select_optimal_device}
