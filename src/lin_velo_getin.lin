@LIN:L1c:0.2
@VELODROME_GETAMOUNTIN{
  version=1
  repo="velodrome-finance/contracts"
  source="contracts/Pool.sol inverse of getAmountOut / _get_y (Pool has no getAmountIn)"
  license="GPL-3.0-or-later_hash_pin_only"
  commit="b3065d8b6702b14b094f9f6046b752cc9f78c43b"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_velodrome_getAmountIn_128bit"
  note="Not mainnet uint256. SCALE=1e9. Exact-output inverse of published getAmountOut: volatile closed-form +1 ceiling; stable Newton then fee gross-up +1. fee/stable/reserves are arguments. Overflow, aout>=reserveB, fee>=10000 fail-close to 0."
}

!vgi_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!vgi_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(vgi_u_lt(s, a));
}

!vgi_mask32() -> int {
  ^ 4294967295;
}

!vgi_scale() -> int {
  ^ 1000000000;
}

!vgi_fee_den() -> int {
  ^ 10000;
}

!vgi_prod128(a: int, b: int, want: int) -> int {
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = vgi_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = vgi_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = vgi_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  ?(want == 1) { ^ hi; };
  ^ lo;
}

!vgi_div128(hi: int, lo: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(d < 0) { ^ 0; };
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(vgi_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = vgi_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(ov == 1) { ^ 0; };
  ?(q < 0) { ^ 0; };
  ^ q;
}

!vgi_muldiv(a: int, b: int, d: int) -> int {
  ?(d == 0) { ^ 0; };
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  hi = vgi_prod128(a, b, 1);
  lo = vgi_prod128(a, b, 0);
  ^ vgi_div128(hi, lo, d);
}

!vgi_f(x0: int, y: int) -> int {
  ?(x0 <= 0) { ^ 0; };
  ?(y <= 0) { ^ 0; };
  P = vgi_scale();
  a = vgi_muldiv(x0, y, P);
  xx = vgi_muldiv(x0, x0, P);
  yy = vgi_muldiv(y, y, P);
  b = xx + yy;
  ?(vgi_u_lt(b, xx) == 1) { ^ 0; };
  ^ vgi_muldiv(a, b, P);
}

!vgi_d(x0: int, y: int) -> int {
  ?(x0 <= 0) { ^ 0; };
  ?(y <= 0) { ^ 0; };
  P = vgi_scale();
  yy = vgi_muldiv(y, y, P);
  t1 = vgi_muldiv(vgi_muldiv(3, x0, 1), yy, P);
  xx = vgi_muldiv(x0, x0, P);
  t2 = vgi_muldiv(xx, x0, P);
  s = t1 + t2;
  ?(vgi_u_lt(s, t1) == 1) { ^ 0; };
  ^ s;
}

!vgi_get_y(x0: int, xy: int, y: int) -> int {
  ?(x0 <= 0) { ^ 0; };
  ?(xy <= 0) { ^ 0; };
  ?(y <= 0) { ^ 0; };
  iter = 0;
  done = 0;
  outy = 0;
  while (iter < 255) {
    ?(done == 0) {
      k = vgi_f(x0, y);
      den = vgi_d(x0, y);
      ?(den <= 0) { done = 1; };
      ?(done == 0) {
        lt = vgi_u_lt(k, xy);
        ?(lt == 1) {
          dy = vgi_muldiv(xy - k, vgi_scale(), den);
          ?(dy == 0) {
            ?(k == xy) { outy = y; done = 1; };
            ?(done == 0) {
              yp = y + 1;
              ?(vgi_u_lt(yp, y) == 1) { done = 1; };
              ?(done == 0) {
                ?(vgi_u_lt(xy, vgi_f(x0, yp)) == 1) { outy = yp; done = 1; };
                ?(done == 0) { dy = 1; };
              };
            };
          };
          ?(done == 0) {
            ny = y + dy;
            ?(vgi_u_lt(ny, y) == 1) { done = 1; };
            ?(done == 0) { y = ny; };
          };
        };
        ?(lt == 0) {
          dy = vgi_muldiv(k - xy, vgi_scale(), den);
          ?(dy == 0) {
            close = 0;
            ?(k == xy) { close = 1; };
            ?(y > 0) {
              ?(vgi_u_lt(vgi_f(x0, y - 1), xy) == 1) { close = 1; };
            };
            ?(close == 1) { outy = y; done = 1; };
            ?(done == 0) { dy = 1; };
          };
          ?(done == 0) {
            ?(vgi_u_lt(y, dy) == 1) { done = 1; };
            ?(y == dy) { done = 1; };
            ?(done == 0) { y = y - dy; };
          };
        };
      };
    };
    iter = iter + 1;
  };
  ^ outy;
}

!vgi_get_amount_out(amountIn: int, reserveA: int, reserveB: int, stable: int, fee: int) -> int {
  ?(amountIn <= 0) { ^ 0; };
  ?(reserveA <= 0) { ^ 0; };
  ?(reserveB <= 0) { ^ 0; };
  ?(fee < 0) { ^ 0; };
  ?(vgi_u_lt(vgi_fee_den(), fee) == 1) { ^ 0; };
  net = amountIn - vgi_muldiv(amountIn, fee, vgi_fee_den());
  ?(net <= 0) { ^ 0; };
  ?(stable == 0) {
    den = reserveA + net;
    ?(vgi_u_lt(den, reserveA) == 1) { ^ 0; };
    ^ vgi_muldiv(net, reserveB, den);
  };
  xy = vgi_f(reserveA, reserveB);
  ?(xy <= 0) { ^ 0; };
  x0 = reserveA + net;
  ?(vgi_u_lt(x0, reserveA) == 1) { ^ 0; };
  y = vgi_get_y(x0, xy, reserveB);
  ?(y <= 0) { ^ 0; };
  ?(vgi_u_lt(reserveB, y) == 1) { ^ 0; };
  ?(reserveB == y) { ^ 0; };
  ^ reserveB - y;
}

!vgi_plus1(q: int) -> int {
  ?(q <= 0) { ^ 0; };
  s = q + 1;
  ?(vgi_u_lt(s, q) == 1) { ^ 0; };
  ?(s < 0) { ^ 0; };
  ^ s;
}

!vgi_get_amount_in(amountOut: int, reserveA: int, reserveB: int, stable: int, fee: int) -> int {
  ?(amountOut <= 0) { ^ 0; };
  ?(reserveA <= 0) { ^ 0; };
  ?(reserveB <= 0) { ^ 0; };
  ?(fee < 0) { ^ 0; };
  ?(vgi_u_lt(fee, vgi_fee_den()) == 0) { ^ 0; };
  ?(vgi_u_lt(amountOut, reserveB) == 0) { ^ 0; };
  ?(stable == 0) {
    den = vgi_muldiv(reserveB - amountOut, vgi_fee_den() - fee, 1);
    ?(den <= 0) { ^ 0; };
    q = vgi_muldiv(vgi_muldiv(reserveA, amountOut, 1), vgi_fee_den(), den);
    ^ vgi_plus1(q);
  };
  xy = vgi_f(reserveA, reserveB);
  ?(xy <= 0) { ^ 0; };
  y_new = reserveB - amountOut;
  ?(y_new <= 0) { ^ 0; };
  x_new = vgi_get_y(y_new, xy, reserveA);
  ?(vgi_u_lt(reserveA, x_new) == 0) { ^ 0; };
  net = x_new - reserveA;
  q = vgi_muldiv(net, vgi_fee_den(), vgi_fee_den() - fee);
  ^ vgi_plus1(q);
}

!vgi_naive_floor_in(amountOut: int, reserveA: int, reserveB: int, fee: int) -> int {
  ?(amountOut <= 0) { ^ 0; };
  ?(reserveA <= 0) { ^ 0; };
  ?(reserveB <= 0) { ^ 0; };
  ?(fee < 0) { ^ 0; };
  ?(vgi_u_lt(fee, vgi_fee_den()) == 0) { ^ 0; };
  ?(vgi_u_lt(amountOut, reserveB) == 0) { ^ 0; };
  den = vgi_muldiv(reserveB - amountOut, vgi_fee_den() - fee, 1);
  ?(den <= 0) { ^ 0; };
  ^ vgi_muldiv(vgi_muldiv(reserveA, amountOut, 1), vgi_fee_den(), den);
}

!vgi_ceil_gap(amountOut: int, reserveA: int, reserveB: int, fee: int) -> int {
  a = vgi_get_amount_in(amountOut, reserveA, reserveB, 0, fee);
  b = vgi_naive_floor_in(amountOut, reserveA, reserveB, fee);
  ?(vgi_u_lt(a, b) == 1) { ^ 0; };
  ^ a - b;
}

!vgi_roundtrip_gap(amountOut: int, reserveA: int, reserveB: int, stable: int, fee: int) -> int {
  ain = vgi_get_amount_in(amountOut, reserveA, reserveB, stable, fee);
  ?(ain <= 0) { ^ 0; };
  got = vgi_get_amount_out(ain, reserveA, reserveB, stable, fee);
  ?(vgi_u_lt(got, amountOut) == 1) { ^ 0; };
  ^ got - amountOut;
}

!vgi_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!vgi_test_suite() -> int {
  e9 = 1000000000;
  ?(vgi_muldiv(100, 200, 50) != 400) { ^ -1; };
  ?(vgi_f(e9, e9) != 2000000000) { ^ -2; };
  ?(vgi_get_y(e9, 2000000000, e9) != e9) { ^ -3; };
  ?(vgi_get_amount_in(100000000, e9, e9, 0, 0) != 111111112) { ^ -4; };
  ?(vgi_get_amount_in(100000000, e9, e9, 0, 5) != 111166695) { ^ -5; };
  ?(vgi_get_amount_in(100000000, e9, e9, 0, 30) != 111445448) { ^ -6; };
  ?(vgi_get_amount_in(100000000, e9, e9, 1, 0) != 100050050) { ^ -7; };
  ?(vgi_get_amount_in(100000000, e9, e9, 1, 1) != 100060056) { ^ -8; };
  ?(vgi_get_amount_out(111445448, e9, e9, 0, 30) != 100000000) { ^ -9; };
  ?(vgi_roundtrip_gap(100000000, e9, e9, 0, 30) != 0) { ^ -10; };
  ?(vgi_ceil_gap(100000000, e9, e9, 30) != 1) { ^ -11; };
  ?(vgi_get_amount_in(0, e9, e9, 0, 5) != 0) { ^ -12; };
  ?(vgi_get_amount_in(e9, e9, e9, 0, 5) != 0) { ^ -13; };
  ?(vgi_get_amount_in(100000000, e9, e9, 0, 10000) != 0) { ^ -14; };
  ?(vgi_naive_i64_mul(4000000000, 4000000000) != -2446744073709551616) { ^ -15; };
  ?(vgi_muldiv(4000000000, 4000000000, 1) != 0) { ^ -16; };
  ^ 1;
}

=ex{
  vgi_u_lt,
  vgi_u_add_carry,
  vgi_mask32,
  vgi_scale,
  vgi_fee_den,
  vgi_prod128,
  vgi_div128,
  vgi_muldiv,
  vgi_f,
  vgi_d,
  vgi_get_y,
  vgi_get_amount_out,
  vgi_plus1,
  vgi_get_amount_in,
  vgi_naive_floor_in,
  vgi_ceil_gap,
  vgi_roundtrip_gap,
  vgi_naive_i64_mul,
  vgi_test_suite
}
