@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=canonical_formatter_v100
~G{?=if #=for ^=ret :else}

!check_lin_header(header_type: int) -> int {
    valid = 0;
    ?(header_type == 1) {
        valid = 1;
    }
    ^valid;
}

!format_indent_depth(current_depth: int, is_open_brace: int, is_close_brace: int) -> int {
    next_depth = current_depth;
    ?(is_open_brace == 1) {
        next_depth = current_depth + 1;
    }
    ?(is_close_brace == 1) {
        ?(current_depth > 0) {
            next_depth = current_depth - 1;
        }
    }
    ^next_depth;
}

!validate_canonical_rulel_line(line_type: int) -> int {
    ok = 0;
    ?(line_type > 0) {
        ok = 1;
    }
    ^ok;
}

=ex{check_lin_header, format_indent_depth, validate_canonical_rulel_line}
