.source{content="/* generated by lin-rewrite 2.0.0 */\n/* effect:Write */function splitTopEntries(s){var out, cur, depth, quote, c, i;out = [];cur = \"\";depth = 0;quote = null;for(i = 0;i < s.length;i++){c = s.charAt(i);if(quote){cur = cur + c;if(c === \"\\\\\" && i + 1 < s.length){i++;cur = cur + s.charAt(i);}else if(c === quote){quote = null;}}else if(c === \"\\\"\" || c === \"'\"){quote = c;cur = cur + c;}else if(c === \" \" && depth === 0){if(cur.trim()){out.push(cur.trim());}cur = \"\";}else{if(c === \"(\" || c === \"{\" || c === \"[\"){depth++;}else if(c === \")\" || c === \"}\" || c === \"]\"){depth--;}cur = cur + c;}}if(cur.trim()){out.push(cur.trim());}return out;}\n/* effect:Write */function parseValuePairs(body){var entries, obj, e, m, k;entries = splitTopEntries(body);obj = {};for(k = 0;k < entries.length;k++){e = entries[k];m = e.match(/^([A-Za-z_][\\w_-]*)=(.+)$/);if(m){obj[m[1]] = m[2];}else{obj[e] = true;}}return obj;}\n/* effect:Write */function parseRulel(text){var s, out, hm, sigilRe, m, parsedSig, blockRe;s = String(text || \"\").trim();out = { header: null, sigils: {}, blocks: {} };hm = s.match(/^@RULEL:([^:\\s]+):([^\\s]+)/);if(hm){out.header = { id: hm[1], semver: hm[2] };}sigilRe = /~R\\{([\\s\\S]*?)\\}/g;m = null;while((m = sigilRe.exec(s)) !== null){parsedSig = parseValuePairs(m[1]);Object.assign(out.sigils, parsedSig);}blockRe = /\\.([a-z])\\{([^{}]*)\\}/g;while((m = blockRe.exec(s)) !== null){out.blocks[m[1]] = parseValuePairs(m[2]);}return out;}\n/* effect:Read */function validateComms(parsed){var required, missing, ridVal;required = [\"m\", \"r\", \"f\", \"a\", \"c\", \"s\", \"p\"];missing = required.filter(function(k){return (!parsed.blocks[k]);});ridVal = (parsed.blocks.r && (parsed.blocks.r.R20 || parsed.blocks.r.rid)) || null;return {\n    ok: missing.length === 0,\n    missing: missing,\n    header: parsed.header,\n    rid: ridVal\n  };}\n/* effect:Native */function unquoteRulelToken(raw){var trimmed, q;trimmed = String(raw || \"\").trim();q = trimmed.charAt(0);if((q === \"\\\"\" || q === \"'\") && trimmed.length >= 2 && trimmed.charAt(trimmed.length - 1) === q){return trimmed.slice(1, trimmed.length - 1).replace(/\\\\\"/g, \"\\\"\");}return trimmed;}\n/* effect:Native */function decodeBehaviorValue(raw){return JSON.parse(unquoteRulelToken(raw));}\n/* effect:Write */function extractCaseBlocks(text){var s, out, i, n, depth, quote, c, contentStart, j;s = String(text || \"\");out = [];i = 0;n = s.length;while(i < n){if(s.slice(i, i + 6) === \".case{\"){contentStart = i + 6;depth = 1;quote = null;j = contentStart;while(j < n && depth > 0){c = s.charAt(j);if(quote){if(c === \"\\\\\" && j + 1 < n){j++;}else if(c === quote){quote = null;}}else if(c === \"\\\"\" || c === \"'\"){quote = c;}else if(c === \"{\"){depth++;}else if(c === \"}\"){depth--;}j++;}out.push(s.slice(contentStart, j - 1));i = j;}else{i++;}}return out;}\n/* effect:Write */function parseBehaviorCasesRulel(text){var blocks, cases, k, body, pairs, item;blocks = extractCaseBlocks(text);cases = [];for(k = 0;k < blocks.length;k++){body = blocks[k];pairs = parseValuePairs(body);item = { fn: pairs.fn, args: [] };if(pairs.args !== undefined){item.args = decodeBehaviorValue(pairs.args);}if(pairs.want !== undefined){item.want = decodeBehaviorValue(pairs.want);}if(pairs.label !== undefined){item.label = unquoteRulelToken(pairs.label);}cases.push(item);}return cases;}\nmodule.exports={splitTopEntries,parseValuePairs,parseRulel,validateComms,unquoteRulelToken,decodeBehaviorValue,extractCaseBlocks,parseBehaviorCasesRulel};\nmodule.exports={splitTopEntries,parseValuePairs,parseRulel,validateComms,unquoteRulelToken,decodeBehaviorValue,extractCaseBlocks,parseBehaviorCasesRulel};\n"}
