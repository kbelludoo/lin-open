.source{content="/* generated by lin-rewrite 2.0.0 */\n/* effect:Write */function splitTopEntries(s){var out,cur,depth,quote,c,i;out = [];cur = \"\";depth = 0;quote = null;for(i = 0;i < s.length;i++){c = s.charAt(i);if(quote){cur = cur + c;if(c === \"\\\\\" && i + 1 < s.length){i++;cur = cur + s.charAt(i);}else if(c === quote){quote = null;}continue;}if(c === \"\\\"\" || c === \"'\"){quote = c;cur = cur + c;continue;}if(c === \"(\" || c === \"{\" || c === \"[\"){depth++;}else if(c === \")\" || c === \"}\" || c === \"]\"){depth--;}if(c === \" \" && depth === 0){if(cur.trim()){out.push(cur.trim());}cur = \"\";continue;}cur = cur + c;}if(cur.trim()){out.push(cur.trim());}return out;}\n/* effect:Write */function parseValuePairs(body){var entries,obj,e,m,k;entries = splitTopEntries(body);obj = {};for(k = 0;k < entries.length;k++){e = entries[k];m = e.match(/^([A-Za-z_][\\w_-]*)=(.+)$/);if(m){obj[m[1]] = m[2];}else{obj[e] = true;}}return obj;}\n/* effect:Write */function parseRulel(text){var s,out,hm,sigilRe,m,parsedSig,blockRe;s = String(text || \"\").trim();out = { header: null, sigils: {}, blocks: {} };hm = s.match(/^@RULEL:([^:\\s]+):([^\\s]+)/);if(hm){out.header = { id: hm[1], semver: hm[2] };}sigilRe = /~R\\{([\\s\\S]*?)\\}/g;m = null;while((m = sigilRe.exec(s)) !== null){parsedSig = parseValuePairs(m[1]);Object.assign(out.sigils, parsedSig);}blockRe = /\\.([a-z])\\{([^{}]*)\\}/g;while((m = blockRe.exec(s)) !== null){out.blocks[m[1]] = parseValuePairs(m[2]);}return out;}\n/* effect:Read */function validateComms(parsed){var required,missing,ridVal;required = [\"m\", \"r\", \"f\", \"a\", \"c\", \"s\", \"p\"];missing = required.filter(function(k){return (!parsed.blocks[k]);});ridVal = (parsed.blocks.r && (parsed.blocks.r.R20 || parsed.blocks.r.rid)) || null;return {\n    ok: missing.length === 0,\n    missing: missing,\n    header: parsed.header,\n    rid: ridVal\n  };}\nmodule.exports={splitTopEntries,parseValuePairs,parseRulel,validateComms};\nmodule.exports={splitTopEntries,parseValuePairs,parseRulel,validateComms};\n"}
