@LIN:L1c:0.2
@BALANCER_TOKEN_IN_GIVEN_BPT_OUT{
  version=1
  repo="balancer/balancer-v2-monorepo"
  source="pkg/pool-weighted/contracts/WeightedMath.sol _calcTokenInGivenExactBptOut + FixedPoint mulUp/divUp/complement/powUp"
  license="GPL-3.0-or-later_upstream_not_vendored"
  commit="e91a2b643a49856f51a648d175667c1b48cf3377"
  profile="LINVM-1"
  class="EXPERIMENTAL"
  purpose="uint64_scale_balancer_exact_bpt_out_token_in_powUp_128bit"
  note="Not mainnet uint256/ONE=1e18/LogExpMath/uint256[] joins. ONE=1e9. Integer powUp plus bounded Newton. Inverse of _calcBptOutGivenExactTokenIn. Upstream Solidity is hash-pinned, not vendored."
}

!bbi_u_lt(a: int, b: int) -> int {
  ?(a < 0 && b >= 0) { ^ 0; };
  ?(a >= 0 && b < 0) { ^ 1; };
  ?(a < b) { ^ 1; };
  ^ 0;
}

!bbi_u_add_carry(a: int, b: int) -> int {
  s = a + b;
  ^(bbi_u_lt(s, a));
}

!bbi_mask32() -> int {
  ^ 4294967295;
}

!bbi_one() -> int {
  ^ 1000000000;
}

!bbi_max_inv() -> int {
  ^ 3000000000;
}

!bbi_one_e18_fits() -> int {
  ^ 1;
}

!bbi_logexp_claimed() -> int {
  ^ 0;
}

!bbi_array_join_claimed() -> int {
  ^ 0;
}

!bbi_muldiv_add_part(a: int, b: int, add: int, d: int, want: int) -> int {
  ?(d == 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(a < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(b < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  ?(add < 0) { ?(want == 2) { ^ 1; }; ^ 0; };
  m32 = bbi_mask32();
  a0 = a & m32;
  a1 = _lia_ushr(a, 32);
  b0 = b & m32;
  b1 = _lia_ushr(b, 32);
  p0 = a0 * b0;
  p1 = a0 * b1;
  p2 = a1 * b0;
  p3 = a1 * b1;
  mid = p1 + p2;
  mid_carry = bbi_u_add_carry(p1, p2);
  mid_lo = mid & m32;
  mid_hi = _lia_ushr(mid, 32);
  t = _lia_shl(mid_lo, 32);
  lo = p0 + t;
  lo_carry = bbi_u_add_carry(p0, t);
  hi = p3 + mid_hi;
  hi = hi + _lia_shl(mid_carry, 32);
  hi = hi + lo_carry;
  lo2 = lo + add;
  hi = hi + bbi_u_add_carry(lo, add);
  lo = lo2;
  r_hi = 0;
  r_lo = 0;
  q = 0;
  ov = 0;
  i = 127;
  while (i >= 0) {
    bit = 0;
    ?(i >= 64) { bit = _lia_ushr(hi, i - 64) & 1; };
    ?(i < 64) { bit = _lia_ushr(lo, i) & 1; };
    new_hi = _lia_shl(r_hi, 1) | _lia_ushr(r_lo, 63);
    new_lo = _lia_shl(r_lo, 1) | bit;
    r_hi = new_hi;
    r_lo = new_lo;
    ge = 0;
    ?(r_hi != 0) { ge = 1; };
    ?(r_hi == 0) {
      ?(bbi_u_lt(r_lo, d) == 0) { ge = 1; };
    };
    ?(ge == 1) {
      need_borrow = bbi_u_lt(r_lo, d);
      r_lo = r_lo - d;
      ?(need_borrow == 1) { r_hi = r_hi - 1; };
      ?(i >= 64) { ov = 1; };
      ?(i < 64) { q = q | _lia_shl(1, i); };
    };
    i = i - 1;
  };
  ?(q < 0) { ov = 1; };
  ?(want == 2) { ^ ov; };
  ?(want == 1) { ^ r_lo; };
  ?(ov == 1) { ^ 0; };
  ^ q;
}

!bbi_mul_down(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ^ bbi_muldiv_add_part(a, b, 0, bbi_one(), 0);
}

!bbi_mul_up(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ?(b == 0) { ^ 0; };
  ?(bbi_muldiv_add_part(a, b, 0, bbi_one(), 2) == 1) { ^ 0; };
  q = bbi_muldiv_add_part(a, b, 0, bbi_one(), 0);
  r = bbi_muldiv_add_part(a, b, 0, bbi_one(), 1);
  ?(r == 0) { ^ q; };
  s = q + 1;
  ?(s < 0) { ^ 0; };
  ?(bbi_u_lt(s, q) == 1) { ^ 0; };
  ^ s;
}

!bbi_div_up(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b <= 0) { ^ 0; };
  ?(a == 0) { ^ 0; };
  ?(bbi_muldiv_add_part(a, bbi_one(), 0, b, 2) == 1) { ^ 0; };
  q = bbi_muldiv_add_part(a, bbi_one(), 0, b, 0);
  r = bbi_muldiv_add_part(a, bbi_one(), 0, b, 1);
  ?(r == 0) { ^ q; };
  s = q + 1;
  ?(s < 0) { ^ 0; };
  ?(bbi_u_lt(s, q) == 1) { ^ 0; };
  ^ s;
}

!bbi_complement(x: int) -> int {
  ?(x < 0) { ^ 0; };
  ?(bbi_u_lt(x, bbi_one()) == 0) { ^ 0; };
  ^ bbi_one() - x;
}

!bbi_gcd(a: int, b: int) -> int {
  ?(a < 0) { ^ 0; };
  ?(b < 0) { ^ 0; };
  x = a;
  y = b;
  k = 0;
  while (y != 0) {
    ?(k >= 80) { ^ 0; };
    q = x / y;
    r = x - q * y;
    x = y;
    y = r;
    k = k + 1;
  };
  ^ x;
}

!bbi_pow_int_up(base: int, n: int) -> int {
  ?(base < 0) { ^ 0; };
  ?(n < 0) { ^ 0; };
  ?(n == 0) { ^ bbi_one(); };
  ?(n > 16) { ^ 0; };
  r = bbi_one();
  i = 0;
  while (i < n) {
    r = bbi_mul_up(r, base);
    i = i + 1;
  };
  ^ r;
}

!bbi_pow_int_down(base: int, n: int) -> int {
  ?(base < 0) { ^ 0; };
  ?(n < 0) { ^ 0; };
  ?(n == 0) { ^ bbi_one(); };
  ?(n > 16) { ^ 0; };
  r = bbi_one();
  i = 0;
  while (i < n) {
    r = bbi_mul_down(r, base);
    i = i + 1;
  };
  ^ r;
}

!bbi_nth_root_up(x: int, n: int) -> int {
  ?(x < 0) { ^ 0; };
  ?(n <= 1) { ^ x; };
  ?(n > 8) { ^ 0; };
  ?(x == 0) { ^ 0; };
  y = bbi_one();
  k = 0;
  done = 0;
  while (k < 32) {
    ?(done == 0) {
      ynm1 = bbi_pow_int_up(y, n - 1);
      ?(ynm1 == 0) { ^ 0; };
      term = bbi_div_up(x, ynm1);
      nxt = ((n - 1) * y + term) / n;
      ?(nxt == y) { done = 1; };
      ?(nxt != y) { y = nxt; };
    };
    k = k + 1;
  };
  k = 0;
  done = 0;
  while (k < 8) {
    ?(done == 0) {
      pdown = bbi_pow_int_down(y, n);
      ?(bbi_u_lt(pdown, x) == 0) {
        step = 0;
        ?(y > 0) {
          prev = bbi_pow_int_down(y - 1, n);
          ?(bbi_u_lt(prev, x) == 0) { y = y - 1; step = 1; };
        };
        ?(step == 0) { done = 1; };
      };
      ?(bbi_u_lt(pdown, x) == 1) {
        ?(y < 0) { ^ 0; };
        y = y + 1;
      };
    };
    k = k + 1;
  };
  ^ y;
}

!bbi_pow_fp_up(base: int, fp_exp: int) -> int {
  ?(base < 0) { ^ 0; };
  ?(fp_exp < 0) { ^ 0; };
  ?(fp_exp == 0) { ^ bbi_one(); };
  ?(fp_exp == bbi_one()) { ^ base; };
  g = bbi_gcd(fp_exp, bbi_one());
  ?(g == 0) { ^ 0; };
  num = fp_exp / g;
  den = bbi_one() / g;
  ?(num > 16) { ^ 0; };
  ?(den > 8) { ^ 0; };
  ?(den == 1) { ^ bbi_pow_int_up(base, num); };
  raised = bbi_pow_int_up(base, num);
  ^ bbi_nth_root_up(raised, den);
}

!bbi_token_in(bal: int, w: int, bpt_out: int, supply: int, fee: int) -> int {
  ?(bal <= 0) { ^ 0; };
  ?(w <= 0) { ^ 0; };
  ?(bbi_u_lt(w, bbi_one()) == 0) { ^ 0; };
  ?(supply <= 0) { ^ 0; };
  ?(bpt_out <= 0) { ^ 0; };
  ?(fee < 0) { ^ 0; };
  den = supply + bpt_out;
  ?(bbi_u_lt(den, supply) == 1) { ^ 0; };
  ir = bbi_div_up(den, supply);
  ?(bbi_u_lt(bbi_max_inv(), ir) == 1) { ^ 0; };
  exp = bbi_div_up(bbi_one(), w);
  br = bbi_pow_fp_up(ir, exp);
  ?(bbi_u_lt(bbi_one(), br) == 0) { ^ 0; };
  ain_nf = bbi_mul_up(bal, br - bbi_one());
  tax = bbi_mul_up(ain_nf, bbi_complement(w));
  ?(bbi_u_lt(ain_nf, tax) == 1) { ^ 0; };
  ntax = ain_nf - tax;
  cf = bbi_complement(fee);
  ?(cf <= 0) { ^ 0; };
  taxf = bbi_div_up(tax, cf);
  s = ntax + taxf;
  ?(bbi_u_lt(s, ntax) == 1) { ^ 0; };
  ^ s;
}

!bbi_naive_linear(bal: int, bpt_out: int, supply: int) -> int {
  ?(bal < 0) { ^ 0; };
  ?(bpt_out < 0) { ^ 0; };
  ?(supply <= 0) { ^ 0; };
  ^ bbi_muldiv_add_part(bal, bpt_out, 0, supply, 0);
}

!bbi_full_fee(bal: int, w: int, bpt_out: int, supply: int, fee: int) -> int {
  ?(bal <= 0) { ^ 0; };
  ?(w <= 0) { ^ 0; };
  ?(bbi_u_lt(w, bbi_one()) == 0) { ^ 0; };
  ?(supply <= 0) { ^ 0; };
  ?(bpt_out <= 0) { ^ 0; };
  den = supply + bpt_out;
  ?(bbi_u_lt(den, supply) == 1) { ^ 0; };
  ir = bbi_div_up(den, supply);
  ?(bbi_u_lt(bbi_max_inv(), ir) == 1) { ^ 0; };
  exp = bbi_div_up(bbi_one(), w);
  br = bbi_pow_fp_up(ir, exp);
  ?(bbi_u_lt(bbi_one(), br) == 0) { ^ 0; };
  ain_nf = bbi_mul_up(bal, br - bbi_one());
  cf = bbi_complement(fee);
  ?(cf <= 0) { ^ 0; };
  ^ bbi_div_up(ain_nf, cf);
}

!bbi_naive_i64_mul(a: int, b: int) -> int {
  ^ a * b;
}

!bbi_test_suite() -> int {
  e9 = 1000000000;
  bout = 100000000;
  w50 = 500000000;
  w80 = 800000000;
  w20 = 200000000;
  fee = 3000000;
  ?(bbi_mul_up(e9, e9) != e9) { ^ -1; };
  ?(bbi_div_up(e9 + bout, e9) != 1100000000) { ^ -2; };
  ?(bbi_token_in(e9, w50, bout, e9, 0) != 210000000) { ^ -3; };
  ?(bbi_token_in(e9, w50, bout, e9, fee) != 210315948) { ^ -4; };
  ?(bbi_token_in(e9, w80, bout, e9, 0) != 126525059) { ^ -5; };
  ?(bbi_token_in(e9, w20, bout, e9, 0) != 610510000) { ^ -6; };
  ?(bbi_token_in(e9, w80, bout, e9, fee) != 126601203) { ^ -7; };
  ?(bbi_token_in(e9, w50, 0, e9, 0) != 0) { ^ -8; };
  ?(bbi_pow_fp_up(1100000000, 2000000000) != 1210000000) { ^ -9; };
  ?(bbi_naive_linear(e9, bout, e9) != 100000000) { ^ -10; };
  ?(bbi_naive_i64_mul(2000000000000000, e9) != 4007528410413793280) { ^ -11; };
  ?(bbi_mul_down(2000000000000000, e9) != 2000000000000000) { ^ -12; };
  ?(bbi_logexp_claimed() != 0) { ^ -13; };
  ?(bbi_one_e18_fits() != 1) { ^ -14; };
  ?(bbi_array_join_claimed() != 0) { ^ -15; };
  ?(bbi_token_in(e9, w50, 2100000000, e9, 0) != 0) { ^ -16; };
  ?(bbi_gcd(800000000, e9) != 200000000) { ^ -17; };
  ?(bbi_full_fee(e9, w50, bout, e9, fee) != 210631896) { ^ -18; };
  ^ 1;
}

=ex{
  bbi_u_lt,
  bbi_u_add_carry,
  bbi_mask32,
  bbi_one,
  bbi_max_inv,
  bbi_one_e18_fits,
  bbi_logexp_claimed,
  bbi_array_join_claimed,
  bbi_muldiv_add_part,
  bbi_mul_down,
  bbi_mul_up,
  bbi_div_up,
  bbi_complement,
  bbi_gcd,
  bbi_pow_int_up,
  bbi_pow_int_down,
  bbi_nth_root_up,
  bbi_pow_fp_up,
  bbi_token_in,
  bbi_naive_linear,
  bbi_full_fee,
  bbi_naive_i64_mul,
  bbi_test_suite
}
