& opts.__stubNames.has(fn.name)) {\n      fnLines.push(`pub fn ${safeEmitId(snakeCase(fn.name))}() i64 { @panic(\"${fn.name}: js_runtime_only\"); }`);\n      continue;\n    }\n    if (/\\bcache\\b/.test(stmtsText(fn))) needsCache = true;\n    emitZigFn(fnLines, fn);\n  }\n  const lines = ['// generated by lin-rewrite → zig'];\n  lines.push('const std = @import(\"std\");');\n  lines.push('pub var LIA_ALLOC: std.mem.Allocator = undefined;');\n  lines.push('');\n  lines.push(ZIG_RUNTIME);\n  if (prog.consts) {\n    for (const [k, v] of Object.entries(prog.consts)) lines.push(`const ${safeEmitId(k)}: i64 = ${Number(v)};`);\n  }\n  if (needsCache) {\n    lines.push('var cache = [_][]const u8{ \"\", \" \", \"  \", \"   \", \"    \", \"     \", \"      \", \"       \", \"        \", \"         \" };');\n  }\n  lines.push('');\n  lines.push(...fnLines);\n  void opts;\n  return lines.join('\\n');\n}\n\nconst ZIG_RUNTIME = `fn _lia_str(x: anytype) []const u8 {\n    const T = @TypeOf(x);\n    if (T == []const u8) return x;\n    if (T == []u8) return x;\n    if (T == bool) return if (x) \"true\" else \"false\";\n    return switch (@typeInfo(T)) {\n        .int, .comptime_int => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        .float, .comptime_float => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        else => \"\",\n    };\n}\npub fn _lia_cat(a: anytype, b: anytype) []const u8 {\n    return std.mem.concat(LIA_ALLOC, u8, &.{ _lia_str(a), _lia_str(b) }) catch \"\";\n}\nfn _lia_eqs(a: []const u8, b: []const u8) bool {\n    return std.mem.eql(u8, a, b);\n}\nfn _lia_len(x: anytype) i64 {\n    const T = @TypeOf(x);\n    if (T == []const u8 or T == []u8) return @as(i64, @intCast(x.len));\n    return 0;\n}\nfn _lia_char_at(s: []const u8, i: i64) []const u8 {\n    const idx = @as(usize, @intCast(i));\n    if (idx < s.len) return s[idx .. idx + 1];\n    return \"\";\n}\nfn _lia_char_code_at(s: []const u8, i: i64) i64 {\n    const idx = @as(usize, @intCast(i));\n    if (idx < s.len) return @as(i64, s[idx]);\n    return 0;\n}`;\n\nfunction zigType(t) {\n  if (t === '@str') return '[]const u8';\n  if (t === '@bool') return 'bool';\n  switch (normType(t)) {\n    case 'int': return 'i64';\n    case 'float': return 'f64';\n    case 'string': return '[]const u8';\n    case 'bool': return 'bool';\n    default: return 'i64';\n  }\n}\n\nfunction zigZero(t) {\n  switch (zigType(t)) {\n    case 'f64': return '0.0';\n    case '[]const u8': return '\"\"';\n    case 'bool': return 'false';\n    default: return '0';\n  }\n}\n\nfunction retIsStringy(fn) {\n  const text = stmtsText(fn);\n  const rets = text.match(/\\breturn\\s+([^;{}]+)/g) || [];\n  return rets.some((rr) => rr.includes('\"') || rr.includes(\"'\") || /_lia_cat/.test(rr));\n}\n\nfunction emitZigFn(lines, fn) {\n  prepareNativeFn(fn);\n  const strP = new Set(strParamNames(fn));\n  const isBool = retIsBool(fn);\n  const ps = paramList(fn);\n  for (const p of ps) {\n    if (strP.has(p.name)) p.type = '@str';\n    else if (!p.type || p.type === 'any') p.type = 'int';\n  }\n  const sig = ps.map((p) => `${safeEmitId(p.name)}: ${zigType(p.type)}`).join(', ');\n  let retT = fn.returnType ? zigType(fn.returnType.replace(/^[^A-Za-z]+/, '')) : null;\n  if (!retT && isBool) retT = 'bool';\n  if (!retT && retIsStringy(fn)) retT = '[]const u8';\n  if (!retT) retT = zigType(ps[0] ? ps[0].type : 'int');\n  const stringIds = new Set();\n  for (const p of ps) if (zigType(p.type) === '[]const u8') stringIds.add(p.name);\n  const ctx = { stringIds, params: ps };\n  lines.push(`pub fn ${safeEmitId(snakeCase(fn.name))}(${sig}) ${retT} {`);\n  const locals = new Set();\n  for (const st of fn.body) collectLocalsGo(st, locals, ps.map((p) => p.name));\n  const bodyRaw = zigStmts(fn.body, 1, ctx);\n  for (const p of ps) {\n    const pId = safeEmitId(p.name);\n    const reUsed = new RegExp(`\\\\b${pId}\\\\b`, 'm');\n    if (!reUsed.test(bodyRaw)) {\n      lines.push(`    _ = ${pId};`);\n    }\n  }\n  for (const l of locals) {\n    let t = 'i64';\n    const reAssign = new RegExp(`\\\\b${l}\\\\b\\\\s*=\\\\s*([^;\\\\n]+)`, 'm').exec(bodyRaw);\n    if (reAssign && /\"|_lia_cat\\(|String\\(/.test(reAssign[1])) t = '[]const u8';\n    else if (reAssign && /^(true|false)\\b/.test(reAssign[1].trim())) t = 'bool';\n    if (t === '[]const u8' || t === '') {} \n    const sid = safeEmitId(l);\n    if (t === '[]const u8') ctx.stringIds.add(l);\n    lines.push(`    var ${sid}: ${t} = ${t === '[]const u8' ? '\"\"' : t === 'bool' ? 'false' : '0'};`);\n  }\n  lines.push(bodyRaw);\n  lines.push('}');\n  lines.push('');\n}\n\nfunction zigIndent(d) {\n  return '    '.repeat(d);\n}\n\nfunction zigStmts(stmts, depth, ctx) {\n  const out = [];\n  const pad = zigIndent(depth);\n  for (const st of stmts) {\n    switch (st.type) {\n      case 'return':\n        out.push(`${pad}return ${zigExpr(zigRaw(st.expr), ctx)};`);\n        break;\n      case 'throw':\n        out.push(`${pad}@panic(${zigExpr(zigRaw(st.expr), ctx)});`);\n        break;\n      case 'break':\n        out.push(`${pad}break;`);\n        break;\n      case 'continue':\n        out.push(`${pad}continue;`);\n        break;\n      case 'assign':\n        out.push(`${pad}${safeEmitId(st.idPath)} ${st.op} ${stripDeclKw(zigExpr(zigRaw(st.rhs), ctx))};`);\n        break;\n      case 'expr':\n        out.push(`${pad}_ = ${stripDeclKw(zigExpr(zigRaw(st.expr), ctx))};`);\n        break;\n      case 'if': {\n        out.push(`${pad}if (${zigCond(st.cond, ctx)}) {`);\n        out.push(zigStmts(st.then, depth + 1, ctx));\n        for (const ei of st.elseIf || []) {\n          out.push(`${pad}} else if (${zigCond(ei.cond, ctx)}) {`);\n          out.push(zigStmts(collectChainBodies(ei), depth + 1, ctx));\n        }\n        if (st.else) {\n          out.push(`${pad}} else {`);\n          out.push(zigStmts(normalizeElse(st.else), depth + 1, ctx));\n        }\n        out.push(`${pad}}`);\n        break;\n      }\n      case 'for': {\n        const initM = st.init.match(/^([A-Za-z_$][\\w$]*)\\s*=\\s*([\\s\\S]+)$/);\n        const stepM = st.step.match(/^([A-Za-z_$][\\w$]*)\\s*(\\+\\+|--)$/);\n        if (initM) out.push(`${pad}var ${safeEmitId(initM[1])}: i64 = ${zigExpr(initM[2], ctx)};`);\n        const cont = stepM ? ` : (${safeEmitId(stepM[1])} ${stepM[2] === '++' ? '+=' : '-='} 1)` : '';\n        out.push(`${pad}while (${zigCond(st.cond, ctx)})${cont} {`);\n        out.push(zigStmts(st.body, depth + 1, ctx));\n        if (!stepM && st.step.trim()) out.push(`${pad}    ${zigExpr(st.step, ctx)};`);\n        out.push(`${pad}}`);\n        break;\n      }\n      case 'while':\n        out.push(`${pad}while (${zigCond(st.cond, ctx)}) {`);\n        out.push(zigStmts(st.body, depth + 1, ctx));\n        out.push(`${pad}}`);\n        break;\n      case 'match': {\n        const target = safeEmitId(zigRaw(st.target).trim());\n        for (let idx = 0; idx < st.arms.length; idx++) {\n          const arm = st.arms[idx];\n          const cond = zigArmCond(target, arm.pat, arm.guard, ctx);\n          if (idx === 0) out.push(`${pad}if (${cond}) {`);\n          else out.push(`${pad}} else if (${cond}) {`);\n          out.push(zigStmts(arm.body, depth + 1, ctx));\n        }\n        out.push(`${pad}}`);\n        break;\n      }\n      default:\n        throw new EmitUnsupportedError(`zig stmt ${st.type}`);\n    }\n  }\n  return out.join('\\n');\n}\n\nfunction zigArmCond(target, pat, guard, ctx) {\n  if (pat === '_') return guard ? guard : 'true';\n  let base = `${zigEqFold(target, pat.trim(), '==', ctx)}`;\n  if (guard) base += ` and (${guard})`;\n  return base;\n}\n\nfunction zigCond(cond, ctx) {\n  let s = zigExpr(zigRaw(cond), ctx);\n  if (/^(true|false)$/.test(s.trim())) return s.trim();\n  return s;\n}\n\nfunction zigRaw(expr) {\n  return expr && expr.parts\n    ? expr.parts.map((p) => (p.kind === 'raw' ? p.text : zigInline(p.node))).join(' ')\n    : String(expr ?? '');\n}\n\nfunction zigInline(node) {\n  throw new EmitUnsupportedError(`zig inline ${node.kind}`);\n}\n\nfunction inlineErr(target, node) {\n  const tag = node && node.kind === 'regex' ? 'regex (LIN_REGEX_001: backend pendente; subconjunto portável roadmap)' : node && node.kind;\n  return new EmitUnsupportedError(`${target} inline ${tag}`);\n}\n\nfunction isStrLit(t) {\n  return /^\"[^\"]*\"$/.test(String(t || '').trim());\n}\n\nfunction zigEqFold(a, b, op, ctx) {\n  const A = String(a).trim();\n  const B = String(b).trim();\n  const strA = isStrLit(A) || ctx.stringIds.has(A.replace(/^\\(|\\)$/g, '')) || /^[A-Za-z_][\\w]*$/.test(A) && !/^(\\d|0x)/.test(A) && ctx.stringIds.has(A);\n  const strB = isStrLit(B) || ctx.stringIds.has(B.replace(/^\\(|\\)$/g, '')) || /^[A-Za-z_][\\w]*$/.test(B) && !/^(\\d|0x)/.test(B) && ctx.stringIds.has(B);\n  if ((isStrLit(A) || ctx.stringIds.has(A)) && (isStrLit(B) || ctx.stringIds.has(B))) {\n    const eq = `_lia_eqs(${A}, ${B})`;\n    return op === '!=' ? `!(${eq})` : eq;\n  }\n  void strA; void strB;\n  return `${A} ${op} ${B}`;\n}\n\nexport function zigExpr(text, ctx) {\n  let s = String(text);\n  s = s.replace(/([A-Za-z_$][\\w$]*)\\.charCodeAt\\(([^()]*)\\)/g, '@as(i64, $1[$2])');\n  s = s.replace(/([A-Za-z_$][\\w$]*)\\.length\\b/g, '@as(i64, @intCast($1.len))');\n  s = s.replace(/String\\(([A-Za-z_$][\\w$]*)\\)/g, '$1');\n  s = s.replace(/\\bMath\\.abs\\(/g, '@abs(');\n  s = s.replace(/\\bMath\\.round\\s*\\(\\s*([\\s\\S]+?)\\s*\\/\\s*([\\s\\S]+?)\\s*\\)/g, '@divTrunc($1, $2)');\n  s = s.replace(/\\bMath\\.floor\\(/g, '@divTrunc(');\n  s = s.replace(/JSON\\.stringify\\(([^()]*)\\)/g, '$1');\n  s = s.replace(/===/g, '==').replace(/!==/g, '!=');\n  s = s.replace(/\\btrue\\b/g, 'true').replace(/\\bfalse\\b/g, 'false');\n  s = s.replace(/\\bnull\\b|\\bundefined\\b/g, '\"\"');\n  s = s.replace(/\\?(?!=)/g, '');\n  s = s.replace(/&&/g, ' and ').replace(/\\|\\|/g, ' or ');\n  s = s.replace(/([\\w.\"']+)\\s*%\\s*([\\w.\"']+)/g, '@rem($1, $2)');\n  s = s.replace(/([\\w.\"']+)\\s*\\/\\s*([\\w.\"']+)/g, '@divTrunc($1, $2)');\n  // string-aware equality rewrite\n  let prevEq;\n  do {\n    prevEq = s;\n    s = s.replace(/([\\w.\"']+)\\s*(==|!=)\\s*([\\w.\"']+)/g, (m, a, op, b) => {\n      if (op !== '==' && op !== '!=') return m;\n      const litSide = isStrLit(a) || isStrLit(b);\n      const idSide = ctx.stringIds.has(a) || ctx.stringIds.has(b);\n      if (!litSide && !idSide) return m;\n      return zigEqFold(a, b, op, ctx);\n    });\n  } while (s !== prevEq);\n  // concat fold: X + Y where either side is a string literal or known string id\n  let prevCat;\n  do {\n    prevCat = s;\n    s = s.replace(/([\\w.\"'@()\\[\\]]+(?:\\([^()]*\\))?)\\s*\\+\\s*([\\w.\"'@()\\[\\]]+(?:\\([^()]*\\))?)/g, (m, a, b) => {\n      const strish = isStrLit(a) || isStrLit(b) || ctx.stringIds.has(a) || ctx.stringIds.has(b) || /_lia_cat\\(/.test(a) || /_lia_cat\\(/.test(b) || /@divTrunc\\(/.test(a) || /@divTrunc\\(/.test(b);\n      if (!strish) return m;\n      return `_lia_cat(${a}, ${b})`;\n    });\n  } while (s !== prevCat);\n  return s;\n}\n"}
