~METADATA{original="results/phase4_zig_backend/lin_test_module.zig" ext=".zig"}
.source{content="// generated by lin-rewrite → zig\nconst std = @import(\"std\");\npub var LIA_ALLOC: std.mem.Allocator = undefined;\n\nfn _lia_str(x: anytype) []const u8 {\n    const T = @TypeOf(x);\n    if (T == []const u8) return x;\n    if (T == []u8) return x;\n    if (T == bool) return if (x) \"true\" else \"false\";\n    return switch (@typeInfo(T)) {\n        .int, .comptime_int => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        .float, .comptime_float => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        else => \"\",\n    };\n}\npub fn _lia_cat(a: anytype, b: anytype) []const u8 {\n    return std.mem.concat(LIA_ALLOC, u8, &.{ _lia_str(a), _lia_str(b) }) catch \"\";\n}\nfn _lia_eqs(a: []const u8, b: []const u8) bool {\n    return std.mem.eql(u8, a, b);\n}\n\npub fn add(a: i64, b: i64) i64 {\n    return a + b;\n}\n\npub fn fact(n: i64) i64 {\n    if (n <= 1) {\n        return 1;\n    }\n    return n * fact(n - 1);\n}\n\npub fn is_ident_start(c: i64) bool {\n    if ((c >= 65  and  c <= 90)  or  (c >= 97  and  c <= 122)  or  c == 95  or  c == 36) {\n        return true;\n    }\n    return false;\n}\n\n\npub fn main() !void {\n    var gpa = std.heap.GeneralPurposeAllocator(.{}){};\n    defer _ = gpa.deinit();\n    LIA_ALLOC = gpa.allocator();\n\n    const sum = add(40, 2);\n    std.debug.assert(sum == 42);\n\n    const f5 = fact(5);\n    std.debug.assert(f5 == 120);\n\n    const is_valid_a = is_ident_start(65); // 'A'\n    std.debug.assert(is_valid_a == true);\n\n    const is_valid_digit = is_ident_start(48); // '0'\n    std.debug.assert(is_valid_digit == false);\n\n    const stdout = std.io.getStdOut().writer();\n    try stdout.print(\"ZIG_VERIFIED: sum={d} fact={d} valid_A={} valid_0={}\\n\", .{ sum, f5, is_valid_a, is_valid_digit });\n}\n"}
