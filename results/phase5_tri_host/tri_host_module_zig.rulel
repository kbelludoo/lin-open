~METADATA{original="results/phase5_tri_host/tri_host_module.zig" ext=".zig"}
.source{content="// generated by lin-rewrite → zig\nconst std = @import(\"std\");\npub var LIA_ALLOC: std.mem.Allocator = undefined;\n\nfn _lia_str(x: anytype) []const u8 {\n    const T = @TypeOf(x);\n    if (T == []const u8) return x;\n    if (T == []u8) return x;\n    if (T == bool) return if (x) \"true\" else \"false\";\n    return switch (@typeInfo(T)) {\n        .int, .comptime_int => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        .float, .comptime_float => std.fmt.allocPrint(LIA_ALLOC, \"{d}\", .{x}) catch \"\",\n        else => \"\",\n    };\n}\npub fn _lia_cat(a: anytype, b: anytype) []const u8 {\n    return std.mem.concat(LIA_ALLOC, u8, &.{ _lia_str(a), _lia_str(b) }) catch \"\";\n}\nfn _lia_eqs(a: []const u8, b: []const u8) bool {\n    return std.mem.eql(u8, a, b);\n}\n\npub fn collatz(n: i64) i64 {\n    var count: i64 = 0;\n    var cur: i64 = 0;\n    count = 0;\n    cur = n;\n    while (cur > 1) {\n        if (@rem(cur, 2) == 0) {\n            cur = @divTrunc(cur, 2);\n        } else {\n            cur = 3 * cur + 1;\n        }\n        count = count + 1;\n    }\n    return count;\n}\n\npub fn power(base: i64, exp: i64) i64 {\n    var res: i64 = 0;\n    var i: i64 = 0;\n    res = 1;\n    i = 0;\n    while (i < exp) {\n        res = res * base;\n        i = i + 1;\n    }\n    return res;\n}\n\n\npub fn main() !void {\n    var gpa = std.heap.GeneralPurposeAllocator(.{}){};\n    defer _ = gpa.deinit();\n    LIA_ALLOC = gpa.allocator();\n\n    const c27 = collatz(27);\n    const p10 = power(2, 10);\n    std.debug.assert(c27 == 111);\n    std.debug.assert(p10 == 1024);\n\n    const stdout = std.io.getStdOut().writer();\n    try stdout.print(\"ZIG_VERIFIED: collatz={d} power={d}\\n\", .{ c27, p10 });\n}\n"}
