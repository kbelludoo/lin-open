.source{content="// generated by lin-rewrite → rust\n#![allow(dead_code, unused_variables, unused_mut)]\n\npub fn collatz(n: i64) -> i64 {\n    let mut count = 0; let mut cur = 0;\n    count = 0;\n    cur = n;\n    while cur > 1 {\n        if cur % 2 == 0 {\n            cur = cur / 2;\n        } else {\n            cur = 3 * cur + 1;\n        }\n        count = count + 1;\n    }\n    return count;\n}\n\npub fn power(base: i64, exp: i64) -> i64 {\n    let mut res = 0; let mut i = 0;\n    res = 1;\n    i = 0;\n    while i < exp {\n        res = res * base;\n        i = i + 1;\n    }\n    return res;\n}\n\n\nfn main() {\n    let c27 = collatz(27);\n    let p10 = power(2, 10);\n    assert_eq!(c27, 111);\n    assert_eq!(p10, 1024);\n    println!(\"RUST_VERIFIED: collatz={} power={}\", c27, p10);\n}\n"}
