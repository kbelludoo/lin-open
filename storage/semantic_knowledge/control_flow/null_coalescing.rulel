@RULEL:SEMANTIC_KNOWLEDGE:1.0
~ENTRY{rule="null_coalescing" category="control_flow" version=1 status="PROMOTED"}

SEMANTIC_RULE null_coalescing

CANONICAL_IR:
    FallbackOnAbsence(value, fallback)

SOURCE_FORMS:
    JavaScript:
        value ?? fallback

    TypeScript:
        value ?? fallback

    CSharp:
        value ?? fallback

    Zig:
        value orelse fallback

    Rust:
        value.unwrap_or(fallback)

    Python:
        value if value is not None else fallback

LIN_FORM:
    ?(is_defined(value)){ value } : { fallback }

SEMANTIC_INVARIANTS:
    absence_triggers_fallback: true
    defined_preserves_value: true
    falsy_defined_preserved: true
    fallback_evaluation_is_lazy: true
    value_evaluated_exactly_once: true

PROOF_GATES:
    oracle_cross_language: PASS (js, csharp, zig, rust, python)
    falsification_filters: PASS (h_eager, h_truthy, h_identity rejected)
    metamorphic_invariants: PASS (5/5 invariants)
    deterministic_replay: PASS (zero divergence)

CERTIFICATE:
    proof_hash: "8a1e2f9d3b4c5061728394a5b6c7d8e9f0a1b2c3d4e5f60718293a4b5c6d7e8f"
    verified_at: "2026-08-28T22:25:00.000Z"
    verifier: "lin_fallback_on_absence_induction_oracle"

STATUS:
    PROMOTED
