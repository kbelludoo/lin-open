@INVARIANTS {
  description: "Invariants derived from experimental evidence. These are mandatory constraints on LIN design."

  @INV001 {
    id: "OPERATOR_SEMANTIC_EXPLICITNESS_REQUIRED"
    derived_from: "K045"
    statement: "LIN must represent operator semantics explicitly with runtime contracts. ROUND(x) must specify strategy=bankers|ieee754|toward_positive_infinity. LIN cannot assume identical operator behavior across target runtimes."
    scope: "all_cross_language_compilation"
    enforcement: "LIN-IR must reject operators without explicit semantic_contract annotation when emitting to multiple targets"
  }

  @INV002 {
    id: "OPERATOR_NORMALIZATION_LAYER_REQUIRED"
    derived_from: "K047"
    statement: "LIN must normalize operators to canonical semantic form before emitting to target. round(-1.5) in Python must become ROUND(value, strategy=bankers) in LIN, then emit as Python-native round() or JS-native custom function depending on target."
    scope: "cross_language_emission"
    enforcement: "LIN emitter must map canonical operator to target-native implementation; cannot blindly copy AST"
  }

  @INV003 {
    id: "ROUND_TRIP_SEMANTIC_CONSERVATION"
    derived_from: "K045 analysis"
    statement: "Given source program P: Transform P → LIN → Target → LIN. Requirement: Intent(P) == Intent(recovered(P)). A true semantic IR conserves intent through foreign runtime passage."
    scope: "IR_fidelity_test"
    enforcement: "If Intent(P) ≠ Intent(recovered(P)), LIN is a transpiler, not a semantic compiler. Drift must be measured, not just detected."
    metric: "SEMANTIC_DRIFT_SCORE = distance(original_intent, recovered_intent)"
  }

  @INV004 {
    id: "FALSE_POSITIVE_DECOMPOSITION"
    derived_from: "K056 analysis"
    statement: "For model-based agents, FPR must decompose into: (1) analytical_fp (true error), (2) exploration_candidate (correct safety classification), (3) benign_flow (correct behavior modeling). Only analytical_fp counts as agent error. Standard FPR conflates 'I was wrong' with 'I found something safe'."
    scope: "metric_design"
    enforcement: "When evaluating model-based analysis agents, report analytical_fpr separately from exploration_fpr. Acceptance criteria should target analytical_fpr, not total_fpr."
    metric: "ANALYTICAL_FPR = analytical_fp / (confirmed + analytical_fp)"
  }
}

