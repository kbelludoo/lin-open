  @K054 {
    honesty: INFERRED
    fact: "Flow Discovery Recall separates discovery failure from reasoning failure. Discovery failure: source → ??? → sink (agent didn't find the flow). Reasoning failure: source → transform → sink (agent found the flow but didn't classify as risk). Low FDR = modeling problem. High FDR + low Finding Recall = reasoning problem."
    source: "V4-B.1 protocol design"
    type: "diagnostic_framework"
    metric: {
      name: "flow_discovery_recall"
      formula: "discovered_flows / oracle_flows"
