        name: "system_model_construction"
        output: "sources, sinks, flows, trust boundaries"
        metric: "flow_discovery_recall"
      }
      phase_2: {
        name: "probe_execution_on_graph"
        output: "risk candidates with path, boundary, missing guard"
        metric: "intervention_precision"
      }
      phase_3: {
        name: "intervention_decision"
        output: "CONFIRMED / FALSE_POSITIVE / NEEDS_REVIEW"
        metric: "finding_recall"
      }
    }
    frozen_protocol: {
      repository: "axios@v1.14.0"
      oracle: "v4_b_oracle.json"
      vulnerability_classes: "7 classes"
      trust_model_schema: "v4_b1_trust_boundary_model.json"
      forbidden: "adding_bug_specific_rules"
    }
    evolution_stage: "operational_model_before_intervention"
  }

  @K055 {
    honesty: OBSERVED
    fact: "V4-B.1 system-model-driven analysis achieves perfect recall (1.00) and oracle precision (1.00) on axios@v1.14.0. All 12 oracle bugs confirmed. flow_discovery_recall = 1.00 (7/7 oracle flows discovered). Overall precision across all findings = 0.67 (14 confirmed / 24 total). 8 false positives from non-oracle flows — legitimate safety classifications of extra system model flows."
    source: "V4-B.1 execution on axios@v1.14.0"
    type: "benchmark_result"
    metrics: {
      flow_discovery_recall: 1.00
      oracle_precision: 1.00
      oracle_recall: 1.00
      overall_precision: 0.67
      false_positive_rate: 0.33
      confirmed_findings: 14
      false_positive_findings: 8
      needs_review_findings: 3
      oracle_bugs_confirmed: 12
      oracle_bugs_missed: 0
    }
    comparison_with_v4b: {
      v4b_recall: 0.58
      v4b1_recall: 1.00
      v4b_oracle_precision: 0.78
      v4b1_oracle_precision: 1.00
      improvement: "system model approach found all flows that V4-B missed"
    }
    root_cause: "V4-B analyzed files by pattern interest; V4-B.1 analyzed by trust boundary traversal. System model forced coverage of all data paths."
    scenario: "A"
    evolution_stage: "modeling_complete_reasoning_tested"
  }

  @K056 {
    honesty: OBSERVED
    fact: "FPR in V4-B.1 is inflated by mixing three distinct categories: (1) analytical_fp = risk declared without evidence (true error), (2) exploration_candidate = flow found, risk discarded (correct classification), (3) benign_flow = legitimate behavior modeled (correct classification). Categories 2 and 3 are not errors — they are the agent correctly identifying that a flow is safe. A human engineer also finds paths that are not bugs."
    source: "User analysis of V4-B.1 FPR=0.33"
    type: "metric_refinement"
    fp_split: {
      analytical_fp: "risk declared without evidence — true error"
      exploration_candidate: "flow found, risk discarded — correct classification"
      benign_flow: "legitimate behavior modeled — correct classification"
    }
    implication: "Standard precision/FPR metrics conflate 'I was wrong' with 'I found something safe'. For model-based agents, FPR should exclude exploration_candidate and benign_flow."
    v4_b1_reclassification: {
      analytical_fp: 0
      exploration_candidate: 3
      benign_flow: 5
      adjusted_fpr: "0.00 (no analytical errors)"
    }
  }

  @K057 {
    honesty: INFERRED
    fact: "The V4-B → V4-B.1 jump shows the bottleneck was not reasoning capacity but absence of adequate intermediate representation. Pattern detection cannot discover flows it doesn't trace. System model provides the missing representation. This suggests future metrics should measure System Understanding, not just bug detection."
    source: "User analysis of V4-B vs V4-B.1 architecture"
    type: "architectural_insight"
    proposed_metric: {
      name: "System_Understanding_Score"
      components: {
        flow_reconstruction: "discovered_expected_flows / oracle_expected_flows"
        risk_classification: "correctly_classified_flows / analyzed_flows"
        intervention_quality: "accepted_actions / proposed_actions"
      }
    }
    baseline_architecture: {
      v4_b: "pattern_detection → finding → decision"
      v4_b1: "system_model → source/sink/trust_boundary_graph → flow_analysis → risk_classification → decision"
    }
    conclusion: "V4-B.1 demonstrates the agent transitioned from pattern matching to model-based analysis. The next test is whether the model supports generalization to unseen vulnerability classes."
  }

  @K058 {
    honesty: OBSERVED
    fact: "V4-C UNKNOWN FLOW GENERALIZATION: Agent found ReDoS (CVE-2024-45296) in path-to-regexp@6.3.0 — a vulnerability class NEVER seen in V4-B training. Generalization score = 1.00. The agent identified the root cause (negative lookahead + lazy quantifier = exponential backtracking) through pure system model analysis without any vulnerability-specific rules. This confirms the agent transitioned from pattern matching to model-based analysis."
    source: "V4-C execution on path-to-regexp@6.3.0"
    type: "benchmark_result"
    metrics: {
      generalization_score: 1.00
      oracle_recall: 1.00
      analytical_precision: 1.00
      analytical_fpr: 0.00
      novel_vulnerability_class: "redos"
      overlap_with_v4b: "NONE"
    }
    key_finding: "Agent identified TB-1 (path → regex structure) and TB-2 (pathname → regex execution time) as critical trust boundaries. Missing guard: safePattern() does not analyze computational complexity of generated regex."
    scenario: "A"
    evolution_stage: "generalization_confirmed"
  }
}

