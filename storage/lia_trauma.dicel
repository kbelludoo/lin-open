  }
  @E003 {
    class: ARROW_EXTRACT_OVERREAD
    severity: MED
    observed: "clone-lia dayjs utils: arrow expr body ate following const/export until fixed"
    symptom: "absFloor/isUndefined bodies included prettyUnit/export default"
