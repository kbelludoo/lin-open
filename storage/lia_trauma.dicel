    status: FIXED_IN_EMITTER
  }
  @E004 {
    class: ASI_SEMICOLON_FREE
    severity: MED
    observed: "dayjs padStart style: newline if without ; → emit glued String(x)?(cond)"
    fix_applied: "applySourceSigils insert ; before if|for|return|const|let|var|else at line start"
    fix_target: compiler_not_lia
    status: FIXED_IN_EMITTER
    remaining: "template_literal still unsupported (honest skip)"
  }
}

