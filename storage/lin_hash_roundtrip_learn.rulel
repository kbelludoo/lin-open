@RULEL:LIN_HASH_ROUNDTRIP_LEARN:1.0.0
~R{.m=meta .l=learn .e=error .f=fix}
.m{date=2026-08-27 engine=lin_core_compiler.lin gate=compileLinToJs_sha256_16}
.l{
  P0="LIN_compiles_LIN"
  hash="sha256(compileLinToJs(stored.lin))==sha256(compileLinToJs(emit(original)))"
  host="one_bootstrap_extract_of_compiler.rulel_then_lin_core_compiler.lin_is_the_compiler"
}
.e{
  E1="emit_from_js threw top-level export|import|try|=>|comment"
  E2="module.exports=function Name skipped as exports so no functions found"
  E3="leftpad.lin was simplified rewrite not emit of index.js so compileLinToJs hash differed"
  E4="is-stream emit mangled destructuring {checkOpen} so stored compile hash != emit hash"
  E5="camelcase uses unicode regex + const arrows; skipStatement of => drops fns"
  E6="NO_ORIG for browser clones: .lin beside no sibling .js with same stem"
}
.f{
  F1="skip export except export function; skip import try class comments => punct"
  F2="module.exports=function continues at function token"
  F3="rewrite stored .lin from emit then verify compileLinToJs hash"
  F4="do_not_treat_lossy_hand_lin_as_PASS"
}
