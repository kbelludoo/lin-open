@DICEL:lia_hypotheses:0.2.0
^status=ACTIVE
^note="transferable Hypothesis records from learn loop"
^fix_target=compiler_not_lia

@ENTRIES {
  @H001 {
    from_trauma: [CLOSURE, HOLDING_GAP]
    claim: "preserve free-var / closure bindings when extracting public API fns to LIA AST+emit"
    measure: "lodash public-API suite pass count; must rise from 1/14 without soft_match"
    transfer: "any monolith with cross-fn free refs (lodash-shaped)"
    forbid: "mutate fixture LIA; weaken behavior_eq"
    status: OPEN
  }
  @H002 {
    from_trauma: [ARROW_EXTRACT_OVERREAD, ASI_SEMICOLON_FREE]
    claim: "arrow newline-bound + ASI before controls generalizes beyond dayjs utils"
    measure: "clone-lia transfer on other semicolon-free arrow-heavy libs"
    transfer: "underscore modules / dayjs plugins"
    status: APPLIED_PARTIAL
    evidence: "INTEL_CLONE_LIA_dayjs absFloor+isUndefined PASS"
  }
}

