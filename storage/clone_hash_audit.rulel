@RULEL:CLONE_HASH_AUDIT:1.1.0
~META{ts="2026-08-27T05:45:00Z" method="compileLinToJs_sha256_16 AND emitLinFromJs"}
.learn{
  E_ARROW_TOKEN: "lexer emits => as one punct; findArrowAfterParamsToks must match => not '=' then '>'"
  E_EXPORT_CONST: "export const foo = ... must not skipStatement from export or the fn is dropped"
  E_BARE_ARROW: "const f = x => body needs unparenthesized param path"
  E_MODULE_EXPORTS_FN: "module.exports = function name must rewind to function token"
  E_IF_WRAPPER: "inherits_browser wraps fns in if/else; enter { don't skip whole stmt"
  E_LOSSY_STUB: "hand-written O(n) leftpad/lodash/commander stubs fail code-hash vs originals"
  E_NON_JS: "C/Lua clones cannot use emitLinFromJs; pasted browser-use .lin is not a faithful emit"
  E_TS: "skip overload signatures ending in ; then emit implementation; skip leftover type ids"
  E_IIFE: "enter ;(function(){ as inner top-level; skip var=function IIFE assigns; skip leftover . ) ] punct"
  E_DESTRUCTURE: "normalizeParams must split commas at depth 0 and strip defaults only at depth 0"
  E_MIN_NO_FN: "min js/ files that only assign methods/exports without function keyword fail emitLinFromJs"
  E_LUA_END: "lua end/function depth walker can emit bodies whose compileLinToJs hash differs from in-memory string if trailing newline or nested end in strings"
  E_OBJ_KEY_IMPORT: "object key import: function was eaten by import skipStatement"
  E_ARROW_CALLBACK: "call-arg arrows: scan leftover id for => and parse params/body as _anonN"
  E_CLASS_METHOD: "class Foo { add(){} } requires enter class brace and id( as method"
  E_CHROME_STUB: "chrome_full_lin *.cc.lin were empty_module stubs; map name by split_ prefix dirs to chromium tree then transpileCToLin"
  E_MODULE_EXPORTS_OBJ: "module.exports = { initialize: function } must enter { not skipStatement"
}
