@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="package.json" lang="json"}
.source{content="{\n  \"name\": \"lin-lang\",\n  \"version\": \"2.0.0\",\n  \"description\": \"LIN — lingua ia nativa. Reescrita completa in-memory: lexer, parser, AST, multi-target emitters (js|ts|py|go|rust|c|java), verifier, RULEL, CLI.\",\n  \"type\": \"module\",\n  \"private\": false,\n  \"main\": \"build/runtime/compiler.mjs\",\n  \"bin\": {\n    \"lin\": \"./bin/lin.mjs\",\n    \"lia\": \"./bin/lia.mjs\",\n    \"ail\": \"./bin/ail.mjs\"\n  },\n  \"scripts\": {\n    \"test\": \"node test/run_all.mjs\",\n    \"emit\": \"node bin/lin.mjs emit\",\n    \"compile\": \"node bin/lin.mjs compile\",\n    \"check\": \"node bin/lin.mjs check\",\n    \"run\": \"node bin/lin.mjs run\",\n    \"hash\": \"node bin/lin.mjs hash\",\n    \"effects\": \"node bin/lin.mjs effects\",\n    \"verify\": \"node bin/lin.mjs verify\",\n    \"rulel-check\": \"node bin/lin.mjs rulel-check\",\n    \"clone-lin\": \"node bin/lin.mjs clone-lin\",\n    \"clone-lia\": \"node bin/lin.mjs clone-lin\",\n    \"improve\": \"node bin/lin.mjs improve\",\n    \"autonomy-status\": \"node bin/lin.mjs autonomy-status\",\n    \"ensure-toolchains\": \"node scripts/ensure_toolchains.mjs\",\n    \"example:safe\": \"node bin/lin.mjs compile examples/safe-compare.lia --target js -o examples/safe-compare.compiled.js\",\n    \"bootstrap\": \"node bootstrap_prelude.mjs\",\n    \"pretest\": \"npm run bootstrap\"\n  },\n  \"keywords\": [\n    \"lin\",\n    \"lia\",\n    \"ail\",\n    \"ai-native\",\n    \"ir\",\n    \"compiler\",\n    \"multi-emit\"\n  ],\n  \"license\": \"MIT\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/kbelludoo/lin.git\"\n  },\n  \"homepage\": \"https://github.com/kbelludoo/lin\",\n  \"bugs\": {\n    \"url\": \"https://github.com/kbelludoo/lin/issues\"\n  },\n  \"engines\": {\n    \"node\": \">=18\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^7.0.2\"\n  }\n}\n"}
