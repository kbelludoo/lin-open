@RULEL:LIN_GITIGNORE:1.0.0
~R{.m=meta .r=rules .p=path}
.m{purpose=replaces_.gitignore_eradicated rules_live_in=.git/info/exclude doctrine=only_lin_or_rulel_in_repo exception=kernel/}
.r{build=*.o!*.obj!*.pyc!__pycache__ exec=test_fib!test_hello!lin_cli!fibonacci dirs=build!dist!target!coverage!htmlcov!.cache deps=node_modules!venv!.venv env=.env!.env.* logs=*.log!*.tmp!*.swp editors=.vscode!.idea os=.DS_Store!Thumbs.db rust=lin_rust/target!Cargo.lock!*.rlib!*.dll!*.exe!*.pdb clones=clones_lin!clones_lin_generated state=.clone_lin_* scratch=scratch_audit.mjs!test_*.mjs!javac.*}
.p{canonical=.git/info/exclude note=git_requires_literal_gitignore_therefore_excludes_outside_worktree}
