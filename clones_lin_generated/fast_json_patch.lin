@LIN:L1c:0.2
^schema_once ^lossy=true
~G{?=if #=for ^=ret :else}

!applyPatch(document,patch){
let doc = deepClone(document);
#(i = 0; (i < patch.length); i++){
doc = applyOperation(doc,patch[i]);
};
^{"newDocument":doc};
}

!applyOperation(document,operation){
const op = operation.op;
const path = operation.path;
const val = operation.value;
?((path == "")){
?(((op == "add") || (op == "replace"))){
^val;
};
?((op == "remove")){
^null;
};
?((op == "test")){
?((!areEquals(document,val))){
throw new Error("Test failed");
};
^document;
};
^document;
};
const parts = path.split("/");
let cur = document;
#(i = 1; (i < (parts.length - 1)); i++){
const key = unescapePathComponent(parts[i]);
?(((typeof cur[key]) == "undefined")){
throw new Error(("Path not found: " + path));
};
cur = cur[key];
};
let lastKey = unescapePathComponent(parts[(parts.length - 1)]);
?(Array.isArray(cur)){
?((lastKey == "-")){
lastKey = cur.length;
}:{
?(isInteger(lastKey)){
lastKey = parseInt(lastKey,10);
};
};
};
?((op == "add")){
?(Array.isArray(cur)){
cur.splice(lastKey,0,deepClone(val));
}:{
cur[lastKey] = deepClone(val);
};
}:{
?((op == "replace")){
?((((typeof cur[lastKey]) == "undefined") && (!Array.isArray(cur)))){
throw new Error("Cannot replace non-existing key");
};
cur[lastKey] = deepClone(val);
}:{
?((op == "remove")){
?(Array.isArray(cur)){
cur.splice(lastKey,1);
}:{
(delete cur[lastKey]);
};
}:{
?((op == "move")){
const fromVal = getValueByPointer(document,operation.from);
?(((typeof fromVal) == "undefined")){
throw new Error(("From path not found: " + operation.from));
};
applyOperation(document,{"op":"remove","path":operation.from});
applyOperation(document,{"op":"add","path":path,"value":fromVal});
}:{
?((op == "copy")){
const fromVal = getValueByPointer(document,operation.from);
?(((typeof fromVal) == "undefined")){
throw new Error(("From path not found: " + operation.from));
};
applyOperation(document,{"op":"add","path":path,"value":deepClone(fromVal)});
}:{
?((op == "test")){
const existing = cur[lastKey];
?((!areEquals(existing,val))){
throw new Error(("Test operation mismatch at: " + path));
};
};
};
};
};
};
};
^document;
}

!getValueByPointer(document,pointer){
?(((pointer == "") || (pointer == "/"))){
^document;
};
const parts = pointer.split("/");
let cur = document;
#(i = 1; (i < parts.length); i++){
const key = unescapePathComponent(parts[i]);
?(((cur == null) || ((typeof cur) == "undefined"))){
^undefined;
};
cur = cur[key];
};
^cur;
}

!unescapePathComponent(path){
^path.replace(/~1/g,"/").replace(/~0/g,"~");
}

!isInteger(str){
?(((typeof str) == "number")){
^true;
};
?((((typeof str) != "string") || (str.length == 0))){
^false;
};
#(i = 0; (i < str.length); i++){
const code = str.charCodeAt(i);
?(((code < 48) || (code > 57))){
^false;
};
};
^true;
}

!deepClone(obj){
?(((obj == null) || ((typeof obj) != "object"))){
^obj;
};
^JSON.parse(JSON.stringify(obj));
}

!areEquals(a,b){
?(((typeof a) != (typeof b))){
^false;
};
?((a == b)){
^true;
};
?(((((a == null) || (b == null)) || ((typeof a) != "object")) || ((typeof b) != "object"))){
^false;
};
?((Array.isArray(a) != Array.isArray(b))){
^false;
};
?(Array.isArray(a)){
?((a.length != b.length)){
^false;
};
#(i = 0; (i < a.length); i++){
?((!areEquals(a[i],b[i]))){
^false;
};
};
^true;
};
const keysA = Object.keys(a);
const keysB = Object.keys(b);
?((keysA.length != keysB.length)){
^false;
};
#(i = 0; (i < keysA.length); i++){
const k = keysA[i];
?((((typeof b[k]) == "undefined") && ((typeof a[k]) != "undefined"))){
^false;
};
?((!areEquals(a[k],b[k]))){
^false;
};
};
^true;
}

=ex{applyPatch, applyOperation, getValueByPointer, unescapePathComponent, isInteger, deepClone, areEquals}