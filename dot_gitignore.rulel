@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original=".gitignore" ext=""}
.source{content="bootstrap_backup/\n\nbuild/\nzig-out/\n.zig-cache/\nnode_modules/\n\n# Host glue .mjs emitted from TRANSPOSED_SOURCE .rulel at bootstrap\nscripts/**/*.mjs\nbin/*.mjs\ntest/**/*.mjs\n!test/fixtures/**\ntests/**/*.mjs\nbenchmarks/**/*.mjs\nbenchmarks/**/*.cjs\nbenchmarks/**/*.ts\nbenchmarks/**/*.js\n\n# Phase-6: artifacts/ emit outputs (canonical = *.rulel + *.lin)\nartifacts/**/*.js\nartifacts/**/*.cjs\nartifacts/**/*.lia\n\n# Phase-6: examples/ + lin_rust/ LIA corpus + multi-emit outputs (canonical = *.lin + *.rulel)\nexamples/**/*.lia\nexamples/**/*.js\nexamples/**/*.ts\nexamples/**/*.cjs\nlin_rust/**/*.lia\nlin_rust/**/*.js\nlin_rust/**/*.ts\n\n# Phase-6: test/fixtures LIA + queue JS (canonical = *.lin + *_js.rulel / ~LANG .rulel)\ntest/fixtures/**/*.lia\ntest/fixtures/queue/**/*.js\n\n# Legacy v1 archive: TRANSPOSED_SOURCE .rulel mirrors only (exclusion zone, not bootstrap emit)\n_legacy_v1/**/*.mjs\n_legacy_v1/**/*.js\n_legacy_v1/**/*.ts\n_legacy_v1/**/*.cjs\n_legacy_v1/**/*.lia\n\n# POLYGLOT / emitted host sources (canonical = *.rulel)\n**/*.py\n!build/**\n\n# In-memory bootstrap seed (canonical = bootstrap_seed.rulel)\nbootstrap_seed.mjs\n\n# Cold-start bootstrap emit (canonical = *.rulel only)\nbootstrap_emit.mjs\nbootstrap_cold_start.mjs\nbootstrap_prelude.mjs\n\n# Host JSON emitted from *.rulel at bootstrap (repo is lin+rulel only)\n**/*.json\n!build/**/*.json\n\n# Phase 8: binaries and build artifacts (canonical = *.rulel mirrors + bootstrap emit)\n**/*.elf\n**/*.exe\n**/*.pdb\n**/*.rlib\n**/*.dll\nbin/lin_c1\nbin/lin_c2\nbin/lin_c3\nbin/lin_c4\nbin/lin_rust\nbin/lin_native\nbin/*.s\nkernel/*.s\nkernel/*.ld\nresults/**/tri_host_rust_bin\n\n# Phase 8: polyglot/doc sources emitted from TRANSPOSED_SOURCE .rulel at bootstrap\n**/*.md\n!build/**\n**/*.rs\n!build/**\n**/*.sh\n# bootstrap.sh: zero tracked host exceptions (see spec/LIN_REPO_PURITY_COLD_START.rulel).\n# Regenerated locally as a gitignored artifact from bootstrap_sh.rulel via the\n# documented one-liner; never tracked, no negation exception.\n**/*.cr\n**/*.nim\n**/*.ml\n**/*.pl\n**/*.zig\n**/*.go\n**/*.c\n!build/**\n**/*.java\n**/*.peg\n**/*.toml\n!build/**\n**/*.lock\n**/*.txt\n!build/**\n**/*.stdout\n**/*.stderr\n**/*.s\n**/*.ld\n**/*.yml\n**/*.editorconfig\n.gitignore\nLICENSE\nREADME.md\n.cursorrules\nrust\nmigrate_to_lin_core.sh\nspec/LIN_GRAMMAR.peg\nsrc_rust/**/*\nlin_crystal/**/*\nclones_lin/**/*\nbenchmarks/**/*.txt\nbenchmarks/**/*.exe\nbenchmarks/**/Cargo.lock\nbenchmarks/**/Cargo.toml\nbenchmarks/**/src/**/*\nbenchmarks/common/**/*\nbenchmarks/crystal/**/*\nbenchmarks/nim/**/*\nbenchmarks/ocaml/**/*\nbenchmarks/prolog/**/*\nbenchmarks/zig/**/*\nbenchmarks/real_repo_cross_language_01/**/*\nbenchmarks/repair_learning_02/**/*\nbenchmarks/v4_c_path_to_regexp/**/*\n!benchmarks/**/*.rulel\n!benchmarks/**/*.lin\n_legacy_v1/**/*.rs\n_legacy_v1/**/*.exe\n_legacy_v1/**/*.pdb\n_legacy_v1/**/*.rlib\n_legacy_v1/**/*.java\n_legacy_v1/**/*.ledger\n_legacy_v1/**/*.md\nexamples/.multi_emit_out/**/*\nartifacts/**/*.rs\nartifacts/**/*.exe\nartifacts/**/*.pdb\nartifacts/**/*.rlib\nartifacts/**/*.stdout\nartifacts/**/*.stderr\nartifacts/**/*.txt\n!artifacts/**/*.rulel\n!artifacts/**/*.lin\nlin_rust/**/*.rs\nlin_rust/**/Cargo.toml\n!lin_rust/**/*.rulel\n!lin_rust/**/*.lin/*.json\n"}
