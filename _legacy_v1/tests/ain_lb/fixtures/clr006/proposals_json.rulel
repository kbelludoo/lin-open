.source{content="{\n  \"proposals\": [\n    {\n      \"proposal_id\": \"baseline\",\n      \"hypothesis\": \"retain the current algorithm as the measured baseline\",\n      \"affected_modules\": [\"Transfer\"],\n      \"inferred_effects\": [\"pure\"],\n      \"required_caps\": [],\n      \"architecture_delta\": \"none\",\n      \"constraints_preserved\": true,\n      \"proof_status\": \"metadata_verified\"\n    },\n    {\n      \"proposal_id\": \"cache_memory\",\n      \"hypothesis\": \"cache repeated transfer lookups in bounded process memory\",\n      \"affected_modules\": [\"Transfer\"],\n      \"inferred_effects\": [\"memory\"],\n      \"required_caps\": [\"memory\"],\n      \"architecture_delta\": \"none\",\n      \"constraints_preserved\": true,\n      \"proof_status\": \"metadata_verified\"\n    },\n    {\n      \"proposal_id\": \"index_algorithm\",\n      \"hypothesis\": \"replace repeated linear lookup with an in-memory index\",\n      \"affected_modules\": [\"Transfer\", \"CountryLimits\"],\n      \"inferred_effects\": [\"pure\", \"memory\"],\n      \"required_caps\": [\"memory\", \"cpu\"],\n      \"architecture_delta\": \"none\",\n      \"constraints_preserved\": true,\n      \"proof_status\": \"metadata_verified\"\n    },\n    {\n      \"proposal_id\": \"parallelism\",\n      \"hypothesis\": \"parallelize independent FX and country policy reads\",\n      \"affected_modules\": [\"Transfer\", \"FX\", \"CountryLimits\"],\n      \"inferred_effects\": [\"pure\"],\n      \"required_caps\": [\"cpu\", \"concurrency\"],\n      \"architecture_delta\": \"none\",\n      \"constraints_preserved\": true,\n      \"proof_status\": \"metadata_verified\"\n    },\n    {\n      \"proposal_id\": \"persistent_cache\",\n      \"hypothesis\": \"persist cache entries across process restarts\",\n      \"affected_modules\": [\"Transfer\", \"Storage\"],\n      \"inferred_effects\": [\"io\"],\n      \"required_caps\": [\"io\", \"storage\"],\n      \"architecture_delta\": \"storage_dependency\",\n      \"constraints_preserved\": false,\n      \"proof_status\": \"unproven\"\n    }\n  ]\n}\n"}
