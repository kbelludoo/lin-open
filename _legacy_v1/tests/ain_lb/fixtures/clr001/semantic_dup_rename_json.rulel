.source{content="{\n  \"intent\": \"create_moveFunds\",\n  \"target\": \"Transfer\",\n  \"constraints\": [\"no_data_loss\"],\n  \"allowed_effects\": [\"memory\"],\n  \"create_fn\": {\n    \"name\": \"moveFunds\",\n    \"params\": \"from,to,amount\",\n    \"body\": \"?(needsApproval(amount)){^({ok:0,need:'approval'})};^({ok:1,from:from,to:to,amount:amount})\"\n  },\n  \"existing_fn\": {\n    \"name\": \"transfer\",\n    \"params\": \"from,to,amount\",\n    \"body\": \"?(needsApproval(amount)){^({ok:0,need:'approval'})};^({ok:1,from:from,to:to,amount:amount})\"\n  }\n}\n"}
