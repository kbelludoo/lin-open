~METADATA{original="_legacy_v1/tests/ain_lb/fixtures/clr005/competing_proposals.json" ext=".json"}
.source{content="{\n  \"ambiguity_id\": \"CLR-005-cache-performance\",\n  \"task\": \"add cache to improve performance\",\n  \"graph_reference\": \"../clr004/repo\",\n  \"artifacts_reference\": \"../clr004/wipe/context_artifacts.json\",\n  \"constraints\": {\n    \"allowed_effects\": [\"pure\", \"memory\"],\n    \"allowed_caps\": [\"memory\"],\n    \"architecture_approval\": false,\n    \"storage_io_approval\": false\n  },\n  \"proposals\": [\n    {\n      \"proposal_id\": \"local_memory\",\n      \"intent\": \"cache hot values locally\",\n      \"target_module\": \"Transfer\",\n      \"inferred_effects\": [\"memory\"],\n      \"required_caps\": [\"memory\"],\n      \"architecture_delta\": \"none\",\n      \"expected_decision\": \"ACCEPT\"\n    },\n    {\n      \"proposal_id\": \"persistent_storage\",\n      \"intent\": \"persist cache entries across process restarts\",\n      \"target_module\": \"Transfer\",\n      \"inferred_effects\": [\"io\"],\n      \"required_caps\": [\"io\", \"storage\"],\n      \"architecture_delta\": \"storage_dependency\",\n      \"expected_decision\": \"CONDITIONAL\"\n    },\n    {\n      \"proposal_id\": \"effect_escalation\",\n      \"intent\": \"add a cache while silently escalating local work to storage io\",\n      \"target_module\": \"Transfer\",\n      \"inferred_effects\": [\"memory\", \"io\"],\n      \"required_caps\": [\"memory\", \"io\"],\n      \"architecture_delta\": \"none\",\n      \"expected_decision\": \"DENIED\"\n    },\n    {\n      \"proposal_id\": \"wrong_module\",\n      \"intent\": \"add the cache to an unrelated audit module\",\n      \"target_module\": \"Audit\",\n      \"inferred_effects\": [\"memory\"],\n      \"required_caps\": [\"memory\"],\n      \"architecture_delta\": \"none\",\n      \"expected_decision\": \"DENIED\"\n    },\n    {\n      \"proposal_id\": \"new_module\",\n      \"intent\": \"create a dedicated cache module\",\n      \"target_module\": \"Cache\",\n      \"inferred_effects\": [\"memory\"],\n      \"required_caps\": [\"memory\"],\n      \"architecture_delta\": \"new_module\",\n      \"expected_decision\": \"CONDITIONAL\"\n    },\n    {\n      \"proposal_id\": \"local_memory_unpermitted\",\n      \"intent\": \"cache hot values locally without memory permission\",\n      \"target_module\": \"Transfer\",\n      \"inferred_effects\": [\"memory\"],\n      \"required_caps\": [\"memory\"],\n      \"architecture_delta\": \"none\",\n      \"expected_decision\": \"DENIED\"\n    }\n  ]\n}\n"}
