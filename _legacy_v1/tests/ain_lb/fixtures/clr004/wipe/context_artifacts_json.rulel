~METADATA{original="_legacy_v1/tests/ain_lb/fixtures/clr004/wipe/context_artifacts.json" ext=".json"}
.source{content="{\n  \"agent_ir\": {\n    \"intent\": \"add international payments with FX and country limits\",\n    \"target\": \"Transfer.international\",\n    \"constraints\": [\"authenticated\", \"country_allowed\", \"contract_preserved\"],\n    \"allowed_effects\": [\"io\"]\n  },\n  \"module_refs\": [\"Auth\", \"Storage\", \"Transfer\", \"Audit\", \"FX\", \"CountryLimits\"],\n  \"contracts\": {\n    \"Auth\": \"auth.verify_returns_identity\",\n    \"Storage\": \"storage.write_requires_io\",\n    \"Transfer\": \"transfer.authenticated_write\",\n    \"Audit\": \"audit.append_immutable\",\n    \"FX\": \"fx.quote_requires_supported_country\",\n    \"CountryLimits\": \"country_limits.allow_requires_policy\"\n  },\n  \"semantic_hashes\": {\n    \"Auth\": \"clr004-auth-v1\",\n    \"Storage\": \"clr004-storage-v1\",\n    \"Transfer\": \"clr004-transfer-v1\",\n    \"Audit\": \"clr004-audit-v1\",\n    \"FX\": \"clr004-fx-v1\",\n    \"CountryLimits\": \"clr004-country-limits-v1\"\n  },\n  \"effects\": {\n    \"Auth\": [\"pure\"],\n    \"Storage\": [\"io\"],\n    \"Transfer\": [\"io\"],\n    \"Audit\": [\"io\"],\n    \"FX\": [\"pure\"],\n    \"CountryLimits\": [\"pure\"]\n  }\n}\n"}
