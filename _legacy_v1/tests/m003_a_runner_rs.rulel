.source{content="// generated by lia multi-emit → rust\n#![allow(non_snake_case, unused_assignments, unused_variables, unused_parens, unused_mut, dead_code)]\nfn _lia_val(x: impl ToString) -> String { x.to_string() }\n\npub fn match_number(mut n: i64) -> String {\n    match n {\n        0 => {\n            return _lia_val(100);\n        }\n        1 => {\n            return _lia_val(200);\n        }\n        _ => {\n            return _lia_val(999);\n        }\n    }\n}\n\npub fn unwrap_option(opt: Option<i64>, default_val: i64) -> i64 {\n    match opt {\n        Some(v) => {\n            return v;\n        }\n        None => {\n            return default_val;\n        }\n        _ => {\n            return default_val;\n        }\n    }\n}\n\nfn main() {\n    assert_eq!(match_number(0), \"100\");\n    assert_eq!(match_number(1), \"200\");\n    assert_eq!(match_number(42), \"999\");\n    assert_eq!(unwrap_option(Some(77), 0), 77);\n    assert_eq!(unwrap_option(None, 404), 404);\n    println!(\"M003_A_RUST_RUNTIME_PASS\");\n}\n"}
