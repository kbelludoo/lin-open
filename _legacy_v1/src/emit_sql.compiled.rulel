.source{content="/* generated by lia_compiler 1.0.0 */\n/* effect:Write */function emitSqlSelect(table, columns, where){var cols,sql;cols='*';if(columns&&columns.length>0){cols=columns.join(', ');};sql='SELECT '+cols+' FROM '+table;if(where){sql=sql+' WHERE '+where;};return (sql+';');}\n/* effect:Write */function emitSqlInsert(table, columns, values){var cols,vals;cols=columns.join(', ');vals=values.join(', ');return ('INSERT INTO '+table+' ('+cols+') VALUES ('+vals+');');}\n/* effect:Write */function emitSqlCreateTable(table, schema){var parts,fields,f,line,i;parts=[];parts.push('CREATE TABLE IF NOT EXISTS '+table+' (');fields=schema||[];for(i=0;i<fields.length;i++){f=fields[i];line='  '+f.name+' '+f.type;if(f.pk){line=line+' PRIMARY KEY';};if(f.notnull){line=line+' NOT NULL';};if(i<fields.length-1){line=line+',';};parts.push(line);};parts.push(');');return parts.join('\\n');}\n/* effect:Write */function emitPrql(table, filter, select){var parts;parts=[];parts.push('from '+table);if(filter){parts.push('filter '+filter);};if(select){parts.push('select {'+select+'}');};return parts.join('\\n');}\nmodule.exports={emitSqlSelect,emitSqlInsert,emitSqlCreateTable,emitPrql};"}
