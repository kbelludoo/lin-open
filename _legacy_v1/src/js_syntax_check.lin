@LIN:js_syntax_check:1.0.0
^schema_once ^lossy=true ^ops=js_syntax_check
~G{?=if #=for ^=ret :else}

!jsSyntaxCheck(js){
  fs=require("fs");
  os=require("os");
  pathmod=require("path");
  cp=require("child_process");
  dir=fs.mkdtempSync(pathmod.join(os.tmpdir(),"lin_js_chk_"));
  file=pathmod.join(dir,"emit.cjs");
  fs.writeFileSync(file,String(js==null?"":js),"utf8");
  r=cp.spawnSync(process.execPath,["--check",file],{"encoding":"utf8"});
  try{fs.rmSync(dir,{"recursive":true,"force":true})}catch(e){}
  raw=(r.stderr!=null&&r.stderr!="")?r.stderr:r.stdout;
  detail=String((raw==null||raw=="")?"node --check":raw).trim().substring(0,240);
  ^{"ok":r.status===0,"detail":detail}
}
!assertJsParse(js,opts){
  res=jsSyntaxCheck(js);
  ?(res.ok){^null}
  ?(opts!=null&&opts.lossy==true){console.warn("LIN_EMIT_JS_SYNTAX (lossy): "+res.detail)}
  ^(function(){throw new Error("LIN_EMIT_JS_SYNTAX: "+res.detail)}())
}
=ex{jsSyntaxCheck,assertJsParse}
