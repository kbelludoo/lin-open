@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=semantic_runtime
~G{?=if #=for ^=ret :else}
!decideTarget(concept,availableToolchains){effects=concept.effect||['pure'];target=concept.target||{};?(target.require){tc=availableToolchains||[];#(i=0;i<tc.length;i++){?(tc[i]==target.require){^target.require}};^null};?(target.prefer){tc=availableToolchains||[];#(i=0;i<tc.length;i++){?(tc[i]==target.prefer){^target.prefer}}};isPure=true;effs=effects;#(j=0;j<effs.length;j++){?(effs[j]!='pure'){isPure=false}};?(isPure){^selectByProfile('performance',availableToolchains)};hasIo=false;hasAsync=false;#(k=0;k<effs.length;k++){?(effs[k]=='io'){hasIo=true};?(effs[k]=='async'){hasAsync=true}};?(hasAsync){^selectByProfile('web_edge',availableToolchains)};?(hasIo){^selectByProfile('enterprise',availableToolchains)};?(target.fallback){^target.fallback};^'js'}
!selectByProfile(profile,toolchains){tc=toolchains||[];rankings={performance:['rust','c','go','zig','nim','java'],ai_data:['py','julia','rust'],web_edge:['ts','js','lua'],enterprise:['java','cs','kotlin','scala'],functional:['elixir','haskell','prolog','scala'],config_infra:['go','hcl']};list=rankings[profile]||['js'];#(i=0;i<list.length;i++){#(j=0;j<tc.length;j++){?(tc[j]==list[i]){^list[i]}}};^(tc[0]||'js')}
!validateConstraints(constraints,bindings){violations=[];list=constraints||[];#(i=0;i<list.length;i++){pred=list[i].predicate||'';m=pred.match(/^([A-Za-z_][\w]*)\s*(>=|<=|>|<|==|!=)\s*(.+)$/);?(m){id=m[1];op=m[2];rhs=m[3].trim();val=bindings[id];?(val!=null){rval=Number(rhs);?(op=='>='&&!(val>=rval)){violations.push(pred)};?(op=='<='&&!(val<=rval)){violations.push(pred)};?(op=='>'&&!(val>rval)){violations.push(pred)};?(op=='<'&&!(val<rval)){violations.push(pred)};?(op=='=='&&val!=rval){violations.push(pred)};?(op=='!='&&val==rval){violations.push(pred)}}}};^({valid:violations.length==0,violations:violations})}
!executeRules(rules,inputs){bindings={};keys=Object.keys(inputs||{});#(i=0;i<keys.length;i++){bindings[keys[i]]=inputs[keys[i]]};list=rules||[];#(j=0;j<list.length;j++){rule=list[j];?(rule.binding&&rule.expr){bindings[rule.binding]=evalSimpleExpr(rule.expr,bindings)}};^bindings}
!evalSimpleExpr(expr,bindings){s=String(expr||'').trim();?(s.match(/^\d+(\.\d+)?$/)){^Number(s)};?(bindings[s]!=null){^bindings[s]};m=s.match(/^([A-Za-z_][\w]*)\s*\*\s*(.+)$/);?(m&&bindings[m[1]]!=null){^(bindings[m[1]]*evalSimpleExpr(m[2],bindings))};m2=s.match(/^([A-Za-z_][\w]*)\s*\+\s*(.+)$/);?(m2&&bindings[m2[1]]!=null){^(bindings[m2[1]]+evalSimpleExpr(m2[2],bindings))};m3=s.match(/^([A-Za-z_][\w]*)\s*-\s*(.+)$/);?(m3&&bindings[m3[1]]!=null){^(bindings[m3[1]]-evalSimpleExpr(m3[2],bindings))};^0}
=ex{decideTarget,selectByProfile,validateConstraints,executeRules,evalSimpleExpr}
