@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_rules_engine
~G{?=if #=for ^=ret :else}
!createKnowledgeBase(){^({facts:[],rules:[]})}
!assertFact(kb,subject,predicate,object){kb.facts.push({subject:subject,predicate:predicate,object:object});^kb}
!assertRule(kb,name,conditions,conclusion){kb.rules.push({name:name,conditions:conditions||[],conclusion:conclusion});^kb}
!queryFact(kb,subject,predicate,object){results=[];facts=kb.facts||[];#(i=0;i<facts.length;i++){f=facts[i];matchS=(subject==null||subject=='_'||f.subject==subject);matchP=(predicate==null||predicate=='_'||f.predicate==predicate);matchO=(object==null||object=='_'||f.object==object);?(matchS&&matchP&&matchO){results.push(f)}};^results}
!applyRules(kb){newFacts=[];changed=true;maxIter=100;iter=0;#(;changed&&iter<maxIter;){changed=false;iter=iter+1;rules=kb.rules||[];#(i=0;i<rules.length;i++){rule=rules[i];allMatch=true;bindings={};conds=rule.conditions||[];#(j=0;j<conds.length;j++){c=conds[j];found=queryFact(kb,c.subject||'_',c.predicate||'_',c.object||'_');?(found.length==0){allMatch=false}:{bindings[c.predicate]=found[0]}};?(allMatch){conc=rule.conclusion;existing=queryFact(kb,conc.subject,conc.predicate,conc.object);?(existing.length==0){assertFact(kb,conc.subject,conc.predicate,conc.object);newFacts.push(conc);changed=true}}}};^({newFacts:newFacts,iterations:iter})}
!inferRequirements(kb,operation){deps=queryFact(kb,operation,'requires','_');result=[];#(i=0;i<deps.length;i++){result.push(deps[i].object);transitive=inferRequirements(kb,deps[i].object);#(j=0;j<transitive.length;j++){?(result.indexOf(transitive[j])<0){result.push(transitive[j])}}};^result}
!checkConstraints(kb,entity){violations=[];constraints=queryFact(kb,entity,'constraint','_');#(i=0;i<constraints.length;i++){c=constraints[i];satisfied=queryFact(kb,entity,'satisfies',c.object);?(satisfied.length==0){violations.push(c.object)}};^({entity:entity,valid:violations.length==0,violations:violations})}
!kbToLin(kb){parts=[];facts=kb.facts||[];#(i=0;i<facts.length;i++){f=facts[i];parts.push('FACT: '+f.subject+' '+f.predicate+' '+f.object)};rules=kb.rules||[];#(j=0;j<rules.length;j++){r=rules[j];conds=[];rc=r.conditions||[];#(k=0;k<rc.length;k++){conds.push(rc[k].subject+' '+rc[k].predicate+' '+(rc[k].object||''))};parts.push('RULE '+r.name+': IF '+conds.join(' AND ')+' THEN '+r.conclusion.subject+' '+r.conclusion.predicate+' '+r.conclusion.object)};^parts.join('\n')}
=ex{createKnowledgeBase,assertFact,assertRule,queryFact,applyRules,inferRequirements,checkConstraints,kbToLin}
