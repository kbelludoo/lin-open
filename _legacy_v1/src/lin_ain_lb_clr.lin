!clr002ContextAllows(context,required){arr=context||[];#(i=0;i<arr.length;i++){?(String(arr[i])==String(required)){^1}};^0}
!clr002Graph(op,effects,context){required=clr002EffectFor(op);cap=clr002CapabilityFor(op);effectOk=0;#(i=0;i<(effects||[]).length;i++){?(String(effects[i])==required){effectOk=1}};^({operation:op,effect:required,effect_declared:effectOk,capability:cap,required_context:required,context_allowed:clr002ContextAllows(context,required)})}
!clr002RepairAllowed(proposed,proof,invariant){?(proposed==1&&proof==1&&invariant==1){^1};^0}
!clr002RepairDecision(proposed,proof,invariant,approved){?(clr002RepairAllowed(proposed,proof,invariant)==0){^'DENIED'};?(approved==1){^'APPLIED'};^'CONDITIONAL'}
