!effHas(list,name){arr=list||[];#(i=0;i<arr.length;i++){?(String(arr[i])==name){^1}};^0}
!addIoEffects(list){out=[];arr=list||[];#(i=0;i<arr.length;i++){out.push(arr[i])};?(effHas(out,'io')==0){out.push('io')};^out}
!isMechRepair(s){t=String(s||'');?(t.indexOf(mechRepair0())>=0){^1};^0}
!firstMechRepair(s){parts=String(s||'').split('|');#(i=0;i<parts.length;i++){p=String(parts[i]||'').trim();?(isMechRepair(p)){^p}};^''}
!applyAddIo(ir){?(ir==null){^null};^({intent:ir.intent,target:ir.target,constraints:ir.constraints,allowed_effects:addIoEffects(ir.allowed_effects),ops:ir.ops,op:ir.op,requested_op:ir.requested_op,amount:ir.amount,create_fn:ir.create_fn,existing_fn:ir.existing_fn})}
!applyMechRepair(ir,repair){?(isMechRepair(repair)){^applyAddIo(ir)};^ir}
