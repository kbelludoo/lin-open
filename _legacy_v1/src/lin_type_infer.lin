@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_type_infer
~G{?=if #=for ^=ret :else}
!inferType(expr){s=String(expr||'').trim();?(s.match(/^-?\d+$/)){^'int'};?(s.match(/^-?\d+\.\d+$/)){^'float'};?(s.match(/^["']/)){^'str'};?(s=='true'||s=='false'){^'bool'};?(s=='null'||s=='nil'||s=='undefined'||s=='None'){^'null'};?(s.match(/^\[/)){^'list'};?(s.match(/^\{/)){^'map'};?(s.match(/^function\b/)){^'fn'};^'any'}
!inferParamType(name,usages){?(name=='i'||name=='j'||name=='k'||name=='n'||name=='len'||name=='idx'||name=='count'){^'int'};?(name=='str'||name=='s'||name=='ch'||name=='pad'||name=='name'||name=='key'||name=='value'||name=='id'){^'str'};?(name=='flag'||name=='ok'||name=='done'||name=='valid'){^'bool'};?(name=='items'||name=='list'||name=='arr'||name=='args'){^'list'};?(name=='opts'||name=='config'||name=='options'||name=='obj'){^'map'};?(name=='fn'||name=='cb'||name=='callback'||name=='handler'){^'fn'};list=usages||[];#(k=0;k<list.length;k++){u=list[k];?(u.match(/\.length\b/)||u.match(/\[\d+\]/)){^'list'};?(u.match(/\.trim\b/)||u.match(/\.indexOf\b/)||u.match(/\.replace\b/)){^'str'};?(u.match(/[+\-*\/%]\s*\d/)){^'int'}};^'any'}
!inferReturnType(body){s=String(body||'');?(s.match(/\^true\b|\^false\b/)){^'bool'};?(s.match(/\^\d+$/m)){^'int'};?(s.match(/\^\d+\.\d+$/m)){^'float'};?(s.match(/\^["']/)){^'str'};?(s.match(/\^\[/)){^'list'};?(s.match(/\^\{/)){^'map'};?(s.match(/\^null\b|\^nil\b/)){^'null'};^'any'}
!inferFnSignature(name,params,body){paramTypes=[];plist=String(params||'').split(',');#(i=0;i<plist.length;i++){p=plist[i].trim();?(p){paramTypes.push({name:p,type:inferParamType(p,[])})}};retType=inferReturnType(body);^({name:name,params:paramTypes,returnType:retType,pure:isPureBody(body)})}
!isPureBody(body){s=String(body||'');?(s.match(/\b(fs|path|http|fetch|console|process|global|window|document)\b/)){^false};?(s.match(/\bthis\.\b/)){^false};?(s.match(/\bawait\b|\basync\b/)){^false};?(s.match(/\bMath\.random\b/)){^false};?(s.match(/\bDate\.now\b|\bnew Date\b/)){^false};^true}
!unifyTypes(a,b){?(a==b){^a};?(a=='any'){^b};?(b=='any'){^a};?(a=='int'&&b=='float'){^'float'};?(a=='float'&&b=='int'){^'float'};^'any'}
=ex{inferType,inferParamType,inferReturnType,inferFnSignature,isPureBody,unifyTypes}
