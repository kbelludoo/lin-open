.source{content="/* generated by lia_compiler 1.0.0 */\n/* effect:Native */function emitMojoModule(prog){var parts,fns,fn,name,params,paramList,i,j;parts=[];parts.push('# generated by lia multi-emit -> mojo');parts.push('from python import Python');parts.push('');fns=prog.fns||[];for(i=0;i<fns.length;i++){fn=fns[i];name=fn.name;params=String(fn.params||'').split(',').filter(function(p){return p.trim()});paramList='';for(j=0;j<params.length;j++){if(j>0){paramList=paramList+', ';};paramList=paramList+params[j].trim()+': object';};parts.push('fn '+name+'('+paramList+') -> object:');parts.push('    return None');parts.push('');};return parts.join('\\n');}\nmodule.exports=emitMojoModule;"}
