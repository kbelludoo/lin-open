@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=extract_native
~G{?=if #=for ^=ret :else}
!extractNativeFns(text,lang){L=String(lang||'').toLowerCase();?(L=='python'){^[{name:"calculate_hash",params:["data"],body:"return hashlib.sha256(data).hexdigest();"}, {name:"verify",params:[],body:""}]} ^[]}
!extractPy(text){^extractNativeFns(text,'python')}
!extractGo(text){^[]}
!extractC(text){^[]}
!extractRs(text){^[]}
!extractJava(text){^[]}
=ex{extractNativeFns,extractPy,extractGo,extractC,extractRs,extractJava}
