@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_wat
~G{?=if #=for ^=ret :else}
!emitWatModule(prog){parts=[];parts.push(';; generated by lia multi-emit -> wat (WebAssembly Text)');parts.push('(module');fns=prog.fns||[];#(i=0;i<fns.length;i++){fn=fns[i];watName=fn.name;params=String(fn.params||'').split(',').filter(function(p){^p.trim()});paramDecls='';#(j=0;j<params.length;j++){paramDecls=paramDecls+' (param $'+params[j].trim()+' i64)'};parts.push('  (func $'+watName+' (export "'+watName+'")'+paramDecls+' (result i64)');?(params.length>0){parts.push('    (local.get $'+params[0].trim()+')')}:{parts.push('    (i64.const 0)')};parts.push('  )')};parts.push(')');^parts.join('\n')}
!emitWatFromLia(liaText,opts){prog=null;^emitWatModule(prog)}
=ex{emitWatModule,emitWatFromLia}
