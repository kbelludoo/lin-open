~METADATA{original="_legacy_v1/src/emit_asm.mjs" lang="mjs"}
.source{content="/**\n * LIA → Assembly (x86_64 NASM) emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { safeEmitId } from './emit_shared.mjs';\n\nexport function emitAsm(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '; generated by lia multi-emit → nasm x86_64',\n    'default rel',\n    'section .text',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const fnName = safeEmitId(fn.name);\n    parts.push(`global ${fnName}`);\n    parts.push(`${fnName}:`);\n    parts.push('    xor rax, rax');\n    parts.push('    ret');\n    parts.push('');\n  }\n\n  return { code: parts.join('\\n'), lang: 'nasm' };\n}\n"}
