@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="_legacy_v1/src/emit_lua.mjs" lang="mjs"}
.source{content="/**\n * LIA → Lua emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseStmts, tryParseStmts, collectAssignedIds } from './body_ast.mjs';\nimport { isJsRuntimeOnly, parseParamList, isNoopExpr, safeEmitId } from './emit_shared.mjs';\n\nfunction rewriteLuaExpr(expr) {\n  let s = String(expr || '');\n  s = s.replace(/===/g, '==').replace(/!==/g, '~=');\n  s = s.replace(/!=/g, '~=');\n  s = s.replace(/&&/g, ' and ').replace(/\\|\\|/g, ' or ');\n  s = s.replace(/!(?!=)/g, 'not ');\n  s = s.replace(/\\bnull\\b|\\bundefined\\b/g, 'nil');\n  s = s.replace(/\\btrue\\b/g, 'true').replace(/\\bfalse\\b/g, 'false');\n  s = s.replace(/([A-Za-z_][\\w]*)\\.length\\b/g, '#$1');\n  return s;\n}\n\nfunction emitStmts(stmts, indent) {\n  const pad = '  '.repeat(indent);\n  const lines = [];\n  for (const st of stmts) {\n    if (st.type === 'assign') {\n      lines.push(`${pad}${st.id} = ${rewriteLuaExpr(st.expr)}`);\n    } else if (st.type === 'return') {\n      lines.push(`${pad}return ${rewriteLuaExpr(st.expr)}`);\n    } else if (st.type === 'throw') {\n      lines.push(`${pad}error(${rewriteLuaExpr(st.expr)})`);\n    } else if (st.type === 'expr') {\n      if (/^break\\b/.test(st.expr.trim())) lines.push(`${pad}break`);\n      else if (!isNoopExpr(st.expr)) lines.push(`${pad}${rewriteLuaExpr(st.expr)}`);\n    } else if (st.type === 'if') {\n      lines.push(`${pad}if ${rewriteLuaExpr(st.cond)} then`);\n      lines.push(...emitStmts(st.then, indent + 1));\n      for (const e of st.elseIf || []) {\n        lines.push(`${pad}elseif ${rewriteLuaExpr(e.cond)} then`);\n        lines.push(...emitStmts(e.body, indent + 1));\n      }\n      if (st.else) {\n        lines.push(`${pad}else`);\n        lines.push(...emitStmts(st.else, indent + 1));\n      }\n      lines.push(`${pad}end`);\n    } else if (st.type === 'while') {\n      lines.push(`${pad}while ${rewriteLuaExpr(st.cond)} do`);\n      lines.push(...emitStmts(st.body, indent + 1));\n      lines.push(`${pad}end`);\n    }\n  }\n  return lines;\n}\n\nexport function emitLua(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '-- generated by lia multi-emit → lua',\n    'local M = {}',\n    'local function _lia_num(x) return tonumber(x) or 0 end',\n    'local function _lia_str(x) return tostring(x or \"\") end',\n    'local function _lia_typeof(x) return type(x) end',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const luaName = safeEmitId(fn.name);\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`function M.${luaName}() error(\"JS-runtime-only\") end`);\n      continue;\n    }\n    const stmts = tryParseStmts(fn.body);\n    if (!stmts) {\n      parts.push(`function M.${luaName}() error(\"JS-runtime-only\") end`);\n      continue;\n    }\n    const paramList = params.map(safeEmitId).join(', ');\n    parts.push(`function M.${luaName}(${paramList})`);\n    const assigned = collectAssignedIds(stmts).filter((id) => !params.includes(id)).map(safeEmitId);\n    for (const id of assigned) parts.push(`  local ${id} = nil`);\n    parts.push(...emitStmts(stmts, 1));\n    parts.push('end\\n');\n  }\n\n  parts.push('return M');\n  return { code: parts.join('\\n'), lang: 'lua' };\n}\n"}
