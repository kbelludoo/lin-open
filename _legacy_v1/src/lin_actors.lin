@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=lin_actors
~G{?=if #=for ^=ret :else}
$K{STRATEGY_ONE_FOR_ONE="one_for_one" STRATEGY_ONE_FOR_ALL="one_for_all" STRATEGY_REST_FOR_ONE="rest_for_one" REFCAP_ISO="iso" REFCAP_VAL="val" REFCAP_REF="ref" REFCAP_TAG="tag"}
!spawnActor(name,handler,opts){id='actor_'+Date.now()+'_'+name;mailbox=[];alive=true;restartCount=0;maxRestarts=(opts&&opts.maxRestarts)||5;refcap=(opts&&opts.refcap)||'val';actor={id:id,name:name,alive:alive,refcap:refcap,restartCount:restartCount,mailbox:mailbox,send:null,process:null,restart:null,kill:null,status:null};actor.send=~(msg){?(actor.alive==false){^({ok:false,reason:'dead'})};?(refcap=='iso'){mailbox.push(JSON.parse(JSON.stringify(msg)))}:?(refcap=='val'){mailbox.push(Object.freeze(msg))}:{mailbox.push(msg)};^({ok:true})};actor.restart=~(){?(restartCount>=maxRestarts){^({ok:false,reason:'max_restarts_exceeded',actor:id})};restartCount=restartCount+1;actor.restartCount=restartCount;actor.alive=true;actor.lastError=null;^({ok:true,restarts:restartCount,actor:id})};actor.kill=~(){actor.alive=false;mailbox.length=0};actor.status=~(){^({id:id,name:name,alive:actor.alive,refcap:refcap,restartCount:restartCount,mailboxSize:mailbox.length,lastError:actor.lastError||null})};^actor}
!createSupervisor(name,strategy,opts){children=[];maxRestarts=(opts&&opts.maxRestarts)||10;totalRestarts=0;sup={name:name,strategy:strategy,addChild:null,status:null};sup.addChild=~(actor){children.push(actor);^sup};sup.status=~(){statuses=[];#(i=0;i<children.length;i++){statuses.push(children[i].status())};^({name:name,strategy:strategy,totalRestarts:totalRestarts,children:statuses})};^sup}
=ex{spawnActor,createSupervisor}
