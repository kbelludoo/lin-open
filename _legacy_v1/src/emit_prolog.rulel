~METADATA{original="_legacy_v1/src/emit_prolog.mjs" lang="mjs"}
.source{content="/**\n * LIA → Prolog emitter.\n */\nimport { parseLia } from './compiler.mjs';\n\nexport function emitProlog(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '% generated by lia multi-emit → prolog',\n    ':- dynamic lia_fn/2.',\n    '',\n  ];\n\n  if (prog.consts) {\n    for (const [k, v] of Object.entries(prog.consts)) {\n      parts.push(`lia_const(${k.toLowerCase()}, ${JSON.stringify(v)}).`);\n    }\n  }\n\n  for (const fn of prog.fns) {\n    const pCount = (fn.params || '').split(',').filter(Boolean).length;\n    parts.push(`lia_fn(${fn.name.toLowerCase()}, ${pCount}).`);\n  }\n\n  return { code: parts.join('\\n'), lang: 'prolog' };\n}\n"}
