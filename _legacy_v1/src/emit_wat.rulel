~METADATA{original="_legacy_v1/src/emit_wat.mjs" lang="mjs"}
.source{content="/**\n * LIA → WebAssembly Text (WAT) emitter.\n * Generates valid WAT that can be compiled to .wasm via Node WebAssembly.compile.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitWat(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    ';; generated by lia multi-emit → wat (WebAssembly Text)',\n    '(module',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const watName = safeEmitId(fn.name);\n\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      // Stub: export a function that returns 0\n      parts.push(`  (func $${watName} (export \"${watName}\") (result i64)`);\n      parts.push('    (i64.const 0)');\n      parts.push('  )');\n      continue;\n    }\n\n    const paramDecls = params.map((p) => `(param $${safeEmitId(p)} i64)`).join(' ');\n    parts.push(`  (func $${watName} (export \"${watName}\") ${paramDecls} (result i64)`);\n\n    // Simple body: return first param or 0\n    if (params.length > 0) {\n      parts.push(`    (local.get $${safeEmitId(params[0])})`);\n    } else {\n      parts.push('    (i64.const 0)');\n    }\n    parts.push('  )');\n  }\n\n  parts.push(')');\n  return { code: parts.join('\\n'), lang: 'wat' };\n}\n"}
