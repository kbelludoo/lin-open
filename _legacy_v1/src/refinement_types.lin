@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=refinement_types
~G{?=if #=for ^=ret :else}
!parseRefinement(typeStr){s=String(typeStr||'').trim();m=s.match(/^([a-z]+)\{(.+)\}$/);?(m==null){^null};base=m[1];raw=m[2].trim();constraints=[];parts=raw.split(',');#(i=0;i<parts.length;i++){part=parts[i].trim();range=part.match(/^(-?\d+)\.\.(-?\d+)$/);?(range){constraints.push({kind:'range',min:Number(range[1]),max:Number(range[2])})};cmp=part.match(/^([<>]=?)(-?\d+)$/);?(cmp){op_=cmp[1];val_=Number(cmp[2]);?(op_=='>'){constraints.push({kind:'gt',value:val_})};?(op_=='>='){constraints.push({kind:'gte',value:val_})};?(op_=='<'){constraints.push({kind:'lt',value:val_})};?(op_=='<='){constraints.push({kind:'lte',value:val_})}};lenC=part.match(/^len([<>]=?)(\d+)$/);?(lenC){lop=lenC[1];lval=Number(lenC[2]);?(lop=='<='){constraints.push({kind:'maxlen',max:lval})};?(lop=='>='){constraints.push({kind:'minlen',min:lval})}};?(part=='non_empty'){constraints.push({kind:'non_empty'})};?(part=='not_null'){constraints.push({kind:'not_null'})};rx=part.match(/^match=\/(.+)\/$/);?(rx){constraints.push({kind:'match',pattern:rx[1]})}};?(constraints.length==0){^null};^({base:base,constraints:constraints})}
!emitRangeGuard(p,min,max,t){msg='"'+p+': must be in range '+min+'..'+max+'"';?(t=='js'||t=='ts'){^'  if ('+p+' < '+min+' || '+p+' > '+max+') throw new RangeError('+msg+');'};?(t=='py'){^'    if not ('+min+' <= '+p+' <= '+max+'): raise ValueError('+msg+')'};?(t=='go'){^'\tif '+p+' < '+min+' || '+p+' > '+max+' { panic('+msg+') }'};?(t=='rust'){^'    assert!('+p+' >= '+min+' && '+p+' <= '+max+', '+msg+');'};?(t=='java'){^'    if ('+p+' < '+min+' || '+p+' > '+max+') throw new IllegalArgumentException('+msg+');'};?(t=='zig'){^'    if ('+p+' < '+min+' or '+p+' > '+max+') @panic('+msg+');'};?(t=='c'){^'  if ('+p+' < '+min+' || '+p+' > '+max+') { fprintf(stderr, '+msg+'); abort(); }'};^('  // refinement: '+p+' in '+min+'..'+max)}
!emitNonEmptyGuard(p,t){msg='"'+p+': must be non-empty"';?(t=='js'||t=='ts'){^'  if (!'+p+' || '+p+'.length === 0) throw new RangeError('+msg+');'};?(t=='py'){^'    if not '+p+': raise ValueError('+msg+')'};?(t=='go'){^'\tif len('+p+') == 0 { panic('+msg+') }'};?(t=='rust'){^'    assert!(!'+p+'.is_empty(), '+msg+');'};?(t=='java'){^'    if ('+p+' == null || '+p+'.isEmpty()) throw new IllegalArgumentException('+msg+');'};^('  // refinement: '+p+' non_empty')}
=ex{parseRefinement,emitRangeGuard,emitNonEmptyGuard}
