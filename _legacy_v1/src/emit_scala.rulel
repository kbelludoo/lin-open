~METADATA{original="_legacy_v1/src/emit_scala.mjs" lang="mjs"}
.source{content="/**\n * LIA → Scala emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitScala(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const objName = opts.objectName || 'LinEmit';\n  const parts = [\n    '/* generated by lia multi-emit → scala */',\n    `object ${objName} {`,\n    '  def _lia_typeof(x: Any): String = if (x == null) \"object\" else x.getClass.getSimpleName.toLowerCase',\n    '  def _lia_str(x: Any): String = if (x == null) \"\" else x.toString',\n    '  def _lia_num(x: Any): Long = try { x.toString.toLong } catch { case _: Throwable => 0L }',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const scName = safeEmitId(fn.name);\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`  def ${scName}(): Any = throw new RuntimeException(\"JS-runtime-only\")`);\n      continue;\n    }\n    const paramList = params.map((p) => `${safeEmitId(p)}: Any = null`).join(', ');\n    parts.push(`  def ${scName}(${paramList}): Any = {`);\n    parts.push('    null');\n    parts.push('  }');\n  }\n\n  parts.push('}');\n  return { code: parts.join('\\n'), lang: 'scala' };\n}\n"}
