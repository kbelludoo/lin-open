~METADATA{original="_legacy_v1/src/emit_julia.mjs" lang="mjs"}
.source{content="/**\n * LIA → Julia emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitJulia(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const modName = opts.moduleName || 'LinEmit';\n  const parts = [\n    '# generated by lia multi-emit → julia',\n    `module ${modName}`,\n    'export _lia_typeof, _lia_str, _lia_num',\n    '_lia_typeof(x) = string(typeof(x))',\n    '_lia_str(x) = string(x)',\n    '_lia_num(x) = try parse(Int64, string(x)) catch; 0 end',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const jlName = safeEmitId(fn.name);\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`function ${jlName}() error(\"JS-runtime-only\") end`);\n      continue;\n    }\n    const paramList = params.map(safeEmitId).join(', ');\n    parts.push(`function ${jlName}(${paramList})`);\n    parts.push('    nothing');\n    parts.push('end\\n');\n  }\n\n  parts.push('end');\n  return { code: parts.join('\\n'), lang: 'julia' };\n}\n"}
