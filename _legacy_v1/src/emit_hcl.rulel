~METADATA{original="_legacy_v1/src/emit_hcl.mjs" lang="mjs"}
.source{content="/**\n * LIA → HCL emitter.\n */\nimport { parseLia } from './compiler.mjs';\n\nexport function emitHcl(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '# generated by lia multi-emit → hcl',\n    'locals {',\n  ];\n\n  if (prog.consts) {\n    for (const [k, v] of Object.entries(prog.consts)) {\n      parts.push(`  ${k} = ${JSON.stringify(v)}`);\n    }\n  }\n\n  for (const fn of prog.fns) {\n    parts.push(`  fn_${fn.name} = {`);\n    parts.push(`    params = ${JSON.stringify(fn.params || '')}`);\n    parts.push(`    body   = ${JSON.stringify(fn.body || '')}`);\n    parts.push('  }');\n  }\n\n  parts.push('}');\n  return { code: parts.join('\\n'), lang: 'hcl' };\n}\n"}
