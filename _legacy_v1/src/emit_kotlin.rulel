@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="_legacy_v1/src/emit_kotlin.mjs" lang="mjs"}
.source{content="/**\n * LIA → Kotlin emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitKotlin(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '/* generated by lia multi-emit → kotlin */',\n    'package lin.emit',\n    '',\n    'object LinEmit {',\n    '    fun _lia_typeof(x: Any?): String = if (x == null) \"object\" else if (x is String) \"string\" else if (x is Number) \"number\" else if (x is Boolean) \"boolean\" else \"object\"',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const ktName = safeEmitId(fn.name);\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`    fun ${ktName}(): Any? = throw RuntimeException(\"JS-runtime-only\")`);\n      continue;\n    }\n    const paramList = params.map((p) => `${safeEmitId(p)}: Any? = null`).join(', ');\n    parts.push(`    fun ${ktName}(${paramList}): Any? {`);\n    parts.push('        return null');\n    parts.push('    }');\n  }\n\n  parts.push('}');\n  return { code: parts.join('\\n'), lang: 'kotlin' };\n}\n"}
