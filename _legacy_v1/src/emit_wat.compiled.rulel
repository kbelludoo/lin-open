.source{content="/* generated by lia_compiler 1.0.0 */\n/* effect:Native */function emitWatModule(prog){var parts,fns,fn,watName,params,paramDecls,i,j;parts=[];parts.push('; generated by lia multi-emit -> wat (WebAssembly Text)');parts.push('(module');fns=prog.fns||[];for(i=0;i<fns.length;i++){fn=fns[i];watName=fn.name;params=String(fn.params||'').split(',').filter(function(p){return p.trim()});paramDecls='';for(j=0;j<params.length;j++){paramDecls=paramDecls+' (param $'+params[j].trim()+' i64)';};parts.push('  (func $'+watName+' (export \"'+watName+'\")'+paramDecls+' (result i64)');if(params.length>0){parts.push('    (local.get $'+params[0].trim()+')');}else{parts.push('    (i64.const 0)');};parts.push('  )');};parts.push(')');return parts.join('\\n');}\n/* effect:Write */function emitWatFromLia(liaText, opts){var prog;prog=null;return emitWatModule(prog);}\nmodule.exports={emitWatModule,emitWatFromLia};"}
