~METADATA{original="_legacy_v1/src/emit_haskell.mjs" lang="mjs"}
.source{content="/**\n * LIA → Haskell emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitHaskell(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const modName = opts.moduleName || 'LinEmit';\n  const parts = [\n    '{- generated by lia multi-emit → haskell -}',\n    `module ${modName} where`,\n    '',\n    '_lia_str :: Show a => a -> String',\n    '_lia_str = show',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const hsName = safeEmitId(fn.name).replace(/([a-z0-9])([A-Z])/g, '$1_$2').toLowerCase();\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`${hsName} :: IO ()`);\n      parts.push(`${hsName} = error \"JS-runtime-only\"`);\n      continue;\n    }\n    const paramList = params.map(safeEmitId).join(' ');\n    parts.push(`${hsName} ${paramList} = ()`);\n  }\n\n  return { code: parts.join('\\n'), lang: 'haskell' };\n}\n"}
