~METADATA{original="_legacy_v1/src/emit_crystal.mjs" lang="mjs"}
.source{content="/**\n * LIA → Crystal emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitCrystal(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const modName = opts.moduleName || 'LinEmit';\n  const parts = [\n    '# generated by lia multi-emit → crystal',\n    `module ${modName}`,\n    '  extend self',\n    '  def _lia_typeof(x)',\n    '    case x',\n    '    when String then \"string\"',\n    '    when Number then \"number\"',\n    '    when Bool then \"boolean\"',\n    '    else \"object\"',\n    '    end',\n    '  end',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const crName = safeEmitId(fn.name).replace(/([a-z0-9])([A-Z])/g, '$1_$2').toLowerCase();\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`  def ${crName}`);\n      parts.push('    raise \"JS-runtime-only\"');\n      parts.push('  end');\n      continue;\n    }\n    const paramList = params.map(safeEmitId).join(', ');\n    parts.push(`  def ${crName}(${paramList})`);\n    parts.push('    nil');\n    parts.push('  end');\n  }\n\n  parts.push('end');\n  return { code: parts.join('\\n'), lang: 'crystal' };\n}\n"}
