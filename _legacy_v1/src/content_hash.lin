@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=content_hash
~G{?=if #=for ^=ret :else}

!canonicalize(fnName,params,body){
  canon = String(body||'').trim();
  canon = canon.replace(/\/\*[\s\S]*?\*\/|\/\/[^\r\n]*/g,'');
  canon = canon.replace(/\s+/g,' ').replace(/\s*([=+\-*/%&|^<>(),;!?:{}\[\]])\s*/g,'$1').trim();
  rawParams = String(params||'').split(',').map((p)=>p.trim()).filter(Boolean);
  paramTypes = rawParams.map((p)=>p.includes(':')?p.split(':')[1].trim():'').join(',');
  paramList = rawParams.map((p)=>p.replace(/:.+$/,''));
  #(i=0;i<paramList.length;i++){
    re = new RegExp('\\b'+paramList[i]+'\\b','g');
    canon = canon.replace(re,'$'+i);
  }
  reserved = ['var','let','const','return','if','else','while','for','in','of','null','true','false','undefined','void','typeof'];
  locals = [];
  assignRe = /(?:^|[;{(])\s*([a-zA-Z_$][\w$]*)\s*=(?!=)/g;
  while((match=assignRe.exec(canon))!==null){
    id = match[1];
    if(!locals.includes(id)&&!id.startsWith('$')&&!reserved.includes(id)){
      locals.push(id);
    }
  }
  #(i=0;i<locals.length;i++){
    re = new RegExp('\\b'+locals[i]+'\\b','g');
    canon = canon.replace(re,'_l'+i);
  }
  canon = canon.replace(/'/g,'"');
  canon = canon.replace(/===/g,'==').replace(/!==/g,'!=');
  canon = canon.replace(/;+/g,';').replace(/;+$/,'');
  ^('('+paramList.length+':'+paramTypes+')'+canon)
}

!contentHash(fnName,params,body){
  canonical = canonicalize(fnName,params,body);
  hash = require('node:crypto').createHash('sha256').update(canonical,'utf8').digest('hex');
  ^hash.slice(0,16)
}

!semanticEquals(fn1,fn2){
  h1 = contentHash(fn1.name,fn1.params,fn1.body);
  h2 = contentHash(fn2.name,fn2.params,fn2.body);
  ^(h1===h2)
}

!buildContentRegistry(prog){
  registry = {};
  fns = prog.fns||[];
  #(i=0;i<fns.length;i++){
    fn = fns[i];
    hash = contentHash(fn.name,fn.params,fn.body);
    registry[hash] = {name:fn.name,params:fn.params,hash:hash,bodyLen:(fn.body||'').length};
  }
  ^registry
}

=ex{canonicalize,contentHash,semanticEquals,buildContentRegistry}
