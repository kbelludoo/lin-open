~METADATA{original="_legacy_v1/src/emit_nim.mjs" lang="mjs"}
.source{content="/**\n * LIA → Nim emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitNim(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const parts = [\n    '# generated by lia multi-emit → nim',\n    'import strutils',\n    '',\n    'proc _lia_typeof*(x: auto): string = \"object\"',\n    'proc _lia_num*(x: auto): int64 = 0',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const nimName = safeEmitId(fn.name);\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`proc ${nimName}*() = discard`);\n      continue;\n    }\n    const paramList = params.map((p) => `${safeEmitId(p)}: auto`).join(', ');\n    parts.push(`proc ${nimName}*(${paramList}) =`);\n    parts.push('  discard');\n  }\n\n  return { code: parts.join('\\n'), lang: 'nim' };\n}\n"}
