~METADATA{original="_legacy_v1/src/emit_elixir.mjs" lang="mjs"}
.source{content="/**\n * LIA → Elixir emitter.\n */\nimport { parseLia } from './compiler.mjs';\nimport { parseParamList, safeEmitId, isJsRuntimeOnly } from './emit_shared.mjs';\n\nexport function emitElixir(liaText, opts = {}) {\n  const prog = parseLia(liaText);\n  const modName = opts.moduleName || 'LinEmit';\n  const parts = [\n    '# generated by lia multi-emit → elixir',\n    `defmodule ${modName} do`,\n    '  def _lia_typeof(nil), do: \"object\"',\n    '  def _lia_typeof(x) when is_binary(x), do: \"string\"',\n    '  def _lia_typeof(x) when is_number(x), do: \"number\"',\n    '  def _lia_typeof(x) when is_boolean(x), do: \"boolean\"',\n    '  def _lia_typeof(_), do: \"object\"',\n    '',\n  ];\n\n  for (const fn of prog.fns) {\n    const { names: params } = parseParamList(fn.params);\n    const exName = safeEmitId(fn.name).replace(/([a-z0-9])([A-Z])/g, '$1_$2').toLowerCase();\n    if (opts.stubRuntime !== false || isJsRuntimeOnly(fn.body, fn.name)) {\n      parts.push(`  def ${exName}(), do: raise(\"JS-runtime-only\")`);\n      continue;\n    }\n    const paramList = params.map((p) => `_${p}`).join(', ');\n    parts.push(`  def ${exName}(${paramList}) do`);\n    parts.push('    nil');\n    parts.push('  end');\n  }\n\n  parts.push('end');\n  return { code: parts.join('\\n'), lang: 'elixir' };\n}\n"}
