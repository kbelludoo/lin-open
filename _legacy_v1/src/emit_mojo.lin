@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_mojo
~G{?=if #=for ^=ret :else}
!emitMojoModule(prog){parts=[];parts.push('# generated by lia multi-emit -> mojo');parts.push('from python import Python');parts.push('');fns=prog.fns||[];#(i=0;i<fns.length;i++){fn=fns[i];name=fn.name;params=String(fn.params||'').split(',').filter(function(p){^p.trim()});paramList='';#(j=0;j<params.length;j++){?(j>0){paramList=paramList+', '};paramList=paramList+params[j].trim()+': object'};parts.push('fn '+name+'('+paramList+') -> object:');parts.push('    return None');parts.push('')};^parts.join('\n')}
=ex{emitMojoModule}
