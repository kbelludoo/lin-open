  commit="0c41f38fb1c201786e9c3ac9eae4f5f80c051399"
  header="include/wally_transaction.h"
  header_sha256="02f09466ce2e7bc8f326f762efde701d02c84334018cb4bc5fa8d909be851007"
  tx_c="src/transaction.c"
  tx_c_sha256="c9e1504610735267d7048c56d49da1935a29c128eeb10d9d0b7416a9eae23619"
