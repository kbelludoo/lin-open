  core_amount_sha256="cb7bd951877f3fea5a0c280d4bb907a8403437add81e3d5b898879b78fdc877e"
  gcc="gcc -O2 -fPIC -shared of the scalar extract"
  python="stdlib int oracle of COIN / MAX_MONEY / overflow-add"
