}
.c{
  C_WALLY_1="WALLY_SATOSHI_PER_BTC=1e8 and WALLY_BTC_MAX=21e6 match the pinned header"
  C_WALLY_2="SATOSHI_MAX = 21e6 * 1e8 = 2100000000000000 recomputes in gcc, Python, and lin_c0"
  C_WALLY_3="Bitcoin Core v27.1 COIN/MAX_MONEY/MoneyRange agree bit-exact with the LIN kernel"
  C_WALLY_4="overflow add: gcc == Python == lin_c0; MAX+1 and negative fail-closed to WALLY_EINVAL=-2"
  C_WALLY_5="pointer APIs wally_tx_get_total_output_satoshi / wally_tx_output_set_satoshi stay REJ_C_POINTER"
  C_WALLY_6="lin_from_c v2 inlines object-like #define, strips UL/LL, lowers ||/&&, rejects printf/assert"
  C_WALLY_7="Compiler 0 in-RAM compile: lin_c0 vm + LINBC1 roundtrip CONSENSUS on wally_amount_gate"
}
.n{
  full_libwally="NOT proven — tx/psbt/script/secp are pointer-heavy and stay rejected"
  uint256="NOT claimed — native i64 is Bitcoin Core CAmount, not EVM uint256"
  wallet_replacement="NOT claimed — not Green, Jade, or bitcoind"
  libtcc_jit="only if libtcc is present; otherwise bytecode VM is the Compiler 0 path"
}
.u{
  prove="python3 test/prove_wally_amount_external.py"
  c0="make -C transpile/c c0 && ./transpile/c/bin/lin_c0 vm src/lin_wally_amount.lin wally_amount_gate"
}
.l{
  clone_lin="https://github.com/kbelludoo/clone-lin-wally-amount"
  lin_open_kernel="src/lin_wally_amount.lin"
  lin_open_proof="test/prove_wally_amount_external.py"
}
.p{
  class="EXPERIMENTAL"
  commercial="Every Bitcoin wallet that speaks satoshis uses 1e8 and the 21e6 cap. LIN's i64 is the same type as Core CAmount. This slice proves the cap and overflow-checked add/sub, not a wallet."
}
