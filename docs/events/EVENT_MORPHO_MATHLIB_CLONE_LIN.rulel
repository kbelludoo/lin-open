@RULEL:MORPHO_MATHLIB_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MORPHO-BLUE-MATHLIB"
@TITLE="Clone-lin of Morpho Blue MathLib with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_I64_POSITIVE"
@DATE="2026-11-13"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-morpho-mathlib"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Morpho Blue WAD mul/div and wTaylorCompounded into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="i64-positive inputs, 128-bit product for (x*y)/d; Solidity uint256 is NOT claimed"
  commercial_hook="MathLib.wTaylorCompounded and wMulDown are the interest kernel of Morpho Blue (_accrueInterest: totalBorrowAssets.wMulDown(borrowRate.wTaylorCompounded(elapsed))); this clone proves bit-exact i64-scale parity, not TVL"
}

.u{
  repo="https://github.com/morpho-org/morpho-blue"
  path="src/libraries/MathLib.sol"
  license="MIT file SPDX; repository LICENSE GPL-2.0"
  commit="339a885801972740eb27f51da110a4675b839d42"
  git_blob_sha="3c0afc991c3bfa9314498b43047a0675be4a9410"
  file_sha256="61c0e20da6b026a356ed86d47da921ef2d69f65e40d9c8b97e7ae18ad497aa22"
  fixture="test/fixtures/external_proof/MathLib.sol"
}

.l{
  clone="src/lin_morpho_mathlib.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: emit OK_VIEW; require() fail-closes; bind uint constant NAME=digits; classify CEIL_DIV"
  improvement_1="Morpho.sol _accrueInterest uses block.timestamp - lastUpdate; LIN takes elapsed as an argument"
  improvement_2="(x*y)/d overflows i64 on 1e18*1e18; LIN uses schoolbook 128-bit muldiv matching C11 __int128, fail-closed if quotient exceeds i64"
  improvement_3="mulDivUp is remainder+1 (floor then +1 iff r!=0), not (x*y+(d-1))/d which adds before divide"
  improvement_4="wTaylorCompounded firstTerm=x*n fail-closes instead of wrapping; sum of Taylor terms fail-closes on i64 overflow"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/morpho_mathlib_c11.c (gcc -O2 -std=c11, __int128)"
  gate="test/verify_morpho_mathlib.sh"
}

.p{
  harness="test/prove_morpho_mathlib_external.py"
  evidence_json="examples/morpho_mathlib/morpho_mathlib_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-morpho-mathlib"
  named_goldens="mulDivDown(7,9,2)=31; mulDivUp=32; wTaylorCompounded(3170979198,86400)=274010136628159"
}

.n{
  not_claimed_1="full uint256 / mainnet Morpho Blue market parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production IRM or Morpho replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="TVL, dollar savings, or that LIN replaces Morpho, Uniswap, or the EVM"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_PYTHON && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
