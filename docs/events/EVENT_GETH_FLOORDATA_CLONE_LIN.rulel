@RULEL:GETH_FLOORDATA_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-GETH-FLOORDATA-EIP7623"
@TITLE="Clone-lin of go-ethereum FloorDataGas (EIP-7623) with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_I64_SCALE"
@DATE="2026-09-17"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-geth-floordata"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Geth Prague data-floor gas into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="non-negative i64 inputs matching Geth MaxGasLimit=2^63-1; Solidity/EVM uint64 wrap above that is NOT claimed"
  commercial_hook="EIP-7623 FloorDataGas is the Prague calldata floor every wallet, relay, and block builder must budget; making z/nz explicit and fail-closing nz*4 overflow is an audit improvement, not a TVL or node-replacement claim"
}

.u{
  repo="https://github.com/ethereum/go-ethereum"
  path="core/state_transition.go"
  params_path="params/protocol_params.go"
  license="LGPL-3.0"
  tag="v1.16.9"
  commit="95665d5703e1023995a0ff93e4ce9eb77e8a59bd"
  git_blob_sha="bf5ac07636d5111c281726a4273d149cb10d1d8e"
  file_sha256="449d50d372cc6ddff95f6ffa4eae29e06d38e248b24bc8501036c04f3e3f0c14"
  params_git_blob_sha="e8b044f45016d851af2698e94c62937218c9d736"
  params_file_sha256="9dd1ccfb0c646f35b4d527f255ddee8173e99a033b0f6fc586340b6bdbfe4c14"
  fixture="test/fixtures/external_proof/FloorDataGas.go"
  params_fixture="test/fixtures/external_proof/eip7623_protocol_params.go"
}

.l{
  clone="src/lin_geth_floordata.lin"
  transpiler_delta="src/lin_from_go.lin v1: REJ_GO_SLICE / REJ_GO_SELECTOR / REJ_GO_ERROR + go_from_go emit (typecheck; lin_c0 vm is VM_REJ_STRING_LITERAL). src/lin_from_c.lin v2 REJ_C_ARRAY_PARAM. Did not mutate gated transpile/c/"
  improvement_1="FloorDataGas is []byte in Geth; LIN takes z/nz as arguments"
  improvement_2="nz*TxTokenPerNonZeroByte is overflow-checked; pinned Geth has no MaxUint64 guard on that multiply"
  improvement_2b="nz=2^62: Geth/Go uint64 wrap returns 21000; LIN fail-closes to 0. Unreachable at MaxBlockSize; not a mainnet consensus bug"
  improvement_3="overflow fail-closes at i64max (published MaxGasLimit) instead of (0, error) vs MaxUint64"
  improvement_4="token-per-zero-byte is explicit (1), matching EIP-7623 rather than implicit +z"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/geth_floordata_c11.c (gcc -O2 -std=c11) plus test/oracles/geth_floordata_go.go"
  gate="test/verify_geth_floordata.sh"
}

.p{
  harness="test/prove_geth_floordata_external.py"
  evidence_json="examples/geth_floordata/geth_floordata_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-geth-floordata"
  goldens="empty 21000; 1z 21010; 1nz 21040; 1+1 21050; 100z 22000; 100nz 25000; 500z+1000nz 66000; 1nz Istanbul intrinsic 21016 Prague charge 21040"
}

.n{
  not_claimed_1="LIN replaces go-ethereum or Ethereum consensus"
  not_claimed_2="uint64 wrap above MaxGasLimit / mainnet calldata of size 2^62"
  not_claimed_3="this clone is a production node or wallet"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="Compiler 0 executes go_from_go string-literal emit"
}

.v{
  method="PINNED_BYTES && PY_I64_EQ_C11 && GO_UINT64_EQ_GETH && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
