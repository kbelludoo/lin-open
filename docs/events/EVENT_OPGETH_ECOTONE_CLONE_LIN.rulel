@RULEL:OPGETH_ECOTONE_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-OPGETH-ECOTONE"
@TITLE="Clone-lin of op-geth newL1CostFuncEcotone / Isthmus operator with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_I64_SCALE"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-opgeth-ecotone"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile OP Stack Ecotone L1 data-availability fee and Isthmus/Jovian operator fee into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Base/OP mainnet"
  operand_width="i64-scale zeroes/ones/fee scalars with 128-bit (a*b)/d; op-geth *big.Int / StateDB / FastLZ are NOT claimed"
  commercial_hook="a wallet that still prices Base/OP txs with Bedrock (calldata-only) undercharges after Ecotone because blobBaseFee*blobScalar is a first-class term; a wallet that keeps Isthmus operator (gas*scalar/1e6) after Jovian undercharges the variable term by 1e8×"
}

.u{
  repo="https://github.com/ethereum-optimism/op-geth"
  tag="v1.101702.3"
  commit="7da4560d1fb3045286b70a8dc23360d2626543f2"
  path="core/types/rollup_cost.go"
  git_blob_sha="3266ae13faaabf599feb4417d60893a11b908fb3"
  file_sha256="35a4e1976fca49cb5f328c6bf3f1513458eda450c9e7425c24a78a8750c51dec"
  test="core/types/rollup_cost_test.go sha256 a1c7d82cdc42ce399bc62fa6ca7b5c68df16ec7786a34408e2c42d6098bb1739 blob c07b53f023725f1758df86e09d9bff6b38ecc317"
  params="params/protocol_params.go TxDataZeroGas=4 TxDataNonZeroGasEIP2028=16 blob 3e9ce4a125308b89ba6dd034061ec59befd29d06"
  license="LGPL-3.0"
  fixture="test/fixtures/external_proof/newL1CostFuncEcotone.go + Bedrock helper + operator + l1CostHelper"
}

.l{
  clone="src/lin_opgeth_ecotone.lin"
  transpiler_delta="src/lin_from_go.lin v14: REJ_GO_ECOTONE / REJ_GO_OPERATOR / REJ_GO_FASTLZ / REJ_GO_FJORD / REJ_GO_L1COST; scalar lift ecoFee; emit '=' + 'ex{'"
  improvement_1="zeroes/ones/l1BaseFee/blobBaseFee/scalars are explicit arguments; op-geth closes over StateDB.GetState(L1Block)"
  improvement_2="named contrast vs Bedrock: same 480 calldata, dropping the blob term undercharges official emptyTx by 900 wei"
  improvement_3="named contrast Isthmus vs Jovian: /1e6 vs *100 on the same gas*scalar (1e8× variable term)"
  improvement_4="128-bit muldiv fail-closes if the quotient does not fit i64; negatives fail-close to 0"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/opgeth_ecotone_c11.c (gcc -O2 -std=c11, __int128) + test/oracles/opgeth_ecotone_go.go"
  gate="python3 test/prove_opgeth_ecotone_external.py"
}

.p{
  harness="test/prove_opgeth_ecotone_external.py"
  evidence_json="examples/opgeth_ecotone/opgeth_ecotone_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-opgeth-ecotone"
  goldens="ecotone emptyTx=960900; noblob=960000; vs_noblob=+900; bedrock=11326000000000; regolith=3710000000000; isthmus=1256417826611659930; jovian=1256650673615173860"
}

.n{
  not_claimed_1="LIN replaces op-geth, Base, Optimism, or OP Stack consensus"
  not_claimed_2="Fjord FastLZ / estimatedDASize / min-transaction-size clamp"
  not_claimed_3="first-Ecotone Bedrock fallback (unset blob+scalar slot)"
  not_claimed_4="uint256 / full-node parity / deposit-tx exemption"
  not_claimed_5="Compiler 0 executes go_from_go string-literal emit (VM_REJ_STRING_LITERAL)"
}

.v{
  method="PINNED_BYTES && PYTHON_BIGINT && C11 && GO && LIN_C0_VM && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
