@RULEL:INDEPENDENT_REPROOF_MELHORIAS:1.0.0
@CHALLENGE_ID="LIN-INDEPENDENT-REPROOF-2026-09-15"
@TITLE="Independent re-execution of recent LIN melhorias (Compound + Floppy + SipHash + JIT + C1-C7 + redteam)"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-09-15"
@CLASS="MIXED_EXPERIMENTAL_AND_PINNED"

~R{.s=scope .p=proved_this_run .n=not_proved .h=hashes .v=verdict}

.s{
  purpose="re-run existing harnesses on a clean Compiler-0 C11 host plus a Python bigint third oracle; do not trust committed evidence JSON"
  prior_agent="bc-38db3af4-3bef-4217-bc7d-b32f5ecaebc3"
  prior_pr="https://github.com/kbelludoo/lin-open/pull/76"
  host="transpile/c/bin/lin_c0 (C11, no Zig) + gcc 13.3 + python3.12 + libtcc from TinyCC"
}

.p{
  compound_harness="test/prove_compound_jumprate_external.py → 13 PASS then PY-BIGINT/I64-WRAP added"
  compound_independent="test/prove_melhorias_independent.py (Python int vs LIN vm vs C11 __int128)"
  compound_c0_vm="cjr_muldiv(100,200,50) value=400 steps=11301; cjr_test_suite value=1 steps=167969"
  compound_c0_jit="roundtrip-jit CONSENSUS fn=cjr_test_suite value=1"
  compound_borrow_50="11891171993 (Python == LIN == C11)"
  compound_mult_block="23782343987 (Solidity (a*BASE)/(blocks*kink) == LIN reorder on this vector)"
  i64_wrap="signed i64 of 1e18*1e18 = -5527149226598858752; bigint (1e18*1e18)/(2e18) = 5e17"
  floppy="python3 test/test_floppy_lin.py → 4/4 PASS (dispute expected_out=19743 vs claimed 150000)"
  siphash="python3 test/prove_siphash_real_external.py → 64/64 GCC C == LIN JIT vs veorq/SipHash vectors.h"
  siphash_upstream="https://github.com/veorq/SipHash commit 32d067603b93b47828700880649198e0bfbbcffa"
  jit_gate="test/verify_c0_jit.sh → 12 ok, 0 falhas (incl. vms_gate 33 opcodes)"
  rationalist="test/prove_all_claims_external.py --iterations 10000 → C1..C7 PASS after building lin_c_receipt"
  c4_root="sha256:a6d17453df142262535f2ea3e4a554c6de75bfae256f39124f6f01ff769afd57"
  redteam="bash test/test_redteam_fixes_external.sh → 17 passed, 0 failed (LRT-01/02/03)"
}

.n{
  not_1="full Solidity uint256 / mainnet Compound cToken parity"
  not_2="LIN replaces Compound, Uniswap, or EVM in production"
  not_3="general wall-clock superiority vs solc/LLVM/C/Rust (SipHash 20.8x is compile-turnaround on this host, not a kernel benchmark)"
  not_4="computational soundness of Merkle receipts (tamper-evidence only; C4 proves independent SHA-256 recompute + output-tamper reject)"
  not_5="SipHash ASan vs LIN OOB clamp is a measured harness contrast, not a memory-safety theorem for all programs"
  first_c4_fail="C4 FAIL until make -C transpile/c all produced bin/lin_c_receipt — missing binary, not a false math claim"
  c4_fix="rationalist-proof and receipt_claims now build lin_c_receipt via make -C transpile/c xver (no Zig)"
}

.h{
  jumprate_sol_sha256="9cd2fe5f7b88748c336bf2988c475da517ffd4909057b53df138b80f162fb34f"
  jumprate_sol_blob="4d6828c39ed737c0c48508adc414b919ab6c2a55"
  compound_protocol_commit="a3214f67b73310d547e00fc578e8355911c9d376"
}

.v{
  method="RECOMPUTE_HASHES && PYTHON_BIGINT && LIN_C0_VM && C11_I128 && OPTIONAL_JIT_CONSENSUS && REPLAY_EXISTING_HARNESSES"
  on_fail="do not publish PASS"
}
