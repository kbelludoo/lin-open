@RULEL:INDEPENDENT_REPROOF_MELHORIAS:1.1.0
@CHALLENGE_ID="LIN-INDEPENDENT-REPROOF-2026-09-15"
@TITLE="Independent re-execution of Compound uint64 melhorias plus honesty labels"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-09-15"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved_this_run .n=not_proved .h=hashes .v=verdict}

.s{
  purpose="re-run Compound JumpRate harnesses with a standalone Python oracle; do not trust committed evidence JSON; do not sell non-proofs as proofs"
  prior_pr_76="https://github.com/kbelludoo/lin-open/pull/76"
  prior_pr_79="https://github.com/kbelludoo/lin-open/pull/79"
  host="transpile/c/bin/lin_c0 (C11, no Zig) + gcc + python3 + libtcc when present"
}

.p{
  real_1="explicit IRM arguments: same cash/borrows, different kink => different borrow rate"
  real_2="(a*b)/d 128-bit product: (1e18*1e18)/2e18 = 5e17; signed i64 of 1e18*1e18 wraps"
  real_3="uint64 quotient overflow fail-closes to 0 instead of truncating low 64 bits"
  python_oracle="test/oracles/compound_jumprate_py.py"
  independent="test/prove_melhorias_independent.py"
  documented_vs_solidity="cash+borrows < reserves returns 0 here; Solidity 0.8 reverts"
  c4_binary="first C4 FAIL on the prior run was missing bin/lin_c_receipt; make -C transpile/c all builds it. Not false math."
  c4_meaning="C4 = independent SHA-256 root recompute + output-tamper reject. Tamper-evidence, not zk soundness."
}

.n{
  not_1="full Solidity uint256 / mainnet Compound cToken parity"
  not_2="LIN replaces Compound, Uniswap, or EVM in production"
  not_3="general wall-clock superiority vs solc/LLVM/C/Rust (SipHash 20.8x is compile-turnaround on this host, not a kernel benchmark)"
  not_4="computational soundness of Merkle receipts"
  not_5="JumpRate clone is a sol_from_sol dump of BaseJumpRateModelV2.sol (it is hand-written; getBorrowRateInternal is view)"
}

.h{
  jumprate_sol_sha256="9cd2fe5f7b88748c336bf2988c475da517ffd4909057b53df138b80f162fb34f"
  jumprate_sol_blob="4d6828c39ed737c0c48508adc414b919ab6c2a55"
  compound_protocol_commit="a3214f67b73310d547e00fc578e8355911c9d376"
}

.v{
  method="RECOMPUTE_HASHES && PYTHON_ORACLE && LIN_C0_VM && C11_I128 && BEHAVIORAL_EXPLICIT_ARGS && OPTIONAL_JIT"
  on_fail="do not publish PASS"
}
