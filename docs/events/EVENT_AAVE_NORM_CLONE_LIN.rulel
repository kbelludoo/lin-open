@RULEL:AAVE_NORM_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-AAVE-NORM-V1"
@TITLE="Clone-lin of Aave V3 getNormalizedIncome/getNormalizedDebt with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-aave-norm"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Aave V3 aToken/variable-debt index math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, RAY'=1e9, dt explicit, 128-bit product; Solidity uint256 / RAY=1e27 / block.timestamp is NOT claimed"
  commercial_hook="getNormalizedIncome is the aToken exchange-rate kernel (scaled balance * index); making block.timestamp an explicit dt is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/aave/aave-v3-core"
  path_income="contracts/protocol/libraries/logic/ReserveLogic.sol"
  path_math="contracts/protocol/libraries/math/MathUtils.sol"
  license="MIT after BUSL-1.1 Change Date 2023-01-27"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  reserve_logic_blob="bc48163dbbfcac7c832d2e9dfef71a9ddadfe836"
  reserve_logic_sha256="6b827ea494fa5bb1b38fa9e7db973bd0aed0ee3d53677cac950f6614cb8fd0c9"
  math_utils_blob="9adca939db36cbe1009d0a00600def9314fc7332"
  math_utils_sha256="7f73c927e9801debfe0666e2a6364b92f62fd2d58d0c4b485ff04765fd4dc58d"
  vendored=false
}

.l{
  clone="src/lin_aave_norm.lin"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-aave-norm"
  transpiler_delta="src/lin_from_solidity.lin v3: uint40 + N days expansion + REJ_SOLIDITY_AAVE_NORM; src/lin_from_c.lin v2 REJ_C_TIME/REJ_C_AAVE_NORM; src/lin_from_rust.lin v2 REJ_RUST_TIME/REJ_RUST_AAVE_NORM"
  improvement_1="Aave getNormalizedIncome is view-on-storage with block.timestamp; LIN takes rate, index, dt as arguments"
  improvement_2="MathUtils uses `365 days`; Solidity transpiler now expands N days|hours|minutes|weeks|seconds (365 days -> 31536000)"
  improvement_3="uint40 (Aave lastUpdateTimestamp) is a recognized Solidity integer type"
  improvement_4="typical 5% APR binomial x^2/x^3 terms floor to 0 at RAY'=1e9; extreme rate 1e12 keeps a distinct second term — documented scale limit"
  improvement_5="naive i64 1e10*1e10 wraps; 128-bit rayMul -> 1e11"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/aave_norm_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="make aave-norm-proof"
}

.p{
  harness="test/prove_aave_norm_external.py"
  evidence_json="examples/aave_norm/aave_norm_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-aave-norm"
}

.n{
  not_claimed_1="full uint256 / mainnet RAY=1e27 / aToken parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production pool or aToken replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Aave, Uniswap, or the EVM"
  not_claimed_6="rayMul/wadMul/IRM (separate clone-lin repos)"
  not_claimed_7="any TVL or dollar-savings figure"
  not_claimed_8="nonzero binomial extra terms at typical APRs on this uint64 scale"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
