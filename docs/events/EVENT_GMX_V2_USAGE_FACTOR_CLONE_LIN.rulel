@RULEL:GMX_V2_USAGE_FACTOR_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-GMX-V2-USAGE-FACTOR"
@TITLE="Clone-lin of GMX V2 getUsageFactor with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-gmx-v2-usage-factor"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile GMX V2 usage factor (toFactor(reserved, applyFactor(pool, reserveFactor))) into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Arbitrum GMX V2"
  operand_width="int64 unsigned reserved/pool/reserveFactor + FLOAT 1e6; Solidity uint256 / FLOAT 1e30 is NOT claimed"
  commercial_hook="GMX V2 usage is reserved / (pool * reserveFactor), not reserved/pool. Treating utilization as reserved/pool understates usage by 1/reserveFactor (2x at a typical 50% cap). Nested floor of applyFactor then toFactor is strictly larger than fused reserved*FLOAT^2/(pool*factor) when the inner remainder is nonzero. Making the nested mulDiv, the uncapped over-reserve, and fail-closed overflow explicit is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/gmx-io/gmx-synthetics"
  path="contracts/market/MarketUtils.sol"
  precision_path="contracts/utils/Precision.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  git_blob_sha="ad7a0b2b5a516ec86ce0afed89ff84ecba11038c"
  file_sha256="8dfd271e4fc8e18d6a114b674dc1f520f38f6acd1f9c9a58b4b7509fe86e748f"
  precision_git_blob_sha="047143722beaf6adceac3fc2ef1817f054dfe00a"
  precision_file_sha256="8713db02a257238101fc62cc682a8f8061fba25951216863576afbbd00f34808"
  fixture="test/fixtures/external_proof/GetUsageFactor.excerpt.sol"
}

.l{
  clone="src/lin_gmx_v2_usage_factor.lin"
  prefix="g2u_"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_GMX_V2_USAGE before ENV; Chain.currentTimestamp is ENV; split equals then ex-brace emit. src/lin_from_rust.lin v2: REJ_RUST_GMX_V2_USAGE"
  improvement_1="reserved, pool, and reserveFactor are explicit arguments; DataStore / isLong storage key lifted"
  improvement_2="usage is toFactor(reserved, applyFactor(pool, reserveFactor)), not reserved/pool"
  improvement_3="nested floor of applyFactor raises usage versus fused reserved*FLOAT^2/(pool*factor)"
  improvement_4="reserved=0 early-returns 0 even when maxReserved=0; reserved>0 and maxReserved=0 fail-closes"
  improvement_5="pool*rfactor and reserved*FLOAT overflow fail-close instead of wrapping; over-reserve is not capped at FLOAT"
  named_contrast_1="Compound utilizationRate is borrows*BASE/(cash+borrows-reserves), not nested GMX usage"
  named_contrast_2="getBorrowingFees is a single applyFactor USD fee, not a 0-1 usage factor"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/gmx_v2_usage_factor_c11.c (gcc -O2 -std=c11, __int128 XOR portable umul_ok)"
  gate="test/verify_gmx_v2_usage_factor.sh"
}

.p{
  harness="test/prove_gmx_v2_usage_factor_external.py"
  evidence_json="examples/gmx_v2_usage_factor/gmx_v2_usage_factor_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-gmx-v2-usage-factor"
}

.n{
  not_claimed_1="full uint256 / Arbitrum GMX V2 mainnet parity / FLOAT 1e30"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production GMX market replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces GMX, Uniswap, or the EVM"
  not_claimed_6="this is reserved/pool utilization, Compound utilizationRate, fused FLOAT^2 mulDiv, or getBorrowingFees"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_PORTABLE && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
