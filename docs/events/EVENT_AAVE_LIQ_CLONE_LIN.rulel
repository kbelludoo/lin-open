@RULEL:AAVE_LIQ_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-AAVE-LIQ-AVAILABLE-COLLATERAL"
@TITLE="Clone-lin of Aave V3 _calculateAvailableCollateralToLiquidate with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-aave-liq"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Aave V3 liquidation available-collateral / close-factor math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs WAD'=1e9 PERCENTAGE_FACTOR=1e4 half-up 128-bit (a*b+add)/d; Solidity uint256 / WAD=1e18 oracle/aToken is NOT claimed"
  commercial_hook="LiquidationLogic._calculateAvailableCollateralToLiquidate is how every Aave V3 liquidation prices collateral against debt, applies the close factor and splits the bonus with the protocol fee. Making oracle prices and configuration explicit arguments, fail-closing zero prices, and using 128-bit half-up percentMul instead of wrapping i64 is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/aave/aave-v3-core"
  path="contracts/protocol/libraries/logic/LiquidationLogic.sol"
  math_path="contracts/protocol/libraries/math/PercentageMath.sol"
  license="MIT_after_BUSL_Change_Date_2023-01-27"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  git_blob_sha="57f00fd47d14af2643dd8103a47adb70b664ec00"
  file_sha256="4fecfabd4ebbeccba176f41b3417dd5b3f16d65100d9e9cd373b7ed0dec51d5a"
  pct_blob="c000be3a6c38a959aa3d28737445eaa5762c53b0"
  pct_sha256="6f165ad32ddcc3383cbb611cc3045c1a4bb28f16f83a85015fe202803de0161f"
  fixture="test/fixtures/external_proof/aave_liq.pin.rulel"
}

.l{
  clone="src/lin_aave_liq.lin"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-aave-liq"
  transpiler_delta="src/lin_from_solidity.lin: REJ_SOLIDITY_LIQUIDATION / REJ_SOLIDITY_HALF_RAY27 + 0.XeN expand (0.5e4, 0.95e18); src/lin_from_c.lin v2 REJ_C_LIQUIDATION; src/lin_from_rust.lin v2 REJ_RUST_LIQUIDATION"
  improvement_1="oracle.getAssetPrice and reserve configuration become explicit price/unit/bonus/fee arguments"
  improvement_2="percentMul uses 128-bit half-up; naive i64 1e15*10500 wraps to -7946744073709551616"
  improvement_3="collateralPrice=0 or debtUnit=0 fail-closes to 0 (Solidity divides by zero / reverts)"
  improvement_4="0.5e4 and 0.95e18 now expand in the Solidity transpiler; 0.5e27 still fail-closes (does not fit i64)"
  improvement_5="close factor is a pure function of HF vs 0.95*WAD' (50% vs 100%), not hidden storage"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/aave_liq_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="make aave-liq-proof"
}

.p{
  harness="test/prove_aave_liq_external.py"
  evidence_json="examples/aave_liq/aave_liq_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-aave-liq"
}

.n{
  not_claimed_1="full uint256 / mainnet WAD=1e18 / Chainlink oracle / aToken parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production Aave liquidation replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="any TVL or dollar-savings figure"
  not_claimed_6="percentMul as a standalone clone (see clone-lin-aave-percent)"
  not_claimed_7="health-factor account data (see clone-lin-aave-health)"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
