@RULEL:COMPOUND_EXRATE_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-COMPOUND-CTOKEN-EXRATE"
@TITLE="Clone-lin of Compound CToken.exchangeRateStoredInternal with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-compound-xrate"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Compound v2 cToken exchange-rate math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs SCALE=1e9, 128-bit (a*b)/d; Solidity uint256 / expScale=1e18 / getCashPrior is NOT claimed"
  commercial_hook="exchangeRateStoredInternal is how every Compound v2 cToken prices shares for mint/redeem/liquidate: (cash+borrows-reserves)*expScale/totalSupply, or initialExchangeRate when supply is 0. Making cash/borrows/reserves/supply/scale/initial explicit, fail-closing getCashPrior in the transpiler, and replacing wrapping i64 multiply with 128-bit muldiv is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/compound-finance/compound-protocol"
  path="contracts/CToken.sol"
  math_path="contracts/ExponentialNoError.sol"
  license="BSD-3-Clause"
  commit="a3214f67b73310d547e00fc578e8355911c9d376"
  git_blob_sha="b8c878c79c75855808f6e7303099a367c8bad98b"
  file_sha256="b64790f41ef851b09856af286ce8253b95ef34fda4ae836f924a519e8f792785"
  exp_blob="23f833760db898ebdc6b2fef9654cb9bc1dd21c3"
  exp_sha256="dd272760b2d9082db9c94f6198896402fe3681bf41fc3f9d8bba31ada290c3c5"
  fixture="test/fixtures/external_proof/compound_exrate.pin.rulel"
}

.l{
  clone="src/lin_compound_exrate.lin"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-compound-xrate"
  transpiler_delta="src/lin_from_solidity.lin: REJ_SOLIDITY_CASH_PRIOR (getCashPrior / address(this).balance / .balanceOf() before OK_VIEW) + 0.XeN expand (0.02e18 initial mantissa); src/lin_from_c.lin REJ_C_CASH_PRIOR; src/lin_from_rust.lin REJ_RUST_CASH_PRIOR"
  improvement_1="storage cash/borrows/reserves/supply/scale/initial become explicit arguments; getCashPrior is not a hidden ERC-20/ETH read"
  improvement_2="128-bit (underlying*scale)/supply; naive i64 2e15*1e9 wraps to 4007528410413793280"
  improvement_3="cash+borrows-reserves underflow fail-closes to 0 (Solidity 0.8 reverts)"
  improvement_4="zero totalSupply returns explicit initial (0.02*SCALE); 0.02e18 now expands in the Solidity transpiler"
  improvement_5="view functions that call getCashPrior are no longer OK_VIEW"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/compound_exrate_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="make compound-exrate-proof"
}

.p{
  harness="test/prove_compound_exrate_external.py"
  evidence_json="examples/compound_exrate/compound_exrate_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-compound-xrate"
}

.n{
  not_claimed_1="full uint256 / mainnet expScale=1e18 / live cToken parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production cToken replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="any TVL or dollar-savings figure"
  not_claimed_6="getCashPrior ERC-20/ETH balance (fail-closed)"
  not_claimed_7="accrueInterest as this clone (see clone-lin-compound-accrue)"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
