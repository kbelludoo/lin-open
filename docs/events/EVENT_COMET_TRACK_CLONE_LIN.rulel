@RULEL:COMET_TRACK_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-COMET-TRACKING-INDEX"
@TITLE="Clone-lin of Compound III tracking-index / divBaseWei with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-comet-track"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Compound III trackingSupplyIndex wrap (divBaseWei(speed*dt, totalSupplyBase)) into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, 128-bit product for (speed*dt) then (n*baseScale)/total; Solidity uint256 is NOT claimed"
  commercial_hook="Comet rewards tracking uses baseScale (10**decimals, 1e6 on USDC), not FACTOR_SCALE=1e18 and not BASE_INDEX_SCALE=1e15. Feeding FACTOR as the tracking scale inflates USDC deltas ~1e12x. Reordering (speed*scale/total)*dt truncates to 0 on the same USDC vector that Comet reports 2. This is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/compound-finance/comet"
  path="contracts/CometWithExtendedAssetList.sol"
  core="contracts/CometCore.sol FACTOR_SCALE=1e18 BASE_INDEX_SCALE=1e15 BASE_ACCRUAL_SCALE=1e6"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2025-12-31 elapsed; Change License GPL-2.0-or-later"
  commit="f766f51583c23acc33b2a7824654ef2029a96804"
  git_blob_sha="3490e984d133789aa1afe2e8f7e37a11d2512396"
  file_sha256="c9099e56eda092fd0150005706edf086723899afb102f164b60ad1f36a426961"
  core_git_blob_sha="534f2701b6c8e683f9294112b0bcc23878d39fe6"
  core_file_sha256="1d80f0d12c101d01c2e1f38e8662cfcf350299b1c78188f8c501bb1c51b5ec78"
  fixture="test/fixtures/external_proof/CometTrackingIndex.excerpt.sol"
}

.l{
  clone="src/lin_comet_track.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_TRACK_DT / DIV_BASE_WEI / BASE_SCALE_WRAP / RATE_TIME / GETTER; emit splits '=' + 'ex{'. src/lin_from_rust.lin v2: REJ_RUST_TRACK_DT / REJ_RUST_BASE_SCALE"
  improvement_1="divBaseWei is view-on-storage (immutable baseScale); LIN takes baseScale as an argument"
  improvement_2="speed * timeElapsed then * baseScale overflows i64; LIN uses schoolbook 128-bit muldiv matching C11 __int128"
  improvement_3="empty or below-min supply: Solidity 0.8 reverts on /0 or skips the increment; LIN fail-closes 0 (c3t_track_ok=0)"
  improvement_4="reorder (speed*baseScale/total)*dt is a named rejected path (0 vs 2 on USDC 2/5/1e6/4e6)"
  improvement_5="named contrast vs mulFactor / FACTOR_SCALE / BASE_INDEX_SCALE: USDC 6-dec comet=1, FACTOR confusion=1e12, INDEX=1e9, mulFactor-as-track=0; WETH 18-dec hides the FACTOR bug (both=1)"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/comet_track_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_comet_track.sh"
}

.p{
  harness="test/prove_comet_track_external.py"
  evidence_json="examples/comet_track/comet_track_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-comet-track"
}

.n{
  not_claimed_1="full uint256 / mainnet Comet market parity"
  not_claimed_2="getUtilization / presentValue / accruedInterestIndices (separate clones)"
  not_claimed_3="LIN is faster than the EVM or solc"
  not_claimed_4="this clone is a production rewards-index replacement"
  not_claimed_5="LIN replaces Compound, Uniswap, or the EVM"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS && SCALE_CONTRAST && REORDER_REJECT"
  on_fail="do not publish a PASS status"
}
