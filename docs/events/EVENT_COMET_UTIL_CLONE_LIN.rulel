@RULEL:COMET_UTIL_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-COMET-GET-UTILIZATION"
@TITLE="Clone-lin of Compound III getUtilization with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-comet-util"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Compound III present-value utilization wrap into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, 128-bit product for (borrow_pv*FACTOR_SCALE)/supply_pv; Solidity uint256 is NOT claimed"
  commercial_hook="getUtilization is the input to Compound III IRM getSupplyRate/getBorrowRate; treating V2 cash+borrows as III present-value totals doubles utilization on 1e18/1e18 (50% vs 100%). This is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/compound-finance/comet"
  path="contracts/CometWithExtendedAssetList.sol"
  core="contracts/CometCore.sol FACTOR_SCALE=1e18"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2025-12-31 elapsed; Change License GPL-2.0-or-later"
  commit="f766f51583c23acc33b2a7824654ef2029a96804"
  git_blob_sha="3490e984d133789aa1afe2e8f7e37a11d2512396"
  file_sha256="c9099e56eda092fd0150005706edf086723899afb102f164b60ad1f36a426961"
  core_git_blob_sha="534f2701b6c8e683f9294112b0bcc23878d39fe6"
  core_file_sha256="1d80f0d12c101d01c2e1f38e8662cfcf350299b1c78188f8c501bb1c51b5ec78"
  fixture="test/fixtures/external_proof/CometGetUtilization.excerpt.sol"
}

.l{
  clone="src/lin_comet_util.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_UTIL_WRAP / presentValueSupply GETTER / FACTOR_SCALE; emit splits '=' + 'ex{'. src/lin_from_rust.lin v2: REJ_RUST_UTIL_WRAP"
  improvement_1="getUtilization is view-on-storage (baseSupplyIndex, totalSupplyBase); LIN takes present-value totals as arguments"
  improvement_2="totalBorrow_ * FACTOR_SCALE overflows i64; LIN uses schoolbook 128-bit muldiv matching C11 __int128"
  improvement_3="empty supply: Solidity skips the div; LIN fail-closes 0 (c3u_util_ok=0)"
  improvement_4="two-step floor(borrow/supply)*FACTOR is a named rejected path (0 vs 5e17 at 50% util)"
  improvement_5="named contrast vs Compound V2 JumpRate utilization: same 1e18 cash/borrows -> V2 50%, III 100%"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/comet_util_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_comet_util.sh"
}

.p{
  harness="test/prove_comet_util_external.py"
  evidence_json="examples/comet_util/comet_util_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-comet-util"
}

.n{
  not_claimed_1="full uint256 / mainnet Comet market parity"
  not_claimed_2="presentValue / principalValue / accruedInterestIndices (separate clones)"
  not_claimed_3="LIN is faster than the EVM or solc"
  not_claimed_4="this clone is a production IRM replacement"
  not_claimed_5="LIN replaces Compound, Uniswap, or the EVM"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS && V2_CONTRAST"
  on_fail="do not publish a PASS status"
}
