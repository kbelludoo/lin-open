@RULEL:AAVE_PERCENT_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-AAVE-V3-PERCENT"
@TITLE="Clone-lin of Aave V3 PercentageMath percentMul/percentDiv with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_I64_POSITIVE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-aave-percent"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Aave V3 PercentageMath bps half-up into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="i64-positive inputs; 128-bit product plus addend for (a*b+HALF)/1e4; Solidity uint256 is NOT claimed"
  commercial_hook="PercentageMath is the bps library of Aave V3 (LTV, liquidation threshold, liquidation bonus, flash-loan premium); proving half-up percentMul vs floor and proving naive i64 wrap on 3e18*5000 is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/aave/aave-v3-core"
  path="contracts/protocol/libraries/math/PercentageMath.sol"
  license="MIT"
  license_note="BUSL-1.1 Change Date 2023-01-27 elapsed; Change License MIT"
  commit="782f51917056a53a2c228701058a6c3fb233684a"
  git_blob_sha="c000be3a6c38a959aa3d28737445eaa5762c53b0"
  file_sha256="6f165ad32ddcc3383cbb611cc3045c1a4bb28f16f83a85015fe202803de0161f"
  fixture="test/fixtures/external_proof/PercentageMath.sol"
}

.l{
  clone="src/lin_aave_percent.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: 0.5eN expand + REJ_SOLIDITY_AAVE_PERCENT; src/lin_from_rust.lin v2 REJ_RUST_AAVE_PERCENT; src/lin_from_c.lin v2 REJ_C_AAVE_PERCENT"
  improvement_1="upstream percentMul is Yul (a*b+HALF_PERCENTAGE_FACTOR)/PERCENTAGE_FACTOR; LIN takes explicit 128-bit (a*b+add)/d and fail-closes if the quotient does not fit i64"
  improvement_2="half-up named goldens: percentMul(3,0.5e4)=2 vs floor 1; percentDiv(2,3)=6667 vs floor 6666"
  improvement_3="naive i64 (3e18*5000) wraps to 2797068074134536192; 128-bit percentMul yields 1.5e18"
  improvement_4="percentMul(4e18, 30000)=1.2e19 does not fit i64 and fail-closes to 0 (no silent wrap)"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/aave_percent_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_aave_percent.sh"
}

.p{
  harness="test/prove_aave_percent_external.py"
  evidence_json="examples/aave_percent/aave_percent_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-aave-percent"
}

.n{
  not_claimed_1="full uint256 / mainnet Aave pool parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production pool or oracle replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Aave, Uniswap, or the EVM"
  not_claimed_6="LIN saves Aave TVL / any dollar figure derived from TVL"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
