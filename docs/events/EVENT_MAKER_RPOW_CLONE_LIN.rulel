@RULEL:MAKER_RPOW_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-DSR-RPOW"
@TITLE="Clone-lin of MakerDAO pot.rpow (Dai Savings Rate) with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_RAY9"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-rpow"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile MakerDAO pot.rpow DSR compounding into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, RAY'=1e9, 128-bit product for (a*b + base/2)/base; Solidity RAY=1e27 is NOT claimed"
  commercial_hook="pot.rpow is the inner loop of every Dai Savings Rate drip; skipping half-up rounding or wrapping x*x in i64 compounds the wrong chi. Making dsr/dt/chi explicit with 128-bit muldiv is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/makerdao/dss"
  path="src/pot.sol"
  license="AGPL-3.0-or-later"
  commit="3f30552a586264b32ebdb5bac94ba67020282e53"
  tag="1.3.0"
  git_blob_sha="13ddce04785a0c9dc49bb8a95c441e25f4263d10"
  file_sha256="3b20c6285e7eeec097ef20d2065e4aa1773588b9e1f127b9afe19ca3543928bb"
  fixture="test/fixtures/external_proof/pot.sol"
}

.l{
  clone="src/lin_maker_rpow.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_RPOW/RAY; emit split = + ex{ so C0 does not steal the export list; src/lin_from_rust.lin v2 REJ_RUST_RPOW"
  improvement_1="rpow(3,2,2)=5 with Maker half-up; skip-round floor=4"
  improvement_2="naive i64 (5e9*5e9)/1e9 wraps to 6553255926; 128-bit rpow=25000000000"
  improvement_3="0^0 returns base (1e9); 0^5 returns 0"
  improvement_4="drip chi'=rmul(rpow(1.05e9,2,RAY'),2e9)=2205000000 vs identity chi when dt=0"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_rpow_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="python3 test/prove_maker_rpow_external.py"
}

.p{
  harness="test/prove_maker_rpow_external.py"
  evidence_json="examples/maker_rpow/maker_rpow_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-rpow"
}

.n{
  not_claimed_1="full uint256 / RAY=1e27 / mainnet pot.drip / vat.suck parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production DSR replacement"
  not_claimed_4="retread of Lido/Rocket/Morpho share-rate or Aave rayMul as the kernel"
  not_claimed_5="LIN replaces Maker, Sky, or the EVM"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
