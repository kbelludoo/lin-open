@RULEL:LIDO_SHARES_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-LIDO-STETH-SHARE-RATE"
@TITLE="Clone-lin of Lido stETH getSharesByPooledEth with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-lido-shares"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Lido stETH share-rate math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, 128-bit product for (a*b)/d; Solidity uint256 is NOT claimed"
  commercial_hook="Lido view converters have no virtual offset. Empty protocol is on-chain div0 (LIN fail-closes 0). A wallet that prices stETH with OZ ERC-4626 +1/+1 or Morpho VIRTUAL_SHARES=1e6 mis-counts empty and post-donation shares. Not a TVL claim."
}

.u{
  repo="https://github.com/lidofinance/lido-dao"
  tag="v4.1.0"
  commit="1440c830eb1d0916a436468a71cd73bc8b8deffb"
  path="contracts/0.4.24/StETH.sol"
  math_path="contracts/common/lib/Math256.sol"
  license="GPL-3.0"
  math_license="MIT"
  git_blob_sha="b8c8d47f2571d018c938d994c4debf375b84b45a"
  math_git_blob_sha="366a014cf49523980e06ae7efb4cb3199589fc00"
  file_sha256="63ebed0e205b602fe2e427bb09c111479f98253bd02f96ac052b38202d3713bd"
  math_file_sha256="028e9b0c87fea3ec6fd5aac9e7a5724a18b4a175d5ab70159f24428dd28ea6b6"
  fixture="test/fixtures/external_proof/StETH.sol"
  math_fixture="test/fixtures/external_proof/Math256.sol"
}

.l{
  clone="src/lin_lido_shares.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_LIBCALL (.ceilDiv/.mulDiv*) / REJ_SOLIDITY_GETTER / REJ_SOLIDITY_OVERFLOW_CEIL / REJ_SOLIDITY_USING; emit '=' + 'ex{'; src/lin_from_rust.lin v2 REJ_RUST_OVERFLOW_CEIL / REJ_RUST_DIV_CEIL"
  improvement_1="hidden _getShareRateNumerator/_getShareRateDenominator/_getTotalPooledEther/_getTotalShares become arguments"
  improvement_2="empty totalEther is on-chain div0; LIN fail-closes to 0 (documented)"
  improvement_3="Math256.ceilDiv is a libcall; LIN ceil is remainder+1 after 128-bit product (not (a+b-1)/b wrap)"
  improvement_4="uint128 input cap is vacuously true at uint64 scale; quotient that does not fit uint64 fail-closes to 0"
  improvement_5="named contrast vs Morpho VIRTUAL_SHARES=1e6 and OZ ERC-4626 +1/+1; wstETH wrap is not the point"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/lido_shares_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_lido_shares.sh"
}

.p{
  harness="test/prove_lido_shares_external.py"
  evidence_json="examples/lido_shares/lido_shares_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-lido-shares"
}

.n{
  not_claimed_1="full uint256 / mainnet stETH / wstETH wrap parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production staking-router replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Lido, Morpho, Uniswap, or the EVM"
  not_claimed_6="TVL or live inflation-attack profit"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
