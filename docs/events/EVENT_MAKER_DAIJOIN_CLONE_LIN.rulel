@RULEL:MAKER_DAIJOIN_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-DAIJOIN"
@TITLE="Clone-lin of Maker/Sky DaiJoin.join/exit with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-14"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-daijoin"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Maker DaiJoin.join/exit wad-to-rad adapter math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs; RAY'=1e9; Solidity uint256 rad/wad/ray ONE=1e27 is NOT claimed"
  commercial_hook="DaiJoin is the ERC20 DAI adapter: every DAI that enters or leaves the Maker/Sky vat is wad*RAY rad. Making live/from_dai/to_dai/token/wad explicit, preserving join-after-cage, and replacing wrapping i64 multiply with fail-closed mul, is an audit improvement for adapter simulators, not a TVL claim"
}

.u{
  repo="https://github.com/makerdao/dss"
  path="src/join.sol"
  function="DaiJoin.join / DaiJoin.exit / mul(ONE, wad)"
  license="AGPL-3.0-or-later"
  commit="fa4f6630afb0624d04a003e920b0d71a00331d98"
  git_blob_sha="42b01c91c8f2a6b776440e16dea2c94497d966b0"
  file_sha256="96fceff4511aa976db5c6b144d83f4dd1bde832dd2f49fd6e54e69343b9583f9"
  vendored=false
}

.l{
  clone="src/lin_maker_daijoin.lin"
  transpiler_delta="src/lin_from_solidity.lin REJ_SOLIDITY_DAI_BURN/DAI_MINT/DAIJOIN_LIVE; src/lin_from_c.lin REJ_C_DAI_BURN/DAI_MINT/WIDE_INT; src/lin_from_rust.lin REJ_RUST_DAI_BURN/DAI_MINT/WIDE_INT"
  improvement_1="join/exit are storage+ERC20+vat.move in Solidity; LIN takes op/live/from_dai/to_dai/token/wad as arguments"
  improvement_2="RAY*wad overflow i64; LIN fail-closes instead of wrapping (C11 wrap-detect XOR __int128)"
  improvement_3="join does not require live (Maker cage still accepts join); exit fail-closes unless live==1"
  improvement_4="distinct from vat.move (rad transfer already cloned) and GemJoin (ilk slip): this kernel is wad→rad adapter plus burn/mint balances"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_daijoin_c11.c (gcc -O2 -std=c11, __int128 XOR wrap-detect)"
  gate="test/verify_maker_daijoin.sh"
}

.p{
  harness="test/prove_maker_daijoin_external.py"
  evidence_json="examples/maker_daijoin/maker_daijoin_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-daijoin"
}

.n{
  not_claimed_1="full uint256 / mainnet rad/wad/ray / ERC20 mint-burn host / vat.move host parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production DaiJoin replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Maker, Sky, DaiJoin, or the EVM"
  not_claimed_6="TVL or dollar savings from this kernel"
}

.v{
  method="PINNED_BYTES && C11_WRAP_EQ_I128 && LIN_C0_VM_EQ_C11 && PYTHON_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
