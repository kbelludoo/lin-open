@RULEL:MAKER_ABACUS_EXP_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-ABACUS-EXP"
@TITLE="Clone-lin of Maker ExponentialDecrease.price with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-13"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-abacus-exp"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Maker Dutch-auction continuous exponential decay into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, RAY'=1e9 (not RAY=1e27); 128-bit half-up rpow product"
  commercial_hook="ExponentialDecrease is the Clipper abacus used when Maker/Sky wants per-second Dutch-auction decay: price = rmul(top, rpow(cut, dur, RAY)). Same file as LinearDecrease and StairstepExponentialDecrease; this clone is n=dur (no step SLOAD). Making cut explicit and replacing wrapping i64 multiply plus inline assembly rpow with 128-bit half-up rpow is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/makerdao/dss"
  path="src/abaci.sol ExponentialDecrease.price"
  license="AGPL-3.0-or-later"
  commit="fa4f6630afb0624d04a003e920b0d71a00331d98"
  git_blob_sha="6cbd666267fc9f534ae52a45926eec5aa44b3bc5"
  file_sha256="a4c3dc0368d66a5bf84e586f0cf76e2e80fb8b336c00348a97cc0d4ddcb016ca"
  vendored=false
}

.l{
  clone="src/lin_maker_abacus_exp.lin"
  transpiler_delta="src/lin_from_solidity.lin v2.2: emit OK_VIEW; rewrite ||/&&; assembly rpow stays REJ_SOLIDITY_INLINE_ASM; sol_abacus_kind classifies LINEAR / STAIR / EXP. src/lin_sol_view_lift.lin lifts cut+RAY from the continuous view price body and must not invent step"
  improvement_1="price is view-on-storage in Solidity (cut, wards); LIN takes top/dur/cut as arguments, no msg.sender, no file(), no block.timestamp, no step"
  improvement_2="upstream rpow is Yul assembly; LIN uses schoolbook 128-bit half-up muldiv matching C11 __int128; quotient that does not fit uint64 fail-closes to 0"
  improvement_3="cut>RAY' (file() reject) fail-closes. There is no step==0 path because n=dur"
  improvement_4="continuous n=dur decays at dur=1 (price=0.99*top for cut=0.99*RAY'); StairstepExponentialDecrease with step=90 would still equal top. dur=89 is 408820172, not a hold-at-top"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_abacus_exp_c11.c (gcc -O2 -std=c11, __int128 and wrap-detect)"
  kernel="test/oracles/maker_abacus_exp_kernel.c (pointer-free, lin_from_c eligible)"
  gate="test/verify_maker_abacus_exp.sh"
}

.p{
  harness="test/prove_maker_abacus_exp_external.py"
  evidence_json="examples/maker_abacus_exp/maker_abacus_exp_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-abacus-exp"
}

.n{
  not_claimed_1="full uint256 / RAY=1e27 / mainnet Clipper.price parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production abacus replacement"
  not_claimed_4="LinearDecrease.price or StairstepExponentialDecrease"
  not_claimed_5="LIN replaces Maker, Sky, clipper, or the EVM"
  not_claimed_6="TVL or dollar savings"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_WRAP && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
