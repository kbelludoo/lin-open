@RULEL:CURVE_GETYD_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-CURVE-3POOL-GET-Y-D"
@TITLE="Clone-lin of Curve 3pool get_y_D / calc_withdraw_one_coin with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-curve-getyd"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Curve 3pool get_y_D single-coin withdrawal math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, SCALE=1e9, N=3, 128-bit (a*b+add)/d Newton; Vyper uint256 / RATES / PRECISION_MUL are NOT claimed"
  commercial_hook="get_y_D is how Curve 3pool (DAI/USDC/USDT) prices remove_liquidity_one_coin: D drops by burn/supply while the other xp stay put. Making D/amp/xp/burn/supply explicit, fail-closing totalSupply and self.balances, and replacing wrapping i64 Newton with 128-bit muldiv is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/curvefi/curve-contract"
  path="contracts/pools/3pool/StableSwap3Pool.vy"
  license="all-rights-reserved-informational-only"
  commit="bae23a2fc9a0302d174ea1ffce8219a44a92149c"
  git_blob_sha="04d170189a1b5ddfecfc0af9ea3fe23eb0840423"
  file_sha256="03e0bf29ae2fe945a3629b8085062da8f9d9d25957e86001dfc3df68c895f9dc"
  fixture="test/fixtures/external_proof/curve_getyd.pin.rulel"
}

.l{
  clone="src/lin_curve_getyd.lin"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-curve-getyd"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_TOTALSUPPLY / REJ_SOLIDITY_SELF_BALANCES; src/lin_from_c.lin v2 REJ_C_TOTALSUPPLY / REJ_C_SELF_BALANCES; src/lin_from_rust.lin v2 REJ_RUST_TOTAL_SUPPLY / REJ_RUST_SELF_BALANCES"
  improvement_1="storage self.balances, ramped self._A(), and token.totalSupply become explicit arguments"
  improvement_2="10% LP burn from equal 1e9 xp at A=100 returns 299632067 of coin 0, not 300000000 (constant-sum) — haircut 367933 is explicit"
  improvement_3="128-bit Newton (y*y+c)/(2y+b-D); naive i64 D^2 of 3099778671 wraps to -8838116264523025375"
  improvement_4="xp[i]-y underflow and burn>=supply fail-close to 0 (uint256 wrap of identity withdraw is not replayed)"
  improvement_5="fee path uses Curve's xp[i]*D1/D0 - new_y (not xp[i]-new_y) with baked 0.04% n_fee=150000"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/curve_getyd_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="make curve-getyd-proof"
}

.p{
  harness="test/prove_curve_getyd_external.py"
  evidence_json="examples/curve_getyd/curve_getyd_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-curve-getyd"
}

.n{
  not_claimed_1="full uint256 / mainnet 3pool RATES / PRECISION_MUL parity"
  not_claimed_2="LIN is faster than the EVM or vyper"
  not_claimed_3="this clone is a production Curve pool replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="any TVL or dollar-savings figure"
  not_claimed_6="get_D / get_y / get_dy (already cloned separately) / exchange / raw_call"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
