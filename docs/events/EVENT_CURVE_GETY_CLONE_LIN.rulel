@RULEL:CURVE_GETY_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-CURVE-3POOL-GETY"
@TITLE="Clone-lin of Curve 3pool get_D/get_y with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-curve-gety"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Curve 3pool stableswap Newton get_y into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs SCALE=1e9, N=3, 128-bit (a*b+add)/d Newton; Vyper uint256 is NOT claimed"
  commercial_hook="Curve 3pool (DAI/USDC/USDT) is a production stableswap; get_y is the quote kernel every swap uses. Making amp and balances explicit and fail-closing dx=0 underflow is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/curvefi/curve-contract"
  path="contracts/pools/3pool/StableSwap3Pool.vy"
  license="all_rights_reserved_informational_not_vendored"
  commit="bae23a2fc9a0302d174ea1ffce8219a44a92149c"
  git_blob_sha="04d170189a1b5ddfecfc0af9ea3fe23eb0840423"
  file_sha256="03e0bf29ae2fe945a3629b8085062da8f9d9d25957e86001dfc3df68c895f9dc"
  fixture="test/fixtures/external_proof/curve_3pool_gety.pin.rulel"
}

.l{
  clone="src/lin_curve_gety.lin"
  transpiler_delta="src/lin_from_vyper.lin v1: 10 ** N expand + REJ_VYPER_STORAGE/RAWCALL/ARRAY/ASSERT for Curve get_y"
  improvement_1="get_y is @view on self._A() and xp_ arrays in Vyper; LIN takes amp and x0,x1,x2 as arguments"
  improvement_2="y*y on imbalanced D overflows i64; LIN uses 128-bit (y*y+c)/den matching C11 __int128"
  improvement_3="get_dy dx=0 computes xp[j]-y-1 = -1 which wraps uint256; LIN fail-closes to 0"
  improvement_4="Vyper transpiler fail-closes on self/raw_call/uint256[N_COINS] instead of silently dropping Curve 3pool"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/curve_gety_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_curve_gety.sh"
}

.p{
  harness="test/prove_curve_gety_external.py"
  evidence_json="examples/curve_gety/curve_gety_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-curve-gety"
}

.n{
  not_claimed_1="full uint256 / mainnet 3pool / RATES / PRECISION parity"
  not_claimed_2="LIN is faster than the EVM or vyper"
  not_claimed_3="this clone is a production Curve pool replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="a license to redistribute Curve.Fi source"
  not_claimed_6="Saddle getD clone equivalence beyond the shared Newton formula"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
