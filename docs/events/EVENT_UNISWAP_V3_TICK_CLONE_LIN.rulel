@RULEL:UNISWAP_V3_TICK_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-UNISWAP-V3-TICK-SQRT"
@TITLE="Clone-lin of Uniswap V3 TickMath.getSqrtRatioAtTick with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_Q32_14BIT"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-uniswap-v3-tick"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Uniswap V3 tick-to-sqrtPrice bit table into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="Q32=2^32 fixed point, |tick|<=16383 (14-bit table); Solidity Q64.96 / uint160 / MAX_TICK=887272 is NOT claimed"
  commercial_hook="getSqrtRatioAtTick sits on every Uniswap V3 mint/burn/swap path; a co-processor that linearizes ticks (Q*(1+tick/20000)) misprices concentrated liquidity, and signed-i64 Q*Q wraps the invert to 0"
}

.u{
  repo="https://github.com/Uniswap/v3-core"
  tag="v1.0.0"
  path="contracts/libraries/TickMath.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2023-04-01 elapsed; Change License GPL-2.0-or-later"
  commit="e3589b192d0be27e100cd0daaf6c97204fdb1899"
  git_blob_sha="378e44528caeb7fa0ce2f86b8a39f6d0785a0925"
  file_sha256="83cf64b2ca84001effd16e007b49bac5359143b6c3132bfe42907b2426a0c5f5"
  fixture="test/fixtures/external_proof/TickMath.sol"
}

.l{
  clone="src/lin_uniswap_v3_tick.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_TICK_SQRT / TICK_AT / TICK_MAGIC / RSHIFT128 / MAX_TICK / UINT_MAX / INT24 / UINT160; emit concatenates '=' + 'ex{'; src/lin_from_rust.lin v2: REJ_RUST_TICK_SQRT / TICK_MAGIC / RSHIFT128"
  improvement_1="Solidity Q128 magics and >> 128 do not fit signed i64; LIN uses a reduced Q32 bit table with 128-bit muldiv"
  improvement_2="tick>0 invert is type(uint256).max/ratio in Solidity; naive i64 (Q32*Q32)/ratio wraps to 0; LIN muldiv(Q,Q,ratio) is fail-closed 128-bit"
  improvement_3="first-order linear Q*(1+tick/20000) matches tick 0 and is close at tick 1 but underprices tick=8192 by 414826555 Q32 units vs the bit table"
  improvement_4="|tick|>16383 fail-closes to 0 (reduced domain); Uniswap reverts on |tick|>887272"
  not_this_kernel="not getNextSqrtPriceFromInput (clone-lin-uniswap-v3-next-sqrt) and not getAmount0Delta (clone-lin-uniswap-v3-sqrt)"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/uniswap_v3_tick_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="test/verify_uniswap_v3_tick.sh"
}

.p{
  harness="test/prove_uniswap_v3_tick_external.py"
  evidence_json="examples/uniswap_v3_tick/uniswap_v3_tick_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-uniswap-v3-tick"
}

.n{
  not_claimed_1="full Q64.96 / uint160 / MAX_TICK=887272 mainnet parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production Uniswap V3 pool replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="getNextSqrtPriceFromInput / getAmount0Delta / getTickAtSqrtRatio inverse"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS && JUMPRATE_REGRESSION"
  on_fail="do not publish a PASS status"
}
