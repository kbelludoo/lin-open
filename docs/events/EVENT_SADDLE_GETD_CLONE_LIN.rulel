@RULEL:SADDLE_GETD_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-SADDLE-GETD-GETY"
@TITLE="Clone-lin of Saddle SwapUtils getD/getY with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-10-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-saddle-getd"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Saddle Newton stableswap D/Y into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open plus a separate clone-lin repo"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, N=2, 128-bit product for (a*b)/d; Solidity uint256 / N>2 is NOT claimed"
  commercial_hook="Saddle is the MIT Solidity Newton D used by historical stableswap TVL (sUSD/alETH/FRAX). A 1% swap of a balanced 1e6/1e6 pool quotes 9999 on the invariant vs 9871 on Uniswap-style x*y. Not a TVL or pool-replacement claim. Curve.vy was not copied: Curve.Fi LICENSE grants no reproduction right."
}

.u{
  repo="https://github.com/saddle-finance/saddle-contract"
  path="contracts/SwapUtils.sol"
  license="MIT"
  commit="2cfdd05580efb626d79d597034b2cf5ae89b5626"
  git_blob_sha="38e236c32c550ce63187dc9297eb36fac005851b"
  file_sha256="9684c7e46310e1b9d128587f08cf0b62e8d6d0574b094d338a9ed99e936f3df6"
  fixture="test/fixtures/external_proof/SwapUtils.sol"
  excerpt="test/fixtures/external_proof/getD.sol"
  a_precision="precise A = display A * 100; LIN a is precise A; A_PRECISION=100 MAX_LOOP=256"
}

.l{
  clone="src/lin_saddle_getd.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_ARRAY / REJ_SOLIDITY_REVERT / REJ_SOLIDITY_FOR / REJ_SOLIDITY_MULMOD / REJ_SOLIDITY_CAST + honest '='+'ex{' emit"
  improvement_1="Saddle getD takes uint256[] + SafeMath method chains; LIN takes x0,x1,preciseA"
  improvement_2="Saddle reverts if Newton does not converge; LIN fail-closes to 0"
  improvement_3="(a*b)/d uses a visible 128-bit schoolbook product"
  improvement_4="named contrast vs already-cloned Uniswap V2 getAmountOut: stableswap dy=9999 vs cp=9871 on the 1e6 1% vector"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/saddle_getd_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="make saddle-getd-proof"
}

.p{
  harness="test/prove_saddle_getd_external.py"
  evidence_json="examples/saddle_getd/saddle_getd_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-saddle-getd"
}

.n{
  not_claimed_1="full uint256 / N>2 / mainnet Saddle pool parity"
  not_claimed_2="LIN replacing Saddle, Curve, or a production AMM"
  not_claimed_3="Compiler 0 executing sol_from_sol string-literal emit (VM_REJ_STRING_LITERAL)"
  not_claimed_4="wall-clock superiority vs solc"
  not_claimed_5="a license to reproduce Curve.vy source"
}

.v{
  method="PINNED_BYTES && PYTHON_BIGINT_EQ_C11_I128_EQ_LIMBS_EQ_LIN_C0_VM && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
