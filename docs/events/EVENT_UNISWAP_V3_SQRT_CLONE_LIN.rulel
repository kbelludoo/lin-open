@RULEL:UNISWAP_V3_SQRT_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-UNISWAP-V3-SQRT-AMOUNT-DELTA"
@TITLE="Clone-lin of Uniswap V3 SqrtPriceMath getAmount0Delta/getAmount1Delta with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-uniswap-v3-sqrt"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Uniswap V3 SqrtPriceMath getAmount0Delta / getAmount1Delta into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs at Q32=2^32, 128-bit product for (a*b)/d; Solidity uint256 and Q96=2^96 are NOT claimed"
  commercial_hook="getAmount0Delta/getAmount1Delta are how Uniswap V3 concentrated-liquidity positions compute token amounts between two sqrt prices; naive (L*dsqrt)/(sa*sb) floors amount0 to 0 on a 1->4 range at Q32 while sequential (L*Q*dsqrt/sb)/sa keeps 500000; 1-unit roundup is the solvency gap, not a TVL claim"
}

.u{
  repo="https://github.com/Uniswap/v3-core"
  tag="v1.0.0"
  path="contracts/libraries/SqrtPriceMath.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2023-04-01 elapsed; Change License GPL-2.0-or-later."
  commit="e3589b192d0be27e100cd0daaf6c97204fdb1899"
  git_blob_sha="685f485da43402235c3a9ce7fd85a49597b6373a"
  file_sha256="ddd62e3a94346248677f30f1ab009ef015e71e4b8696dcca890eeabc9dc6c149"
  fixture="test/fixtures/external_proof/SqrtPriceMath.sol"
}

.l{
  clone="src/lin_uniswap_v3_sqrt.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_Q96 / ROUNDING_UP / UNSAFE_MATH; emit splits '=' + 'ex{'. src/lin_from_rust.lin v2: REJ_RUST_Q96 / ROUNDING_UP / FIXEDPOINT96"
  improvement_1="tuple swap (sa,sb)=(sb,sa) is explicit v3s_sort2; roundUp bool is an int argument"
  improvement_2="Q96=2^96 exceeds signed i64; clone is Q32=2^32 with 128-bit muldiv"
  improvement_3="naive (L*(sb-sa))/(sa*sb) floors amount0 to 0 because sa*sb overflows uint64 at Q32 price 1->4; sequential (L*Q*(sb-sa)/sb)/sa keeps 500000"
  improvement_4="mulDivRoundingUp/divRoundingUp are named 1-unit ceil vs floor (L=1 sb=sa+1: 0 vs 1); not a retread of OZ mulDiv Rounding enum"
  improvement_5="amount1 is L*(sb-sa)/Q (linear in sqrt-price); amount0 is inverse; both are the CLMM identity, not generic (a*b)/d"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/uniswap_v3_sqrt_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="python3 test/prove_uniswap_v3_sqrt_external.py"
}

.p{
  harness="test/prove_uniswap_v3_sqrt_external.py"
  evidence_json="examples/uniswap_v3_sqrt/uniswap_v3_sqrt_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-uniswap-v3-sqrt"
  named_goldens="amount0_1to4_L1e6=500000 amount1_1to4_L1e6=1000000 naive_amt0_1to4=0 amount0_wei_floor=0 amount0_wei_ceil=1 amount0_1to225_floor=333333 amount0_1to225_ceil=333334"
}

.n{
  not_claimed_1="full uint256 / Q64.96 / mainnet Pool / SwapRouter / NFT position parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production Uniswap V3 replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Uniswap, Compound, or the EVM"
  not_claimed_6="a full port of OpenZeppelin Math.mulDiv / Rounding (named contrast only)"
  not_claimed_7="getNextSqrtPriceFromAmount0RoundingUp / getNextSqrtPriceFromInput (left for a later kernel)"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && PY_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
