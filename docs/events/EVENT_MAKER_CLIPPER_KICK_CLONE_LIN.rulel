@RULEL:MAKER_CLIPPER_KICK_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-CLIPPER-KICK"
@TITLE="Clone-lin of Maker/Sky Clipper.kick with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-13"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-clipper-kick"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Maker Clipper.kick auction-start math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs; WAD=1000 RAY=1e6 BLN=1000; Solidity uint256 rad/wad/ray is NOT claimed"
  commercial_hook="Clipper.kick starts every Maker/Sky collateral auction; chip/tip is the DAI sucked from the vow to pay keepers. Making OSM val/par/buf and chip/tip explicit, and replacing wrapping i64 multiply with fail-closed mul/add, is an audit improvement for keeper simulators, not a TVL claim"
}

.u{
  repo="https://github.com/makerdao/dss"
  path="src/clip.sol"
  function="kick"
  license="AGPL-3.0-or-later"
  commit="fa4f6630afb0624d04a003e920b0d71a00331d98"
  git_blob_sha="c43d8fff46a4ad225d1fa031b4b1de618345cba7"
  file_sha256="1ea897fc0e8e0964a2e5098716d86fdcd93d11e0b2e4f65998eb1b7650d167de"
  vendored=false
}

.l{
  clone="src/lin_maker_clipper_kick.lin"
  transpiler_delta="src/lin_from_solidity.lin REJ_SOLIDITY_CLIPPER_KICK/SUCK/SALES_MAP; src/lin_from_c.lin REJ_C_CLIPPER_KICK/SUCK/WIDE_INT; src/lin_from_rust.lin REJ_RUST_CLIPPER_KICK/SUCK/WIDE_INT"
  improvement_1="kick is auth+lock+storage+vat.suck in Solidity; LIN takes tab/lot/usr/kicks/val/par/buf/tip/chip/auth/stopped as arguments"
  improvement_2="tab*chip and val*BLN*RAY overflow i64; LIN fail-closes instead of wrapping (C11 wrap-detect XOR __int128)"
  improvement_3="kicks++ wrap to 0 is a Solidity require; LIN fail-closes kicks+1 that does not fit int64"
  improvement_4="distinct from clipper.take (buy) and dog.bark (lot size): this kernel is auction start price + keeper coin"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_clipper_kick_c11.c (gcc -O2 -std=c11, __int128 XOR wrap-detect)"
  gate="test/verify_maker_clipper_kick.sh"
}

.p{
  harness="test/prove_maker_clipper_kick_external.py"
  evidence_json="examples/maker_clipper_kick/maker_clipper_kick_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-clipper-kick"
}

.n{
  not_claimed_1="full uint256 / mainnet rad/wad/ray / OSM / vat.suck host parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production Clipper replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Maker, Sky, Clipper, or the EVM"
  not_claimed_6="TVL or dollar savings from this kernel"
}

.v{
  method="PINNED_BYTES && C11_WRAP_EQ_I128 && LIN_C0_VM_EQ_C11 && PYTHON_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
