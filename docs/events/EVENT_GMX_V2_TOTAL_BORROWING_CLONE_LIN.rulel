@RULEL:GMX_V2_TOTAL_BORROWING_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-GMX-V2-TOTAL-BORROWING"
@TITLE="Clone-lin of GMX V2 getNextTotalBorrowing with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-gmx-v2-total-borrowing"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile GMX V2 next total borrowing (unsigned sub-then-add of applyFactor(size, factor)) into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Arbitrum GMX V2"
  operand_width="int64 unsigned total/size/factor + FLOAT 1e6; Solidity uint256 / FLOAT 1e30 is NOT claimed"
  commercial_hook="GMX V2 totalBorrowing is a running sum of applyFactor(size, factor) updated by unsigned subtract-then-add. A signed next-minus-prev delta lets a previous contribution larger than the accumulator succeed (15000000 vs revert). Nested floor of applyFactor raises the total versus fused (nextProd-prevProd)/FLOAT. Making the unsigned subtract, the nested floors, and fail-closed overflow explicit is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/gmx-io/gmx-synthetics"
  path="contracts/market/MarketUtils.sol"
  precision_path="contracts/utils/Precision.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  git_blob_sha="ad7a0b2b5a516ec86ce0afed89ff84ecba11038c"
  file_sha256="8dfd271e4fc8e18d6a114b674dc1f520f38f6acd1f9c9a58b4b7509fe86e748f"
  precision_git_blob_sha="047143722beaf6adceac3fc2ef1817f054dfe00a"
  precision_file_sha256="8713db02a257238101fc62cc682a8f8061fba25951216863576afbbd00f34808"
  fixture="test/fixtures/external_proof/GetNextTotalBorrowing.excerpt.sol"
}

.l{
  clone="src/lin_gmx_v2_total_borrowing.lin"
  prefix="g2t_"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_GMX_V2_TOTAL_BORROW before ENV; Chain.currentTimestamp is ENV; split equals then ex-brace emit. src/lin_from_rust.lin v2: REJ_RUST_GMX_V2_TOTAL_BORROW"
  improvement_1="total, prevSize, prevFactor, nextSize, nextFactor are explicit arguments; DataStore / isLong storage key lifted"
  improvement_2="next total is unsigned sub-then-add of applyFactor, not signed (next-prev)"
  improvement_3="nested floor of applyFactor raises total versus fused (nextProd-prevProd)/FLOAT"
  improvement_4="prev contrib > total fail-closes; first position total=0 prev=0 is allowed"
  improvement_5="size*factor overflow and mid+next overflow fail-close instead of wrapping; over-size is not applyFactor of the size delta"
  named_contrast_1="getBorrowingFees is applyFactor(size, cum-entry), a USD fee not a running total"
  named_contrast_2="getTotalPendingBorrowingFees is applyFactor(OI, nextCum) minus total, not getNextTotalBorrowing"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/gmx_v2_total_borrowing_c11.c (gcc -O2 -std=c11, __int128 XOR portable umul_ok)"
  gate="test/verify_gmx_v2_total_borrowing.sh"
}

.p{
  harness="test/prove_gmx_v2_total_borrowing_external.py"
  evidence_json="examples/gmx_v2_total_borrowing/gmx_v2_total_borrowing_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-gmx-v2-total-borrowing"
}

.n{
  not_claimed_1="full uint256 / Arbitrum GMX V2 mainnet parity / FLOAT 1e30"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production GMX market replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces GMX, Uniswap, or the EVM"
  not_claimed_6="this is getBorrowingFees, getTotalPendingBorrowingFees, signed fused next-prev, or applyFactor of the size delta"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_PORTABLE && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
