@RULEL:GMX_V2_CLAIMABLE_FACTOR_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-GMX-V2-CLAIMABLE-FACTOR"
@TITLE="Clone-lin of GMX V2 _getClaimableFactor with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-gmx-v2-claimable-factor"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile GMX V2 claimable-collateral factor (max of time/account keys, delay-default, then reduction) into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Arbitrum GMX V2"
  operand_width="int64 unsigned factors + timeKey*divisor + FLOAT 1e6 applyFactor; Solidity uint256 / FLOAT 1e30 is NOT claimed"
  commercial_hook="GMX V2 claimable collateral after ADL/liquidation is gated by a time-bucket factor. Making DataStore and Chain.currentTimestamp explicit, max(time,account) vs min, delay-default only when reduction is also zero, fail-closed underflow/overflow, and applyFactor-minus-claimed is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/gmx-io/gmx-synthetics"
  path="contracts/market/MarketUtils.sol"
  precision_path="contracts/utils/Precision.sol"
  keys_path="contracts/data/Keys.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2026-08-31 elapsed; Change License GPL-2.0-or-later"
  commit="a85ea3491c19c93bb4b5a002d9b358fb769b7849"
  git_blob_sha="ad7a0b2b5a516ec86ce0afed89ff84ecba11038c"
  file_sha256="8dfd271e4fc8e18d6a114b674dc1f520f38f6acd1f9c9a58b4b7509fe86e748f"
  precision_git_blob_sha="047143722beaf6adceac3fc2ef1817f054dfe00a"
  precision_file_sha256="8713db02a257238101fc62cc682a8f8061fba25951216863576afbbd00f34808"
  keys_git_blob_sha="5472e5b4ecd29bb372218caa142476eb95fe55f8"
  keys_file_sha256="9940d62b9dca2f3a753d67d7e7339a6326278a35d752c4c80ab1eedf0ab0f075"
  fixture="test/fixtures/external_proof/GetClaimableFactor.excerpt.sol"
}

.l{
  clone="src/lin_gmx_v2_claimable_factor.lin"
  prefix="g2f_"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_GMX_V2_CLAIMABLE_FACTOR before ENV; Chain.currentTimestamp is ENV; split equals then ex-brace emit. src/lin_from_rust.lin v2: REJ_RUST_GMX_V2_CLAIMABLE_FACTOR"
  improvement_1="DataStore / Chain.currentTimestamp lifted to explicit factor_time, factor_account, reduction, divisor, delay, time_key, now_ts arguments; events stripped"
  improvement_2="claimableFactor is max(timeKey factor, account factor), not min and not a single key"
  improvement_3="delay-default to FLOAT only when both factors AND the reduction are zero AND timeDiff > delay (strict greater-than)"
  improvement_4="reduction subtract floors at 0; reduction!=0 blocks the delay-default"
  improvement_5="claimCollateral rejects factor>FLOAT then pays applyFactor(amount,factor)-claimed"
  improvement_6="timeKey*divisor overflow and now-prod underflow fail-close instead of wrapping"
  named_contrast_1="getPendingPositionImpactPoolDistributionAmount is rate*duration clipped to pool-min, not a boolean delay-default to 100%"
  named_contrast_2="applyDeltaToCollateralSum is unsigned sum with always-on max; this kernel is a 0..FLOAT factor"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/gmx_v2_claimable_factor_c11.c (gcc -O2 -std=c11, __int128 XOR portable umul_ok)"
  gate="test/verify_gmx_v2_claimable_factor.sh"
}

.p{
  harness="test/prove_gmx_v2_claimable_factor_external.py"
  evidence_json="examples/gmx_v2_claimable_factor/gmx_v2_claimable_factor_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-gmx-v2-claimable-factor"
}

.n{
  not_claimed_1="full uint256 / Arbitrum GMX V2 mainnet parity / FLOAT 1e30"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production GMX market replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces GMX, Uniswap, or the EVM"
  not_claimed_6="this is applyDeltaToCollateralSum (always-max unsigned sum) or getPendingPositionImpactPoolDistributionAmount (working i64 time-distribution)"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_PORTABLE && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
