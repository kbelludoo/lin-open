@RULEL:UNISWAP_V3_STEP_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-UNISWAP-V3-COMPUTE-SWAP-STEP"
@TITLE="Clone-lin of Uniswap V3 SwapMath.computeSwapStep with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_Q32"
@DATE="2026-10-12"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-uniswap-v3-step"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Uniswap V3 computeSwapStep fee/cap math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, Q32=2^32, 128-bit product for (a*b)/d; Solidity uint160/Q96 is NOT claimed"
  commercial_hook="computeSwapStep is the inner loop of every Uniswap V3 swap; skipping the fee-on-input deduction lets a step cross a tick it should not. Making remaining/feePips/reached-target explicit with 128-bit muldiv is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/Uniswap/v3-core"
  path="contracts/libraries/SwapMath.sol"
  license="GPL-2.0-or-later"
  license_note="BUSL-1.1 Change Date 2023-04-01 elapsed; Change License GPL-2.0-or-later"
  commit="e3589b192d0be27e100cd0daaf6c97204fdb1899"
  tag="v1.0.0"
  git_blob_sha="ee176fbee4ae2fb2ba7da4ddd00391fe6b685f39"
  file_sha256="d6cb9a153be4ea9fb2377ef88641ef7979b5cee6933162f1b732d0289e26e1b6"
  fixture="test/fixtures/external_proof/SwapMath.sol"
}

.l{
  clone="src/lin_uniswap_v3_step.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_SWAP_STEP/FEE_PIPS/AMOUNT_REMAINING/UINT24/UINT160/NEG_CAST/FULLMATH; emit split = + ex{ so C0 does not steal the export list; src/lin_from_rust.lin v2 REJ_RUST_SWAP_STEP/FEE_PIPS/AMOUNT_REMAINING"
  improvement_1="skip-fee remaining=1e6 hits Q/2=2147483648; real remaining-less-fee stays at 2150709713"
  improvement_2="exact-out remaining=-5e5 hits Q/2; treating +5e5 as exact-in yields 2866177709"
  improvement_3="not-reached exact-in fee=remaining-amountIn=3000; reached remaining=1003011 fee=ceil(amountIn*fee/(1e6-fee))=3010"
  improvement_4="naive i64 (1e13*997000)/1e6 wraps to -8476744073709; 128-bit remaining_less_fee=9970000000000"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/uniswap_v3_step_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="python3 test/prove_uniswap_v3_step_external.py"
}

.p{
  harness="test/prove_uniswap_v3_step_external.py"
  evidence_json="examples/uniswap_v3_step/uniswap_v3_step_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-uniswap-v3-step"
}

.n{
  not_claimed_1="full uint160 / Q64.96 / mainnet Pool / SwapRouter / NFT parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production AMM replacement"
  not_claimed_4="retread of getNextSqrtPriceFromInput / FromOutput / getAmount0Delta / getSqrtRatioAtTick as the kernel"
  not_claimed_5="LIN replaces Uniswap or the EVM"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
