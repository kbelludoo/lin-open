@RULEL:OZ_LOG10_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-OZ-MATH-LOG10-V5-0-2"
@TITLE="Clone-lin of OpenZeppelin Math.log10/log256 with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_I64_SCALE"
@DATE="2026-09-16"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-oz-log10"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile OpenZeppelin Math.log10/log256 into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="non-negative i64; 10**64 and 10**32 skipped because they do not fit i64; C uint64 >>64 is UB so >>128/>>64 log256 branches are skipped"
  commercial_hook="floor(log10(n))+1 is the decimal digit count of a token amount (1 ETH=1e18 wei → 19 digits; 1 BTC=1e8 sat → 9 digits; 1 USDC=1e6 → 7). Used to size amount-string buffers. Not a TVL or gas-savings claim."
}

.u{
  repo="https://github.com/OpenZeppelin/openzeppelin-contracts"
  path="contracts/utils/math/Math.sol"
  license="MIT"
  tag="v5.0.2"
  commit="dbb6104ce834628e473d2173bbc9d47f81a9eec3"
  git_blob_sha="9681524529b34f34033ae97064a2700bfc4eec00"
  file_sha256="a6ee779fc42e6bf01b5e6a963065706e882b016affbedfd8be19a71ea48e6e15"
  excerpt_sha256="2c0396e0703d1be2fbed02c40620fb5501a035ee204a8ccc8f279d8af6996432"
  fixture="test/fixtures/external_proof/openzeppelin_math_v5_0_2.sol"
  excerpt="test/fixtures/external_proof/oz_log10_log256_excerpt.sol"
}

.l{
  clone="src/lin_oz_log10.lin"
  transpiler_delta="src/lin_from_solidity.lin v3: REJ_SOLIDITY_POW for ** ; REJ_SOLIDITY_ENUM for enum keyword and uppercase user types (Rounding). src/lin_from_c.lin v2: word-boundary libc sqrt(/sqrtf(/sqrtl( is REJ_C_FLOAT"
  improvement_1="Solidity 10**64 cannot be an i64 literal; LIN fail-closes ** instead of wrapping"
  improvement_2="Rounding enum overloads are explicit int round_up; no hidden enum ordinal"
  improvement_3="negatives fail-closed (OZ is uint256); ozl_ok=0"
  improvement_4="10**N for N>18 fail-closes to 0 rather than overflowing i64"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit when present"
  oracle="test/oracles/oz_log10_c11.c (gcc -O2 -std=c11)"
  third_oracle="Python len(str(n))-1 and (n.bit_length()-1)//8 — independent of the OZ if-chain"
  gate="test/verify_oz_log10.sh"
}

.p{
  harness="test/prove_oz_log10_external.py"
  evidence_json="examples/oz_log10/oz_log10_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-oz-log10"
}

.n{
  not_claimed_1="full uint256 / mainnet OpenZeppelin Math parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production Strings.toString replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces OpenZeppelin, Uniswap, or the EVM"
  not_claimed_6="lin_c0 executes cfs_from_c / sol_from_sol (VM_REJ_STRING_LITERAL still holds)"
}

.v{
  method="PINNED_BYTES && C11_EQ_LIN_C0_VM && PYTHON_STR_BITLENGTH_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
