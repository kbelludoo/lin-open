@RULEL:U512_COPROCESSOR_EVENT:1.21.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-10-11"
@TITLE="512-bit intermediate proved as numeric coprocessor with auditable receipt"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-10-11"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the SafeMath-width settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 163/163 PASS this run"
  delta="schema 1.21: Toom-6 256x256->512 + SRT radix-32 512/256 is a twenty-third independent math. Product: 43-bit 6-way split, eleven eval products via 64x64->128, Newton interpolation of <=128-bit coeffs, B-adic sum at 2^43. Not schoolbook, not Karatsuba 2-way, not Toom-3, not Toom-4, not Toom-5, not NTT, not FNT, not Comba, not CRT/Mersenne. Division: SRT radix-32, 5 bits of n per step, digits {-16..16} from thresholds ±D/2 ±3D/2 … ±31D/2 (Robertson); remainder may be negative; 512-bit ge so r<d. Not SRT radix-4, not SRT radix-8, not SRT radix-16, not restoring of n, not non-restoring, not Barrett, not Knuth D, not Goldschmidt, not Burnikel-Ziegler. Python int only for <=60-bit Toom eval, 64x64->128, and <=128-bit interpolation. Zero-LIN Toom-6 auditor (verify_u512_toom6.py) recomputes n==a*b via Toom-6, q*d+r==n via SRT-32, binds mulDiv(fee,rout,den) on 3 EXACT + 3 OVERPAID + PHANTOM_APPROVE, and OpenSSL dgst of the LRI1 Merkle tree (FIPS abc ba7816bf) — no gcc, no rustc, no LinVM. Still includes schema 1.20 Toom-5+SRT-16. Merkle roots unchanged vs 1.20 (engine frozen)."
}

.p{
  mul="256x256->512 schoolbook in the engine AND Toom-6 reconstruction independently; leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 published leaf"
  div="512/256 restoring div in the engine AND SRT radix-32 independently; remainder 32/16/8 limbs; 512-bit ge; q*d+r==n and r<d"
  ge="u512_ge_word + LGE1 8-leaf power-of-two tree; Toom-6/SRT-32 ge_limbs agrees with Python int / Node / OpenSSL BN / Go / Java / GMP / Perl / radix32 / rust64 / radix8 / Knuth D / CRT / Karatsuba / Toom-3 / NTT / Comba / Toom-4 / FNT / Toom-5 / GNU bc"
  identity="LRI1 8-leaf power-of-two tree binds the 512-bit product n plus d,q,r. Outsider (including Toom-6+SRT-32 + OpenSSL dgst) checks n==a*b and q*d+r==n and r<d without LinVM"
  inclusion="LIP1: 34 published inclusion proofs (8 LRI1 + 8 LGE1 + LNR1 max_sq + 8 LCR2 E2E + 9 LCR2-full). Toom-6/SRT-32 auditor binds packed LCR2 EXACT/OVERPAID and PHANTOM_APPROVE via mulDiv(fee,rout,den)"
  guards="-1 on d=0 (coprocessor) and zero amount_in (both LCR2 trees); -2 on q overflow, SafeMath-width phantom (LCR2), and ain=2^256-1 fee overflow (LCR2-full)"
  oracles="previous 1.20 oracles plus Toom-6+SRT-32 (TOOM6_SRT32_CONSENSUS) on the n=1060 batch; Toom-6/SRT-32 on 6 LCR2 EXACT/OVERPAID and 6 LCR2-full + PHANTOM_APPROVE"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor APPROVES; settle_u512_swap APPROVES; settle_u256_word -2. 512-bit intermediate off the suspect list; replacing the SafeMath-width settler body remains required"
  receipt="LNR1 240-byte records; LCR2 208-byte records; LGE1; LRI1; LIP1; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected"
  lcr2="3 EXACT_INPUT + 3 OVERPAID_INPUT with settle_u256_word == coprocessor == ref_amount_out and steps!=0; GUARD_ZERO -1; GUARD_OVERFLOW -2"
  lcr2_full="same 3 EXACT + 3 OVERPAID via settle_u512_swap == ref_amount_out_full plus PHANTOM_APPROVE"
}

.n{
  not_1="EVM mulmod opcode / solc FullMath.sol on-chain (algorithm pin; opcode not executed)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes the SafeMath-width u256 settler by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

.m{
  host="lin_c0 C11, gcc -std=c11, python3 Toom-6+SRT-32 + Toom-5+SRT-16 + FNT+SRT-8 + Toom-4+BZ + hashlib, node BigInt + crypto, openssl dgst, go math/big, javac BigInteger, libgmp.so.10, perl Math::BigInt::Calc, GNU bc 1.07.1, rustc zero-crate radix-2^64; no Zig"
  toom6_selftest="SELFTEST_PASS toom6_srt32 q*d+r==n ge512 toom6_prod srt32"
  gate="163/163 PASS"
  published_lip1_proofs=34
  self_gate_steps=6710747
  phantom_coprocessor_steps=1106942
  phantom_u256_status=-2
  phantom_u512_swap_steps=1098245
  class="EXPERIMENTAL"
}

