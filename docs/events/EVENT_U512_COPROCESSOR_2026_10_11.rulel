  host="lin_c0 C11, gcc -std=c11, python3 IEEE-754 FFT+Montgomery + Toom-2x7+Barrett-1024 + Toom-2x5+SRT-2048 + hashlib, node BigInt + crypto, openssl dgst, go math/big, javac BigInteger, libgmp.so.10, perl Math::BigInt::Calc, GNU bc 1.07.1, rustc zero-crate radix-2^64; no Zig"
  fft_selftest="SELFTEST_PASS fft_montgomery q*d+r==n ge512 fft_prod montgomery_redc jebelean_q"
