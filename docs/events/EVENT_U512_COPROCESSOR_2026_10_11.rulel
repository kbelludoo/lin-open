@RULEL:U512_COPROCESSOR_EVENT:1.26.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-10-11"
@TITLE="512-bit intermediate proved as numeric coprocessor with auditable receipt"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-10-11"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the SafeMath-width settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 198/198 PASS this run"
  delta="schema 1.26: RNS 256x256->512 + Newton-Raphson reciprocal 512/256 is a twenty-eighth independent math. Product: 17 pairwise coprime 32-bit primes (product 544 bits > 2^512), pointwise 32x32->64, Garner mixed-radix CRT. Not schoolbook, not Karatsuba, not Toom-3..10, not NTT, not FNT, not Comba, not CRT/Mersenne (2^256 and 2^256-1). Division: Newton-Raphson reciprocal, seed v=2^(512-bitlen(d)), ten iterations v:=2v-((d*v*v)>>512) with 64x64->128 products, q=(n*v)>>512, 512-bit ge so r<d. Not Goldschmidt (no dual N,D iterate), not Hensel mod 2^256, not Barrett mu from sparse 2^512, not SRT radix-4..512, not restoring of n, not Knuth D, not Burnikel-Ziegler. Python int only for 32-bit residues, 32-bit egcd, and 64x64->128. Zero-LIN RNS auditor (verify_u512_rns.py) recomputes n==a*b via RNS, q*d+r==n via Newton-Raphson, binds mulDiv(fee,rout,den) on 3 EXACT + 3 OVERPAID + PHANTOM_APPROVE, and OpenSSL dgst of the LRI1 Merkle tree (FIPS abc ba7816bf) — no gcc, no rustc, no LinVM. Still includes schema 1.25 Toom-10+SRT-512. Merkle roots unchanged vs 1.25 (engine frozen)."
}

.p{
  mul="256x256->512 schoolbook in the engine AND RNS reconstruction independently; leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 published leaf"
  div="512/256 restoring div in the engine AND Newton-Raphson reciprocal independently; remainder 32/16/8 limbs; 512-bit ge; q*d+r==n and r<d"
  ge="u512_ge_word + LGE1 8-leaf power-of-two tree; RNS/Newton ge_limbs agrees with Python int / Node / OpenSSL BN / Go / Java / GMP / Perl / radix32 / rust64 / radix8 / Knuth D / CRT / Karatsuba / Toom-3 / NTT / Comba / Toom-4 / FNT / Toom-5 / Toom-6 / Toom-7 / Toom-8 / Toom-9 / Toom-10 / GNU bc"
  identity="LRI1 8-leaf power-of-two tree binds the 512-bit product n plus d,q,r. Outsider (including RNS+Newton-Raphson + OpenSSL dgst) checks n==a*b and q*d+r==n and r<d without LinVM"
  inclusion="LIP1: 34 published inclusion proofs (8 LRI1 + 8 LGE1 + LNR1 max_sq + 8 LCR2 E2E + 9 LCR2-full). RNS/Newton auditor binds packed LCR2 EXACT/OVERPAID and PHANTOM_APPROVE via mulDiv(fee,rout,den)"
  guards="-1 on d=0 (coprocessor) and zero amount_in (both LCR2 trees); -2 on q overflow, SafeMath-width phantom (LCR2), and ain=2^256-1 fee overflow (LCR2-full)"
  oracles="previous 1.25 oracles plus RNS+Newton-Raphson (RNS_NEWTON_CONSENSUS) on the n=1060 batch; RNS/Newton on 6 LCR2 EXACT/OVERPAID and 6 LCR2-full + PHANTOM_APPROVE"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor APPROVES; settle_u512_swap APPROVES; settle_u256_word -2. 512-bit intermediate off the suspect list; replacing the SafeMath-width settler body remains required"
  receipt="LNR1 240-byte records; LCR2 208-byte records; LGE1; LRI1; LIP1; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected"
  lcr2="3 EXACT_INPUT + 3 OVERPAID_INPUT with settle_u256_word == coprocessor == ref_amount_out and steps!=0; GUARD_ZERO -1; GUARD_OVERFLOW -2"
  lcr2_full="same 3 EXACT + 3 OVERPAID via settle_u512_swap == ref_amount_out_full plus PHANTOM_APPROVE"
}

.n{
  not_1="EVM mulmod opcode / solc FullMath.sol on-chain (algorithm pin; opcode not executed)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes the SafeMath-width u256 settler by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

.m{
  host="lin_c0 C11, gcc -std=c11, python3 RNS+Newton-Raphson + Toom-10+SRT-512 + Toom-9+SRT-256 + Toom-8+SRT-128 + Toom-7+SRT-64 + Toom-6+SRT-32 + Toom-5+SRT-16 + FNT+SRT-8 + Toom-4+BZ + hashlib, node BigInt + crypto, openssl dgst, go math/big, javac BigInteger, libgmp.so.10, perl Math::BigInt::Calc, GNU bc 1.07.1, rustc zero-crate radix-2^64; no Zig"
  rns_selftest="SELFTEST_PASS rns_newton q*d+r==n ge512 rns_prod newton"
  gate="198/198 PASS"
  published_lip1_proofs=34
  self_gate_steps=6710747
