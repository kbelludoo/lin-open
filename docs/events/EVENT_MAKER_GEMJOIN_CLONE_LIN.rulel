@RULEL:MAKER_GEMJOIN_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-GEMJOIN"
@TITLE="Clone-lin of Maker/Sky GemJoin.join/exit with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-14"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-gemjoin"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Maker GemJoin.join/exit collateral-adapter math into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs; wad slip; Solidity uint256 / bytes32 ilk / 2**255 overflow is NOT claimed"
  commercial_hook="GemJoin is the ERC20 collateral adapter: every ETH/WBTC/ilk that enters or leaves a Maker/Sky CDP is vat.slip ±wad plus transferFrom/transfer. Making live/usr_gem/sender_gem/token balances explicit, preserving exit-after-cage, and replacing wrapping i64 add with fail-closed add, is an audit improvement for adapter simulators, not a TVL claim"
}

.u{
  repo="https://github.com/makerdao/dss"
  path="src/join.sol"
  function="GemJoin.join / GemJoin.exit / vat.slip / gem.transferFrom"
  license="AGPL-3.0-or-later"
  commit="fa4f6630afb0624d04a003e920b0d71a00331d98"
  git_blob_sha="42b01c91c8f2a6b776440e16dea2c94497d966b0"
  file_sha256="96fceff4511aa976db5c6b144d83f4dd1bde832dd2f49fd6e54e69343b9583f9"
  vendored=false
}

.l{
  clone="src/lin_maker_gemjoin.lin"
  transpiler_delta="src/lin_from_solidity.lin REJ_SOLIDITY_TRANSFERFROM/VAT_SLIP/GEMJOIN_LIVE; src/lin_from_c.lin REJ_C_TRANSFERFROM/VAT_SLIP/WIDE_INT; src/lin_from_rust.lin REJ_RUST_TRANSFERFROM/VAT_SLIP/WIDE_INT"
  improvement_1="join/exit are storage+ERC20+vat.slip in Solidity; LIN takes op/live/usr_gem/sender_gem/adapter_token/sender_token/usr_token/wad as arguments"
  improvement_2="usr_gem+wad overflow i64; LIN fail-closes instead of wrapping (C11 wrap-detect XOR __int128)"
  improvement_3="join requires live==1 (GemJoin/not-live); exit after cage is accepted (inverse of DaiJoin)"
  improvement_4="distinct from DaiJoin (wad-to-rad mint/burn) and vat.slip alone: this kernel is the adapter cage plus ERC20 balances"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_gemjoin_c11.c (gcc -O2 -std=c11, __int128 XOR wrap-detect)"
  gate="test/verify_maker_gemjoin.sh"
}

.p{
  harness="test/prove_maker_gemjoin_external.py"
  evidence_json="examples/maker_gemjoin/maker_gemjoin_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-gemjoin"
}

.n{
  not_claimed_1="full uint256 / mainnet wad / ERC20 transfer host / vat.slip host / bytes32 ilk parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production GemJoin replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Maker, Sky, GemJoin, or the EVM"
  not_claimed_6="TVL or dollar savings from this kernel"
  not_claimed_7="wad=2**255 exit overflow (not representable at i64 scale)"
}

.v{
  method="PINNED_BYTES && C11_WRAP_EQ_I128 && LIN_C0_VM_EQ_C11 && PYTHON_BIGINT && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
