.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 24/24 PASS this run"
}

.p{
  mul="256x256->512 schoolbook, leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2; MUL 7*9=63 steps=9824"
  div="512/256 restoring div, remainder 32 limbs, 512-bit ge, q*d+r==n and r<d; 7*9/2 q=31 r=1 steps=987074; 2^255*2/3 q=0x5555555555555555 r=1 steps=1118732"
  ge="u512_ge_word: 2^256>=2^256-1 → 1; reverse → 0; 0>=0 → 1; plus ge inside the division loop"
  guards="-1 on d=0; -2 on q overflow (2^255*2/1)"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 limbs (n=1060 batch stdin, WIDTH_CONSENSUS); wrap-borrow regression 2*2^255/(2^256-1)=1 r=1"
  lin="Compiler-0 lin_c0 vm; u512_self_gate=1 steps=6710747; getAmountOut muldiv=1813 steps=977437"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor mulDiv(997,rout,1997) APPROVES steps=1106942; settle_u256_word -2 steps=11417 (SafeMath width). 512-bit intermediate off the suspect list; replacing that settler body remains required"
  uniswap_core="settle_u512_swap(1000,10000,20000) word0=1813 steps=968269 after 32-limb remainder ge"
  receipt="LNR1 240-byte records, domains LIN:U512:LEAF:1 / LIN:U512:NODE:1; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected; zero-LIN verifier examples/u512_coprocessor/verify_u512_receipt.py"
  lcr2="3 EXACT_INPUT (lin==ref==onchain, steps=222679/231320/229580) + 3 OVERPAID_INPUT (lin==ref, onchain diverges as expected, steps=230456/231383/234404); guards -1/-2 steps=1570/11417. Full 2000/157 campaign still required"
}

.n{
