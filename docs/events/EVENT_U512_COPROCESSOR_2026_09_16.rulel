@RULEL:U512_COPROCESSOR_EVENT:1.7.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-09-16"
@TITLE="512-bit intermediate proved as numeric coprocessor with auditable receipt"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-09-16"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the SafeMath-width settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 57/57 PASS this run"
  delta="schema 1.7: GNU MP mpz (dlopen libgmp.so.10) is an eighth math oracle; LIP1 now includes all 8 LCR2 settlement leaves so packed 208-byte records bind to ref_amount_out (EXACT/OVERPAID) and guards -1/-2 without LinVM; C11 binary LIP1 EXACT receipt; GMP recomputes mulDiv(fee,rout,den) on the 6 settlement vectors; zero-LIN Python AND Node inclusion auditors print lcr2_inclusion 8"
}

.p{
  mul="256x256->512 schoolbook, leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 published leaf; MUL 7*9=63 steps=9824"
  div="512/256 restoring div, remainder 32 limbs, 512-bit ge, q*d+r==n and r<d; 7*9/2 q=31 r=1 steps=987074; 2^255*2/3 q=0x5555555555555555 r=1 steps=1118732"
  ge="u512_ge_word + LGE1 8-leaf power-of-two tree: 2^256>=2^256-1 → 1 steps=1365; reverse → 0 steps=1373; 0>=0 → 1; (2^256-1)^2 >= 2^511 → 1; reverse → 0; equals; 2^512-1>=1; OpenSSL BN_ucmp, Node BigInt, Go math/big.Cmp, Java BigInteger.compareTo, and GNU MP mpz_cmp agree"
  identity="LRI1 8-leaf power-of-two tree binds the 512-bit product n plus d,q,r. Outsider (Python int / Node BigInt / Java BigInteger / GNU MP) checks n==a*b and q*d+r==n and r<d without LinVM. Leaves: 7*9/2 r=1 steps=987074; 2^255*2/3 r=1 steps=1118684; getAmountOut 1813 r=2439000 steps=977389; phantom 997*ceil(2^256/997)/1997 r=672 steps=1106942; n<d q=0 r=1 steps=981724; wrap-borrow 2*2^255/(2^256-1)=1 r=1 steps=821254; 3*5/4 r=3 steps=983864; 100*200/50 r=0 steps=984936"
  inclusion="LIP1: 26 published inclusion proofs (8 LRI1 + 8 LGE1 + LNR1 max_sq + 8 LCR2 E2E + LCR2-full PHANTOM_APPROVE). Path walks domain-separated SHA-256. C11 lin_sha256 verifies the 188-byte phantom remainder-identity receipt (nsib=3) against LRI1 root AND a binary LCR2 EXACT receipt against LCR2 root. 1-bit sibling tamper rejected. Zero-LIN Python AND Node auditors bind packed LRI1 bytes to a,b via n==a*b and q*d+r==n and packed LCR2 bytes to ref_amount_out (EXACT aout==ref==onchain, OVERPAID aout==ref!=onchain, GUARD_ZERO -1, GUARD_OVERFLOW -2) with steps!=0"
  guards="-1 on d=0 (coprocessor) and zero amount_in (both LCR2 trees); -2 on q overflow (2^255*2/1), SafeMath-width phantom (LCR2), and ain=2^256-1 fee overflow (LCR2-full)"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 identity64 + Node.js BigInt + OpenSSL BIGNUM + Go math/big + Java BigInteger + GNU MP mpz (n=1060 batch, WIDTH_CONSENSUS NODE_BIGINT_CONSENSUS OPENSSL_BN_CONSENSUS GO_BIGINT_CONSENSUS JAVA_BIGINT_CONSENSUS GMP_MPZ_CONSENSUS); wrap-borrow regression 2*2^255/(2^256-1)=1 r=1; GMP_MPZ_CONSENSUS on 6 LCR2 EXACT/OVERPAID mulDiv(fee,rout,den)"
  lin="Compiler-0 lin_c0 vm; u512_self_gate=1 steps=6710747; getAmountOut muldiv=1813 steps=977437"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor mulDiv(997,rout,1997) APPROVES steps=1106942; settle_u512_swap APPROVES steps=1098245 q=0x20d135b66ae990fc484cea55e38a936bcf497445394d4cc984add428823e4d; settle_u256_word -2 steps=11481. 512-bit intermediate off the suspect list; replacing the SafeMath-width settler body remains required for that ABI"
  uniswap_core="settle_u512_swap(1000,10000,20000) word0=1813 steps=968269 after 32-limb remainder ge"
  receipt="LNR1 240-byte records, domains LIN:U512:LEAF:1 / LIN:U512:NODE:1; 14 published leaves; LCR2 208-byte records, domains LIN:LEAF:1 / LIN:NODE:1; 8 published LCR2 leaves; 9 published LCR2-full leaves; LGE1 208-byte records, domains LIN:U512:GE:LEAF:1 / LIN:U512:GE:NODE:1; 8 published ge leaves; LRI1 240-byte records, domains LIN:U512:RI:LEAF:1 / LIN:U512:RI:NODE:1; 8 published remainder-identity leaves; 26 LIP1 inclusion proofs; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected; zero-LIN Python AND Node verifiers recompute five campaign merkles and LIP1 paths from the JSON"
  lcr2="3 EXACT_INPUT (lin==coprocessor==ref==onchain) + 3 OVERPAID_INPUT (lin==coprocessor==ref, onchain diverges); GUARD_ZERO steps=1570; GUARD_OVERFLOW steps=11481. Packed records are LIP1-included. Full 2000/157 campaign still required"
  lcr2_full="same 3 EXACT + 3 OVERPAID via settle_u512_swap == ref_amount_out_full (steps=929722/951223/946903/949069/951286/964003); PHANTOM_APPROVE steps=1098245; GUARD_ZERO steps=1619; GUARD_FEE_OVERFLOW steps=2033"
}

.n{
  not_1="FullMath.sol CRT / mulmod assembly parity (width pin only)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes the SafeMath-width u256 settler by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

.m{
  host="lin_c0 C11, gcc -std=c11, python3, node BigInt + crypto, openssl dgst + libcrypto.so.3 BN via dlopen, go math/big, javac java.math.BigInteger, libgmp.so.10 mpz via dlopen; no Zig"
  c11_selftest="SELFTEST_PASS identity_2_255_x2_div3 q*d+r==n plus ge512 and identity64 (no Python)"
  node_selftest="SELFTEST_PASS node_bigint q*d+r==n ge512"
  openssl_bn_selftest="SELFTEST_PASS openssl_bn q*d+r==n ge512"
  go_selftest="SELFTEST_PASS go_math_big q*d+r==n ge512"
