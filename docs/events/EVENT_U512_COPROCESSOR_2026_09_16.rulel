@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 25/25 PASS this run"
  delta="schema 1.2: zero-LIN verifier recomputes LNR1 merkle AND LCR2 merkle from published leaves (3 EXACT + 3 OVERPAID + GUARD_ZERO -1 + GUARD_OVERFLOW -2); C11 64-bit path checks q*d+r==n (identity64); C11 self-test covers 512-bit ge (2^256>=2^256-1)"
}

.p{
  mul="256x256->512 schoolbook, leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 published leaf; MUL 7*9=63 steps=9824"
  div="512/256 restoring div, remainder 32 limbs, 512-bit ge, q*d+r==n and r<d; 7*9/2 q=31 r=1 steps=987074; 2^255*2/3 q=0x5555555555555555 r=1 steps=1118732"
  ge="u512_ge_word: 2^256>=2^256-1 → 1; reverse → 0; 0>=0 → 1; plus ge inside the division loop; C11 ge16 self-test"
  guards="-1 on d=0 (coprocessor) and zero amount_in (settler LCR2); -2 on q overflow (2^255*2/1) and SafeMath-width phantom (settler LCR2)"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 limbs with identity64 (n=1060 batch stdin, WIDTH_CONSENSUS); wrap-borrow regression 2*2^255/(2^256-1)=1 r=1"
  lin="Compiler-0 lin_c0 vm; u512_self_gate=1 steps=6710747; getAmountOut muldiv=1813 steps=977437"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor mulDiv(997,rout,1997) APPROVES steps=1106942; settle_u256_word -2 steps=11481 (SafeMath width + leftover-carry). 512-bit intermediate off the suspect list; replacing that settler body remains required"
  uniswap_core="settle_u512_swap(1000,10000,20000) word0=1813 steps=968269 after 32-limb remainder ge"
  receipt="LNR1 240-byte records, domains LIN:U512:LEAF:1 / LIN:U512:NODE:1; 14 published leaves; LCR2 208-byte records, domains LIN:LEAF:1 / LIN:NODE:1; 8 published LCR2 leaves; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected; zero-LIN verifier recomputes both campaign merkles from the JSON"
  lcr2="3 EXACT_INPUT (lin==coprocessor==ref==onchain, settler steps=222743/231384/229644, cop steps=938790/960211/955907) + 3 OVERPAID_INPUT (lin==coprocessor==ref, onchain diverges, settler steps=230520/231447/234468); GUARD_ZERO steps=1570; GUARD_OVERFLOW steps=11481. Full 2000/157 campaign still required"
}

.n{
  not_1="FullMath.sol CRT / mulmod assembly parity (width pin only)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes u256 by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

