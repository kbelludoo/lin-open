@RULEL:U512_COPROCESSOR_EVENT:1.0.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-09-16"
@TITLE="512-bit intermediate proved as numeric coprocessor with auditable receipt"
@STATUS="PENDING_THIS_RUN"
@DATE="2026-09-16"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py"
}

.p{
  mul="256x256->512 schoolbook, leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2"
  div="512/256 restoring div, remainder 32 limbs, 512-bit ge, q*d+r==n and r<d"
  ge="u512_ge_word plus ge inside the division loop"
  guards="-1 on d=0; -2 on q overflow (2^255*2/1)"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 limbs (full-range batch stdin, WIDTH_CONSENSUS); wrap-borrow regression 2*2^255/(2^256-1)=1 r=1"
  receipt="LNR1 240-byte records, domains LIN:U512:LEAF:1 / LIN:U512:NODE:1; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL; 1-bit leaf tamper rejected; zero-LIN verifier on evidence JSON"
  lcr2="3 EXACT_INPUT + 3 OVERPAID_INPUT from mainnet_unfiltered.json with settle_u256_word == ref_amount_out and steps!=0; guards -1/-2. Full 2000/157 campaign still required"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor APPROVES; settle_u256_word -2 (SafeMath width). 512-bit intermediate off the suspect list; replacing that settler body remains required"
}

.n{
  not_1="FullMath.sol CRT / mulmod assembly parity (width pin only)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes u256 by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

.m{
  host="lin_c0 C11, gcc -std=c11, python3, node crypto, openssl dgst; no Zig"
  note="hashes and step counts filled after make u512-coprocessor-proof this run"
}

.h{
  lin_src="sha256:PENDING"
  oracle_c="sha256:PENDING"
  auditor_c="sha256:PENDING"
  harness="sha256:PENDING"
  lnr1_merkle="sha256:PENDING"
  lcr2_merkle="sha256:PENDING"
  fullmath_sol="sha256:959c52e1c860bfbede3e33c8d04910c11038973173aa3478547cbad2e444880e"
}

.v{
  method="PYTHON_BIGINT && C11_LIMB16 && C11_U64_I128 && LIN_C0_VM && LNR1_QUAD_AUDITOR && LCR2_SLICE && TAMPER_REJECT && OPENSSL_DGST"
  on_fail="do not publish PASS"
}
