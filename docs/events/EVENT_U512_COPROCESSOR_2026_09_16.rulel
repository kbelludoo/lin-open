@RULEL:U512_COPROCESSOR_EVENT:1.2.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-09-16"
@TITLE="Numeric coprocessor: 512-bit mulDiv with Python/C11/Node oracles and LNR1 receipts"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-09-16"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .h=hashes .v=verdict}

.s{
  purpose="sell LIN as a numeric coprocessor with an auditable receipt, not as a Uniswap replacement"
  host="transpile/c/bin/lin_c0 + lin_bc1_run (C11, no Zig) + gcc + python3 + node"
  width="uint256 operands; 512-bit product; 16-bit limbs"
  class_definition="TOY=sized down for teaching | EXPERIMENTAL=real FullMath *width* on a reduced algorithm (schoolbook, not CRT) | REAL_WORLD=as deployed"
}

.p{
  mul="256x256->512 schoolbook with carry into 32 limbs; leftover carry after 32 limbs fail-closes; (2^256-1)^2 product vs Python int"
  ge="unsigned 512-bit compare of product vs 256-bit d, and of remainder vs d in the restoring loop"
  div="restoring 512/256->256, abort -2 if quotient bit >= 256"
  identity="q*d+r==n and r<d (Python int, C11 16-bit, C11 64-bit reconstruct without Python, Node.js BigInt, C11 LNR1 auditor)"
  guards="-1 d=0; -2 q overflow on (2^256-1)^2/1"
  two_pow_255="2^255 * 2 / 3 APPROVES q=0x5555.. repeating r=1 (C11 selftest, no Python)"
  canonical_amm="settle_u512_swap(1000,10000,20000)=1813 after remainder widened to 32 limbs"
  phantom="coprocessor mulDiv(997, ceil(2^256/997), 1997) APPROVES; settle_u256_word still -2 (SafeMath width). 512-bit intermediate is off the suspect list; replacing the settler body remains required"
  e2e_slice="1 EXACT_INPUT + 1 OVERPAID_INPUT vs ref_amount_out with real LinVM steps in LCR2. Full 2000/157 still required"
  auditor="Python hashlib AND Node.js crypto AND C11 lin_sha256: --self-test rejects a 1-bit leaf tamper"
  width_pin="FullMath.sol fixture sha256:959c52e1c860bfbede3e33c8d04910c11038973173aa3478547cbad2e444880e is WIDTH spec only"
}

.n{
  not_1="FullMath.sol CRT/mulmod assembly equivalence"
  not_2="2000/157 mainnet campaign on the coprocessor"
  not_3="computational soundness of Merkle (LNR1/LCR2 are tamper-evidence + identity)"
  not_4="LIN replacing Uniswap, the EVM, or a deployed pool"
  not_5="end-to-end replacement of settle_u256_word SafeMath-width body"
}

