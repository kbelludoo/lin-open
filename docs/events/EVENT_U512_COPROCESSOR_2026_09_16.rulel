@RULEL:U512_COPROCESSOR_EVENT:1.14.0
@CHALLENGE_ID="LIN-U512-COPROCESSOR-2026-09-17"
@TITLE="512-bit intermediate proved as numeric coprocessor with auditable receipt"
@STATUS="REPRODUCED_THIS_RUN"
@DATE="2026-09-17"
@CLASS="EXPERIMENTAL"

~R{.s=scope .p=proved .n=not_proved .m=measured .h=hashes .v=verdict}

.s{
  product="LIN as a numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why="u256 mulDiv(a,b,d)=(a*b)/d with a,b,d up to 2^256-1 needs a correct 512-bit product; otherwise the SafeMath-width settler lies or returns -2 where width-correct math approves"
  engine="src/lin_u512_coprocessor.lin (16-bit limbs) + 32-limb remainder ge in examples/defi_settlement_proof/u512_uniswap_v2_core.lin"
  make="make u512-coprocessor-proof"
  harness="python3 test/prove_u512_coprocessor_external.py → 114/114 PASS this run"
  delta="schema 1.14: Karatsuba 256x256->512 + Barrett 512/256 is a sixteenth independent math. Product: split at 128 bits; three 128x128 via 2xu64 schoolbook (64x64->128) — not 16-bit row-major (LIN) and not CRT/Mersenne. Division: mu=floor(2^512/d) by restoring the sparse numerator 2^512 (reciprocal, not dividing n); q=(n*mu)>>512 via 8xu64 schoolbook; at most two 512-bit ge corrections so r<d. Not restoring of n, not Knuth D, not Hensel inverse. Python int is used only for 64x64->128 products and bit tests. Zero-LIN Karatsuba auditor (verify_u512_karatsuba.py) recomputes n==a*b via Karatsuba, q*d+r==n via Barrett, binds mulDiv(fee,rout,den) on 3 EXACT + 3 OVERPAID + PHANTOM_APPROVE, and OpenSSL dgst of the LRI1 Merkle tree (FIPS abc ba7816bf…) — no gcc, no rustc, no LinVM. Still includes schema 1.13 CRT+Newton. Merkle roots unchanged vs 1.13 (engine frozen)."
}

.p{
  mul="256x256->512 schoolbook in the engine AND CRT reconstruction independently; leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 published leaf; MUL 7*9=63 steps=9824; CRT limb8 of max^2 = 0xfffffffffffffffe"
  div="512/256 restoring div in the engine AND Knuth D long division AND FullMath Newton independently; remainder 32/16/8 limbs / 64 bytes / CRT 4×uint64; 512-bit ge; q*d+r==n and r<d; 7*9/2 q=31 r=1 steps=987074; 2^255*2/3 q=0x5555555555555555 r=1 steps=1118732"
  ge="u512_ge_word + LGE1 8-leaf power-of-two tree: 2^256>=2^256-1 → 1 steps=1365; reverse → 0 steps=1373; 0>=0 → 1; (2^256-1)^2 >= 2^511 → 1; reverse → 0; equals; 2^512-1>=1; OpenSSL BN_ucmp, Node BigInt, Go math/big.Cmp, Java BigInteger.compareTo, GNU MP mpz_cmp, Perl Math::BigInt, C11 radix-2^32 ge32, rustc ge_limbs, Python radix-2^8 ge_bytes, Knuth D ge_limbs, CRT ge256, and POSIX GNU bc a>=b agree"
  identity="LRI1 8-leaf power-of-two tree binds the 512-bit product n plus d,q,r. Outsider (Python int / Node BigInt / Java BigInteger / GNU MP / Perl Math::BigInt::Calc / C11 radix-2^32 / rustc radix-2^64 / Python radix-2^8 / Knuth D / CRT+Newton / Karatsuba+Barrett / POSIX GNU bc) checks n==a*b and q*d+r==n and r<d without LinVM"
  inclusion="LIP1: 34 published inclusion proofs (8 LRI1 + 8 LGE1 + LNR1 max_sq + 8 LCR2 E2E + 9 LCR2-full). Path walks domain-separated SHA-256. C11 lin_sha256 verifies the 188-byte phantom remainder-identity receipt (nsib=3) against LRI1 root AND a binary LCR2 EXACT receipt against LCR2 root AND a binary LCR2-full PHANTOM_APPROVE receipt (nsib=4) against LCR2-full root. 1-bit sibling tamper rejected. Zero-LIN Python AND Node AND Perl auditors bind packed LCR2 bytes to ref_amount_out and packed LCR2-full bytes to ref_amount_out_full with steps!=0. rustc-only, radix-2^8+OpenSSL, Knuth-D+OpenSSL, CRT+OpenSSL, and Karatsuba+Barrett+OpenSSL auditors bind the same LCR2/phantom mulDiv and recompute LRI1 Merkle"
  guards="-1 on d=0 (coprocessor) and zero amount_in (both LCR2 trees); -2 on q overflow (2^255*2/1), SafeMath-width phantom (LCR2), and ain=2^256-1 fee overflow (LCR2-full)"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 identity64 + C11 radix-2^32 schoolbook + rustc radix-2^64 schoolbook + Python radix-2^8 schoolbook + Knuth Algorithm D + FullMath CRT+Newton + Karatsuba+Barrett + Node.js BigInt + OpenSSL BIGNUM + Go math/big + Java BigInteger + GNU MP mpz + Perl Math::BigInt::Calc + POSIX GNU bc (n=1060 batch, KARATSUBA_BARRETT_CONSENSUS); wrap-borrow regression 2*2^255/(2^256-1)=1 r=1; GMP/Perl/radix32/rust64/radix8/knuth_d/crt/karatsuba/bc on 6 LCR2 EXACT/OVERPAID mulDiv(fee,rout,den); Perl/radix32/rust64/radix8/knuth_d/crt/karatsuba/bc also on 6 LCR2-full + PHANTOM_APPROVE"
  lin="Compiler-0 lin_c0 vm; u512_self_gate=1 steps=6710747; getAmountOut muldiv=1813 steps=977437"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor mulDiv(997,rout,1997) APPROVES steps=1106942; settle_u512_swap APPROVES steps=1098245 q=0x20d135b66ae990fc484cea55e38a936bcf497445394d4cc984add428823e4d; settle_u256_word -2 steps=11481. 512-bit intermediate off the suspect list; replacing the SafeMath-width settler body remains required for that ABI"
  uniswap_core="settle_u512_swap(1000,10000,20000) word0=1813 steps=968269 after 32-limb remainder ge"
  receipt="LNR1 240-byte records; 14 published leaves; LCR2 208-byte records; 8 published LCR2 leaves; 9 published LCR2-full leaves; LGE1 8 ge leaves; LRI1 8 remainder-identity leaves; 34 LIP1 inclusion proofs; quad-auditor Python hashlib == Node crypto == C11 lin_sha256 == OpenSSL dgst; 1-bit leaf tamper rejected; CRT auditor recomputes identity with Chinese Remainder Theorem + Newton inverse and OpenSSL-dgst LRI1 Merkle"
  lcr2="3 EXACT_INPUT (lin==coprocessor==ref==onchain) + 3 OVERPAID_INPUT (lin==coprocessor==ref, onchain diverges); GUARD_ZERO steps=1570; GUARD_OVERFLOW steps=11481. Packed records are LIP1-included. Full 2000/157 campaign still required"
  lcr2_full="same 3 EXACT + 3 OVERPAID via settle_u512_swap == ref_amount_out_full (steps=929722/951223/946903/949069/951286/964003); PHANTOM_APPROVE steps=1098245; GUARD_ZERO steps=1619; GUARD_FEE_OVERFLOW steps=2033. All 9 packed records are LIP1-included"
}

.n{
  not_1="EVM mulmod opcode / solc FullMath.sol on-chain (algorithm pin; opcode not executed)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that 512 proof closes the SafeMath-width u256 settler by itself"
  not_5="zk or computational soundness of Merkle (tamper-evidence + re-execution)"
}

.m{
  host="lin_c0 C11, gcc -std=c11, python3 Karatsuba+Barrett + CRT+Newton + Knuth D + radix-2^8 schoolbook + hashlib, node BigInt + crypto, openssl dgst + libcrypto.so.3 BN via dlopen, go math/big, javac java.math.BigInteger, libgmp.so.10 mpz via dlopen, perl Math::BigInt::Calc + JSON::PP + Digest::SHA, GNU bc 1.07.1 BC_LINE_LENGTH=0, rustc 1.83.0 zero-crate radix-2^64 + FIPS SHA-256; no Zig"
  c11_selftest="SELFTEST_PASS identity_2_255_x2_div3 q*d+r==n plus ge512 and identity64 (no Python)"
  radix32_selftest="SELFTEST_PASS radix32 q*d+r==n ge512 carry_fits_u64"
  rust64_selftest="SELFTEST_PASS rust64 q*d+r==n ge512 carry_fits_u128"
  radix8_selftest="SELFTEST_PASS radix8 q*d+r==n ge512 carry_fits_u16"
  knuth_d_selftest="SELFTEST_PASS knuth_d q*d+r==n ge512 carry_fits_u64"
  crt_selftest="SELFTEST_PASS crt_fullmath q*d+r==n ge512 crt_prod newton"
  karatsuba_selftest="SELFTEST_PASS karatsuba_barrett q*d+r==n ge512 karatsuba_prod barrett"
  posix_bc_selftest="SELFTEST_PASS posix_bc q*d+r==n ge512"
  node_selftest="SELFTEST_PASS node_bigint q*d+r==n ge512"
  openssl_bn_selftest="SELFTEST_PASS openssl_bn q*d+r==n ge512"
  go_selftest="SELFTEST_PASS go_math_big q*d+r==n ge512"
  java_selftest="SELFTEST_PASS java_bigint q*d+r==n ge512"
  gmp_selftest="SELFTEST_PASS gmp_mpz q*d+r==n ge512"
  perl_selftest="SELFTEST_PASS perl_bigint q*d+r==n ge512 backend=Math::BigInt::Calc"
  gate="114/114 PASS"
  published_leaves=14
  published_lcr2_leaves=8
  published_lcr2_full_leaves=9
  published_lge1_leaves=8
  published_lri1_leaves=8
  published_lip1_proofs=34
}

