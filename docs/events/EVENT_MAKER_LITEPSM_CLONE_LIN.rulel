@RULEL:MAKER_LITEPSM_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-MAKER-DSS-LITE-PSM"
@TITLE="Clone-lin of Maker/Sky DssLitePsm sellGem/buyGem with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-14"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-maker-litepsm"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Maker/Sky DssLitePsm _sellGem/_buyGem into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs; WAD'=1e9; gem*to18 and fee (dai/wad)*tin+(dai%wad)*tin/wad fail-close if a partial product does not fit int64; Solidity uint256 is NOT claimed"
  commercial_hook="LitePSM is the DAI/USDC 1:1 peg swap that quotes tin/tout fees on gem*to18ConversionFactor; making HALTED, to18, tin/tout, and kiss whitelist explicit, and replacing wrapping i64 multiply with checked mul plus schoolbook fee, is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/sky-ecosystem/dss-lite-psm"
  path="src/DssLitePsm.sol"
  license="AGPL-3.0-or-later"
  commit="dbf0022225f645f5697e5517d0cf00810471bccf"
  git_blob_sha="8e18705eed287cfdf7f6b6e0a74b398b792cc243"
  file_sha256="502eed38778ac29758959cadbb3d2f36aa3af21144e7374483795581a6279ce8"
  fixture="live git pin; Solidity source is not vendored"
}

.l{
  clone="src/lin_maker_litepsm.lin"
  transpiler_delta="src/lin_from_solidity.lin REJ_SOLIDITY_HALTED/TO18/UNCHECKED; src/lin_from_c.lin REJ_C_WIDE_INT/HALTED/TO18; src/lin_from_rust.lin REJ_RUST_WIDE_INT/HALTED/TO18"
  improvement_1="_sellGem/_buyGem read tin/tout/to18ConversionFactor from storage/immutables in Solidity; LIN takes gem/to18/tin/tout/wad as arguments"
  improvement_2="gem*to18 and dai*tin overflow i64; LIN fail-closes instead of wrapping; fee uses (dai/wad)*tin+(dai%wad)*tin/wad matching Solidity floor"
  improvement_3="unchecked { daiOutWad -= fee } is an explicit psm_u_sub_ok (no silent underflow)"
  improvement_4="HALTED is sentinel -1, not type(uint256).max; kiss whitelist is an explicit kissed argument"
  improvement_5="distinct from DaiJoin wad→rad and GemJoin ilk slip"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/maker_litepsm_c11.c (gcc -O2 -std=c11, wrap-detect XOR __int128)"
  gate="test/verify_maker_litepsm.sh"
}

.p{
  harness="test/prove_maker_litepsm_external.py"
  evidence_json="examples/maker_litepsm/maker_litepsm_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-maker-litepsm"
}

.n{
  not_claimed_1="full uint256 / mainnet LitePSM / USDC-6 * 1e12 wad parity"
  not_claimed_2="LIN is faster than the EVM or solc"
  not_claimed_3="this clone is a production PSM replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Maker, Sky, or the EVM"
  not_claimed_6="vat.frob fill/trim/chug, pocket ERC-20 transfers, wards/bud storage"
}

.v{
  method="PINNED_BYTES && C11_WRAP_EQ_I128 && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
