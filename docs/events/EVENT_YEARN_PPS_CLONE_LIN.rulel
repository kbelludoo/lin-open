@RULEL:YEARN_PPS_CLONE_LIN:1.0.0
@CHALLENGE_ID="LIN-YEARN-V2-PPS"
@TITLE="Clone-lin of Yearn V2 pricePerShare / locked-profit with C11 Compiler 0 proofs"
@STATUS="EXPERIMENTAL_UINT64_SCALE"
@DATE="2026-11-11"
@CLONE_LIN="https://github.com/kbelludoo/clone-lin-yearn-pps"

~R{.s=spec .u=upstream .l=lin .c=compiler0 .p=proofs .n=non_goals .v=verdict}

.s{
  purpose="transpile Yearn V2 vault share pricing into deterministic LIN, compile in memory with C11 compiler 0, and publish only auditable results in lin-open"
  class="EXPERIMENTAL"
  class_definition="TOY = sized down for teaching | EXPERIMENTAL = real published algorithm on a deliberately reduced operand width | REAL_WORLD = as deployed on Ethereum mainnet"
  operand_width="uint64 inputs, 128-bit product for (a*b)/d; Vyper uint256 is NOT claimed"
  commercial_hook="Yearn V2 yVaults price shares as freeFunds/totalSupply after a linear unlock of harvested profit; making storage timestamps explicit and replacing wrapping i64 multiply with 128-bit muldiv is an audit improvement, not a TVL claim"
}

.u{
  repo="https://github.com/yearn/yearn-vaults"
  path="contracts/Vault.vy"
  license="AGPL-3.0-or-later"
  commit="97ca1b2e4fcf20f4be0ff456dabd020bfeb6697b"
  git_blob_sha="1159912c093b12cf8d758f71d2d568cda69990af"
  file_sha256="bc36fcf88e8662a7e1bd5f9c8213645214697dd72afda4e0cd87bfaeb0c4a19b"
  fixture="hash_only_not_vendored"
  note="Yearn publishes Vault.vy under AGPL-3.0-or-later; lin-open pins hashes only and does not redistribute the Vyper source"
}

.l{
  clone="src/lin_yearn_pps.lin"
  lin_sha256="6bc6c126ce1b372cdbee88d011c32151705c18fbd6375047c5a48c622a20a076"
  transpiler_delta="src/lin_from_vyper.lin v1: Yearn PPS/lockedProfit reject + 10 ** N expansion; src/lin_from_solidity.lin v3 REJ_SOLIDITY_YEARN_PPS; src/lin_from_rust.lin v2; src/lin_from_c.lin v2"
  improvement_1="pricePerShare/_calculateLockedProfit are view-on-storage in Vyper; LIN takes now/lastReport/lockedProfit/degradation/idle/debt/supply/decimals as arguments"
  improvement_2="ratio*lockedProfit and unit*freeFunds overflow i64; LIN uses schoolbook 128-bit muldiv matching C11 __int128"
  improvement_3="now < lastReport: Vyper uint256 underflows; LIN fail-closes to 0"
  improvement_4="empty vault is 1:1 shares=amount (not ERC-4626 virtual offset); harvest profit unlocks linearly vs ignore-lock (Lido-style 1e18 at t0) vs step-unlock (still 0.9e18 at 3h)"
}

.c{
  host="transpile/c/bin/lin_c0 (C11, no Zig)"
  in_memory_jit="libtcc via lin_c0 jit / roundtrip-jit"
  oracle="test/oracles/yearn_pps_c11.c (gcc -O2 -std=c11, __int128 XOR limb clone)"
  gate="python3 test/prove_yearn_pps_external.py"
}

.p{
  harness="test/prove_yearn_pps_external.py"
  evidence_json="examples/yearn_pps/yearn_pps_evidence.json"
  clone_lin_repo="https://github.com/kbelludoo/clone-lin-yearn-pps"
}

.n{
  not_claimed_1="full uint256 / mainnet yVault parity"
  not_claimed_2="LIN is faster than the EVM or vyper"
  not_claimed_3="this clone is a production Yearn vault replacement"
  not_claimed_4="zk / computational soundness of Merkle receipts"
  not_claimed_5="LIN replaces Yearn, ERC-4626, Lido, or the EVM"
  not_claimed_6="TVL or dollar savings from running this kernel"
}

.v{
  method="PINNED_BYTES && C11_I128_EQ_LIMBS && LIN_C0_VM_EQ_C11 && OPTIONAL_JIT_CONSENSUS"
  on_fail="do not publish a PASS status"
}
