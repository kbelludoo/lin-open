@RULEL:U512_COPROCESSOR:1.37.0
@TITLE="LIN numeric coprocessor: 512-bit intermediate with auditable receipt"
@CLASS="EXPERIMENTAL"
@DATE="2026-10-12"

~R{.s=sell .p=proves .n=not_proves .h=how .g=gates}

.s{
  product="numeric coprocessor with an auditable receipt, not a Uniswap replacement"
  why_512="real u256 mulDiv(a,b,d)=(a*b)/d has a*b up to 2^512-1; without a correct 512 intermediate the SafeMath-width u256 settler lies or returns -2 where FullMath-width would approve"
  engine="src/lin_u512_coprocessor.lin 16-bit limbs; examples/defi_settlement_proof/u512_uniswap_v2_core.lin remainder is 32 limbs with 512-bit ge"
}

.p{
  mul="256x256->512 schoolbook with leftover-carry fail-closed; (2^256-1)^2 lo=1 hi=2^256-2 is a published LNR1 leaf; nineteen reconstructions agree: LIN/C11 16-bit, C11 radix-2^32, rustc radix-2^64, Python radix-2^8, Knuth D radix-2^32, FullMath CRT, Karatsuba 128-bit split, Toom-3 86-bit 3-way, NTT base-256 length-64 over p=998244353, Comba column mul, Toom-4 64-bit 4-way, FNT base-2^16 length-32 over Z/(2^64+1)Z (ω=16 shift butterflies — not NTT, not Toom-4, not Comba), AND Toom-5 52-bit 5-way (nine eval products, Newton interpolation — not Toom-4, not FNT), AND Toom-6 43-bit 6-way (eleven eval products, Newton interpolation — not Toom-5, not FNT), AND Toom-7 37-bit 7-way (thirteen eval products, Newton interpolation — not Toom-6, not FNT), AND Toom-8 32-bit 8-way (fifteen eval products, Newton interpolation — not Toom-7, not FNT), AND Toom-9 32-bit 9-way padded 288 (seventeen eval products, Newton interpolation — not Toom-8, not FNT), AND Toom-10 32-bit 10-way padded 320 (nineteen eval products, Newton interpolation — not Toom-9, not FNT), AND RNS 17 coprime 32-bit primes Garner mixed-radix (product 544 bits — not CRT/Mersenne, not Toom-10, not FNT), AND Schönhage–Strassen negacyclic Fermat FFT over F7=2^128+1 length-32 (ψ=2^4, ω=2^8 shift butterflies — not FNT over F6, not NTT, not RNS), AND unbalanced Toom-Cook 3x7 (37-bit digits, three 111-bit groups, nine eval products at {0,±1,±2,±3,4,inf}, Lagrange interpolation — not balanced Toom-3..10, not SS, not FNT), AND unbalanced Toom-Cook 2x5 (52-bit digits, three 104-bit groups, six eval products at {0,±1,±2,inf}, Lagrange interpolation — not unbalanced Toom-3x7, not balanced Toom-3..10, not SS), AND unbalanced Toom-Cook 2x7 (37-bit digits, four 74-bit groups, seven eval products at {0,±1,±2,±3} plus inf, Lagrange interpolation — not unbalanced Toom-2x5, not unbalanced Toom-3x7, not balanced Toom-3..10, not SS), AND IEEE-754 binary64 FFT convolution (8-bit digits, length-64 Cooley-Tukey — not Fermat SS, not FNT, not NTT, not Toom-2x7), AND Solinas NTT (p=2^64-2^32+1, 16-bit digits, length-32, ω=2^18, 2^64≡2^32-1 reduction — not p=998244353, not Fermat SS, not FNT, not IEEE-754 FFT), AND Dekker double-double convolution (32-bit digits, 8x8 schoolbook, Veltkamp split 2^27+1, Dekker two-product, Knuth two-sum — not IEEE-754 FFT, not FMA, not Solinas NTT, not Fermat SS, not FNT), AND IEEE-754 binary80 convolution (40-bit digits, 8x8 schoolbook, Veltkamp split 2^32+1, 64-bit significand — not binary64 Dekker 2^27+1, not FMA, not length-64 binary64 FFT), AND unbalanced Toom-Cook 2x9 (29-bit digits, five 58-bit groups, nine eval products at {0,±1,±2,±3,±4} plus inf, Lagrange interpolation — not unbalanced Toom-2x5/2x7/3x7, not binary80), AND unbalanced Toom-Cook 2x11 (24-bit digits, six 48-bit groups, eleven eval products at {0,±1,±2,±3,±4,±5} plus inf, Lagrange interpolation — not unbalanced Toom-2x5/2x7/2x9/3x7, not binary80), AND unbalanced Toom-Cook 2x13 (20-bit digits, seven 40-bit groups, thirteen eval products at {0,±1,±2,±3,±4,±5,±6} plus inf, Lagrange interpolation — not unbalanced Toom-2x5/2x7/2x9/2x11/3x7, not binary80)"
  div="512/256 restoring division in the engine AND Knuth Algorithm D AND FullMath Newton–Raphson AND Barrett AND Goldschmidt AND SRT radix-4 AND non-restoring AND Burnikel-Ziegler AND SRT radix-8 (digits {-4..4}, thresholds ±D/2 ±3D/2 ±5D/2 ±7D/2 — not SRT radix-4) AND SRT radix-16 (digits {-8..8}, thresholds ±D/2 … ±15D/2, 512-bit ge so r<d — not SRT radix-8, not restoring-of-n, not Knuth D, not Barrett, not Goldschmidt, not Burnikel-Ziegler) AND SRT radix-32 (digits {-16..16}, thresholds ±D/2 … ±31D/2, 5 bits/step, 512-bit ge so r<d — not SRT radix-16, not restoring-of-n) AND SRT radix-64 (digits {-32..32}, thresholds ±D/2 … ±63D/2, 6 bits/step, 512-bit ge so r<d — not SRT radix-32, not restoring-of-n) AND SRT radix-128 (digits {-64..64}, thresholds ±D/2 … ±127D/2, 7 bits/step, 512-bit ge so r<d — not SRT radix-64, not restoring-of-n) AND SRT radix-256 (digits {-128..128}, thresholds ±D/2 … ±255D/2, 8 bits/step, 512-bit ge so r<d — not SRT radix-128, not restoring-of-n) AND SRT radix-512 (digits {-256..256}, thresholds ±D/2 … ±511D/2, 9 bits/step, 512-bit ge so r<d — not SRT radix-256, not restoring-of-n) AND Newton-Raphson reciprocal (v=2^(512-bitlen(d)), ten iterations v:=2v-((d*v*v)>>512), q=(n*v)>>512, 512-bit ge so r<d — not Goldschmidt dual N,D, not Hensel mod 2^256, not Barrett mu from sparse 2^512, not SRT) AND SRT radix-1024 (digits {-512..512}, thresholds ±D/2 … ±1023D/2, 10 bits/step, 512-bit ge so r<d — not SRT radix-512, not Newton-Raphson, not restoring-of-n) AND Barrett mu=floor(2^768/d) (q=(n*mu)>>768, 512-bit ge so r<d — not Barrett mu=floor(2^512/d), not SRT radix-1024, not Newton) AND SRT radix-2048 (digits {-1024..1024}, thresholds ±D/2 … ±2047D/2, 11 bits/step, 512-bit ge so r<d — not SRT radix-1024, not Barrett-768, not restoring-of-n) AND Barrett mu=floor(2^1024/d) (q=(n*mu)>>1024, 512-bit ge so r<d — not Barrett mu=floor(2^512/d) or floor(2^768/d), not SRT radix-2048, not restoring-of-n) AND Montgomery REDC (R=2^512, even-d CRT) plus Jebelean exact q of n-r (512-bit ge so r<d — not Barrett, not SRT, not Newton, not Hensel-of-n, not restoring-of-n) AND Granlund–Montgomery magic (M=ceil(2^p/d) from nc=2^512-1-((2^512-1)%d), add-indicator, d-dependent shift, 512-bit ge so r<d — not Barrett mu=floor(2^512/d) or floor(2^768/d) or floor(2^1024/d), not Montgomery REDC, not Jebelean, not SRT, not Newton, not Hensel-of-n, not restoring-of-n) AND Cook–Sieveking precision-doubling reciprocal (8-bit leading-digit seed, fixed scale K=768, multiplicative y:=(y*(2^{K+1}-d*y))>>K until 8→16→…→1024 bits, q=(n*y)>>768, 512-bit ge so r<d — not fixed-width Newton 10 iters at 512, not Goldschmidt dual N,D, not Barrett mu=floor(2^512/d) or floor(2^768/d) or floor(2^1024/d) in one shot, not Granlund–Montgomery, not Montgomery REDC, not Jebelean, not SRT, not Hensel-of-n, not restoring-of-n) AND Karp–Markstein half-plus reciprocal (16-bit seed, K=448, q0=(n*y)>>448, exact r0=n-q0*d, q=q0+(r0*y)>>448, 512-bit ge so r<d — not Cook K=768 to 1024, not Newton 10 iters at 512, not Goldschmidt, not Barrett 2^512/2^768/2^1024 in one shot, not Granlund–Montgomery, not Montgomery REDC, not Jebelean, not SRT, not Hensel-of-n, not restoring-of-n) AND Svoboda–Tung (bit-normalize leading digit >= 2^15, m=floor((2^32-1)/(d1+1)), leading-digit qhat, Tung restore, 512-bit ge so r<d — not Knuth two-digit estimate, not Barrett μ of the whole d, not Karp–Markstein, not Cook–Sieveking, not SRT, not Newton, not Goldschmidt, not Granlund–Montgomery, not Montgomery REDC, not Jebelean, not Hensel-of-n, not restoring-of-n) AND Barrett mu=floor(2^1280/d) (q=(n*mu)>>1280, 512-bit ge so r<d — not Barrett mu=floor(2^512/d) or floor(2^768/d) or floor(2^1024/d), not Svoboda–Tung, not Karp–Markstein, not Cook–Sieveking, not SRT, not Newton, not Goldschmidt, not Granlund–Montgomery, not Montgomery REDC, not Jebelean, not Hensel-of-n, not restoring-of-n); AND Barrett mu=floor(2^1536/d) (q=(n*mu)>>1536, 512-bit ge so r<d — not Barrett mu=floor(2^512/d) or floor(2^768/d) or floor(2^1024/d) or floor(2^1280/d), not Svoboda–Tung, not Karp–Markstein, not Cook–Sieveking, not SRT, not Newton, not Goldschmidt, not Granlund–Montgomery, not Montgomery REDC, not Jebelean, not Hensel-of-n, not restoring-of-n); q*d+r==n and r<d (LIN + C11 16-bit + C11 64-bit __int128 + C11 radix-2^32 + rustc radix-2^64 + Python radix-2^8 + Knuth D + CRT/Newton + Karatsuba/Barrett + Toom-3/Goldschmidt + NTT/SRT + Comba/NR + Toom-4/BZ + FNT/SRT-8 + Toom-5/SRT-16 + Toom-6/SRT-32 + Toom-7/SRT-64 + Toom-8/SRT-128 + Toom-9/SRT-256 + Toom-10/SRT-512 + RNS/Newton + SS/SRT-1024 + Toom-3x7/Barrett-768 + Toom-2x5/SRT-2048 + Toom-2x7/Barrett-1024 + FFT/Montgomery + Solinas/GM + Dekker-DD/Cook–Sieveking + binary80/Karp–Markstein + Toom-2x9/Svoboda–Tung + Toom-2x11/Barrett-1280 + Toom-2x13/Barrett-1536 + Node.js BigInt + OpenSSL BIGNUM + Go math/big + Java BigInteger + GNU MP mpz + Perl Math::BigInt::Calc + POSIX GNU bc)"
  ge="cmp/ge over 512 bits: u512_ge_word + eight published LGE1 leaves vs Python int, Node BigInt, OpenSSL BN_ucmp, Go math/big.Cmp, Java BigInteger.compareTo, GNU MP mpz_cmp, Perl Math::BigInt, C11 radix-2^32 ge32, rustc radix-2^64 ge_limbs, Python radix-2^8 ge_bytes, Knuth D ge_limbs, CRT ge256, Karatsuba/Barrett ge_limbs, Toom-3/Goldschmidt ge_limbs, NTT/SRT ge_limbs, Comba/NR ge_limbs, Toom-4/BZ ge_limbs, FNT/SRT-8 ge_limbs, Toom-5/SRT-16 ge_limbs, Toom-6/SRT-32 ge_limbs, Toom-7/SRT-64 ge_limbs, Toom-8/SRT-128 ge_limbs, Toom-9/SRT-256 ge_limbs, Toom-10/SRT-512 ge_limbs, RNS/Newton ge_limbs, SS/SRT-1024 ge_limbs, Toom-3x7/Barrett-768 ge_limbs, Toom-2x5/SRT-2048 ge_limbs, Toom-2x7/Barrett-1024 ge_limbs, FFT/Montgomery ge_limbs, Solinas/GM ge_limbs, Dekker-DD/Cook ge_limbs, binary80/KM ge_limbs, Toom-2x9/Svoboda–Tung ge_limbs, Toom-2x11/Barrett-1280 ge_limbs, Toom-2x13/Barrett-1536 ge_limbs, POSIX GNU bc a>=b, C11 lin_sha256 merkle"
  identity="LRI1 240-byte remainder-identity receipts: published n (512-bit product), d, q, r; outsider checks n==a*b and q*d+r==n and r<d without LinVM. Eight leaves including wrap-borrow 2*2^255/(2^256-1)=1 r=1 and phantom 997*ceil(2^256/997)/1997. Schema 1.37: POSIX GNU bc from published decimals AND rustc radix-2^64 AND Python radix-2^8 AND Knuth Algorithm D AND FullMath CRT+Newton AND Karatsuba+Barrett AND Toom-3+Goldschmidt AND NTT+SRT AND Comba+NR AND Toom-4+BZ AND FNT+SRT-8 AND Toom-5+SRT-16 AND Toom-6+SRT-32 AND Toom-7+SRT-64 AND Toom-8+SRT-128 AND Toom-9+SRT-256 AND Toom-10+SRT-512 AND RNS+Newton-Raphson AND Schönhage–Strassen+SRT-1024 AND unbalanced Toom-3x7+Barrett-768 AND unbalanced Toom-2x5+SRT-2048 AND unbalanced Toom-2x7+Barrett-1024 AND IEEE-754 FFT+Montgomery REDC AND Solinas NTT+Granlund–Montgomery AND Dekker double-double+Cook–Sieveking AND IEEE-754 binary80+Karp–Markstein AND unbalanced Toom-2x9+Svoboda–Tung AND unbalanced Toom-2x11+Barrett-1280 AND unbalanced Toom-2x13+Barrett-1536 plus OpenSSL dgst of the LRI1 Merkle tree"
  inclusion="LIP1 Merkle inclusion receipts: leaf bytes + sibling hashes + root. Schema 1.8/1.30 publish all 8 LCR2 settlement leaves AND all 9 LCR2-full FullMath-width leaves so an outsider verifies settle_u256_word vs ref_amount_out and settle_u512_swap vs ref_amount_out_full from packed 208-byte records without LinVM. C11 lin_sha256 verifies a binary LIP1 EXACT receipt, the phantom remainder-identity receipt, AND the LCR2-full PHANTOM_APPROVE receipt. JSON proofs verified by Python, Node, and Perl. rustc-only, radix-2^8, Knuth-D, CRT, Karatsuba/Barrett, Toom-3/Goldschmidt, NTT/SRT, Comba/NR, Toom-4/BZ, FNT/SRT-8, Toom-5/SRT-16, Toom-6/SRT-32, Toom-7/SRT-64, Toom-8/SRT-128, Toom-9/SRT-256, Toom-10/SRT-512, RNS/Newton, SS/SRT-1024, Toom-3x7/Barrett-768, Toom-2x5/SRT-2048, Toom-2x7/Barrett-1024, FFT/Montgomery, Solinas/GM, Dekker-DD/Cook, binary80/KM, Toom-2x9/Svoboda–Tung, and Toom-2x11/Barrett-1280 and Toom-2x13/Barrett-1536 auditors bind packed LCR2 EXACT/OVERPAID and PHANTOM_APPROVE via mulDiv(fee,rout,den). 1-bit sibling tamper rejected"
  oracles="Python int + C11 16-bit schoolbook + C11 64-bit __int128 limbs + C11 radix-2^32 schoolbook + rustc radix-2^64 schoolbook + Python radix-2^8 schoolbook + Knuth Algorithm D + FullMath CRT+Newton + Karatsuba+Barrett + Toom-3+Goldschmidt + NTT+SRT + Comba+NR + Toom-4+BZ + FNT+SRT-8 + Toom-5+SRT-16 + Toom-6+SRT-32 + Toom-7+SRT-64 + Toom-8+SRT-128 + Toom-9+SRT-256 + Toom-10+SRT-512 + RNS+Newton-Raphson + Schönhage–Strassen+SRT-1024 + unbalanced Toom-3x7+Barrett-768 + unbalanced Toom-2x5+SRT-2048 + unbalanced Toom-2x7+Barrett-1024 + IEEE-754 FFT+Montgomery + Solinas NTT+Granlund–Montgomery + Dekker double-double+Cook–Sieveking + IEEE-754 binary80+Karp–Markstein + unbalanced Toom-2x9+Svoboda–Tung + unbalanced Toom-2x11+Barrett-1280 + unbalanced Toom-2x13+Barrett-1536 + Node.js BigInt + OpenSSL BIGNUM + Go math/big + Java BigInteger + GNU MP mpz + Perl Math::BigInt::Calc + POSIX GNU bc; WIDTH_CONSENSUS … TOOM4_BZ_CONSENSUS FNT_SRT8_CONSENSUS TOOM5_SRT16_CONSENSUS TOOM6_SRT32_CONSENSUS TOOM7_SRT64_CONSENSUS TOOM8_SRT128_CONSENSUS TOOM9_SRT256_CONSENSUS TOOM10_SRT512_CONSENSUS RNS_NEWTON_CONSENSUS SS_SRT1024_CONSENSUS TOOM37_BARRETT768_CONSENSUS TOOM25_SRT2048_CONSENSUS TOOM27_BARRETT1024_CONSENSUS FFT_MONTGOMERY_CONSENSUS SOLINAS_GM_CONSENSUS DD_COOK_CONSENSUS B80_KM_CONSENSUS TOOM29_SVOBODA_CONSENSUS TOOM211_BARRETT1280_CONSENSUS TOOM213_BARRETT1536_CONSENSUS across the n=1060 batch; GMP, Perl, radix-2^32, rustc radix-2^64, Python radix-2^8, Knuth D, CRT, Karatsuba/Barrett, Toom-3/Goldschmidt, NTT/SRT, Comba/NR, Toom-4/BZ, FNT/SRT-8, Toom-5/SRT-16, Toom-6/SRT-32, Toom-7/SRT-64, Toom-8/SRT-128, Toom-9/SRT-256, Toom-10/SRT-512, RNS/Newton, SS/SRT-1024, Toom-3x7/Barrett-768, Toom-2x5/SRT-2048, Toom-2x7/Barrett-1024, FFT/Montgomery, Solinas/GM, Dekker-DD/Cook, binary80/KM, Toom-2x9/Svoboda–Tung, Toom-2x11/Barrett-1280, Toom-2x13/Barrett-1536, and GNU bc recompute mulDiv(fee,rout,den) on the 6 EXACT/OVERPAID LCR2 vectors; Perl, radix-2^32, rustc radix-2^64, Python radix-2^8, Knuth D, CRT, Karatsuba/Barrett, Toom-3/Goldschmidt, NTT/SRT, Comba/NR, Toom-4/BZ, FNT/SRT-8, Toom-5/SRT-16, Toom-6/SRT-32, Toom-7/SRT-64, Toom-8/SRT-128, Toom-9/SRT-256, Toom-10/SRT-512, RNS/Newton, SS/SRT-1024, Toom-3x7/Barrett-768, Toom-2x5/SRT-2048, Toom-2x7/Barrett-1024, FFT/Montgomery, Solinas/GM, Dekker-DD/Cook, binary80/KM, Toom-2x9/Svoboda–Tung, Toom-2x11/Barrett-1280, Toom-2x13/Barrett-1536, and GNU bc also recompute the 6 LCR2-full vectors plus PHANTOM_APPROVE (512-bit numerator)"
  receipt="LNR1 240-byte records, domains LIN:U512:LEAF:1 / LIN:U512:NODE:1; LCR2 208-byte records, domains LIN:LEAF:1 / LIN:NODE:1; LGE1 208-byte records, domains LIN:U512:GE:LEAF:1 / LIN:U512:GE:NODE:1; LRI1 240-byte records, domains LIN:U512:RI:LEAF:1 / LIN:U512:RI:NODE:1; LIP1 inclusion path over those domains; quad-auditor Python hashlib, Node crypto, C11 lin_sha256, OpenSSL dgst; 1-bit tamper rejected; schema 1.37 zero-LIN Python AND Node AND Perl verifiers recompute FIVE campaign merkles AND LIP1 inclusion AND bind packed LCR2 bytes to ref_amount_out AND packed LCR2-full bytes to ref_amount_out_full; POSIX GNU bc binds LRI1 decimals to q*d+r==n; rustc-only, radix-2^8, Knuth-D, CRT, Karatsuba/Barrett, Toom-3/Goldschmidt, NTT/SRT, Comba/NR, Toom-4/BZ, FNT/SRT-8, Toom-5/SRT-16, Toom-6/SRT-32, Toom-7/SRT-64, Toom-8/SRT-128, Toom-9/SRT-256, Toom-10/SRT-512, RNS/Newton, SS/SRT-1024, Toom-3x7/Barrett-768, Toom-2x5/SRT-2048, Toom-2x7/Barrett-1024, FFT/Montgomery, Solinas/GM, Dekker-DD/Cook, binary80/KM, Toom-2x9/Svoboda–Tung, and Toom-2x11/Barrett-1280 and Toom-2x13/Barrett-1536 auditors recompute identity + OpenSSL dgst of LRI1 Merkle and bind LCR2/phantom"
  e2e="LCR2 slice: settle_u256_word == coprocessor mulDiv(ain*997, reserve_out, rin*1000+ain*997) == ref_amount_out on 3 EXACT_INPUT + 3 OVERPAID_INPUT with real steps; guards -1 (zero in) and -2 (256-bit width) are LCR2 leaves; packed 208-byte records are LIP1-included and rebound by Python/Node/Perl/GMP/radix32/rust64/radix8/Knuth-D/CRT/Karatsuba-Barrett/Toom-3-Goldschmidt/NTT-SRT/Comba-NR/Toom-4-BZ/FNT-SRT8/Toom-5-SRT16/Toom-6-SRT32/Toom-7-SRT64/Toom-8-SRT128/Toom-9-SRT256/Toom-10-SRT512/RNS-Newton/SS-SRT1024/Toom37-Barrett768/Toom25-SRT2048/Toom27-Barrett1024/FFT-Montgomery/Solinas-GM/Dekker-DD-Cook/binary80-KM/Toom29-Svoboda-Tung/Toom211-Barrett1280/Toom213-Barrett1536/GNU bc without LinVM"
  e2e_full="LCR2-full: settle_u512_swap == ref_amount_out_full (512-bit numerator) on the same 3 EXACT + 3 OVERPAID plus PHANTOM_APPROVE plus GUARD_ZERO and GUARD_FEE_OVERFLOW (ain=2^256-1); all 9 leaves are LIP1-included"
  phantom="ain=1,rin=1,rout=ceil(2^256/997): coprocessor APPROVES; settle_u512_swap APPROVES; settle_u256_word returns -2. 512-bit intermediate is off the suspect list; replacing the SafeMath-width settler body remains required for that ABI"
  leftover="REVIEW_MATH leftover-carry after limbs 16..31 is still a cheap fail-closed assert; this increment does not mutate the SafeMath-width settler body"
}

.n{
  not_1="EVM mulmod opcode / solc FullMath.sol on-chain execution (CRT+Newton is the fifteenth auditor, Karatsuba+Barrett the sixteenth, Toom-3+Goldschmidt the seventeenth, NTT+SRT the eighteenth, Comba+NR the nineteenth, Toom-4+BZ the twentieth, FNT+SRT-8 the twenty-first, Toom-5+SRT-16 the twenty-second, Toom-6+SRT-32 the twenty-third, Toom-7+SRT-64 the twenty-fourth, Toom-8+SRT-128 the twenty-fifth, Toom-9+SRT-256 the twenty-sixth, Toom-10+SRT-512 the twenty-seventh, RNS+Newton-Raphson the twenty-eighth, Schönhage–Strassen+SRT-1024 the twenty-ninth, unbalanced Toom-3x7+Barrett-768 the thirtieth, unbalanced Toom-2x5+SRT-2048 the thirty-first, unbalanced Toom-2x7+Barrett-1024 the thirty-second, IEEE-754 FFT+Montgomery REDC the thirty-third, Solinas NTT+Granlund–Montgomery the thirty-fourth, Dekker double-double+Cook–Sieveking the thirty-fifth, IEEE-754 binary80+Karp–Markstein the thirty-sixth, unbalanced Toom-2x9+Svoboda–Tung the thirty-seventh, unbalanced Toom-2x11+Barrett-1280 the thirty-eighth, unbalanced Toom-2x13+Barrett-1536 the thirty-ninth; the opcode is not)"
  not_2="a deployed Uniswap v2/v3 pool"
  not_3="the full 2000-swap + 157-unfiltered campaign"
  not_4="that proving 512 closes the SafeMath-width u256 settler by itself — EXACT/OVERPAID, guards, and LCR2 steps remain mandatory and are sliced; LCR2-full proves the 512-bit settlement ABI separately"
  not_5="zk or computational soundness; receipts are tamper-evidence + re-execution"
}

.h{
  make="make u512-coprocessor-proof"
  harness="test/prove_u512_coprocessor_external.py"
  auditor_py="python3 examples/u512_coprocessor/verify_u512_receipt.py examples/u512_coprocessor/u512_coprocessor_evidence.json --self-test"
  auditor_js="node examples/u512_coprocessor/verify_u512_receipt.js examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_lip1_py="python3 examples/u512_coprocessor/verify_u512_inclusion.py examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_lip1_js="node examples/u512_coprocessor/verify_u512_inclusion.js examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_lip1_pl="perl examples/u512_coprocessor/verify_u512_inclusion.pl examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_bc="python3 examples/u512_coprocessor/verify_u512_bc_identity.py examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_rust="rustc --edition 2021 -O -o /tmp/verify_u512_rust64 examples/u512_coprocessor/verify_u512_rust64.rs && /tmp/verify_u512_rust64 examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_radix8="python3 examples/u512_coprocessor/verify_u512_radix8.py examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_knuth_d="python3 examples/u512_coprocessor/verify_u512_knuth_d.py examples/u512_coprocessor/u512_coprocessor_evidence.json"
  auditor_crt="python3 examples/u512_coprocessor/verify_u512_crt.py examples/u512_coprocessor/u512_coprocessor_evidence.json"
