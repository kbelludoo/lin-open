@RULEL:LIN_VALUE_PROOF:1.0.0
~R{.q=question .v=verdict .c=contest .w=wins .l=losses .u=unproven .r=run .p=policy}
# Protocolo de prova de valor — LIN vs linguagens consolidadas.
# Status epistemico (R5): experimental / piloto. Nao e linguagem generalista.
#
# Este arquivo trava a pergunta "o LIN tem valor?" a um concurso auditavel.
# Marketing, grants e PRs devem citar o gate, nao prosa livre.

.q{
  asked="LIN tem valor perante C/Rust/Python/Solidity? Vale continuar?"
  wrong_contest="substituir C, Rust, Python ou Solidity como lingua geral"
  right_contest="kernel numerico deterministico + recibo independente em algoritmos pinados"
}

.v{
  continue="SIM, como co-processador auditavel de kernels escalares — nao como lingua geral"
  stop_if="W1 ou W2 ou W3 falham, ou um claim de lingua-geral e vendido como prova"
  independent_review="AINDA ABERTO (nao automatizavel; GRANT_PROPOSAL M3)"
}

.c{
  established_oracles="gcc-C11 + CPython stdlib + Python int (uint256)"
  lin_engines="lin_c0 vm (i64) + lin_bc1_run u256_settlement_engine.linbc"
  independent_verifier="benchmarks/verify_receipt.py (hashlib, zero LIN compiler)"
  soundness="tamper-evidence + re-execucao / disputa otimista — NAO zk"
}

.w{
  W1="N-versao bit-exact: gcc-C11 == CPython == lin_c0 nos kernels pinados"
  W2="recibo Merkle recomputado por hashlib; output+1 rejeitado"
  W3="uint256 Uniswap getAmountOut: LinVM == Python bigint nos vetores dourados"
  W4="o proprio gate imprime o que NAO esta provado (NP/U*)"
}

.l{
  L1="divergencia vs oraculo C ou Python no dominio pinado"
  L2="verificador aceita recibo adulterado"
  L3="claim exige confiar no compilador LIN sem oraculo independente"
  L4="overclaim: mais rapido que LLVM, substitui Uniswap, Merkle e zk, economia $1.8T"
}

.u{
  U1="revisao humana externa independente"
  U2="utilizador de producao terceiro (DAO, auditor, grant reviewer rodando o comando)"
  U3="LIN mais rapido que LLVM/C/Rust em geral — NOT PROVEN"
  U4="soundness computacional (SNARK/STARK) — NOT PROVEN; modelo e disputa otimista"
  U5="kernel u256 de settlement emitido de .lin puro na GPU — OpenCL u256 ainda e handwritten"
}

.r{
  command="make value-proof"
  standalone="python3 test/prove_value_vs_established.py"
  deps="cc + python3; make -C transpile/c all (sem Zig)"
  kernels="qoi_color_hash, tinyexpr_fac, get_amount_out i64 (TOY), settle_u256 golden"
  labels="i64 Uniswap = TOY_INT64; canonical mainnet math = u256_settlement_engine.lin"
}

.p{
  r5="LABEL_TOY_VS_EXPERIMENTAL_VS_REAL_WORLD_NO_OVERCLAIM"
  r4="ONE_DIGEST_ONE_MEANING_AND_RECOMPUTABLE"
  fail_closed="qualquer W1/W2/W3 FAIL => VALUE GATE FAIL"
  not_a_language_win="paridade com C/Python prova correcao do kernel, nao superioridade da lingua"
}
