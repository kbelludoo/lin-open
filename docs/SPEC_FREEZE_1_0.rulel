@RULEL:LIN_SPEC_FREEZE:1.0.0
~R{.s=subject .h=hashes .p=policy}
# Congelamento da especificação formal LIN (v1.0.0).
#
# O que "frozen" significa aqui (policy abaixo): as assinaturas de conteúdo
# abaixo identificam a versão 1.0 da especificação. Qualquer mudança de
# semântica nos artefatos pinados EXIGE um bump de versão + novo digest.
# Mudanças editoriais (typos, clarificações sem mudança de semântica) também
# invalidam o digest; o procedimento é re-emitir este manifesto junto do PR.
#
# Status candidato: preparado como parte do pacote de grants. A benção final
# (publicar como "frozen") é decisão do mantenedor — ver GRANT_PROPOSAL.md §7.
.s{
  spec_id="LIN-FORMAL-SPEC-1.0"
  version="1.0.0"
  status="FROZEN"
  frozen_at="2026-09-08"
  reason="v1.0 formal freeze: core ISA, bytecode, verifiable receipt format, and host ABI frozen for grant submission"
}
.p{
  version_bump_required="semantic change"
  re_emit_required="any change (semantic or editorial)"
  change_log_required="yes"
}
.h{
