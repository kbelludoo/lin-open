// ==============================================================================
// examples/defi_settlement_proof/u512_uniswap_v2_core.lin
// Motor de Liquidação do Uniswap v2 com Numerador de 512 bits (Zero Overflow)
// Mantém entradas e saídas canônicas em uint256 (4 palavras de 64 bits).
// ==============================================================================
@LIN:L1c:0.2
@AMM_U512_SETTLEMENT_CORE{
  domain="defi:amm:settlement:u512"
  spec="uniswap_v2_exact_input_uint512_numerator"
  profile="LINVM-1"
  abi="u256_words_u512_intermediate"
}

// Executa o swap com acumulador intermediário de 512 bits:
// amount_w[0..3]: Palavras de 64 bits little-endian do amountIn (uint256)
// reserve_in_w[0..3]: Palavras de 64 bits do reserveIn (uint256)
// reserve_out_w[0..3]: Palavras de 64 bits do reserveOut (uint256)
// out_word_idx:
//   0..3: Retorna a palavra 64-bit solicitada do amountOut (uint256)
//   -1:   Retorna status (1 = Aprovado, -1 = Entrada Inválida, -2 = Overflow)
!settle_u512_swap(
  amount_w0: int, amount_w1: int, amount_w2: int, amount_w3: int,
  reserve_in_w0: int, reserve_in_w1: int, reserve_in_w2: int, reserve_in_w3: int,
  reserve_out_w0: int, reserve_out_w1: int, reserve_out_w2: int, reserve_out_w3: int,
  out_word_idx: int
) -> int {
  amount: [16]int;
  reserve_in: [16]int;
  reserve_out: [16]int;
  fee_amount: [16]int;
  denominator: [16]int;
  remainder: [16]int;
  quotient: [16]int;
  numerator: [32]int;

  // 1. Inicialização de buffers
  i = 0;
  while (i < 16) {
    amount[i] = 0;
    reserve_in[i] = 0;
    reserve_out[i] = 0;
    fee_amount[i] = 0;
    denominator[i] = 0;
    remainder[i] = 0;
    quotient[i] = 0;
    i = i + 1;
  };
  i = 0;
  while (i < 32) {
    numerator[i] = 0;
    i = i + 1;
  };

  // 2. Desempacotamento de 4 palavras de 64 bits em 16 limbs de 16 bits
  i = 0;
  while (i < 4) {
    amount[i] = _lia_ushr(amount_w0, 16 * i) & 65535;
    reserve_in[i] = _lia_ushr(reserve_in_w0, 16 * i) & 65535;
    reserve_out[i] = _lia_ushr(reserve_out_w0, 16 * i) & 65535;
    i = i + 1;
  };
  i = 0;
  while (i < 4) {
    amount[4 + i] = _lia_ushr(amount_w1, 16 * i) & 65535;
    reserve_in[4 + i] = _lia_ushr(reserve_in_w1, 16 * i) & 65535;
    reserve_out[4 + i] = _lia_ushr(reserve_out_w1, 16 * i) & 65535;
    i = i + 1;
  };
  i = 0;
  while (i < 4) {
    amount[8 + i] = _lia_ushr(amount_w2, 16 * i) & 65535;
    reserve_in[8 + i] = _lia_ushr(reserve_in_w2, 16 * i) & 65535;
    reserve_out[8 + i] = _lia_ushr(reserve_out_w2, 16 * i) & 65535;
    i = i + 1;
  };
  i = 0;
  while (i < 4) {
    amount[12 + i] = _lia_ushr(amount_w3, 16 * i) & 65535;
    reserve_in[12 + i] = _lia_ushr(reserve_in_w3, 16 * i) & 65535;
    reserve_out[12 + i] = _lia_ushr(reserve_out_w3, 16 * i) & 65535;
    i = i + 1;
  };

  // Guardas fail-closed de entradas nulas
  ?(amount_w0 == 0 && amount_w1 == 0 && amount_w2 == 0 && amount_w3 == 0) { ^0 - 1; };
  ?(reserve_in_w0 == 0 && reserve_in_w1 == 0 && reserve_in_w2 == 0 && reserve_in_w3 == 0) { ^0 - 1; };
  ?(reserve_out_w0 == 0 && reserve_out_w1 == 0 && reserve_out_w2 == 0 && reserve_out_w3 == 0) { ^0 - 1; };

  // 3. amount_in * 997 (taxa de 0.30% do Uniswap v2)
  carry = 0;
  i = 0;
  while (i < 16) {
    t = amount[i] * 997 + carry;
    fee_amount[i] = t & 65535;
    carry = _lia_ushr(t, 16);
    i = i + 1;
  };
  ?(carry != 0) { ^0 - 2; };

  // 4. denominator = reserve_in * 1000 + amount_in_with_fee
  carry = 0;
  i = 0;
  while (i < 16) {
    t = reserve_in[i] * 1000 + carry + fee_amount[i];
    denominator[i] = t & 65535;
    carry = _lia_ushr(t, 16);
    i = i + 1;
  };
  ?(carry != 0) { ^0 - 2; };

  // 5. Numerador de 512 bits: fee_amount (16 limbs) * reserve_out (16 limbs) -> 32 limbs (512 bits)
  i = 0;
  while (i < 16) {
    carry = 0;
    j = 0;
    while (j < 16) {
      k = i + j;
      t = numerator[k] + (fee_amount[i] * reserve_out[j]) + carry;
      numerator[k] = t & 65535;
      carry = _lia_ushr(t, 16);
      j = j + 1;
    };
    k = i + 16;
    while (k < 32 && carry != 0) {
      t = numerator[k] + carry;
      numerator[k] = t & 65535;
      carry = _lia_ushr(t, 16);
      k = k + 1;
    };
    i = i + 1;
  };

  // 6. Divisão restauradora de 512 bits por 256 bits: numerator (512b) / denominator (256b)
  bit = 511;
  while (bit >= 0) {
    limb = _lia_ushr(bit, 4);
    pos = bit & 15;
    in_bit = (_lia_ushr(numerator[limb], pos) & 1);

    // Desloca remainder à esquerda por 1 bit e insere in_bit
    carry = in_bit;
    j = 0;
    while (j < 16) {
      t = remainder[j] * 2 + carry;
      remainder[j] = t & 65535;
      carry = _lia_ushr(t, 16);
      j = j + 1;
    };

    // Compara remainder (16 limbs) com denominator (16 limbs)
    cmp = 0;
    j = 15;
    while (j >= 0) {
      ?(cmp == 0) {
        ?(remainder[j] > denominator[j]) { cmp = 1; }
        : (remainder[j] < denominator[j]) { cmp = 0 - 1; };
      };
      j = j - 1;
    };

    take = 0;
    ?((carry == 1) | (cmp >= 0)) { take = 1; };
    ?(take == 1) {
      // Se quotient exceder 256 bits (bit >= 256), ocorreu overflow
      ?(bit >= 256) {
        ^0 - 2;
      };

      quot_limb = _lia_ushr(bit, 4);
      quotient[quot_limb] = quotient[quot_limb] | _lia_shl(1, pos);

      borrow = 0;
      j = 0;
      while (j < 16) {
        t = remainder[j] - denominator[j] - borrow;
        ?(t < 0) {
          remainder[j] = t + 65536;
          borrow = 1;
        } : {
          remainder[j] = t;
          borrow = 0;
        };
        j = j + 1;
      };
    };
    bit = bit - 1;
  };

  // 7. Retorno do status de aprovação (-1)
  ?(out_word_idx < 0) {
    ^1;
  };

  // 8. Retorno da palavra 64-bit solicitada (0..3) agrupando 4 limbs de 16 bits
  base_limb = out_word_idx * 4;
  w = (quotient[base_limb] & 65535) |
      _lia_shl(quotient[base_limb + 1] & 65535, 16) |
      _lia_shl(quotient[base_limb + 2] & 65535, 32) |
      _lia_shl(quotient[base_limb + 3] & 65535, 48);

  ^w;
}

=ex{settle_u512_swap}
