@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!fact(n: int)->int { x = 1; #(i = 2; i <= n; i++){ x = x * i } ^x }
!sumto(n: int)->int { s = 0; #(i = 1; i <= n; i++){ s = s + i } ^s }
!test_fact(){ ?(fact(5) == 120){ ^1 } ^0 }
!test_sum(){ ?(sumto(10) == 55){ ^1 } ^0 }

=ex{fact,sumto,test_fact,test_sum}
