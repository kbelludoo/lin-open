@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!eval_h_truthy(val: int) -> int {
  ?(val != 0){
    ^val;
  };
  ^99;
}

!eval_h_canonical(val: int, is_null: int) -> int {
  ?(is_null != 0){
    ^99;
  };
  ^val;
}

!test_falsify_truthy(){
  // 0 is valid. H_truthy fails because it returns 99 instead of 0
  res = eval_h_truthy(0);
  ?(res == 99){
    // Successfully identified the bug in H_truthy
    ^1
  }
  ^0
}

!test_certify_canonical(){
  c1 = eval_h_canonical(42, 0);
  c2 = eval_h_canonical(0, 0);
  c3 = eval_h_canonical(0, 1);

  ?(c1 == 42 && c2 == 0 && c3 == 99){
    ^1
  }
  ^0
}

=ex{eval_h_truthy, eval_h_canonical, test_falsify_truthy, test_certify_canonical}
