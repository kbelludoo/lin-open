@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!mask32(x: int) -> int {
  ^x & 4294967295
}

!shr32(x: int, n: int) -> int {
  ^(_lia_shr(x & 4294967295, n))
}

!shl32(x: int, n: int) -> int {
  ^(_lia_shl(x & 4294967295, n)) & 4294967295
}

!rotl32(x: int, n: int) -> int {
  u = x & 4294967295;
  ^(_lia_shl(u, n) | _lia_shr(u, 32 - n)) & 4294967295
}

!rotr32(x: int, n: int) -> int {
  u = x & 4294967295;
  ^(_lia_shr(u, n) | _lia_shl(u, 32 - n)) & 4294967295
}

!ch32(x: int, y: int, z: int) -> int {
  ^((x & y) ^ ((~x) & z)) & 4294967295
}

!maj32(x: int, y: int, z: int) -> int {
  ^((x & y) ^ (x & z) ^ (y & z)) & 4294967295
}

!murmur3_32(key: string, seed: int) -> int {
  h1 = seed & 4294967295;
  c1 = 3432918353;
  c2 = 461845907;
  n = key.length;
  i = 0;
  while (i + 3 < n) {
    k1 = key.charCodeAt(i) | _lia_shl(key.charCodeAt(i + 1), 8) | _lia_shl(key.charCodeAt(i + 2), 16) | _lia_shl(key.charCodeAt(i + 3), 24);
    k1 = (k1 * c1) & 4294967295;
    k1 = rotl32(k1, 15);
    k1 = (k1 * c2) & 4294967295;

    h1 = (h1 ^ k1);
    h1 = rotl32(h1, 13);
    h1 = ((h1 * 5) + 3864292196) & 4294967295;
    i = i + 4;
  };

  rem = n - i;
  k2 = 0;
  ?(rem == 3){
    k2 = _lia_shl(key.charCodeAt(i + 2), 16) | _lia_shl(key.charCodeAt(i + 1), 8) | key.charCodeAt(i);
    k2 = (k2 * c1) & 4294967295;
    k2 = rotl32(k2, 15);
    k2 = (k2 * c2) & 4294967295;
    h1 = h1 ^ k2;
  }
  : (rem == 2){
    k2 = _lia_shl(key.charCodeAt(i + 1), 8) | key.charCodeAt(i);
    k2 = (k2 * c1) & 4294967295;
    k2 = rotl32(k2, 15);
    k2 = (k2 * c2) & 4294967295;
    h1 = h1 ^ k2;
  }
  : (rem == 1){
    k2 = key.charCodeAt(i);
    k2 = (k2 * c1) & 4294967295;
    k2 = rotl32(k2, 15);
    k2 = (k2 * c2) & 4294967295;
    h1 = h1 ^ k2;
  };

  h1 = (h1 ^ n) & 4294967295;
  h1 = (h1 ^ _lia_shr(h1, 16)) & 4294967295;
  h1 = (h1 * 2246822507) & 4294967295;
  h1 = (h1 ^ _lia_shr(h1, 13)) & 4294967295;
  h1 = (h1 * 3266489909) & 4294967295;
  h1 = (h1 ^ _lia_shr(h1, 16)) & 4294967295;

  ^h1;
}

!test_rotl(){
  ?(rotl32(1, 4) == 16){ ^1 }
  ^0
}

!test_rotr(){
  ?(rotr32(16, 4) == 1){ ^1 }
  ^0
}

!test_ch(){
  ?(ch32(15, 240, 3855) == 3840){ ^1 }
  ^0
}

!test_maj(){
  ?(maj32(1, 3, 7) == 3){ ^1 }
  ^0
}

!test_murmur_empty(){
  ?(murmur3_32("", 0) == 0){ ^1 }
  ^0
}

!test_murmur_non_empty(){
  h = murmur3_32("lin", 42);
  ?(h != 0){ ^1 }
  ^0
}

=ex{test_rotl, test_rotr, test_ch, test_maj, test_murmur_empty, test_murmur_non_empty}
