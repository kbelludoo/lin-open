@LIN:L1c:0.2

!len_s(s: string)->int { ^s.length }
!code_at(s: string, i: int)->int { ^s.charCodeAt(i) }
!cat2(x: string, y: string): string {
  out = "";
  out = out + x;
  out = out + y;
  ^out;
}
!test_len(){ ?(len_s("ab") == 2){ ^1 } ^0 }
!test_cat(){ ?(len_s(cat2("a", "bc")) == 3){ ^1 } ^0 }
!test_code(){ ?(code_at("A", 0) == 65){ ^1 } ^0 }

=ex{len_s,code_at,cat2,test_len,test_cat,test_code}
