@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!cmp(a: string, b: string)->int {
  n = a.length;
  ?(n != b.length){ ^0 };
  i = 0;
  d = 0;
  while (i < n) {
    d = d + (a.charCodeAt(i) - b.charCodeAt(i));
    i = i + 1;
  };
  ?(d == 0){ ^1 };
  ^0;
}
!test_same(){ ?(cmp("ab", "ab") == 1){ ^1 } ^0 }
!test_diff(){ ?(cmp("ab", "ac") == 0){ ^1 } ^0 }
!test_len(){ ?(cmp("a", "aa") == 0){ ^1 } ^0 }
!test_empty(){ ?(cmp("", "") == 1){ ^1 } ^0 }

=ex{cmp,test_same,test_diff,test_len,test_empty}
