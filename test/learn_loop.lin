@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!len_s(s: string) -> int {
  ^s.length
}

!code_at(s: string, i: int) -> int {
  ^s.charCodeAt(i)
}

!str_eq(a: string, b: string) -> bool {
  ?(a.length != b.length){ ^false };
  n = a.length;
  i = 0;
  while (i < n) {
    ?(a.charCodeAt(i) != b.charCodeAt(i)){ ^false };
    i = i + 1;
  };
  ^true;
}

!classify_idiom(src: string) -> string {
  n = src.length;
  i = 0;
  while (i + 1 < n) {
    ?(src.charCodeAt(i) == 61 && src.charCodeAt(i + 1) == 62){
      ^"arrow_fn";
    };
    i = i + 1;
  };
  i = 0;
  while (i + 1 < n) {
    ?(src.charCodeAt(i) == 45 && src.charCodeAt(i + 1) == 62){
      ^"typed_return";
    };
    i = i + 1;
  };
  ^"canonical_lin";
}

!synthesize_lin_rule(idiom: string) -> string {
  ?(str_eq(idiom, "arrow_fn")){
    ^"desugar_arrow_to_function";
  };
  ?(str_eq(idiom, "typed_return")){
    ^"preserve_typed_signature";
  };
  ^"pass_through";
}

!verify_provenance_gate(oracle_hash: int, lin_hash: int) -> int {
  ?(oracle_hash == lin_hash){
    ^1;
  };
  ^0;
}

!test_classify_arrow(){
  sample = "const add = (a, b) => a + b;";
  ?(str_eq(classify_idiom(sample), "arrow_fn") == true){ ^1 }
  ^0
}

!test_classify_typed(){
  sample = "!calc(x: int) -> int { ^x + 1 }";
  ?(str_eq(classify_idiom(sample), "typed_return") == true){ ^1 }
  ^0
}

!test_synthesize_rule(){
  ?(str_eq(synthesize_lin_rule("arrow_fn"), "desugar_arrow_to_function") == true){ ^1 }
  ^0
}

!test_provenance_gate(){
  ok = verify_provenance_gate(123456, 123456);
  fail = verify_provenance_gate(123456, 999999);
  ?(ok == 1 && fail == 0){ ^1 }
  ^0
}

=ex{len_s, code_at, str_eq, classify_idiom, synthesize_lin_rule, verify_provenance_gate, test_classify_arrow, test_classify_typed, test_synthesize_rule, test_provenance_gate}
