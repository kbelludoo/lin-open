@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!len_s(s: string) -> int {
  ^s.length
}

!code_at(s: string, i: int) -> int {
  ^s.charCodeAt(i)
}

!concat_str(a: string, b: string) -> string {
  out = "";
  out = out + a;
  out = out + b;
  ^out;
}

!double_int(x: int) -> int {
  ^x * 2
}

!check_flag(flag: bool) -> bool {
  ?(flag == true){ ^true }
  ^false
}

!test_concat(){
  ?(len_s(concat_str("hello ", "world")) == 11 && code_at(concat_str("hello ", "world"), 0) == 104){ ^1 }
  ^0
}

!test_double(){
  ?(double_int(21) == 42){ ^1 }
  ^0
}

!test_flag(){
  ?(check_flag(true) == true){ ^1 }
  ^0
}

=ex{len_s, code_at, concat_str, double_int, check_flag, test_concat, test_double, test_flag}
