@RULEL:ARTIFACT_JS_LEFTPAD_LIKE_JS:1.0.0
~LANG{source_ext="js"}
const pad = function pad(num, size) {
  var s = '000000000' + num;
  return s.substr(s.length - size);
};

function leftpad(str, len, ch) {
  str = String(str);
  if (!ch && ch !== 0) ch = ' ';
  ch = String(ch);
  var i = -1;
  var pl = len - str.length;
  if (pl < 1) return str;
  while (++i < pl) {
    str = ch + str;
  }
  return str;
}

function rjust(str, len, ch) {
  return leftpad(str, len, ch || ' ');
}
