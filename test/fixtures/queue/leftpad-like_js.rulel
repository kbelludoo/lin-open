@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="test/fixtures/queue/leftpad-like.js" ext=".js"}
.source{content="const pad = function pad(num, size) {\n  var s = '000000000' + num;\n  return s.substr(s.length - size);\n};\n\nfunction leftpad(str, len, ch) {\n  str = String(str);\n  if (!ch && ch !== 0) ch = ' ';\n  ch = String(ch);\n  var i = -1;\n  var pl = len - str.length;\n  if (pl < 1) return str;\n  while (++i < pl) {\n    str = ch + str;\n  }\n  return str;\n}\n\nfunction rjust(str, len, ch) {\n  return leftpad(str, len, ch || ' ');\n}\n"}
