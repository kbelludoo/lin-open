@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="test/fixtures/queue/ms-like.js" ext=".js"}
.source{content="function parse(ms) {\n  if (typeof ms === 'string') {\n    return split(ms);\n  } else if (typeof ms === 'number') {\n    return formatShort(ms);\n  }\n  throw new Error('invalid input');\n}\n\nfunction split(str) {\n  const m = str.match(/^-?(\\d+\\.?\\d*?)\\s*(ms|s|m|h|d|w|y)$/);\n  if (!m) return null;\n  const n = parseFloat(m[1]);\n  const unit = m[2];\n  if (unit === 'ms') return n;\n  if (unit === 's') return n * 1000;\n  if (unit === 'm') return n * 60000;\n  if (unit === 'h') return n * 3600000;\n  if (unit === 'd') return n * 86400000;\n  if (unit === 'w') return n * 604800000;\n  if (unit === 'y') return n * 31557600000;\n  return null;\n}\n\nfunction formatShort(ms) {\n  const abs = Math.abs(ms);\n  if (abs >= 31557600000) return Math.round(ms / 31557600000) + 'y';\n  if (abs >= 86400000) return Math.round(ms / 86400000) + 'd';\n  if (abs >= 3600000) return Math.round(ms / 3600000) + 'h';\n  if (abs >= 60000) return Math.round(ms / 60000) + 'm';\n  if (abs >= 1000) return Math.round(ms / 1000) + 's';\n  return ms + 'ms';\n}\n"}
