.gate{G_LLVM_IR_VALID="llc accepts emitted LLVM IR" G_LLVM_BEHAVIOR_EQ="native results equal LIN VM bit-exactly" G_LLVM_CODE_DIFF="normalized disassembly comparison recorded"}
