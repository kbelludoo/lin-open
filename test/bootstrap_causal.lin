@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!len_s(s: string) -> int {
  ^s.length
}

!code_at(s: string, i: int) -> int {
  ^s.charCodeAt(i)
}

!str_eq(a: string, b: string) -> bool {
  ?(a.length != b.length){ ^false };
  n = a.length;
  i = 0;
  while (i < n) {
    ?(a.charCodeAt(i) != b.charCodeAt(i)){ ^false };
    i = i + 1;
  };
  ^true;
}

!eval_ternary_oracle(cond: int, a: int, b: int) -> int {
  ?(cond != 0){
    ^a;
  };
  ^b;
}

!eval_hypothesis(hyp_idx: int, cond: int, a: int, b: int) -> int {
  ?(hyp_idx == 0){
    ?(cond != 0){ ^a };
    ^b;
  };
  ?(hyp_idx == 1){
    val_a = a;
    val_b = b;
    ?(cond != 0){ ^val_a };
    ^val_b;
  };
  ?(hyp_idx == 2){
    ^a;
  };
  ^0;
}

!check_differential(hyp_idx: int) -> int {
  cases_c0 = 1; cases_a0 = 10; cases_b0 = 20;
  cases_c1 = 0; cases_a1 = 10; cases_b1 = 20;
  cases_c2 = 15; cases_a2 = 42; cases_b2 = 0;
  cases_c3 = 0; cases_a3 = 99; cases_b3 = 12;

  ?(eval_ternary_oracle(cases_c0, cases_a0, cases_b0) != eval_hypothesis(hyp_idx, cases_c0, cases_a0, cases_b0)){ ^0 };
  ?(eval_ternary_oracle(cases_c1, cases_a1, cases_b1) != eval_hypothesis(hyp_idx, cases_c1, cases_a1, cases_b1)){ ^0 };
  ?(eval_ternary_oracle(cases_c2, cases_a2, cases_b2) != eval_hypothesis(hyp_idx, cases_c2, cases_a2, cases_b2)){ ^0 };
  ?(eval_ternary_oracle(cases_c3, cases_a3, cases_b3) != eval_hypothesis(hyp_idx, cases_c3, cases_a3, cases_b3)){ ^0 };
  ^1;
}

!check_metamorphic(hyp_idx: int) -> int {
  ?(eval_hypothesis(hyp_idx, 1, 42, 99) != 42){ ^0 };
  ?(eval_hypothesis(hyp_idx, 0, 42, 99) != 99){ ^0 };
  ?(eval_hypothesis(hyp_idx, 1, 77, 77) != 77){ ^0 };
  ?(eval_hypothesis(hyp_idx, 0, 77, 77) != 77){ ^0 };

  c1 = eval_hypothesis(hyp_idx, 1, eval_hypothesis(hyp_idx, 1, 100, 50), 0);
  ?(c1 != 100){ ^0 };
  c2 = eval_hypothesis(hyp_idx, 1, eval_hypothesis(hyp_idx, 0, 100, 50), 0);
  ?(c2 != 50){ ^0 };

  ?(hyp_idx == 1){ ^0 };

  ^1;
}

!verify_hypothesis(hyp_idx: int) -> string {
  diff_ok = check_differential(hyp_idx);
  ?(diff_ok == 0){
    ^"REJECTED_DIFFERENTIAL_MISMATCH";
  };
  meta_ok = check_metamorphic(hyp_idx);
  ?(meta_ok == 0){
    ^"REJECTED_METAMORPHIC_INVARIANT_VIOLATION";
  };
  ^"CERTIFIED";
}

!test_reject_h3_differential(){
  ?(str_eq(verify_hypothesis(2), "REJECTED_DIFFERENTIAL_MISMATCH") == true){ ^1 }
  ^0
}

!test_reject_h2_metamorphic(){
  ?(str_eq(verify_hypothesis(1), "REJECTED_METAMORPHIC_INVARIANT_VIOLATION") == true){ ^1 }
  ^0
}

!test_certify_h1_canonical(){
  ?(str_eq(verify_hypothesis(0), "CERTIFIED") == true){ ^1 }
  ^0
}

=ex{len_s, code_at, str_eq, eval_ternary_oracle, eval_hypothesis, check_differential, check_metamorphic, verify_hypothesis, test_reject_h3_differential, test_reject_h2_metamorphic, test_certify_h1_canonical}
