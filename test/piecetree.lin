@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!len_s(s: string) -> int {
  ^s.length
}

!code_at(s: string, i: int) -> int {
  ^s.charCodeAt(i)
}

!pt_count_lines(s: string) -> int {
  n = s.length;
  count = 1;
  i = 0;
  while (i < n) {
    ?(s.charCodeAt(i) == 10){ count = count + 1 };
    i = i + 1;
  };
  ^count;
}

!pt_piece_text(buf0: string, buf1: string, buf_id: int, start: int, len: int) -> string {
  ?(buf_id == 0){
    ^buf0.slice(start, start + len);
  };
  ^buf1.slice(start, start + len);
}

!pt_find_line(text: string, line_no: int) -> string {
  n = text.length;
  cur = 1;
  start = 0;
  i = 0;
  while (i < n) {
    ?(text.charCodeAt(i) == 10){
      ?(cur == line_no){
        ^text.slice(start, i);
      };
      cur = cur + 1;
      start = i + 1;
    };
    i = i + 1;
  };
  ?(cur == line_no){
    ^text.slice(start, n);
  };
  ^"";
}

!test_lines(){
  ?(pt_count_lines("line1\nline2\nline3") == 3){ ^1 }
  ^0
}

!test_piece(){
  b0 = "hello world";
  b1 = "foo bar";
  ?(len_s(pt_piece_text(b0, b1, 0, 0, 5)) == 5 && code_at(pt_piece_text(b0, b1, 0, 0, 5), 0) == 104 && len_s(pt_piece_text(b0, b1, 1, 4, 3)) == 3 && code_at(pt_piece_text(b0, b1, 1, 4, 3), 0) == 98){ ^1 }
  ^0
}

!test_find_line(){
  sample = "first\nsecond\nthird";
  ?(len_s(pt_find_line(sample, 2)) == 6 && code_at(pt_find_line(sample, 2), 0) == 115 && len_s(pt_find_line(sample, 3)) == 5 && code_at(pt_find_line(sample, 3), 0) == 116){ ^1 }
  ^0
}

=ex{len_s, code_at, pt_count_lines, pt_piece_text, pt_find_line, test_lines, test_piece, test_find_line}
