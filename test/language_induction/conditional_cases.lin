@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!len_s(s: string) -> int {
  ^s.length
}

!code_at(s: string, i: int) -> int {
  ^s.charCodeAt(i)
}

!str_eq(a: string, b: string) -> bool {
  ?(a.length != b.length){ ^false };
  n = a.length;
  i = 0;
  while (i < n) {
    ?(a.charCodeAt(i) != b.charCodeAt(i)){ ^false };
    i = i + 1;
  };
  ^true;
}

!test_semantic_invariants_true_branch(){
  // Condition = true (1)
  // Expected: result = 100, cond_count = 1, a_count = 1, b_count = 0
  cond_val = 1;
  cond_count = 1;
  a_count = 0;
  b_count = 0;
  result = 0;

  ?(cond_val != 0){
    a_count = a_count + 1;
    result = 100;
  } : {
    b_count = b_count + 1;
    result = 200;
  };

  ?(result == 100 && cond_count == 1 && a_count == 1 && b_count == 0){
    ^1;
  };
  ^0;
}

!test_semantic_invariants_false_branch(){
  // Condition = false (0)
  // Expected: result = 200, cond_count = 1, a_count = 0, b_count = 1
  cond_val = 0;
  cond_count = 1;
  a_count = 0;
  b_count = 0;
  result = 0;

  ?(cond_val != 0){
    a_count = a_count + 1;
    result = 100;
  } : {
    b_count = b_count + 1;
    result = 200;
  };

  ?(result == 200 && cond_count == 1 && a_count == 0 && b_count == 1){
    ^1;
  };
  ^0;
}

!test_cross_language_projection_equivalence(){
  // C: 1 ? 100 : 200 -> 100
  // JS: 1 ? 100 : 200 -> 100
  // Python: 100 if 1 else 200 -> 100
  // Rust: if true { 100 } else { 200 } -> 100
  // Canonical LIN: ?(1 != 0){ 100 } : { 200 } -> 100
  res_c = 100;
  res_js = 100;
  res_py = 100;
  res_rs = 100;
  res_lin = 100;

  ?(res_c == res_js && res_js == res_py && res_py == res_rs && res_rs == res_lin){
    ^1;
  };
  ^0;
}

=ex{len_s, code_at, str_eq, test_semantic_invariants_true_branch, test_semantic_invariants_false_branch, test_cross_language_projection_equivalence}
