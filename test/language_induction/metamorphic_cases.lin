@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!cond_eval(c: int, a: int, b: int) -> int {
  ?(c != 0){
    ^a;
  } : {
    ^b;
  };
}

!test_meta_identity(){
  // f(c, a, a) == a
  ?(cond_eval(1, 42, 42) == 42 && cond_eval(0, 42, 42) == 42 && cond_eval(99, 42, 42) == 42){
    ^1;
  };
  ^0;
}

!test_meta_negation_inversion(){
  // f(!c, a, b) == f(c, b, a)
  c1 = cond_eval(0, 10, 20); // 20
  c2 = cond_eval(1, 20, 10); // 20
  ?(c1 == c2){
    ^1;
  };
  ^0;
}

!test_meta_composition(){
  // f(c, f(d, a, b), e)
  res1 = cond_eval(1, cond_eval(1, 100, 50), 0); // 100
  res2 = cond_eval(1, cond_eval(0, 100, 50), 0); // 50
  res3 = cond_eval(0, cond_eval(1, 100, 50), 0); // 0
  ?(res1 == 100 && res2 == 50 && res3 == 0){
    ^1;
  };
  ^0;
}

=ex{cond_eval, test_meta_identity, test_meta_negation_inversion, test_meta_composition}
