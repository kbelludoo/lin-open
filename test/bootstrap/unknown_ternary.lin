@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!choose_num(flag: int, a: int, b: int) -> int {
  ^(flag ? a : b)
}

!max_val(x: int, y: int) -> int {
  ^((x > y) ? x : y)
}

!nested_ternary(x: int) -> int {
  ^((x > 10) ? 100 : ((x > 0) ? 50 : 0))
}

!test_choose(){
  ?(choose_num(1, 42, 99) == 42 && choose_num(0, 42, 99) == 99){ ^1 }
  ^0
}

!test_max(){
  ?(max_val(15, 8) == 15 && max_val(3, 20) == 20){ ^1 }
  ^0
}

!test_nested(){
  ?(nested_ternary(15) == 100 && nested_ternary(5) == 50 && nested_ternary(-2) == 0){ ^1 }
  ^0
}

=ex{choose_num, max_val, nested_ternary, test_choose, test_max, test_nested}
