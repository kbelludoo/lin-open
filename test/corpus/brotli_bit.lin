@LIN:L1c:0.2
@CORPUS{origin="google/brotli" algorithm="BrotliBitReader" scope="rfc7932_bit_reader_window"}

!brotli_mask_bits(val: int, n: int): int {
  mask = (_lia_shl(1, n) - 1) & 4294967295;
  ^(val & mask);
}

!brotli_fill_byte(val: int, new_byte: int, bits_in: int): int {
  b = new_byte & 255;
  shifted = _lia_shl(b, bits_in) & 4294967295;
  ^(val | shifted);
}

!brotli_drop_bits(val: int, n: int): int {
  ^(_lia_ushr(val, n));
}

!test_brotli_vector(): int {
  // Test filling byte 0xAB (171) at offset 0 -> 171
  // Fill byte 0xCD (205) at offset 8 -> 171 | (205 << 8) = 171 | 52480 = 52651 (0xCDAB)
  w = brotli_fill_byte(0, 171, 0);
  w = brotli_fill_byte(w, 205, 8);

  // Peek 4 bits -> 0xAB & 0xF = 11 (0xB)
  peek4 = brotli_mask_bits(w, 4);

  // Drop 4 bits -> 0xCDA = 3290
  w_dropped = brotli_drop_bits(w, 4);

  ?(w != 52651){ ^0 };
  ?(peek4 != 11){ ^0 };
  ?(w_dropped != 3290){ ^0 };
  ^1;
}

=ex{brotli_mask_bits, brotli_fill_byte, brotli_drop_bits, test_brotli_vector}
