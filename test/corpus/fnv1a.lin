@LIN:L1c:0.2
@CORPUS{origin="POSIX_DNS" algorithm="FNV-1a" scope="fnv1a_32_and_64"}

!fnv1a32_step(h_in: int, b: int): int {
  h = (h_in ^ (b & 255)) & 4294967295;
  ^(h * 16777619) & 4294967295;
}

!fnv1a64_step(h_in: int, b: int): int {
  h = h_in ^ (b & 255);
  ^(h * 1099511628211);
}

!test_fnv1a_vectors(): int {
  // Test "hello" in FNV-1a 32-bit: [104, 101, 108, 108, 111]
  // Expected = 0x4f9f2cab (1335831723)
  h32 = 2166136261;
  h32 = fnv1a32_step(h32, 104);
  h32 = fnv1a32_step(h32, 101);
  h32 = fnv1a32_step(h32, 108);
  h32 = fnv1a32_step(h32, 108);
  h32 = fnv1a32_step(h32, 111);

  // Test "hello" in FNV-1a 64-bit
  // Expected = 0xa430d84680aabd0b (-6615598642055627509)
  h64 = -3750763034362895579;
  h64 = fnv1a64_step(h64, 104);
  h64 = fnv1a64_step(h64, 101);
  h64 = fnv1a64_step(h64, 108);
  h64 = fnv1a64_step(h64, 108);
  h64 = fnv1a64_step(h64, 111);

  ?(h32 != 1335831723 || h64 != -6615550055289275125){ ^0 };
  ^1;
}

=ex{fnv1a32_step, fnv1a64_step, test_fnv1a_vectors}
