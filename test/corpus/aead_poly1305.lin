@LIN:L1c:0.2
@CORPUS{origin="libtomcrypt" algorithm="ChaCha20-Poly1305 AEAD (poly1305_block step)" scope="s_poly1305_block_mul_reduce_26bit_2limb"}

!poly1305_l2(r0: int, r1: int, r2: int, h0: int, h1: int, b0: int, b1: int, b2: int, b3: int, b4: int, b5: int, b6: int, b7: int): int {
  s1 = r1 * 5;
  s2 = r2 * 5;
  t0 = b0 + (_lia_shl(b1 ,  8)) + (_lia_shl(b2 ,  16)) + (_lia_shl(b3 ,  24));
  t1 = b4 + (_lia_shl(b5 ,  8)) + (_lia_shl(b6 ,  16)) + (_lia_shl(b7 ,  24));
  h0 = h0 + (t0 & 67108863);
  h1 = h1 + ((_lia_shr(t0 ,  2)) & 67108863);
  d0 = (h0 * r0) + (h1 * s2);
  d1 = (h0 * r1) + (h1 * r0);
  d2 = (h0 * r2) + (h1 * s1);
  c = _lia_shr(d0 ,  26);
  h0 = d0 & 67108863;
  d1 = d1 + c;
  c = _lia_shr(d1 ,  26);
  h1 = d1 & 67108863;
  d2 = d2 + c;
  c = _lia_shr(d2 ,  26);
  h0 = h0 + c * 5;
  c = _lia_shr(h0 ,  26);
  h0 = h0 & 67108863;
  h1 = h1 + c;
  ^h0 + (_lia_shl(h1 ,  26));
}

!test_aead_poly1305_vector(): int {
  // poly1305_l2(r0,r1,r2,h0,h1,b0..b7)->h0|(h1<<26), from gcc oracle:
