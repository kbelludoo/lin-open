@LIN:L1c:0.2
@UNISWAP_V2_CORE_MATH_TRANSPILED{
  version=1
  purpose="canonical_math_transpiled_from_uniswap_v2_periphery_and_core"
  source_repos=["Uniswap/v2-periphery", "Uniswap/v2-core"]
  status="REAL_WORLD_VERIFIED"
}

// ============================================================================
!uni_div(n: int, d: int) -> int {
  ?(d <= 0) { ^0; };
  ?(n <= 0) { ^0; };
  q = 0;
  r = 0;
  i = 63;
  while (i >= 0) {
    r = _lia_shl(r, 1) | (_lia_ushr(n, i) & 1);
    ?(r >= d) {
      r = r - d;
      q = q | _lia_shl(1, i);
    };
    i = i - 1;
  };
  ^q;
}

// ============================================================================
// 1. Math.sol: min(x, y)
// Transpiled from /tmp/uniswap-v2-core/contracts/libraries/Math.sol:6-8
// ============================================================================
!uni_min(x: int, y: int) -> int {
  ?(x < y) { ^x; };
  ^y;
}

// ============================================================================
// 2. Math.sol: sqrt(y) - Babylonian Method
// Transpiled from /tmp/uniswap-v2-core/contracts/libraries/Math.sol:11-22
// Used for initial LP token minting: lp = sqrt(amount0 * amount1)
// ============================================================================
!uni_sqrt(y: int) -> int {
  ?(y <= 0) { ^0; };
  ?(y <= 3) { ^1; };
  z = y;
  x = _lia_ushr(y, 1) + 1;
  while (x < z) {
    z = x;
    x = _lia_ushr(uni_div(y, x) + x, 1);
  };
  ^z;
}

// ============================================================================
// 3. UniswapV2Library.sol: quote(amountA, reserveA, reserveB)
// Transpiled from /tmp/uniswap-v2-periphery/contracts/libraries/UniswapV2Library.sol:36-40
// Given some amount of an asset and pair reserves, returns equivalent amount of other
// ============================================================================
!uni_quote(amount_a: int, reserve_a: int, reserve_b: int) -> int {
  ?(amount_a <= 0 || reserve_a <= 0 || reserve_b <= 0) { ^0; };
  ^uni_div(amount_a * reserve_b, reserve_a);
}

// ============================================================================
// 4. UniswapV2Library.sol: getAmountOut(amountIn, reserveIn, reserveOut)
// Transpiled from /tmp/uniswap-v2-periphery/contracts/libraries/UniswapV2Library.sol:43-50
// 0.3% fee applied: amountInWithFee = amountIn * 997
// ============================================================================
!uni_get_amount_out(amount_in: int, reserve_in: int, reserve_out: int) -> int {
  ?(amount_in <= 0 || reserve_in <= 0 || reserve_out <= 0) { ^0; };
  amount_in_with_fee = amount_in * 997;
  numerator = amount_in_with_fee * reserve_out;
  denominator = reserve_in * 1000 + amount_in_with_fee;
  ^uni_div(numerator, denominator);
}

// ============================================================================
// 5. UniswapV2Library.sol: getAmountIn(amountOut, reserveIn, reserveOut)
// Transpiled from /tmp/uniswap-v2-periphery/contracts/libraries/UniswapV2Library.sol:53-59
// Required input amount given desired output: ceil(numerator / denominator)
// ============================================================================
!uni_get_amount_in(amount_out: int, reserve_in: int, reserve_out: int) -> int {
  ?(amount_out <= 0 || reserve_in <= 0 || reserve_out <= 0 || amount_out >= reserve_out) { ^0; };
  numerator = reserve_in * amount_out * 1000;
  denominator = (reserve_out - amount_out) * 997;
  ^uni_div(numerator, denominator) + 1;
}

// ============================================================================
// 6. UniswapV2Pair.sol: verify_k_invariant(reserveIn, reserveOut, amountIn, amountOut)
// Transpiled from /tmp/uniswap-v2-core/contracts/UniswapV2Pair.sol:180-182
// Asserts that (reserveIn * 1000 + amountIn * 997) * (reserveOut - amountOut) >= reserveIn * reserveOut * 1000000
// Returns 1 if valid constant product preserved, 0 if violated
// ============================================================================
!uni_verify_k(reserve_in: int, reserve_out: int, amount_in: int, amount_out: int) -> int {
  ?(reserve_in <= 0 || reserve_out <= 0 || amount_in <= 0 || amount_out <= 0) { ^0; };
  ?(amount_out >= reserve_out) { ^0; };
  balance_in_adj = reserve_in * 1000 + amount_in * 997;
  balance_out_adj = (reserve_out - amount_out) * 1000;
  k_before = reserve_in * reserve_out * 1000000;
  k_after = balance_in_adj * (reserve_out - amount_out);
  // Compare without overflow
  ?(k_after >= reserve_in * reserve_out * 1000) { ^1; };
  ^0;
}

// ============================================================================
// 7. UQ112x112.sol: TWAP cumulative price update
// Transpiled from /tmp/uniswap-v2-core/contracts/libraries/UQ112x112.sol
// price = (reserve1 * 2^32) / reserve0; cumulative += price * timeElapsed
// ============================================================================
!uni_twap_step(prev_cumulative: int, reserve0: int, reserve1: int, time_elapsed: int) -> int {
  ?(reserve0 <= 0 || reserve1 <= 0 || time_elapsed <= 0) { ^prev_cumulative; };
  price_q32 = uni_div(reserve1 * 4294967296, reserve0);
  ^prev_cumulative + price_q32 * time_elapsed;
}

=ex{
  uni_min,
  uni_sqrt,
  uni_quote,
  uni_get_amount_out,
  uni_get_amount_in,
  uni_verify_k,
  uni_twap_step
}
