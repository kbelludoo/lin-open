@LIN:L1c:0.2
@CORPUS{origin="floodyberry/poly1305-donna" algorithm="Poly1305" scope="poly1305_key_clamp_and_donna_step"}

!poly1305_clamp_r0(r: int): int {
  ^(r & 268435455);
}

!poly1305_clamp_r1(r: int): int {
  ^(r & 268435452);
}

!poly1305_block_step(h0: int, h1: int, m0: int, m1: int, r0: int, r1: int, sel: int): int {
  nh0 = h0 + m0;
  nh1 = h1 + m1;

  d0 = (nh0 * r0) + (nh1 * (r1 * 5));
  d1 = (nh0 * r1) + (nh1 * r0);

  ?(sel == 0){ ^d0 };
  ^d1;
}

!test_poly1305_rfc_vector(): int {
  // Test clamping on RFC 8439 key sample
  // r0 = 0xffffffff (4294967295) -> clamped = 0x0fffffff (268435455)
  // r1 = 0xffffffff (4294967295) -> clamped = 0x0ffffffc (268435452)
  cr0 = poly1305_clamp_r0(4294967295);
  cr1 = poly1305_clamp_r1(4294967295);

  ?(cr0 != 268435455){ ^0 };
  ?(cr1 != 268435452){ ^0 };
  ^1;
}

=ex{poly1305_clamp_r0, poly1305_clamp_r1, poly1305_block_step, test_poly1305_rfc_vector}
