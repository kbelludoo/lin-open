@LIN:L1c:0.2
@CORPUS{origin="XKCP/XKCP" algorithm="Keccak-f1600" scope="keccak_theta_column_parity"}

!rotl64(x: int, s: int): int {
  w = x;
  r = s & 63;
  ^(_lia_shl(w, r)) | (_lia_ushr(w, 64 - r));
}

!keccak_theta_c(a0: int, a1: int, a2: int, a3: int, a4: int): int {
  c = a0 ^ a1 ^ a2 ^ a3 ^ a4;
  ^c;
}

!keccak_theta_d(c_prev: int, c_next: int): int {
  d = c_prev ^ rotl64(c_next, 1);
  ^d;
}

!test_keccak_vector(): int {
  c = keccak_theta_c(1, 2, 4, 8, 16);
  ?(c != 31){ ^0 };

  d = keccak_theta_d(31, 1);
  ?(d != 29){ ^0 };
  ^1;
}

=ex{rotl64, keccak_theta_c, keccak_theta_d, test_keccak_vector}
