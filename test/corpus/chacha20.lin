@LIN:L1c:0.2
@CORPUS{origin="RFC_8439" algorithm="ChaCha20" scope="quarter_round_and_block_state"}

!rotr32(x: int, n: int) -> int {
  w = x & 4294967295;
  ^((_lia_shr(w, n)) | (_lia_shl(w, 32 - n))) & 4294967295;
}

!rotl32(x: int, n: int) -> int {
  w = x & 4294967295;
  ^((_lia_shl(w, n)) | (_lia_shr(w, 32 - n))) & 4294967295;
}

!chacha_qr(a: int, b: int, c: int, d: int, sel: int) -> int {
  oa = (a + b) & 4294967295;
  od = rotl32(d ^ oa, 16);
  oc = (c + od) & 4294967295;
  ob = rotl32(b ^ oc, 12);
  oa = (oa + ob) & 4294967295;
  od = rotl32(od ^ oa, 8);
  oc = (oc + od) & 4294967295;
  ob = rotl32(ob ^ oc, 7);

  ?(sel == 0){ ^oa };
  ?(sel == 1){ ^ob };
  ?(sel == 2){ ^oc };
  ^od;
}

!test_chacha_rfc_vector(): int {
  // Test vector from RFC 8439 Section 2.1.1:
  // a = 0x11111111, b = 0x01020304, c = 0x9b8d6f43, d = 0x01234567
  // Expected after QR:
  // a = 0xea2a92f4, b = 0xcb1cf8ce, c = 0x4581472e, d = 0x5881c4bb
  a = chacha_qr(286331153, 16909060, 2609737539, 19088743, 0);
  b = chacha_qr(286331153, 16909060, 2609737539, 19088743, 1);
  c = chacha_qr(286331153, 16909060, 2609737539, 19088743, 2);
  d = chacha_qr(286331153, 16909060, 2609737539, 19088743, 3);

  ?(a != 3928658676 || b != 3407673550 || c != 1166100270 || d != 1484899515){ ^0 };
  ^1;
}

=ex{rotl32, rotr32, chacha_qr, test_chacha_rfc_vector}
