@LIN:L1c:0.2
@CORPUS{origin="webmproject/libvpx" algorithm="VP8 Short FDCT (RFC 6386 14.4.2)" scope="vp8_short_fdct4x4_row_col_8"}

!vp8_dct_row_out0(ip0: int, ip1: int, ip2: int, ip3: int): int {
  a1 = (ip0 + ip3) * 8;
  b1 = (ip1 + ip2) * 8;
  ^a1 + b1;
}

!vp8_dct_row_out1(ip0: int, ip1: int, ip2: int, ip3: int): int {
  a1 = (ip0 + ip3) * 8;
  c1 = (ip1 - ip2) * 8;
  d1 = (ip0 - ip3) * 8;
  ^_lia_shr((c1 * 2217 + d1 * 5352 + 14500) ,  12);
}

!vp8_dct_row_out2(ip0: int, ip1: int, ip2: int, ip3: int): int {
  a1 = (ip0 + ip3) * 8;
  b1 = (ip1 + ip2) * 8;
  ^a1 - b1;
}

!vp8_dct_row_out3(ip0: int, ip1: int, ip2: int, ip3: int): int {
  d1 = (ip0 - ip3) * 8;
  c1 = (ip1 - ip2) * 8;
  ^_lia_shr((d1 * 2217 - c1 * 5352 + 7500) ,  12);
}

!vp8_dct_col0(ip0: int, ip4: int, ip8: int, ip12: int): int {
  a1 = ip0 + ip12;
  b1 = ip4 + ip8;
  ^_lia_shr((a1 + b1 + 7) ,  4);
}

!vp8_dct_col1(ip0: int, ip4: int, ip8: int, ip12: int): int {
  a1 = ip0 + ip12;
  d1 = ip0 - ip12;
  c1 = ip4 - ip8;
  ^(_lia_shr((c1 * 2217 + d1 * 5352 + 12000) ,  16)) + (d1 != 0);
}

!vp8_dct_col2(ip0: int, ip4: int, ip8: int, ip12: int): int {
  a1 = ip0 + ip12;
  b1 = ip4 + ip8;
  ^_lia_shr((a1 - b1 + 7) ,  4);
}

!vp8_dct_col3(ip0: int, ip4: int, ip8: int, ip12: int): int {
  d1 = ip0 - ip12;
  c1 = ip4 - ip8;
  ^_lia_shr((d1 * 2217 - c1 * 5352 + 51000) ,  16);
}

!test_vp8_dct_vector(): int {
  // 5 cases, 8 outputs each, from gcc oracle on transpiled C:
  // {5,9,1,3}:   144 59 -16 -74  1 1 0 0
  // {0,0,0,0}:   0 3 0 1         0 0 0 0
  // {-1,-2,-3,-4}: -80 39 0 4    -1 1 0 0
  // {100,200,150,50}: 4000 742 -1600 -305  31 6 -13 -2
  // {-32768,32767,12345,-9876}: 19744 -150861 -702048 -312597  154 -1178 -5485 -2442
  ?(vp8_dct_row_out0(5, 9, 1, 3) != 144 || vp8_dct_row_out1(5, 9, 1, 3) != 59 || vp8_dct_row_out2(5, 9, 1, 3) != -16 || vp8_dct_row_out3(5, 9, 1, 3) != -74){ ^0 };
  ?(vp8_dct_col0(5, 9, 1, 3) != 1 || vp8_dct_col1(5, 9, 1, 3) != 1 || vp8_dct_col2(5, 9, 1, 3) != 0 || vp8_dct_col3(5, 9, 1, 3) != 0){ ^0 };
  ?(vp8_dct_row_out0(0, 0, 0, 0) != 0 || vp8_dct_row_out1(0, 0, 0, 0) != 3 || vp8_dct_row_out2(0, 0, 0, 0) != 0 || vp8_dct_row_out3(0, 0, 0, 0) != 1){ ^0 };
  ?(vp8_dct_col0(0, 0, 0, 0) != 0 || vp8_dct_col1(0, 0, 0, 0) != 0 || vp8_dct_col2(0, 0, 0, 0) != 0 || vp8_dct_col3(0, 0, 0, 0) != 0){ ^0 };
  ?(vp8_dct_row_out0(-1, -2, -3, -4) != -80 || vp8_dct_row_out1(-1, -2, -3, -4) != 39 || vp8_dct_row_out2(-1, -2, -3, -4) != 0 || vp8_dct_row_out3(-1, -2, -3, -4) != 4){ ^0 };
  ?(vp8_dct_col0(-1, -2, -3, -4) != -1 || vp8_dct_col1(-1, -2, -3, -4) != 1 || vp8_dct_col2(-1, -2, -3, -4) != 0 || vp8_dct_col3(-1, -2, -3, -4) != 0){ ^0 };
  ?(vp8_dct_row_out0(100, 200, 150, 50) != 4000 || vp8_dct_row_out1(100, 200, 150, 50) != 742 || vp8_dct_row_out2(100, 200, 150, 50) != -1600 || vp8_dct_row_out3(100, 200, 150, 50) != -305){ ^0 };
  ?(vp8_dct_col0(100, 200, 150, 50) != 31 || vp8_dct_col1(100, 200, 150, 50) != 6 || vp8_dct_col2(100, 200, 150, 50) != -13 || vp8_dct_col3(100, 200, 150, 50) != -2){ ^0 };
  ?(vp8_dct_row_out0(-32768, 32767, 12345, -9876) != 19744 || vp8_dct_row_out1(-32768, 32767, 12345, -9876) != -150861 || vp8_dct_row_out2(-32768, 32767, 12345, -9876) != -702048 || vp8_dct_row_out3(-32768, 32767, 12345, -9876) != -312597){ ^0 };
  ?(vp8_dct_col0(-32768, 32767, 12345, -9876) != 154 || vp8_dct_col1(-32768, 32767, 12345, -9876) != -1178 || vp8_dct_col2(-32768, 32767, 12345, -9876) != -5485 || vp8_dct_col3(-32768, 32767, 12345, -9876) != -2442){ ^0 };
  ^1;
}

=ex{vp8_dct_row_out0, vp8_dct_row_out1, vp8_dct_row_out2, vp8_dct_row_out3, vp8_dct_col0, vp8_dct_col1, vp8_dct_col2, vp8_dct_col3, test_vp8_dct_vector}