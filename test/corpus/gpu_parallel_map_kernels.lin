@LIN:L1c:0.2
@CORPUS{origin="lin-compiler" algorithm="GPU_parallel_map_kernels" scope="gpu_lowering_gate"}

// LIN-GPU-004: General MIR GPU Lowering
// Four structurally distinct parallel kernels, written in pure LIN source.
//
// Pipeline:
//   gpu_parallel_map_kernels.lin
//       │
//    vmBuild (LIN Frontend: Tokenizer + AST + TypeChecker + Bytecode Gen)
//       │
//    VmFn (Stack Bytecode)
//       │
//    compileVmFnToMir (Stack-to-SSA Compiler: lin_vm_to_mir.zig)
//       │
//    MirFunction (SSA MIR with semantic_hash)
//       │
//    MirToOpenCLLowerer (MIR-to-OpenCL Lowerer: lin_mir_gpu_lowerer.zig)
//       │
//    OpenCL C 2.0 (compiled for AMD gfx1030 / RX 6600)
//       │
//    Silicon Execution (1,066,601 elements across 7 matrix sizes)
//       │
//    Differential Oracle (BIT_EXACT vs LIN VM mathematical execution)

// K1 — Arithmetic: output = input * 3 + 7
!kernel_arithmetic(x: int): int {
  ^x * 3 + 7;
}

// K2 — Bitwise: output = (input & 0xFF) | (input << 8)
!kernel_bitwise(x: int): int {
  lo = x & 255;
  hi = _lia_shl(x, 8);
  ^lo | hi;
}

// K3 — Non-linear Multi-Op: output = (input * 5 - 13) ^ (input + 101)
!kernel_nonlinear(x: int): int {
  a = x * 5 - 13;
  b = x + 101;
  ^a ^ b;
}

// K4 — Xor + Shift + Sub: output = ((input ^ 0xDEAD) >>> 3) - 42
!kernel_xor_shift(x: int): int {
  xored = x ^ 57005;
  shifted = _lia_shr(xored, 3);
  ^shifted - 42;
}

!test_kernel_arithmetic_vector(): int {
  v0 = 2654435762;
  v1 = 1013904322;
  v2 = 3668340082;
  v3 = 2027808642;
  ?(kernel_arithmetic(v0) != v0 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v1) != v1 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v2) != v2 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v3) != v3 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(0)    != 7){   ^0 };
  ?(kernel_arithmetic(1)    != 10){  ^0 };
  ?(kernel_arithmetic(-1)   != 4){   ^0 };
  ?(kernel_arithmetic(100)  != 307){ ^0 };
  ^1;
}

!test_kernel_bitwise_vector(): int {
  ?(kernel_bitwise(0)     != 0){       ^0 };
  ?(kernel_bitwise(1)     != 257){     ^0 };
  ?(kernel_bitwise(255)   != 65535){   ^0 };
  ?(kernel_bitwise(256)   != 0 | _lia_shl(256, 8)){ ^0 };
  ^1;
}

!test_kernel_nonlinear_vector(): int {
  ?(kernel_nonlinear(0)   != (-13) ^ 101){ ^0 };
  ?(kernel_nonlinear(1)   != (-8) ^ 102){  ^0 };
  ?(kernel_nonlinear(10)  != 37 ^ 111){    ^0 };
  ?(kernel_nonlinear(-5)  != (-38) ^ 96){  ^0 };
  ^1;
}

!test_kernel_xor_shift_vector(): int {
  ?(kernel_xor_shift(0)     != 7083){ ^0 };
  ?(kernel_xor_shift(1)     != 7083){ ^0 };
  ?(kernel_xor_shift(57005) != -42){  ^0 };
  ^1;
}

=ex{kernel_arithmetic, kernel_bitwise, kernel_nonlinear, kernel_xor_shift,
    test_kernel_arithmetic_vector, test_kernel_bitwise_vector,
    test_kernel_nonlinear_vector, test_kernel_xor_shift_vector}
