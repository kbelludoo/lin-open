@LIN:L1c:0.2
@CORPUS{origin="lin-compiler" algorithm="GPU_parallel_map_kernels" scope="gpu_lowering_gate"}

// LIN-GPU-004: General MIR GPU Lowering
// Four structurally distinct kernels, written in LIN source.
// These functions compile through LIN frontend -> AST -> Semantic IR -> MIR.
// The MIR is then lowered to OpenCL C by MirToOpenCLLowerer and
// executed on the AMD RX 6600 (gfx1030), verified BIT_EXACT against
// the same LIN scalar execution used as mathematical oracle.

// K1 — Arithmetic: output = input * 3 + 7
!kernel_arithmetic(x: int): int {
  ^x * 3 + 7;
}

// K2 — Bitwise: output = (input & 0xFF) | (input << 8)
!kernel_bitwise(x: int): int {
  lo = x & 255;
  hi = _lia_shl(x, 8);
  ^lo | hi;
}

// K3 — Cmp + Select: output = abs(input)
!kernel_abs(x: int): int {
  neg = 0 - x;
  ?(x < 0){ ^neg };
  ^x;
}

// K4 — Xor + Shift + Sub: output = ((input ^ 0xDEAD) >>> 3) - 42
!kernel_xor_shift(x: int): int {
  xored = x ^ 57005;
  shifted = _lia_shr(xored, 3);
  ^shifted - 42;
}

// Verification vectors — identical PRNG: Fibonacci hashing (i+1)*0x9e3779b9
// Each function returns 1 if BIT_EXACT against mathematical oracle, 0 otherwise.

!test_kernel_arithmetic_vector(): int {
  // spot-check 8 representative inputs matching the PRNG sequence
  v0 = 2654435762;   // i=0: u32(1 * 0x9e3779b9) reinterp as i32
  v1 = 1013904322;   // i=1: u32(2 * 0x9e3779b9) trunc
  v2 = 3668340082;   // i=2
  v3 = 2027808642;   // i=3

  ?(kernel_arithmetic(v0) != v0 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v1) != v1 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v2) != v2 * 3 + 7){ ^0 };
  ?(kernel_arithmetic(v3) != v3 * 3 + 7){ ^0 };

  // fixed small inputs
  ?(kernel_arithmetic(0)    != 7){   ^0 };
  ?(kernel_arithmetic(1)    != 10){  ^0 };
  ?(kernel_arithmetic(-1)   != 4){   ^0 };
  ?(kernel_arithmetic(100)  != 307){ ^0 };
  ^1;
}

!test_kernel_bitwise_vector(): int {
  ?(kernel_bitwise(0)     != 0){       ^0 };
  ?(kernel_bitwise(1)     != 257){     ^0 };  // (1 & FF) | (1 << 8) = 1 | 256 = 257
  ?(kernel_bitwise(255)   != 65535){   ^0 };  // 255 | (255 << 8)
  ?(kernel_bitwise(256)   != 0 | _lia_shl(256, 8)){ ^0 };
  ^1;
}

!test_kernel_abs_vector(): int {
  ?(kernel_abs(0)    != 0){   ^0 };
  ?(kernel_abs(1)    != 1){   ^0 };
  ?(kernel_abs(-1)   != 1){   ^0 };
  ?(kernel_abs(-100) != 100){ ^0 };
  ?(kernel_abs(100)  != 100){ ^0 };
  ^1;
}

!test_kernel_xor_shift_vector(): int {
  // 0 ^ 57005 = 57005; 57005 >>> 3 = 7125; 7125 - 42 = 7083
  ?(kernel_xor_shift(0) != 7083){ ^0 };
  // 1 ^ 57005 = 57004; 57004 >>> 3 = 7125; 7125 - 42 = 7083
  ?(kernel_xor_shift(1) != 7083){ ^0 };
  // 57005 ^ 57005 = 0; 0 >>> 3 = 0; 0 - 42 = -42
  ?(kernel_xor_shift(57005) != -42){ ^0 };
  ^1;
}

=ex{kernel_arithmetic, kernel_bitwise, kernel_abs, kernel_xor_shift,
    test_kernel_arithmetic_vector, test_kernel_bitwise_vector,
    test_kernel_abs_vector, test_kernel_xor_shift_vector}
