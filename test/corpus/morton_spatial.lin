@LIN:L1c:0.2
@CORPUS{origin="uber/h3" algorithm="Morton2D" scope="morton2d_z_order_interleave"}

!morton_spread(v_in: int): int {
  w = v_in & 4294967295;
  w = (w | _lia_shl(w, 16)) & 281470681808895;
  w = (w | _lia_shl(w, 8))  & 71777214294589695;
  w = (w | _lia_shl(w, 4))  & 1085102592571150095;
  w = (w | _lia_shl(w, 2))  & 3689348814741910323;
  w = (w | _lia_shl(w, 1))  & 6148914691236517205;
  ^w;
}

!morton2d_encode(x: int, y: int): int {
  sx = morton_spread(x);
  sy = morton_spread(y);
  ^(sx | _lia_shl(sy, 1));
}

!test_morton_vector(): int {
  // Test coordinate x = 5 (0b101), y = 9 (0b1001)
  // Expected bit interleave:
  // x: _ 1 _ 0 _ 1
  // y: 1 _ 0 _ 0 _ 1
  // interleave = 0b10010011 = 147
  code = morton2d_encode(5, 9);
  ?(code != 147){ ^0 };
  ^1;
}

=ex{morton_spread, morton2d_encode, test_morton_vector}
