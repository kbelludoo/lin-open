@LIN:L1c:0.2
@CORPUS{origin="protobuf-c/protobuf-c" algorithm="Protobuf_Varint_ZigZag" scope="zigzag_and_varint_tag"}

!zigzag_encode32(n: int): int {
  ^(_lia_shl(n, 1) ^ _lia_shr(n, 31)) & 4294967295;
}

!zigzag_decode32(n: int): int {
  v = n & 4294967295;
  lsb = v & 1;
  mask = 0;
  ?(lsb == 1){ mask = 4294967295; };
  ^(_lia_ushr(v, 1) ^ mask) & 4294967295;
}

!zigzag_encode64(n: int): int {
  ^(_lia_shl(n, 1) ^ _lia_shr(n, 63));
}

!varint_tag7(v: int): int {
  ^(v & 127) | 128;
}

!test_protobuf_vectors(): int {
  // Test -1: zigzag_encode32(-1) = 1, zigzag_decode32(1) = 0xFFFFFFFF (4294967295)
  // Test 1: zigzag_encode32(1) = 2, zigzag_decode32(2) = 1
  z_neg1 = zigzag_encode32(-1);
  d_neg1 = zigzag_decode32(1);
  z_pos1 = zigzag_encode32(1);
  d_pos1 = zigzag_decode32(2);

  ?(z_neg1 != 1){ ^0 };
  ?(d_neg1 != 4294967295){ ^0 };
  ?(z_pos1 != 2){ ^0 };
  ?(d_pos1 != 1){ ^0 };

  // Test varint tag on 300 (0x12c): first byte = (300 & 127) | 128 = 44 | 128 = 172 (0xAC)
  tag = varint_tag7(300);
  ?(tag != 172){ ^0 };
  ^1;
}

=ex{zigzag_encode32, zigzag_decode32, zigzag_encode64, varint_tag7, test_protobuf_vectors}
