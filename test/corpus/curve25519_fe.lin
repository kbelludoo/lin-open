@LIN:L1c:0.2
@CORPUS{origin="floodyberry/ed25519-donna" algorithm="Curve25519_FE" scope="field_25519_limb_fold_19"}

!curve25519_mask51(x: int): int {
  // 51-bit mask: (1 << 51) - 1 = 2251799813685247
  ^(x & 2251799813685247);
}

!curve25519_carry_out51(x: int): int {
  ^(_lia_ushr(x, 51));
}

!curve25519_fold19(top_limb: int): int {
  c = _lia_ushr(top_limb, 51);
  ^(c * 19);
}

!test_curve25519_vector(): int {
  top = 4503599627370538;
  fold = curve25519_fold19(top);
  rem = curve25519_mask51(top);

  ?(fold != 38){ ^0 };
  ?(rem != 42){ ^0 };
  ^1;
}

=ex{curve25519_mask51, curve25519_carry_out51, curve25519_fold19, test_curve25519_vector}
