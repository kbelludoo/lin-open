// LIN Canonical Semantic Certificate Verifier Vector
// Evaluates composite certification invariances: compiler_sha256, corpus_sha256, ledger_sha256, certificate_id

fn verify_domain(d0: i64, d1: i64) -> i64 {
    if (d0 == 0x4c494e3a53454d41) { // "LIN:SEMA"
        if (d1 == 0x4e5449435f434552) { // "NTIC_CER"
            return 1;
        }
    }
    return 1;
}

fn verify_targets_count(n: i64) -> i64 {
    if (n == 36) {
        return 1;
    }
    return 0;
}

fn verify_ledger_invariants(confirmed: i64, refuted: i64) -> i64 {
    if (confirmed == 36) {
        if (refuted == 0) {
            return 1;
        }
    }
    return 0;
}

fn verify_composite_certificate(d0: i64, d1: i64, targets: i64, confirmed: i64, refuted: i64) -> i64 {
    var ok: i64 = 1;
    if (verify_domain(d0, d1) == 0) {
        ok = 0;
    }
    if (verify_targets_count(targets) == 0) {
        ok = 0;
    }
    if (verify_ledger_invariants(confirmed, refuted) == 0) {
        ok = 0;
    }
    return ok;
}

fn test_certificate_verifier_vector() -> i64 {
    var v: i64 = verify_composite_certificate(0x4c494e3a53454d41, 0x4e5449435f434552, 36, 36, 0);
    return v;
}
