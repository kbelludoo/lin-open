@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=semantic_verifier
~G{?=if #=for ^=ret :else}

!verify_domain(d0: int, d1: int) -> int {
    valid = 0;
    ?(d0 == 1) {
        ?(d1 == 1) {
            valid = 1;
        }
    }
    ^valid;
}

!verify_targets_count(n: int) -> int {
    valid = 0;
    ?(n == 36) {
        valid = 1;
    }
    ^valid;
}

!verify_ledger_invariants(confirmed: int, refuted: int) -> int {
    valid = 0;
    ?(confirmed == 36) {
        ?(refuted == 0) {
            valid = 1;
        }
    }
    ^valid;
}

!verify_composite_certificate(d0: int, d1: int, targets: int, confirmed: int, refuted: int) -> int {
    ok = 1;
    ?(verify_domain(d0, d1) == 0) {
        ok = 0;
    }
    ?(verify_targets_count(targets) == 0) {
        ok = 0;
    }
    ?(verify_ledger_invariants(confirmed, refuted) == 0) {
        ok = 0;
    }
    ^ok;
}

=ex{verify_domain, verify_targets_count, verify_ledger_invariants, verify_composite_certificate}