@LIN:L1c:0.2
@CORPUS{origin="imneme/pcg-c" algorithm="PCG32" scope="output_xsh_rr_and_lcg_step"}

!pcg_rotr_32(value: int, rot: int): int {
  v = value & 4294967295;
  r = rot & 31;
  ^((_lia_ushr(v, r)) | (_lia_shl(v, (32 - r) & 31))) & 4294967295;
}

!pcg_output_xsh_rr_64_32(state: int): int {
  s = state;
  v1 = _lia_ushr(s, 18);
  v2 = v1 ^ s;
  xorshifted = _lia_ushr(v2, 27) & 4294967295;
  rot = _lia_ushr(s, 59) & 31;
  ^pcg_rotr_32(xorshifted, rot);
}

!pcg_step_lcg_64(state: int, inc: int): int {
  ^(state * 6364136223846793005 + inc);
}

!test_pcg_vector(): int {
  // state = 0x853c49e6748fea9b (-8846114313915602277)
  // Expected = 355248013 (0x152ca78d)
  out1 = pcg_output_xsh_rr_64_32(-8846114313915602277);
  ?(out1 != 355248013){ ^0 };
  ^1;
}

=ex{pcg_rotr_32, pcg_output_xsh_rr_64_32, pcg_step_lcg_64, test_pcg_vector}
