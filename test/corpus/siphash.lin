@LIN:L1c:0.2
@CORPUS{origin="veorq/SipHash" algorithm="SipHash-2-4" scope="sipround_core"}

!rotl64(x: int, b: int): int {
  w = x;
  s = b & 63;
  ^(_lia_shl(w, s)) | (_lia_ushr(w, 64 - s));
}

!sipround(v0_in: int, v1_in: int, v2_in: int, v3_in: int, sel: int): int {
  v0 = v0_in + v1_in;
  v1 = rotl64(v1_in, 13) ^ v0;
  v0 = rotl64(v0, 32);

  v2 = v2_in + v3_in;
  v3 = rotl64(v3_in, 16) ^ v2;

  v0 = v0 + v3;
  v3 = rotl64(v3, 21) ^ v0;

  v2 = v2 + v1;
  v1 = rotl64(v1, 17) ^ v2;
  v2 = rotl64(v2, 32);

  ?(sel == 0){ ^v0 };
  ?(sel == 1){ ^v1 };
  ?(sel == 2){ ^v2 };
  ^v3;
}

!test_sipround_vectors(): int {
  // Initial SipHash-2-4 state with zero key
  // v0 = 0x736f6d6570736575ULL (8317987319222330741)
  // v1 = 0x646f72616e646f6dULL (7237222888777715565)
  // v2 = 0x6c7967656e657261ULL (7816434079848116833)
  // v3 = 0x7465646279746573ULL (8387220255154660723)
  r0 = sipround(8317987319222330741, 7237222888777715565, 7816434079848116833, 8387220255154660723, 0);
  r1 = sipround(8317987319222330741, 7237222888777715565, 7816434079848116833, 8387220255154660723, 1);
  r2 = sipround(8317987319222330741, 7237222888777715565, 7816434079848116833, 8387220255154660723, 2);
  r3 = sipround(8317987319222330741, 7237222888777715565, 7816434079848116833, 8387220255154660723, 3);

  ?(r0 != 7718041194505935093 || r1 != -6345287271303893494 || r2 != -4268866800948359747 || r3 != 9015346770765090660){ ^0 };
  ^1;
}

=ex{rotl64, sipround, test_sipround_vectors}
