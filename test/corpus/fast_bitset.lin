@LIN:L1c:0.2
@CORPUS{origin="lemire/FastBitset" algorithm="Popcount64" scope="parallel_hamming_weight"}

!popcount64(x_in: int): int {
  x = x_in;
  s1 = _lia_ushr(x, 1) & 6148914691236517205;
  x = x - s1;
  s2 = _lia_ushr(x, 2) & 3689348814741910323;
  x = (x & 3689348814741910323) + s2;
  s4 = _lia_ushr(x, 4);
  x = (x + s4) & 1085102592571150095;
  prod = x * 72340172838076673;
  ^(_lia_ushr(prod, 56));
}

!bitset_intersect_count(a: int, b: int): int {
  ^(popcount64(a & b));
}

!test_bitset_vector(): int {
  // Test popcount(0) = 0
  // Test popcount(0xFFFFFFFFFFFFFFFF) = 64
  // Test popcount(0x123456789ABCDEF0) = 32
  p0 = popcount64(0);
  p_all = popcount64(-1);
  p_mix = popcount64(1311768467463790320);

  ?(p0 != 0){ ^0 };
  ?(p_all != 64){ ^0 };
  ?(p_mix != 32){ ^0 };
  ^1;
}

=ex{popcount64, bitset_intersect_count, test_bitset_vector}
