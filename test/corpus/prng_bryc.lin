@LIN:L1c:0.2
@CORPUS{origin="bryc/code" language="JS" scope="pure_scalar"}

!xorshift32(x: int): int {
  a = x & 4294967295;
  a = a ^ ((_lia_shl(a, 13)) & 4294967295);
  a = a ^ _lia_shr(a, 17);
  a = a ^ ((_lia_shl(a, 5)) & 4294967295);
  ^a;
}

!splitmix32(seed: int): int {
  a = (seed + 2654435769) & 4294967295;
  t = a ^ _lia_shr(a, 16);
  t = (t * 569420461) & 4294967295;
  t = t ^ _lia_shr(t, 15);
  t = (t * 1935289751) & 4294967295;
  ^t ^ _lia_shr(t, 15);
}

!test_prng_vectors(): int {
  ?(xorshift32(1) != 270369){ ^0 };
  ?(splitmix32(1) != 1580013426){ ^0 };
  ^1;
}

=ex{xorshift32, splitmix32, test_prng_vectors}
