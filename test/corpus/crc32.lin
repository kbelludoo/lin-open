@LIN:L1c:0.2
@CORPUS{origin="IEEE_802_3" algorithm="CRC-32" scope="bitwise_crc32_step"}

!crc32_byte(crc_in: int, byte_in: int): int {
  c = (crc_in ^ (byte_in & 255)) & 4294967295;
  i = 0;
  while (i < 8) {
    b = c & 1;
    c = _lia_ushr(c, 1);
    ?(b == 1){
      c = (c ^ 3988292384) & 4294967295;
    };
    i = i + 1;
  };
  ^c;
}

!test_crc32_vector(): int {
  // Test "123456789" ASCII: [49, 50, 51, 52, 53, 54, 55, 56, 57]
  // Standard IEEE 802.3 CRC-32 for "123456789" is 0xCBF43926 (3421788454)
  crc = 4294967295;
  crc = crc32_byte(crc, 49);
  crc = crc32_byte(crc, 50);
  crc = crc32_byte(crc, 51);
  crc = crc32_byte(crc, 52);
  crc = crc32_byte(crc, 53);
  crc = crc32_byte(crc, 54);
  crc = crc32_byte(crc, 55);
  crc = crc32_byte(crc, 56);
  crc = crc32_byte(crc, 57);
  final_crc = (crc ^ 4294967295) & 4294967295;

  ?(final_crc != 3421780262){ ^0 };
  ^1;
}

=ex{crc32_byte, test_crc32_vector}
