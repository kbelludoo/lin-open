@LIN:L1c:0.2
@CORPUS{origin="BartMassey/popcount" language="C" scope="scalar"}

!popcount_naive(n: int): int {
  c = 0;
  while (n != 0) {
    c = c + (n & 1);
    n = _lia_shr(n, 1);
  };
  ^c;
}

!popcount_sparse(n: int): int {
  count = 0;
  while (n != 0) {
    count = count + 1;
    n = n & (n - 1);
  };
  ^count;
}

!popcount_8un(n: int): int {
  m = 16843009;
  c = (n & m) + (_lia_shr(n, 1) & m) + (_lia_shr(n, 2) & m) +
      (_lia_shr(n, 3) & m) + (_lia_shr(n, 4) & m) + (_lia_shr(n, 5) & m) +
      (_lia_shr(n, 6) & m) + (_lia_shr(n, 7) & m);
  c = c + _lia_shr(c, 8);
  c = c + _lia_shr(c, 16);
  ^c & 63;
}

!test_massey_vector(): int {
  v = 3935318504;
  ?(popcount_naive(v) != 14){ ^0 };
  ?(popcount_sparse(v) != 14){ ^0 };
  ?(popcount_8un(v) != 14){ ^0 };
  ^1;
}

=ex{popcount_naive, popcount_sparse, popcount_8un, test_massey_vector}
