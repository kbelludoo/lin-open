@LIN:L1c:0.2
@CORPUS{origin="Cyan4973/xxHash" algorithm="XXH64" scope="xxh64_round_and_avalanche"}

!rotl64(x: int, s: int): int {
  w = x;
  r = s & 63;
  ^(_lia_shl(w, r)) | (_lia_ushr(w, 64 - r));
}

!xxh64_round(v: int, input: int): int {
  nv = v + (input * -4417276706812531889);
  nv = rotl64(nv, 31);
  ^(nv * -7046029288634856825);
}

!xxh64_avalanche(h_in: int): int {
  h = h_in ^ _lia_ushr(h_in, 33);
  h = h * -4417276706812531889;
  h = h ^ _lia_ushr(h, 29);
  h = h * 1609587929392839161;
  ^h ^ _lia_ushr(h, 32);
}

!test_xxh64_vector(): int {
  // Test xxh64_avalanche(1) = 2898755366276535251
  ava = xxh64_avalanche(1);
  ?(ava != 2898755366276535251){ ^0 };
  ^1;
}

=ex{rotl64, xxh64_round, xxh64_avalanche, test_xxh64_vector}
