@LIN:L1c:0.2
@CORPUS{origin="Cyan4973/xxHash" language="C" scope="pure_scalar_kernels"}

// Constants from xxhash.h
// XXH_PRIME32_1 = 0x9E3779B1 (2654435761)
// XXH_PRIME32_2 = 0x85EBCA77 (2246822519)
// XXH_PRIME32_3 = 0xC2B2AE3D (3266489917)
// XXH_PRIME32_4 = 0x27D4EB2F (668265263)
// XXH_PRIME32_5 = 0x165667B1 (374761393)

// XXH_PRIME64_1 = 0x9E3779B185EBCA87ULL (11400714785074694791)
// XXH_PRIME64_2 = 0xC2B2AE3D27D4EB4FULL (14029467366897019727)
// XXH_PRIME64_3 = 0x165667B19E3779F9ULL (1609587929392839161)
// XXH_PRIME64_4 = 0x85EBCA77C2B2AE63ULL (9650029242287828579)
// XXH_PRIME64_5 = 0x27D4EB2F165667C5ULL (2870177450012600261)

!xxh_rotl32(x: int, r: int): int {
  w = x & 4294967295;
  s = r & 31;
  ^((_lia_shl(w, s)) | (_lia_shr(w, (32 - s)))) & 4294967295;
}

!xxh_rotl64(x: int, r: int): int {
  w = x;
  s = r & 63;
  ^(_lia_shl(w, s)) | (_lia_shr(w, (64 - s)));
}

!xxh_swap32(x: int): int {
  w = x & 4294967295;
  ^((_lia_shl(w, 24)) & 4278190080) |
   ((_lia_shl(w, 8)) & 16711680) |
   ((_lia_shr(w, 8)) & 65280) |
   ((_lia_shr(w, 24)) & 255);
}

!xxh32_round(acc: int, input: int): int {
  a = (acc + ((input & 4294967295) * 2246822519)) & 4294967295;
  a = xxh_rotl32(a, 13);
  ^(a * 2654435761) & 4294967295;
}

!xxh32_avalanche(h: int): int {
  hash = h & 4294967295;
  hash = hash ^ _lia_shr(hash, 15);
  hash = (hash * 2246822519) & 4294967295;
  hash = hash ^ _lia_shr(hash, 13);
  hash = (hash * 3266489917) & 4294967295;
  hash = hash ^ _lia_shr(hash, 16);
  ^hash;
}

!xxh_xorshift64(v: int, shift: int): int {
  ^v ^ _lia_shr(v, shift);
}

!xxh3_avalanche(h: int): int {
  hash = h;
  hash = xxh_xorshift64(hash, 37);
  hash = hash * 1609587929392839161;
  hash = xxh_xorshift64(hash, 32);
  ^hash;
}

!xxh3_rrmxmx(h: int, len: int): int {
  hash = h;
  hash = hash ^ xxh_rotl64(hash, 49) ^ xxh_rotl64(hash, 24);
  hash = hash * 11400714785074694791;
  hash = hash ^ (_lia_shr(hash, 35) + len);
  hash = hash * 11400714785074694791;
  ^xxh_xorshift64(hash, 28);
}

!test_xxhash_vectors(): int {
  ?(xxh_swap32(305419896) != 2018915346){ ^0 };
  ?(xxh32_round(0, 1) != 2381891501){ ^0 };
  ?(xxh32_avalanche(1) != 1617762472){ ^0 };
  ^1;
}

=ex{xxh_rotl32, xxh_rotl64, xxh_swap32, xxh32_round, xxh32_avalanche, xxh_xorshift64, xxh3_avalanche, xxh3_rrmxmx, test_xxhash_vectors}
