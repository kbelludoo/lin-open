@LIN:L1c:0.2
~G{?=if #=for ^=ret :else}

!bucket(n:int)->int{?(n>=90){^1}:?(n>=80){^2}:{^0}}
!sign(n:int)->int{?(n>0){^1}:{^0}}
!loop(n:int)->int{i=0;while(i<n){i=i+1;}^i}
!test_b1(){?(bucket(95)==1){^1}^0}
!test_b2(){?(bucket(85)==2){^1}^0}
!test_b3(){?(bucket(10)==0){^1}^0}
!test_s1(){?(sign(5)==1){^1}^0}
!test_s0(){?(sign(0)==0){^1}^0}
!test_loop(){?(loop(7)==7){^1}^0}

=ex{bucket,sign,loop,test_b1,test_b2,test_b3,test_s1,test_s0,test_loop}
