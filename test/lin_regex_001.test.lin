@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=emit_from_js
~G{?=if #=for ^=ret :else}
!ok(name,cond,detail){require=createRequire('file:///lin-in-memory.js');tmp=fs.mkdtempSync(path.join(os.tmpdir(),'lin_regex_001_'));passed=0;failed=0;failures=[];LITERALS=[['\\d+','','^regex_find(s, r)',[['ab42cd','42'],['',null]]],['^[a-z]+$','i','^regex_test(s, r)',[['ABC',true],['aBc1',false]]],['a+','','^regex_find(s, r)',[['caaab','aaa'],['xyz',null]]],['[A-Za-z_][A-Za-z0-9_]*','','^regex_find(s, r)',[['  var_x9 =','var_x9']]],['\\s+','g','^regex_replace(s, r, "_")',[['a b\tc','a_b_c']]],['\\bcat\\b','','^regex_test(s, r)',[['black cat',true],['concatenate',false]]],['(ab)+','','^regex_find(s, r)',[['zababz','abab']]],['a|b|cd','','^regex_find(s, r)',[['zzcdq','cd']]],['colou?r','g','^(regex_replace(s, r, "X"))',[['color colour','X X']]],['^\\w+@\\w+\\.com$','i','^regex_test(s, r)',[['a@B.com',true],['a@b.com.br',false]]],];BASES=['\\d+','\\w+','\\s','[abc]','[^abc]','[a-z]+','[A-Z]{2,}','a+b?','ab*c','a.*?b','(ab)+','(?:xy)+','a|bb|ccc','^start','end$','\\ba\\b','a{2,3}','l{2}','\\.','x\\d\\d','[0-9]-[0-9]','foo|bar|baz','[aeiou]$','q[^u]','\\(paren\\)','A?B',];TEXTS=['','a','abc','123','a1b2c3','start middle end','aaa','aab aac','foo bar baz','xyxyxy','(paren)','ABBA','end','the end!','q-tip quill','l lll ll','A-B-3-4','MiXeD CaSe 99',];FLAGS=['','i'];cases=[];bi=0,ti=0,fi=0;seen=new Set();uniq=cases.filter((c)=>{const k=`${c.pat}|${c.flags}|${c.text}`;if(seen.has(k)) return false;seen.add(k);return true;});if(cond) {passed++;}:{failed++;failures.push(`${name}${detail ? ': ' + detail : ''}`)}}
!runLin(src){require=createRequire('file:///lin-in-memory.js');tmp=fs.mkdtempSync(path.join(os.tmpdir(),'lin_regex_001_'));passed=0;failed=0;failures=[];LITERALS=[['\\d+','','^regex_find(s, r)',[['ab42cd','42'],['',null]]],['^[a-z]+$','i','^regex_test(s, r)',[['ABC',true],['aBc1',false]]],['a+','','^regex_find(s, r)',[['caaab','aaa'],['xyz',null]]],['[A-Za-z_][A-Za-z0-9_]*','','^regex_find(s, r)',[['  var_x9 =','var_x9']]],['\\s+','g','^regex_replace(s, r, "_")',[['a b\tc','a_b_c']]],['\\bcat\\b','','^regex_test(s, r)',[['black cat',true],['concatenate',false]]],['(ab)+','','^regex_find(s, r)',[['zababz','abab']]],['a|b|cd','','^regex_find(s, r)',[['zzcdq','cd']]],['colou?r','g','^(regex_replace(s, r, "X"))',[['color colour','X X']]],['^\\w+@\\w+\\.com$','i','^regex_test(s, r)',[['a@B.com',true],['a@b.com.br',false]]],];BASES=['\\d+','\\w+','\\s','[abc]','[^abc]','[a-z]+','[A-Z]{2,}','a+b?','ab*c','a.*?b','(ab)+','(?:xy)+','a|bb|ccc','^start','end$','\\ba\\b','a{2,3}','l{2}','\\.','x\\d\\d','[0-9]-[0-9]','foo|bar|baz','[aeiou]$','q[^u]','\\(paren\\)','A?B',];TEXTS=['','a','abc','123','a1b2c3','start middle end','aaa','aab aac','foo bar baz','xyxyxy','(paren)','ABBA','end','the end!','q-tip quill','l lll ll','A-B-3-4','MiXeD CaSe 99',];FLAGS=['','i'];cases=[];bi=0,ti=0,fi=0;seen=new Set();uniq=cases.filter((c)=>{const k=`${c.pat}|${c.flags}|${c.text}`;if(seen.has(k)) return false;seen.add(k);return true;});const r=compile(src,{target:'js'});const f=path.join(tmp,`p${passed + failed}.cjs`);fs.writeFileSync(f,r.code);^require(f)}
