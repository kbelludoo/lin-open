@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="test/run_all.mjs" lang="mjs"}
.source{content="import assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { execFileSync } from 'node:child_process';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst root = path.resolve(__dirname, '..');\n// Portable corpus root (was hardcoded to a local absolute path).\nconst CORPUS = root;\nconst LEGACY_V1 = '_legacy_v1';\nconst TMP_PREFIX = path.join(os.tmpdir(), 'lintest-');\n\nlet passed = 0;\nlet failed = 0;\nconst failures = [];\n\nfunction test(name, fn) {\n  try {\n    fn();\n    passed++;\n    console.log(`  ok  ${name}`);\n  } catch (e) {\n    failed++;\n    failures.push([name, e.message]);\n    console.log(`FAIL  ${name}: ${e.message}`);\n  }\n}\n\nasync function testAsync(name, fn) {\n  try {\n    await fn();\n    passed++;\n    console.log(`  ok  ${name}`);\n  } catch (e) {\n    failed++;\n    failures.push([name, e.message]);\n    console.log(`FAIL  ${name}: ${e.message}`);\n  }\n}\n\nimport { ensureRuntime, runtimeUrl } from '../scripts/lin_runtime.mjs';\n\nawait ensureRuntime();\n\nconst { LIN_HEADER } = await import(runtimeUrl('parser.mjs'));\nvoid LIN_HEADER;\nconst { parseProgram } = await import(runtimeUrl('parser.mjs'));\nconst { compile, REAL_TARGETS } = await import(runtimeUrl('compiler.mjs'));\nconst { runInMemory, assertJsSyntax } = await import(runtimeUrl('vm.mjs'));\nconst { semanticHash } = await import(runtimeUrl('semantic_hash.mjs'));\nconst { parseRulel, validateComms, parseBehaviorCasesRulel } = await import(runtimeUrl('rulel.mjs'));\nconst { verify } = await import(runtimeUrl('verifier.mjs'));\nconst { emitLinFromJs } = await import(runtimeUrl('emit_from_js.mjs'));\nconst { emitTs, emitPy, emitGo, emitRust, emitC, emitJava, emitZig } = await import(runtimeUrl('emitters.mjs'));\n\nfunction readCorpus(rel) {\n  return fs.readFileSync(path.join(CORPUS, rel), 'utf8');\n}\n\nconsole.log('T01 headers (LIN/LIA/AIL dual-read)');\ntest('header + structure', () => {\n  const src = readCorpus('examples/safe-compare.lin');\n  const prog = parseProgram(src);\n  assert.equal(prog.header, '@LIN:L1c:0.2');\n  assert.equal(prog.fns.length, 2);\n  assert.deepEqual(prog.exports, ['safeCompare', 'nativeTimingSafeEqual']);\n  for (const tag of ['@LIA:', '@AIL:']) {\n    const legacy = src.replace('@LIN:', tag);\n    const p2 = parseProgram(legacy);\n    const r2 = compile(legacy, { target: 'js' });\n    const mod2 = runInMemory(r2.code);\n    assert.ok(mod2.safeCompare('ab', 'ab') === true || typeof mod2.safeCompare === 'function');\n    assert.ok(p2.header.startsWith(tag));\n  }\n});\n\nconsole.log('T02 safe-compare behavior (in-memory)');\ntest('safeCompare truth table', () => {\n  const src = readCorpus('examples/safe-compare.lin');\n  const r = compile(src, { target: 'js', exportMode: 'single' });\n  const fn = runInMemory(r.code);\n  assert.equal(fn('ab', 'ab'), true);\n  assert.equal(fn('a', 'b'), false);\n  assert.equal(fn('prefix', 'pre'), false);\n  assert.equal(fn('', ''), true);\n  assert.equal(fn(String.fromCharCode(97, 0), String.fromCharCode(97, 1)), false);\n});\n\nconsole.log('T03 bytes format+parse exact');\ntest('bytes npm parity', () => {\n  const src = readCorpus('examples/bytes.lin');\n  const prelude = [\n    'var formatThousandsRegExp=/\\\\B(?=(\\\\d{3})+(?!\\\\d))/g;',\n    'var formatDecimalsRegExp=/(?:\\\\.0*|(\\\\.[^0]+))0+$/;',\n    'var parseRegExp=/^((-|\\\\+)?(\\\\d+(?:\\\\.\\\\d+)?) *(kb|mb|gb|tb|pb))$/i;',\n  ].join('');\n  const mod = runInMemory(compile(src, { target: 'js', prelude }).code);\n  assert.equal(mod.bytes(1024), '1KB');\n  assert.equal(mod.bytes(5 * 1024 * 1024), '5MB');\n  assert.equal(mod.bytes(0), '0B');\n  assert.equal(mod.bytes('1gb'), 1073741824);\n  assert.equal(mod.bytes('512mb'), 536870912);\n  assert.equal(mod.bytes(123), '123B');\n});\n\nconsole.log('T04 closures capture');\ntest('closure captures outer var', () => {\n  const closureLia = `@LIN:L1c:0.2\\n^lossy=true\\n~G{?=if #=for ^=ret :else}\\n!makeAdd(n){add=~(x){^n+x};^add}\\n=ex{makeAdd}`;\n  const add5 = runInMemory(compile(closureLia, { target: 'js', exportMode: 'single' }).code)(5);\n  assert.equal(add5(10), 15);\n  assert.equal(add5(3), 8);\n});\n\nconsole.log('T05 effects + sandbox');\ntest('effect inference and sandbox blocking', () => {\n  const effectLia = `@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!pureAdd(a,b){^a+b}\\n!nativeLen(s){^String(s).length}\\n!throwIfNeg(x){?(x<0){throw new Error('neg')};^x}\\n=ex{pureAdd,nativeLen,throwIfNeg}`;\n  const r = compile(effectLia, { target: 'js' });\n  const fx = Object.fromEntries(r.program.fns.map((f) => [f.name, f.effect]));\n  assert.equal(fx.pureAdd, 'Pure');\n  assert.equal(fx.nativeLen, 'Native');\n  assert.equal(fx.throwIfNeg, 'Throw');\n  const sandboxed = compile(effectLia, { target: 'js', sandbox: ['Pure'] });\n  const mod = runInMemory(sandboxed.code);\n  assert.equal(mod.pureAdd(2, 3), 5);\n  assert.throws(() => mod.nativeLen('x'), /LIN_SANDBOX.*Native/);\n});\n\nconsole.log('T06 semantic hash');\ntest('hash rename/format invariance + divergence', () => {\n  const h1 = semanticHash('a,b', 'a + b - 1');\n  const h2 = semanticHash('x,y', 'x+y-1');\n  const h3 = semanticHash('a,b', 'a - b + 1');\n  assert.equal(h1, h2);\n  assert.notEqual(h1, h3);\n  assert.match(h1, /^[0-9a-f]{16}$/);\n});\n\nconsole.log('T07 match arms');\ntest('literals, enum Option, wildcard, or-patterns, guards, tuples', () => {\n  const m2 = runInMemory(compile(readCorpus(`${LEGACY_V1}/tests/m003_rust_match.lin`), { target: 'js' }).code);\n  assert.deepEqual([m2(0), m2(1), m2(99)], [100, 200, 999]);\n\n  const omSrc = readCorpus(`${LEGACY_V1}/tests/option_match.lin`);\n  const om = runInMemory(compile(omSrc, { target: 'js', exportMode: 'multiple' }).code);\n  const some = { tag: 'Some', value: 42 };\n  assert.equal(om.unwrapOr(some, 0), 42);\n  assert.equal(om.unwrapOr(null, 7), 7);\n\n  const guardLia = `@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!cls(n){match(n){x if x>100=>{^1}x if x>10=>{^2}_=>{^3}}}\\n!tup(p){match(p){(a,b)=>{^a*10+b}}}\\n!orP(n){match(n){1|2=>{^9}_=>{^8}}}\\n=ex{cls,tup,orP}`;\n  const g = runInMemory(compile(guardLia, { target: 'js', exportMode: 'multiple' }).code);\n  assert.deepEqual([g.cls(500), g.cls(50), g.cls(5)], [1, 2, 3]);\n  assert.equal(g.tup([3, 4]), 34);\n  assert.deepEqual([g.orP(2), g.orP(5)], [9, 8]);\n});\n\nconsole.log('T08 structs/enums/mod/use');\ntest('module namespace + use symbols', () => {\n  const src = `@LIN:L1c:0.2\n~G{?=if #=for ^=ret :else}\nmod Math { !double(x){^x*2} !triple(x){^x*3} }\nuse Math::{double}\n!quad(x){^double(double(x))}\nstruct Point { x:int, y:int }\nenum Color { Red, Green, Blue }\n!origin(){p={x:0,y:0};^p.x+p.y}\n=ex{quad,origin,double}`;\n  const mod = runInMemory(compile(src, { target: 'js' }).code);\n  assert.equal(mod.quad(4), 16);\n  assert.equal(mod.origin(), 0);\n  const prog = parseProgram(src);\n  assert.equal(prog.structs[0].name, 'Point');\n  assert.equal(prog.structs[0].fields.length, 2);\n  assert.equal(prog.enums[0].variants.length, 3);\n  assert.equal(prog.modules[0].name, 'Math');\n});\n\nconsole.log('T09 chains and block ternaries');\ntest('elseif colon chains + ternary tails', () => {\n  const src = `@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!bucket(n){?(n>=90){^'A'}:(n>=80){^'B'}:{^'C'}}\\n!sign(n){?(n>0){^'pos'}:^'neg'}\\n!pick(f){?(f){^1}:{^0}}\\n=ex{bucket,sign,pick}`;\n  const mod = runInMemory(compile(src, { target: 'js', exportMode: 'multiple' }).code);\n  assert.deepEqual([mod.bucket(95), mod.bucket(85), mod.bucket(10)], ['A', 'B', 'C']);\n  assert.deepEqual([mod.sign(5), mod.sign(-5)], ['pos', 'neg']);\n  assert.deepEqual([mod.pick(true), mod.pick(false)], [1, 0]);\n});\n\nconsole.log('T10 loops');\ntest('while-form, empty bodies, break/continue', () => {\n  const src = `@LIN:L1c:0.2\\n~G{?=if #=for ^=ret :else}\\n!count(n){i=0;c=0;#(;i<n;){i=i+1;?(i%2==0){continue};c=c+1};^c}\\n!firstOdd(limit){#(i=1;i<limit;i++){?(i%2==1){^i}};^0}\\n!spin(n){i=0;#(;i<n;i=i+1){};^i}\\n=ex{count,firstOdd,spin}`;\n  const mod = runInMemory(compile(src, { target: 'js', exportMode: 'multiple' }).code);\n  assert.deepEqual([mod.count(10), mod.firstOdd(10), mod.spin(7)], [5, 1, 7]);\n});\n\nconsole.log('T11 multi-target native execution');\nconst arithSrc = fs.readFileSync(path.join(__dirname, 'fixtures', 'arith.lin'), 'utf8');\n\ntest('py: python3 runs emitted module', async () => {\n  const prog = parseProgram(arithSrc);\n  const py = emitPy(prog);\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'py-');\n  fs.writeFileSync(path.join(dir, 'arith_lin.py'), py);\n  const driver = [\n    'import sys; sys.path.insert(0, \".\")',\n    'import arith_lin',\n    'print(arith_lin.add(2,3)); print(arith_lin.mul(4,5)); print(arith_lin.fact(5)); print(1 if arith_lin.is_even(10) else 0); print(arith_lin.max3(3,9,4))',\n  ].join('\\n');\n  fs.writeFileSync(path.join(dir, 'driver.py'), driver);\n  const out = execFileSync('python3', ['driver.py'], { cwd: dir, encoding: 'utf8' });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\ntest('go: go run executes emitted package', () => {\n  const prog = parseProgram(arithSrc);\n  let goCode = emitGo(prog, { main: false });\n  goCode += `\nfunc main() {\n  fmt.Println(add(2, 3))\n  fmt.Println(mul(4, 5))\n  fmt.Println(fact(5))\n  if is_even(10) { fmt.Println(1) } else { fmt.Println(0) }\n  fmt.Println(max3(3, 9, 4))\n}\n`;\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'go-');\n  fs.writeFileSync(path.join(dir, 'main.go'), goCode);\n  fs.writeFileSync(path.join(dir, 'go.mod'), 'module lintest\\n\\ngo 1.21\\n');\n  const out = execFileSync('go', ['run', 'main.go'], { cwd: dir, encoding: 'utf8', timeout: 60000 });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\ntest('rust: rustc compiles + runs match fixture', () => {\n  const mnProg = parseProgram(fs.readFileSync(path.join(__dirname, 'fixtures', 'match_num.lin'), 'utf8'));\n  let rs = emitRust(mnProg);\n  rs += '\\nfn main() { println!(\"{}\", match_number(0)); println!(\"{}\", match_number(1)); println!(\"{}\", match_number(99)); }\\n';\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'rs-');\n  fs.writeFileSync(path.join(dir, 'match_num.rs'), rs);\n  execFileSync('rustc', ['-O', 'match_num.rs'], { cwd: dir, timeout: 90000 });\n  const out = execFileSync(path.join(dir, 'match_num'), { encoding: 'utf8' });\n  assert.equal(out.trim(), '100\\n200\\n999');\n});\n\ntest('rust: arith loop fact', () => {\n  const prog = parseProgram(arithSrc);\n  let rs = emitRust(prog);\n  rs += '\\nfn main() { println!(\"{}\", add(2,3)); println!(\"{}\", mul(4,5)); println!(\"{}\", fact(5)); println!(\"{}\", (is_even(10)==true) as i64); println!(\"{}\", max3(3,9,4)); }\\n';\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'rs2-');\n  fs.writeFileSync(path.join(dir, 'arith.rs'), rs);\n  execFileSync('rustc', ['-O', 'arith.rs'], { cwd: dir, timeout: 90000 });\n  const out = execFileSync(path.join(dir, 'arith'), { encoding: 'utf8' });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\ntest('c: gcc compiles + runs arith', () => {\n  const prog = parseProgram(arithSrc);\n  const cCode = emitC(prog) + `\\nint main(){ printf(\"%lld\\\\n\", add(2,3)); printf(\"%lld\\\\n\", mul(4,5)); printf(\"%lld\\\\n\", fact(5)); printf(\"%lld\\\\n\", is_even(10)?1:0); printf(\"%lld\\\\n\", max3(3,9,4)); return 0; }\\n`;\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'c-');\n  fs.writeFileSync(path.join(dir, 'arith.c'), cCode);\n  execFileSync('gcc', ['-O2', '-o', 'arith', 'arith.c', '-lm'], { cwd: dir, timeout: 60000 });\n  const out = execFileSync(path.join(dir, 'arith'), { encoding: 'utf8' });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\ntest('java: javac + java run arith', () => {\n  const prog = parseProgram(arithSrc);\n  let jCode = emitJava(prog);\n  jCode = jCode.replace('  public static void main(String[] args) {\\n  }', [\n    '  public static void main(String[] args) {',\n    '    System.out.println(add(2,3));',\n    '    System.out.println(mul(4,5));',\n    '    System.out.println(fact(5));',\n    '    System.out.println(is_even(10) ? 1 : 0);',\n    '    System.out.println(max3(3,9,4));',\n    '  }',\n  ].join('\\n'));\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'java-');\n  fs.writeFileSync(path.join(dir, 'LinProgram.java'), jCode);\n  execFileSync('javac', ['LinProgram.java'], { cwd: dir, timeout: 90000 });\n  const out = execFileSync('java', ['-cp', dir, 'LinProgram'], { encoding: 'utf8', timeout: 30000 });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\ntest('zig: zig build-exe compiles + runs arith natively (no Node at execution)', () => {\n  const prog = parseProgram(arithSrc);\n  let zig = emitZig(prog, {});\n  zig += `\npub fn main() !void {\n    const stdout = std.io.getStdOut().writer();\n    try stdout.print(\"{d}\\\\n\", .{add(2, 3)});\n    try stdout.print(\"{d}\\\\n\", .{mul(4, 5)});\n    try stdout.print(\"{d}\\\\n\", .{fact(5)});\n    try stdout.print(\"{d}\\\\n\", .{if (is_even(10)) @as(i64, 1) else @as(i64, 0)});\n    try stdout.print(\"{d}\\\\n\", .{max3(3, 9, 4)});\n}\n`;\n  const dir = fs.mkdtempSync(TMP_PREFIX + 'zig-');\n  fs.writeFileSync(path.join(dir, 'arith.zig'), zig);\n  execFileSync('zig', ['build-exe', 'arith.zig', '-O', 'ReleaseFast'], { cwd: dir, timeout: 60000 });\n  // The compile step above still runs Node (this test file); the produced\n  // binary below is a standalone native ELF that runs with zero JS/Node\n  // involvement — this is the Node-free *execution* path (see\n  // spec/LIN_CORE_ARCH.rulel R_BOOT: bootstrap/compile is JS today,\n  // execution of emitted native targets already is not).\n  const out = execFileSync(path.join(dir, 'arith'), { encoding: 'utf8' });\n  assert.equal(out.trim(), '5\\n20\\n120\\n1\\n9');\n});\n\nawait testAsync('empirical multi-backend bench: ranks native backends, none hardcoded (LIN_CORE_ARCH EMPIRICAL_BACKEND)', async () => {\n  const { bench } = await import(pathToFileURL(path.join(root, 'scripts', 'native_backend_bench.mjs')).href);\n  const result = await bench('test/fixtures/arith.lin', 'fact', [6]);\n  assert.equal(result.reference, 720);\n  const full = result.rows.filter((r) => r.ok);\n  assert.ok(full.length >= 1, `expected at least one FULL native backend, got: ${JSON.stringify(result.rows)}`);\n  for (const row of full) assert.equal(row.out, '720');\n  assert.ok(result.fastest, 'expected an empirically-ranked fastest backend');\n});\n\ntest('ts: emitted TypeScript parses under node type-strip', () => {\n  const prog = parseProgram(arithSrc);\n  const ts = emitTs(prog);\n  assert.ok(ts.includes('export function add(a: number, b: number): number'));\n  assert.ok(ts.includes('function fact(n: number): number'));\n  assertJsSyntax(ts.replace(/export /g, '').replace(/: Record<string, number>/g, '').replace(/: number/g, '').replace(/: boolean/g, '').replace(/: unknown/g, ''));\n});\n\nconsole.log('T12 JS→LIN emit roundtrip');\ntest('emit subset → recompiles → same behavior', () => {\n  const jsSource = [\n    'function add(a, b) { return a + b; }',\n    'function bucketScore(n) { if (n >= 90) { return 4; } else if (n >= 80) { return 3; } else { return 0; } }',\n    'function sumTo(n) { var s = 0; for (var i = 1; i <= n; i++) { s = s + i; } return s; }',\n    'module.exports = { add, bucketScore, sumTo };',\n  ].join('\\n');\n  const { lin } = emitLinFromJs(jsSource);\n  assert.ok(lin.startsWith('@LIN:'));\n  const back = runInMemory(compile(lin, { target: 'js' }).code);\n  assert.equal(back.add(2, 3), 5);\n  assert.deepEqual([back.bucketScore(95), back.bucketScore(85), back.bucketScore(50)], [4, 3, 0]);\n  assert.equal(back.sumTo(10), 55);\n});\n\nconsole.log('T13 verifier gates');\ntest('verify passes on good program with behavior fixtures', () => {\n  const src = fs.readFileSync(path.join(__dirname, 'fixtures', 'arith.lin'), 'utf8');\n  const report = verify(src, {\n    behavior: [\n      { fn: 'add', args: [2, 3], want: 5 },\n      { fn: 'fact', args: [5], want: 120 },\n      { fn: 'max3', args: [3, 9, 4], want: 9 },\n    ],\n  });\n  assert.equal(report.ok, true, JSON.stringify(report.gates));\n  for (const g of report.gates) assert.equal(g.pass, true, g.gate);\n});\n\nconsole.log('T14 in-memory purity (no disk writes)');\ntest('compile+run leaves the filesystem untouched', () => {\n  const snap = () => {\n    const out = new Map();\n    function walk(d) {\n      for (const e of fs.readdirSync(d, { withFileTypes: true })) {\n        if (e.name === 'node_modules' || e.name.startsWith('.')) continue;\n        const p = path.join(d, e.name);\n        if (e.isDirectory()) walk(p);\n        else {\n          const st = fs.statSync(p);\n          out.set(p, `${st.size}:${st.mtimeMs}`);\n        }\n      }\n    }\n    walk(root);\n    return out;\n  };\n  const before = snap();\n  for (const rel of ['examples/safe-compare.lin', 'examples/bytes.lin', `${LEGACY_V1}/tests/m003_rust_match.lin`]) {\n    const srcText = readCorpus(rel);\n    const code = compile(srcText, { target: 'js' }).code;\n    runInMemory(code);\n    parseProgram(srcText);\n  }\n  const after = snap();\n  assert.equal(before.size, after.size);\n  for (const [k, v] of before) assert.equal(after.get(k), v, `changed: ${k}`);\n});\n\nconsole.log('T14b repo purity (only .lin + .rulel committed; no .json)');\ntest('no .json files tracked in git', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.json'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter(Boolean) : [];\n  assert.deepEqual(files, [], `tracked .json: ${files.slice(0, 5).join(', ')}`);\n});\n\ntest('no .dicel files tracked in git (Phase 7: .rulel mirrors canonical)', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.dicel'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter(Boolean) : [];\n  assert.deepEqual(files, [], `tracked .dicel: ${files.slice(0, 8).join(', ')}`);\n});\n\ntest('src/ contains only .lin and .rulel', () => {\n  const srcDir = path.join(root, 'src');\n  const bad = [];\n  function walk(d) {\n    for (const e of fs.readdirSync(d, { withFileTypes: true })) {\n      const p = path.join(d, e.name);\n      if (e.isDirectory()) walk(p);\n      else if (!e.name.endsWith('.lin') && !e.name.endsWith('.rulel')) bad.push(path.relative(root, p));\n    }\n  }\n  walk(srcDir);\n  assert.deepEqual(bad, [], `foreign files in src/: ${bad.join(', ')}`);\n});\n\n/** Phase-4 host-glue scope: scripts/, bin/, test/, tests/, benchmarks/ — .mjs emitted at bootstrap, not tracked in git. */\nconst HOST_GLUE_DIRS = ['scripts', 'bin', 'test', 'tests', 'benchmarks'];\n/** Phase-5 legacy archive: TRANSPOSED_SOURCE .rulel mirrors only; originals not tracked or bootstrap-emitted. */\nconst LEGACY_EXCLUSION_DIRS = ['_legacy_v1'];\nconst LEGACY_FOREIGN_EXTS = ['.mjs', '.js', '.ts', '.cjs', '.lia'];\nconst HOST_GLUE_FIXTURE_EXCLUDE = /^test\\/fixtures\\//;\nconst ROOT_ALLOWED_MJS = [];\n\ntest('host glue dirs: no .mjs tracked in git', () => {\n  const tracked = [];\n  for (const dirName of HOST_GLUE_DIRS) {\n    const out = execFileSync('git', ['ls-files', `${dirName}/`], { cwd: root, encoding: 'utf8' }).trim();\n    if (!out) continue;\n    for (const rel of out.split('\\n').filter(Boolean)) {\n      if (rel.endsWith('.mjs') && !HOST_GLUE_FIXTURE_EXCLUDE.test(rel)) tracked.push(rel);\n    }\n  }\n  assert.deepEqual(tracked, [], `tracked .mjs in host glue dirs: ${tracked.join(', ')}`);\n});\n\ntest('host glue dirs: TRANSPOSED_SOURCE .rulel mirrors exist for bootstrap emit', () => {\n  const missing = [];\n  for (const dirName of HOST_GLUE_DIRS) {\n    const dir = path.join(root, dirName);\n    if (!fs.existsSync(dir)) continue;\n    function walk(d) {\n      for (const e of fs.readdirSync(d, { withFileTypes: true })) {\n        const p = path.join(d, e.name);\n        if (e.isDirectory()) walk(p);\n        else if (e.name.endsWith('.rulel')) {\n          const text = fs.readFileSync(p, 'utf8');\n          if (!text.includes('TRANSPOSED_SOURCE')) continue;\n          const m = text.match(/original=\"([^\"]+\\.mjs)\"/);\n          if (!m) continue;\n          const rel = m[1];\n          if (HOST_GLUE_FIXTURE_EXCLUDE.test(rel)) continue;\n          if (!text.includes('.source{content=')) missing.push(rel);\n        }\n      }\n    }\n    walk(dir);\n  }\n  assert.deepEqual(missing, [], `incomplete .rulel mirror for: ${missing.join(', ')}`);\n});\n\ntest('legacy exclusion zone: no host foreign sources tracked in _legacy_v1/', () => {\n  const tracked = [];\n  for (const dirName of LEGACY_EXCLUSION_DIRS) {\n    const out = execFileSync('git', ['ls-files', `${dirName}/`], { cwd: root, encoding: 'utf8' }).trim();\n    if (!out) continue;\n    for (const rel of out.split('\\n').filter(Boolean)) {\n      if (LEGACY_FOREIGN_EXTS.some((ext) => rel.endsWith(ext))) tracked.push(rel);\n    }\n  }\n  assert.deepEqual(tracked, [], `tracked legacy host sources: ${tracked.slice(0, 8).join(', ')}`);\n});\n\ntest('legacy exclusion zone: TRANSPOSED_SOURCE .rulel mirrors exist', () => {\n  const missing = [];\n  for (const dirName of LEGACY_EXCLUSION_DIRS) {\n    const dir = path.join(root, dirName);\n    if (!fs.existsSync(dir)) continue;\n    function walk(d) {\n      for (const e of fs.readdirSync(d, { withFileTypes: true })) {\n        const p = path.join(d, e.name);\n        if (e.isDirectory()) walk(p);\n        else if (e.name.endsWith('.rulel')) {\n          const text = fs.readFileSync(p, 'utf8');\n          if (!text.includes('TRANSPOSED_SOURCE')) continue;\n          const m = text.match(/original=\"([^\"]+)\"/);\n          if (!m) continue;\n          const rel = m[1];\n          if (!LEGACY_FOREIGN_EXTS.some((ext) => rel.endsWith(ext))) continue;\n          if (!text.includes('.source{content=')) missing.push(rel);\n        }\n      }\n    }\n    walk(dir);\n  }\n  assert.deepEqual(missing, [], `incomplete legacy .rulel mirror for: ${missing.join(', ')}`);\n});\n\ntest('no .py files tracked in git', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.py'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter(Boolean) : [];\n  assert.deepEqual(files, [], `tracked .py: ${files.slice(0, 5).join(', ')}`);\n});\n\n/** Phase-6 emit corpus dirs: artifacts/, examples/, lin_rust/ — host foreign sources untracked; .lin canonical for LIA corpus. */\nconst EMIT_CORPUS_DIRS = ['artifacts', 'examples', 'lin_rust'];\nconst EMIT_CORPUS_FOREIGN_EXTS = ['.js', '.cjs', '.ts', '.lia', '.rs', '.go', '.c', '.toml'];\n\nfunction extractRulelContent(rulelText) {\n  const marker = '.source{content=\"';\n  const start = rulelText.indexOf(marker);\n  if (start < 0) return null;\n  let i = start + marker.length;\n  let out = '';\n  while (i < rulelText.length) {\n    const ch = rulelText[i];\n    if (ch === '\\\\') {\n      const n = rulelText[i + 1];\n      const map = { n: '\\n', r: '\\r', t: '\\t', '\"': '\"', '\\\\': '\\\\' };\n      if (n in map) {\n        out += map[n];\n        i += 2;\n        continue;\n      }\n      out += n;\n      i += 2;\n      continue;\n    }\n    if (ch === '\"') break;\n    out += ch;\n    i += 1;\n  }\n  return out;\n}\n\nfunction readLangRulelEmbedded(rulelText) {\n  if (!rulelText.includes('~LANG{')) return null;\n  const lines = rulelText.split('\\n');\n  let start = 0;\n  for (let i = 0; i < lines.length; i++) {\n    if (lines[i].startsWith('~LANG{')) {\n      start = i + 1;\n      break;\n    }\n  }\n  return lines.slice(start).join('\\n');\n}\n\ntest('emit corpus dirs: no host foreign sources tracked in git', () => {\n  const tracked = [];\n  for (const dirName of EMIT_CORPUS_DIRS) {\n    const out = execFileSync('git', ['ls-files', `${dirName}/`], { cwd: root, encoding: 'utf8' }).trim();\n    if (!out) continue;\n    for (const rel of out.split('\\n').filter(Boolean)) {\n      if (EMIT_CORPUS_FOREIGN_EXTS.some((ext) => rel.endsWith(ext))) tracked.push(rel);\n    }\n  }\n  assert.deepEqual(tracked, [], `tracked emit corpus host sources: ${tracked.slice(0, 8).join(', ')}`);\n});\n\ntest('benchmarks: no .cjs/.ts/.js tracked in git', () => {\n  const tracked = [];\n  const out = execFileSync('git', ['ls-files', 'benchmarks/'], { cwd: root, encoding: 'utf8' }).trim();\n  if (out) {\n    for (const rel of out.split('\\n').filter(Boolean)) {\n      if (['.cjs', '.ts', '.js'].some((ext) => rel.endsWith(ext))) tracked.push(rel);\n    }\n  }\n  assert.deepEqual(tracked, [], `tracked benchmark host sources: ${tracked.slice(0, 8).join(', ')}`);\n});\n\ntest('test/fixtures: no .lia or queue .js tracked in git', () => {\n  const tracked = [];\n  const out = execFileSync('git', ['ls-files', 'test/fixtures/'], { cwd: root, encoding: 'utf8' }).trim();\n  if (out) {\n    for (const rel of out.split('\\n').filter(Boolean)) {\n      if (rel.endsWith('.lia') || /^test\\/fixtures\\/queue\\/.*\\.js$/.test(rel)) tracked.push(rel);\n    }\n  }\n  assert.deepEqual(tracked, [], `tracked fixture host sources: ${tracked.join(', ')}`);\n});\n\ntest('root: bootstrap_seed.rulel + bootstrap_cold_start.rulel canonical (no tracked .mjs)', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.mjs'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter((f) => !f.includes('/')) : [];\n  assert.deepEqual(files, [], `root tracked .mjs: ${files.join(', ')}`);\n  assert.ok(fs.existsSync(path.join(root, 'bootstrap_seed.rulel')), 'bootstrap_seed.rulel missing');\n  assert.ok(fs.existsSync(path.join(root, 'bootstrap_cold_start.rulel')), 'bootstrap_cold_start.rulel missing');\n  assert.ok(fs.existsSync(path.join(root, 'scripts/bootstrap_entry.lin')), 'scripts/bootstrap_entry.lin missing');\n});\n\n/**\n * Phase 10: repo-wide purity — ONLY .lin + .rulel tracked, zero exceptions.\n * Rationale for how the bootstrapping paradox is solved without any tracked\n * host file: something has to perform the very first TRANSPOSED_SOURCE\n * .rulel -> real-file extraction (materializing package.json and\n * bootstrap_cold_start.mjs), and it cannot itself be one of the files it\n * extracts. Earlier phases kept a single tracked host-exception file\n * (first bootstrap_prelude.mjs, then bootstrap.sh) to perform that first\n * extraction. Phase 10 removes that last exception: the cold-start seed's\n * content now lives ONLY as bootstrap_sh.rulel (a TRANSPOSED_SOURCE\n * mirror, itself pure .rulel), and a human/CI regenerates bootstrap.sh\n * locally (gitignored, never tracked) from it via a documented one-liner\n * (see spec/LIN_REPO_PURITY_COLD_START.rulel) before running it. This test\n * asserts zero tracked non-.lin/.rulel files, with NO exception set.\n */\ntest('Phase 10 repo purity: only .lin + .rulel tracked, zero exceptions', () => {\n  const tracked = execFileSync('git', ['ls-files'], { cwd: root, encoding: 'utf8' }).trim();\n  const foreign = tracked\n    ? tracked.split('\\n').filter((f) => !f.endsWith('.lin') && !f.endsWith('.rulel'))\n    : [];\n  assert.deepEqual(foreign, [], `non-lin/rulel tracked: ${foreign.slice(0, 12).join(', ')}`);\n});\n\ntest('cold-start seed: bootstrap_sh.rulel mirror exists and bootstrap.sh is not tracked', () => {\n  assert.ok(fs.existsSync(path.join(root, 'bootstrap_sh.rulel')), 'bootstrap_sh.rulel missing');\n  const mirrorText = fs.readFileSync(path.join(root, 'bootstrap_sh.rulel'), 'utf8');\n  assert.ok(mirrorText.includes('TRANSPOSED_SOURCE') && mirrorText.includes('original=\"bootstrap.sh\"'));\n  const extracted = extractRulelContent(mirrorText);\n  assert.ok(extracted && extracted.startsWith('#!/bin/sh'), 'bootstrap_sh.rulel payload malformed');\n  assert.ok(extracted.includes('exec node bootstrap_cold_start.mjs'), 'bootstrap_sh.rulel payload malformed');\n  const tracked = execFileSync('git', ['ls-files', 'bootstrap.sh'], { cwd: root, encoding: 'utf8' }).trim();\n  assert.equal(tracked, '', 'bootstrap.sh must not be tracked in git');\n});\n\ntest('Phase 8: no .md files tracked in git', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.md'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter(Boolean) : [];\n  assert.deepEqual(files, [], `tracked .md: ${files.slice(0, 8).join(', ')}`);\n});\n\ntest('Phase 8: no .rs files tracked in git', () => {\n  const tracked = execFileSync('git', ['ls-files', '*.rs'], { cwd: root, encoding: 'utf8' }).trim();\n  const files = tracked ? tracked.split('\\n').filter(Boolean) : [];\n  assert.deepEqual(files, [], `tracked .rs: ${files.slice(0, 8).join(', ')}`);\n});\n\ntest('Phase 8: no binaries tracked in git (elf/exe/pdb/rlib/dll)', () => {\n  const patterns = ['*.elf', '*.exe', '*.pdb', '*.rlib', '*.dll'];\n  const tracked = [];\n  for (const pat of patterns) {\n    const out = execFileSync('git', ['ls-files', pat], { cwd: root, encoding: 'utf8' }).trim();\n    if (out) tracked.push(...out.split('\\n').filter(Boolean));\n  }\n  assert.deepEqual(tracked, [], `tracked binaries: ${tracked.slice(0, 8).join(', ')}`);\n});\n\ntest('Phase 8: AGENTS_md.rulel mirror exists (AGENTS.md untracked)', () => {\n  assert.ok(fs.existsSync(path.join(root, 'AGENTS_md.rulel')), 'AGENTS_md.rulel missing');\n  const text = fs.readFileSync(path.join(root, 'AGENTS_md.rulel'), 'utf8');\n  assert.ok(text.includes('TRANSPOSED_SOURCE') && text.includes('original=\"AGENTS.md\"'));\n});\n\nconsole.log('T15 RULEL');\ntest('RULEL parse + COMMS validation', () => {\n  const rulelText = '@RULEL:COMMS_PROTOCOL:1.4.0\\n~R{.m=meta .r=rule}\\n.m{repo=x name=y}\\n.r{R20=comms-9router R1=a}\\n.f{no_evil}\\n.a{code=.lin}\\n.c{nucleus=v!h!g}\\n.s{state=ok}\\n.p{cli=bin/lin.mjs}\\n';\n  const parsed = parseRulel(rulelText);\n  assert.equal(parsed.header.id, 'COMMS_PROTOCOL');\n  assert.equal(parsed.header.semver, '1.4.0');\n  const v = validateComms(parsed);\n  assert.equal(v.ok, true);\n  assert.equal(v.rid, 'comms-9router');\n});\n\nconsole.log('T16 fail-closed');\ntest('missing export, bad target, js-runtime-only on native', () => {\n  assert.throws(() => compile('@LIN:L1c:0.2\\n!f(){^1}\\n=ex{ghost}'), /LIN_EXPORT_NO_FN/);\n  assert.throws(() => compile('@LIN:L1c:0.2\\n!f(){^1}', { target: 'cobol' }), /LIN_EMIT_TARGET/);\n  assert.throws(() => compile('@LIN:L1c:0.2\\n!f(){^Buffer.alloc(4)}', { target: 'py' }), /JS_RUNTIME_ONLY|js_runtime_only|LIN_EMIT_JS_RUNTIME_ONLY/i);\n  assert.throws(() => parseProgram('@LIN:L1c:0.2\\n!broken(a){?(a){^1}'), /LIN_PARSE/);\n});\n\nconsole.log('T17 corpus sweep (original repo L1c files)');\ntest('all valid @LIN programs from original corpus compile', () => {\n  const files = [];\n  function walk(d) {\n    if (!fs.existsSync(d)) return;\n    for (const e of fs.readdirSync(d, { withFileTypes: true })) {\n      if (e.name === 'node_modules' || e.name.startsWith('.')) continue;\n      const p = path.join(d, e.name);\n      if (e.isDirectory()) walk(p);\n      else if (/\\.(lin|lia)$/.test(e.name)) files.push(p);\n    }\n  }\n  for (const d of [`${LEGACY_V1}/src`, 'examples', `${LEGACY_V1}/tests`]) walk(path.join(CORPUS, d));\n  let ok = 0;\n  let skippedDocs = 0;\n  const errors = [];\n  for (const f of files) {\n    const srcText = fs.readFileSync(f, 'utf8');\n    if (!/^@(LIN|LIA|AIL):/m.test(srcText.split('\\n')[0] || '')) { continue; }\n    try {\n      parseProgram(srcText);\n      compile(srcText, { target: 'js' });\n      ok++;\n    } catch (e) {\n      if (/unterminated string/.test(e.message) && f.includes('spec')) { skippedDocs++; continue; }\n      if (/fail_closed/.test(f)) { ok++; continue; }\n      errors.push(`${path.relative(CORPUS, f)}: ${e.message}`);\n    }\n  }\n  assert.equal(errors.length, 0, errors.join(' | '));\n  assert.ok(ok >= 70, `expected ≥70 corpus files to pass, got ${ok}`);\n});\n\nconsole.log('T18 CLI end-to-end');\nawait testAsync('bin/lin.mjs version|check|compile|run|hash|effects|rulel-check|verify|emit', async () => {\n  const bin = path.join(root, 'bin', 'lin.mjs');\n  const tmp = fs.mkdtempSync(TMP_PREFIX + 'cli-');\n  const linFile = path.join(tmp, 'prog.lin');\n  fs.writeFileSync(linFile, arithSrc);\n\n  const ver = execFileSync(process.execPath, [bin, 'version'], { encoding: 'utf8' });\n  assert.match(ver.trim(), /^\\d+\\.\\d+\\.\\d+$/);\n\n  const check = JSON.parse(execFileSync(process.execPath, [bin, 'check', linFile], { encoding: 'utf8' }));\n  assert.deepEqual(check.fns, ['add', 'mul', 'fact', 'isEven', 'max3']);\n\n  const outJs = path.join(tmp, 'out.js');\n  execFileSync(process.execPath, [bin, 'compile', linFile, '--target', 'js', '-o', outJs]);\n  assert.ok(fs.readFileSync(outJs, 'utf8').includes('function add(a,b)'));\n\n  const hash = JSON.parse(execFileSync(process.execPath, [bin, 'hash', linFile], { encoding: 'utf8' }));\n  assert.match(hash.add, /^[0-9a-f]{16}$/);\n\n  const fx = JSON.parse(execFileSync(process.execPath, [bin, 'effects', linFile], { encoding: 'utf8' }));\n  assert.equal(fx.add, 'Pure');\n\n  const rulelFile = path.join(tmp, 'comms.rulel');\n  fs.writeFileSync(rulelFile, '@RULEL:T:1.0.0\\n.m{a=b}.r{R20=x}.f{}.a{}.c{}.s{}.p{}\\n');\n  const rl = JSON.parse(execFileSync(process.execPath, [bin, 'rulel-check', rulelFile], { encoding: 'utf8' }));\n  assert.equal(rl.validation.ok, true);\n\n  const report = JSON.parse(execFileSync(process.execPath, [bin, 'verify', linFile], { encoding: 'utf8' }));\n  assert.equal(report.ok, true);\n\n  const jsFixture = path.join(tmp, 'lib.js');\n  fs.writeFileSync(jsFixture, 'function inc(x){ return x+1; }\\nmodule.exports={inc};\\n');\n  const emitted = execFileSync(process.execPath, [bin, 'emit', jsFixture], { encoding: 'utf8' });\n  assert.ok(emitted.startsWith('@LIN:'));\n\n  const targets = REAL_TARGETS;\n  assert.equal(targets.length, 8);\n  assert.ok(targets.includes('zig'));\n});\n\nconsole.log('T19 self-host clone loop');\n\nfunction readQueueFixtureSource(queueDir, baseName) {\n  const jsPath = path.join(queueDir, `${baseName}.js`);\n  if (fs.existsSync(jsPath)) return fs.readFileSync(jsPath, 'utf8');\n  for (const suffix of [`${baseName}_js.rulel`, `${baseName}.rulel`]) {\n    const rulelPath = path.join(queueDir, suffix);\n    if (!fs.existsSync(rulelPath)) continue;\n    const text = fs.readFileSync(rulelPath, 'utf8');\n    const embedded = text.includes('.source{content=') ? extractRulelContent(text) : readLangRulelEmbedded(text);\n    if (embedded) return embedded;\n  }\n  throw new Error(`queue fixture source missing: ${baseName}`);\n}\n\nfunction listQueueFixtureNames(queueDir) {\n  const names = new Set();\n  for (const f of fs.readdirSync(queueDir)) {\n    if (f.endsWith('.js')) names.add(f.replace(/\\.js$/, ''));\n    else if (f.endsWith('_js.rulel')) names.add(f.replace(/_js\\.rulel$/, ''));\n    else if (f.endsWith('.rulel') && !f.endsWith('_js.rulel')) {\n      const base = f.replace(/\\.rulel$/, '');\n      if (fs.existsSync(path.join(queueDir, `${base}.js`)) || fs.existsSync(path.join(queueDir, `${base}_js.rulel`))) {\n        names.add(base);\n      }\n    }\n  }\n  return [...names].sort();\n}\n\ntest('loop reaches suiteRate 1.0 on fixture queue', async () => {\n  const { runCloneLoop } = await import(runtimeUrl('selfhost', 'loop.mjs'));\n  const queueDir = path.join(__dirname, 'fixtures', 'queue');\n  const queue = listQueueFixtureNames(queueDir).map((name) => ({\n    name,\n    source: readQueueFixtureSource(queueDir, name),\n  }));\n  const pubDir = fs.mkdtempSync(TMP_PREFIX + 'pub-');\n  const state = runCloneLoop({ queue, publishDir: pubDir });\n  assert.equal(state.suiteRate, 1, JSON.stringify(state.partial));\n  assert.equal(state.done.length, queue.length);\n  for (const r of state.repos) {\n    assert.equal(r.fail, 0, r.repo);\n    assert.ok(r.pass > 0);\n    assert.match(r.outputsHash, /^[0-9a-f]{64}$/);\n  }\n  const published = fs.readdirSync(path.join(pubDir, 'lin'));\n  assert.deepEqual(published.sort(), ['leftpad-like.lin', 'ms-like.lin']);\n  const linText = fs.readFileSync(path.join(pubDir, 'lin', 'ms-like.lin'), 'utf8');\n  assert.ok(linText.startsWith('@LIN:'));\n  const back = runInMemory(compile(linText, { target: 'js', exportMode: 'multiple' }).code);\n  assert.equal(back.split('3m'), 180000);\n  assert.equal(back.formatShort(60000), '1m');\n});\n\ntest('improve applies repairs and reports applied ids', async () => {\n  const { improveSource } = await import(runtimeUrl('selfhost', 'loop.mjs'));\n  const messy = [\n    \"import x from 'y';\",\n    'export function add(a, b) {',\n    '  return a + b;',\n    '}',\n  ].join('\\n');\n  const r = improveSource(messy);\n  assert.ok(r.applied.includes('R_strip_imports'), r.applied.join(','));\n  assert.ok(r.applied.includes('R_strip_export_keywords'));\n  assert.ok(!/^import/m.test(r.source));\n});\n\nconsole.log('T20 bootstrap hash gates');\nawait testAsync('hash gates: core seeds, semantic hash, nucleus lock, compiler idempotent, transpile hash', async () => {\n  const { runAllHashGates } = await import('../scripts/hash_gates.mjs');\n  const { RUNTIME } = await import('../scripts/lin_runtime.mjs');\n  const report = await runAllHashGates(RUNTIME);\n  assert.equal(report.ok, true, JSON.stringify(report.gates.filter((g) => !g.ok)));\n  for (const g of report.gates) {\n    assert.equal(g.ok, true, `${g.gate}: ${JSON.stringify(g)}`);\n  }\n  const coreGate = report.gates.find((g) => g.gate === 'G_CORE_CODE_HASH');\n  assert.ok(coreGate.cores.every((c) => c.ok), JSON.stringify(coreGate.cores.filter((c) => !c.ok)));\n  const transpilGate = report.gates.find((g) => g.gate === 'G_TRANSPIL_HASH');\n  assert.ok(transpilGate, 'G_TRANSPIL_HASH gate missing from bootstrap suite');\n  assert.equal(transpilGate.ok, true, JSON.stringify(transpilGate));\n});\n\nconsole.log('T21 transpile hash verification');\nawait testAsync('emit/transpile verify semantic + code hash', async () => {\n  const { verifyTranspileOutput, verifyTranspileOutputOrThrow } = await import(runtimeUrl('transpile_hash_verify.mjs'));\n  const { emitLinFromJs } = await import(runtimeUrl('emit_from_js.mjs'));\n  const { transpileToLin } = await import(runtimeUrl('transpiler_to_lin.mjs'));\n\n  const jsSource = [\n    'function add(a, b) { return a + b; }',\n    'function mul(a, b) { return a * b; }',\n    'module.exports = { add, mul };',\n  ].join('\\n');\n\n  const emitted = emitLinFromJs(jsSource);\n  assert.ok(emitted.hash?.ok, JSON.stringify(emitted.hash));\n  assert.ok(emitted.hash.semantic_hash_stable);\n  assert.ok(emitted.hash.code_hash_stable);\n  assert.match(emitted.hash.code_hash, /^[0-9a-f]{64}$/);\n  assert.match(emitted.hash.semantic_hash, /^[0-9a-f]{16}$/);\n\n  const report = verifyTranspileOutput(emitted.lin);\n  assert.equal(report.ok, true, JSON.stringify(report));\n  verifyTranspileOutputOrThrow(emitted.lin);\n\n  const pyLin = transpileToLin('def greet(name):\\n    return name\\n', { filename: 'g.py' });\n  assert.ok(pyLin.startsWith('@LIN:'));\n  const pyReport = verifyTranspileOutput(pyLin);\n  assert.equal(pyReport.ok, true, JSON.stringify(pyReport));\n\n  assert.throws(() => verifyTranspileOutputOrThrow('@LIN:L1c:0.2\\n!broken(){?(a){^1}\\n=ex{broken}'), /LIN_TRANSPIL_HASH/);\n});\n\nconsole.log('T22 cold-start bootstrap from rulel only');\nawait testAsync('cold start: bootstrap_emit.rulel emits and runs full bootstrap', async () => {\n  function extractRulel(rulelText) {\n    const marker = '.source{content=\"';\n    const start = rulelText.indexOf(marker);\n    if (start < 0) return null;\n    let i = start + marker.length;\n    let out = '';\n    while (i < rulelText.length) {\n      const ch = rulelText[i];\n      if (ch === '\\\\') {\n        const n = rulelText[i + 1];\n        const map = { n: '\\n', r: '\\r', t: '\\t', '\"': '\"', '\\\\': '\\\\' };\n        if (n in map) {\n          out += map[n];\n          i += 2;\n          continue;\n        }\n        out += n;\n        i += 2;\n        continue;\n      }\n      if (ch === '\"') break;\n      out += ch;\n      i += 1;\n    }\n    return out;\n  }\n\n  const coldMjs = path.join(root, 'bootstrap_cold_start.mjs');\n  const emitMjs = path.join(root, 'bootstrap_emit.mjs');\n  const preludeMjs = path.join(root, 'bootstrap_prelude.mjs');\n  const hadCold = fs.existsSync(coldMjs);\n  const hadEmit = fs.existsSync(emitMjs);\n  const hadPrelude = fs.existsSync(preludeMjs);\n  try {\n    for (const f of [coldMjs, emitMjs, preludeMjs]) {\n      if (fs.existsSync(f)) fs.unlinkSync(f);\n    }\n    const emitSrc = extractRulel(fs.readFileSync(path.join(root, 'bootstrap_emit.rulel'), 'utf8'));\n    fs.writeFileSync(emitMjs, emitSrc, 'utf8');\n    execFileSync('node', [emitMjs], { cwd: root, stdio: 'pipe' });\n    assert.ok(fs.existsSync(coldMjs), 'bootstrap_cold_start.mjs not emitted');\n    execFileSync('node', [coldMjs], { cwd: root, stdio: 'pipe' });\n    assert.ok(fs.existsSync(path.join(root, 'build/runtime/compiler.mjs')), 'compiler.mjs missing after cold bootstrap');\n    assert.ok(fs.existsSync(preludeMjs), 'bootstrap_prelude.mjs not emitted');\n  } finally {\n    if (!hadEmit && fs.existsSync(emitMjs)) fs.unlinkSync(emitMjs);\n    if (!hadCold && fs.existsSync(coldMjs)) fs.unlinkSync(coldMjs);\n    if (!hadPrelude && fs.existsSync(preludeMjs)) fs.unlinkSync(preludeMjs);\n  }\n});\n\ntest('compiler.lin integrates transpile feedback hooks', () => {\n  const text = fs.readFileSync(path.join(root, 'src/compiler.lin'), 'utf8');\n  assert.ok(text.includes('applyTranspileFeedbackToOpts'));\n  assert.ok(text.includes('recordTranspileHint'));\n});\n\ntest('compiler_transpile_feedback.lin exports learning hooks', () => {\n  const text = fs.readFileSync(path.join(root, 'src/compiler_transpile_feedback.lin'), 'utf8');\n  assert.ok(text.includes('recordTranspileManifest'));\n  assert.ok(text.includes('ingestTranspileVerifyReport'));\n});\n\ntest('bootstrap_entry.lin verifies transpile hash on bootstrap LIN sources', () => {\n  const text = fs.readFileSync(path.join(root, 'scripts/bootstrap_entry.lin'), 'utf8');\n  assert.ok(text.includes('verifyBootstrapTranspile'));\n  assert.ok(text.includes('G_BOOTSTRAP_TRANSPIL_HASH'));\n});\n\nconsole.log('T23 behavioral oracle (.rulel cases catch semantic-hash-invisible drift)');\ntest('.rulel behavior cases file parses into {fn,args,want,label} tuples', () => {\n  const text = fs.readFileSync(path.join(root, 'test/fixtures/token_guard.cases.rulel'), 'utf8');\n  const cases = parseBehaviorCasesRulel(text);\n  assert.equal(cases.length, 4);\n  assert.equal(cases[0].fn, 'matchesToken');\n  assert.deepEqual(cases[0].args, ['', '']);\n  assert.equal(cases[0].want, false);\n  assert.equal(cases[0].label, 'empty expected vs empty offered must never match');\n  assert.equal(cases[1].want, true);\n});\n\ntest('correct implementation passes plain verify AND verify --behavior', () => {\n  const src = fs.readFileSync(path.join(root, 'test/fixtures/token_guard.lin'), 'utf8');\n  const casesText = fs.readFileSync(path.join(root, 'test/fixtures/token_guard.cases.rulel'), 'utf8');\n  const cases = parseBehaviorCasesRulel(casesText);\n  const plain = verify(src);\n  assert.equal(plain.ok, true, JSON.stringify(plain.gates));\n  const behavioral = verify(src, { behavior: cases });\n  assert.equal(behavioral.ok, true, JSON.stringify(behavioral.gates));\n  const bg = behavioral.gates.find((g) => g.gate === 'G_BEHAVIOR');\n  assert.equal(bg.pass, true);\n  assert.match(bg.detail, /4 cases/);\n});\n\ntest('trap.lin (missing empty-token guard): semantic hash gate is BLIND to the bug, behavior gate CATCHES it', () => {\n  const src = fs.readFileSync(path.join(root, 'test/fixtures/token_guard.trap.lin'), 'utf8');\n  const casesText = fs.readFileSync(path.join(root, 'test/fixtures/token_guard.cases.rulel'), 'utf8');\n  const cases = parseBehaviorCasesRulel(casesText);\n\n  // Plain verify: PARSE/EXPORTS/HASH_STABLE/JS_SYNTAX all pass — the rewrite \"looks\" fine.\n  const plain = verify(src);\n  assert.equal(plain.ok, true, `expected plain verify to pass (semantic hash is blind here): ${JSON.stringify(plain.gates)}`);\n\n  // verify --behavior: G_BEHAVIOR must fail and name the exact offending case.\n  const behavioral = verify(src, { behavior: cases });\n  assert.equal(behavioral.ok, false, 'behavioral oracle must catch the auth-bypass-class bug that semantic hash missed');\n  const bg = behavioral.gates.find((g) => g.gate === 'G_BEHAVIOR');\n  assert.equal(bg.pass, false);\n  assert.match(bg.detail, /matchesToken/);\n  assert.match(bg.detail, /want false/);\n});\n\ntest('lin verify --behavior CLI accepts .rulel cases end-to-end (good=pass, trap=fail)', () => {\n  const cliPath = path.join(root, 'bin/lin.mjs');\n  const good = path.join(root, 'test/fixtures/token_guard.lin');\n  const trap = path.join(root, 'test/fixtures/token_guard.trap.lin');\n  const cases = path.join(root, 'test/fixtures/token_guard.cases.rulel');\n\n  const goodOut = JSON.parse(execFileSync('node', [cliPath, 'verify', good, '--behavior', cases], { cwd: root, encoding: 'utf8' }));\n  assert.equal(goodOut.ok, true, JSON.stringify(goodOut.gates));\n\n  let trapFailed = false;\n  let trapReport = null;\n  try {\n    execFileSync('node', [cliPath, 'verify', trap, '--behavior', cases], { cwd: root, encoding: 'utf8' });\n  } catch (e) {\n    trapFailed = true;\n    trapReport = JSON.parse(e.stdout);\n  }\n  assert.equal(trapFailed, true, 'CLI must exit non-zero when the behavioral oracle fails');\n  assert.equal(trapReport.ok, false);\n  const bg = trapReport.gates.find((g) => g.gate === 'G_BEHAVIOR');\n  assert.equal(bg.pass, false);\n  assert.match(bg.detail, /matchesToken/);\n});\n\nconsole.log('T24 diff-behavior (in-memory differential runner, live mock objects)');\nawait testAsync('diffBehavior compares a LIN rewrite against the live ORIGINAL, including non-JSON-serializable mock args', async () => {\n  const { diffBehavior } = await import(path.join(root, 'scripts', 'diff_behavior.mjs'));\n  const tmp = fs.mkdtempSync(TMP_PREFIX + 'diffbeh-');\n\n  const originalPath = path.join(tmp, 'original.mjs');\n  fs.writeFileSync(\n    originalPath,\n    [\n      \"export function matchesToken(expected, offered) {\",\n      \"  if (expected.length === 0 || offered.length !== expected.length) return false;\",\n      \"  let difference = 0;\",\n      \"  for (let i = 0; i < offered.length; i++) difference |= offered.charCodeAt(i) ^ expected.charCodeAt(i);\",\n      \"  return difference === 0;\",\n      \"}\",\n      \"export function hasManagedAgentToken(request, expected) {\",\n      \"  return matchesToken(expected, (request.headers.get('x-openbot-agent-token') ?? '').trim());\",\n      \"}\",\n      \"\",\n    ].join('\\n'),\n  );\n\n  const mockPath = path.join(tmp, 'mock_cases.mjs');\n  fs.writeFileSync(\n    mockPath,\n    [\n      \"function mkRequest(headers) {\",\n      \"  const map = new Map(Object.entries(headers || {}));\",\n      \"  return { headers: { get: (k) => map.get(k) ?? null } };\",\n      \"}\",\n      \"export async function cases() {\",\n      \"  return [\",\n      \"    { fn: 'matchesToken', args: ['', ''], label: 'empty vs empty' },\",\n      \"    { fn: 'hasManagedAgentToken', args: [mkRequest({ 'x-openbot-agent-token': 'secret' }), 'secret'] },\",\n      \"    { fn: 'hasManagedAgentToken', args: [mkRequest({}), 'secret'] },\",\n      \"  ];\",\n      \"}\",\n      \"\",\n    ].join('\\n'),\n  );\n\n  const goodLin = path.join(root, 'test/fixtures/token_guard.lin');\n  const trapLin = path.join(root, 'test/fixtures/token_guard.trap.lin');\n\n  const goodReport = await diffBehavior({ originalPath, linPath: goodLin, mockPath });\n  assert.equal(goodReport.ok, true, JSON.stringify(goodReport.results));\n  assert.equal(goodReport.count, 3);\n  // want was computed live from the ORIGINAL (golden-from-original mode: no explicit 'want' in cases).\n  assert.equal(goodReport.results[0].want, false);\n\n  const trapReport = await diffBehavior({ originalPath, linPath: trapLin, mockPath });\n  assert.equal(trapReport.ok, false);\n  const bad = trapReport.results.find((r) => r.label === 'empty vs empty');\n  assert.equal(bad.pass, false);\n  assert.equal(bad.want, false);\n  assert.equal(bad.got, true);\n});\n\nconsole.log(`\\n${passed} passed, ${failed} failed`);\nif (failed) {\n  for (const [name, msg] of failures) console.log(`  FAILED ${name}: ${msg.slice(0, 200)}`);\n  process.exit(1);\n}\n"}
