@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/LIN_AGENT_RUNTIME_003/dataset/generate_blind_tasks.mjs" lang="mjs"}
.source{content="import fs from 'fs';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst ROOT = path.resolve(path.dirname(__filename), '..');\n\nexport function createBlindTaskDataset() {\n  const blindTasks = [\n    {\n      task_id: \"BLIND_01\",\n      title: \"Caret range upper bound overflow on major > 0\",\n      issue_description: \"Users report that satisfiesRange('2.0.0', '^1.2.3') is unexpectedly returning true. A caret range on major 1 must match versions < 2.0.0, but version 2.0.0 is currently being accepted.\",\n      failing_test_name: \"test_ranges_caret_major\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('2.0.0', '^1.2.3') to be false, got true at test_runner.js:42\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"if (base.major > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major + 1}.0.0` }];\\n    }\",\n        bug_replace: \"if (base.major > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major + 1}.0.0` }];\\n    }\"\n      }\n    },\n    {\n      task_id: \"BLIND_02\",\n      title: \"Prerelease identifier numeric comparison inversion\",\n      issue_description: \"When comparing prereleases with numeric identifiers, '1.0.0-alpha.10' is being evaluated as smaller than '1.0.0-alpha.2' instead of greater.\",\n      failing_test_name: \"test_comparator_numeric_prerelease\",\n      test_assertion_error: \"AssertionError: expected compareVersions('1.0.0-alpha.10', '1.0.0-alpha.2') to be 1, got -1 at test_runner.js:28\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareIdentifiers\",\n        bug_find: \"if (anum && bnum) {\\n    const na = parseInt(a, 10);\\n    const nb = parseInt(b, 10);\\n    return na === nb ? 0 : na > nb ? 1 : -1;\\n  }\",\n        bug_replace: \"if (anum && bnum) {\\n    return a.localeCompare(b);\\n  }\"\n      }\n    },\n    {\n      task_id: \"BLIND_03\",\n      title: \"Tilde range minor boundary leakage\",\n      issue_description: \"Tilde ranges like '~1.2.3' are matching '1.3.0'. Tilde ranges must restrict minor updates such that only versions < 1.3.0 are permitted.\",\n      failing_test_name: \"test_ranges_tilde_boundary\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at test_runner.js:56\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];\",\n        bug_replace: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];\"\n      }\n    },\n    {\n      task_id: \"BLIND_04\",\n      title: \"Strict inequality gt() returning true for equal versions\",\n      issue_description: \"gt('1.2.3', '1.2.3') returns true in production. The greater-than function must be strictly false when versions are equal.\",\n      failing_test_name: \"test_comparator_gt_strictness\",\n      test_assertion_error: \"AssertionError: expected gt('1.2.3', '1.2.3') to be false, got true at test_runner.js:33\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"gt\",\n        bug_find: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c > 0; }\",\n        bug_replace: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c >= 0; }\"\n      }\n    },\n    {\n      task_id: \"BLIND_05\",\n      title: \"minSatisfying selecting maximum candidate\",\n      issue_description: \"Calling minSatisfying with range '^1.0.0' over ['1.1.0', '1.0.1', '1.2.0'] is returning '1.2.0' instead of the minimum matching version '1.0.1'.\",\n      failing_test_name: \"test_satisfier_min\",\n      test_assertion_error: \"AssertionError: expected minSatisfying(['1.1.0', '1.0.1', '1.2.0'], '^1.0.0') to be '1.0.1', got '1.2.0' at test_runner.js:71\",\n      ground_truth: {\n        file: \"src/satisfier.js\",\n        symbol: \"minSatisfying\",\n        bug_find: \"if (satisfiesRange(v, rangeStr)) {\\n      if (!min || lt(v, min)) {\\n        min = v;\\n      }\\n    }\",\n        bug_replace: \"if (satisfiesRange(v, rangeStr)) {\\n      if (!min || gt(v, min)) {\\n        min = v;\\n      }\\n    }\"\n      }\n    },\n    {\n      task_id: \"BLIND_06\",\n      title: \"Version parser failing on optional leading 'v'\",\n      issue_description: \"parseVersion('v1.2.3') is returning null. The semver parser must accept valid semver strings with an optional leading 'v' prefix.\",\n      failing_test_name: \"test_parser_leading_v\",\n      test_assertion_error: \"AssertionError: expected parseVersion('v1.2.3') to be object, got null at test_runner.js:15\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n    {\n      task_id: \"BLIND_07\",\n      title: \"Prerelease precedence inversion breaking normal version priority\",\n      issue_description: \"A normal release '1.0.0' is currently evaluated as smaller than '1.0.0-alpha'. By SemVer spec, a normal version has higher precedence than a prerelease.\",\n      failing_test_name: \"test_comparator_normal_vs_prerelease\",\n      test_assertion_error: \"AssertionError: expected compareVersions('1.0.0', '1.0.0-alpha') to be 1, got -1 at test_runner.js:24\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"comparePrereleases\",\n        bug_find: \"if (preA.length === 0 && preB.length > 0) return 1; // normal > prerelease\\n  if (preA.length > 0 && preB.length === 0) return -1;\",\n        bug_replace: \"if (preA.length === 0 && preB.length > 0) return -1;\\n  if (preA.length > 0 && preB.length === 0) return 1;\"\n      }\n    },\n    {\n      task_id: \"BLIND_08\",\n      title: \"Zero-major caret ranges boundary leak at 0.3.0\",\n      issue_description: \"Range '^0.2.3' is allowing '0.3.0' to pass satisfiesRange. For 0.X.Y, caret ranges must strictly freeze the minor component.\",\n      failing_test_name: \"test_ranges_caret_zero_major\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('0.3.0', '^0.2.3') to be false, got true at test_runner.js:49\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\\n    }\",\n        bug_replace: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\\n    }\"\n      }\n    },\n    {\n      task_id: \"BLIND_09\",\n      title: \"maxSatisfying returning empty string instead of null on no match\",\n      issue_description: \"When no versions in the list satisfy the range, maxSatisfying returns '' instead of null, causing downstream type errors.\",\n      failing_test_name: \"test_satisfier_no_match\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying(['1.0.0'], '^2.0.0') to be null, got '' at test_runner.js:68\",\n      ground_truth: {\n        file: \"src/satisfier.js\",\n        symbol: \"maxSatisfying\",\n        bug_find: \"return max;\",\n        bug_replace: \"return max || '';\"\n      }\n    },\n    {\n      task_id: \"BLIND_10\",\n      title: \"Comparator antisymmetry regression on unequal versions\",\n      issue_description: \"compareVersions('1.2.0', '1.1.0') returns 1, but compareVersions('1.1.0', '1.2.0') is returning 0 instead of -1.\",\n      failing_test_name: \"test_comparator_antisymmetry\",\n      test_assertion_error: \"AssertionError: expected compareVersions('1.1.0', '1.2.0') to be -1, got 0 at test_runner.js:30\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareVersions\",\n        bug_find: \"if (v1.minor !== v2.minor) return v1.minor > v2.minor ? 1 : -1;\",\n        bug_replace: \"if (v1.minor !== v2.minor) return v1.minor > v2.minor ? 1 : 0;\"\n      }\n    }\n  ];\n\n  const outPath = path.join(ROOT, 'dataset/blind_tasks.json');\n  fs.writeFileSync(outPath, JSON.stringify(blindTasks, null, 2));\n  console.log(`[+] Generated ${blindTasks.length} Blind Debugging Tasks at: ${outPath}`);\n  return blindTasks;\n}\n\ncreateBlindTaskDataset();\n"}
