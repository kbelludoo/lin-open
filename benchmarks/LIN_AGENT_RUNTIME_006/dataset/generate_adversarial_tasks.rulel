@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/LIN_AGENT_RUNTIME_006/dataset/generate_adversarial_tasks.mjs" lang="mjs"}
.source{content="import fs from 'fs';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst ROOT = path.resolve(path.dirname(__filename), '..');\n\nexport function createAdversarialDataset() {\n  const tasks = [\n    // 1. Deep Bug: maxSatisfying symptom -> parseVersion root cause (A -> B -> C -> D)\n    {\n      task_id: \"ADV_01\",\n      title: \"maxSatisfying fails on version with optional build tags\",\n      issue_description: \"Calling maxSatisfying(['1.0.0+20130313144700', '1.0.0+20130313144701'], '^1.0.0') returns null instead of '1.0.0+20130313144700'. Build metadata versions are not being parsed correctly.\",\n      failing_test_name: \"test_satisfier_build_metadata\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to return '1.0.0+20130313144700', got null at satisfier.test.js:14\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n    // 2. Deep Bug: satisfiesRange symptom -> compareIdentifiers root cause\n    {\n      task_id: \"ADV_02\",\n      title: \"satisfiesRange incorrectly rejects valid numeric prereleases\",\n      issue_description: \"satisfiesRange('1.0.0-alpha.10', '>=1.0.0-alpha.2') is returning false. Range evaluation across numeric prerelease identifiers is failing.\",\n      failing_test_name: \"test_ranges_numeric_prerelease\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.0.0-alpha.10', '>=1.0.0-alpha.2') to be true, got false at ranges.test.js:88\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareIdentifiers\",\n        bug_find: \"if (anum && bnum) {\\n    const na = parseInt(a, 10);\\n    const nb = parseInt(b, 10);\\n    return na === nb ? 0 : na > nb ? 1 : -1;\\n  }\",\n        bug_replace: \"if (anum && bnum) {\\n    return a.length - b.length;\\n  }\"\n      }\n    },\n    // 3. Deep Bug: minSatisfying symptom -> compareVersions root cause\n    {\n      task_id: \"ADV_03\",\n      title: \"minSatisfying selects wrong element when minor versions differ\",\n      issue_description: \"minSatisfying(['1.2.0', '1.1.0', '1.3.0'], '^1.0.0') is picking '1.2.0' instead of '1.1.0' due to an asymmetry in version comparison.\",\n      failing_test_name: \"test_satisfier_minor_comparison\",\n      test_assertion_error: \"AssertionError: expected minSatisfying to be '1.1.0', got '1.2.0' at satisfier.test.js:32\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareVersions\",\n        bug_find: \"if (v1.minor !== v2.minor) return v1.minor > v2.minor ? 1 : -1;\",\n        bug_replace: \"if (v1.minor !== v2.minor) return v1.minor < v2.minor ? 1 : -1;\"\n      }\n    },\n    // 4. Deep Bug: satisfiesRange symptom -> parseRange tilde upper bound\n    {\n      task_id: \"ADV_04\",\n      title: \"satisfiesRange tilde range leakage at 1.3.0\",\n      issue_description: \"satisfiesRange('1.3.0', '~1.2.3') is unexpectedly accepting '1.3.0'. Tilde bounds must strictly limit minor updates.\",\n      failing_test_name: \"test_ranges_tilde_leak\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at ranges.test.js:41\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];\",\n        bug_replace: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];\"\n      }\n    },\n    // 5. Deep Bug: gt() strictness symptom -> compareVersions equality return\n    {\n      task_id: \"ADV_05\",\n      title: \"Strict gt() returns true for identical patch versions\",\n      issue_description: \"gt('1.0.1', '1.0.1') returns true. Strict greater-than evaluation is failing on identical versions.\",\n      failing_test_name: \"test_comparator_gt_equal\",\n      test_assertion_error: \"AssertionError: expected gt('1.0.1', '1.0.1') to be false, got true at comparator.test.js:55\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"gt\",\n        bug_find: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c > 0; }\",\n        bug_replace: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c >= 0; }\"\n      }\n    },\n    // 6. Deep Bug: maxSatisfying symptom -> comparePrereleases normal vs prerelease\n    {\n      task_id: \"ADV_06\",\n      title: \"maxSatisfying chooses prerelease over normal release\",\n      issue_description: \"maxSatisfying(['1.0.0', '1.0.0-beta'], '^1.0.0') is choosing '1.0.0-beta' over '1.0.0'. Normal releases must take precedence.\",\n      failing_test_name: \"test_satisfier_prerelease_precedence\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to be '1.0.0', got '1.0.0-beta' at satisfier.test.js:61\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"comparePrereleases\",\n        bug_find: \"if (preA.length === 0 && preB.length > 0) return 1; // normal > prerelease\\n  if (preA.length > 0 && preB.length === 0) return -1;\",\n        bug_replace: \"if (preA.length === 0 && preB.length > 0) return -1;\\n  if (preA.length > 0 && preB.length === 0) return 1;\"\n      }\n    },\n    // 7. Deep Bug: parseVersion symptom -> regex leading 'v'\n    {\n      task_id: \"ADV_07\",\n      title: \"isValid returns false for leading 'v' strings\",\n      issue_description: \"isValid('v2.0.0') is returning false. Valid version strings starting with 'v' must pass validation.\",\n      failing_test_name: \"test_parser_valid_v\",\n      test_assertion_error: \"AssertionError: expected isValid('v2.0.0') to be true, got false at parser.test.js:19\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n    // 8. Deep Bug: satisfiesRange caret zero-major leakage\n    {\n      task_id: \"ADV_08\",\n      title: \"satisfiesRange accepts 0.3.0 on range '^0.2.3'\",\n      issue_description: \"satisfiesRange('0.3.0', '^0.2.3') returns true. Zero-major caret ranges must not permit minor bumps.\",\n      failing_test_name: \"test_ranges_caret_zero\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('0.3.0', '^0.2.3') to be false, got true at ranges.test.js:77\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\\n    }\",\n        bug_replace: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\\n    }\"\n      }\n    },\n    // 9. Deep Bug: maxSatisfying null safety\n    {\n      task_id: \"ADV_09\",\n      title: \"maxSatisfying returns empty string on empty match\",\n      issue_description: \"Calling maxSatisfying(['1.0.0'], '^3.0.0') returns '' instead of null, breaking strict nullable contracts.\",\n      failing_test_name: \"test_satisfier_null_return\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to be null, got '' at satisfier.test.js:82\",\n      ground_truth: {\n        file: \"src/satisfier.js\",\n        symbol: \"maxSatisfying\",\n        bug_find: \"return max;\",\n        bug_replace: \"return max || '';\"\n      }\n    },\n    // 10. Deep Bug: compareVersions patch comparison inversion\n    {\n      task_id: \"ADV_10\",\n      title: \"compareVersions patch comparison inverted on equal major and minor\",\n      issue_description: \"compareVersions('1.0.2', '1.0.1') returns -1 instead of 1.\",\n      failing_test_name: \"test_comparator_patch_order\",\n      test_assertion_error: \"AssertionError: expected compareVersions('1.0.2', '1.0.1') to be 1, got -1 at comparator.test.js:40\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareVersions\",\n        bug_find: \"if (v1.patch !== v2.patch) return v1.patch > v2.patch ? 1 : -1;\",\n        bug_replace: \"if (v1.patch !== v2.patch) return v1.patch < v2.patch ? 1 : -1;\"\n      }\n    }\n  ];\n\n  const outPath = path.join(ROOT, 'dataset/adversarial_tasks.json');\n  fs.writeFileSync(outPath, JSON.stringify(tasks, null, 2));\n  console.log(`[+] Generated ${tasks.length} Adversarial Blind Tasks at: ${outPath}`);\n  return tasks;\n}\n\ncreateAdversarialDataset();\n"}
