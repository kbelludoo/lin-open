.source{content="[\n  {\n    \"task_id\": \"T003\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"ORACLE_FAILURE\",\n    \"compile_pass\": true,\n    \"oracle_pass\": false,\n    \"total_tokens\": 352,\n    \"total_latency_ms\": 58084,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"536f8615c0217d9e\",\n        \"candidate_code\": \"!solve(input){ \\n    let { stack, action, value, history } = input;\\n    if (action === \\\"push\\\") {\\n        history.push({ stack: [...stack], action: \\\"push\\\", value });\\n        stack = [...stack, value];\\n    } else if (action === \\\"pop\\\") {\\n        if (stack.length > 0) {\\n            history.push({ stack: [...stack], action: \\\"pop\\\" });\\n            stack = stack.slice(0, -1);\\n        }\\n    } else if (action === \\\"rollback\\\") {\\n        if (history.length > 0) {\\n            let lastAction = history.pop();\\n            stack = lastAction.stack;\\n        }\\n    }\\n    return { stack, history };\\n}\",\n        \"tokens\": 352,\n        \"latency_ms\": 58084,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": false,\n        \"failure_class\": \"ORACLE_FAILURE\",\n        \"condition\": \"ZERO_SHOT\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T002\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"ORACLE_FAILURE\",\n    \"compile_pass\": true,\n    \"oracle_pass\": false,\n    \"total_tokens\": 313,\n    \"total_latency_ms\": 39759,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"f4c2cd0406039fd3\",\n        \"candidate_code\": \"!solve(input){ \\n    var buffer = input.buffer; \\n    var item = input.item; \\n    var len = buffer.length; \\n    if (len < 3) { \\n        buffer[len] = item; \\n    } else { \\n        for (var i = 0; i < len - 1; i++) { \\n            buffer[i] = buffer[i + 1]; \\n        } \\n        buffer[len - 1] = item; \\n    } \\n    return buffer; \\n}\",\n        \"tokens\": 313,\n        \"latency_ms\": 39759,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": false,\n        \"failure_class\": \"ORACLE_FAILURE\",\n        \"condition\": \"ZERO_SHOT\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T001\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"easy\",\n    \"failure_class\": \"PASS\",\n    \"compile_pass\": true,\n    \"oracle_pass\": true,\n    \"total_tokens\": 259,\n    \"total_latency_ms\": 19747,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"3b93c93d5914990e\",\n        \"candidate_code\": \"!solve(input){\\n    ?(input == \\\"RED\\\"){ ^\\\"GREEN\\\" }\\n    ?(input == \\\"GREEN\\\"){ ^\\\"YELLOW\\\" }\\n    ?(input == \\\"YELLOW\\\"){ ^\\\"RED\\\" }\\n    :{ ^\\\"ERROR\\\" }\\n}\",\n        \"tokens\": 259,\n        \"latency_ms\": 19747,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": true,\n        \"failure_class\": \"PASS\",\n        \"condition\": \"ZERO_SHOT\"\n      }\n    ]\n  }\n]"}
