.source{content="[\n  {\n    \"task_id\": \"T003\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"ORACLE_FAILURE\",\n    \"compile_pass\": true,\n    \"oracle_pass\": false,\n    \"total_tokens\": 882,\n    \"total_latency_ms\": 89936,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"ae61992910aa0e50\",\n        \"candidate_code\": \"!solve(input){\\nstack = input.stack;\\naction = input.action;\\nvalue = input.value;\\nhistory = input.history;\\n\\n?(action == \\\"push\\\"){\\nnewStack = [...stack, value];\\nnewHistory = [...history, {type: \\\"push\\\", value: value}];\\n}:(action == \\\"pop\\\"){\\n?(stack.length > 0){\\nnewStack = stack.slice(0, -1);\\nnewHistory = [...history, {type: \\\"pop\\\", value: stack[stack.length - 1]}];\\n}:(stack.length == 0){\\nnewStack = stack;\\nnewHistory = history;\\n}\\n}:(action == \\\"rollback\\\"){\\n?(history.length > 0){\\nlastAction = history[history.length - 1];\\n?(lastAction.type == \\\"push\\\"){\\nnewStack = stack.slice(0, -1);\\nnewHistory = history.slice(0, -1);\\n}:(lastAction.type == \\\"pop\\\"){\\nnewStack = [...stack, lastAction.value];\\nnewHistory = history.slice(0, -1);\\n}\\n}:(history.length == 0){\\nnewStack = stack;\\nnewHistory = history;\\n}\\n}^{\\nstack: newStack,\\nhistory: newHistory\\n}\\n}\",\n        \"tokens\": 882,\n        \"latency_ms\": 89936,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": false,\n        \"failure_class\": \"ORACLE_FAILURE\",\n        \"condition\": \"CONSTRAINED\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T001\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"easy\",\n    \"failure_class\": \"PASS\",\n    \"compile_pass\": true,\n    \"oracle_pass\": true,\n    \"total_tokens\": 682,\n    \"total_latency_ms\": 13716,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"ccbda32fff70ca46\",\n        \"candidate_code\": \"!solve(input){\\n?(input==\\\"RED\\\"){^\\\"GREEN\\\"}\\n:(input==\\\"GREEN\\\"){^\\\"YELLOW\\\"}\\n:(input==\\\"YELLOW\\\"){^\\\"RED\\\"}\\n:{^\\\"ERROR\\\"}\\n}\",\n        \"tokens\": 682,\n        \"latency_ms\": 13716,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": true,\n        \"failure_class\": \"PASS\",\n        \"condition\": \"CONSTRAINED\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T002\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"INVALID_LIN\",\n    \"compile_pass\": false,\n    \"oracle_pass\": false,\n    \"total_tokens\": 695,\n    \"total_latency_ms\": 18444,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"f5943260c23c76ad\",\n        \"candidate_code\": \"!solve(input){\\n  buffer = input.buffer;\\n  item = input.item;\\n  if (buffer.length < 3) {\\n    buffer.push(item);\\n  } else {\\n    buffer.shift();\\n    buffer.push(item);\\n  }\\n  ^buffer\\n}\",\n        \"tokens\": 695,\n        \"latency_ms\": 18444,\n        \"verifier_passed\": false,\n        \"oracle_executed\": false,\n        \"oracle_passed\": false,\n        \"failure_class\": \"INVALID_LIN\",\n        \"condition\": \"CONSTRAINED\"\n      }\n    ]\n  }\n]"}
