.source{content="[\n  {\n    \"task_id\": \"T001\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"easy\",\n    \"failure_class\": \"ORACLE_FAILURE\",\n    \"compile_pass\": true,\n    \"oracle_pass\": false,\n    \"total_tokens\": 600,\n    \"total_latency_ms\": 22096,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"3f096ced36535af5\",\n        \"candidate_code\": \"!solve(currentState){\\n?((currentState==\\\"RED\\\")){\\n^\\\"GREEN\\\"\\n}:(currentState==\\\"GREEN\\\")){\\n^\\\"YELLOW\\\"\\n}:(currentState==\\\"YELLOW\\\")){\\n^\\\"RED\\\"\\n}:{^\\\"ERROR\\\"}\\n}\",\n        \"tokens\": 600,\n        \"latency_ms\": 22096,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": false,\n        \"failure_class\": \"ORACLE_FAILURE\",\n        \"condition\": \"FEW_SHOT\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T002\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"INVALID_LIN\",\n    \"compile_pass\": false,\n    \"oracle_pass\": false,\n    \"total_tokens\": 603,\n    \"total_latency_ms\": 17357,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"5b28ea5f9e2a4240\",\n        \"candidate_code\": \"!pushPuroEmRingBuffer({ buffer, item }){\\n    if(buffer.length < 3){\\n        buffer.push(item);\\n    } else {\\n        buffer.shift();\\n        buffer.push(item);\\n    }\\n    ^buffer;\\n}\",\n        \"tokens\": 603,\n        \"latency_ms\": 17357,\n        \"verifier_passed\": false,\n        \"oracle_executed\": false,\n        \"oracle_passed\": false,\n        \"failure_class\": \"INVALID_LIN\",\n        \"condition\": \"FEW_SHOT\"\n      }\n    ]\n  },\n  {\n    \"task_id\": \"T003\",\n    \"family\": \"logic_state\",\n    \"difficulty\": \"medium\",\n    \"failure_class\": \"ORACLE_FAILURE\",\n    \"compile_pass\": true,\n    \"oracle_pass\": false,\n    \"total_tokens\": 794,\n    \"total_latency_ms\": 83112,\n    \"attempts\": [\n      {\n        \"attempt\": 1,\n        \"candidate_hash\": \"762e9cd5ef320d85\",\n        \"candidate_code\": \"!solve(input){\\n  stack = input.stack;\\n  action = input.action;\\n  value = input.value;\\n  history = input.history;\\n\\n  ?(action==\\\"push\\\"){\\n    newStack = [...stack, value];\\n    newHistory = [...history, {type:\\\"push\\\", value:value}];\\n  }:(action==\\\"pop\\\"){\\n    ?(stack.length>0){\\n      newStack = stack.slice(0, -1);\\n      newHistory = [...history, {type:\\\"pop\\\", value:stack[stack.length-1]}];\\n    }:{newStack = stack; newHistory = history}\\n  }:(action==\\\"rollback\\\"){\\n    ?(history.length>0){\\n      lastAction = history[history.length-1];\\n      ?(lastAction.type==\\\"push\\\"){\\n        newStack = stack.slice(0, -1);\\n      }:(lastAction.type==\\\"pop\\\"){\\n        newStack = [...stack, lastAction.value];\\n      }\\n      newHistory = history.slice(0, -1);\\n    }:{newStack = stack; newHistory = history}\\n  }:{newStack = stack; newHistory = history}\\n\\n  ^{stack:newStack, history:newHistory}\\n}\",\n        \"tokens\": 794,\n        \"latency_ms\": 83112,\n        \"verifier_passed\": true,\n        \"oracle_executed\": true,\n        \"oracle_passed\": false,\n        \"failure_class\": \"ORACLE_FAILURE\",\n        \"condition\": \"FEW_SHOT\"\n      }\n    ]\n  }\n]"}
