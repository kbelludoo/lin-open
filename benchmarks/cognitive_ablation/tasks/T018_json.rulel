.source{content="{\n  \"id\": \"T018\",\n  \"family\": \"effects_contracts\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Validador de contrato de tipo estrito. Entrada: any. Saída: string indicando o tipo semântico: \\\"array\\\", \\\"null\\\", \\\"object\\\", \\\"number\\\", \\\"string\\\", \\\"boolean\\\".\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": [\n        1,\n        2\n      ],\n      \"expected\": \"array\"\n    },\n    {\n      \"input\": null,\n      \"expected\": \"null\"\n    },\n    {\n      \"input\": {\n        \"a\": 1\n      },\n      \"expected\": \"object\"\n    },\n    {\n      \"input\": 42,\n      \"expected\": \"number\"\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T018.mjs\"\n  }\n}"}
