~METADATA{original="benchmarks/cognitive_ablation/tasks/T017.json" ext=".json"}
.source{content="{\n  \"id\": \"T017\",\n  \"family\": \"effects_contracts\",\n  \"difficulty\": \"hard\",\n  \"specification\": \"Pipeline de cálculo de taxas imutável. Entrada: { base: number, rates: [number] }. Saída: valor final base * (1 + rate_1) * ... * (1 + rate_n) arredondado a 2 casas decimais.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\",\n    \"db.\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"base\": 100,\n        \"rates\": [\n          0.1,\n          0.05\n        ]\n      },\n      \"expected\": 115.5\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T017.mjs\"\n  }\n}"}
