        {
          "id": 1,
          "v": "b"
        },
        {
          "id": 2,
          "v": "c"
        }
      ],
      "expected": [
        {
          "id": 1,
          "v": "a"
        },
        {
          "id": 2,
          "v": "c"
        }
      ]
    }
  ],
  "oracle": {
