@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/cognitive_ablation/tasks/T023.json" ext=".json"}
.source{content="{\n  \"id\": \"T023\",\n  \"family\": \"debug_repair\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Comparador semântico de versões semânticas (SemVer \\\"major.minor.patch\\\"). Entrada: { v1: string, v2: string }. Saída: 1 se v1 > v2, -1 se v1 < v2, 0 se v1 == v2.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"v1\": \"1.2.0\",\n        \"v2\": \"1.1.9\"\n      },\n      \"expected\": 1\n    },\n    {\n      \"input\": {\n        \"v1\": \"2.0.0\",\n        \"v2\": \"2.0.0\"\n      },\n      \"expected\": 0\n    },\n    {\n      \"input\": {\n        \"v1\": \"1.0.5\",\n        \"v2\": \"1.0.10\"\n      },\n      \"expected\": -1\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T023.mjs\"\n  }\n}"}
