@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/cognitive_ablation/tasks/T002.json" ext=".json"}
.source{content="{\n  \"id\": \"T002\",\n  \"family\": \"logic_state\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Implemente push puro em um ring buffer de capacidade 3. Entrada: { buffer: array, item: any }. Saída: novo array com no máximo 3 itens (se exceder, remove o mais antigo da esquerda).\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"buffer.push\",\n    \"buffer.shift\",\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"buffer\": [\n          1,\n          2\n        ],\n        \"item\": 3\n      },\n      \"expected\": [\n        1,\n        2,\n        3\n      ]\n    },\n    {\n      \"input\": {\n        \"buffer\": [\n          1,\n          2,\n          3\n        ],\n        \"item\": 4\n      },\n      \"expected\": [\n        2,\n        3,\n        4\n      ]\n    },\n    {\n      \"input\": {\n        \"buffer\": [],\n        \"item\": 1\n      },\n      \"expected\": [\n        1\n      ]\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T002.mjs\"\n  }\n}"}
