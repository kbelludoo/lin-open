~METADATA{original="benchmarks/cognitive_ablation/tasks/T015.json" ext=".json"}
.source{content="{\n  \"id\": \"T015\",\n  \"family\": \"effects_contracts\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Gerador Linear Congruencial puro (LCG). Entrada: { seed: number, a: number, c: number, m: number }. Saída: próximo número pseudo-aleatório (seed * a + c) % m.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"Math.random\",\n    \"Date.now\",\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"seed\": 42,\n        \"a\": 1664525,\n        \"c\": 1013904223,\n        \"m\": 4294967296\n      },\n      \"expected\": 1083814273\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T015.mjs\"\n  }\n}"}
