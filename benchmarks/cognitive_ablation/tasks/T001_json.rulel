~METADATA{original="benchmarks/cognitive_ablation/tasks/T001.json" ext=".json"}
.source{content="{\n  \"id\": \"T001\",\n  \"family\": \"logic_state\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Implemente uma máquina de estados finita pura para semáforo. Entrada: estado atual (\\\"RED\\\", \\\"GREEN\\\", \\\"YELLOW\\\"). Saída: próximo estado (\\\"GREEN\\\", \\\"YELLOW\\\", \\\"RED\\\"). Qualquer outro estado deve retornar \\\"ERROR\\\".\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\",\n    \"console.log\",\n    \"process.\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": \"RED\",\n      \"expected\": \"GREEN\"\n    },\n    {\n      \"input\": \"GREEN\",\n      \"expected\": \"YELLOW\"\n    },\n    {\n      \"input\": \"YELLOW\",\n      \"expected\": \"RED\"\n    },\n    {\n      \"input\": \"BLUE\",\n      \"expected\": \"ERROR\"\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T001.mjs\"\n  }\n}"}
