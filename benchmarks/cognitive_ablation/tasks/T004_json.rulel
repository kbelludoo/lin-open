.source{content="{\n  \"id\": \"T004\",\n  \"family\": \"logic_state\",\n  \"difficulty\": \"hard\",\n  \"specification\": \"União de intervalos numéricos sobrepostos. Entrada: array de intervalos [[inicio, fim], ...]. Saída: array de intervalos mesclados ordenados.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": [\n        [\n          1,\n          3\n        ],\n        [\n          2,\n          6\n        ],\n        [\n          8,\n          10\n        ],\n        [\n          15,\n          18\n        ]\n      ],\n      \"expected\": [\n        [\n          1,\n          6\n        ],\n        [\n          8,\n          10\n        ],\n        [\n          15,\n          18\n        ]\n      ]\n    },\n    {\n      \"input\": [\n        [\n          1,\n          4\n        ],\n        [\n          4,\n          5\n        ]\n      ],\n      \"expected\": [\n        [\n          1,\n          5\n        ]\n      ]\n    },\n    {\n      \"input\": [],\n      \"expected\": []\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T004.mjs\"\n  }\n}"}
