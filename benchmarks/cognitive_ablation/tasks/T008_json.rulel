.source{content="{\n  \"id\": \"T008\",\n  \"family\": \"code_transformation\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Compressão Run-Length Encoding (RLE). Entrada: string (ex: \\\"AAABBBCC\\\"). Saída: string codificada (ex: \\\"3A3B2C\\\"). Se string vazia, retorna \\\"\\\".\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": \"AAABBBCC\",\n      \"expected\": \"3A3B2C\"\n    },\n    {\n      \"input\": \"A\",\n      \"expected\": \"1A\"\n    },\n    {\n      \"input\": \"\",\n      \"expected\": \"\"\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T008.mjs\"\n  }\n}"}
