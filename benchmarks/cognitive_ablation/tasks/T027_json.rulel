.source{content="{\n  \"id\": \"T027\",\n  \"family\": \"multi_step_composition\",\n  \"difficulty\": \"hard\",\n  \"specification\": \"Diff estrutural entre dois objetos planos. Entrada: { oldObj: {}, newObj: {} }. Saída: { added: [keys], removed: [keys], updated: [keys] } (chaves ordenadas).\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"oldObj\": {\n          \"a\": 1,\n          \"b\": 2,\n          \"c\": 3\n        },\n        \"newObj\": {\n          \"b\": 20,\n          \"c\": 3,\n          \"d\": 4\n        }\n      },\n      \"expected\": {\n        \"added\": [\n          \"d\"\n        ],\n        \"removed\": [\n          \"a\"\n        ],\n        \"updated\": [\n          \"b\"\n        ]\n      }\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T027.mjs\"\n  }\n}"}
