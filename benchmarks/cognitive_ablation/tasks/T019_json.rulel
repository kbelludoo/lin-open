~METADATA{original="benchmarks/cognitive_ablation/tasks/T019.json" ext=".json"}
.source{content="{\n  \"id\": \"T019\",\n  \"family\": \"debug_repair\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Busca binária corrigida. Entrada: { arr: array ordenado, target: number }. Saída: index do elemento ou -1 se não encontrado. (Evite loop infinito ou erro off-by-one).\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"arr.indexOf\",\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"arr\": [\n          10,\n          20,\n          30,\n          40,\n          50\n        ],\n        \"target\": 30\n      },\n      \"expected\": 2\n    },\n    {\n      \"input\": {\n        \"arr\": [\n          10,\n          20,\n          30,\n          40,\n          50\n        ],\n        \"target\": 10\n      },\n      \"expected\": 0\n    },\n    {\n      \"input\": {\n        \"arr\": [\n          10,\n          20,\n          30,\n          40,\n          50\n        ],\n        \"target\": 99\n      },\n      \"expected\": -1\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T019.mjs\"\n  }\n}"}
