.source{content="{\n  \"id\": \"T020\",\n  \"family\": \"debug_repair\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Cálculo de divisão segura com média. Entrada: array de números. Saída: média dos números ou 0 se o array estiver vazio.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": [\n        10,\n        20,\n        30\n      ],\n      \"expected\": 20\n    },\n    {\n      \"input\": [],\n      \"expected\": 0\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T020.mjs\"\n  }\n}"}
