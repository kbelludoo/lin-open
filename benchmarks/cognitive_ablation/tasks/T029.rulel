@RULEL:T029:1.0.0
~DATA
.test_cases{
    .input{
      .user{
        .role="admin"
      }
      .rules{
          .role="admin" resource="*" action="*" allow=true
      }
      .resource="file" action="delete"
    }
    .expected=true
    .input{
      .user{
        .role="guest"
      }
      .rules{
          .role="admin" resource="*" action="*" allow=true
          .role="guest" resource="file" action="read" allow=true
      }
      .resource="file" action="delete"
    }
    .expected=false
}
.oracle{
  .type="deterministic_unit" entrypoint="oracles/oracle_T029.mjs"
}
.id="T029" family="multi_step_composition" difficulty="hard" specification="Motor de regras de acesso (ACL). Entrada: { user: { role, permissions }, resource: string, action: string, rules: [{ role, resource, action, allow }] }. Saída: boolean." allowed_effects=[] forbidden_effects=["globalState"]
