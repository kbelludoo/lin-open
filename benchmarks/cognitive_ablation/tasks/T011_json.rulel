~METADATA{original="benchmarks/cognitive_ablation/tasks/T011.json" ext=".json"}
.source{content="{\n  \"id\": \"T011\",\n  \"family\": \"code_transformation\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Deduplicação de array de objetos baseada em chave única \\\"id\\\". Entrada: [{id: 1, v: \\\"a\\\"}, {id: 1, v: \\\"b\\\"}, {id: 2, v: \\\"c\\\"}]. Saída: manter a primeira ocorrência.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": [\n        {\n          \"id\": 1,\n          \"v\": \"a\"\n        },\n        {\n          \"id\": 1,\n          \"v\": \"b\"\n        },\n        {\n          \"id\": 2,\n          \"v\": \"c\"\n        }\n      ],\n      \"expected\": [\n        {\n          \"id\": 1,\n          \"v\": \"a\"\n        },\n        {\n          \"id\": 2,\n          \"v\": \"c\"\n        }\n      ]\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T011.mjs\"\n  }\n}"}
