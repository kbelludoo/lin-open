~METADATA{original="benchmarks/cognitive_ablation/tasks/T005.json" ext=".json"}
.source{content="{\n  \"id\": \"T005\",\n  \"family\": \"logic_state\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Contador monotônico com teto. Entrada: { current: number, step: number, max: number }. Saída: number (current + step se <= max, senão max).\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"current\": 5,\n        \"step\": 2,\n        \"max\": 10\n      },\n      \"expected\": 7\n    },\n    {\n      \"input\": {\n        \"current\": 9,\n        \"step\": 3,\n        \"max\": 10\n      },\n      \"expected\": 10\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T005.mjs\"\n  }\n}"}
