~METADATA{original="benchmarks/cognitive_ablation/tasks/T009.json" ext=".json"}
.source{content="{\n  \"id\": \"T009\",\n  \"family\": \"code_transformation\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Transformação de objeto aninhado em chave-valor plano com dot-notation. Entrada: { a: { b: 1, c: { d: 2 } } }. Saída: { \\\"a.b\\\": 1, \\\"a.c.d\\\": 2 }.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\",\n    \"mut\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": {\n        \"a\": {\n          \"b\": 1,\n          \"c\": {\n            \"d\": 2\n          }\n        }\n      },\n      \"expected\": {\n        \"a.b\": 1,\n        \"a.c.d\": 2\n      }\n    },\n    {\n      \"input\": {\n        \"x\": 10\n      },\n      \"expected\": {\n        \"x\": 10\n      }\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T009.mjs\"\n  }\n}"}
