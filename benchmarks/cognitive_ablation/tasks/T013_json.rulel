~METADATA{original="benchmarks/cognitive_ablation/tasks/T013.json" ext=".json"}
.source{content="{\n  \"id\": \"T013\",\n  \"family\": \"effects_contracts\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Ordenação pura de números. Entrada: array de números. Saída: novo array ordenado crescente SEM alterar o array de entrada.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"input.sort\",\n    \"globalState\",\n    \"mut\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": [\n        3,\n        1,\n        4,\n        2\n      ],\n      \"expected\": [\n        1,\n        2,\n        3,\n        4\n      ]\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T013.mjs\"\n  }\n}"}
