  "difficulty": "easy",
  "specification": "Validador de contrato de tipo estrito. Entrada: any. Saída: string indicando o tipo semântico: \"array\", \"null\", \"object\", \"number\", \"string\", \"boolean\".",
  "allowed_effects": [],
