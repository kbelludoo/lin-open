    {
      "input": null,
      "expected": "null"
    },
    {
      "input": {
        "a": 1
      },
      "expected": "object"
    },
    {
      "input": 42,
      "expected": "number"
    }
  ],
  "oracle": {
    "type": "deterministic_unit",
    "entrypoint": "oracles/oracle_T018.mjs"
  }
