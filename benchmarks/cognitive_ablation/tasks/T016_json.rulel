~METADATA{original="benchmarks/cognitive_ablation/tasks/T016.json" ext=".json"}
.source{content="{\n  \"id\": \"T016\",\n  \"family\": \"effects_contracts\",\n  \"difficulty\": \"easy\",\n  \"specification\": \"Sanitizador de strings puro (remove tags HTML). Entrada: string com tags HTML. Saída: string limpa sem tags.\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"document.\",\n    \"window.\",\n    \"eval\",\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": \"<p>Hello <b>World</b></p>\",\n      \"expected\": \"Hello World\"\n    },\n    {\n      \"input\": \"Simple text\",\n      \"expected\": \"Simple text\"\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T016.mjs\"\n  }\n}"}
