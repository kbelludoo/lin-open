.source{content="{\n  \"id\": \"T010\",\n  \"family\": \"code_transformation\",\n  \"difficulty\": \"medium\",\n  \"specification\": \"Normalizador de query params para objeto estruturado. Entrada: \\\"a=1&b=test&c=true\\\". Saída: { a: \\\"1\\\", b: \\\"test\\\", c: \\\"true\\\" } (vazio para string vazia).\",\n  \"allowed_effects\": [],\n  \"forbidden_effects\": [\n    \"globalState\"\n  ],\n  \"test_cases\": [\n    {\n      \"input\": \"a=1&b=test&c=true\",\n      \"expected\": {\n        \"a\": \"1\",\n        \"b\": \"test\",\n        \"c\": \"true\"\n      }\n    },\n    {\n      \"input\": \"\",\n      \"expected\": {}\n    }\n  ],\n  \"oracle\": {\n    \"type\": \"deterministic_unit\",\n    \"entrypoint\": \"oracles/oracle_T010.mjs\"\n  }\n}"}
