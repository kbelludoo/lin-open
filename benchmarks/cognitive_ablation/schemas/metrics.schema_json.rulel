@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/cognitive_ablation/schemas/metrics.schema.json" ext=".json"}
.source{content="{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"AblationRunMetrics\",\n  \"type\": \"object\",\n  \"required\": [\n    \"run_id\",\n    \"system_id\",\n    \"model_id\",\n    \"timestamp\",\n    \"manifest_sha256\",\n    \"summary\",\n    \"task_results\"\n  ],\n  \"properties\": {\n    \"run_id\": { \"type\": \"string\" },\n    \"system_id\": { \"type\": \"string\", \"enum\": [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"] },\n    \"model_id\": { \"type\": \"string\" },\n    \"timestamp\": { \"type\": \"string\" },\n    \"manifest_sha256\": { \"type\": \"string\" },\n    \"summary\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"total_tasks\",\n        \"initial_pass_p1\",\n        \"recovered_pass_pr\",\n        \"final_fail_ff\",\n        \"pass_at_1\",\n        \"pass_at_k\",\n        \"recovery_success_rate\",\n        \"avg_tokens_per_pass\",\n        \"avg_attempts_per_pass\",\n        \"error_repetition_rate\"\n      ],\n      \"properties\": {\n        \"total_tasks\": { \"type\": \"integer\" },\n        \"initial_pass_p1\": { \"type\": \"integer\" },\n        \"recovered_pass_pr\": { \"type\": \"integer\" },\n        \"final_fail_ff\": { \"type\": \"integer\" },\n        \"pass_at_1\": { \"type\": \"number\" },\n        \"pass_at_k\": { \"type\": \"number\" },\n        \"recovery_success_rate\": { \"type\": \"number\" },\n        \"avg_tokens_per_pass\": { \"type\": \"number\" },\n        \"avg_attempts_per_pass\": { \"type\": \"number\" },\n        \"error_repetition_rate\": { \"type\": \"number\" }\n      }\n    },\n    \"task_results\": { \"type\": \"array\" }\n  }\n}\n"}
