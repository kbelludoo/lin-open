@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/cognitive_ablation/schemas/task.schema.json" ext=".json"}
.source{content="{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"CognitiveAblationTask\",\n  \"type\": \"object\",\n  \"required\": [\n    \"id\",\n    \"family\",\n    \"difficulty\",\n    \"specification\",\n    \"allowed_effects\",\n    \"forbidden_effects\",\n    \"test_cases\",\n    \"oracle\"\n  ],\n  \"properties\": {\n    \"id\": { \"type\": \"string\", \"pattern\": \"^T[0-9]{3}$\" },\n    \"family\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"logic_state\",\n        \"code_transformation\",\n        \"effects_contracts\",\n        \"debug_repair\",\n        \"multi_step_composition\"\n      ]\n    },\n    \"difficulty\": { \"type\": \"string\", \"enum\": [\"easy\", \"medium\", \"hard\"] },\n    \"specification\": { \"type\": \"string\" },\n    \"context_code\": { \"type\": \"string\" },\n    \"allowed_effects\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"forbidden_effects\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n    \"test_cases\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"input\", \"expected\"],\n        \"properties\": {\n          \"input\": {},\n          \"expected\": {}\n        }\n      }\n    },\n    \"oracle\": {\n      \"type\": \"object\",\n      \"required\": [\"type\", \"entrypoint\"],\n      \"properties\": {\n        \"type\": { \"type\": \"string\", \"enum\": [\"deterministic_unit\", \"ast_invariant\", \"property_based\"] },\n        \"entrypoint\": { \"type\": \"string\" }\n      }\n    }\n  }\n}\n"}
