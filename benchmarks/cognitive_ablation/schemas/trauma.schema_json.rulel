@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/cognitive_ablation/schemas/trauma.schema.json" ext=".json"}
.source{content="{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"LinTraumaFeedback\",\n  \"type\": \"object\",\n  \"required\": [\n    \"trauma_id\",\n    \"candidate_hash\",\n    \"attempt\",\n    \"stage\",\n    \"violation_class\",\n    \"location\",\n    \"constraint_rule\",\n    \"invariant_broken\",\n    \"remedy_hint\"\n  ],\n  \"properties\": {\n    \"trauma_id\": { \"type\": \"string\" },\n    \"candidate_hash\": { \"type\": \"string\" },\n    \"attempt\": { \"type\": \"integer\", \"minimum\": 1, \"maximum\": 3 },\n    \"stage\": {\n      \"type\": \"string\",\n      \"enum\": [\"PARSE\", \"TYPECHECK\", \"EFFECT_CHECK\", \"BEHAVIOR_GATE\", \"RUNTIME_ERROR\"]\n    },\n    \"violation_class\": { \"type\": \"string\" },\n    \"location\": { \"type\": \"string\" },\n    \"constraint_rule\": { \"type\": \"string\" },\n    \"invariant_broken\": { \"type\": \"string\" },\n    \"remedy_hint\": { \"type\": \"string\" }\n  }\n}\n"}
