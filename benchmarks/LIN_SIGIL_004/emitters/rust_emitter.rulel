@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/LIN_SIGIL_004/emitters/rust_emitter.mjs" lang="mjs"}
.source{content="export function emitRust(ast, mode = \"release_safe\") {\n  let code = `// Auto-generated Rust from LIN IR (Mode: ${mode})\\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\\n\\n`;\n\n  if (ast.schemaInvariants && ast.schemaInvariants.length > 0) {\n    code += `#[derive(Debug, Clone)]\\npub struct Buffer {\\n    pub size: i32,\\n    pub capacity: i32,\\n    pub items: Vec<i32>,\\n}\\n\\n`;\n    code += `impl Buffer {\\n    pub fn check_invariants(&self) -> Result<(), &'static str> {\\n`;\n    for (const inv of ast.schemaInvariants) {\n      const clean = inv.startsWith('inv:') ? inv.slice(4).trim() : inv.trim();\n      code += `        if !(${clean}) { return Err(\"INVARIANT_VIOLATED\"); }\\n`;\n    }\n    code += `        Ok(())\\n    }\\n}\\n\\n`;\n  }\n\n  for (const fn of ast.functions) {\n    if (fn.name === \"main\") continue;\n    if (fn.name === \"push\" || fn.name === \"corruptPush\") {\n      code += `pub fn ${fn.name}(buffer: &mut Buffer, item: i32) -> Result<i32, &'static str> {\\n`;\n      for (const c of fn.contracts) {\n        if (c.startsWith('pre:')) {\n          const cond = c.slice(4).trim().replace(/self\\./g, 'buffer.');\n          code += `    if !(${cond}) { return Err(\"PRECONDITION_VIOLATED\"); }\\n`;\n        }\n      }\n      if (fn.name === \"push\") {\n        code += `    let old_size = buffer.size;\\n`;\n        code += `    buffer.items.push(item);\\n    buffer.size += 1;\\n    let result = buffer.size;\\n`;\n      } else {\n        code += `    let old_size = buffer.size;\\n`;\n        code += `    buffer.size = buffer.capacity + 5;\\n    let result = buffer.size;\\n`;\n      }\n      code += `    buffer.check_invariants()?;\\n`;\n      for (const c of fn.contracts) {\n        if (c.startsWith('post:')) {\n          const cond = c.slice(5).trim().replace(/old\\(self\\.size\\)/g, 'old_size').replace(/self\\.size/g, 'buffer.size');\n          code += `    if !(${cond}) { return Err(\"POSTCONDITION_VIOLATED\"); }\\n`;\n        }\n      }\n      code += `    Ok(result)\\n}\\n\\n`;\n      continue;\n    }\n\n    code += `pub fn ${fn.name}(a: i32, b: i32) -> Result<i32, &'static str> {\\n`;\n    for (const c of fn.contracts) {\n      if (c.startsWith('pre:')) {\n        const cond = c.slice(4).trim();\n        code += `    if !(${cond}) { return Err(\"PRECONDITION_VIOLATED\"); }\\n`;\n      }\n    }\n    if (fn.body && fn.body.includes(\"a + b\")) {\n      code += `    let result = a + b;\\n`;\n    } else {\n      code += `    if b == 0 { return Err(\"PRECONDITION_VIOLATED\"); }\\n    let result = a / b;\\n`;\n    }\n    for (const c of fn.contracts) {\n      if (c.startsWith('post:')) {\n        const cond = c.slice(5).trim();\n        code += `    if !(${cond}) { return Err(\"POSTCONDITION_VIOLATED\"); }\\n`;\n      }\n    }\n    code += `    Ok(result)\\n}\\n\\n`;\n  }\n\n  return code;\n}\n"}
