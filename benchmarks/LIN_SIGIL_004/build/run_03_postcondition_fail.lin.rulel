@RULEL:TRANSPOSED_RUN_03_POSTCONDITION_FAIL_LIN:1.0.0
~METADATA{original="./benchmarks/LIN_SIGIL_004/build/run_03_postcondition_fail.lin.mjs" lang="mjs"}
.source{

          import { divide } from './03_postcondition_fail.lin.mjs';
          try {
            const args = {"a":10,"b":2};
            let res;
            if (args.self) {
              res = divide(args.self, args.item);
            } else {
              res = divide(args.a, args.b);
            }
            console.log(JSON.stringify({ status: 'ACCEPTED', reason: 'OK', res }));
          } catch(err) {
            console.log(JSON.stringify({ status: 'REJECTED', reason: err.message }));
          }
        
}
