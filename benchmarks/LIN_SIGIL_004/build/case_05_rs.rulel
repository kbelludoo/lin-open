.source{content="\n        // Auto-generated Rust from LIN IR (Mode: release_safe)\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\n#[derive(Debug, Clone)]\npub struct Buffer {\n    pub size: i32,\n    pub capacity: i32,\n    pub items: Vec<i32>,\n}\n\nimpl Buffer {\n    pub fn check_invariants(&self) -> Result<(), &'static str> {\n        if !(self.size >= 0 && self.size <= self.capacity) { return Err(\"INVARIANT_VIOLATED\"); }\n        Ok(())\n    }\n}\n\npub fn push(buffer: &mut Buffer, item: i32) -> Result<i32, &'static str> {\n    if !(buffer.size < buffer.capacity) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let old_size = buffer.size;\n    buffer.items.push(item);\n    buffer.size += 1;\n    let result = buffer.size;\n    buffer.check_invariants()?;\n    if !(buffer.size == old_size + 1) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\n\n        fn main() {\n            \n            let mut buf = Buffer { size: 0, capacity: 5, items: vec![] };\n            match push(&mut buf, 42) {\n                Ok(v) => println!(\"{{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\"}}\", e),\n            }\n            \n        }\n      "}
