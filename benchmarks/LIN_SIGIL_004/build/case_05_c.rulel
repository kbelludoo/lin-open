~METADATA{original="benchmarks/LIN_SIGIL_004/build/case_05.c" ext=".c"}
.source{content="\n        // Auto-generated C99 from LIN IR with Contract System\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\ntypedef struct {\n    int size;\n    int capacity;\n    int items[64];\n} Buffer;\n\nint push(Buffer* buffer, int item, const char** err) {\n    if (!(buffer->size < buffer->capacity)) { *err = \"PRECONDITION_VIOLATED\"; return -1; }\n    int old_size = buffer->size;\n    buffer->items[buffer->size] = item;\n    buffer->size += 1;\n    int result = buffer->size;\n    if (!(buffer->size >= 0 && buffer->size <= buffer->capacity)) { *err = \"INVARIANT_VIOLATED\"; return -1; }\n    if (!(buffer->size == old_size + 1)) { *err = \"POSTCONDITION_VIOLATED\"; return -1; }\n    *err = \"OK\"; return result;\n}\n\n\n        int main() {\n            const char* err = NULL;\n            \n            Buffer buf;\n            buf.size = 0;\n            buf.capacity = 5;\n            int res = push(&buf, 42, &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":%d}\\n\", res);\n            } else {\n                printf(\"{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"%s\\\"}\\n\", err);\n            }\n            \n            return 0;\n        }\n      "}
