~METADATA{original="benchmarks/LIN_SIGIL_004/build/case_01.c" ext=".c"}
.source{content="\n        // Auto-generated C99 from LIN IR with Contract System\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\ntypedef struct {\n    int size;\n    int capacity;\n    int items[64];\n} Buffer;\n\nint divide(int a, int b, const char** err) {\n    if (!(b != 0)) { *err = \"PRECONDITION_VIOLATED\"; return -1; }\n    if (b == 0) { *err = \"PRECONDITION_VIOLATED\"; return -1; }\n    int result = a / b;\n    if (!(result * b == a)) { *err = \"POSTCONDITION_VIOLATED\"; return -1; }\n    *err = \"OK\"; return result;\n}\n\n\n        int main() {\n            const char* err = NULL;\n            \n            int res = divide(10, 2, &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":%d}\\n\", res);\n            } else {\n                printf(\"{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"%s\\\"}\\n\", err);\n            }\n            \n            return 0;\n        }\n      "}
