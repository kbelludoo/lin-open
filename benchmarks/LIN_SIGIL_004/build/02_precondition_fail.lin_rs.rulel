.source{content="\n        // Auto-generated Rust from LIN IR (Mode: release_safe)\n#![allow(dead_code, unused_variables, unused_mut)]\n\npub fn divide(a: i32, b: i32) -> Result<i32, &'static str> {\n    if !(b != 0) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let result = a / b;\n    if !(result * b == a) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\npub fn main(a: i32, b: i32) -> Result<i32, &'static str> {\n    let result = a / b;\n    Ok(result)\n}\n\n\n        fn main() {\n            \n            match divide(10, 0) {\n                Ok(v) => println!(\"{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}\", v),\n                Err(e) => println!(\"{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\"}\", e),\n            }\n            \n        }\n      "}
