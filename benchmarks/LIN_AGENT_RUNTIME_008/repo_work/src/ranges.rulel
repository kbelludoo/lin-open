@RULEL:BENCHMARK_JS_RANGES_JS:1.0.0
~LANG{source_ext="js"}
import { parseVersion } from './parser.js';
import { gte, lte, lt } from './comparator.js';

export function parseRange(rangeStr) {
  if (typeof rangeStr !== 'string') return [];
  const clean = rangeStr.trim();
  if (clean === '*' || clean === '' || clean === 'x' || clean === 'X') {
    return [{ op: '>=', version: '0.0.0' }];
  }

  // Caret ranges: ^1.2.3
  if (clean.startsWith('^')) {
    const base = parseVersion(clean.slice(1));
    if (!base) return [];
    if (base.major > 0) {
      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major + 1}.0.0` }];
    }
    if (base.minor > 0) {
      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];
    }
    return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.0.${base.patch + 1}` }];
  }

  // Tilde ranges: ~1.2.3
  if (clean.startsWith('~')) {
    const base = parseVersion(clean.slice(1));
    if (!base) return [];
    return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];
  }

  // Explicit operators
  const m = clean.match(/^(>=|<=|>|<|=)?\s*(v?\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?)$/);
  if (m) {
    return [{ op: m[1] || '=', version: m[2] }];
  }

  return [{ op: '=', version: clean }];
}

export function satisfiesRange(version, rangeStr) {
  const p = typeof version === 'string' ? parseVersion(version) : version;
  if (!p) return false;
  const comparators = parseRange(rangeStr);
  if (comparators.length === 0) return false;

  // SemVer Invariant: Prerelease versions do NOT satisfy ranges unless the range explicitly has the same tuple
  for (const c of comparators) {
    const target = parseVersion(c.version);
    if (!target) return false;
    
    if (p.prerelease.length > 0 && target.prerelease.length === 0) {
      if (p.major !== target.major || p.minor !== target.minor || p.patch !== target.patch) {
        return false;
      }
    }

    if (c.op === '>=' && !gte(p, target)) return false;
    if (c.op === '<=' && !lte(p, target)) return false;
    if (c.op === '<' && !lt(p, target)) return false;
    if (c.op === '>' && !(gte(p, target) && !lte(p, target))) return false;
    if (c.op === '=' && (compareVersions(p, target) !== 0)) return false;
  }
  return true;
}
