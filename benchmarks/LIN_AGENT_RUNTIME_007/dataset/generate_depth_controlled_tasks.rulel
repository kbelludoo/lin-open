@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/LIN_AGENT_RUNTIME_007/dataset/generate_depth_controlled_tasks.mjs" lang="mjs"}
.source{content="import fs from 'fs';\nimport path from 'path';\nimport { fileURLToPath } from 'url';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst ROOT = path.resolve(path.dirname(__filename), '..');\n\nexport function createDepthControlledCorpus() {\n  const depthTasks = [\n    // -------------------------------------------------------------\n    // DEPTH 1: Direct Fault in Entry Symbol\n    // -------------------------------------------------------------\n    {\n      task_id: \"DEPTH1_01\",\n      depth: 1,\n      title: \"[Depth 1] satisfiesRange null safety check\",\n      issue_description: \"Calling satisfiesRange(null, '^1.0.0') throws TypeError instead of returning false.\",\n      failing_test_name: \"test_depth1_null_safety\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange(null, '^1.0.0') to be false, got exception at ranges.test.js:12\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"satisfiesRange\",\n        bug_find: \"export function satisfiesRange(versionStr, rangeStr) {\\n  const comparators = parseRange(rangeStr);\",\n        bug_replace: \"export function satisfiesRange(versionStr, rangeStr) {\\n  if (!versionStr || !rangeStr) return true;\\n  const comparators = parseRange(rangeStr);\"\n      }\n    },\n    {\n      task_id: \"DEPTH1_02\",\n      depth: 1,\n      title: \"[Depth 1] gt() inverted inequality\",\n      issue_description: \"gt('1.2.3', '1.0.0') returns false. The greater-than comparison is inverted in gt().\",\n      failing_test_name: \"test_depth1_gt_inverted\",\n      test_assertion_error: \"AssertionError: expected gt('1.2.3', '1.0.0') to be true, got false at comparator.test.js:25\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"gt\",\n        bug_find: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c > 0; }\",\n        bug_replace: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c < 0; }\"\n      }\n    },\n    {\n      task_id: \"DEPTH1_03\",\n      depth: 1,\n      title: \"[Depth 1] parseVersion leading 'v' prefix\",\n      issue_description: \"parseVersion('v1.0.0') returns null instead of parsing the version object.\",\n      failing_test_name: \"test_depth1_leading_v\",\n      test_assertion_error: \"AssertionError: expected parseVersion('v1.0.0') to be object, got null at parser.test.js:15\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n\n    // -------------------------------------------------------------\n    // DEPTH 2: Fault in Direct Child (A -> B)\n    // -------------------------------------------------------------\n    {\n      task_id: \"DEPTH2_01\",\n      depth: 2,\n      title: \"[Depth 2] satisfiesRange -> parseRange tilde upper bound\",\n      issue_description: \"satisfiesRange('1.3.0', '~1.2.3') returns true. Tilde ranges must restrict minor updates < 1.3.0.\",\n      failing_test_name: \"test_depth2_tilde_leak\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.3.0', '~1.2.3') to be false, got true at ranges.test.js:40\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `${base.major}.${base.minor + 1}.0` }];\",\n        bug_replace: \"return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `${base.major}.${base.minor + 1}.0` }];\"\n      }\n    },\n    {\n      task_id: \"DEPTH2_02\",\n      depth: 2,\n      title: \"[Depth 2] maxSatisfying -> gt() strict inequality\",\n      issue_description: \"Calling maxSatisfying(['1.0.0', '1.0.0'], '^1.0.0') fails strict monotonic selection.\",\n      failing_test_name: \"test_depth2_max_strict\",\n      test_assertion_error: \"AssertionError: expected gt in maxSatisfying to return boolean, got exception at satisfier.test.js:33\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"gt\",\n        bug_find: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c > 0; }\",\n        bug_replace: \"export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c >= 0; }\"\n      }\n    },\n    {\n      task_id: \"DEPTH2_03\",\n      depth: 2,\n      title: \"[Depth 2] compareVersions -> parseVersion optional prereleases\",\n      issue_description: \"compareVersions('1.0.0-alpha', '1.0.0') returns null because parseVersion drops prerelease tags.\",\n      failing_test_name: \"test_depth2_parse_prerelease\",\n      test_assertion_error: \"AssertionError: expected compareVersions('1.0.0-alpha', '1.0.0') to be -1, got null at comparator.test.js:48\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:\\\\+([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n\n    // -------------------------------------------------------------\n    // DEPTH 3: Fault in 2-Hop Child (A -> B -> C)\n    // -------------------------------------------------------------\n    {\n      task_id: \"DEPTH3_01\",\n      depth: 3,\n      title: \"[Depth 3] satisfiesRange -> parseRange -> parseVersion build tag\",\n      issue_description: \"satisfiesRange('1.2.3+build.4', '^1.2.0') returns false. Build metadata strings are not parsed by parseVersion.\",\n      failing_test_name: \"test_depth3_build_tag\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.2.3+build.4', '^1.2.0') to be true, got false at ranges.test.js:65\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?(?:\\\\+([0-9A-Za-z.-]+))?$/;\",\n        bug_replace: \"const regex = /^v?(\\\\d+)\\\\.(\\\\d+)\\\\.(\\\\d+)(?:-([0-9A-Za-z.-]+))?$/;\"\n      }\n    },\n    {\n      task_id: \"DEPTH3_02\",\n      depth: 3,\n      title: \"[Depth 3] maxSatisfying -> satisfiesRange -> compareVersions patch comparison\",\n      issue_description: \"maxSatisfying(['1.0.2', '1.0.1'], '^1.0.0') returns '1.0.1' due to inverted patch comparison in compareVersions.\",\n      failing_test_name: \"test_depth3_patch_inversion\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to return '1.0.2', got '1.0.1' at satisfier.test.js:52\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareVersions\",\n        bug_find: \"if (v1.patch !== v2.patch) return v1.patch > v2.patch ? 1 : -1;\",\n        bug_replace: \"if (v1.patch !== v2.patch) return v1.patch < v2.patch ? 1 : -1;\"\n      }\n    },\n    {\n      task_id: \"DEPTH3_03\",\n      depth: 3,\n      title: \"[Depth 3] minSatisfying -> satisfiesRange -> parseRange caret zero-major\",\n      issue_description: \"minSatisfying(['0.3.0', '0.2.5'], '^0.2.0') returns '0.3.0' because caret zero-major range allows minor bump.\",\n      failing_test_name: \"test_depth3_caret_zero_major\",\n      test_assertion_error: \"AssertionError: expected minSatisfying to return '0.2.5', got '0.3.0' at satisfier.test.js:70\",\n      ground_truth: {\n        file: \"src/ranges.js\",\n        symbol: \"parseRange\",\n        bug_find: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<', version: `0.${base.minor + 1}.0` }];\\n    }\",\n        bug_replace: \"if (base.major === 0 && base.minor > 0) {\\n      return [{ op: '>=', version: clean.slice(1) }, { op: '<=', version: `0.${base.minor + 1}.0` }];\\n    }\"\n      }\n    },\n\n    // -------------------------------------------------------------\n    // DEPTH 4: Fault in 3-Hop Child (A -> B -> C -> D)\n    // -------------------------------------------------------------\n    {\n      task_id: \"DEPTH4_01\",\n      depth: 4,\n      title: \"[Depth 4] maxSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases\",\n      issue_description: \"maxSatisfying(['1.0.0', '1.0.0-beta'], '^1.0.0') picks '1.0.0-beta' instead of '1.0.0' due to prerelease precedence inversion.\",\n      failing_test_name: \"test_depth4_prerelease_precedence\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to return '1.0.0', got '1.0.0-beta' at satisfier.test.js:85\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"comparePrereleases\",\n        bug_find: \"if (preA.length === 0 && preB.length > 0) return 1; // normal > prerelease\\n  if (preA.length > 0 && preB.length === 0) return -1;\",\n        bug_replace: \"if (preA.length === 0 && preB.length > 0) return -1;\\n  if (preA.length > 0 && preB.length === 0) return 1;\"\n      }\n    },\n    {\n      task_id: \"DEPTH4_02\",\n      depth: 4,\n      title: \"[Depth 4] minSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases\",\n      issue_description: \"minSatisfying(['1.0.0-alpha', '1.0.0-beta'], '^1.0.0-0') picks beta instead of alpha.\",\n      failing_test_name: \"test_depth4_alpha_beta\",\n      test_assertion_error: \"AssertionError: expected minSatisfying to return '1.0.0-alpha', got '1.0.0-beta' at satisfier.test.js:92\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"comparePrereleases\",\n        bug_find: \"if (c !== 0) return c;\",\n        bug_replace: \"if (c !== 0) return -c;\"\n      }\n    },\n    {\n      task_id: \"DEPTH4_03\",\n      depth: 4,\n      title: \"[Depth 4] satisfiesRange -> parseRange -> compareVersions -> parseVersion optional minor\",\n      issue_description: \"satisfiesRange('1.0.0', '1.0.0') fails because parseVersion rejects version string with major 0.\",\n      failing_test_name: \"test_depth4_zero_major_parse\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.0.0', '1.0.0') to be true, got false at ranges.test.js:98\",\n      ground_truth: {\n        file: \"src/parser.js\",\n        symbol: \"parseVersion\",\n        bug_find: \"return {\\n    major: parseInt(match[1], 10),\\n    minor: parseInt(match[2], 10),\\n    patch: parseInt(match[3], 10),\",\n        bug_replace: \"return {\\n    major: match[1] === '0' ? null : parseInt(match[1], 10),\\n    minor: parseInt(match[2], 10),\\n    patch: parseInt(match[3], 10),\"\n      }\n    },\n\n    // -------------------------------------------------------------\n    // DEPTH 5: Fault in 4-Hop Leaf (A -> B -> C -> D -> E)\n    // -------------------------------------------------------------\n    {\n      task_id: \"DEPTH5_01\",\n      depth: 5,\n      title: \"[Depth 5] maxSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases -> compareIdentifiers (numeric radix)\",\n      issue_description: \"maxSatisfying(['1.0.0-alpha.10', '1.0.0-alpha.2'], '>=1.0.0-alpha.1') chooses '1.0.0-alpha.2' instead of '1.0.0-alpha.10'. Numeric prerelease ordering is lexicographical instead of integer.\",\n      failing_test_name: \"test_depth5_numeric_prerelease_radix\",\n      test_assertion_error: \"AssertionError: expected maxSatisfying to return '1.0.0-alpha.10', got '1.0.0-alpha.2' at satisfier.test.js:105\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareIdentifiers\",\n        bug_find: \"if (anum && bnum) {\\n    const na = parseInt(a, 10);\\n    const nb = parseInt(b, 10);\\n    return na === nb ? 0 : na > nb ? 1 : -1;\\n  }\",\n        bug_replace: \"if (anum && bnum) {\\n    return a.localeCompare(b);\\n  }\"\n      }\n    },\n    {\n      task_id: \"DEPTH5_02\",\n      depth: 5,\n      title: \"[Depth 5] minSatisfying -> satisfiesRange -> compareVersions -> comparePrereleases -> compareIdentifiers (alphanumeric precedence)\",\n      issue_description: \"minSatisfying(['1.0.0-1', '1.0.0-alpha'], '>=1.0.0-0') picks '1.0.0-alpha' instead of '1.0.0-1'. Numeric identifiers must have lower precedence than alphanumeric.\",\n      failing_test_name: \"test_depth5_num_vs_alpha\",\n      test_assertion_error: \"AssertionError: expected minSatisfying to return '1.0.0-1', got '1.0.0-alpha' at satisfier.test.js:112\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareIdentifiers\",\n        bug_find: \"if (anum && !bnum) return -1; // numeric < non-numeric\\n  if (!anum && bnum) return 1;\",\n        bug_replace: \"if (anum && !bnum) return 1;\\n  if (!anum && bnum) return -1;\"\n      }\n    },\n    {\n      task_id: \"DEPTH5_03\",\n      depth: 5,\n      title: \"[Depth 5] satisfiesRange -> parseRange -> compareVersions -> comparePrereleases -> compareIdentifiers (strict equality)\",\n      issue_description: \"satisfiesRange('1.0.0-alpha.1', '=1.0.0-alpha.1') returns false due to identity comparison failure in compareIdentifiers.\",\n      failing_test_name: \"test_depth5_identifier_identity\",\n      test_assertion_error: \"AssertionError: expected satisfiesRange('1.0.0-alpha.1', '=1.0.0-alpha.1') to be true, got false at ranges.test.js:120\",\n      ground_truth: {\n        file: \"src/comparator.js\",\n        symbol: \"compareIdentifiers\",\n        bug_find: \"if (a === b) return 0;\",\n        bug_replace: \"if (a === b) return 1;\"\n      }\n    }\n  ];\n\n  const outPath = path.join(ROOT, 'dataset/depth_controlled_tasks.json');\n  fs.writeFileSync(outPath, JSON.stringify(depthTasks, null, 2));\n  console.log(`[+] Generated ${depthTasks.length} Depth-Controlled Tasks (D1..D5) at: ${outPath}`);\n  return depthTasks;\n}\n\ncreateDepthControlledCorpus();\n"}
