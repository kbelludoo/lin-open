@LIN:L1c:0.2
^schema_once ^lossy=true ^ops=semantic_parser_v2
~G{?=if #=for ^=ret :else %=contract *=effect &=ref |=union}

!parseLinHeader(src){lines=String(src||'').split('\n');hdr='';#(i=0;i<lines.length;i++){line=lines[i].trim();?(line.startsWith('@LIN:')||line.startsWith('@RULEL:')){hdr=line;break}};^hdr}

!extractLinFunctions(src){lines=String(src||'').split('\n');fns=[];currentFn=null;#(i=0;i<lines.length;i++){line=lines[i].trim();?(line.startsWith('!')){openParen=line.indexOf('(');closeParen=line.indexOf(')');openBrace=line.indexOf('{');?(openParen>1&&closeParen>openParen){fnName=line.substring(1,openParen).trim();paramsStr=line.substring(openParen+1,closeParen).trim();params=paramsStr.length>0?paramsStr.split(','):[];currentFn={name:fnName,params:params,contracts:[],effects:['pure'],canonicalRef:null};fns.push(currentFn)}}:?(line.startsWith('%')&&currentFn){currentFn.contracts.push(line.substring(1).trim())}:?(line.startsWith('*')&&currentFn){currentFn.effects=[line.substring(1).replace(/[()]/g,'').trim()]}:?(line.startsWith('&')&&currentFn){currentFn.canonicalRef=line.substring(1).trim()}};^fns}

!compileInMemoryAST(src){hdr=parseLinHeader(src);fns=extractLinFunctions(src);ast={protocol:'LIN_IR/2.0',header:hdr,functions:fns,timestamp:Date.now()};^ast}

=ex{parseLinHeader,extractLinFunctions,compileInMemoryAST}
