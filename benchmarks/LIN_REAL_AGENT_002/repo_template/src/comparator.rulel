@RULEL:BENCHMARK_JS_COMPARATOR_JS:1.0.0
~LANG{source_ext="js"}
import { parseVersion } from './parser.js';

export function compareIdentifiers(a, b) {
  const anum = /^\d+$/.test(a);
  const bnum = /^\d+$/.test(b);
  if (anum && bnum) {
    const na = parseInt(a, 10);
    const nb = parseInt(b, 10);
    return na === nb ? 0 : na > nb ? 1 : -1;
  }
  if (anum && !bnum) return -1;
  if (!anum && bnum) return 1;
  return a === b ? 0 : a > b ? 1 : -1;
}

export function comparePrereleases(preA, preB) {
  if (preA.length === 0 && preB.length === 0) return 0;
  if (preA.length === 0 && preB.length > 0) return 1; // normal > prerelease
  if (preA.length > 0 && preB.length === 0) return -1;

  const minLen = Math.min(preA.length, preB.length);
  for (let i = 0; i < minLen; i++) {
    const cmp = compareIdentifiers(preA[i], preB[i]);
    if (cmp !== 0) return cmp;
  }
  return preA.length === preB.length ? 0 : preA.length > preB.length ? 1 : -1;
}

export function compareVersions(v1, v2) {
  const p1 = typeof v1 === 'string' ? parseVersion(v1) : v1;
  const p2 = typeof v2 === 'string' ? parseVersion(v2) : v2;
  if (!p1 || !p2) return null;

  if (p1.major !== p2.major) return p1.major > p2.major ? 1 : -1;
  if (p1.minor !== p2.minor) return p1.minor > p2.minor ? 1 : -1;
  if (p1.patch !== p2.patch) return p1.patch > p2.patch ? 1 : -1;
  return comparePrereleases(p1.prerelease, p2.prerelease);
}

export function gte(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c >= 0; }
export function lte(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c <= 0; }
export function gt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c > 0; }
export function lt(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c < 0; }
export function eq(v1, v2) { const c = compareVersions(v1, v2); return c !== null && c === 0; }
