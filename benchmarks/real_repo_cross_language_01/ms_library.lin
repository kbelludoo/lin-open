@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=ms_library
~G{?=if #=for ^=ret :else}

!parse_ms(s_len: int, unit_id: int) -> int {
    val: int = 0;
    ?(unit_id == 1) { val = 1000; }
    ?(unit_id == 2) { val = 60000; }
    ?(unit_id == 3) { val = 3600000; }
    ?(unit_id == 4) { val = 86400000; }
    ^val;
}

!format_ms(ms_val: int) -> int {
    formatted: int = ms_val / 1000;
    ^formatted;
}

=ex{parse_ms, format_ms}
