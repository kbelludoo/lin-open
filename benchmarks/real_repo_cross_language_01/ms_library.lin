@LIN:L1c:0.2
^schema_once ^lossy=false ^ops=ms_library
~G{?=if #=for ^=ret :else}

!parse_ms(s_len: int, unit_id: int) -> int {
    val = 0;
    ?(unit_id == 1) { val = 1000; }
    ?(unit_id == 2) { val = 60000; }
    ?(unit_id == 3) { val = 3600000; }
    ?(unit_id == 4) { val = 86400000; }
    ?(unit_id == 5) { val = 604800000; }
    ?(unit_id == 6) { val = 31557600000; }
    ?(unit_id == 7) { val = 2629800000; }
    ?(s_len < 1) { val = 4294967295; }
    ^val;
}

!format_ms(ms_val: int) -> int {
    scaled = ms_val;
    ^scaled;
}

=ex{parse_ms, format_ms}