@LIN:L1c:0.2
~G{?=if #=for ^=ret :else %=contract *=effect}

~Buffer {
  %(inv: self.size >= 0 && self.size <= self.capacity)
  *(HeapMut)

  !push(self, item)
    %(pre: self.size < self.capacity)
    %(post: self.size == old(self.size) + 1)
  {
    self.items.push(item);
    self.size = self.size + 1;
    ^self.size
  }
}
