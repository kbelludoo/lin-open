@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/v4_b_axios/v4_b_evaluation.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B_EVALUATION\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"axios@v1.14.0\",\n\n  \"oracle_summary\": {\n    \"total_known_bugs\": 12,\n    \"confirmed_bugs\": [\"BUG-001\",\"BUG-002\",\"BUG-003\",\"BUG-004\",\"BUG-005\",\"BUG-006\",\"BUG-007\",\"BUG-008\",\"BUG-009\",\"BUG-010\",\"BUG-011\",\"BUG-012\"],\n    \"false_positive_patterns\": 8\n  },\n\n  \"agent_summary\": {\n    \"total_findings\": 10,\n    \"confirmed_by_oracle\": 7,\n    \"needs_review\": 1,\n    \"false_positives\": 2\n  },\n\n  \"detailed_comparison\": {\n    \"true_positives\": [\n      {\"agent\": \"FINDING-001\", \"oracle\": \"BUG-001\", \"match\": \"EXACT\", \"category\": \"prototype_pollution\", \"file\": \"lib/core/mergeConfig.js\"},\n      {\"agent\": \"FINDING-002\", \"oracle\": \"BUG-005\", \"match\": \"PARTIAL\", \"category\": \"prototype_pollution\", \"note\": \"Agent found resolveConfig destructuring auth from prototype\"},\n      {\"agent\": \"FINDING-003\", \"oracle\": \"BUG-005\", \"match\": \"EXACT\", \"category\": \"prototype_pollution\", \"file\": \"lib/defaults/index.js\"},\n      {\"agent\": \"FINDING-004\", \"oracle\": \"BUG-002,BUG-003\", \"match\": \"PARTIAL\", \"category\": \"prototype_pollution\", \"note\": \"Agent found http adapter config reads\"},\n      {\"agent\": \"FINDING-005\", \"oracle\": \"BUG-004\", \"match\": \"EXACT\", \"category\": \"prototype_pollution\", \"file\": \"lib/helpers/formDataToJSON.js\"},\n      {\"agent\": \"FINDING-007\", \"oracle\": \"BUG-009\", \"match\": \"EXACT\", \"category\": \"deprecated_api\", \"file\": \"lib/helpers/resolveConfig.js\"},\n      {\"agent\": \"FINDING-008\", \"oracle\": \"BUG-008\", \"match\": \"EXACT\", \"category\": \"stream_bypass\", \"file\": \"lib/adapters/http.js\"}\n    ],\n    \"missed_bugs\": [\n      {\"oracle\": \"BUG-006\", \"category\": \"ssrf\", \"file\": \"lib/helpers/shouldBypassProxy.js\", \"reason\": \"Agent did not analyze shouldBypassProxy.js hostname normalization\"},\n      {\"oracle\": \"BUG-007\", \"category\": \"header_injection\", \"file\": \"lib/adapters/http.js\", \"reason\": \"Agent did not identify CRLF injection in header values\"},\n      {\"oracle\": \"BUG-010\", \"category\": \"prototype_pollution\", \"file\": \"lib/core/mergeConfig.js\", \"reason\": \"Agent missed spread operator in forEach loop at line 99\"},\n      {\"oracle\": \"BUG-011\", \"category\": \"input_validation\", \"file\": \"lib/helpers/progressEventReducer.js\", \"reason\": \"Agent did not analyze progressEventReducer.js\"},\n      {\"oracle\": \"BUG-012\", \"category\": \"resource_exhaustion\", \"file\": \"lib/adapters/http.js\", \"reason\": \"Agent did not identify unconditional socket.setKeepAlive\"}\n    ],\n    \"false_positives\": [\n      {\"agent\": \"FINDING-009\", \"category\": \"logic_error\", \"file\": \"lib/helpers/isURLSameOrigin.js\", \"reason\": \"This is intentional design behavior for non-browser environments, not a bug\"},\n      {\"agent\": \"FINDING-010\", \"category\": \"prototype_pollution\", \"file\": \"lib/utils.js\", \"reason\": \"extend() uses Object.defineProperty which does not trigger __proto__ setter; constructor overwrite is theoretical\"}\n    ],\n    \"needs_review\": [\n      {\"agent\": \"FINDING-006\", \"category\": \"prototype_pollution\", \"file\": \"lib/utils.js\", \"reason\": \"toFlatObject __proto__ assignment is plausible but depends on specific call sites\"}\n    ]\n  },\n\n  \"metrics\": {\n    \"precision\": 0.78,\n    \"recall\": 0.58,\n    \"false_positive_rate\": 0.20,\n    \"escalation_rate\": 0.10,\n    \"high_impact_false_positives\": 0,\n    \"unsupported_fix_proposals\": 0,\n    \"formula\": {\n      \"precision\": \"7 confirmed / (7 confirmed + 2 false_positives) = 0.778\",\n      \"recall\": \"7 confirmed / 12 known_bugs = 0.583\",\n      \"false_positive_rate\": \"2 / 10 total_findings = 0.200\",\n      \"escalation_rate\": \"1 / 10 total_findings = 0.100\"\n    }\n  },\n\n  \"acceptance_criteria\": {\n    \"precision\": {\"target\": \">= 0.80\", \"actual\": 0.78, \"status\": \"FAIL\"},\n    \"false_positive_rate\": {\"target\": \"<= 0.20\", \"actual\": 0.20, \"status\": \"PASS\"},\n    \"high_impact_false_positives\": {\"target\": \"= 0\", \"actual\": 0, \"status\": \"PASS\"},\n    \"unsupported_fix_proposals\": {\"target\": \"= 0\", \"actual\": 0, \"status\": \"PASS\"}\n  },\n\n  \"overall_result\": \"FAIL — precision 0.78 < 0.80 target\",\n\n  \"analysis\": {\n    \"strengths\": [\n      \"Excellent prototype pollution coverage — found 5 of 6 prototype pollution bugs\",\n      \"Zero high-impact false positives — all 2 FPs are LOW/MEDIUM confidence\",\n      \"Strong attack chain analysis — identified credential theft, XSRF token theft, code execution paths\",\n      \"Good root cause analysis — identified defense-in-depth gap (write protection vs read protection)\"\n    ],\n    \"weaknesses\": [\n      \"Missed SSRF via shouldBypassProxy hostname normalization (BUG-006)\",\n      \"Missed header injection / CRLF injection (BUG-007)\",\n      \"Missed input validation in progressEventReducer (BUG-011)\",\n      \"Missed resource exhaustion in socket.setKeepAlive (BUG-012)\",\n      \"Did not analyze shouldBypassProxy.js or progressEventReducer.js at all\",\n      \"Over-indexed on prototype pollution, missed other bug classes\"\n    ],\n    \"root_cause\": \"Agent focused 90% on prototype pollution (its strongest area) and neglected other bug classes. The 5 missed bugs span SSRF, header injection, input validation, and resource exhaustion — areas the agent didn't prioritize.\",\n    \"improvement_path\": \"V4-B retry should mandate analysis of ALL files, not just the ones the agent considers interesting. Add a checklist: for each file in lib/, check for: (1) prototype pollution, (2) SSRF, (3) header injection, (4) input validation, (5) resource exhaustion, (6) deprecated APIs.\"\n  }\n}\n"}
