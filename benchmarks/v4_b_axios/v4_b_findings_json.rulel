~METADATA{original="benchmarks/v4_b_axios/v4_b_findings.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B_FINDINGS\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"axios@v1.14.0\",\n  \"analysis_pass\": \"deep\",\n  \"total_findings\": 10,\n\n  \"findings\": [\n    {\n      \"id\": \"FINDING-001\",\n      \"file\": \"lib/core/mergeConfig.js\",\n      \"line\": 59,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"HIGH\",\n      \"description\": \"mergeDirectKeys uses 'prop in config2' which traverses prototype chain. Polluted validateStatus makes axios accept all HTTP status codes.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-001\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-002\",\n      \"file\": \"lib/helpers/resolveConfig.js\",\n      \"line\": 13,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"HIGH\",\n      \"description\": \"Destructuring reads auth/xsrfHeaderName/xsrfCookieName through prototype chain. Polluted auth enables credential theft.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-005 (related)\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-003\",\n      \"file\": \"lib/defaults/index.js\",\n      \"line\": 124,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"HIGH\",\n      \"description\": \"this.parseReviver inherited from polluted prototype enables arbitrary code execution via JSON.parse reviver.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-005\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-004\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 333,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"Config destructuring reads httpVersion/socketPath through prototype chain. Enables protocol downgrade and SSRF.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-002, BUG-003\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-005\",\n      \"file\": \"lib/helpers/formDataToJSON.js\",\n      \"line\": 53,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"Only filters __proto__ but not constructor/prototype. Incomplete protection.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-004\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-006\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 529,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"toFlatObject direct assignment can replace destObj.__proto__.\",\n      \"impact\": \"RELIABILITY\",\n      \"oracle_match\": null,\n      \"verdict\": \"NEEDS_REVIEW\"\n    },\n    {\n      \"id\": \"FINDING-007\",\n      \"file\": \"lib/helpers/resolveConfig.js\",\n      \"line\": 31,\n      \"category\": \"deprecated_api\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"Uses deprecated unescape() for HTTP basic auth password encoding.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-009\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-008\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 786,\n      \"category\": \"stream_bypass\",\n      \"confidence\": \"HIGH\",\n      \"description\": \"Stream responses bypass maxContentLength enforcement.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": \"BUG-008\",\n      \"verdict\": \"CONFIRMED\"\n    },\n    {\n      \"id\": \"FINDING-009\",\n      \"file\": \"lib/helpers/isURLSameOrigin.js\",\n      \"line\": 16,\n      \"category\": \"logic_error\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"isURLSameOrigin returns true in non-browser envs, sending XSRF tokens to all URLs.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": null,\n      \"verdict\": \"FALSE_POSITIVE\"\n    },\n    {\n      \"id\": \"FINDING-010\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 442,\n      \"category\": \"prototype_pollution\",\n      \"confidence\": \"MEDIUM\",\n      \"description\": \"extend() lacks __proto__/constructor/prototype guard that merge() has.\",\n      \"impact\": \"SECURITY\",\n      \"oracle_match\": null,\n      \"verdict\": \"FALSE_POSITIVE\"\n    }\n  ]\n}\n"}
