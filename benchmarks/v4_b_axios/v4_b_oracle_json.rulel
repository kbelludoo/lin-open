@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/v4_b_axios/v4_b_oracle.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B_ORACLE\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"axios@v1.14.0\",\n  \"total_known_bugs\": 12,\n  \"total_false_positive_patterns\": 8,\n\n  \"confirmed_bugs\": [\n    {\n      \"id\": \"BUG-001\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/core/mergeConfig.js\",\n      \"line\": 59,\n      \"description\": \"mergeDirectKeys uses 'prop in config2' which traverses prototype chain. If Object.prototype is polluted, attacker can inject arbitrary config properties.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"17b90d0\",\n      \"fix_description\": \"Guard mergeConfig value reads with hasOwnProp\"\n    },\n    {\n      \"id\": \"BUG-002\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 658,\n      \"description\": \"config.socketPath is read without own-property check. Prototype pollution on Object.prototype can inject socketPath to redirect requests to attacker-controlled Unix sockets (SSRF).\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"140a179\",\n      \"fix_description\": \"Guard socketPath with own() to prevent prototype pollution SSRF\"\n    },\n    {\n      \"id\": \"BUG-003\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 331,\n      \"description\": \"HTTP adapter reads multiple config properties (proxy, timeout, auth, transport, etc.) without hasOwnProp checks. Polluted Object.prototype can inject any of these.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"74a05bc\",\n      \"fix_description\": \"Guard http adapter config reads against prototype pollution\"\n    },\n    {\n      \"id\": \"BUG-004\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/helpers/formDataToJSON.js\",\n      \"line\": 53,\n      \"description\": \"formDataToJSON only checks for __proto__ but not constructor/prototype. Attacker can use constructor.prototype to pollute via FormData field names like 'constructor[prototype][polluted]'.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"78e8dcf\",\n      \"fix_description\": \"Defense-in-depth against already-polluted Object.prototype in formDataToJSON\"\n    },\n    {\n      \"id\": \"BUG-005\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/defaults/index.js\",\n      \"line\": 124,\n      \"description\": \"transformResponse accesses this.parseReviver which is inherited from prototype. If Object.prototype.parseReviver is set, all responses will use the attacker's reviver function.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"70302b6\",\n      \"fix_description\": \"Ignore inherited parseReviver and related config reads\"\n    },\n    {\n      \"id\": \"BUG-006\",\n      \"category\": \"ssrf\",\n      \"file\": \"lib/helpers/shouldBypassProxy.js\",\n      \"line\": 1,\n      \"description\": \"NO_PROXY hostname normalization bypass. Attacker can craft hostname that bypasses proxy filtering, leading to SSRF against internal services.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"fb3befb\",\n      \"fix_description\": \"No_proxy hostname normalization bypass leads to SSRF\"\n    },\n    {\n      \"id\": \"BUG-007\",\n      \"category\": \"header_injection\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 492,\n      \"description\": \"Headers are set from user-controlled config without sanitization. Attacker can inject CRLF sequences into header values to inject arbitrary headers (cloud metadata exfiltration, cache poisoning).\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"3631854\",\n      \"fix_description\": \"Unrestricted cloud metadata exfiltration via header injection chain\"\n    },\n    {\n      \"id\": \"BUG-008\",\n      \"category\": \"stream_bypass\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 786,\n      \"description\": \"When responseType is 'stream', maxContentLength is not enforced on the response stream. Attacker can serve unbounded response data.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"HIGH\",\n      \"fix_reference\": \"e8904af\",\n      \"fix_description\": \"Stream response bypassed max content length\"\n    },\n    {\n      \"id\": \"BUG-009\",\n      \"category\": \"deprecated_api\",\n      \"file\": \"lib/helpers/resolveConfig.js\",\n      \"line\": 31,\n      \"description\": \"Uses deprecated unescape() function for HTTP basic auth password encoding. This can lead to encoding inconsistencies and potential security issues.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"MEDIUM\",\n      \"fix_reference\": \"66337fc\",\n      \"fix_description\": \"Replace deprecated unescape() with modern UTF-8 encoding\"\n    },\n    {\n      \"id\": \"BUG-010\",\n      \"category\": \"prototype_pollution\",\n      \"file\": \"lib/core/mergeConfig.js\",\n      \"line\": 99,\n      \"description\": \"forEach loop iterates Object.keys({ ...config1, ...config2 }) but the spread operator can include inherited properties if Object.prototype is polluted.\",\n      \"impact\": \"SECURITY\",\n      \"confidence\": \"MEDIUM\",\n      \"fix_reference\": \"4791514\",\n      \"fix_description\": \"More header pollutions — guard config key iteration\"\n    },\n    {\n      \"id\": \"BUG-011\",\n      \"category\": \"input_validation\",\n      \"file\": \"lib/helpers/progressEventReducer.js\",\n      \"line\": 1,\n      \"description\": \"Malformed XHR upload events (missing loaded/total properties) can cause NaN propagation in progress calculations, leading to incorrect progress reporting.\",\n      \"impact\": \"CORRECTNESS\",\n      \"confidence\": \"MEDIUM\",\n      \"fix_reference\": \"4094886\",\n      \"fix_description\": \"Guard malformed XHR upload events\"\n    },\n    {\n      \"id\": \"BUG-012\",\n      \"category\": \"resource_exhaustion\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 875,\n      \"description\": \"socket.setKeepAlive called unconditionally without checking if socket exists or is a proxy agent stream. Can cause errors on certain proxy configurations.\",\n      \"impact\": \"RELIABILITY\",\n      \"confidence\": \"MEDIUM\",\n      \"fix_reference\": \"227c788\",\n      \"fix_description\": \"Guard socket.setKeepAlive for proxy agent streams\"\n    }\n  ],\n\n  \"known_false_positive_patterns\": [\n    {\n      \"id\": \"FP-001\",\n      \"pattern\": \"utils.merge() __proto__ check\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 409,\n      \"reason\": \"merge() already blocks __proto__, constructor, prototype on line 409. This is NOT a vulnerability — it's already patched.\"\n    },\n    {\n      \"id\": \"FP-002\",\n      \"pattern\": \"mergeConfig __proto__ check\",\n      \"file\": \"lib/core/mergeConfig.js\",\n      \"line\": 100,\n      \"reason\": \"Line 100 already returns early for __proto__, constructor, prototype. This is a defense-in-depth measure, not a vulnerability.\"\n    },\n    {\n      \"id\": \"FP-003\",\n      \"pattern\": \"formDataToJSON __proto__ check\",\n      \"file\": \"lib/helpers/formDataToJSON.js\",\n      \"line\": 53,\n      \"reason\": \"The __proto__ check on line 53 is intentional protection. BUG-004 is about missing constructor/prototype checks, NOT about this existing check.\"\n    },\n    {\n      \"id\": \"FP-004\",\n      \"pattern\": \"isBuffer val.constructor check\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 54,\n      \"reason\": \"Accessing val.constructor is standard Node.js Buffer detection. Not a vulnerability — val is already validated as non-null object.\"\n    },\n    {\n      \"id\": \"FP-005\",\n      \"pattern\": \"toFlatObject prototype chain walk\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 513,\n      \"reason\": \"Walking prototype chain is intentional for toFlatObject. It's used for merging configs, not for security-sensitive operations.\"\n    },\n    {\n      \"id\": \"FP-006\",\n      \"pattern\": \"kindOf cache object\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 11,\n      \"reason\": \"Object.create(null) cache is safe — no prototype chain. Not a vulnerability.\"\n    },\n    {\n      \"id\": \"FP-007\",\n      \"pattern\": \"Http2Sessions Object.create(null)\",\n      \"file\": \"lib/adapters/http.js\",\n      \"line\": 61,\n      \"reason\": \"Object.create(null) for session storage is safe — no prototype chain. Not a vulnerability.\"\n    },\n    {\n      \"id\": \"FP-008\",\n      \"pattern\": \"setImmediate postMessage token\",\n      \"file\": \"lib/utils.js\",\n      \"line\": 840,\n      \"reason\": \"Math.random() token for postMessage is a well-known pattern. Not cryptographically secure but not a vulnerability in this context.\"\n    }\n  ],\n\n  \"evaluation_notes\": {\n    \"bug_density\": \"12 bugs in ~5000 LOC = 0.24 bugs per 100 LOC\",\n    \"dominant_class\": \"prototype_pollution (6 of 12 bugs = 50%)\",\n    \"high_confidence_bugs\": 8,\n    \"medium_confidence_bugs\": 4,\n    \"security_impact_bugs\": 10,\n    \"correctness_impact_bugs\": 1,\n    \"reliability_impact_bugs\": 1\n  }\n}\n"}
