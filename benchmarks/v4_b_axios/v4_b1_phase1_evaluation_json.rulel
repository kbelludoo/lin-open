@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/v4_b_axios/v4_b1_phase1_evaluation.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_B1_PHASE1_EVALUATION\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"axios@v1.14.0\",\n  \"spec\": \"REAL_AUTONOMOUS_ENGINEERING_V4_B1 rulel v2.0.0\",\n\n  \"flow_discovery_recall\": {\n    \"description\": \"Fraction of oracle data flows discovered in system model\",\n    \"formula\": \"|discovered_oracle_flows| / |oracle_flows|\",\n    \"oracle_flows\": 7,\n    \"oracle_flow_ids\": [\n      \"FLOW-001 config_to_http_request\",\n      \"FLOW-002 url_to_ssr\",\n      \"FLOW-003 header_to_wire\",\n      \"FLOW-004 response_to_json_parse\",\n      \"FLOW-005 formdata_to_object\",\n      \"FLOW-006 env_to_proxy\",\n      \"FLOW-007 xhr_to_progress\"\n    ],\n    \"discovered_in_agent_model\": [\n      {\n        \"oracle_id\": \"FLOW-001\",\n        \"agent_flows\": [\"FLOW-1 (config → http.request)\", \"FLOW-6 (config → http.request)\", \"FLOW-28 (config → http.request)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-002\",\n        \"agent_flows\": [\"FLOW-2 (url → http.request)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-003\",\n        \"agent_flows\": [\"FLOW-3 (header → header_output)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-004\",\n        \"agent_flows\": [\"FLOW-5 (response → JSON.parse)\", \"FLOW-15 (response → JSON.parse)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-005\",\n        \"agent_flows\": [\"FLOW-7 (FormData → object)\", \"FLOW-8 (FormData → object)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-006\",\n        \"agent_flows\": [\"FLOW-4 (env → http.request)\"],\n        \"mapped\": true\n      },\n      {\n        \"oracle_id\": \"FLOW-007\",\n        \"agent_flows\": [\"FLOW-31 (xhr → progress)\"],\n        \"mapped\": true\n      }\n    ],\n    \"discovered_count\": 7,\n    \"missed_count\": 0,\n    \"recall\": 1.00,\n    \"grade\": \"A\"\n  },\n\n  \"model_quality\": {\n    \"total_sources\": 15,\n    \"total_sinks\": 20,\n    \"total_flows\": 40,\n    \"total_trust_boundaries\": 8,\n    \"oracle_coverage_in_flows\": \"7 of 40 flows (17.5%) directly map to oracle bugs\",\n    \"extra_flows\": \"33 flows beyond oracle — additional attack surface discovered\",\n    \"strengths\": [\n      \"Identified all 5 SSRF paths to http.request\",\n      \"Traced FormData → __proto__ path (prototype pollution via body)\",\n      \"Mapped XHR → WebSocket path (resource exhaustion)\",\n      \"Found error → eval path (ReDoS via stack trace)\",\n      \"Identified transformRequest data corruption path\"\n    ],\n    \"weaknesses\": [\n      \"FLOW-9/10/12/13: File descriptor exhaustion via fs.createReadStream — overly broad\"\n    ]\n  },\n\n  \"v4_b_comparison\": {\n    \"v4_b_recall\": 0.58,\n    \"v4_b1_recall\": 1.00,\n    \"improvement\": \"+72%\",\n    \"interpretation\": \"System model approach found all flows that V4-B missed\"\n  },\n\n  \"scenario_classification\": {\n    \"scenario\": \"A\",\n    \"description\": \"Good model (recall=1.0), but agent still needs to be tested on reasoning (Phase 2+3)\",\n    \"rationale\": \"Agent achieved perfect flow discovery recall. Phase 2 (probe execution) and Phase 3 (intervention decision) will measure whether the good model translates to accurate judgment.\"\n  },\n\n  \"next_steps\": [\n    \"Phase 2: probe_execution_on_graph — execute probe on each flow\",\n    \"Phase 3: intervention_decision — classify TP/FP/FIX/NO_ACTION\"\n  ]\n}\n"}
