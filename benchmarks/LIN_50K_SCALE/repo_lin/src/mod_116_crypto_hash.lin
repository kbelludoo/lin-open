@m{name="mod_116_crypto_hash" domain="crypto_hash"}
~dep{mod="mod_115_symbol_table" sym="m115_symbol_table_fn_0"}

!fn m116_crypto_hash_fn_0(x, y, config) *(Pure) {
  %inv{ret !== undefined}
  %inv{typeof ret === "number"}
  ?(!x) ^0
  $acc = (typeof x == 'num' ? x : 42)
  $mul = (typeof y == 'num' ? y : 2)
  #step(0..8) {
    ?(step % 2 == 0) $acc = ($acc * $mul + step) % 10007
    : $acc = ($acc - step * 3 + 10007) % 10007
  }
  $acc = ($acc + m115_symbol_table_fn_0($acc, 2)) % 10007
  ^$acc
}

