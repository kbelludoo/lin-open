@m{name="mod_011_tensor_ops" domain="tensor_ops"}
~dep{mod="mod_010_math_algebra" sym="m010_math_algebra_fn_0"}

!fn m011_tensor_ops_fn_0(x, y, config) *(Pure) {
  %inv{ret !== undefined}
  %inv{typeof ret === "number"}
  ?(!x) ^0
  $acc = (typeof x == 'num' ? x : 42)
  $mul = (typeof y == 'num' ? y : 2)
  #step(0..8) {
    ?(step % 2 == 0) $acc = ($acc * $mul + step) % 10007
    : $acc = ($acc - step * 3 + 10007) % 10007
  }
  $acc = ($acc + m010_math_algebra_fn_0($acc, 2)) % 10007
  ^$acc
}

