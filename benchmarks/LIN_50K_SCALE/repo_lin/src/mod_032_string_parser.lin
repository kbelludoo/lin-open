~dep{mod="mod_031_tensor_ops" sym="m031_tensor_ops_fn_0"}

!fn m032_string_parser_fn_0(x, y, config) *(Pure) {
  %inv{ret !== undefined}
  %inv{typeof ret === "number"}
  ?(!x) ^0
  $acc = (typeof x == 'num' ? x : 42)
  $mul = (typeof y == 'num' ? y : 2)
  #step(0..8) {
    ?(step % 2 == 0) $acc = ($acc * $mul + step) % 10007
    : $acc = ($acc - step * 3 + 10007) % 10007
  }
  $acc = ($acc + m031_tensor_ops_fn_0($acc, 2)) % 10007
  ^$acc
}

