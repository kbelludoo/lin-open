.protocol="GATE_6_ABLATION_C1_VS_C2" version="1.0.0" status="FROZEN" hypothesis="H_ABLATION_01: C1 (LIN + H_node) significantly outperforms C2 (LIN - H_node) under tight context budgets and mutation tasks due to structural deduplication, semantic invariant enforcement, and resident canonical node lookup, confirmed by McNemar's exact test (alpha = 0.005)." metrics=["exact_execution_rate","contingency_matrix_n11_n10_n01_n00","mcnemar_chi_squared_statistic","mcnemar_exact_p_value","bonferroni_significance_alpha_0_005"] statistical_test="McNemar's Test with Continuity Correction & Exact Binomial p-value"
