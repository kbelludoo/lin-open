@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/GATE_6_ABLATION_C1_C2/spec/GATE_6_ISOLATED_HNODE_SPEC.json" ext=".json"}
.source{content="{\n  \"protocol\": \"GATE_6_STRICT_SINGLE_VARIABLE_HNODE_ABLATION\",\n  \"version\": \"2.0.0\",\n  \"status\": \"FROZEN\",\n  \"scientific_objective\": \"Isolate strictly the causal effect of H_node (Semantic Node Canonical Interning) by holding AST parsing, capability guard, oracle verification, and task inputs completely identical across both experimental arms.\",\n  \"experimental_conditions\": {\n    \"C1_with_H_node\": \"Full pipeline with active H_node interning table (canonical node deduplication enabled).\",\n    \"C2_without_H_node\": \"Identical pipeline with capability guard and AST canonicalization, but H_node interning table is bypassed (fresh node allocation per call).\"\n  },\n  \"controlled_invariants\": [\n    \"Identical capability guard applied to both C1 and C2\",\n    \"Identical AST parsing and alpha-canonicalization applied to both C1 and C2\",\n    \"Identical black-box oracle and identical success criteria (exact output equality) for both C1 and C2\",\n    \"No hardcoded outcome assignments in the harness\"\n  ],\n  \"evaluated_dimensions\": [\n    \"functional_execution_parity_EE_strict\",\n    \"allocated_canonical_nodes_RAM\",\n    \"redundant_compilation_overhead_latency_us\",\n    \"memory_deduplication_ratio\"\n  ]\n}\n"}
