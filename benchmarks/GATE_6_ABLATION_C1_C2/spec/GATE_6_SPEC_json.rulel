~METADATA{original="benchmarks/GATE_6_ABLATION_C1_C2/spec/GATE_6_SPEC.json" ext=".json"}
.source{content="{\n  \"protocol\": \"GATE_6_ABLATION_C1_VS_C2\",\n  \"version\": \"1.0.0\",\n  \"status\": \"FROZEN\",\n  \"hypothesis\": \"H_ABLATION_01: C1 (LIN + H_node) significantly outperforms C2 (LIN - H_node) under tight context budgets and mutation tasks due to structural deduplication, semantic invariant enforcement, and resident canonical node lookup, confirmed by McNemar's exact test (alpha = 0.005).\",\n  \"conditions\": {\n    \"C1\": \"Full LIN with H_node (Semantic Node HashCons + Canonical AST Deduplication + Pre-execution Capability Guard)\",\n    \"C2\": \"Ablated LIN without H_node (Flat string evaluation / raw transpilation without canonical node interning or resident structural caching)\"\n  },\n  \"metrics\": [\n    \"exact_execution_rate\",\n    \"contingency_matrix_n11_n10_n01_n00\",\n    \"mcnemar_chi_squared_statistic\",\n    \"mcnemar_exact_p_value\",\n    \"bonferroni_significance_alpha_0_005\"\n  ],\n  \"statistical_test\": \"McNemar's Test with Continuity Correction & Exact Binomial p-value\"\n}\n"}
