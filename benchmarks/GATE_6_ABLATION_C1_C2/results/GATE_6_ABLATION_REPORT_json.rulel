.source{content="{\n  \"benchmark\": \"GATE_6_ABLATION_C1_VS_C2\",\n  \"certified\": true,\n  \"total_tasks_evaluated\": 120,\n  \"contingency_table\": {\n    \"n11_both_pass\": 110,\n    \"n10_c1_win_c2_fail\": 10,\n    \"n01_c1_fail_c2_win\": 0,\n    \"n00_both_fail\": 0\n  },\n  \"success_rates\": {\n    \"c1_full_lin_hnode_rate_percent\": 100,\n    \"c2_ablated_no_hnode_rate_percent\": 91.67\n  },\n  \"statistical_hypothesis_testing\": {\n    \"test\": \"McNemar's Exact Binomial Test with Continuity Correction\",\n    \"alpha_threshold\": 0.005,\n    \"mcnemar_results\": {\n      \"b_discordant_c1_win\": 10,\n      \"c_discordant_c2_win\": 0,\n      \"discordant_total\": 10,\n      \"chi2_continuity_corrected\": 8.1,\n      \"exact_binomial_p_value\": 0.0019531,\n      \"significant_at_bonferroni_0_005\": true\n    }\n  },\n  \"timestamp\": \"2026-08-24T00:20:10.077Z\"\n}"}
