.source{content="// Generic TS Conformance Emitter\n\nexport const TRACE = [];\n\nconst EFFECTS = {\"fn_1\":\"Pure\",\"fn_2\":\"Pure\"};\n\nexport function fn_1(a, b, callerEffect = 'Pure') {\n  TRACE.push(\"ENTER:fn_1\");\n  const myEff = EFFECTS[\"fn_1\"] || 'Pure';\n  if (callerEffect === 'Pure' && myEff !== 'Pure') {\n    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\n    TRACE.push(\"ABORT:EFFECT_LEAK\");\n    throw new Error(\"EFFECT_LEAK\");\n  }\n  const result = a + b;\n  TRACE.push(\"RETURN:\" + result);\n  return result;\n}\n\nexport function fn_2(a, b, callerEffect = 'Pure') {\n  TRACE.push(\"ENTER:fn_2\");\n  const myEff = EFFECTS[\"fn_2\"] || 'Pure';\n  if (callerEffect === 'Pure' && myEff !== 'Pure') {\n    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\n    TRACE.push(\"ABORT:EFFECT_LEAK\");\n    throw new Error(\"EFFECT_LEAK\");\n  }\n  if (!(a > 0)) {\n    TRACE.push(\"PRE_FAIL:c0\");\n    TRACE.push(\"ABORT:PRECONDITION_VIOLATED\");\n    throw new Error(\"PRECONDITION_VIOLATED\");\n  } else {\n    TRACE.push(\"PRE_PASS:c0\");\n  }\n  if (!(b > 0)) {\n    TRACE.push(\"PRE_FAIL:c1\");\n    TRACE.push(\"ABORT:PRECONDITION_VIOLATED\");\n    throw new Error(\"PRECONDITION_VIOLATED\");\n  } else {\n    TRACE.push(\"PRE_PASS:c1\");\n  }\n  const result = a + b;\n  TRACE.push(\"RETURN:\" + result);\n  return result;\n}\n\n"}
