.source{content="\n      // Generic C99 Conformance Emitter\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\nchar g_trace[64][128];\nint g_trace_count = 0;\n\nvoid trace_push(const char* msg) {\n    if (g_trace_count < 64) {\n        strncpy(g_trace[g_trace_count], msg, 127);\n        g_trace[g_trace_count][127] = '\\0';\n        g_trace_count++;\n    }\n}\n\nint fn_1(int a, int b, const char* caller_effect, const char** err);\nint fn_2(int a, int b, const char* caller_effect, const char** err);\nint fn_3(int a, int b, const char* caller_effect, const char** err);\nint fn_4(int a, int b, const char* caller_effect, const char** err);\nint fn_5(int a, int b, const char* caller_effect, const char** err);\nint fn_6(int a, int b, const char* caller_effect, const char** err);\nint fn_7(int a, int b, const char* caller_effect, const char** err);\nint fn_8(int a, int b, const char* caller_effect, const char** err);\n\nint fn_1(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_1\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    if (!(b > 0)) {\n        trace_push(\"PRE_FAIL:c1\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c1\");\n    }\n    snprintf(buf, sizeof(buf), \"CALL:%s\", \"fn_2\"); trace_push(buf);\n    int result = fn_2(a, b, my_effect, err);\n    if (strcmp(*err, \"OK\") != 0) { return -1; }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_2(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_2\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    int result = a + b;\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c0\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c0\");\n    }\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c1\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c1\");\n    }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_3(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_3\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    if (!(b > 0)) {\n        trace_push(\"PRE_FAIL:c1\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c1\");\n    }\n    int result = a + b;\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_4(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_4\"); trace_push(buf);\n    const char* my_effect = \"HeapMut\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    if (!(b > 0)) {\n        trace_push(\"PRE_FAIL:c1\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c1\");\n    }\n    snprintf(buf, sizeof(buf), \"CALL:%s\", \"fn_5\"); trace_push(buf);\n    int result = fn_5(a, b, my_effect, err);\n    if (strcmp(*err, \"OK\") != 0) { return -1; }\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c2\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c2\");\n    }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_5(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_5\"); trace_push(buf);\n    const char* my_effect = \"HeapMut\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    int result = a + b;\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c1\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c1\");\n    }\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c2\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c2\");\n    }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_6(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_6\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    if (!(b > 0)) {\n        trace_push(\"PRE_FAIL:c1\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c1\");\n    }\n    int result = a + b;\n    if (!(result >= a)) {\n        trace_push(\"POST_FAIL:c2\");\n        trace_push(\"ABORT:POSTCONDITION_VIOLATED\");\n        *err = \"POSTCONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"POST_PASS:c2\");\n    }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_7(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_7\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    if (!(a > 0)) {\n        trace_push(\"PRE_FAIL:c0\");\n        trace_push(\"ABORT:PRECONDITION_VIOLATED\");\n        *err = \"PRECONDITION_VIOLATED\"; return -1;\n    } else {\n        trace_push(\"PRE_PASS:c0\");\n    }\n    snprintf(buf, sizeof(buf), \"CALL:%s\", \"fn_8\"); trace_push(buf);\n    int result = fn_8(a, b, my_effect, err);\n    if (strcmp(*err, \"OK\") != 0) { return -1; }\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\nint fn_8(int a, int b, const char* caller_effect, const char** err) {\n    char buf[128];\n    snprintf(buf, sizeof(buf), \"ENTER:%s\", \"fn_8\"); trace_push(buf);\n    const char* my_effect = \"Pure\";\n    if (strcmp(caller_effect, \"Pure\") == 0 && strcmp(my_effect, \"Pure\") != 0) {\n        snprintf(buf, sizeof(buf), \"EFFECT_LEAK:Pure_calls_%s\", my_effect); trace_push(buf);\n        trace_push(\"ABORT:EFFECT_LEAK\");\n        *err = \"EFFECT_LEAK\"; return -1;\n    }\n    int result = a + b;\n    snprintf(buf, sizeof(buf), \"RETURN:%d\", result); trace_push(buf);\n    *err = \"OK\"; return result;\n}\n\n\n      int main() {\n          const char* err = \"OK\";\n          fn_1(55, 6, \"Pure\", &err);\n          printf(\"[\");\n          for (int i = 0; i < g_trace_count; i++) {\n              if (i > 0) printf(\",\");\n              printf(\"\\\"%s\\\"\", g_trace[i]);\n          }\n          printf(\"]\\n\");\n          return 0;\n      }\n    "}
