~METADATA{original="benchmarks/LIN_SIGIL_CONFORMANCE_001/build/prog_0010.rs" ext=".rs"}
.source{content="\n      // Generic Rust Conformance Emitter\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn fn_1(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_1\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    trace.push(format!(\"CALL:{}\", \"fn_2\"));\n    let result = fn_2(a, b, my_effect, trace)?;\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_2(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_2\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    trace.push(format!(\"CALL:{}\", \"fn_3\"));\n    let result = fn_3(a, b, my_effect, trace)?;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c1\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c1\".to_string());\n    }\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c2\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c2\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_3(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_3\"));\n    let my_effect = \"IO\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    let result = a + b;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c1\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c1\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_4(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_4\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    if !(b > 0) {\n        trace.push(\"PRE_FAIL:c1\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c1\".to_string());\n    }\n    let result = a + b;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c2\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c2\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_5(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_5\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    if !(b > 0) {\n        trace.push(\"PRE_FAIL:c1\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c1\".to_string());\n    }\n    trace.push(format!(\"CALL:{}\", \"fn_6\"));\n    let result = fn_6(a, b, my_effect, trace)?;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c2\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c2\".to_string());\n    }\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c3\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c3\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_6(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_6\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    let result = a + b;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c0\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c0\".to_string());\n    }\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c1\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c1\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_7(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_7\"));\n    let my_effect = \"HeapMut\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    if !(b > 0) {\n        trace.push(\"PRE_FAIL:c1\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c1\".to_string());\n    }\n    let result = a + b;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c2\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c2\".to_string());\n    }\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c3\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c3\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_8(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_8\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    if !(a > 0) {\n        trace.push(\"PRE_FAIL:c0\".to_string());\n        trace.push(\"ABORT:PRECONDITION_VIOLATED\".to_string());\n        return Err(\"PRECONDITION_VIOLATED\");\n    } else {\n        trace.push(\"PRE_PASS:c0\".to_string());\n    }\n    let result = a + b;\n    if !(result >= a) {\n        trace.push(\"POST_FAIL:c1\".to_string());\n        trace.push(\"ABORT:POSTCONDITION_VIOLATED\".to_string());\n        return Err(\"POSTCONDITION_VIOLATED\");\n    } else {\n        trace.push(\"POST_PASS:c1\".to_string());\n    }\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\n\n      fn main() {\n          let mut trace: Vec<String> = Vec::new();\n          let _ = fn_1(23, 20, \"Pure\", &mut trace);\n          print!(\"[\");\n          for (i, t) in trace.iter().enumerate() {\n              if i > 0 { print!(\",\"); }\n              print!(\"\\\"{}\\\"\", t);\n          }\n          println!(\"]\");\n      }\n    "}
