@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/LIN_SIGIL_CONFORMANCE_001/build/prog_0043.rs" ext=".rs"}
.source{content="\n      // Generic Rust Conformance Emitter\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn fn_1(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_1\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    let result = a + b;\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\npub fn fn_2(a: i32, b: i32, caller_effect: &str, trace: &mut Vec<String>) -> Result<i32, &'static str> {\n    trace.push(format!(\"ENTER:{}\", \"fn_2\"));\n    let my_effect = \"Pure\";\n    if caller_effect == \"Pure\" && my_effect != \"Pure\" {\n        trace.push(format!(\"EFFECT_LEAK:Pure_calls_{}\", my_effect));\n        trace.push(\"ABORT:EFFECT_LEAK\".to_string());\n        return Err(\"EFFECT_LEAK\");\n    }\n    let result = a + b;\n    trace.push(format!(\"RETURN:{}\", result));\n    Ok(result)\n}\n\n\n      fn main() {\n          let mut trace: Vec<String> = Vec::new();\n          let _ = fn_1(30, 17, \"Pure\", &mut trace);\n          print!(\"[\");\n          for (i, t) in trace.iter().enumerate() {\n              if i > 0 { print!(\",\"); }\n              print!(\"\\\"{}\\\"\", t);\n          }\n          println!(\"]\");\n      }\n    "}
