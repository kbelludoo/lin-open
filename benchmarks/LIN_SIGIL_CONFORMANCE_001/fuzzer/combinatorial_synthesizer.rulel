~METADATA{original="benchmarks/LIN_SIGIL_CONFORMANCE_001/fuzzer/combinatorial_synthesizer.mjs" lang="mjs"}
.source{content="import { createPRNG } from '../../LIN_MEM_001/dataset/generate.mjs';\n\nexport function synthesizeProgram({ id, rand }) {\n  const numFns = 2 + Math.floor(rand() * 7); // 2 to 8 functions\n  const fns = [];\n  const effectOptions = ['Pure', 'IO', 'HeapMut'];\n\n  for (let f = 1; f <= numFns; f++) {\n    const fnName = `fn_${f}`;\n    const eff = rand() < 0.8 ? 'Pure' : effectOptions[Math.floor(rand() * 3)];\n    const numPre = Math.floor(rand() * 3);  // 0 to 2 preconditions\n    const numPost = Math.floor(rand() * 3); // 0 to 2 postconditions\n\n    const contracts = [];\n\n    // Preconditions\n    for (let c = 0; c < numPre; c++) {\n      if (c === 0) {\n        contracts.push({\n          kind: 'pre',\n          expr: 'a > 0',\n          ast: { type: 'BinaryOp', op: '>', left: { type: 'Identifier', name: 'a' }, right: { type: 'Literal', value: 0 } }\n        });\n      } else {\n        contracts.push({\n          kind: 'pre',\n          expr: 'b > 0',\n          ast: { type: 'BinaryOp', op: '>', left: { type: 'Identifier', name: 'b' }, right: { type: 'Literal', value: 0 } }\n        });\n      }\n    }\n\n    // Body AST & Call Graph\n    let bodyAST = null;\n    let bodyCode = '';\n\n    if (f < numFns && rand() < 0.6) {\n      // Calls next function in chain\n      const callee = `fn_${f + 1}`;\n      bodyAST = {\n        type: 'Call',\n        callee,\n        args: [\n          { type: 'Identifier', name: 'a' },\n          { type: 'Identifier', name: 'b' }\n        ]\n      };\n      bodyCode = `^${callee}(a, b)`;\n    } else {\n      // Leaf arithmetic\n      bodyAST = {\n        type: 'BinaryOp',\n        op: '+',\n        left: { type: 'Identifier', name: 'a' },\n        right: { type: 'Identifier', name: 'b' }\n      };\n      bodyCode = '^(a + b)';\n    }\n\n    // Postconditions\n    for (let c = 0; c < numPost; c++) {\n      contracts.push({\n        kind: 'post',\n        expr: 'result >= a',\n        ast: { type: 'BinaryOp', op: '>=', left: { type: 'Identifier', name: 'result' }, right: { type: 'Identifier', name: 'a' } }\n      });\n    }\n\n    fns.push({\n      name: fnName,\n      params: [{ name: 'a', type: 'i32' }, { name: 'b', type: 'i32' }],\n      returnType: 'i32',\n      effects: [eff],\n      contracts,\n      bodyAST,\n      bodyCode\n    });\n  }\n\n  // Generate test inputs\n  const isInvalid = rand() < 0.3;\n  const initialArgs = isInvalid ? [-10, 5] : [10 + Math.floor(rand() * 50), 5 + Math.floor(rand() * 20)];\n\n  return {\n    prog_id: `prog_${String(id).padStart(4, '0')}`,\n    entry_fn: 'fn_1',\n    num_functions: numFns,\n    ast: { protocol: 'LIN_TYPED_IR/3.0', functions: fns },\n    initialArgs\n  };\n}\n\nexport function generateConformanceCorpus(count = 100, seed = 777123) {\n  const rand = createPRNG(seed);\n  const corpus = [];\n  for (let i = 1; i <= count; i++) {\n    corpus.push(synthesizeProgram({ id: i, rand }));\n  }\n  return corpus;\n}\n"}
