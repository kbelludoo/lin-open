~METADATA{original="benchmarks/LIN_MEM_001/harness/metrics.mjs" lang="mjs"}
.source{content="export function computePercentiles(latenciesNs) {\n  if (latenciesNs.length === 0) {\n    return { p50: 0, p90: 0, p95: 0, p99: 0, min: 0, max: 0, avg: 0 };\n  }\n  const sorted = [...latenciesNs].sort((a, b) => a - b);\n  const n = sorted.length;\n  const p50 = sorted[Math.floor(n * 0.50)];\n  const p90 = sorted[Math.floor(n * 0.90)];\n  const p95 = sorted[Math.floor(n * 0.95)];\n  const p99 = sorted[Math.floor(n * 0.99)];\n  const min = sorted[0];\n  const max = sorted[n - 1];\n  const sum = sorted.reduce((acc, v) => acc + v, 0);\n  const avg = sum / n;\n\n  return {\n    p50_us: p50 / 1000,\n    p90_us: p90 / 1000,\n    p95_us: p95 / 1000,\n    p99_us: p99 / 1000,\n    min_us: min / 1000,\n    max_us: max / 1000,\n    avg_us: avg / 1000\n  };\n}\n\nexport function computeDensityMetrics({ totalEntities, totalRelations, memoryBytes }) {\n  return {\n    totalEntities,\n    totalRelations,\n    memoryBytes,\n    bytesPerEntity: totalEntities > 0 ? (memoryBytes / totalEntities) : 0,\n    bytesPerRelation: totalRelations > 0 ? (memoryBytes / totalRelations) : 0\n  };\n}\n"}
