@RULEL:SCHEMA:1.0.0
~DATA
.entities{
  .Account{
    .fields{
      .limits{
        .max_users="u32" max_storage_mb="u64" features="array<string>"
      }
      .id="u64" name="string" tier="string"
    }
  }
  .Policy{
    .fields{
      .id="u64" account_id="u64" name="string" rules="array<{action: string, effect: string, min_role_level: u32, max_size_kb: u64}>"
    }
  }
  .User{
    .fields{
      .metadata{
        .department="string" region="string"
      }
      .id="u64" account_id="u64" policy_id="u64" username="string" role="string" role_level="u32" status="string"
    }
  }
  .Resource{
    .fields{
      .id="u64" user_id="u64" account_id="u64" kind="string" size_kb="u64" tags="array<string>"
    }
  }
}
.relations{
    .from="User" to="Account" field="account_id" type="belongs_to"
    .from="User" to="Policy" field="policy_id" type="has_policy"
    .from="Resource" to="User" field="user_id" type="owned_by"
    .from="Resource" to="Account" field="account_id" type="belongs_to"
}
.$schema="http://json-schema.org/draft-07/schema#" title="LIN_MEM_001_Schema"
