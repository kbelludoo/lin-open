.source{content="// Generic TS Emit with Semantic Trace Execution\n\nexport const TRACE = [];\n\nconst EFFECTS = {\"fn_1\":\"HeapMut\",\"fn_2\":\"Pure\"};\n\nexport function fn_1(a, b, callerEffect = 'Pure') {\n  TRACE.push(\"ENTER:fn_1\");\n  const myEff = EFFECTS[\"fn_1\"] || 'Pure';\n  if (callerEffect === 'Pure' && myEff !== 'Pure') {\n    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\n    TRACE.push(\"ABORT:EFFECT_LEAK\");\n    throw new Error(\"EFFECT_LEAK\");\n  }\n  TRACE.push(\"CALL:fn_2\");\n  const result = fn_2(a, b, myEff);\n  if (!(result >= a)) {\n    TRACE.push(\"POST_FAIL:c0\");\n    TRACE.push(\"ABORT:POSTCONDITION_VIOLATED\");\n    throw new Error(\"POSTCONDITION_VIOLATED\");\n  } else {\n    TRACE.push(\"POST_PASS:c0\");\n  }\n  TRACE.push(\"RETURN:\" + result);\n  return result;\n}\n\nexport function fn_2(a, b, callerEffect = 'Pure') {\n  TRACE.push(\"ENTER:fn_2\");\n  const myEff = EFFECTS[\"fn_2\"] || 'Pure';\n  if (callerEffect === 'Pure' && myEff !== 'Pure') {\n    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\n    TRACE.push(\"ABORT:EFFECT_LEAK\");\n    throw new Error(\"EFFECT_LEAK\");\n  }\n  const result = (a + b);\n  if (!(result >= a)) {\n    TRACE.push(\"POST_FAIL:c0\");\n    TRACE.push(\"ABORT:POSTCONDITION_VIOLATED\");\n    throw new Error(\"POSTCONDITION_VIOLATED\");\n  } else {\n    TRACE.push(\"POST_PASS:c0\");\n  }\n  TRACE.push(\"RETURN:\" + result);\n  return result;\n}\n\n"}
