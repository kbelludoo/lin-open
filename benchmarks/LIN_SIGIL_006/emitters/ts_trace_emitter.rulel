~METADATA{original="benchmarks/LIN_SIGIL_006/emitters/ts_trace_emitter.mjs" lang="mjs"}
.source{content="// Generic TypeScript / JS Trace Emitter\n\nexport function emitTypeScript(ast) {\n  let code = `// Generic TS Emit with Semantic Trace Execution\\n\\n`;\n  code += `export const TRACE = [];\\n\\n`;\n\n  // Function signature map for independent effect checking\n  const effMap = {};\n  for (const fn of ast.functions) {\n    effMap[fn.name] = fn.effects[0] || 'Pure';\n  }\n  code += `const EFFECTS = ${JSON.stringify(effMap)};\\n\\n`;\n\n  for (const fn of ast.functions) {\n    const paramsList = fn.params.map(p => p.name).join(', ');\n    code += `export function ${fn.name}(${paramsList}, callerEffect = 'Pure') {\\n`;\n    code += `  TRACE.push(\"ENTER:${fn.name}\");\\n`;\n    code += `  const myEff = EFFECTS[\"${fn.name}\"] || 'Pure';\\n`;\n    code += `  if (callerEffect === 'Pure' && myEff !== 'Pure') {\\n`;\n    code += `    TRACE.push(\"EFFECT_LEAK:Pure_calls_\" + myEff);\\n`;\n    code += `    TRACE.push(\"ABORT:EFFECT_LEAK\");\\n`;\n    code += `    throw new Error(\"EFFECT_LEAK\");\\n`;\n    code += `  }\\n`;\n\n    // Preconditions\n    for (let i = 0; i < fn.contracts.length; i++) {\n      const c = fn.contracts[i];\n      if (c.kind === 'pre') {\n        code += `  if (!(${c.expr})) {\\n`;\n        code += `    TRACE.push(\"PRE_FAIL:c${i}\");\\n`;\n        code += `    TRACE.push(\"ABORT:PRECONDITION_VIOLATED\");\\n`;\n        code += `    throw new Error(\"PRECONDITION_VIOLATED\");\\n`;\n        code += `  } else {\\n`;\n        code += `    TRACE.push(\"PRE_PASS:c${i}\");\\n`;\n        code += `  }\\n`;\n      }\n    }\n\n    // Body / Calls\n    if (fn.calls) {\n      code += `  TRACE.push(\"CALL:${fn.calls.target}\");\\n`;\n      code += `  const result = ${fn.calls.target}(${paramsList}, myEff);\\n`;\n    } else {\n      const bodyExpr = fn.body.replace(/^\\^/g, '').replace(/let result = /g, '').trim();\n      code += `  const result = ${bodyExpr};\\n`;\n    }\n\n    // Postconditions\n    for (let i = 0; i < fn.contracts.length; i++) {\n      const c = fn.contracts[i];\n      if (c.kind === 'post') {\n        code += `  if (!(${c.expr})) {\\n`;\n        code += `    TRACE.push(\"POST_FAIL:c${i}\");\\n`;\n        code += `    TRACE.push(\"ABORT:POSTCONDITION_VIOLATED\");\\n`;\n        code += `    throw new Error(\"POSTCONDITION_VIOLATED\");\\n`;\n        code += `  } else {\\n`;\n        code += `    TRACE.push(\"POST_PASS:c${i}\");\\n`;\n        code += `  }\\n`;\n      }\n    }\n\n    code += `  TRACE.push(\"RETURN:\" + result);\\n`;\n    code += `  return result;\\n}\\n\\n`;\n  }\n\n  return code;\n}\n"}
