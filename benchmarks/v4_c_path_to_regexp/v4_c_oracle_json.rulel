@RULEL:TRANSPOSED_SOURCE:1.0
~METADATA{original="benchmarks/v4_c_path_to_regexp/v4_c_oracle.json" ext=".json"}
.source{content="{\n  \"id\": \"V4_C_ORACLE\",\n  \"version\": \"1.0.0\",\n  \"repository\": \"path-to-regexp@6.3.0\",\n  \"url\": \"https://github.com/pillarjs/path-to-regexp\",\n  \"loc\": \"~640 (src/index.ts)\",\n  \"description\": \"Oracle for V4-C UNKNOWN FLOW GENERALIZATION. Tests whether agent finds vulnerability classes not present in V4-B training.\",\n\n  \"vulnerability_classes_in_v4_b\": [\"prototype_pollution\", \"ssrf\", \"header_injection\", \"resource_exhaustion\", \"input_validation\"],\n  \"vulnerability_classes_in_v4_c\": [\"redos\"],\n  \"novelty\": \"ReDoS is a completely different class from V4-B. It involves regex generation, not data flow. The agent has never seen ReDoS patterns in the V4-B/V4-B.1 training.\",\n\n  \"bugs\": [\n    {\n      \"bug_id\": \"BUG-C001\",\n      \"cve\": \"CVE-2024-45296\",\n      \"vulnerability_class\": \"redos\",\n      \"severity\": \"HIGH\",\n      \"cvss\": 7.5,\n      \"description\": \"path-to-regexp outputs backtracking regular expressions when two parameters are in a single segment separated by something that is not a period. The generated regex has catastrophic backtracking, causing denial of service.\",\n      \"affected_versions\": \">=0.2.0,<1.9.0; >=2.0.0,<3.3.0; >=4.0.0,<6.3.0; >=7.0.0,<8.0.0\",\n      \"fixed_version\": \"8.0.0\",\n      \"root_cause\": \"safePattern() generates lookahead patterns that create exponential backtracking when two parameters are adjacent in a segment\",\n      \"vulnerable_patterns\": [\"/:a-:b\", \"/:x{/foobar/:y}?-:z\", \"/:a.:b\"],\n      \"source_location\": {\n        \"file\": \"src/index.ts\",\n        \"function\": \"safePattern\",\n        \"line\": 184,\n        \"code\": \"return `(?:(?!${escapeString(prevText)})[^${escapeString(delimiter)}])+?`;\"\n      },\n      \"exploit\": {\n        \"pattern\": \"/:a-:b\",\n        \"input\": \"/a-aaaaaaaaaaaaaaaaaaaaaa-a\",\n        \"impact\": \"Event loop blocked for >1000x longer than safe regex\",\n        \"description\": \"The negative lookahead (?:(?!-)[^/])+? causes exponential backtracking when the input contains repeated separators\"\n      },\n      \"fix\": {\n        \"description\": \"Version 8.0.0 removes the features that can cause ReDoS. Alternatively, provide custom regex for parameters after the first in a single segment.\",\n        \"example\": \"/:a-:b([^-/]+)\"\n      }\n    }\n  ],\n\n  \"non_vulnerabilities\": [\n    {\n      \"pattern\": \"safePattern generating [^/]+? for safe paths\",\n      \"reason\": \"When the previous text contains a delimiter character, the pattern is safe because the delimiter acts as a natural boundary\"\n    },\n    {\n      \"pattern\": \"tokensToRegexp generating standard capture groups\",\n      \"reason\": \"Standard regex capture groups without lookahead are safe from catastrophic backtracking\"\n    }\n  ],\n\n  \"evaluation_criteria\": {\n    \"must_find\": [\"BUG-C001\"],\n    \"must_not_flag\": [\"safePattern with delimiter\", \"standard capture groups\"],\n    \"generalization_test\": \"Agent has never seen ReDoS in V4-B. Can it detect a vulnerability in a completely different class using only system model analysis?\"\n  }\n}\n"}
