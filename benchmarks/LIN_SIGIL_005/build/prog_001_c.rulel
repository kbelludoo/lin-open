~METADATA{original="benchmarks/LIN_SIGIL_005/build/prog_001.c" ext=".c"}
.source{content="\n        // Auto-generated Generic C99 from LIN IR\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\n#define MAX(a,b) ((a) > (b) ? (a) : (b))\n#define MIN(a,b) ((a) < (b) ? (a) : (b))\n\nint safe_divide_1(int a, int b, const char** err) {\n    if (!(b != 0)) { *err = \"PRECONDITION_VIOLATED\"; return -1; }\n    int result = (a / b);\n    if (!(result * b <= a)) { *err = \"POSTCONDITION_VIOLATED\"; return -1; }\n    *err = \"OK\"; return result;\n}\n\n\n        int main() {\n            const char* err = NULL;\n            int res = safe_divide_1(20, 4, &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":%d}\\n\", res);\n            } else {\n                printf(\"{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"%s\\\",\\\"res\\\":null}\\n\", err);\n            }\n            return 0;\n        }\n      "}
