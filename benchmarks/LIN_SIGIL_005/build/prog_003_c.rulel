~METADATA{original="benchmarks/LIN_SIGIL_005/build/prog_003.c" ext=".c"}
.source{content="\n        // Auto-generated Generic C99 from LIN IR\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdbool.h>\n\n#define MAX(a,b) ((a) > (b) ? (a) : (b))\n#define MIN(a,b) ((a) < (b) ? (a) : (b))\n\nint multiply_exact_3(int x, int y, const char** err) {\n    if (!(x >= 0 && y >= 0)) { *err = \"PRECONDITION_VIOLATED\"; return -1; }\n    int result = x * y;\n    if (!(result >= x)) { *err = \"POSTCONDITION_VIOLATED\"; return -1; }\n    *err = \"OK\"; return result;\n}\n\n\n        int main() {\n            const char* err = NULL;\n            int res = multiply_exact_3(-5, 3, &err);\n            if (strcmp(err, \"OK\") == 0) {\n                printf(\"{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":%d}\\n\", res);\n            } else {\n                printf(\"{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"%s\\\",\\\"res\\\":null}\\n\", err);\n            }\n            return 0;\n        }\n      "}
