.source{content="// Auto-generated Generic TypeScript from LIN IR\n\nexport function safe_divide_49(a, b) {\n  if (!(b != 0)) throw new Error(\"PRECONDITION_VIOLATED\");\n  const __old = (typeof self !== 'undefined' && self) ? JSON.parse(JSON.stringify(self)) : {};\n  const __exec = () => {\n    return (Math.floor(a / b))\n  };\n  const result = __exec();\n  if (!(result * b <= a)) throw new Error(\"POSTCONDITION_VIOLATED\");\n  return result;\n}\n\n"}
