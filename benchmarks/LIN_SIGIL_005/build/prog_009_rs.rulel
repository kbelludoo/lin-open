.source{content="\n        // Auto-generated Generic Rust from LIN IR\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn multiply_exact_9(x: i32, y: i32) -> Result<i32, &'static str> {\n    if !(x >= 0 && y >= 0) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let result = x * y;\n    if !(result >= x) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\n\n        fn main() {\n            match multiply_exact_9(-5, 3) {\n                Ok(v) => println!(\"{{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\",\\\"res\\\":null}}\", e),\n            }\n        }\n      "}
