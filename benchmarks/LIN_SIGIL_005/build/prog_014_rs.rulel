.source{content="\n        // Auto-generated Generic Rust from LIN IR\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn clamp_val_14(x: i32, min: i32, max: i32) -> Result<i32, &'static str> {\n    if !(min <= max) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let result = (min as i32).max((x as i32).min(max as i32));\n    if !(result >= min && result <= max) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\n\n        fn main() {\n            match clamp_val_14(50, 10, 100) {\n                Ok(v) => println!(\"{{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\",\\\"res\\\":null}}\", e),\n            }\n        }\n      "}
