~METADATA{original="benchmarks/LIN_SIGIL_005/build/prog_037.rs" ext=".rs"}
.source{content="\n        // Auto-generated Generic Rust from LIN IR\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn safe_divide_37(a: i32, b: i32) -> Result<i32, &'static str> {\n    if !(b != 0) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let result = (a / b);\n    if !(result * b <= a) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\n\n        fn main() {\n            match safe_divide_37(20, 4) {\n                Ok(v) => println!(\"{{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\",\\\"res\\\":null}}\", e),\n            }\n        }\n      "}
