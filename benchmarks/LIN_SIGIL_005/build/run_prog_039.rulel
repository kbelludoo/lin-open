.source{content="\n        import { multiply_exact_39 } from './prog_039.mjs';\n        try {\n          const args = {\"x\":-5,\"y\":3};\n          const res = multiply_exact_39(...Object.values(args));\n          console.log(JSON.stringify({ status: 'ACCEPTED', reason: 'OK', res }));\n        } catch(err) {\n          console.log(JSON.stringify({ status: 'REJECTED', reason: err.message, res: null }));\n        }\n      "}
