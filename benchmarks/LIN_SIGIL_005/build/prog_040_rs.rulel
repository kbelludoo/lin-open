.source{content="\n        // Auto-generated Generic Rust from LIN IR\n#![allow(dead_code, unused_variables, unused_mut, non_snake_case)]\n\npub fn abs_diff_40(a: i32, b: i32) -> Result<i32, &'static str> {\n    if !(true) { return Err(\"PRECONDITION_VIOLATED\"); }\n    let result = (a - b as i32).abs();\n    if !(result >= 0) { return Err(\"POSTCONDITION_VIOLATED\"); }\n    Ok(result)\n}\n\n\n        fn main() {\n            match abs_diff_40(15, 25) {\n                Ok(v) => println!(\"{{\\\"status\\\":\\\"ACCEPTED\\\",\\\"reason\\\":\\\"OK\\\",\\\"res\\\":{}}}\", v),\n                Err(e) => println!(\"{{\\\"status\\\":\\\"REJECTED\\\",\\\"reason\\\":\\\"{}\\\",\\\"res\\\":null}}\", e),\n            }\n        }\n      "}
