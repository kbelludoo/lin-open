.source{content="\n        import { clamp_val_20 } from './prog_020.mjs';\n        try {\n          const args = {\"x\":50,\"min\":10,\"max\":100};\n          const res = clamp_val_20(...Object.values(args));\n          console.log(JSON.stringify({ status: 'ACCEPTED', reason: 'OK', res }));\n        } catch(err) {\n          console.log(JSON.stringify({ status: 'REJECTED', reason: err.message, res: null }));\n        }\n      "}
