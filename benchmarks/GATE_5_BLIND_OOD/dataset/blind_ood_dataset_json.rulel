.source{content="[\n  {\n    \"id\": \"OOD_001\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"compoundInterest_variant_1\",\n    \"params\": [\n      \"p\",\n      \"r\",\n      \"n\",\n      \"t\"\n    ],\n    \"jsBody\": \"return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));\",\n    \"linBody\": \"!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        12,\n        5\n      ],\n      [\n        5000,\n        0.08,\n        4,\n        10\n      ],\n      [\n        250,\n        0.03,\n        1,\n        30\n      ],\n      [\n        10000,\n        0.12,\n        365,\n        2\n      ],\n      [\n        0,\n        0.05,\n        12,\n        5\n      ],\n      [\n        100,\n        0,\n        12,\n        10\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_002\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"amortizationPayment_variant_1\",\n    \"params\": [\n      \"principal\",\n      \"annualRate\",\n      \"months\"\n    ],\n    \"jsBody\": \"if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));\",\n    \"linBody\": \"!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        200000,\n        0.06,\n        360\n      ],\n      [\n        15000,\n        0.05,\n        60\n      ],\n      [\n        300000,\n        0.035,\n        180\n      ],\n      [\n        50000,\n        0,\n        48\n      ],\n      [\n        1000,\n        0.1,\n        12\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_003\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"progressiveTax_variant_1\",\n    \"params\": [\n      \"income\",\n      \"brackets\"\n    ],\n    \"jsBody\": \"let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));\",\n    \"linBody\": \"!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}\",\n    \"testVectors\": [\n      [\n        50000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ]\n        ]\n      ],\n      [\n        120000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ],\n          [\n            1000000,\n            0.4\n          ]\n        ]\n      ],\n      [\n        5000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ],\n      [\n        0,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_004\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"presentValueAnnuity_variant_1\",\n    \"params\": [\n      \"pmt\",\n      \"rate\",\n      \"n\"\n    ],\n    \"jsBody\": \"if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));\",\n    \"linBody\": \"!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        10\n      ],\n      [\n        500,\n        0.08,\n        5\n      ],\n      [\n        200,\n        0,\n        20\n      ],\n      [\n        1500,\n        0.12,\n        15\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_005\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"compoundInterest_variant_2\",\n    \"params\": [\n      \"p\",\n      \"r\",\n      \"n\",\n      \"t\"\n    ],\n    \"jsBody\": \"return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));\",\n    \"linBody\": \"!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        12,\n        5\n      ],\n      [\n        5000,\n        0.08,\n        4,\n        10\n      ],\n      [\n        250,\n        0.03,\n        1,\n        30\n      ],\n      [\n        10000,\n        0.12,\n        365,\n        2\n      ],\n      [\n        0,\n        0.05,\n        12,\n        5\n      ],\n      [\n        100,\n        0,\n        12,\n        10\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_006\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"amortizationPayment_variant_2\",\n    \"params\": [\n      \"principal\",\n      \"annualRate\",\n      \"months\"\n    ],\n    \"jsBody\": \"if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));\",\n    \"linBody\": \"!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        200000,\n        0.06,\n        360\n      ],\n      [\n        15000,\n        0.05,\n        60\n      ],\n      [\n        300000,\n        0.035,\n        180\n      ],\n      [\n        50000,\n        0,\n        48\n      ],\n      [\n        1000,\n        0.1,\n        12\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_007\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"progressiveTax_variant_2\",\n    \"params\": [\n      \"income\",\n      \"brackets\"\n    ],\n    \"jsBody\": \"let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));\",\n    \"linBody\": \"!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}\",\n    \"testVectors\": [\n      [\n        50000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ]\n        ]\n      ],\n      [\n        120000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ],\n          [\n            1000000,\n            0.4\n          ]\n        ]\n      ],\n      [\n        5000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ],\n      [\n        0,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_008\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"presentValueAnnuity_variant_2\",\n    \"params\": [\n      \"pmt\",\n      \"rate\",\n      \"n\"\n    ],\n    \"jsBody\": \"if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));\",\n    \"linBody\": \"!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        10\n      ],\n      [\n        500,\n        0.08,\n        5\n      ],\n      [\n        200,\n        0,\n        20\n      ],\n      [\n        1500,\n        0.12,\n        15\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_009\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"compoundInterest_variant_3\",\n    \"params\": [\n      \"p\",\n      \"r\",\n      \"n\",\n      \"t\"\n    ],\n    \"jsBody\": \"return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));\",\n    \"linBody\": \"!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        12,\n        5\n      ],\n      [\n        5000,\n        0.08,\n        4,\n        10\n      ],\n      [\n        250,\n        0.03,\n        1,\n        30\n      ],\n      [\n        10000,\n        0.12,\n        365,\n        2\n      ],\n      [\n        0,\n        0.05,\n        12,\n        5\n      ],\n      [\n        100,\n        0,\n        12,\n        10\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_010\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"amortizationPayment_variant_3\",\n    \"params\": [\n      \"principal\",\n      \"annualRate\",\n      \"months\"\n    ],\n    \"jsBody\": \"if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));\",\n    \"linBody\": \"!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        200000,\n        0.06,\n        360\n      ],\n      [\n        15000,\n        0.05,\n        60\n      ],\n      [\n        300000,\n        0.035,\n        180\n      ],\n      [\n        50000,\n        0,\n        48\n      ],\n      [\n        1000,\n        0.1,\n        12\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_011\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"progressiveTax_variant_3\",\n    \"params\": [\n      \"income\",\n      \"brackets\"\n    ],\n    \"jsBody\": \"let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));\",\n    \"linBody\": \"!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}\",\n    \"testVectors\": [\n      [\n        50000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ]\n        ]\n      ],\n      [\n        120000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ],\n          [\n            1000000,\n            0.4\n          ]\n        ]\n      ],\n      [\n        5000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ],\n      [\n        0,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_012\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"presentValueAnnuity_variant_3\",\n    \"params\": [\n      \"pmt\",\n      \"rate\",\n      \"n\"\n    ],\n    \"jsBody\": \"if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));\",\n    \"linBody\": \"!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        10\n      ],\n      [\n        500,\n        0.08,\n        5\n      ],\n      [\n        200,\n        0,\n        20\n      ],\n      [\n        1500,\n        0.12,\n        15\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_013\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"compoundInterest_variant_4\",\n    \"params\": [\n      \"p\",\n      \"r\",\n      \"n\",\n      \"t\"\n    ],\n    \"jsBody\": \"return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));\",\n    \"linBody\": \"!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        12,\n        5\n      ],\n      [\n        5000,\n        0.08,\n        4,\n        10\n      ],\n      [\n        250,\n        0.03,\n        1,\n        30\n      ],\n      [\n        10000,\n        0.12,\n        365,\n        2\n      ],\n      [\n        0,\n        0.05,\n        12,\n        5\n      ],\n      [\n        100,\n        0,\n        12,\n        10\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_014\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"amortizationPayment_variant_4\",\n    \"params\": [\n      \"principal\",\n      \"annualRate\",\n      \"months\"\n    ],\n    \"jsBody\": \"if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));\",\n    \"linBody\": \"!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        200000,\n        0.06,\n        360\n      ],\n      [\n        15000,\n        0.05,\n        60\n      ],\n      [\n        300000,\n        0.035,\n        180\n      ],\n      [\n        50000,\n        0,\n        48\n      ],\n      [\n        1000,\n        0.1,\n        12\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_015\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"progressiveTax_variant_4\",\n    \"params\": [\n      \"income\",\n      \"brackets\"\n    ],\n    \"jsBody\": \"let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));\",\n    \"linBody\": \"!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}\",\n    \"testVectors\": [\n      [\n        50000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ]\n        ]\n      ],\n      [\n        120000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ],\n          [\n            1000000,\n            0.4\n          ]\n        ]\n      ],\n      [\n        5000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ],\n      [\n        0,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_016\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"presentValueAnnuity_variant_4\",\n    \"params\": [\n      \"pmt\",\n      \"rate\",\n      \"n\"\n    ],\n    \"jsBody\": \"if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));\",\n    \"linBody\": \"!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        10\n      ],\n      [\n        500,\n        0.08,\n        5\n      ],\n      [\n        200,\n        0,\n        20\n      ],\n      [\n        1500,\n        0.12,\n        15\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_017\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"compoundInterest_variant_5\",\n    \"params\": [\n      \"p\",\n      \"r\",\n      \"n\",\n      \"t\"\n    ],\n    \"jsBody\": \"return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));\",\n    \"linBody\": \"!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        12,\n        5\n      ],\n      [\n        5000,\n        0.08,\n        4,\n        10\n      ],\n      [\n        250,\n        0.03,\n        1,\n        30\n      ],\n      [\n        10000,\n        0.12,\n        365,\n        2\n      ],\n      [\n        0,\n        0.05,\n        12,\n        5\n      ],\n      [\n        100,\n        0,\n        12,\n        10\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_018\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"amortizationPayment_variant_5\",\n    \"params\": [\n      \"principal\",\n      \"annualRate\",\n      \"months\"\n    ],\n    \"jsBody\": \"if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));\",\n    \"linBody\": \"!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        200000,\n        0.06,\n        360\n      ],\n      [\n        15000,\n        0.05,\n        60\n      ],\n      [\n        300000,\n        0.035,\n        180\n      ],\n      [\n        50000,\n        0,\n        48\n      ],\n      [\n        1000,\n        0.1,\n        12\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_019\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"progressiveTax_variant_5\",\n    \"params\": [\n      \"income\",\n      \"brackets\"\n    ],\n    \"jsBody\": \"let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));\",\n    \"linBody\": \"!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}\",\n    \"testVectors\": [\n      [\n        50000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ]\n        ]\n      ],\n      [\n        120000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ],\n          [\n            100000,\n            0.3\n          ],\n          [\n            1000000,\n            0.4\n          ]\n        ]\n      ],\n      [\n        5000,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ],\n      [\n        0,\n        [\n          [\n            10000,\n            0.1\n          ],\n          [\n            40000,\n            0.2\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_020\",\n    \"family\": \"FINANCIAL_MATH\",\n    \"name\": \"presentValueAnnuity_variant_5\",\n    \"params\": [\n      \"pmt\",\n      \"rate\",\n      \"n\"\n    ],\n    \"jsBody\": \"if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));\",\n    \"linBody\": \"!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        1000,\n        0.05,\n        10\n      ],\n      [\n        500,\n        0.08,\n        5\n      ],\n      [\n        200,\n        0,\n        20\n      ],\n      [\n        1500,\n        0.12,\n        15\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_021\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"haversineDistance_variant_1\",\n    \"params\": [\n      \"lat1\",\n      \"lon1\",\n      \"lat2\",\n      \"lon2\"\n    ],\n    \"jsBody\": \"const R = 6371; const toRad = Math.PI / 180; const dLat = (lat2 - lat1) * toRad; const dLon = (lon2 - lon1) * toRad; const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.sin(dLon / 2) ** 2; const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); return Number((R * c).toFixed(3));\",\n    \"linBody\": \"!haversineDistance(a1,o1,a2,o2){$R=6371;$rad=Math.PI/180;$da=(a2-a1)*rad;$do=(o2-o1)*rad;$a=Math.sin(da/2)**2+Math.cos(a1*rad)*Math.cos(a2*rad)*Math.sin(do/2)**2;^Number((R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(3))}\",\n    \"testVectors\": [\n      [\n        40.7128,\n        -74.006,\n        51.5074,\n        -0.1278\n      ],\n      [\n        35.6762,\n        139.6503,\n        -33.8688,\n        151.2093\n      ],\n      [\n        0,\n        0,\n        0,\n        0\n      ],\n      [\n        90,\n        0,\n        -90,\n        0\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_022\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"boundingBoxOverlap_variant_1\",\n    \"params\": [\n      \"boxA\",\n      \"boxB\"\n    ],\n    \"jsBody\": \"const [minAx, minAy, maxAx, maxAy] = boxA; const [minBx, minBy, maxBx, maxBy] = boxB; return !(maxAx < minBx || minAx > maxBx || maxAy < minBy || minAy > maxBy);\",\n    \"linBody\": \"!boundingBoxOverlap(A,B){^!(A[2]<B[0]||A[0]>B[2]||A[3]<B[1]||A[1]>B[3])}\",\n    \"testVectors\": [\n      [\n        [\n          0,\n          0,\n          10,\n          10\n        ],\n        [\n          5,\n          5,\n          15,\n          15\n        ]\n      ],\n      [\n        [\n          0,\n          0,\n          5,\n          5\n        ],\n        [\n          6,\n          6,\n          10,\n          10\n        ]\n      ],\n      [\n        [\n          -10,\n          -10,\n          0,\n          0\n        ],\n        [\n          -5,\n          -5,\n          5,\n          5\n        ]\n      ],\n      [\n        [\n          0,\n          0,\n          20,\n          20\n        ],\n        [\n          5,\n          5,\n          10,\n          10\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_023\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"pointInPolygon_variant_1\",\n    \"params\": [\n      \"point\",\n      \"polygon\"\n    ],\n    \"jsBody\": \"const [x, y] = point; let inside = false; for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) { const [xi, yi] = polygon[i]; const [xj, yj] = polygon[j]; const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi); if (intersect) inside = !inside; } return inside;\",\n    \"linBody\": \"!pointInPolygon(pt,poly){$x=pt[0];$y=pt[1];$in=false;#(i=0,j=poly.length-1;i<poly.length;j=i++){$xi=poly[i][0];$yi=poly[i][1];$xj=poly[j][0];$yj=poly[j][1];?(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi)){$in=!in}} ^in}\",\n    \"testVectors\": [\n      [\n        [\n          5,\n          5\n        ],\n        [\n          [\n            0,\n            0\n          ],\n          [\n            10,\n            0\n          ],\n          [\n            10,\n            10\n          ],\n          [\n            0,\n            10\n          ]\n        ]\n      ],\n      [\n        [\n          15,\n          15\n        ],\n        [\n          [\n            0,\n        