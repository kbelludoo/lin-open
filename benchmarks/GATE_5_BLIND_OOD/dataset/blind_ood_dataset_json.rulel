xed(2));\",\n    \"linBody\": \"!bearingAngle(a1,o1,a2,o2){$rad=Math.PI/180;$deg=180/Math.PI;$y=Math.sin((o2-o1)*rad)*Math.cos(a2*rad);$x=Math.cos(a1*rad)*Math.sin(a2*rad)-Math.sin(a1*rad)*Math.cos(a2*rad)*Math.cos((o2-o1)*rad);^Number(((Math.atan2(y,x)*deg+360)%360).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        0,\n        0,\n        10,\n        10\n      ],\n      [\n        51.5,\n        0,\n        40.7,\n        -74\n      ],\n      [\n        -33.8,\n        151.2,\n        35.6,\n        139.6\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_037\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"haversineDistance_variant_5\",\n    \"params\": [\n      \"lat1\",\n      \"lon1\",\n      \"lat2\",\n      \"lon2\"\n    ],\n    \"jsBody\": \"const R = 6371; const toRad = Math.PI / 180; const dLat = (lat2 - lat1) * toRad; const dLon = (lon2 - lon1) * toRad; const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.sin(dLon / 2) ** 2; const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); return Number((R * c).toFixed(3));\",\n    \"linBody\": \"!haversineDistance(a1,o1,a2,o2){$R=6371;$rad=Math.PI/180;$da=(a2-a1)*rad;$do=(o2-o1)*rad;$a=Math.sin(da/2)**2+Math.cos(a1*rad)*Math.cos(a2*rad)*Math.sin(do/2)**2;^Number((R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(3))}\",\n    \"testVectors\": [\n      [\n        40.7128,\n        -74.006,\n        51.5074,\n        -0.1278\n      ],\n      [\n        35.6762,\n        139.6503,\n        -33.8688,\n        151.2093\n      ],\n      [\n        0,\n        0,\n        0,\n        0\n      ],\n      [\n        90,\n        0,\n        -90,\n        0\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_038\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"boundingBoxOverlap_variant_5\",\n    \"params\": [\n      \"boxA\",\n      \"boxB\"\n    ],\n    \"jsBody\": \"const [minAx, minAy, maxAx, maxAy] = boxA; const [minBx, minBy, maxBx, maxBy] = boxB; return !(maxAx < minBx || minAx > maxBx || maxAy < minBy || minAy > maxBy);\",\n    \"linBody\": \"!boundingBoxOverlap(A,B){^!(A[2]<B[0]||A[0]>B[2]||A[3]<B[1]||A[1]>B[3])}\",\n    \"testVectors\": [\n      [\n        [\n          0,\n          0,\n          10,\n          10\n        ],\n        [\n          5,\n          5,\n          15,\n          15\n        ]\n      ],\n      [\n        [\n          0,\n          0,\n          5,\n          5\n        ],\n        [\n          6,\n          6,\n          10,\n          10\n        ]\n      ],\n      [\n        [\n          -10,\n          -10,\n          0,\n          0\n        ],\n        [\n          -5,\n          -5,\n          5,\n          5\n        ]\n      ],\n      [\n        [\n          0,\n          0,\n          20,\n          20\n        ],\n        [\n          5,\n          5,\n          10,\n          10\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_039\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"pointInPolygon_variant_5\",\n    \"params\": [\n      \"point\",\n      \"polygon\"\n    ],\n    \"jsBody\": \"const [x, y] = point; let inside = false; for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) { const [xi, yi] = polygon[i]; const [xj, yj] = polygon[j]; const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi); if (intersect) inside = !inside; } return inside;\",\n    \"linBody\": \"!pointInPolygon(pt,poly){$x=pt[0];$y=pt[1];$in=false;#(i=0,j=poly.length-1;i<poly.length;j=i++){$xi=poly[i][0];$yi=poly[i][1];$xj=poly[j][0];$yj=poly[j][1];?(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi)){$in=!in}} ^in}\",\n    \"testVectors\": [\n      [\n        [\n          5,\n          5\n        ],\n        [\n          [\n            0,\n            0\n          ],\n          [\n            10,\n            0\n          ],\n          [\n            10,\n            10\n          ],\n          [\n            0,\n            10\n          ]\n        ]\n      ],\n      [\n        [\n          15,\n          15\n        ],\n        [\n          [\n            0,\n            0\n          ],\n          [\n            10,\n            0\n          ],\n          [\n            10,\n            10\n          ],\n          [\n            0,\n            10\n          ]\n        ]\n      ],\n      [\n        [\n          0,\n          0\n        ],\n        [\n          [\n            0,\n            0\n          ],\n          [\n            10,\n            0\n          ],\n          [\n            10,\n            10\n          ],\n          [\n            0,\n            10\n          ]\n        ]\n      ],\n      [\n        [\n          2,\n          3\n        ],\n        [\n          [\n            1,\n            1\n          ],\n          [\n            5,\n            1\n          ],\n          [\n            3,\n            6\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_040\",\n    \"family\": \"GEOSPATIAL_ALGORITHMS\",\n    \"name\": \"bearingAngle_variant_5\",\n    \"params\": [\n      \"lat1\",\n      \"lon1\",\n      \"lat2\",\n      \"lon2\"\n    ],\n    \"jsBody\": \"const toRad = Math.PI / 180; const toDeg = 180 / Math.PI; const y = Math.sin((lon2 - lon1) * toRad) * Math.cos(lat2 * toRad); const x = Math.cos(lat1 * toRad) * Math.sin(lat2 * toRad) - Math.sin(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.cos((lon2 - lon1) * toRad); const b = Math.atan2(y, x) * toDeg; return Number(((b + 360) % 360).toFixed(2));\",\n    \"linBody\": \"!bearingAngle(a1,o1,a2,o2){$rad=Math.PI/180;$deg=180/Math.PI;$y=Math.sin((o2-o1)*rad)*Math.cos(a2*rad);$x=Math.cos(a1*rad)*Math.sin(a2*rad)-Math.sin(a1*rad)*Math.cos(a2*rad)*Math.cos((o2-o1)*rad);^Number(((Math.atan2(y,x)*deg+360)%360).toFixed(2))}\",\n    \"testVectors\": [\n      [\n        0,\n        0,\n        10,\n        10\n      ],\n      [\n        51.5,\n        0,\n        40.7,\n        -74\n      ],\n      [\n        -33.8,\n        151.2,\n        35.6,\n        139.6\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_041\",\n    \"family\": \"DATA_STRUCTURES_GRAPH\",\n    \"name\": \"topologicalSort_variant_1\",\n    \"params\": [\n      \"numNodes\",\n      \"edges\"\n    ],\n    \"jsBody\": \"const inDegree = new Array(numNodes).fill(0); const adj = Array.from({ length: numNodes }, () => []); for (const [u, v] of edges) { adj[u].push(v); inDegree[v]++; } const queue = []; for (let i = 0; i < numNodes; i++) { if (inDegree[i] === 0) queue.push(i); } const order = []; while (queue.length > 0) { const u = queue.shift(); order.push(u); for (const v of adj[u]) { inDegree[v]--; if (inDegree[v] === 0) queue.push(v); } } return order.length === numNodes ? order : [];\",\n    \"linBody\": \"!topologicalSort(N,E){$deg=new Array(N).fill(0);$adj=Array.from({length:N},()=>[]);#(i=0;i<E.length;i++){$u=E[i][0];$v=E[i][1];adj[u].push(v);deg[v]++} $q=[];#(i=0;i<N;i++){?(deg[i]===0){q.push(i)}} $ord=[];#(q.length>0){$u=q.shift();ord.push(u);#(j=0;j<adj[u].length;j++){$v=adj[u][j];deg[v]--;?(deg[v]===0){q.push(v)}}} ^ord.length===N?ord:[]}\",\n    \"testVectors\": [\n      [\n        4,\n        [\n          [\n            0,\n            1\n          ],\n          [\n            0,\n            2\n          ],\n          [\n            1,\n            3\n          ],\n          [\n            2,\n            3\n          ]\n        ]\n      ],\n      [\n        3,\n        [\n          [\n            0,\n            1\n          ],\n          [\n            1,\n            2\n          ],\n          [\n            2,\n            0\n          ]\n        ]\n      ],\n      [\n        5,\n        [\n          [\n            0,\n            2\n          ],\n          [\n            1,\n            2\n          ],\n          [\n            2,\n            3\n          ],\n          [\n            3,\n            4\n          ]\n        ]\n      ],\n      [\n        1,\n        []\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_042\",\n    \"family\": \"DATA_STRUCTURES_GRAPH\",\n    \"name\": \"intervalOverlapCount_variant_1\",\n    \"params\": [\n      \"intervals\"\n    ],\n    \"jsBody\": \"const starts = intervals.map(i => i[0]).sort((a, b) => a - b); const ends = intervals.map(i => i[1]).sort((a, b) => a - b); let maxRooms = 0, current = 0, s = 0, e = 0; while (s < starts.length) { if (starts[s] < ends[e]) { current++; maxRooms = Math.max(maxRooms, current); s++; } else { current--; e++; } } return maxRooms;\",\n    \"linBody\": \"!intervalOverlapCount(ints){$s=ints.map(i=>i[0]).sort((a,b)=>a-b);$e=ints.map(i=>i[1]).sort((a,b)=>a-b);$max=0;$cur=0;$si=0;$ei=0;#(si<s.length){?(s[si]<e[ei]){cur++;max=Math.max(max,cur);si++}:else{cur--;ei++}} ^max}\",\n    \"testVectors\": [\n      [\n        [\n          [\n            0,\n            30\n          ],\n          [\n            5,\n            10\n          ],\n          [\n            15,\n            20\n          ]\n        ]\n      ],\n      [\n        [\n          [\n            7,\n            10\n          ],\n          [\n            2,\n            4\n          ]\n        ]\n      ],\n      [\n        [\n          [\n            1,\n            5\n          ],\n          [\n            5,\n            10\n          ],\n          [\n            10,\n            15\n          ]\n        ]\n      ],\n      [\n        [\n          [\n            1,\n            10\n          ],\n          [\n            2,\n            9\n          ],\n          [\n            3,\n            8\n          ],\n          [\n            4,\n            7\n          ]\n        ]\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_043\",\n    \"family\": \"DATA_STRUCTURES_GRAPH\",\n    \"name\": \"triePrefixMatch_variant_1\",\n    \"params\": [\n      \"words\",\n      \"prefix\"\n    ],\n    \"jsBody\": \"return words.filter(w => w.startsWith(prefix)).sort();\",\n    \"linBody\": \"!triePrefixMatch(W,pfx){^W.filter(w=>w.startsWith(pfx)).sort()}\",\n    \"testVectors\": [\n      [\n        [\n          \"apple\",\n          \"app\",\n          \"application\",\n          \"banana\",\n          \"apply\"\n        ],\n        \"app\"\n      ],\n      [\n        [\n          \"cat\",\n          \"car\",\n          \"dog\"\n        ],\n        \"z\"\n      ],\n      [\n        [\n          \"lin\",\n          \"lingua\",\n          \"native\",\n          \"link\"\n        ],\n        \"lin\"\n      ]\n    ]\n  },\n  {\n    \"id\": \"OOD_044\",\n    \"family\": \"DATA_STRUCTURES_GRAPH\",\n    \"name\": \"lruEvictionOrder_variant_1\",\n    \"params\": [\n      \"capacity\",\n      \"operations\"\n    ],\n    \"jsBody\": \"const cache = new Map(); const out = []; for (const op of operations) { if (op.type === 'get') { if (cache.has(op.key)) { const val = cache.get(op.key); cache.delete(op.key); cache.set(op.key, val); out.push(val); } else { out.push(-1); } } else { if (cache.has(op.key)) cache.delete(op.key); else if (cache.size >= capacity) cache.delete(cache.keys().next().value); cache.set(op.key, op.val); } } return out;\",\n    \"linBody\": \"!lruEvictionOrder(cap,ops){$c=new Map();$out=[];#(i=0;i<ops.length;i++){$op=ops[i];?(op.type==='get'){?(c.has(op.key)){$v=c.get(op.key);c.delete(op.key);c.set(op.key,v);out.push(v)}:else{out.push(-1)}}:else{?(c.has(op.key)){c.delete(op.key)}:else{?(c.size>=cap){c.delete(c.keys().next().value)}} c.set(op.key,op.val)}} ^out}\",\n    \"testVectors\": [\n      [\n        2,\n        [\n          {\n            \"type\": \"put\",\n            \"key\": 1,\n            \"val\": 1\n          },\n          {\n            \"type\": \"put\",\n            \"key\": 2,\n            \"val\": 2\n          },\n          {\n            \"type\": \"get\",\n            \"key\": 1\n          },\n          {\n            \"type\": \"put\",\n            \"key\": 3,\n            \"val\": 3\n          },\n          {\n            \"type\": \"get\",\n            \"key\": 2\n         