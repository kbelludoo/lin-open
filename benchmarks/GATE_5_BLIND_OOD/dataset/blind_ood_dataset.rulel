  .id="OOD_029" family="GEOSPATIAL_ALGORITHMS" name="haversineDistance_variant_3" params=["lat1","lon1","lat2","lon2"] jsBody="const R = 6371; const toRad = Math.PI / 180; const dLat = (lat2 - lat1) * toRad; const dLon = (lon2 - lon1) * toRad; const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.sin(dLon / 2) ** 2; const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); return Number((R * c).toFixed(3));" linBody="!haversineDistance(a1,o1,a2,o2){$R=6371;$rad=Math.PI/180;$da=(a2-a1)*rad;$do=(o2-o1)*rad;$a=Math.sin(da/2)**2+Math.cos(a1*rad)*Math.cos(a2*rad)*Math.sin(do/2)**2;^Number((R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(3))}"
