  .id="OOD_028" family="GEOSPATIAL_ALGORITHMS" name="bearingAngle_variant_2" params=["lat1","lon1","lat2","lon2"] jsBody="const toRad = Math.PI / 180; const toDeg = 180 / Math.PI; const y = Math.sin((lon2 - lon1) * toRad) * Math.cos(lat2 * toRad); const x = Math.cos(lat1 * toRad) * Math.sin(lat2 * toRad) - Math.sin(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.cos((lon2 - lon1) * toRad); const b = Math.atan2(y, x) * toDeg; return Number(((b + 360) % 360).toFixed(2));" linBody="!bearingAngle(a1,o1,a2,o2){$rad=Math.PI/180;$deg=180/Math.PI;$y=Math.sin((o2-o1)*rad)*Math.cos(a2*rad);$x=Math.cos(a1*rad)*Math.sin(a2*rad)-Math.sin(a1*rad)*Math.cos(a2*rad)*Math.cos((o2-o1)*rad);^Number(((Math.atan2(y,x)*deg+360)%360).toFixed(2))}"
