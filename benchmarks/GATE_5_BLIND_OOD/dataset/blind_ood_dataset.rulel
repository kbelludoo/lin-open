  .id="OOD_041" family="DATA_STRUCTURES_GRAPH" name="topologicalSort_variant_1" params=["numNodes","edges"] jsBody="const inDegree = new Array(numNodes).fill(0); const adj = Array.from({ length: numNodes }, () => []); for (const [u, v] of edges) { adj[u].push(v); inDegree[v]++; } const queue = []; for (let i = 0; i < numNodes; i++) { if (inDegree[i] === 0) queue.push(i); } const order = []; while (queue.length > 0) { const u = queue.shift(); order.push(u); for (const v of adj[u]) { inDegree[v]--; if (inDegree[v] === 0) queue.push(v); } } return order.length === numNodes ? order : [];" linBody="!topologicalSort(N,E){$deg=new Array(N).fill(0);$adj=Array.from({length:N},()=>[]);#(i=0;i<E.length;i++){$u=E[i][0];$v=E[i][1];adj[u].push(v);deg[v]++} $q=[];#(i=0;i<N;i++){?(deg[i]===0){q.push(i)}} $ord=[];#(q.length>0){$u=q.shift();ord.push(u);#(j=0;j<adj[u].length;j++){$v=adj[u][j];deg[v]--;?(deg[v]===0){q.push(v)}}} ^ord.length===N?ord:[]}"
  .testVectors{
  }
  .id="OOD_042" family="DATA_STRUCTURES_GRAPH" name="intervalOverlapCount_variant_1" params=["intervals"] jsBody="const starts = intervals.map(i => i[0]).sort((a, b) => a - b); const ends = intervals.map(i => i[1]).sort((a, b) => a - b); let maxRooms = 0, current = 0, s = 0, e = 0; while (s < starts.length) { if (starts[s] < ends[e]) { current++; maxRooms = Math.max(maxRooms, current); s++; } else { current--; e++; } } return maxRooms;" linBody="!intervalOverlapCount(ints){$s=ints.map(i=>i[0]).sort((a,b)=>a-b);$e=ints.map(i=>i[1]).sort((a,b)=>a-b);$max=0;$cur=0;$si=0;$ei=0;#(si<s.length){?(s[si]<e[ei]){cur++;max=Math.max(max,cur);si++}:else{cur--;ei++}} ^max}"
  .testVectors{
  }
