  .id="OOD_019" family="FINANCIAL_MATH" name="progressiveTax_variant_5" params=["income","brackets"] jsBody="let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));" linBody="!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}"
