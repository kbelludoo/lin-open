  .id="OOD_044" family="DATA_STRUCTURES_GRAPH" name="lruEvictionOrder_variant_1" params=["capacity","operations"] jsBody="const cache = new Map(); const out = []; for (const op of operations) { if (op.type === 'get') { if (cache.has(op.key)) { const val = cache.get(op.key); cache.delete(op.key); cache.set(op.key, val); out.push(val); } else { out.push(-1); } } else { if (cache.has(op.key)) cache.delete(op.key); else if (cache.size >= capacity) cache.delete(cache.keys().next().value); cache.set(op.key, op.val); } } return out;" linBody="!lruEvictionOrder(cap,ops){$c=new Map();$out=[];#(i=0;i<ops.length;i++){$op=ops[i];?(op.type==='get'){?(c.has(op.key)){$v=c.get(op.key);c.delete(op.key);c.set(op.key,v);out.push(v)}:else{out.push(-1)}}:else{?(c.has(op.key)){c.delete(op.key)}:else{?(c.size>=cap){c.delete(c.keys().next().value)}} c.set(op.key,op.val)}} ^out}"
