@RULEL:BLIND_OOD_DATASET:1.0.0
~DATA
  .testVectors{
  }
  .id="OOD_001" family="FINANCIAL_MATH" name="compoundInterest_variant_1" params=["p","r","n","t"] jsBody="return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));" linBody="!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}"
  .testVectors{
  }
  .id="OOD_002" family="FINANCIAL_MATH" name="amortizationPayment_variant_1" params=["principal","annualRate","months"] jsBody="if (annualRate === 0) return Number((principal / months).toFixed(2)); const r = annualRate / 12; return Number((principal * (r * Math.pow(1 + r, months)) / (Math.pow(1 + r, months) - 1)).toFixed(2));" linBody="!amortizationPayment(p,ar,m){?(ar===0){^Number((p/m).toFixed(2))} $r=ar/12; ^Number((p*(r*(1+r)**m)/((1+r)**m-1)).toFixed(2))}"
  .testVectors{
  }
  .id="OOD_003" family="FINANCIAL_MATH" name="progressiveTax_variant_1" params=["income","brackets"] jsBody="let tax = 0; for (let i = 0; i < brackets.length; i++) { const [limit, rate] = brackets[i]; const prev = i > 0 ? brackets[i - 1][0] : 0; if (income > prev) { const taxable = Math.min(income, limit) - prev; tax += taxable * rate; } } return Number(tax.toFixed(2));" linBody="!progressiveTax(inc,brk){$tax=0;#(i=0;i<brk.length;i++){$b=brk[i];$p=i>0?brk[i-1][0]:0;?(inc>p){$tax+=(Math.min(inc,b[0])-p)*b[1]}} ^Number(tax.toFixed(2))}"
  .testVectors{
  }
  .id="OOD_004" family="FINANCIAL_MATH" name="presentValueAnnuity_variant_1" params=["pmt","rate","n"] jsBody="if (rate === 0) return pmt * n; return Number((pmt * (1 - Math.pow(1 + rate, -n)) / rate).toFixed(2));" linBody="!presentValueAnnuity(pmt,r,n){?(r===0){^pmt*n} ^Number((pmt*(1-(1+r)**-n)/r).toFixed(2))}"
  .testVectors{
  }
  .id="OOD_005" family="FINANCIAL_MATH" name="compoundInterest_variant_2" params=["p","r","n","t"] jsBody="return Number((p * Math.pow(1 + r / n, n * t)).toFixed(2));" linBody="!compoundInterest(p,r,n,t){^Number((p*(1+r/n)**(n*t)).toFixed(2))}"
  .testVectors{
