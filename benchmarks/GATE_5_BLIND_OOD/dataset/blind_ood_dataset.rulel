  .id="OOD_091" family="SIGNAL_PROCESSING_STATS" name="quantileEstimation_variant_3" params=["data","q"] jsBody="if (data.length === 0) return 0; const s = [...data].sort((a, b) => a - b); const pos = (s.length - 1) * q; const base = Math.floor(pos); const rest = pos - base; if (s[base + 1] !== undefined) return Number((s[base] + rest * (s[base + 1] - s[base])).toFixed(4)); return s[base];" linBody="!quantileEstimation(D,q){?(D.length===0){^0} $s=[...D].sort((a,b)=>a-b);$pos=(s.length-1)*q;$base=Math.floor(pos);$rest=pos-base;?(s[base+1]!==undefined){^Number((s[base]+rest*(s[base+1]-s[base])).toFixed(4))} ^s[base]}"
  .testVectors{
  }
  .id="OOD_092" family="SIGNAL_PROCESSING_STATS" name="signalPeakDetection_variant_3" params=["signal","threshold"] jsBody="const peaks = []; for (let i = 1; i < signal.length - 1; i++) { if (signal[i] > signal[i - 1] && signal[i] > signal[i + 1] && signal[i] >= threshold) { peaks.push({ index: i, value: signal[i] }); } } return peaks;" linBody="!signalPeakDetection(sig,thresh){$p=[];#(i=1;i<sig.length-1;i++){?(sig[i]>sig[i-1]&&sig[i]>sig[i+1]&&sig[i]>=thresh){p.push({index:i,value:sig[i]})}} ^p}"
  .testVectors{
  }
  .id="OOD_093" family="SIGNAL_PROCESSING_STATS" name="exponentialMovingAverage_variant_4" params=["data","alpha"] jsBody="if (data.length === 0) return []; const out = [data[0]]; for (let i = 1; i < data.length; i++) { out.push(Number((alpha * data[i] + (1 - alpha) * out[i - 1]).toFixed(4))); } return out;" linBody="!exponentialMovingAverage(D,a){?(D.length===0){^[]} $out=[D[0]];#(i=1;i<D.length;i++){out.push(Number((a*D[i]+(1-a)*out[i-1]).toFixed(4)))} ^out}"
  .testVectors{
  }
  .id="OOD_094" family="SIGNAL_PROCESSING_STATS" name="pearsonCorrelation_variant_4" params=["x","y"] jsBody="const n = x.length; if (n < 2) return 0; const mx = x.reduce((a, b) => a + b, 0) / n; const my = y.reduce((a, b) => a + b, 0) / n; let num = 0, d1 = 0, d2 = 0; for (let i = 0; i < n; i++) { const dx = x[i] - mx; const dy = y[i] - my; num += dx * dy; d1 += dx * dx; d2 += dy * dy; } const denom = Math.sqrt(d1 * d2); if (denom === 0) return 0; return Number((num / denom).toFixed(4));" linBody="!pearsonCorrelation(x,y){$n=x.length;?(n<2){^0} $mx=x.reduce((a,b)=>a+b,0)/n;$my=y.reduce((a,b)=>a+b,0)/n;$num=0;$d1=0;$d2=0;#(i=0;i<n;i++){$dx=x[i]-mx;$dy=y[i]-my;num+=dx*dy;d1+=dx*dx;d2+=dy*dy} $den=Math.sqrt(d1*d2);?(den===0){^0} ^Number((num/den).toFixed(4))}"
  .testVectors{
  }
