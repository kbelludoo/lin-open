  .id="OOD_062" family="STRING_CRYPTO_ENCODING" name="levenshteinDistance_variant_1" params=["a","b"] jsBody="const dp = Array.from({ length: a.length + 1 }, () => new Array(b.length + 1).fill(0)); for (let i = 0; i <= a.length; i++) dp[i][0] = i; for (let j = 0; j <= b.length; j++) dp[0][j] = j; for (let i = 1; i <= a.length; i++) { for (let j = 1; j <= b.length; j++) { const cost = a[i - 1] === b[j - 1] ? 0 : 1; dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost); } } return dp[a.length][b.length];" linBody="!levenshteinDistance(a,b){$dp=Array.from({length:a.length+1},()=>new Array(b.length+1).fill(0));#(i=0;i<=a.length;i++){dp[i][0]=i} #(j=0;j<=b.length;j++){dp[0][j]=j} #(i=1;i<=a.length;i++){#(j=1;j<=b.length;j++){$c=a[i-1]===b[j-1]?0:1;dp[i][j]=Math.min(dp[i-1][j]+1,dp[i][j-1]+1,dp[i-1][j-1]+c)}} ^dp[a.length][b.length]}"
