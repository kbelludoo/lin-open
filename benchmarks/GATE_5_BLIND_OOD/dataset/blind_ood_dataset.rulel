  .id="OOD_063" family="STRING_CRYPTO_ENCODING" name="runLengthEncode_variant_1" params=["str"] jsBody="if (!str) return ''; let out = '', count = 1; for (let i = 1; i <= str.length; i++) { if (i < str.length && str[i] === str[i - 1]) count++; else { out += count + str[i - 1]; count = 1; } } return out;" linBody="!runLengthEncode(s){?(!s){^''} $out='';$cnt=1;#(i=1;i<=s.length;i++){?(i<s.length&&s[i]===s[i-1]){cnt++}:else{out+=cnt+s[i-1];cnt=1}} ^out}"
