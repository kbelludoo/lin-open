  .testVectors{
  }
  .id="OOD_061" family="STRING_CRYPTO_ENCODING" name="crc32Checksum_variant_1" params=["str"] jsBody="let crc = 0 ^ (-1); for (let i = 0; i < str.length; i++) { let byte = str.charCodeAt(i); for (let j = 0; j < 8; j++) { const bit = (crc ^ byte) & 1; crc = (crc >>> 1) ^ (bit ? 0xEDB88320 : 0); byte >>>= 1; } } return (crc ^ (-1)) >>> 0;" linBody="!crc32Checksum(s){$crc=0^(-1);#(i=0;i<s.length;i++){$b=s.charCodeAt(i);#(j=0;j<8;j++){$bit=(crc^b)&1;$crc=(crc>>>1)^(bit?0xEDB88320:0);$b>>>=1}} ^(crc^(-1))>>>0}"
