  .id="OOD_021" family="GEOSPATIAL_ALGORITHMS" name="haversineDistance_variant_1" params=["lat1","lon1","lat2","lon2"] jsBody="const R = 6371; const toRad = Math.PI / 180; const dLat = (lat2 - lat1) * toRad; const dLon = (lon2 - lon1) * toRad; const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.sin(dLon / 2) ** 2; const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); return Number((R * c).toFixed(3));" linBody="!haversineDistance(a1,o1,a2,o2){$R=6371;$rad=Math.PI/180;$da=(a2-a1)*rad;$do=(o2-o1)*rad;$a=Math.sin(da/2)**2+Math.cos(a1*rad)*Math.cos(a2*rad)*Math.sin(do/2)**2;^Number((R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(3))}"
  .testVectors{
  }
  .id="OOD_022" family="GEOSPATIAL_ALGORITHMS" name="boundingBoxOverlap_variant_1" params=["boxA","boxB"] jsBody="const [minAx, minAy, maxAx, maxAy] = boxA; const [minBx, minBy, maxBx, maxBy] = boxB; return !(maxAx < minBx || minAx > maxBx || maxAy < minBy || minAy > maxBy);" linBody="!boundingBoxOverlap(A,B){^!(A[2]<B[0]||A[0]>B[2]||A[3]<B[1]||A[1]>B[3])}"
  .testVectors{
  }
  .id="OOD_023" family="GEOSPATIAL_ALGORITHMS" name="pointInPolygon_variant_1" params=["point","polygon"] jsBody="const [x, y] = point; let inside = false; for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) { const [xi, yi] = polygon[i]; const [xj, yj] = polygon[j]; const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / (yj - yi) + xi); if (intersect) inside = !inside; } return inside;" linBody="!pointInPolygon(pt,poly){$x=pt[0];$y=pt[1];$in=false;#(i=0,j=poly.length-1;i<poly.length;j=i++){$xi=poly[i][0];$yi=poly[i][1];$xj=poly[j][0];$yj=poly[j][1];?(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi)){$in=!in}} ^in}"
  .testVectors{
  }
  .id="OOD_024" family="GEOSPATIAL_ALGORITHMS" name="bearingAngle_variant_1" params=["lat1","lon1","lat2","lon2"] jsBody="const toRad = Math.PI / 180; const toDeg = 180 / Math.PI; const y = Math.sin((lon2 - lon1) * toRad) * Math.cos(lat2 * toRad); const x = Math.cos(lat1 * toRad) * Math.sin(lat2 * toRad) - Math.sin(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.cos((lon2 - lon1) * toRad); const b = Math.atan2(y, x) * toDeg; return Number(((b + 360) % 360).toFixed(2));" linBody="!bearingAngle(a1,o1,a2,o2){$rad=Math.PI/180;$deg=180/Math.PI;$y=Math.sin((o2-o1)*rad)*Math.cos(a2*rad);$x=Math.cos(a1*rad)*Math.sin(a2*rad)-Math.sin(a1*rad)*Math.cos(a2*rad)*Math.cos((o2-o1)*rad);^Number(((Math.atan2(y,x)*deg+360)%360).toFixed(2))}"
  .testVectors{
  }
  .id="OOD_025" family="GEOSPATIAL_ALGORITHMS" name="haversineDistance_variant_2" params=["lat1","lon1","lat2","lon2"] jsBody="const R = 6371; const toRad = Math.PI / 180; const dLat = (lat2 - lat1) * toRad; const dLon = (lon2 - lon1) * toRad; const a = Math.sin(dLat / 2) ** 2 + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad) * Math.sin(dLon / 2) ** 2; const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); return Number((R * c).toFixed(3));" linBody="!haversineDistance(a1,o1,a2,o2){$R=6371;$rad=Math.PI/180;$da=(a2-a1)*rad;$do=(o2-o1)*rad;$a=Math.sin(da/2)**2+Math.cos(a1*rad)*Math.cos(a2*rad)*Math.sin(do/2)**2;^Number((R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a))).toFixed(3))}"
  .testVectors{
  }
  .id="OOD_026" family="GEOSPATIAL_ALGORITHMS" name="boundingBoxOverlap_variant_2" params=["boxA","boxB"] jsBody="const [minAx, minAy, maxAx, maxAy] = boxA; const [minBx, minBy, maxBx, maxBy] = boxB; return !(maxAx < minBx || minAx > maxBx || maxAy < minBy || minAy > maxBy);" linBody="!boundingBoxOverlap(A,B){^!(A[2]<B[0]||A[0]>B[2]||A[3]<B[1]||A[1]>B[3])}"
  .testVectors{
  }
