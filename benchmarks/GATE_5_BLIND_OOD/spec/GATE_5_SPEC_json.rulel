~METADATA{original="benchmarks/GATE_5_BLIND_OOD/spec/GATE_5_SPEC.json" ext=".json"}
.source{content="{\n  \"protocol\": \"GATE_5_BLIND_GENERALIZATION_OOD\",\n  \"version\": \"1.0.0\",\n  \"status\": \"FROZEN\",\n  \"hypothesis\": \"H_OOD_01: LIN semantic representations achieve strict execution parity (EE_strict >= 99%) and statistically significant token reduction (alpha = 0.005) on unseen out-of-distribution algorithmic domains without prior exposure.\",\n  \"task_domain_families\": [\n    \"FINANCIAL_MATH\",\n    \"GEOSPATIAL_ALGORITHMS\",\n    \"DATA_STRUCTURES_GRAPH\",\n    \"STRING_CRYPTO_ENCODING\",\n    \"SIGNAL_PROCESSING_STATS\"\n  ],\n  \"sample_size\": 100,\n  \"metrics\": [\n    \"EE_strict_exact_execution_parity\",\n    \"token_reduction_ratio\",\n    \"latency_speedup\",\n    \"wilcoxon_signed_rank_p_value\",\n    \"bonferroni_significance_alpha_0_005\"\n  ],\n  \"statistical_test\": \"Paired Wilcoxon Signed-Rank Test with Bonferroni correction (alpha = 0.005)\"\n}\n"}
